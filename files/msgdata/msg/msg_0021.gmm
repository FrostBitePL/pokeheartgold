	<row id="msg_0021_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czerwony Apricorn\nCzerwony Apricorn.\nDrażni nozdrza.</language>
	</row>
	<row id="msg_0021_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żółty Apricorn\nŻółty Apricorn.\nMa orzeźwiający zapach.</language>
	</row>
	<row id="msg_0021_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niebieski Apricorn\nNiebieski Apricorn.\nPachnie trochę jak trawa.</language>
	</row>
	<row id="msg_0021_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zielony Apricorn\nZielony Apricorn.\nMa tajemniczy, aromatyczny zapach.</language>
	</row>
	<row id="msg_0021_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Różowy Apricorn\nRóżowy Apricorn.\nMa miły, słodki zapach.</language>
	</row>
	<row id="msg_0021_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biały Apricorn\nBiały Apricorn.\nNie pachnie niczym.</language>
	</row>
	<row id="msg_0021_00046" index="46">
		<attribute name="window_context_name">used</attribute>
