	<row id="msg_0040_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O? Coś się dzieje z {STRVAR_1 1, 0, 0}...\r</language>
	</row>
	<row id="msg_0040_00100" index="100">
