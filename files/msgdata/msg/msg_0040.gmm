	<row id="msg_0040_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzień dobry! Witaj w Centrum\nPokémon.\rLeczymy twoje zmęczone Pokémony do\npełni zdrowia.\rChcesz, żeby twoje Pokémony\nodpoczęły? {YESNO 0}</language>
	</row>
