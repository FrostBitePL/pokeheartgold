	<row id="msg_0040_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapisany plik gry już istnieje.\rZapis jest niemożliwy.\rSzczegóły znajdziesz w instrukcji.\rJeśli chcesz usunąć obecny zapis,\nnaciśnij na ekranie tytułowym Góra +\fSELECT + B.</language>
	</row>
	<row id="msg_0040_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapisuję dużą ilość danych...\rNie wyłączaj zasilania.</language>
