	<row id="msg_0040_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} uruchomił(a) komputer.\r</language>
	</row>
	<row id="msg_0040_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Do którego komputera chcesz się\nzalogować? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Połączono z Systemem Przechowywania\nPokémonów.\r</language>
	</row>
	<row id="msg_0040_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zalogowano na komputer: {STRVAR_1 3, 0, 0}.\r</language>
	</row>
	<row id="msg_0040_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słowa profesor Kunic rozbrzmiały...\r{STRVAR_1 3, 0, 0}! Wszystko ma swój czas i\nmiejsce! Ale nie teraz.</language>
	</row>
	<row id="msg_0040_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj! W czym mogę pomóc?</language>
	</row>
	<row id="msg_0040_00039" index="39">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0040_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gotowe! Wszystkie zdrowe i\nszczęśliwe!\rPowodzenia i dbaj o siebie!</language>
	</row>
	<row id="msg_0040_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mama: {STRVAR_1 3, 0, 0}!\nWitaj w domu.\rBrzmi na to, że sporo dziś\nprzeżyłeś.\rMoże powinieneś trochę\nodpocząć i się zrelaksować.\r...\n...</language>
	</row>
	<row id="msg_0040_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mama: Cieszę się! Ty i twój\nPokémon świetnie wyglądacie.\rAch tak, słyszałam od Profesora\nMariusza.\rPowiedział, że energia Pokémona\nmierzona jest w HP (punktach życia).\rJeśli twój Pokémon straci HP,\nmożesz go uzdrowić w każdym\fCentrum Pokémon.\rJeśli wybierasz się w daleką podróż,\nmądry Trener zaopatruje się\fw Mikstury w Sklepie Pokémon.\rSpraw, bym była dumna, kochanie!\nUważaj na siebie!</language>
	</row>
	<row id="msg_0040_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mama: Cieszę się! Ty i twój\nPokémon świetnie wyglądacie.\rAch tak, {STRVAR_1 3, 0, 0}, twój Pokémon\nzemdleje, jeśli straci wszystkie HP.\rJeśli twój Pokémon straci HP,\nwróć do domu, zanim zemdleje.\rZostanie w pełni uzdrowiony,\ngdy odpocznie.\rNo cóż, kochanie, spraw, bym\nbyła dumna! Uważaj na siebie!</language>
	</row>
	<row id="msg_0040_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najpierw przywróćmy twoim Pokémonom\npełnię zdrowia.</language>
	</row>
	<row id="msg_0040_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje Pokémony są w doskonałym\nzdrowiu.</language>
	</row>
	<row id="msg_0040_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odwiedź Centrum Pokémon, gdy HP\ntwoich Pokémonów spadnie.\rJeśli planujesz dalszą podróż,\nzaopatrz się w Mikstury w Pokémon\fMart.\rPowodzenia, Trenerze!</language>
	</row>
	<row id="msg_0040_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W skrzynce nie ma żadnej poczty.\r</language>
	</row>
	<row id="msg_0040_00048" index="48">
		<attribute name="window_context_name">garbage</attribute>
