	<row id="msg_0040_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja Torba jest pełna.\rNie można zabrać Griseous Orb, więc\nnie możesz wejść.</language>
	</row>
	<row id="msg_0040_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dane Sali Sław są uszkodzone.\rZostaną naprawione, gdy ponownie\nwejdziesz do Sali Sław.\r</language>
	</row>
	<row id="msg_0040_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) {STRVAR_1 31, 1, 0}!\rAle Fashion Case jest już pełny!</language>
