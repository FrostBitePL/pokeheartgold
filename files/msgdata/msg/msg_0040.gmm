	<row id="msg_0040_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} czuje się lepiej, więc\nzdecydowałeś/aś się zabrać {STRVAR_1 0, 0, 0}\fze sobą!\r</language>
	</row>
	<row id="msg_0040_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej!\rMożesz mi powiedzieć, jak się\nczujesz tuż przed walką? Jak się\fczujesz, gdy wygrywasz lub\nprzegrywasz? Jak to jest być numerem\fjeden? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, powiedz mi, jak się czujesz\nprzed walką!\r</language>
	</row>
	<row id="msg_0040_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, powiedz mi, jak się czujesz\npo wygranej!\r</language>
	</row>
	<row id="msg_0040_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, powiedz mi, jak się czujesz\npo przegranej!\r</language>
	</row>
	<row id="msg_0040_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, powiedz mi, jak to jest być\nnumerem jeden!\r</language>
	</row>
	<row id="msg_0040_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słucham? Nie powiesz? Szkoda...</language>
	</row>
	<row id="msg_0040_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję! Powiesz mi coś jeszcze? {YESNO 0}</language>
	</row>
