	<row id="msg_0040_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} znalazł(a) Lśniący Liść!\r{STRVAR_1 3, 0, 0} położył(a) Lśniący Liść na\n{STRVAR_1 1, 1, 0}!</language>
