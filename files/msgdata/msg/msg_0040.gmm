<?xml version="1.0"?>
<body language="English">
	<row id="msg_0040_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Centrum Pokémon.\rLeczymy twoje zmęczone Pokémony do\npełni zdrowia.\rChcesz, żeby twoje Pokémony\nodpoczęły?{YESNO 0}</language>
	</row>
	<row id="msg_0040_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, zabiorę twoje Pokémony na\nkilka sekund.</language>
	</row>
	<row id="msg_0040_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękujemy za cierpliwość.\rTwoje Pokémony są w pełni zdrowia.\r</language>
	</row>
	<row id="msg_0040_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszamy ponownie o każdej porze!</language>
	</row>
	<row id="msg_0040_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Centrum Pokémon.\rLeczymy twoje zmęczone Pokémony do\npełni zdrowia.\rCzy chciałbyś/chciałabyś...\r</language>
	</row>
	<row id="msg_0040_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">T-ta Karta Trenera!\rCo za wspaniały odcień! I tyle\ngwiazdek!\rWidziałem wielu Trenerów z\nfioletowymi Kartami Trenera...\rAle ty jesteś pierwszy/a, kto ich\nprzebił tak imponującą kartą.\rProszę, {STRVAR_1 3, 0, 0}, czy mogę uleczyć\ntwoje Pokémony? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miło cię widzieć, {STRVAR_1 3, 0, 0}!\rJak zwykle, tak? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z przyjemnością zajmę się twoimi\nPokémonami na kilka sekund.</language>
	</row>
	<row id="msg_0040_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękujemy za cierpliwość.</language>
	</row>
	<row id="msg_0040_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nadzieję, że zobaczymy się\nznowu!</language>
	</row>
	<row id="msg_0040_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje Pokémony mogły zostać zarażone\nPokérusem.\rNiewiele o nim wiadomo, poza tym, że\nto mikroskopijne formy życia, które\fprzyczepiają się do Pokémonów.\rZarażone Pokémony podobno rosną\nwyjątkowo dobrze.</language>
	</row>
	<row id="msg_0040_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} nie ma już Pokémonów\nzdolnych do walki!\r{STRVAR_1 3, 0, 0} traci przytomność!</language>
	</row>
	<row id="msg_0040_00012" index="12">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0040_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chcesz zapisać grę? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapis już istnieje.\rCzy chcesz go nadpisać? {YESNO 0}</language>
	</row>
	<row id="msg_0040_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapisuję...\rNie wyłączaj zasilania.</language>
	</row>
