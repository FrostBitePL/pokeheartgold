<?xml version="1.0"?>
<body language="English">
	<row id="msg_0051_D02R0104_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CLEFAIRY: Pip Pip!</language>
	</row>
	<row id="msg_0051_D02R0104_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Mt. Moon Square.\rProszę, nie śmieć. Wyrzucaj\nśmieci tam, gdzie ich miejsce!</language>
	</row>
	<row id="msg_0051_D02R0104_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} znalazł(a)\n{STRVAR_1 8, 1, 0}!</language>
	</row>
	<row id="msg_0051_D02R0104_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} umieścił(a)\n{STRVAR_1 8, 1, 0} w kieszeni\f{COLOR 2}{STRVAR_1 31, 2, 0}{COLOR 0}.</language>
	</row>
	<row id="msg_0051_D02R0104_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdobyto {STRVAR_1 8, 0, 0}!\rSzkoda!\nTorba jest pełna...</language>
	</row>
	<row id="msg_0051_D02R0104_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteśmy dziś zamknięci.</language>
	</row>
</body>
