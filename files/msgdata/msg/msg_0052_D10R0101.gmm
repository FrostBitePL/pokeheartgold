<?xml version="1.0"?>
<body language="English">
	<row id="msg_0052_D10R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie złapałeś/aś jeszcze wszystkich\nswoich Pokémonów, ale...\rCzy chciałbyś(-abyś) zrezygnować\nz Pokazu Łapania?</language>
	</row>
	<row id="msg_0052_D10R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem...\rJestem rozczarowany, że\nzrezygnowałeś/aś. Nadrób to\fnastępnym razem!\r</language>
	</row>
	<row id="msg_0052_D10R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O to chodzi, {STRVAR_1 3, 0, 0}!\nPodoba mi się, że się nie poddajesz!</language>
	</row>
	<row id="msg_0052_D10R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O to chodzi, {STRVAR_1 3, 0, 0}!\nPodoba mi się, że się nie poddajesz!</language>
	</row>
	<row id="msg_0052_D10R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ding-dong!\nGratulacje!\r{STRVAR_1 3, 0, 0} pomyślnie złapał(a)\ndostarczonego Pokémona!\r</language>
	</row>
	<row id="msg_0052_D10R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chciałbyś(-abyś) zrezygnować?</language>
	</row>
	<row id="msg_0052_D10R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niech zacznie się odliczanie!</language>
	</row>
	<row id="msg_0052_D10R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzy...</language>
	</row>
	<row id="msg_0052_D10R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dwa...</language>
	</row>
	<row id="msg_0052_D10R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden...</language>
	</row>
	<row id="msg_0052_D10R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Start!</language>
	</row>
</body>
