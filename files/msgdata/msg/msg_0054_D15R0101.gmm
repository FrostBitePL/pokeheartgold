<?xml version="1.0"?>
<body language="English">
	<row id="msg_0054_D15R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tylko ci, którzy dotrą na szczyt,\notrzymają wspaniały atak.</language>
	</row>
	<row id="msg_0054_D15R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprout Tower została zbudowana\ndawno temu jako miejsce\ftreningu Pokémonów.</language>
	</row>
	<row id="msg_0054_D15R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BELLSPROUT wysoki na ponad 30 metrów...\rLudzie mówią, że stał się\nśrodkowym filarem tego miejsca.</language>
	</row>
	<row id="msg_0054_D15R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz, jak drży filar?\rLudzie trenują na górze.</language>
	</row>
	<row id="msg_0054_D15R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Posąg Pokémona...\rWygląda bardzo dostojnie.</language>
	</row>
</body>
