	<row id="msg_0062_D22R0101_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ed: Rozmiar Pokémona to nie jedyna\nrzecz, którą porównuje się przy\fwyłanianiu zwycięzcy.</language>
	</row>
