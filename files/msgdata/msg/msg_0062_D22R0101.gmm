	<row id="msg_0062_D22R0101_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">William: Dostałem Pokémona, jakiego\nchciałem, więc jestem bardzo\fszczęśliwy.</language>
	</row>
	<row id="msg_0062_D22R0101_00055" index="55">
