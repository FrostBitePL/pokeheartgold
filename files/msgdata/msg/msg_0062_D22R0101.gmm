<?xml version="1.0"?>
<body language="English">
	<row id="msg_0062_D22R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tylko jeden Pokémon może iść z tobą\nna Spacer w Pokéwalkerze...\rNie mogę się zdecydować, który!</language>
	</row>
	<row id="msg_0062_D22R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może na to nie wyglądam, ale mam\nprzy sobie wiele Pokéwalkerów!\fRobią głośne dźwięki, gdy chodzę.\rMoże Spacer nie jest tak łatwy,\njak myślałem...</language>
	</row>
	<row id="msg_0062_D22R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwaga, proszę!\r...Ojej, muszę przestać myśleć\njak nauczyciel(ka) przez cały czas.\rMusisz być Trenerem Pokémonów.\rSkoro tak ciężko pracujesz, chcę,\nżebyś to miał/a.\r</language>
	</row>
	<row id="msg_0062_D22R0101_00003" index="3">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0062_D22R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niech jakiś Pokémon trzyma ten\nQuick Claw.\rCzasem zaatakuje pierwszy\npodczas walki.</language>
	</row>
	<row id="msg_0062_D22R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fajnie jest wypuścić Pokémona\nz Poké Balla, żeby z nim pospacerować,\fale Pokéwalker to zupełnie nowy\fwymiar.</language>
	</row>
	<row id="msg_0062_D22R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja mama nie może zabrać mi Pokémona\ni mówi mi, żebym się z nim nie\fbawił w domu. Ale hej!\rMogę trzymać go w moim Pokéwalkerze.\nW ten sposób zawsze jestem z nim!</language>
	</row>
	<row id="msg_0062_D22R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spaceruję po parku, ale nigdy\nnie wchodzę w trawę.\rTrenerzy zawsze chcą walczyć...</language>
	</row>
	<row id="msg_0062_D22R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PERSIAN: Fufushaa!</language>
	</row>
	<row id="msg_0062_D22R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hyc, puf, hyc...\rBrak mi...tchu!\nBiegałem, żeby naładować\fPokéwalker!</language>
	</row>
