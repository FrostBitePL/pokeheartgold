	<row id="msg_0062_D22R0101_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don: Czy trafisz na właściwego\nPokémona, to w połowie kwestia\fszczęścia.</language>
	</row>
