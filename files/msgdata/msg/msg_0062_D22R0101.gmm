	<row id="msg_0062_D22R0101_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Abby: Ktoś mi powiedział, że kolorowe\nPokémony mają większe szanse na\fwygraną. Ciekawe, czy to prawda...</language>
	</row>
