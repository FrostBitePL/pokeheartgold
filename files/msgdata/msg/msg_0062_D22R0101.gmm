	<row id="msg_0062_D22R0101_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miejsce Wypoczynku dla Wszystkich\nNational Park</language>
	</row>
	<row id="msg_0062_D22R0101_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co to za ogłoszenie?\rProszę walczyć tylko w trawie parku.\r           National Park\n           Biuro Strażnika</language>
	</row>
	<row id="msg_0062_D22R0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co to za ogłoszenie?\rZabawa piłkami niedozwolona,\nz wyjątkiem Poké Balli.\r           National Park\n           Biuro Strażnika</language>
	</row>
