	<row id="msg_0062_D22R0101_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Benny: Wiesz co?\nZłapałem niedawno SCYTHERA,\fa i tak nie wygrałem...</language>
	</row>
	<row id="msg_0062_D22R0101_00058" index="58">
