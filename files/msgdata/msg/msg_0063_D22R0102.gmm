		<language name="English">Miejsce Wypoczynku dla Wszystkich\nNational Park</language>
	</row>
	<row id="msg_0063_D22R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co to za ogłoszenie?\rProszę walczyć tylko w trawie parku.\rNational Park\nBiuro Strażnika</language>
	</row>
	<row id="msg_0063_D22R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co to za ogłoszenie?\rZabawa piłkami niedozwolona,\nz wyjątkiem Poké Balli.\rNational Park\nBiuro Strażnika</language>
	</row>
	<row id="msg_0063_D22R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don: Zamierzam\nwygrać! Nie\fprzeszkadzaj mi.</language>
	</row>
