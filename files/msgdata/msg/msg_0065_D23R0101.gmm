<?xml version="1.0"?>
<body language="English">
	<row id="msg_0065_D23R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Wieży Radiowej Goldenrod!</language>
	</row>
	<row id="msg_0065_D23R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Wieży Radiowej Goldenrod!\r...A może jednak nie.\nPrzykro mi to mówić, ale nikt nie\fmoże teraz odwiedzić wieży.</language>
	</row>
	<row id="msg_0065_D23R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um, tak. Mówię gościom, żeby wracali\ndo domu, tak jak kazałeś/aś...</language>
	</row>
	<row id="msg_0065_D23R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy specjalną akcję z Quizem!\rOdpowiedz poprawnie na pięć pytań\nz rzędu, by wygrać Kartę Radiową!\rGdy wgrasz ją do Pokégearu, będziesz\nmógł/mogła słuchać radia...\fkiedykolwiek i gdziekolwiek!\rChcesz spróbować naszego Quizu? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwsze pytanie!\rCzy możesz sprawdzić Mapę Miasta\nswoim Pokégearem? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się.\nDrugie pytanie!\rNIDORINA może być tylko samicą.\nPrawda czy fałsz? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się.\nTrzecie pytanie!\rKurt, twórca Poké Balli, używa\nApricornów jako składników? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znów zgadza się.\nCzwarte pytanie!\rNie da się użyć TM na\nMAGIKARPIE. Prawda czy fałsz? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow!\nZostało już tylko jedno pytanie.\rW popularnym programie Profesora Oaka,\nPokémon Talk, występuje on z Marie? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brawo! Udało się!\nGratulacje!\fOto twoja nagroda, Karta Radiowa!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} może teraz słuchać\nradia w Pokégearze!</language>
	</row>
	<row id="msg_0065_D23R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszamy do słuchania naszych\nprogramów radiowych!</language>
	</row>
	<row id="msg_0065_D23R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, kochanie.\nPrzykro mi, ale odpowiedź jest\fbłędna. Spróbuj jeszcze raz!</language>
	</row>
	<row id="msg_0065_D23R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och. Rozumiem.\nWróć do mnie, jeśli zmienisz zdanie.</language>
	</row>
	<row id="msg_0065_D23R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Cześć!\nNazywam się Whitney!\rSłyszałam o Quizie na Kartę Radiową,\nwięc przyszłam po jedną...\rAle ten Quiz jest taki trudny!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Wow, udało ci się!\nA ja byłam pewna, że odpowiedzią na\ftrzecie pytanie są Apricorny!\rOjej!\nCzas wracać do Sali!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben to niesamowity DJ!\nJego słodki głos po prostu mnie rozczula!</language>
	</row>
	<row id="msg_0065_D23R0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbiam Mary z Pokémon Talk.\rChoć wiem tylko, jak brzmi\njej głos!</language>
	</row>
	<row id="msg_0065_D23R0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kim jesteś?\nMamy tu pewien interes do załatwienia.\rKazano mi nie wpuszczać nikogo poza\nTeam Rocket!\rRozumiesz?\rMożesz przejść tylko wtedy, gdy masz\nna sobie ten fajny, czarny mundur\fTeam Rocket!</language>
	</row>
	<row id="msg_0065_D23R0101_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha! Musisz być nowy/a!\nNieźle wyglądasz w mundurze\fTeam Rocket!\rIdź dalej!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co ty robisz?\nIdź na górę i zajmij swoje stanowisko!</language>
	</row>
	<row id="msg_0065_D23R0101_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0}: Hej, Team Rocket!\rPrzestańcie się tak grupować i\nnękać ludzi. Tchórze!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0}: ...Huh?\nCzy ty jesteś {STRVAR_1 3, 0, 0}?\fCo tu robisz?\rNie wierzę... Myślisz, że jesteś\nsilny/a, skoro wyglądasz jak oni?\rTo głupota!\nNie powinieneś/aś nosić czegoś takiego!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? To ty!\nNie jesteś nowy/a?\fW takim razie walcz ze mną!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś zbyt silny/a.\rMożesz zniszczyć nasz plan.\nMuszę poinformować pozostałych...\r</language>
	</row>
	<row id="msg_0065_D23R0101_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0}: Rozumiem.\nPróbowałeś/aś być sprytny/a...\rHa!\nTypowy pomysł słabeusza!\rNieważne.\nZostawię to tobie.\rMuszę pokonać Poskramiacza Smoków...\nJak on się nazywał...? Lance!\rPo tym...przyjdzie kolej na ciebie.\nBądź gotowy/a!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1P Recepcja\n2P Sprzedaż\f3P Kadry\f4P Produkcja\f5P Biuro Dyrektora\f6P Taras Widokowy</language>
	</row>
	<row id="msg_0065_D23R0101_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szczęśliwy Kanał!\nWygrywaj dzięki numerom ID Pokémonów!\rWymieniaj się Pokémonami, by zbierać\nróżne numery ID!</language>
	</row>
	<row id="msg_0065_D23R0101_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Kącik Loterii Pokémon.\nNazywam się Felicity, dziś ci pomogę.\rJeśli wylosowany numer pasuje do\nnumeru ID jednego z twoich Pokémonów,\fmożesz wygrać wspaniałe nagrody.\rChcesz sprawdzić dzisiejszy\nszczęśliwy numer? {YESNO 0}</language>
	</row>
	<row id="msg_0065_D23R0101_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wylosowałeś/aś już dziś Los Loteryjny.\nWróć jutro.</language>
	</row>
	<row id="msg_0065_D23R0101_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och. Rozumiem.\nProszę, odwiedź nas znowu.</language>
	</row>
	<row id="msg_0065_D23R0101_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najpierw sprawdzę dzisiejszy szczęśliwy\nnumer Kącika Loterii Pokémon.\r...\r</language>
	</row>
	<row id="msg_0065_D23R0101_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Numer twojego Losu Loteryjnego to\n{STRVAR_1 54, 0, 0}.\rZobaczmy teraz, czy pasuje do numeru\nID jednego z twoich Pokémonów.\r</language>
	</row>
	<row id="msg_0065_D23R0101_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje!\rNumer ID twojego {STRVAR_1 1, 0, 0}\nz drużyny pasuje do numeru Losu\fLoteryjnego!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje!\rNumer ID twojego {STRVAR_1 1, 0, 0}\nz PC pasuje do numeru Losu\fLoteryjnego!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi.\nNie trafiłeś/aś...</language>
	</row>
	<row id="msg_0065_D23R0101_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnia cyfra się zgadza, więc\nwygrywasz czwartą nagrodę!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdobyłeś/aś nowe Tło do użycia\nw Przymierzalniach.</language>
	</row>
	<row id="msg_0065_D23R0101_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnie dwie cyfry się zgadzają,\nwięc wygrywasz trzecią nagrodę!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnie trzy cyfry się zgadzają,\nwięc wygrywasz drugą nagrodę!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnie cztery cyfry się zgadzają,\nwięc wygrywasz pierwszą nagrodę!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O mój Boże, wszystkie pięć cyfr\nsię zgadza!\rWygrałeś/aś nagrodę główną!\nTo po prostu niesamowite!\r...Och, przepraszam! Twoja nagroda!\nTrochę mnie poniosło.\rProszę bardzo!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Och?\nWygląda na to, że nie masz na to miejsca.\rProszę, zrób miejsce w plecaku\ni daj mi znać.</language>
	</row>
	<row id="msg_0065_D23R0101_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}?\nTak, czekałam na ciebie.\rTo nagroda, którą dla ciebie\ntrzymaliśmy. Proszę bardzo!\r</language>
	</row>
	<row id="msg_0065_D23R0101_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszam ponownie!\nDo widzenia, tu Felicity, twoja obsługa!</language>
	</row>
	<row id="msg_0065_D23R0101_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Kącik Loterii Pokémon.\rChcesz ponownie sprawdzić dzisiejszy\nszczęśliwy numer? {YESNO 0}</language>
	</row>
</body>
