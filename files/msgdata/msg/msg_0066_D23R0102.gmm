<?xml version="1.0"?>
<body language="English">
	<row id="msg_0066_D23R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Radio jest fajne, wiesz?\rFajna muzyka i informacje o Pokémonach...\nZaskakujące wiadomości i wzruszające\fdramaty...\fMa wszystko!\rJedyne, czego brakuje, to obraz.\r..................\nOjej, to się chyba nazywa telewizja!</language>
	</row>
	<row id="msg_0066_D23R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kołysanki w radiu usypiają dzikie\nPokémony.\rDlatego nie widać wielu Pokémonów,\ngdy radio gra kołysanki w wysokiej\ftrawie.</language>
	</row>
	<row id="msg_0066_D23R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu chcieliby przejąć\nWieżę Radiową?</language>
	</row>
	<row id="msg_0066_D23R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">JIGGLYPUFF: Jiggly...</language>
	</row>
	<row id="msg_0066_D23R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi. Dalej tylko dla\nupoważnionego personelu.\rWcześniej tak nie było. Coś jest nie\ntak z Dyrektorem...</language>
	</row>
	<row id="msg_0066_D23R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz swobodnie się rozglądać.\nDyrektor jest znów miły, tak jak\fkiedyś.</language>
	</row>
	<row id="msg_0066_D23R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">2P Sprzedaż</language>
	</row>
	<row id="msg_0066_D23R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon Talk z Profesorem Oakiem\nNajgorętszy Program na Antenie!</language>
	</row>
	<row id="msg_0066_D23R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">2P Studio 2</language>
	</row>
	<row id="msg_0066_D23R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Huh?\nDzisiejsze hasło?\rPOMOC, oczywiście!</language>
	</row>
	<row id="msg_0066_D23R0102_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Cześć! Jestem Buena!\rZnasz program radiowy pod nazwą\nHasło Bueny?\rJeśli powiesz mi hasło z programu,\nzdobędziesz punkty.\rZbieraj punkty i wymieniaj je\nu tej słodkiej młodej damy tam,\fby dostać wspaniałe nagrody!\rProszę bardzo!\nTo twoja własna karta punktowa!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Dziękuję, że słuchacie mnie\ncodziennie!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: {STRVAR_1 3, 0, 0}!\nDziękuję, że słuchasz mojego programu!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: {STRVAR_1 3, 0, 0}!\nDziękuję, że słuchasz mojego programu!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Pamiętasz dzisiejsze\nhasło? {YESNO 0}</language>
	</row>
	<row id="msg_0066_D23R0102_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Och, wow! Dziękuję!\nJak brzmiało twoje imię?\r...{STRVAR_1 3, 0, 0}!\rChodź, {STRVAR_1 3, 0, 0}.\nDołącz do programu.\r</language>
	</row>
	<row id="msg_0066_D23R0102_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Och, wow! Dziękuję!\nJak brzmiało twoje imię?\r...{STRVAR_1 3, 0, 0}!\rChodź, {STRVAR_1 3, 0, 0}.\nDołącz do programu.\r</language>
	</row>
	<row id="msg_0066_D23R0102_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Dzięki, {STRVAR_1 3, 0, 0}!\rDołącz do programu, tak jak zawsze!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Dzięki, {STRVAR_1 3, 0, 0}!\rDołącz do programu, tak jak zawsze!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Wróć po wysłuchaniu mojego\nprogramu, dobra? Do zobaczenia!</language>
	</row>
	<row id="msg_0066_D23R0102_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Wszyscy gotowi?\rChcę usłyszeć, jak wykrzykujecie\ndzisiejsze hasło dla {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Wszyscy gotowi?\rChcę usłyszeć, jak wykrzykujecie\ndzisiejsze hasło dla {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Juhu! Zgadza się!\rSłuchałeś/aś! Jestem taka szczęśliwa!\nZdobyłeś/aś jeden punkt! Gratulacje!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Aww... To nie to...\nZapomniałeś/aś hasła?</language>
	</row>
	<row id="msg_0066_D23R0102_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Och! Twoja Niebieska Karta\nosiągnęła dziś 30 punktów! Niesamowite!\rHmm... Przychodzisz tak często,\n{STRVAR_1 3, 0, 0}, zrobię ci\fspecjalną ofertę!\rCo powiesz na mój numer telefonu?\r</language>
	</row>
	<row id="msg_0066_D23R0102_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Och! Twoja Niebieska Karta\nosiągnęła dziś 30 punktów! Niesamowite!\rHmm... Przychodzisz tak często,\n{STRVAR_1 3, 0, 0}, zrobię ci\fspecjalną ofertę!\rCo powiesz na mój numer telefonu?\r</language>
	</row>
	<row id="msg_0066_D23R0102_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Buenę\nw Pokégearze!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Nie mogę się doczekać\ntwojego telefonu!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Słuchaj mojego programu z hasłem!</language>
	</row>
	<row id="msg_0066_D23R0102_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Przykro mi...\nMasz tylko jedną szansę dziennie.\rWróć jutro po kolejną próbę!</language>
	</row>
	<row id="msg_0066_D23R0102_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Twój plecak jest pełny!</language>
	</row>
	<row id="msg_0066_D23R0102_00031" index="31">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0066_D23R0102_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buena: Słuchaj mojego programu\nznów jutro!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbieraj punkty Niebieskiej Karty,\nby zdobyć wspaniałe nagrody!</language>
	</row>
	<row id="msg_0066_D23R0102_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja suma punktów na Niebieskiej\nKarcie wynosi teraz {STRVAR_1 51, 0, 0}.</language>
	</row>
	<row id="msg_0066_D23R0102_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje!\rTwoja suma punktów wynosi teraz\n{STRVAR_1 51, 0, 0}. Nagrodą jest {STRVAR_1 8, 1, 0}. Proszę bardzo!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Punkty na twojej Niebieskiej Karcie\nosiągnęły maksimum.\fDam ci nową kartę!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Otrzymano nową Niebieską Kartę!</language>
	</row>
	<row id="msg_0066_D23R0102_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę, dołącz do programu znowu!\r</language>
	</row>
	<row id="msg_0066_D23R0102_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ktoś musi w końcu zlać ten podły\nTeam Rocket!\fTak jak trzy lata temu!</language>
	</row>
