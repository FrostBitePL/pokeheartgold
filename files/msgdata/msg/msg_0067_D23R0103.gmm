<?xml version="1.0"?>
<body language="English">
	<row id="msg_0067_D23R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nagrania odgłosów wielu\nznalezionych Pokémonów.\rMusimy mieć jakieś 200 rodzajów.</language>
	</row>
	<row id="msg_0067_D23R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dla Trenerów, Pokémony są ich\nukochanymi partnerami.\rTo okropne, jak Team Rocket próbuje\nkontrolować Pokémony.</language>
	</row>
	<row id="msg_0067_D23R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Działamy 24 godziny na dobę, by\nnadawać rozrywkowe programy.\rJa też będę się starać działać\nprzez całą dobę!</language>
	</row>
	<row id="msg_0067_D23R0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szef Team Rocket zamknął się\nod środka.\rAle Dyrektor może to otworzyć.\rJest na piątym piętrze.\nProszę, uratuj go!</language>
	</row>
	<row id="msg_0067_D23R0103_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy Dyrektor jest bezpieczny?</language>
	</row>
	<row id="msg_0067_D23R0103_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję, dzieciaku! Jesteś\nnajlepszy/a! To wyraz mojej wdzięczności.\r</language>
	</row>
	<row id="msg_0067_D23R0103_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) TM11!</language>
	</row>
	<row id="msg_0067_D23R0103_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Słoneczny Dzień.\nWzmacnia ataki typu Ognisty\fna jakiś czas.</language>
	</row>
	<row id="msg_0067_D23R0103_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, twój plecak jest pełny.</language>
	</row>
	<row id="msg_0067_D23R0103_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłeś/aś po prostu wspaniały/a!</language>
	</row>
	<row id="msg_0067_D23R0103_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drzwi są zamknięte...\nPotrzebujesz Karty-Klucza.</language>
	</row>
	<row id="msg_0067_D23R0103_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To gniazdo na Kartę-Klucz.\r</language>
	</row>
	<row id="msg_0067_D23R0103_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} włożył(a) Kartę-Klucz.\r</language>
	</row>
	<row id="msg_0067_D23R0103_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powinieneś/aś móc otworzyć drzwi\nKartą-Kluczem!</language>
	</row>
	<row id="msg_0067_D23R0103_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To gniazdo na Kartę-Klucz.</language>
	</row>
	<row id="msg_0067_D23R0103_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">3P Kadry</language>
	</row>
	<row id="msg_0067_D23R0103_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon Music, prowadzi: DJ Ben</language>
	</row>
</body>
