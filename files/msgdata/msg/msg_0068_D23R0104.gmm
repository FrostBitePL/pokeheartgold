<?xml version="1.0"?>
<body language="English">
	<row id="msg_0068_D23R0104_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słuchałem radia, będąc przy\nruinach.\rSłyszałem tam dziwną audycję.</language>
	</row>
	<row id="msg_0068_D23R0104_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: Dlaczego? Dlaczego muszę\nprzez to przechodzić?\rMEOWTH, pomóż mi!</language>
	</row>
	<row id="msg_0068_D23R0104_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: Och! Jesteś moim małym wybawcą!\nWeźmiesz to w podziękowaniu?\r</language>
	</row>
	<row id="msg_0068_D23R0104_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) Bright\nPowder od Mary!</language>
	</row>
	<row id="msg_0068_D23R0104_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: Gdy Pokémon je trzyma, obniża\nto celność przeciwnika.</language>
	</row>
	<row id="msg_0068_D23R0104_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieee! Twój plecak jest pełny!</language>
	</row>
	<row id="msg_0068_D23R0104_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mary: Proszę, słuchajcie mnie\nw programie Profesora Oaka, Pokémon Talk.</language>
	</row>
	<row id="msg_0068_D23R0104_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MEOWTH: Meowth...</language>
	</row>
	<row id="msg_0068_D23R0104_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">4P Produkcja</language>
	</row>
	<row id="msg_0068_D23R0104_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">4P Studio 1</language>
	</row>
	<row id="msg_0068_D23R0104_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben: Team Rocket... Czegoś im brakuje.\nTo muzyka!\rMuzyka wzbogaca serce i duszę\nczłowieka.\rMiłośnicy muzyki nigdy nie zrobiliby\nczegoś tak okropnego w miejscu takim\fjak Wieża Radiowa!</language>
	</row>
	<row id="msg_0068_D23R0104_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ben: Słuchasz naszej muzyki?</language>
	</row>
	<row id="msg_0068_D23R0104_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proton, dowódca tej misji w Wieży\nRadiowej... Jest taki fajny.\r</language>
	</row>
	<row id="msg_0068_D23R0104_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kim jesteś?\rJeśli stajesz na drodze Protonowi...\nchodzi mi o Team Rocket. Na to nie pozwolę!\r</language>
	</row>
	<row id="msg_0068_D23R0104_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team Rocket i Proton to wszystko,\nczego potrzebuję!\rKogo obchodzą Pokémony?</language>
	</row>
</body>
