<?xml version="1.0"?>
<body language="English">
	<row id="msg_0069_D23R0105_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ehem, słyszycie mnie?\r...Jestem Dyrektorem.\rPostanowiliśmy nadawać wspaniałe\nprogramy wychwalające Team Rocket!\rWszyscy, nie chcę słyszeć narzekań.\nPo prostu wykonujcie dobrze swoją\frobotę, żeby...\r</language>
	</row>
	<row id="msg_0069_D23R0105_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej!\nJestem zajęty udawaniem...\fKim jesteś?\r</language>
	</row>
	<row id="msg_0069_D23R0105_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Och nie, to znowu ty, {STRVAR_1 3, 0, 0}?\r</language>
	</row>
	<row id="msg_0069_D23R0105_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Petrel: Nie, nie, nie! Udawałem\nDyrektora, żeby wpłynąć na cały\fregion, by wspierał Team Rocket!\rTym razem się nie powstrzymam!\nPokaż, na co cię stać!\r</language>
	</row>
	<row id="msg_0069_D23R0105_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Petrel: Słuchaj uważnie.\rSchowaliśmy prawdziwego Dyrektora\nw podziemnym magazynie.\rJest na samym końcu Goldenrod\nTunnel.\rJestem miłym facetem. Dam ci Klucz\ndo Piwnicy, żebyś mógł/mogła dostać\fsię do podziemnego magazynu.\fWeź go z wdzięcznością!\r</language>
	</row>
	<row id="msg_0069_D23R0105_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Petrel: Schowaliśmy Dyrektora\nw podziemnym magazynie.\rJest na samym końcu Goldenrod\nTunnel.\rHahaha...\nWątpię, żeby dziecko takie jak ty\fzaszło aż tak daleko.</language>
	</row>
	<row id="msg_0069_D23R0105_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dyrektor: Witaj, to ty! Wiesz,\nnaprawdę kocham Pokémony.\rZbudowałem tę Wieżę Radiową tylko po\nto, by wyrazić moją miłość do nich.\rByłoby miło, gdyby ludzie cieszyli\nsię naszymi programami.</language>
	</row>
	<row id="msg_0069_D23R0105_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">5P Biuro Dyrektora</language>
	</row>
	<row id="msg_0069_D23R0105_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Idź w górę do Tarasu Widokowego</language>
	</row>
</body>
