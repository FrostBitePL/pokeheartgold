<?xml version="1.0"?>
<body language="English">
	<row id="msg_0072_D24R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hm? To Pokédex, prawda?\nMogę zobaczyć?\rJest tak wiele rodzajów Pokémonów.\nHm? Co to jest?\rCo to za Pokémon?\nWygląda jak dziwne pismo na\fścianach ruin.\rJeśli te rysunki to naprawdę\nPokémony, powinno być ich o wiele\fwięcej.\rWiem! Pozwól, że ulepszę twój\nPokédex. Chodź za mną.\r</language>
	</row>
	<row id="msg_0072_D24R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Au!\r</language>
	</row>
	<row id="msg_0072_D24R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystko w porządku?\nŚpieszyłem się i...\fPrzepraszam, zraniłem cię?\r</language>
	</row>
	<row id="msg_0072_D24R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie może być!\nCzy to może być Pokémon z Sinnoh...\fTen, którego nazywają ARCEUS...?\r</language>
	</row>
	<row id="msg_0072_D24R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, czy to może być...?\nARCEUS powoduje to wszystko...?\rNie potrafię tego wytłumaczyć\ninaczej...\r</language>
	</row>
	<row id="msg_0072_D24R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ARCEUS może być kluczem do\nrozwiązania tajemnicy UNOWN\fi Ruins of Alph...?\r</language>
	</row>
	<row id="msg_0072_D24R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz pójść ze mną do Ruins of\nAlph? Proszę! Musisz!\rTrzęsę się z ekscytacji.\nMyślę, że coś zaraz się wydarzy!\r</language>
	</row>
	<row id="msg_0072_D24R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruins of Alph.\rGoście zainteresowani archeologią\nsą mile widziani.</language>
	</row>
	<row id="msg_0072_D24R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruins of Alph.\rŚmiało zwiedzaj ruiny i zostań\nprofesorem od skamieniałości!</language>
	</row>
	<row id="msg_0072_D24R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Centrum Badań nad Ruinami</language>
	</row>
	<row id="msg_0072_D24R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To tajemnicza sala.\nProszę, uważaj, gdzie stawiasz kroki.</language>
	</row>
</body>
