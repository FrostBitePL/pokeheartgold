<?xml version="1.0"?>
<body language="English">
	<row id="msg_0074_D24R0202_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w tej komnacie!\rOdbudowujemy starożytne kamienne\npanele z Pokémonami.\rMożesz obracać elementy kamiennych\npaneli, dotykając ich przez chwilę.\rJeśli dotkniesz elementu i przesuniesz\ngo, możesz go przemieszczać.\rMyślimy, że powinniśmy zdołać umieścić\nje z powrotem tam, gdzie były...</language>
	</row>
	<row id="msg_0074_D24R0202_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odbudowałeś/aś kamienny panel?\rTo wspaniale!\nMamy tu geniusza archeologii!</language>
	</row>
	<row id="msg_0074_D24R0202_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0074_D24R0202_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nic się nie stało...</language>
	</row>
</body>
