<?xml version="1.0"?>
<body language="English">
	<row id="msg_0086_D24R0218_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To replika starożytnego Pokémona.</language>
	</row>
	<row id="msg_0086_D24R0218_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm.\rBadam te ruiny od wielu lat, ale\ncoś wydaje się...inne.\r</language>
	</row>
	<row id="msg_0086_D24R0218_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow!\rObrazy UNOWN na ścianie...\rMam wrażenie, że się na mnie gapią!\r</language>
	</row>
	<row id="msg_0086_D24R0218_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co to jest?\nJest tu coś niesamowitego, co\fsprawia, że drżą mi nogi.\fNie mogę tego powstrzymać!\r</language>
	</row>
	<row id="msg_0086_D24R0218_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, wszystko w porządku?\nZniknąłeś/aś tuż przede mną, i to\fsprawiło, że byłem tak zaskoczony!\r</language>
	</row>
	<row id="msg_0086_D24R0218_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem.\rMoc ARCEUSA i UNOWN wpłynęły na\nsiebie nawzajem, tworząc ogromną\fenergię, która wysłała cię do\fSinjoh Ruins...?\rUNOWN, Ruins of Alph i ARCEUS...\fTajemnica się pogłębia...\rTo sprawiło, że jestem jeszcze\nbardziej ciekawy!\rPewnego dnia rozwiążę wszystkie\ntajemnice!\r</language>
	</row>
</body>
