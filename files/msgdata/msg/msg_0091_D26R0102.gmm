<?xml version="1.0"?>
<body language="English">
	<row id="msg_0091_D26R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: Tak trzymaj, {STRVAR_1 3, 0, 0}!\rTeam Rocket uciekł.\rMoje plecy też są już lepiej.\nWynośmy się stąd.\r</language>
	</row>
	<row id="msg_0091_D26R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proton: A cóż my tu mamy?\rCzęsto nazywają mnie najstraszniejszym\ni najokrutniejszym gościem w Team\fRocket...\rGorąco radzę ci, żebyś nie mieszał/a\nsię w nasze sprawy!\r</language>
	</row>
	<row id="msg_0091_D26R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proton: Hmf...\nTeam Rocket faktycznie rozpadł się\ftrzy lata temu. Ale my kontynuowaliśmy\fnaszą działalność w podziemiu.\rTaka drobna przeszkoda jak ty nie\nbędzie większym problemem dla naszej\fmisji.\rRadzę ci bać się tego, co nadchodzi!\r</language>
	</row>
	<row id="msg_0091_D26R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SLOWPOKE z odciętym ogonem...\rHę? Ma przy sobie Mail. Przeczytać\ngo? {YESNO 0}</language>
	</row>
	<row id="msg_0091_D26R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} przeczytał(a) Mail.\rBądź grzeczny/a i zajmij się domem\nrazem z Dziadkiem i SLOWPOKE.\f           Z miłością, Tata</language>
	</row>
	<row id="msg_0091_D26R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SLOWPOKE z odciętym ogonem...</language>
	</row>
</body>
