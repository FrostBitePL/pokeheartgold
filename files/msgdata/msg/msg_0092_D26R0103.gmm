<?xml version="1.0"?>
<body language="English">
	<row id="msg_0092_D26R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekam, żeby zobaczyć moment ewolucji\nSLOWPOKE. Dzięki obserwacji dokonałem\fnowego odkrycia.\rSLOWPOKE trzymający King’s Rock\nczęsto zostaje ugryziony przez\fSHELLDERA.\rProszę, podzielę się z tobą\nKing’s Rock.</language>
	</row>
	<row id="msg_0092_D26R0103_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0092_D26R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będę jak SLOWPOKE.\rBędę cierpliwie czekać, żeby zobaczyć,\njak jeden z nich ewoluuje.</language>
	</row>
</body>
