<?xml version="1.0"?>
<body language="English">
	<row id="msg_0093_D27R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ludzie trenują w tej Latarni\nMorskiej.\rNiełatwo się wspiąć przez\nwszystkich tych Trenerów.</language>
	</row>
	<row id="msg_0093_D27R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W przeszłości Pokémony oświetlały\nnocą morze wokół Olivine.\rLatarnia Morska została zbudowana,\nby oddać hołd tym Pokémonom.</language>
	</row>
</body>
