<?xml version="1.0"?>
<body language="English">
	<row id="msg_0094_D27R0107_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: ...Ten Pokémon zawsze\noświetlał morze nocą.\r...Ale nagle zachorował...\nŁapie oddech...\r...Wiem, że w Cianwood jest\nwspaniała apteka...\rAle to za morzem...\nA nie mogę zostawić Ampiego\fbez opieki...\r</language>
	</row>
	<row id="msg_0094_D27R0107_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Czy mogę cię prosić, żebyś\nzdobył dla mnie jakieś lekarstwo?\fProszę?\r</language>
	</row>
	<row id="msg_0094_D27R0107_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: ...Czy to lekarstwo\nwyleczy Ampiego? {YESNO 0}</language>
	</row>
	<row id="msg_0094_D27R0107_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} wręczył(a) Tajemny\nEliksir Jasmine.</language>
	</row>
	<row id="msg_0094_D27R0107_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: ...Yym, proszę się nie\nobrażaj...\rAmpi nie przyjmie niczego od\nnikogo poza mną...\r</language>
	</row>
	<row id="msg_0094_D27R0107_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: ...\rAmpi, jak się czujesz?\r</language>
	</row>
	<row id="msg_0094_D27R0107_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ampi: Palu!\nPalulu!\r</language>
	</row>
	<row id="msg_0094_D27R0107_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: ...Och, tak mi ulżyło...\nTo po prostu wspaniałe...\rBardzo, bardzo ci dziękuję.\n...Wracam do Sali...\r</language>
	</row>
	<row id="msg_0094_D27R0107_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: ...Rozumiem...\r</language>
	</row>
	<row id="msg_0094_D27R0107_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Ampi, trzymaj się!\r</language>
	</row>
	<row id="msg_0094_D27R0107_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ampi: ...\n...Pa...palu...\r</language>
	</row>
	<row id="msg_0094_D27R0107_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego oddech jest płytki...</language>
	</row>
	<row id="msg_0094_D27R0107_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ampi: Palu!\nPalulu!</language>
	</row>
</body>
