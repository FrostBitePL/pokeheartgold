	</row>
	<row id="msg_0096_D31R0201_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje z okazji osiągnięcia rangi\n{STRVAR_1 51, 0, 0}. Twoja zwycięska drużyna\fPokémonów zdobyła specjalne\fWstążki za ten wyczyn!</language>
	</row>
