	<row id="msg_0096_D31R0201_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chcesz skomunikować się\nz przyjacielem i zawiązać drużynę\ftag team? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden Trener powinien wybrać\n„ZOSTAŃ LIDEREM”.\rDrugi Trener musi wybrać\n„DOŁĄCZ DO GRUPY”. {YESNO 0}</language>
	</row>
