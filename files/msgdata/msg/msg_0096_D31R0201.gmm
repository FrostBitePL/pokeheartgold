	<row id="msg_0096_D31R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierz Pokémony, które chcesz\nzgłosić.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystkie twoje Pokémony muszą\nbyć różne.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzymane przedmioty muszą\nbyć różne.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz zaprowadzę cię do Sali Battle Room.</language>
	</row>
	<row id="msg_0096_D31R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje!\nPokonałeś/aś wszystkich siedmiu\fTrenerów!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje!\nPokonałeś/aś Tower Tycoona!\rWręczamy ci te Punkty Walki\nw uznaniu twojego talentu!\r{STRVAR_1 3, 0, 0} otrzymał/a\n{STRVAR_1 50, 1, 0} BP!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapisywanie...\nNie wyłączaj zasilania.</language>
	</row>
	<row id="msg_0096_D31R0201_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nadzieję, że wrócisz.</language>
	</row>
	<row id="msg_0096_D31R0201_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekaliśmy na ciebie!\rZanim wejdziesz do Sali Battle Room,\ntwój postęp zostanie zapisany.\fProszę czekać.</language>
	</row>
	<row id="msg_0096_D31R0201_00017" index="17">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
