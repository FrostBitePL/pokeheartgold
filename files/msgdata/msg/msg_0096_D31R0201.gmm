		<language name="English"></language>
		<language name="日本語">XXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam!\rNie zapisałeś/aś gry, zanim ostatnio\nzakończyłeś/aś wyzwanie.\rZ tego powodu zostałeś/aś\nzdyskwalifikowany/a z wyzwania!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Battle Tower!\rJestem twoim przewodnikiem po\nSalach Multi Battle.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chcesz podjąć wyzwanie\nSali Multi Battle? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00022" index="22">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0096_D31R0201_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sale Multi Battle w Battle Tower\nsłużą do Multi Battle z partnerem.\rBy wystartować, dołącz do innego\nTrenera i walczcie po dwa Pokémony\fkażdy.\rWewnątrz wieży znajduje się sala\nzwana Battle Salon, gdzie możesz\fspotkać innych Trenerów.\rTam możesz znaleźć Trenera, który\nzostanie twoim partnerem w Multi\fBattle.\rMożesz też zawiązać drużynę\nz przyjacielem przez komunikację\fbezprzewodową.\rGdy już zawiążecie drużynę,\nzostaniecie zaprowadzeni do Sali\fMulti Battle.\rW Sali Multi Battle czeka na wasze\nwyzwanie siedem drużyn tag team.\rJeśli uda wam się pokonać wszystkie\nsiedem drużyn, zdobędziecie Punkty\fWalki.\rJeśli chcecie przerwać wyzwanie,\nzapiszcie grę.\rJeśli tego nie zrobicie, zostaniecie\nzdyskwalifikowani z wyzwania.\rPoza tym, jeśli jesteście w drużynie\ntag team z przyjacielem, nie możecie\fprzerwać wyzwania.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00024" index="24">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
