<?xml version="1.0"?>
<body language="English">
	<row id="msg_0096_D31R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Battle Tower!\rJestem twoim przewodnikiem po\nSalach Single i Double Battle.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chcesz podjąć wyzwanie\nSali Battle Room? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nadzieję, że wrócisz!</language>
	</row>
	<row id="msg_0096_D31R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle Tower to obiekt do wyzwań\nSingle lub Double Battle.\rGdy już przystąpisz, twoje wyzwanie\ntrwa aż do przegranej.\rW formacie Single Battle zgłaszasz\ntrzy Pokémony.\rW formacie Double Battle zgłaszasz\ncztery Pokémony.\rWalki odbywają się w Salach Battle\nRoom, których w wieży jest wiele.\rW każdej Sali Battle Room czeka\nna twoje wyzwanie siedmiu Trenerów.\rJeśli uda ci się pokonać wszystkich\nsiedmiu, zdobędziesz Punkty Walki (BP).\rJeśli chcesz przerwać wyzwanie,\nzapisz grę.\rJeśli tego nie zrobisz, zostaniesz\nzdyskwalifikowany/a z wyzwania.\rPamiętaj o tym!\r</language>
	</row>
	<row id="msg_0096_D31R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Którą Salę Battle Room wybierasz?\nSingle czy Double? {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
