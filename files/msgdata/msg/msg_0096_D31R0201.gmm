	<row id="msg_0096_D31R0201_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pobrałem historię poprzednich liderów\nSali Battle Room rangi {STRVAR_1 51, 0, 0},\f{STRVAR_1 52, 1, 0}.\rPotwierdź to na Monitorze Wyników\nobok mnie.</language>
