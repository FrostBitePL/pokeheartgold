	<row id="msg_0096_D31R0201_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardzo dziękujemy za udział!\nZapraszamy ponownie!</language>
	</row>
	<row id="msg_0096_D31R0201_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na to, że nie ma jeszcze\nżadnych danych...</language>
	</row>
	<row id="msg_0096_D31R0201_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Komunikacja bezprzewodowa DS\nzostanie uruchomiona. {YESNO 0}</language>
	</row>
	<row id="msg_0096_D31R0201_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekamy na twoją kolejną wizytę.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz mówić do mnie Sędzia.\rHeheh, to tak naprawdę nie moje\nprawdziwe imię, ale tak wszyscy\fmnie nazywają.\rTo przez tę moją dziwną moc.\nTo prawdziwy dar.\rPotrafię rozpoznać--osądzić, można\npowiedzieć--ogólny potencjał\fposzczególnych Pokémonów.\rJeśli chcesz, mógłbym osądzić\nintrygujący potencjał twojego\fPokémona.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chcesz, mógłbym osądzić\nintrygujący potencjał twojego\fPokémona.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Ach.\nNie potrzebujesz mojej oceny. Rozumiem.</language>
	</row>
	<row id="msg_0096_D31R0201_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Osądzić Jajko?!\nTo trudne zadanie nawet dla mnie.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem, rozumiem...\rPotencjał tego Pokémona jest\nprzyzwoity we wszystkich aspektach.\rTaki jest mój osąd i jest ostateczny.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem, rozumiem...\rPotencjał tego Pokémona jest\npowyżej przeciętnej we wszystkich\faspektach.\rTaki jest mój osąd i jest ostateczny.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem, rozumiem...\rTen Pokémon ma stosunkowo wysoki\npotencjał we wszystkich aspektach.\rTaki jest mój osąd i jest ostateczny.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem, rozumiem...\rTen Pokémon ma znakomity potencjał\nwe wszystkich aspektach.\rTaki jest mój osąd i jest ostateczny.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swoją drogą, powiedziałbym, że\nnajlepszy potencjał tkwi w jego HP.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swoją drogą, powiedziałbym, że\nnajlepszy potencjał tkwi w jego Ataku.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swoją drogą, powiedziałbym, że\nnajlepszy potencjał tkwi w jego Obronie.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swoją drogą, powiedziałbym, że\nnajlepszy potencjał tkwi w jego\fAtaku Specjalnym.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swoją drogą, powiedziałbym, że\nnajlepszy potencjał tkwi w jego\fObronie Specjalnej.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swoją drogą, powiedziałbym, że\nnajlepszy potencjał tkwi w jego Szybkości.\r</language>
	</row>
	<row id="msg_0096_D31R0201_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest w tym całkiem przyzwoity.\nTak go osądziłem.</language>
	</row>
	<row id="msg_0096_D31R0201_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest w tym bardzo dobry.\nTak go osądziłem.</language>
	</row>
	<row id="msg_0096_D31R0201_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest w tym fantastyczny.\nTak go osądziłem.</language>
	</row>
	<row id="msg_0096_D31R0201_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mógłby być w tym lepszy.\nTak go osądziłem.</language>
	</row>
	<row id="msg_0096_D31R0201_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uczestniczący Pokémon otrzyma\nWstążkę!</language>
