<?xml version="1.0"?>
<body language="English">
	<row id="msg_0101_D32FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niektórzy Trenerzy polegają wyłącznie\nna potencjale Pokémona. Ale możesz\fużywać przedmiotów i lekarstw, by\fpoprawić możliwości Pokémona.</language>
	</row>
	<row id="msg_0101_D32FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wspinaczka górska i Pokémony są\nw pewnym sensie podobne.\rObie sprowadzają się do potencjału!\rNie polegam na przedmiotach ani\nlekarstwach, tylko na potencjale\fi treningu przed walką!</language>
	</row>
</body>
