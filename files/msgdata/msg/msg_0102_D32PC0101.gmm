<?xml version="1.0"?>
<body language="English">
	<row id="msg_0102_D32PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strój karateki to strój wojownika!\rNic nie nadaje się lepiej na wyprawę\ndo Battle Frontier niż właśnie to!</language>
	</row>
	<row id="msg_0102_D32PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niektórzy dziwią się, widząc taką\nmałą dziewczynę jak ja samą\fw Battle Frontier.\rAle to nie tak, że muszę walczyć\nosobiście, wiesz?\n</language>
	</row>
	<row id="msg_0102_D32PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moim życiowym hobby są od zawsze\nwalki Pokémonów.\rWalka po śniadaniu,\nwalka po obiedzie,\fi po kolacji...\fPotem po prostu biorę kąpiel\fi idę spać.</language>
	</row>
</body>
