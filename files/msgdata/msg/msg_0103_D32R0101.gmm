<?xml version="1.0"?>
<body language="English">
	<row id="msg_0103_D32R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Battle Frontier!\rTo twoja pierwsza wizyta?\nTędy, proszę!\r</language>
	</row>
	<row id="msg_0103_D32R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och! Masz Vs. Recorder!\nJak miło!\rUlepszamy Vs. Recordery odwiedzającym\npo raz pierwszy, na potrzeby Battle\fFrontier.\rPożyczę twój na chwilę.\rZobaczmy... Odsuwamy tę część tutaj,\ni tik-tak-klik-szczęk tam!\rGotowe!\nProszę bardzo.\r</language>
	</row>
	<row id="msg_0103_D32R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vs. Recorder gracza {STRVAR_1 3, 0, 0}\nzostał ulepszony.</language>
	</row>
	<row id="msg_0103_D32R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reszta naszego personelu z chęcią\nwyjaśni, jak działają poszczególne\fobiekty Battle Frontier.\rJa mogę omówić ogólne tematy.\nMasz jakieś pytania? {YESNO 0}</language>
	</row>
	<row id="msg_0103_D32R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Który temat mam wyjaśnić? {YESNO 0}</language>
	</row>
	<row id="msg_0103_D32R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle Frontier ma pięć obiektów\npoświęconych walce.\rW Battle Tower celem jest pokonanie\nsiedmiu Trenerów z rzędu.\rW Battle Hall możesz prowadzić\nzapisy walk dla poszczególnych\fPokémonów.\rW Battle Factory musisz wygrywać\nkolejne walki wypożyczonymi\fPokémonami.\rBattle Castle zmusza Trenerów do\nzarządzania Punktami Zamku, by\fpostępować dalej.\rA na koniec, w Battle Arcade to\nlosowy traf wywołuje wydarzenia.\rMożesz wypróbować dowolny\nz tych obiektów!\r</language>
	</row>
	<row id="msg_0103_D32R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walki w pięciu obiektach Battle\nFrontier odbywają się według\fspecjalnych zasad.\rPrzede wszystkim nie można zdobywać\nPunktów Doświadczenia.\rW konsekwencji Pokémony walczące\ntutaj nie zdobędą poziomów.\rJeśli wybrana zostanie zasada\nPoziomu 50, Pokémony o wyższych\fpoziomach zostaną tymczasowo\fobniżone do poziomu 50.\rPokémony poniżej poziomu 50 zostaną\nwpisane bez podwyższenia poziomu.\r</language>
	</row>
	<row id="msg_0103_D32R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Punkty Walki są zwykle nazywane\nBP.\rBP to punkty używane wyłącznie\nw Battle Frontier.\rBP są przyznawane za osiągnięcie\npewnych celów w różnych obiektach\fBattle Frontier.\rBP można wymienić na nagrody\nw Punkcie Wymiany.\r</language>
	</row>
	<row id="msg_0103_D32R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Punkt Wymiany składa się z dwóch\nnamiotów prosto przed tobą.\rTam możesz wymienić swoje BP\nna szeroki wybór nagród.\rZapraszamy do odwiedzenia go!\r</language>
	</row>
	<row id="msg_0103_D32R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monitor Wyników pokazuje dane\nTrenera, takie jak poprzedni wynik\fi najlepszy wynik do tej pory.\rZnajdziesz go przy recepcji\nw każdym obiekcie.\r</language>
	</row>
	<row id="msg_0103_D32R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nadzieję, że wizyta ci się spodoba!</language>
	</row>
	<row id="msg_0103_D32R0101_00011" index="11">
