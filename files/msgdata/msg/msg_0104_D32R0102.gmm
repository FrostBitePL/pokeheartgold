<?xml version="1.0"?>
<body language="English">
	<row id="msg_0104_D32R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekajcieee na mnie!!\r</language>
	</row>
	<row id="msg_0104_D32R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O rety!\nZasnąłem/am i zaprzepaściłem/am\fszansę na bycie tu pierwszym/pierwszą...\rGłupi/a ja, głupi/a ja...\nSzlocham...szlocham...</language>
	</row>
	<row id="msg_0104_D32R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Głupi/a ja, głupi/a ja...\nSzlocham...szlocham...</language>
	</row>
	<row id="msg_0104_D32R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Klik, klik, klik...\nOch! To ty!\rPrzestało mi już zależeć na tym,\nby zawsze być pierwszym/pierwszą.\rTeraz liczę osoby, które przybywają\ndo Battle Frontier.\fOczywiście nikt mnie o to nie prosił.\fTo tylko hobby.</language>
	</row>
	<row id="msg_0104_D32R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę przestać się trząść!\rPowiedziałem/am rodzinie, że podbiję\nBattle Frontier, gdy wyjeżdżałem/am\fz domu...\rAle teraz tu jestem i nie wiedzieć\nczemu nie mogę przestać się trząść!\rCo zrobię, jeśli zostanę pokonany/a\nna miazgę?\r</language>
	</row>
	<row id="msg_0104_D32R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Wyglądasz dość młodo.\r...\n...\rZbiorę się w sobie i rzucę wyzwanie\nBattle Frontier...\fMoże!\r</language>
	</row>
	<row id="msg_0104_D32R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbiorę się w sobie i rzucę wyzwanie\nBattle Frontier!\r...\nAlbo i nie!\r</language>
	</row>
	<row id="msg_0104_D32R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nareszcie!\nJestem tu, w Battle Frontier!\rGdy zwykła walka Pokémonów na trasie\nprzestaje cię satysfakcjonować,\fmusisz przybyć do Battle Frontier!\rNie zgadzasz się?</language>
	</row>
	<row id="msg_0104_D32R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zazwyczaj wybór Pokémonów to\ncała tajemnica walki Pokémonów.\rAle gdy zmienisz pewne zasady lub\nograniczenia, walka nagle staje\fsię jeszcze zabawniejsza.\rA miejsce, gdzie można się tak\nbawić... nazywa się Battle Frontier!</language>
	</row>
	<row id="msg_0104_D32R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oto Battle Frontier\rPrzybywajcie, Dumni Trenerzy,\ni celujcie w szczyt!</language>
	</row>
</body>
