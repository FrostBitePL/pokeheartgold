<?xml version="1.0"?>
<body language="English">
	<row id="msg_0108_D32R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Battle Hall!\rJestem twoim przewodnikiem po\nwyzwaniach Single i Double Battle.\rPamiętaj, że te wyzwania są\nprzeznaczone dla pojedynczego\fTrenera.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Które wyzwanie chcesz\npodjąć?{YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Battle Hall możesz samodzielnie\npodjąć wyzwanie Single lub Double\fBattle.\rDo wyzwania Single Battle zgłaszasz\njednego Pokémona na co najmniej\f30. poziomie.\rWyzwanie Double Battle wymaga\nzgłoszenia dwóch takich samych\fPokémonów, każdy na co najmniej\f30. poziomie.\rRekordy serii zwycięstw są\nprowadzone dla poszczególnych\frodzajów Pokémonów.\rDzięki temu każdy rodzaj Pokémona\nmoże dążyć do numeru 1.\rGdy wejdziesz do Hall, zostaniesz\npoproszony/a o wybór typu i rangi\fPokémona, którym chcesz walczyć.\rJeśli uda ci się wygrać dziesięć walk\nz rzędu, zdobędziesz Punkty Walki (BP).\rJeśli chcesz przerwać wyzwanie,\nzapisz grę.\rJeśli tego nie zrobisz, zostaniesz\nzdyskwalifikowany/a z wyzwania.\rPamiętaj o tym!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Battle Hall!\rJestem twoim przewodnikiem po\nwyzwaniu Multi Battle.\rPamiętaj, że to wyzwanie wymaga\ndwóch Trenerów.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chcesz podjąć wyzwanie\nMulti Battle w Battle Hall? {YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz zawiązać drużynę z przyjacielem\nna wyzwanie Multi Battle, używając\ftego samego rodzaju Pokémona,\fkażdy na co najmniej 30. poziomie.\rGdy wejdziecie do Hall, zostaniecie\npoproszeni o wybór typu i rangi\fPokémona, którym chcecie walczyć.\rJeśli uda wam się wygrać dziesięć\nwalk z rzędu, zdobędziecie Punkty\fWalki (BP).\rPamiętaj: wyzwania Multi Battle\nw Battle Hall nie można przerwać.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nadzieję, że wrócisz!</language>
	</row>
	<row id="msg_0108_D32R0401_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na jakim poziomie chcesz zagrać?\nPoziom 50 czy Otwarty Poziom?</language>
	</row>
	<row id="msg_0108_D32R0401_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz zapisać grę, zanim cię\nwprowadzę. Zgadzasz się?{YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tędy, proszę!</language>
	</row>
	<row id="msg_0108_D32R0401_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekamy na twoją kolejną wizytę.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tęskniliśmy za tobą!\rMusisz zapisać grę, zanim wznowisz\nswoje wyzwanie. Proszę czekać.</language>
	</row>
	<row id="msg_0108_D32R0401_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam!\rNie zapisałeś/aś gry, zanim ostatnio\nzakończyłeś/aś wyzwanie.\rZ tego powodu zostałeś/aś\nzdyskwalifikowany/a z wyzwania!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje!\rW uznaniu twojego zwycięstwa,\nwręczamy ci ten pamiątkowy odcisk!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złoty Odcisk został dodany\ndo Vs. Recordera gracza\f{STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Srebrny Odcisk został dodany\ndo Vs. Recordera gracza\f{STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WALKA POJEDYNCZA</language>
	</row>
	<row id="msg_0108_D32R0401_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WALKA PODWÓJNA</language>
	</row>
	<row id="msg_0108_D32R0401_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PODEJMIJ WYZWANIE</language>
	</row>
	<row id="msg_0108_D32R0401_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">INFO</language>
	</row>
	<row id="msg_0108_D32R0401_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANULUJ</language>
	</row>
	<row id="msg_0108_D32R0401_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">POZIOM 50</language>
	</row>
	<row id="msg_0108_D32R0401_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OTWARTY POZIOM</language>
	</row>
	<row id="msg_0108_D32R0401_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANULUJ</language>
	</row>
	<row id="msg_0108_D32R0401_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz wychować silne Pokémony,\nale nie masz pojęcia, które wybrać...?\rDla Trenerów, którzy tak się czują,\nBattle Factory to naprawdę miejsce\fwarte odwiedzenia!</language>
	</row>
	<row id="msg_0108_D32R0401_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz całkowitą rację.\rMówi się, że życie to niekończąca\nsię seria okazji do nauki.\rTo miejsce jest najlepsze do nauki\no walkach Pokémonów i o innych\fTrenerach...</language>
	</row>
	<row id="msg_0108_D32R0401_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I raaaz--bum!\nI drugi raaaaz--bum!\rNie mam jeszcze Pokémona, więc\nćwiczę rzucanie Poké Ballami!</language>
	</row>
	<row id="msg_0108_D32R0401_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Babciu, hej! Babciu!\nPrzyszedłem/am wymienić się\fAkcesoriami!\fMam coś specjalnie dla mojej babci!</language>
	</row>
	<row id="msg_0108_D32R0401_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, dziękuję ci, kochanie...\rJesteś taki/a słodki/a, silny/a\ni miły/a...\nMam szczęście mieć takie wnuczę.</language>
	</row>
	<row id="msg_0108_D32R0401_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tamta mała dziewczynka ze swoją\nbabcią...\rTak się składa, że wiem, że ta\nmała dziewczynka jest niesamowicie\fsilna...\rPozory czasem mylą.\n</language>
	</row>
	<row id="msg_0108_D32R0401_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden Trener powinien wybrać\n„ZOSTAŃ LIDEREM”.\rDrugi Trener musi wybrać\n„DOŁĄCZ DO GRUPY”.{YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musimy uruchomić komunikację\nbezprzewodową DS.{YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz zapisać grę, zanim cię\nwprowadzę. Proszę czekać.</language>
	</row>
	<row id="msg_0108_D32R0401_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierz Pokémony, które chcesz\nzgłosić.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trwa zapisana seria zwycięstw dla\n{STRVAR_1 0, 0, 0}.\rUsunąć ten rekord i rozpocząć nowe\nwyzwanie z {STRVAR_1 0, 1, 0}?{YESNO 0}</language>
	</row>
	<row id="msg_0108_D32R0401_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam!\rNie masz ani jednego kwalifikującego\nsię Pokémona na co najmniej\f30. poziomie!\r</language>
	</row>
	<row id="msg_0108_D32R0401_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam!\rDo Double Battle musisz mieć dwa\ntakie same Pokémony, każdy na\fco najmniej 30. poziomie.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poza tym Jajka nie kwalifikują się\ndo startu.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jajka i {STRVAR_1 0, 1, 0} nie mogą\nwystartować.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jajka, {STRVAR_1 0, 1, 0} i {STRVAR_1 0, 2, 0}\nnie mogą wystartować.\r</language>
	</row>
	<row id="msg_0108_D32R0401_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jajka, {STRVAR_1 0, 1, 0}, {STRVAR_1 0, 2, 0}\ni {STRVAR_1 0, 3, 0} nie mogą\fwystartować.\r</language>
	</row>
