<?xml version="1.0"?>
<body language="English">
	<row id="msg_0110_D32R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Battle Arcade!\rJestem twoim przewodnikiem po\nwyzwaniach Single i Double Battle.\rPamiętaj, że te wyzwania są\nprzeznaczone dla pojedynczego\fTrenera.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Które wyzwanie chcesz\npodjąć?{YESNO 0}</language>
	</row>
	<row id="msg_0110_D32R0601_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Battle Arcade możesz podjąć\nwyzwanie Single lub Double Battle.\rTutaj plansza gry jest aktywowana\nprzed każdą walką.\rW zależności od tego, co pojawi się\nna planszy, ma miejsce wydarzenie.\rNiektóre wydarzenia będą korzystne\ndla wyzywającego, inne nie.\rCelem jest utrzymanie serii zwycięstw\ntak długo, jak to możliwe.\rPodczas wyzwania wszelkie przedmioty\ntrzymane przez twoje Pokémony\fzostaną umieszczone w magazynie.\rJeśli uda ci się wygrać siedem walk\nz rzędu, zdobędziesz Punkty Walki (BP).\rJeśli chcesz przerwać wyzwanie,\nzapisz grę.\rJeśli tego nie zrobisz, zostaniesz\nzdyskwalifikowany/a z wyzwania.\rPamiętaj o tym!\r</language>
	</row>
	<row id="msg_0110_D32R0601_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Battle Arcade!\rJestem twoim przewodnikiem po\nwyzwaniu Multi Battle.\rPamiętaj, że to wyzwanie wymaga\ndwóch Trenerów.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chcesz podjąć wyzwanie\nMulti Battle w Battle Arcade?{YESNO 0}</language>
	</row>
	<row id="msg_0110_D32R0601_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz zawiązać drużynę z przyjacielem\nna wyzwanie Multi Battle.\rTutaj plansza gry jest aktywowana\nprzed każdą walką.\rW zależności od tego, co pojawi się\nna planszy, ma miejsce wydarzenie.\rWydarzenia mogą mieć duży wpływ na\nwynik walki, dobry lub zły.\rCelem jest utrzymanie serii zwycięstw\ntak długo, jak to możliwe.\rPodczas wyzwania wszelkie przedmioty\ntrzymane przez wasze Pokémony\fzostaną umieszczone w magazynie.\rJeśli uda wam się wygrać siedem walk\nz rzędu, zdobędziecie Punkty Walki (BP).\rPamiętaj: wyzwania Multi Battle\nw Battle Arcade nie można przerwać.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nadzieję, że wrócisz!</language>
	</row>
	<row id="msg_0110_D32R0601_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierz Pokémony, które chcesz\nzgłosić.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam!\rNie masz {STRVAR_1 50, 0, 0} kwalifikujących\nsię Pokémonów.\rMusisz mieć {STRVAR_1 50, 1, 0} różnych\nPokémonów, by wystartować.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poza tym Jajka nie kwalifikują się\ndo startu.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jajka i {STRVAR_1 0, 1, 0} nie mogą\nwystartować.\r</language>
	</row>
	<row id="msg_0110_D32R0601_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jajka, {STRVAR_1 0, 1, 0} i {STRVAR_1 0, 2, 0}\nnie mogą wystartować.\r</language>
	</row>
