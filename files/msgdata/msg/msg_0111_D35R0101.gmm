<?xml version="1.0"?>
<body language="English">
	<row id="msg_0111_D35R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\rSłyszysz wiatr wiejący do tego\npokoju? To...to tylko ja gwiżdżę.\rDość o tym.\nMoże coś kupisz? {YESNO 0}</language>
	</row>
	<row id="msg_0111_D35R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arrgh...\nZnalazłeś/aś tajne schody...\rJak ci się to udało?\nMyślałem, że są dobrze zamaskowane...</language>
	</row>
	<row id="msg_0111_D35R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heheh! Eksperyment zadziałał\njak marzenie.\rMAGIKARPY są bezwartościowe, ale\nGYARADOSY to prawdziwa żyła złota.</language>
	</row>
	<row id="msg_0111_D35R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urrgh...\rPokémony typu Smoczy tego\nfaceta są mocne...</language>
	</row>
	<row id="msg_0111_D35R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance: DRAGONITE, Hyperpromień.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co cię tak zatrzymało, {STRVAR_1 3, 0, 0}?\rTak jak myślałem, ten dziwny sygnał\nradiowy pochodzi właśnie stąd.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co cię tak zatrzymało, {STRVAR_1 3, 0, 0}?\rTak jak myślałem, ten dziwny sygnał\nradiowy pochodzi właśnie stąd.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Schody są tuż tutaj.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance: {STRVAR_1 3, 0, 0}, powinniśmy się\nrozdzielić, żeby zbadać to miejsce.\fJa pójdę pierwszy.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance: {STRVAR_1 3, 0, 0}, powinniśmy się\nrozdzielić, żeby zbadać to miejsce.\fJa pójdę pierwszy.\r</language>
	</row>
	<row id="msg_0111_D35R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świst...świst...\rPrzeszkadza ci ten dźwięk? To ja.\nMoja sztuczna szczęka źle leży\fi ta szczelina powoduje ten dźwięk.\rDość o tym.\nMoże coś kupisz?\r</language>
	</row>
	<row id="msg_0111_D35R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Radio jest włączone.\rLeci program rozrywkowy\nEkipa Poszukiwaczy Pokémonów!</language>
	</row>
	<row id="msg_0111_D35R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Radio jest włączone.\rLeci program rozrywkowy\nMiniserial Radiowy!</language>
	</row>
	<row id="msg_0111_D35R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Radio jest włączone.\rLeci program rozrywkowy\nHasło Bueny!</language>
	</row>
	<row id="msg_0111_D35R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team Rocket ogłasza swój powrót\nprzez radio!</language>
	</row>
	<row id="msg_0111_D35R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszysz coś dziwnego...!</language>
	</row>
