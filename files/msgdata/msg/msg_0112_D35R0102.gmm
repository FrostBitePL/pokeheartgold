<?xml version="1.0"?>
<body language="English">
	<row id="msg_0112_D35R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej!\nWłamywacz!\r</language>
	</row>
	<row id="msg_0112_D35R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz moja kolej!\nNie ma ucieczki!\r</language>
	</row>
	<row id="msg_0112_D35R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To posąg PERSIANA...\nJego oczy świecą na czerwono...\rCzujesz, że ktoś może cię\nobserwować...</language>
	</row>
	<row id="msg_0112_D35R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To posąg PERSIANA...\nJego oczy świecą na niebiesko...\rNie czujesz, żeby ktoś cię obserwował...</language>
	</row>
	<row id="msg_0112_D35R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczy posągu PERSIANA\njuż nie świecą...</language>
	</row>
	<row id="msg_0112_D35R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tajny przełącznik!\rCzerwony przełącznik miga\nw podejrzany sposób.\fNaciśniesz go? {YESNO 0}</language>
	</row>
	<row id="msg_0112_D35R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tajny przełącznik!\rNiebieski przełącznik świeci.\fNaciśniesz go? {YESNO 0}</language>
	</row>
	<row id="msg_0112_D35R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lepiej go naciśnij.\r</language>
	</row>
	<row id="msg_0112_D35R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tajny przełącznik już nie świeci...</language>
	</row>
	<row id="msg_0112_D35R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">System nadzoru jest wyłączony!</language>
	</row>
	<row id="msg_0112_D35R0102_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">System nadzoru jest włączony!</language>
	</row>
</body>
