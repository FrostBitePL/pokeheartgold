<?xml version="1.0"?>
<body language="English">
	<row id="msg_0116_D37R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyzwano mnie na pojedynek\nna dole.\rJest tam ostro. Lepiej uważaj.</language>
	</row>
	<row id="msg_0116_D37R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyglądasz na uczciwego młodzieńca.\nJak trafiłeś do\fTeam Rocket...?</language>
	</row>
	<row id="msg_0116_D37R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team Rocket nigdy nie przestaje\nnękać ludzi, co nie?</language>
	</row>
	<row id="msg_0116_D37R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na dole są jakieś sklepy...\rAle są też Trenerzy.\nBoję się tam schodzić.</language>
	</row>
	<row id="msg_0116_D37R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak...\nTeam Rocket też może korzystać z tunelu.</language>
	</row>
	<row id="msg_0116_D37R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszyscy ludzie pracujący w tunelu\nodeszli. Nikt nie chce, żeby Team\fRocket robił im problemy.</language>
	</row>
	<row id="msg_0116_D37R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Cześć, {STRVAR_1 3, 0, 0}.\nWłaśnie w porę!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Jeśli pójdziesz tym tunelem,\nzobaczysz Sklep z Przebraniami.\rTam twój Pokémon może założyć\nAkcesoria, przebrać się i\fzrobić sobie zdjęcie!\rSwoją drogą, oto Fashion Case!\rPowiedziałeś/aś, że go chcesz?\nWiedziałam!\rTo prezent ode mnie!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Trzymaj Akcesoria w Fashion\nCase, dobra?\rMuszę już iść.\nDo zobaczenia!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Cześć, {STRVAR_1 3, 0, 0}.\nWłaśnie w porę!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Jeśli pójdziesz tym tunelem,\nzobaczysz Sklep z Przebraniami.\rTam twój Pokémon może założyć\nAkcesoria, przebrać się i\fzrobić sobie zdjęcie!\rSwoją drogą, oto Fashion Case!\rPowiedziałeś/aś, że go chcesz?\nWiedziałem!\rTo prezent ode mnie!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Trzymaj Akcesoria w Fashion\nCase, dobra?\rMuszę już iść.\nDo zobaczenia!\r</language>
	</row>
</body>
