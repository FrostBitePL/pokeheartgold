<?xml version="1.0"?>
<body language="English">
	<row id="msg_0116_D37R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyzwano mnie na pojedynek\nna dole.\rJest tam ostro. Lepiej uważaj.</language>
	</row>
	<row id="msg_0116_D37R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyglądasz na uczciwego młodzieńca.\nJak trafiłeś do Genezy...?</language>
	</row>
	<row id="msg_0116_D37R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Geneza nigdy nie przestaje nękać\nludzi, co nie?</language>
	</row>
	<row id="msg_0116_D37R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na dole są jakieś sklepy...\rAle są też Trenerzy.\nBoję się tam schodzić.</language>
	</row>
	<row id="msg_0116_D37R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak... Geneza też może korzystać z\ntunelu.</language>
	</row>
	<row id="msg_0116_D37R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszyscy ludzie pracujący w tunelu\nodeszli. Nikt nie chce, żeby Geneza\frobiła im problemy.</language>
	</row>
	<row id="msg_0116_D37R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Cześć, {STRVAR_1 3, 0, 0}.\nWłaśnie w porę!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Jeśli pójdziesz tym tunelem,\nzobaczysz Sklep z Przebraniami.\rTam twój Pokémon może założyć\nAkcesoria, przebrać się i\fzrobić sobie zdjęcie!\rSwoją drogą, oto Fashion Case!\rPowiedziałeś/aś, że go chcesz?\nWiedziałam!\rTo prezent ode mnie!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Trzymaj Akcesoria w Fashion\nCase, dobra?\rMuszę już iść.\nDo zobaczenia!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Cześć, {STRVAR_1 3, 0, 0}.\nWłaśnie w porę!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Jeśli pójdziesz tym tunelem,\nzobaczysz Sklep z Przebraniami.\rTam twój Pokémon może założyć\nAkcesoria, przebrać się i\fzrobić sobie zdjęcie!\rSwoją drogą, oto Fashion Case!\rPowiedziałeś/aś, że go chcesz?\nWiedziałem!\rTo prezent ode mnie!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Trzymaj Akcesoria w Fashion\nCase, dobra?\rMuszę już iść.\nDo zobaczenia!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z głębi tunelu dobiega ciężki,\ndudniący bas. W klubie „Rozpadlina”\fgra dziś zespół Zgon.\r</language>
	</row>
	<row id="msg_0116_D37R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagle światła migają, a dźwięk się\nzniekształca...\r</language>
	</row>
	<row id="msg_0116_D37R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nad tłumem, w błysku stroboskopów,\ntańczy niewielki, różowy Pokémon.\fNaśladuje ruchy wokalisty!\r</language>
	</row>
	<row id="msg_0116_D37R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dwóch mężczyzn w białych fartuchach\nskanuje salę urządzeniem. „Odczyty\fpsychiczne biją skalę. To ono.\nTrzeba to zgłosić panu Łukaszowi\fnatychmiast.”\r</language>
	</row>
	<row id="msg_0116_D37R0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon spogląda na ciebie, śmieje\nsię i wskakuje prosto do twojej\ftorby. Agenci Genezy odjeżdżają z\npustymi rękami.\r</language>
	</row>
	<row id="msg_0116_D37R0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) Mew!\r</language>
	</row>
</body>
