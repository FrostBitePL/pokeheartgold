<?xml version="1.0"?>
<body language="English">
	<row id="msg_0117_D37R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj, kochanie.\rSprzedaję niedrogie ziołowe lekarstwa.\nSą dobre, ale odrobinę gorzkie.\rTwój Pokémon może ich nie lubić.\nHehehehe... {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej! Chcesz zobaczyć jakieś okazje?\rSprzedaję rzadkie przedmioty, jakich\nnikt inny nie ma--ale tylko po\fjednej sztuce każdego. {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 8, 0, 0} kosztuje\n${STRVAR_1 53, 1, 0}. Chcesz go?</language>
	</row>
	<row id="msg_0117_D37R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki.\r</language>
	</row>
	<row id="msg_0117_D37R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umieściłeś/aś {STRVAR_1 8, 0, 0} w\nkieszeni {STRVAR_1 18, 1, 0}. {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Już to kupiłeś/aś. Wyprzedałem\nwszystko. {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej, brakuje ci gotówki. {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej, twój plecak jest zapchany. {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziś już zamknięte.</language>
	</row>
	<row id="msg_0117_D37R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wpadnij kiedyś jeszcze.</language>
	</row>
	<row id="msg_0117_D37R0102_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj!\rProwadzę Salon Pokémon!\rJestem starszym i lepszym z dwóch\nBraci od Strzyżenia.\rMogę upiększyć twojego Pokémona\nza jedyne $500.\rPielęgnacja poprawia wygląd.\nTwój Pokémon stanie się bardziej\fprzyjazny i piękniejszy.\rChcesz, żebym to zrobił? {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nad którym Pokémonem mam popracować?</language>
	</row>
	<row id="msg_0117_D37R0102_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobra! Popatrz, jak staje się piękny!</language>
	</row>
	<row id="msg_0117_D37R0102_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gotowe! Wszystko zrobione!</language>
	</row>
	<row id="msg_0117_D37R0102_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak? Szkoda!</language>
	</row>
	<row id="msg_0117_D37R0102_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrzebujesz więcej pieniędzy niż to.</language>
	</row>
	<row id="msg_0117_D37R0102_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strzygę tylko raz dziennie, przykro mi.\nSkończyłem na dziś.</language>
	</row>
	<row id="msg_0117_D37R0102_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Salonie Pokémon!\rJestem młodszym i tańszym z dwóch\nBraci od Strzyżenia.\rOdświeżę twojego Pokémona\nza jedyne $300.\rPielęgnacja poprawia wygląd.\nTwój Pokémon stanie się bardziej\fprzyjazny i piękniejszy.\rWięc? Co ty na to?</language>
	</row>
	<row id="msg_0117_D37R0102_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobra, którego Pokémona mam odświeżyć?</language>
	</row>
	<row id="msg_0117_D37R0102_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobra! Mam nadzieję, że dobrze mi pójdzie!</language>
	</row>
	<row id="msg_0117_D37R0102_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I proszę! Wszystko zrobione!</language>
	</row>
	<row id="msg_0117_D37R0102_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie? Jakie rozczarowanie!</language>
	</row>
	<row id="msg_0117_D37R0102_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trochę brakuje ci gotówki.</language>
	</row>
	<row id="msg_0117_D37R0102_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam przeczucie, że następnym razem\nnie pójdzie dobrze. Zamykam na dziś!</language>
	</row>
	<row id="msg_0117_D37R0102_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} wygląda na trochę szczęśliwszego.</language>
	</row>
	<row id="msg_0117_D37R0102_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} wygląda na szczęśliwego.</language>
	</row>
	<row id="msg_0117_D37R0102_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} wygląda na zachwyconego!</language>
	</row>
	<row id="msg_0117_D37R0102_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DALEJ WSTĘP WZBRONIONY</language>
	</row>
	<row id="msg_0117_D37R0102_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} włożył(a)\nKlucz do Piwnicy.\r</language>
	</row>
	<row id="msg_0117_D37R0102_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Pamiątkowym Studiu Fotograficznym.\nNie jesteśmy zwykłym studiem!\rMożesz założyć mundur Team Rocket,\nby zrobić sobie zdjęcie!\rChcesz spróbować? {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę, stań przed kamerą,\ngdy się przebierzesz.\r</language>
	</row>
	<row id="msg_0117_D37R0102_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś gotowy/a?\rDawaj!\nWyglądaj tak, jakbyś rządził/a światem!\r</language>
	</row>
	<row id="msg_0117_D37R0102_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobra robota.\rMożesz sprawdzić zdjęcie w PC.</language>
	</row>
	<row id="msg_0117_D37R0102_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz założyć mundur Team Rocket,\nby zrobić sobie zdjęcie!\rChcesz spróbować? {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Uczciwie.\rNikt nie powinien podziwiać Team Rocket.</language>
	</row>
	<row id="msg_0117_D37R0102_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm. Twój Album Zdjęć jest pełny.\rWejdź do PC i usuń\njakieś zdjęcia.</language>
	</row>
	<row id="msg_0117_D37R0102_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\nTy też jesteś nowy/a?\rMusieliśmy zwerbować nowych członków\nna misję w Wieży Radiowej.\fPotem skończyły się nam mundury.\rSłyszałem, że to studio je ma, więc\npostanowiłem jeden „pożyczyć”.\rSkoro tu jesteś, czemu też się\nnie przebierzesz?\r</language>
	</row>
	<row id="msg_0117_D37R0102_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spójrz na siebie! Całkiem nieźle!\rOch, ale nie próbuj straszyć ludzi,\nchodząc naokoło wyglądając\ftak, dobra?</language>
	</row>
	<row id="msg_0117_D37R0102_00038" index="38">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0117_D37R0102_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, twoje Pokémony są takie\nurocze! Ale to zachwycające!\rJeśli przebierzesz tu swojego\nPokémona, spraw, by było na co popatrzeć!\rWtedy powieszę nawet jego zdjęcie\nw drugim pokoju!\rZrobisz to, prawda? {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, ty głuptasie...\nGdzie twój duch przygody?</language>
	</row>
	<row id="msg_0117_D37R0102_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, ooh, tak! Jak miło!\nNie zwlekajmy!\rMam ci wytłumaczyć, jak\nprzebrać twojego Pokémona? {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, ciekawe, którego Pokémona\nprzebierzesz?\r</language>
	</row>
	<row id="msg_0117_D37R0102_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hihihi...\nMam nadzieję, że przebierzesz go\furoczo!\r</language>
	</row>
	<row id="msg_0117_D37R0102_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz Fashion Case, prawda?\nAch, oui, wspaniale!\rWystarczy wybrać Akcesoria i założyć\nje na swojego Pokémona.\rGdy skończysz, zrobię zdjęcie\ni powieszę je obok siebie!\rJeśli wymienisz się rekordami\nz innymi, możesz zdobyć też ich zdjęcia!\rMyślę, że będzie dużo łatwiej,\njeśli po prostu spróbujesz! {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, świetna robota!\nWystawmy zdjęcie od razu!\fOch, ale musi mieć tytuł!\r</language>
	</row>
	<row id="msg_0117_D37R0102_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 28, 0, 0}...\rOoh, tak, tak! Teraz rozumiem!\nTwój zmysł estetyczny aż promienieje!\r</language>
	</row>
	<row id="msg_0117_D37R0102_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, non, non, non!\nBędzie takie smutne bez tytułu.\r</language>
	</row>
	<row id="msg_0117_D37R0102_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och... Wyszedłeś/aś, nic nie\nzrobiwszy... Jakie rozczarowanie.</language>
	</row>
	<row id="msg_0117_D37R0102_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli znów przebierzesz jakiegoś\nPokémona, to zdjęcie zostanie zmienione.\rChcesz przebrać\nPokémona, kochanie? {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu by nie przebrać się samej\ni powiesić zdjęcie...?\rTytuł powinien brzmieć...\nHmm...może „Dziewczęcy Raj”?</language>
	</row>
	<row id="msg_0117_D37R0102_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, non, non, non! To Jajko!\nJest za młode, żeby się przebierać!\r</language>
	</row>
	<row id="msg_0117_D37R0102_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powiesiłam twoje zdjęcie właśnie tu.\nWygląda tam po prostu idealnie!</language>
	</row>
	<row id="msg_0117_D37R0102_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To rama na zdjęcie\nportretowe.</language>
	</row>
	<row id="msg_0117_D37R0102_00054" index="54">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0117_D37R0102_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Członkowie Team Rocket w czarnych\nstrojach biegali wszędzie dookoła...\rZastanawiałem się, co się dzieje.\nWięc stawiłeś/aś czoła Team Rocket?\fJesteś imponujący/a!\rMoże będziesz w stanie stawić czoła\nlegendarnemu Poké...\r</language>
	</row>
	<row id="msg_0117_D37R0102_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahaha! Nieważne.\rMuszę już iść.\r</language>
	</row>
	<row id="msg_0117_D37R0102_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spójrz tylko!\rTo losowanie Akcesoriów.\nNigdy nie wiesz, co dostaniesz.\rChcesz spróbować za $100? {YESNO 0}</language>
	</row>
	<row id="msg_0117_D37R0102_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, jesteś świetny/a!\nTyle Akcesoriów i tapet!\rŚmiało, przebierz swojego Pokémona!</language>
	</row>
	<row id="msg_0117_D37R0102_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszam ponownie!</language>
	</row>
	<row id="msg_0117_D37R0102_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie!\nBrakuje ci gotówki.</language>
	</row>
	<row id="msg_0117_D37R0102_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No to jedziemy!\r..................\n..................\f......\fWygrywasz!\r</language>
	</row>
	<row id="msg_0117_D37R0102_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może tapeta?\r</language>
	</row>
	<row id="msg_0117_D37R0102_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszam ponownie!</language>
	</row>
	<row id="msg_0117_D37R0102_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie wygrałeś/aś. Przykro mi.\r</language>
	</row>
</body>
