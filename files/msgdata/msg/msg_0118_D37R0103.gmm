<?xml version="1.0"?>
<body language="English">
	<row id="msg_0118_D37R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MACHOKE, pomóż nam przenieść kontener!\r</language>
	</row>
	<row id="msg_0118_D37R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten magazyn jest sprzątany w kilka\nsekund dzięki MACHOKE.\rRzeczy na ziemi to śmieci.\nWeź je, jeśli chcesz!</language>
	</row>
	<row id="msg_0118_D37R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MACHOKE: Maaacho!</language>
	</row>
</body>
