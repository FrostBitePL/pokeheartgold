<?xml version="1.0"?>
<body language="English">
	<row id="msg_0121_D38R0104_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej!\rJestem Karate King!\nTrenuję tu sam, w tej jaskini!\rTy!\nWalcz ze mną! Hłaaargh!\r</language>
	</row>
	<row id="msg_0121_D38R0104_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja... jestem zmiażdżony...\rMój trening wciąż nie jest\nwystarczający...\nAle porażka to porażka. Przyznaję.\rNa dowód, że mnie pokonałeś/aś, dam\nci rzadkiego Pokémona typu Walczącego.\r</language>
	</row>
	<row id="msg_0121_D38R0104_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) TYROGUE\nod Karate King!</language>
	</row>
	<row id="msg_0121_D38R0104_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TYROGUE to typ Walczący.\nEwoluuje w twardszego Pokémona.\rNie przestawaj ciężko pracować.\nJa też będę dalej trenować. Żegnaj!</language>
	</row>
	<row id="msg_0121_D38R0104_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie masz miejsca w swojej drużynie!</language>
	</row>
	<row id="msg_0121_D38R0104_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadać przezwisko otrzymanemu\nTYROGUE? {YESNO 0}</language>
	</row>
	<row id="msg_0121_D38R0104_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
</body>
