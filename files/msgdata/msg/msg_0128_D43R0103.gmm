<?xml version="1.0"?>
<body language="English">
	<row id="msg_0128_D43R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaczekaj.\r...Zamierzasz rzucić wyzwanie\nLidze Pokémon?\rVictory Road faktycznie tam się kończy.\rAle czy zauważyłeś/aś...?\nNie widziałeś/aś po drodze żadnych\fprawdziwych Trenerów, prawda?\rCzłowieku, wszyscy byli beznadziejni!\rCóż, fakt, że zaszedłeś/aś tak daleko,\noznacza, że nie jesteś jednym z nich.\rAle!\rTwoja podróż kończy się tutaj!\rBo...właśnie tutaj, właśnie teraz...\nzmiażdżę cię!\r</language>
	</row>
	<row id="msg_0128_D43R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">..................\rNie zrezygnowałem/am z zostania\nnajlepszym Trenerem...\rDowiem się, dlaczego nie mogę wygrywać,\ni stanę się silniejszy/a...\rGdy to zrobię, rzucę ci wyzwanie.\rPokonam cię z całej swojej mocy.\n...Humph! Trzymaj się do tego czasu.\r</language>
	</row>
</body>
