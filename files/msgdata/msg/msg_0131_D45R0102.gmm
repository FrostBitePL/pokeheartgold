<?xml version="1.0"?>
<body language="English">
	<row id="msg_0131_D45R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\rNie wiem, dlaczego tu przybyłeś/aś.\rW każdym razie, muszę cię ostrzec,\nże to nie jest miejsce dla dzieci\ftakich jak ty.\r</language>
	</row>
	<row id="msg_0131_D45R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz pewne spojrzenie...\rPrzypomina mi dziecko, które stanęło\nprzede mną trzy lata temu...\fMasz te same oczy...\r...\rJestem w drodze do Goldenrod City,\nżeby odpowiedzieć na wezwanie\fi dołączyć do mojej drużyny.\rZamierzasz stanąć mi na drodze?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\nTu Wieża Radiowa.\fTu Wieża Radiowa.\fZ przyjemnością ogłaszamy\fodrodzenie Team Rocket.\f...Giovanni?\f...Słyszysz nas?\fWreszcie nam się udało!\f...\r</language>
	</row>
	<row id="msg_0131_D45R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi dawni współpracownicy mnie\npotrzebują...\rNie powtórzymy porażki sprzed\ntrzech lat!\r{COLOR 1}Team Rocket{COLOR 0} narodzi się na nowo,\na ja będę rządzić światem!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giovanni: Jak to możliwe...?\rOstatnie trzy lata poszły\nna marne...?\rJak dziecko takie jak ty zdołało\nznów zniszczyć moje marzenie?\rCenne marzenie Team Rocket stało się\nniewiele więcej niż złudzeniem...\r</language>
	</row>
	<row id="msg_0131_D45R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\n...Hej!\fGdzie zniknął Giovanni?\fCiekawe, czy słucha naszej\ftransmisji...\f...\r</language>
	</row>
	<row id="msg_0131_D45R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giovanni: Zapamiętaj moje słowa.\rNiemożność ocenienia własnej siły\npokazuje, że wciąż jesteś tylko\fdzieckiem.\r</language>
	</row>
	<row id="msg_0131_D45R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Hę?\rTo ten facet, którego właśnie\nwidzieliśmy, kłócący się z tym\fchłopcem!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Hę?\rTo ten facet, którego właśnie\nwidzieliśmy, kłócący się z tym\fchłopcem!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Trzy lata temu...?\nGoldenrod City...?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Trzy lata temu...?\nGoldenrod City...?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy to może być ten, do kogo\npróbowano dotrzeć przez radio?\fGiovanni, ich szef?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy to może być ten, do kogo\npróbowano dotrzeć przez radio?\fGiovanni, ich szef?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszysz to, {STRVAR_1 3, 0, 0}?\nRadio mówi coś dziwnego!\rTeam Rocket zajęło Wieżę Radiową\nw Goldenrod City!\rTo niemożliwe! {STRVAR_1 3, 0, 0},\nprzecież już rozwiązałeś/aś tę sprawę!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszysz to, {STRVAR_1 3, 0, 0}?\nRadio mówi coś dziwnego!\rTeam Rocket zajęło Wieżę Radiową\nw Goldenrod City!\rTo niemożliwe! {STRVAR_1 3, 0, 0},\nprzecież już rozwiązałeś/aś tę sprawę!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Ciągle wzywają swojego szefa.\nAż mi ich żal, że nie wiedzą, że on\fnie przyjdzie.\rPo tym, {STRVAR_1 3, 0, 0}, ich pokonasz!\r...Zaraz, chwileczkę!\r{STRVAR_1 3, 0, 0}, wciąż tu jesteś.\nWięc kto pokona Team Rocket...?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Ciągle wzywają swojego szefa.\nAż mi ich żal, że nie wiedzą, że on\fnie przyjdzie.\rPo tym, {STRVAR_1 3, 0, 0}, ich pokonasz!\r...Zaraz, chwileczkę!\r{STRVAR_1 3, 0, 0}, wciąż tu jesteś.\nWięc kto pokona Team Rocket...?\r</language>
	</row>
	<row id="msg_0131_D45R0102_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie znowu...!\nMam już dosyć!\fProszę, pozwól mi wrócić do mojego\fczasu!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie znowu...!\nMam już dosyć!\fProszę, pozwól mi wrócić do mojego\fczasu!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CELEBI podróżuje w czasie!\nWraca do momentu sprzed rozpoczęcia\ftej dziwnej przygody...\r</language>
	</row>
	<row id="msg_0131_D45R0102_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest tu radio, które już nie działa...</language>
	</row>
	<row id="msg_0131_D45R0102_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie możesz włączyć radia.\nGiovanni musiał je tu zostawić...</language>
	</row>
	<row id="msg_0131_D45R0102_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CELEBI...!\rMusi wyzdrowieć, inaczej nigdy nie\nzdołamy wrócić do naszego czasu!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CELEBI...!\rMusi wyzdrowieć, inaczej nigdy nie\nzdołamy wrócić do naszego czasu!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan użył Max Revive na CELEBI!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra użyła Max Revive na CELEBI!\r</language>
	</row>
	<row id="msg_0131_D45R0102_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{COLOR 1}Podróż w Czasie{COLOR 0}......!\rTo już! Proszę, zabierz nas do\nnaszego czasu!\r</language>
	</row>
