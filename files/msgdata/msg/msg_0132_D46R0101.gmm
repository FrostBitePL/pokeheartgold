<?xml version="1.0"?>
<body language="English">
	<row id="msg_0132_D46R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dorota: Przyjechałem do Regionu\nŚwidnica szukać Pokémonów typu\fRobaczego, żebym mógł stać się\fsilniejszym Trenerem Pokémonów typu\fRobaczego!\rHej, może wymienimy się numerami\ntelefonu? {YESNO 0}</language>
	</row>
	<row id="msg_0132_D46R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zarejestrował(a)\nBugsy’ego w Pokégearze!</language>
	</row>
	<row id="msg_0132_D46R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dorota: Możemy walczyć w czwartki,\nokoło południa!\fZadzwoń do mnie!</language>
	</row>
	<row id="msg_0132_D46R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dorota: Ech, no cóż...\nW porządku...</language>
	</row>
	<row id="msg_0132_D46R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dorota: Dasz mi swój numer\ntelefonu? {YESNO 0}</language>
	</row>
</body>
