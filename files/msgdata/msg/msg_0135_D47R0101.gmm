	<row id="msg_0135_D47R0101_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszamy ponownie.</language>
	</row>
	<row id="msg_0135_D47R0101_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DS Wireless Communications zostanie\nuruchomione. {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Błąd komunikacji.\rProszę powtórz proces rejestracji\nod początku.</language>
