	</row>
	<row id="msg_0135_D47R0101_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Safari Zone Link zostało zakończone!\rProszę podejdź do recepcji obok\nciebie.</language>
	</row>
	<row id="msg_0135_D47R0101_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi, ale tego nie da się\njeszcze użyć.</language>
