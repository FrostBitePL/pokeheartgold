<?xml version="1.0"?>
<body language="English">
	<row id="msg_0135_D47R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Safari Zone!\rZa jedyne ${STRVAR_1 52, 1, 0} możesz zagrać\nw Grę Safari.\rMożesz wędrować po rozległej Safari\nZone i łapać, co tylko chcesz.\fChcesz zagrać? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Właścicielu!\nWitaj w Safari Zone!\rZa jedyne ${STRVAR_1 52, 1, 0} możesz zagrać\nw Grę Safari.\rMożesz wędrować po rozległej Safari\nZone i łapać, co tylko chcesz.\fChcesz zagrać? {YESNO 0}\n</language>
	</row>
	<row id="msg_0135_D47R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To będzie ${STRVAR_1 52, 1, 0}, proszę!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze.\nZapraszamy ponownie!</language>
	</row>
	<row id="msg_0135_D47R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oto twoje Safari Balle!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) {STRVAR_1 51, 1, 0}\nSafari Balli od pracownika.</language>
	</row>
	<row id="msg_0135_D47R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawołamy cię, gdy skończą ci się\nSafari Balle.\fCóż, mam nadzieję, że dobrze się\fpobawisz!\rIdź i baw się dobrze!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wciąż masz Safari Balle.\nOpuścić Safari Zone? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczywiście.\rProszę zwróć wszystkie pozostałe\nSafari Balle.\r</language>
	</row>
	<row id="msg_0135_D47R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze się bawiłeś/aś?\nZapraszamy ponownie!</language>
	</row>
	<row id="msg_0135_D47R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi.\nNie masz wystarczająco pieniędzy.\rMam nadzieję, że wpadniesz jeszcze.</language>
	</row>
	<row id="msg_0135_D47R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Właścicielu!\nNie masz wystarczająco pieniędzy.\rMam nadzieję, że wpadniesz jeszcze.</language>
	</row>
	<row id="msg_0135_D47R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi.\nNie ma już miejsca w PC!\rProszę wróć, gdy zrobisz jakieś\nmiejsce.</language>
	</row>
	<row id="msg_0135_D47R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Właścicielu!\nNie ma już miejsca w PC!\rProszę wróć, gdy zrobisz jakieś\nmiejsce.</language>
	</row>
	<row id="msg_0135_D47R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć! Jesteś tu w Safari Zone\npo raz pierwszy? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj, Właścicielu!\nCzy mam wyjaśnić Safari Zone? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Safari Zone możesz cieszyć się\nGrą Safari, w której dostajesz\f{STRVAR_1 51, 1, 0} Safari Balli, żeby spróbować\fzłapać Pokémony.\rGdy skończą ci się Safari Balle,\ngra się kończy.\rGdy zobaczysz Pokémona, możesz\nrzucić Przynętę lub Błoto.\rJeśli rzucisz Przynętę, Pokémon\nzwykle zostaje, ale trudniej go złapać.\rJeśli rzucisz Błoto, łatwiej go\nzłapać, ale Pokémon może uciec.\rBaw się dobrze w Safari Zone!</language>
	</row>
	<row id="msg_0135_D47R0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Baw się dobrze w Safari Zone!</language>
	</row>
	<row id="msg_0135_D47R0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strażnik Baoba ma coś ważnego,\nczym chce się z tobą podzielić!</language>
	</row>
	<row id="msg_0135_D47R0101_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest Area Customizer.\nCo chciałbyś(-abyś) wiedzieć? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Safari Zone ma sześć Obszarów.\rObszar Równinny...\nObszar Szczytowy...\fi tak dalej.\rArea Customizer pozwala ci\nzmieniać kombinację tych Obszarów.\rCo chciałbyś(-abyś) wiedzieć? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprawdź maszynę, a zobaczysz ekran\nArea Customizer.\rDolne okno pokazuje aktualne\nustawienie Safari Zone.\rWybierz Obszar przyciskiem A,\nżeby zamienić go na inny.\rCo chciałbyś(-abyś) wiedzieć? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy wybierzesz Obszar, a potem\nwybierzesz Zamień, zobaczysz\f12 nowych Obszarów.\rWybierz jeden z nich, podświetlając\ngo i naciskając przycisk A.\rCo chciałbyś(-abyś) wiedzieć? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy wybierzesz Obszar, a potem\nwybierzesz Kolejność, typ Obszaru\fsię nie zmieni, ale lokalizację\fmożna teraz zmienić.\rCo chciałbyś(-abyś) wiedzieć? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W różnych Obszarach mieszkają różne\nPokémony, więc gdy zmienisz Obszary,\fzobaczysz inne Pokémony.\rSpróbuj wypróbować różne Obszary!\nCo chciałbyś(-abyś) wiedzieć? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi, ale tego nie da się\njeszcze użyć. Strażnik Baoba ma\fwielki plan dla tej maszyny...a\ftak przynajmniej mówi. Ale nawet\fmy nie wiemy, o co chodzi. To\ftajemnica.</language>
	</row>
	<row id="msg_0135_D47R0101_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszamy do korzystania z Area\nCustomizer!</language>
	</row>
	<row id="msg_0135_D47R0101_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} włączył(a)\nArea Customizer!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wciąż jest w fazie rozwoju.</language>
	</row>
	<row id="msg_0135_D47R0101_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, czekałem na ciebie!\nCo o tym myślisz?\rTo jest zupełnie nowa Safari Zone.\nSwoją drogą...\rWłaśnie wpadłem na pomysł.\nChciałbyś(-abyś) podejść do Testu\fPredyspozycji Właściciela? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świetnie!\nPozwól, że wyjaśnię, jak działa\ftest. To bardzo proste.\rWystarczy, że złapiesz jednego\nGEODUDE w Safari i pokażesz mi go.\rSą w trawie najbliżej wejścia.\nZłapanie jednego nie powinno\fzająć długo.\rPowodzenia!</language>
	</row>
	<row id="msg_0135_D47R0101_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, nigdy nie myślałem, że ktoś\nodmówi!\rMożesz zostać Właścicielem Safari\nZone, czy tego nie widzisz?\rWłaściciel...\nNieźle to brzmi, prawda?\rPowinieneś/aś spróbować testu! {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, wspaniale!\nZłapałeś/aś GEODUDE!\fZdałeś/aś pierwszy test.\r..................\rHę? Czy nie mówiłem ci, że są\ndwa testy?\rZgadza się!\nZostanie właścicielem nie jest\ftakie łatwe.\rDrugi test to...\nCóż, wciąż go przygotowuję.\rDam ci znać, gdy będzie gotowy.\nMusisz jeszcze trochę poczekać.\fZadzwonię do ciebie przez Pokégear.</language>
	</row>
	<row id="msg_0135_D47R0101_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokaż mi GEODUDE, gdy już go\nzłapiesz.\rSą w trawie najbliżej wejścia.\nNie powinno to zająć długo.\rPowodzenia!</language>
	</row>
	<row id="msg_0135_D47R0101_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekałem na ciebie!\nTest jest gotowy.\rTym razem złap SANDSHREW\ni pokaż mi go, dobrze?\rBrzmi łatwo, prawda? Wcale nie!\nSANDSHREW nie pojawi się przy\fobecnym ustawieniu Safari Zone.\rI właśnie tutaj przydaje się to!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta wyrafinowana, zaawansowana\ntechnologicznie maszyna pozwala\fdostosowywać Obszary Safari Zone.\fNazywam ją Area Customizer!\rChcesz wiedzieć, jak działa,\nprawda?\fTo...tajemnica!\rCóż, nie powinieneś/aś mieć\nproblemu z jej obsługą. Po prostu\fporozmawiaj z pracownikiem obok\fmnie!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prawie zapomniałem!\rByłem w trakcie wyjaśniania\ndrugiego testu, prawda?\rNie zobaczysz SANDSHREW przy\nobecnych Obszarach Safari Zone,\rwięc musisz użyć Area Customizer,\nżeby je zmienić.\rSANDSHREW mieszkają na pustyni!\nPowodzenia!</language>
	</row>
	<row id="msg_0135_D47R0101_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Udało ci się!\rZłapałeś/aś SANDSHREW!\nWiedziałem, że dasz radę.\rZdałeś/aś test!\nTeraz jesteś Właścicielem Safari\fZone!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze chciałem zobaczyć, jak młodzi\nludzie bawią się w safari!\rPomyślałem, że mogę zdobyć jakieś\nnowe pomysły. To powinno pomóc\fci ukończyć Pokédex.\rWłaśnie tak myślałem.\r</language>
	</row>
	<row id="msg_0135_D47R0101_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawiasem mówiąc, chociaż jesteś\nteraz Właścicielem Safari Zone,\fczy mógłbyś nadal płacić za wstęp?\fMamy swoje powody.\rNie denerwuj się. Będę wciąż\nmyślał, jak stworzyć nowe, zabawne\fsposoby, żeby pomóc ci ukończyć\fPokédex.\rIdź i baw się dobrze w Safari Zone!</language>
	</row>
	<row id="msg_0135_D47R0101_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci znać przez Pokégear, gdy\ntylko wymyślę coś nowego!</language>
	</row>
	<row id="msg_0135_D47R0101_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokaż mi SANDSHREW, gdy już go\nzłapiesz. SANDSHREW mieszkają na\fpustyni! Powodzenia!</language>
	</row>
	<row id="msg_0135_D47R0101_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwolnij trochę.\rGdy kolejny test będzie gotowy,\nzadzwonię do ciebie przez Pokégear.\rDaj mi trochę czasu, dobrze?</language>
	</row>
	<row id="msg_0135_D47R0101_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, czekałem na ciebie!\rMiałem olśnienie!\nNowa atrakcja!\rPostanowiłem nazwać ją...\nAranżacja Obiektów!\rBędzie super fajnie!\nMożesz umieszczać obiekty na polu,\fbawiąc się w Safari Zone!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co więcej, rodzaje Pokémonów, które\nzobaczysz, zmienią się w zależności\fod rodzajów umieszczonych obiektów.\rCzy to nie niesamowite?\nZadzwonię do ciebie przez Pokégear,\fjeśli pojawi się coś jeszcze!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyjaśnię Aranżację Obiektów.\nCzy chciałbyś(-abyś) coś wiedzieć? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyjaśnię Aranżację Obiektów.\nŚmiało zadawaj mi dowolne pytania.\r</language>
	</row>
	<row id="msg_0135_D47R0101_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest wiele obiektów, które możesz\numieszczać wszędzie, chodząc po\fSafari Zone, poza schodami i trawą,\fw której pojawiają się Pokémony!\rPamiętaj też, że możesz umieścić\ndo 30 obiektów w jednym Obszarze.\rCzy chciałbyś(-abyś) wiedzieć\njeszcze coś? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umieszczanie obiektów jest łatwe.\nWystarczy upewnić się, że miejsce\fprzed tobą jest wolne.\rJeśli jest puste, możesz wybrać\nobiekt.\rNiektóre obiekty są duże i mogą\npotrzebować sporo miejsca.\rCzy chciałbyś(-abyś) wiedzieć\njeszcze coś? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chcesz usunąć obiekt, po\nprostu podejdź do niego i sprawdź\fgo. Umieszczone obiekty będą\fświecić w ciemności.\fPowinno to pomóc ci nocą.\rCzy chciałbyś(-abyś) wiedzieć\njeszcze coś? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest wiele różnych obiektów.\nTakie, które wyglądają jak trawa,\fjak drzewa, jak głazy, jak woda,\fi inne rodzaje obiektów...\rSpróbuj umieścić różne obiekty.\nLiczba obiektów umieszczonych\fw Obszarze jest pokazana w Area\fCustomizer na górnym ekranie.\rBędzie coraz więcej obiektów, bo\nbędę ciągle dodawać nowe.\rCzy chciałbyś(-abyś) wiedzieć\njeszcze coś? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rodzaje Pokémonów, które zobaczysz,\nzmienią się w zależności od rodzajów\fumieszczonych obiektów.\rSafari Zone również się wtedy\nzmienia. Spróbuj umieścić różne\frodzaje obiektów.\rCzy chciałbyś(-abyś) wiedzieć\njeszcze coś? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważaj!\rGdy zamienisz Obszary, wszystkie\numieszczone przez ciebie obiekty\fzostaną usunięte.\rCzy chciałbyś(-abyś) wiedzieć\njeszcze coś? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam nadzieję, że ci się spodoba!\nIdź i baw się dobrze!</language>
	</row>
	<row id="msg_0135_D47R0101_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Safari Zone {STRVAR_1 3, 0, 0}!\rZa jedyne $500 możesz zagrać\nw Grę Safari.\rMożesz wędrować po rozległej Safari\nZone i łapać, co tylko chcesz.\fChcesz zagrać? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To będzie ${STRVAR_1 52, 1, 0}, proszę!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze.\nZapraszamy ponownie!</language>
	</row>
	<row id="msg_0135_D47R0101_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oto twoje Safari Balle.\r</language>
	</row>
	<row id="msg_0135_D47R0101_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) {STRVAR_1 51, 1, 0}\nSafari Balli.</language>
	</row>
	<row id="msg_0135_D47R0101_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawołamy cię, gdy skończą ci się\nSafari Balle.\rCóż, życzę ci powodzenia!\r</language>
	</row>
	<row id="msg_0135_D47R0101_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie masz Safari Zone swojego\nznajomego.\fPrzykro mi, ale nie możesz tu wejść.\rProszę porozmawiaj z pracownikiem\nobok mnie.</language>
	</row>
	<row id="msg_0135_D47R0101_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wciąż masz czas. Na pewno chcesz\nopuścić Safari Zone?</language>
	</row>
	<row id="msg_0135_D47R0101_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczywiście.\rProszę zwróć wszystkie pozostałe\nSafari Balle.\r</language>
	</row>
	<row id="msg_0135_D47R0101_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze się bawiłeś/aś?\nZapraszamy ponownie!</language>
	</row>
	<row id="msg_0135_D47R0101_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi.\nNie masz wystarczająco pieniędzy.\rMam nadzieję, że wpadniesz jeszcze.</language>
	</row>
	<row id="msg_0135_D47R0101_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Właścicielu!\rTo jest recepcja Safari Zone Link.\rMożesz tutaj wymieniać Safari Zone.\rChcesz połączyć się ze znajomymi,\nżeby wymienić Safari Zone? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest recepcja Safari Zone Link.\rMożesz tutaj wymieniać Safari Zone.\rChcesz połączyć się ze znajomymi,\nżeby wymienić Safari Zone? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chciałbyś(-abyś) zapisać grę?</language>
	</row>
	<row id="msg_0135_D47R0101_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest już zapisany plik.\nCzy można go nadpisać?</language>
	</row>
	<row id="msg_0135_D47R0101_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapisywanie...\nNie wyłączaj zasilania.</language>
	</row>
	<row id="msg_0135_D47R0101_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) grę.</language>
	</row>
	<row id="msg_0135_D47R0101_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę zdecydujcie, które z was\ndwojga zostanie liderem grupy.\rDrugi gracz musi wtedy wybrać\n„DOŁĄCZ DO GRUPY”. {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierz gracza, z którym chcesz\nwymienić Safari Zone. {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczekiwanie na odpowiedź\n{STRVAR_1 3, 0, 0}...</language>
	</row>
	<row id="msg_0135_D47R0101_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} odpowiedział(a)\n„OK”!</language>
	</row>
	<row id="msg_0135_D47R0101_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} odpowiedział(a):\n„Nie”...</language>
	</row>
	<row id="msg_0135_D47R0101_00076" index="76">
		<attribute name="window_context_name">used</attribute>
