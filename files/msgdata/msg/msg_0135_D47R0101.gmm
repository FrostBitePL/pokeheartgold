	</row>
	<row id="msg_0135_D47R0101_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} odpowiedział(a)!\rCzy chciałbyś(-abyś) wymienić Safari\nZone z {STRVAR_1 3, 0, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0135_D47R0101_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wysłano „OK”\ndo {STRVAR_1 3, 0, 0}.</language>
	</row>
	<row id="msg_0135_D47R0101_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaraz otrzymasz Safari Zone.\nProszę czekaj.</language>
	</row>
	<row id="msg_0135_D47R0101_00082" index="82">
		<attribute name="window_context_name">used</attribute>
