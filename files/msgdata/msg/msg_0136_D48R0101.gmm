<?xml version="1.0"?>
<body language="English">
	<row id="msg_0136_D48R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiedziałeś/aś?\nBudują Safari Zone tuż za rogiem.\rMówią, że będzie naprawdę fajnie!\nZobaczysz wiele różnych rodzajów\fPokémonów i wszystkie możesz łapać!\rNie ma powodu, żeby tam nie iść,\nprawda? Tak bardzo czekam na\fSafari Zone!\rNiech już skończą tę budowę!</language>
	</row>
	<row id="msg_0136_D48R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiedziałeś/aś? Jest Safari Zone\ntuż za rogiem.\rTo naprawdę fajne!\nZobaczysz wiele różnych rodzajów\fPokémonów i wszystkie możesz łapać!\rNie ma powodu, żeby tam nie iść,\nprawda? Tuż za rogiem.\rTo nie zajmie dużo czasu.\nMoże wpadniesz? Wpadniesz? {YESNO 0}</language>
	</row>
	<row id="msg_0136_D48R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze!\nJest właśnie tam.\rWejdź po schodach, a będziesz na\nzewnątrz. Potem to tylko kilka\fkroków!</language>
	</row>
	<row id="msg_0136_D48R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To taka dobra okazja, wiesz?</language>
	</row>
	<row id="msg_0136_D48R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? Safari Zone było fajne?\nNie musisz nic mówić!\fTwoja twarz mówi, że było naprawdę\ffajnie!</language>
	</row>
	<row id="msg_0136_D48R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co?\nTy też chcesz iść do Safari Zone?\rWciąż jest w budowie.\nProszę, wróć później.</language>
	</row>
	<row id="msg_0136_D48R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doceniam, że wszyscy tak na to\nczekają. Ale pani przy recepcji\fwydaje się nieco zbyt dramatyczna...\fNie nastawiaj się na zbyt wiele!</language>
	</row>
	<row id="msg_0136_D48R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Hej, {STRVAR_1 3, 0, 0}!\nMiło znów cię widzieć! Ale nigdy\fnie spodziewałem się zobaczyć cię\ftutaj.\rCzy to możliwe...że jesteś w drodze\nna Embedded Tower?\rEmbedded Tower to ogromna wieża\nprzebijająca niebo.\rMówi się, że ma coś wspólnego\nz mitycznym Pokémonem, który rozciągnął\fmorza, oraz tym Pokémonem, który\fposzerzył lądy.\rAle ta wieża już nie stoi.\r</language>
	</row>
	<row id="msg_0136_D48R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Droga do Embedded Tower\njest trudniejsza, niż możesz sobie\fwyobrazić.\rMusisz użyć zarówno Wspinaczki\npo Skałach, jak i Surfu.\r</language>
	</row>
	<row id="msg_0136_D48R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Rozumiem! Więc pokonałeś/aś\ntakże wszystkich Liderów Sal w Kanto!\rW takim razie nie ma się czym\nmartwić. Wierz w siebie i podążaj\fswoją drogą.\rYahaha!\r</language>
	</row>
	<row id="msg_0136_D48R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystko Jest Ekscytujące!\nZwiedzaj, żeby Znaleźć Dzikie\fPokémony!\rSafari Zone Strażnika Baoby\nJuż Wkrótce!</language>
	</row>
	<row id="msg_0136_D48R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystko Jest Ekscytujące!\nZwiedzaj, żeby Znaleźć Dzikie\fPokémony!\rSafari Zone Strażnika Baoby\nJuż Działa!</language>
	</row>
</body>
