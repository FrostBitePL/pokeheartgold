<?xml version="1.0"?>
<body language="English">
	<row id="msg_0141_D49R0105_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To sala „Zaufania”.\rMa ukazywać wzajemne poleganie\nna sobie Pokémonów i ludzi.</language>
	</row>
	<row id="msg_0141_D49R0105_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tylko Pokéatleci, którzy zajęli\npierwsze miejsce w pięciu\fkonkurencjach z jednym Pokémonem,\fmogą tu wejść.</language>
	</row>
	<row id="msg_0141_D49R0105_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To sala „Potencjału”.\nProszę, wejdź.</language>
	</row>
	<row id="msg_0141_D49R0105_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By zdobywać Medale z różnymi\nrodzajami Pokémonów, trzeba przede\fwszystkim wierzyć w swojego\fPokémona.</language>
	</row>
	<row id="msg_0141_D49R0105_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbiałbym/łabym zobaczyć tu\nswoje własne buty!</language>
	</row>
	<row id="msg_0141_D49R0105_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta Kopuła zawiera tak wiele\ninnych kopuł...</language>
	</row>
	<row id="msg_0141_D49R0105_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} sprawdził/a Medal!\r</language>
	</row>
	<row id="msg_0141_D49R0105_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ci, którzy wzięli udział\nw Pokéathlonie 50 razy, są tu\fupamiętnieni za swojego niezłomnego\fducha.</language>
	</row>
	<row id="msg_0141_D49R0105_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To twoja koszulka z twoim\nautografem!</language>
	</row>
	<row id="msg_0141_D49R0105_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ci, którzy sprintowali 5000 razy,\nsą tu upamiętnieni za osiągnięcie\fpolegające na pobiciu legendarnego\frekordu.</language>
	</row>
	<row id="msg_0141_D49R0105_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fajne buty!\nI to w twoim modelu!</language>
	</row>
	<row id="msg_0141_D49R0105_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ci, którzy zamienili Pokémona 200 razy,\nsą tu upamiętnieni za świetną\fwspółpracę i więź ze swoim\fPokémonem.</language>
	</row>
	<row id="msg_0141_D49R0105_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To fajna flaga!\nI jest twoja!</language>
	</row>
	<row id="msg_0141_D49R0105_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Medale Pokéathlonu...\rTo dowód ciężkiej pracy zarówno\nPokéatletów, jak i Pokémonów.\rPokémony, które zdobyły wszystkie\npięć Medali, nazywane są\f„Pokémonami Medalistami”, na\fpamiątkę zaufania, jakie zdobyły\fod swojego Pokéatlety.</language>
	</row>
	<row id="msg_0141_D49R0105_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ABRA: ...\n...\f...\rChyba śpi!</language>
	</row>
	<row id="msg_0141_D49R0105_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DRATINI: Achoo!</language>
	</row>
</body>
