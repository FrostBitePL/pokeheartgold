<?xml version="1.0"?>
<body language="English">
	<row id="msg_0143_D49R0107_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Magnus: O rety!\r</language>
	</row>
	<row id="msg_0143_D49R0107_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To ty...!\nRzeczywiście, to ty, {STRVAR_1 3, 0, 0}!\rWspaniale!\nToż to niemałe osiągnięcie, że\fzaszedłeś/aś aż tutaj, druhu!\r</language>
	</row>
	<row id="msg_0143_D49R0107_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To sala „Przyjaźni”.\rZbudowano ją, by uczcić solidarność,\nzaufanie i potencjał Pokémonów\fi ludzi oraz wyrazić nadzieję na\fwieczną przyjaźń między Pokémonami\fa ludźmi.\r</language>
	</row>
	<row id="msg_0143_D49R0107_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje!\rTa sala jest tylko dla prawdziwych\nPokéatletów, którzy zdobyli\fprawdziwą przyjaźń z Pokémonami!\r{STRVAR_1 3, 0, 0}!\nJesteś prawdziwym Pokéatletą, druhu!\r</language>
	</row>
	<row id="msg_0143_D49R0107_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powiedziawszy to...\nto również moment\fnowego początku...\r</language>
	</row>
	<row id="msg_0143_D49R0107_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się, druhu!\nWłaśnie usłyszałeś/aś nowy sygnał\fstartowy. Twoje wyzwanie trwa dalej,\fku zupełnie nowym wyżynom, na drodze\fdo zostania legendarnym Pokéatletą!\rSpójrz na ten posąg.\nMoże właśnie patrzysz na swój cel...\r</language>
	</row>
	<row id="msg_0143_D49R0107_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Magnus: To sala „Przyjaźni”.\nJest ostatnia ze wszystkich. To sala,\fw której składa się przysięgę wiecznej\fprzyjaźni między ludźmi a Pokémonami.\r...Ale to nie jest twój cel, druhu.\rKażda sala ma Trofea do zdobycia,\nale ty możesz dążyć do dowolnych\fnowych wyżyn.\rTo zależy wyłącznie od ciebie, czy\ntam dotrzesz, czy nie...\rZgadza się!\rTwój prawdziwy cel to nie coś,\nco może za ciebie ustalić ktoś\finny, druhu.\r{STRVAR_1 3, 0, 0}!\nMożesz pokonać każdą trudność\fdzięki przyjaźni ze swoim Pokémonem.</language>
	</row>
	<row id="msg_0143_D49R0107_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To twój posąg!\r</language>
	</row>
	<row id="msg_0143_D49R0107_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Posąg Pokémona, z którym\ndzieliłeś/aś swoją podróż,\fwzajemnie sobie pomagając\fi pielęgnując przyjaźń!</language>
	</row>
	<row id="msg_0143_D49R0107_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To posąg medalisty wśród Pokémonów.\rCzy chcesz zastąpić go innym?</language>
	</row>
	<row id="msg_0143_D49R0107_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz ustawić posąg Pokémona\nmedalisty, który zdobył\fpięć medali.\rCzy chcesz ustawić posąg?</language>
	</row>
	<row id="msg_0143_D49R0107_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To posąg medalisty wśród Pokémonów.\rCzy chcesz zastąpić go innym?</language>
	</row>
	<row id="msg_0143_D49R0107_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz ustawić posąg Pokémona\nmedalisty, który zdobył\fpięć medali.\rCzy chcesz ustawić posąg?</language>
	</row>
	<row id="msg_0143_D49R0107_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To posąg medalisty wśród Pokémonów.\rCzy chcesz zastąpić go innym?</language>
	</row>
</body>
