<?xml version="1.0"?>
<body language="English">
	<row id="msg_0146_D51R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: To jest {COLOR 1}Mystri Stage{COLOR 0}.\nMityczna scena zbudowana, by okazać\fszacunek ARCEUSOWI.\rMówi się, że ludzie dawniej\nświętowali jego wspaniałą potęgę\fmuzyką i tańcem.\rNiektórzy ludzie w Johto wciąż\nprzekazują tę tradycję.\r</language>
	</row>
	<row id="msg_0146_D51R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: To jest {COLOR 1}Mystri Stage{COLOR 0}.\nMityczna scena zbudowana, by okazać\fszacunek ARCEUSOWI.\rMówi się, że ludzie dawniej\nświętowali jego wspaniałą potęgę\fmuzyką i tańcem.\rNiektórzy ludzie w Johto wciąż\nprzekazują tę tradycję.</language>
	</row>
	<row id="msg_0146_D51R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: {COLOR 1}Mystri Stage{COLOR 0} pozwala\nwejść na scenę tylko jednemu\fARCEUSOWI i nikomu więcej...\rJeśli chcesz tam wejść, musisz\nzdeponować pozostałe Pokémony\fw Skrzynce PC w chatce.</language>
	</row>
	<row id="msg_0146_D51R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Przynieś zamiast tego\nswojego ARCEUSA.\rKażdy inny Pokémon może zostać\nzdmuchnięty przez potężną moc\funoszącą się w ruinach.\r</language>
	</row>
	<row id="msg_0146_D51R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: To jest moment, w którym\nmożna by powiedzieć: „Główny bohater\fwreszcie wkracza na {COLOR 1}Mystri Stage{COLOR 0}”.\rCałe moje badanie ruin i mitologii\nPokémonów w Sinnoh mogło mieć na\fcelu przyprowadzenie cię na tę\fscenę właśnie dzisiaj...\r</language>
	</row>
	<row id="msg_0146_D51R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Na {COLOR 1}Mystri Stage{COLOR 0}\nprzedstawione są Pokémony, które\fukształtowały ten świat.\rKrąg na środku to ARCEUS,\npochodzenie tego wszystkiego...\r</language>
	</row>
	<row id="msg_0146_D51R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Zgodnie ze starożytnym\ndokumentem, czas, przestrzeń\fi antymateria, czyli to, co razem\fnazywamy światem, narodzi się, gdy\fARCEUS stanie na {COLOR 1}Mystri Stage{COLOR 0}.\r</language>
	</row>
	<row id="msg_0146_D51R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: To jest wzór, który\nreprezentuje PALKIĘ, władcę\fprzestrzeni i wymiarów...\r</language>
	</row>
	<row id="msg_0146_D51R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: To jest wzór, który\nreprezentuje DIALGĘ, strażnika\fczasu...\r</language>
	</row>
	<row id="msg_0146_D51R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: To jest wzór, który\nreprezentuje GIRATINĘ, władcę\fświata leżącego po przeciwnej\fstronie naszego, świata antymaterii...\r</language>
	</row>
	<row id="msg_0146_D51R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: ARCEUS zaakceptował cię\njako Trenera.\rMówi się, że ARCEUS, który\nukształtował świat, pokaże ci\fprzebłysk swojej prawdziwej mocy.\rMoc mogącą sprawić, że życie\npowstanie z niczego...\r</language>
	</row>
	<row id="msg_0146_D51R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Wygląda na to, że coś się\nstanie, gdy wybierzesz jeden\fz kręgów...\rBędziesz chciał/a być dobrze\nprzygotowany/a.</language>
	</row>
	<row id="msg_0146_D51R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Gdy będziesz gotowy/a,\nwybierz krąg i stań na jego środku.</language>
	</row>
	<row id="msg_0146_D51R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Więc wybierasz DIALGĘ,\nstrażnika czasu? {YESNO 0}</language>
	</row>
	<row id="msg_0146_D51R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Więc wybierasz PALKIĘ,\nwładcę przestrzeni i wymiarów? {YESNO 0}</language>
	</row>
	<row id="msg_0146_D51R0201_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Więc wybierasz GIRATINĘ,\nwładcę Distortion World? {YESNO 0}</language>
	</row>
	<row id="msg_0146_D51R0201_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Ta lśniąca kula...\nCzy to może być...Jajko?\rCzy właśnie byliśmy świadkami momentu,\nw którym Jajko zostało sprowadzone\fna ten świat? Momentu, którego nikt\fnigdy nie widział?\r</language>
	</row>
	<row id="msg_0146_D51R0201_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Jajko jest kolebką każdej\nistoty. Ta planeta sama w sobie jest\fw pewnym sensie Jajkiem...\rŻycie, które wywodzi się z Jajka,\ndobiegnie w swoim czasie końca...\fżeby zacząć się od nowa...\rMoże właśnie to ARCEUS chciał\nnam pokazać.\r\n</language>
	</row>
	<row id="msg_0146_D51R0201_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Co to było...?\r</language>
	</row>
	<row id="msg_0146_D51R0201_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Wygląda na to, że znów\notacza nas ta potężna moc...!\r</language>
	</row>
	<row id="msg_0146_D51R0201_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: Oczywiście... ARCEUS!\rWięc źródłem mocy, którą\nwyczuwałam, był ARCEUS!\r</language>
	</row>
	<row id="msg_0146_D51R0201_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: To, co dziś jest {COLOR 1}Sinjoh Ruins{COLOR 0},\nzostało zbudowane przez lud Sinnoh,\fby uhonorować ARCEUSA...\rTo skuta lodem świątynia, która\nczekała na ARCEUSA przez setki lat...\r</language>
	</row>
	<row id="msg_0146_D51R0201_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: To jest {COLOR 1}Mystri Stage{COLOR 0}.\rZostała zaprojektowana, by wydobyć\nmoc, którą posiada ARCEUS.\r</language>
	</row>
	<row id="msg_0146_D51R0201_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: ARCEUS jest opisywany\nw mitologii jako pochodzenie\fwszystkiego i źródło wszelkiego\fistnienia.\rMówi się, że moc ARCEUSA jest\nuwalniana na {COLOR 1}Mystri Stage{COLOR 0}!\r</language>
	</row>
	<row id="msg_0146_D51R0201_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cynthia: {COLOR 1}Sinjoh Ruins{COLOR 0} to pozostałości\nświątyni zbudowanej, by okazać\fszacunek ARCEUSOWI.</language>
	</row>
	<row id="msg_0146_D51R0201_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tajemniczy okrągły obiekt\nprzybrał kształt Pokémona!\r</language>
	</row>
	<row id="msg_0146_D51R0201_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zdobył(a)\n{STRVAR_1 0, 1, 0}!</language>
	</row>
	<row id="msg_0146_D51R0201_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierzesz DIALGĘ? {YESNO 0}</language>
	</row>
	<row id="msg_0146_D51R0201_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierzesz PALKIĘ? {YESNO 0}</language>
	</row>
	<row id="msg_0146_D51R0201_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierzesz GIRATINĘ? {YESNO 0}</language>
	</row>
	<row id="msg_0146_D51R0201_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To miejsce nie wydaje się reagować...</language>
	</row>
	<row id="msg_0146_D51R0201_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na to, że tylko jeden\nARCEUS może tu stanąć...</language>
	</row>
	<row id="msg_0146_D51R0201_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chciałbyś(-abyś) nadać\nprzezwisko {STRVAR_1 0, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0146_D51R0201_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na to, że nie reaguje już\nna tego ARCEUSA...</language>
	</row>
</body>
