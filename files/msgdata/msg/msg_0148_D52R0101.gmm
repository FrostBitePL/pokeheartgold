<?xml version="1.0"?>
<body language="English">
	<row id="msg_0148_D52R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GROUDON: Grrgggrrrrah!\r</language>
	</row>
	<row id="msg_0148_D52R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GROUDON zniknął...</language>
	</row>
	<row id="msg_0148_D52R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No, witaj!\nTego się nie widuje codziennie!\rTen Pokémon to GROUDON, legendarny\nPokémon z hoeńskiego mitu o\fukształtowaniu tego regionu.\rRozumiem...\rEmbedded Tower zostało zbudowane\nprzez ludzi z Hoenn.\r</language>
	</row>
	<row id="msg_0148_D52R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieża, która łączy ze sobą morze,\nląd i niebo...\rGROUDON nie był jedynym Pokémonem\nopisanym w hoeńskim micie...\rTo miejsce może wciąż ukrywać\nswoje tajemnice...\r</language>
	</row>
	<row id="msg_0148_D52R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kompetentny Profesor Pokémonów\nmoże powiedzieć ci więcej, gdy\fpokażesz mu GROUDONA.\rUff!\rJest tak wiele powiązań między\nPokémonami a mitami.\rDo zobaczenia.\r</language>
	</row>
</body>
