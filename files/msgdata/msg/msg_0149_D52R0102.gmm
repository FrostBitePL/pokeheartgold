<?xml version="1.0"?>
<body language="English">
	<row id="msg_0149_D52R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KYOGRE: Gyararoooah!\r</language>
	</row>
	<row id="msg_0149_D52R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">KYOGRE zniknął...</language>
	</row>
	<row id="msg_0149_D52R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No, witaj!\nTego się nie widuje codziennie!\rTen Pokémon to KYOGRE, legendarny\nPokémon z hoeńskiego mitu o\fukształtowaniu tego regionu.\rRozumiem...\fRozumiem.\rEmbedded Tower zostało zbudowane\nprzez ludzi z Hoenn.\r</language>
	</row>
	<row id="msg_0149_D52R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieża, która łączy ze sobą morze,\nląd i niebo...\rKYOGRE nie był jedynym Pokémonem\nopisanym w hoeńskim micie...\rTo miejsce może wciąż ukrywać\nswoje tajemnice.\r</language>
	</row>
	<row id="msg_0149_D52R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kompetentny Profesor Pokémonów\nmoże powiedzieć ci więcej, gdy\fpokażesz mu KYOGRE.\rUff!\rJest tak wiele powiązań między\nPokémonami a mitami.\rDo zobaczenia.\r</language>
	</row>
</body>
