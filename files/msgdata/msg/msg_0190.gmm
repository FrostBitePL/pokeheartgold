<?xml version="1.0"?>
<body language="English">
	<row id="msg_0190_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Mariusz: Dotknij Poké Balla,\nżeby zobaczyć, jaki Pokémon jest w środku!</language>
	</row>
	<row id="msg_0190_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Mariusz: Więc podoba ci się\n{COLOR 3}BULBASAUR{COLOR 0}, Pokémon typu Grass?</language>
	</row>
	<row id="msg_0190_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Mariusz: Weźmiesz\n{COLOR 1}CHARMANDER{COLOR 0}, Pokémona typu Fire?</language>
	</row>
	<row id="msg_0190_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Mariusz: Chcesz\n{COLOR 2}SQUIRTLE{COLOR 0}, Pokémona typu Water?</language>
	</row>
	<row id="msg_0190_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W tym Poké Ballu jest\n{COLOR 3}BULBASAUR{COLOR 0}, Pokémon typu Grass!</language>
	</row>
	<row id="msg_0190_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W tym Poké Ballu jest\n{COLOR 1}CHARMANDER{COLOR 0}, Pokémon typu Fire!</language>
	</row>
	<row id="msg_0190_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W tym Poké Ballu jest\n{COLOR 2}SQUIRTLE{COLOR 0}, Pokémon typu Water!</language>
	</row>
	<row id="msg_0190_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy się zdecydujesz, dotknij Poké Balla!</language>
	</row>
	<row id="msg_0190_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotknij przycisku Poké Balla, by wybrać.\nDotknij gdzie indziej, by zmienić wybór.</language>
	</row>
</body>
