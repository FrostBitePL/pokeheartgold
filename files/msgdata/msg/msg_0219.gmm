<?xml version="1.0"?>
<body language="English">
	<row id="msg_0219_00000" index="0">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0219_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\n...\rZiiiewam...\n...\rHę? Już zrobiło się tak jasno\nna zewnątrz!\r</language>
	</row>
	<row id="msg_0219_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\n...\rZiiiewam...\n...\rHę? Co?! Już tak późno?!\nO nie! Zaspałem!\r</language>
	</row>
	<row id="msg_0219_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\n...\rHmm. Wygląda na to, że słońce\nzachodzi...\r...Więc to jest to, co nazywają\n„zmierzchem”, prawda?\r</language>
	</row>
	<row id="msg_0219_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\n...\rHmm... Ciekawe...\n...\rHę? Ach! Przepraszam, wybacz!\nWłaśnie czytałem tę książkę.\r</language>
	</row>
	<row id="msg_0219_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\n...\rZiiiewam...\n...\rHę? Gość?\nO tej porze?\r</language>
	</row>
	<row id="msg_0219_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam, że kazałem czekać!\rWitaj w świecie Pokémonów!\rNazywam się Profesor Oak.\rAle wszyscy nazywają mnie\nProfesorem Pokémonów.\rZanim ruszymy dalej, chciałbym\npowiedzieć Ci kilka rzeczy, które\fpowinieneś wiedzieć o tym świecie!\r</language>
	</row>
	<row id="msg_0219_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najpierw powiem Ci ważne\nrzeczy o tej grze.\n\nDotknij dowolny temat, o którym\nchciałbyś dowiedzieć się więcej,\nna dolnym ekranie.</language>
	</row>
	<row id="msg_0219_00008" index="8">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0219_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyjaśnię sterowanie tą grą.\n\nMożesz sterować grą, dotykając\ndolnego ekranu, zwanego też\nEkranem Dotykowym.\n\nDotknij panel w prawym dolnym\nrogu Ekranu Dotykowego.</language>
	</row>
	<row id="msg_0219_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotykając Ekranu Dotykowego\nw ten sposób, możesz potwierdzać\nwybory i kontynuować\nrozmowy.</language>
	</row>
	<row id="msg_0219_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz też kontynuować, naciskając\nprzycisk A, gdy zobaczysz jego ikonę\nna Ekranie Dotykowym.</language>
	</row>
	<row id="msg_0219_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Różne przyciski dotykowe będą się\npojawiać na Ekranie Dotykowym\nw zależności od sytuacji.</language>
	</row>
	<row id="msg_0219_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz wyjaśnię działanie\nprzycisków.\n\nMożesz poruszać główną postacią\npo ekranie za pomocą\nKrzyżaka.</language>
	</row>
	<row id="msg_0219_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz wyjaśnię przyciski.\n\nUżyj Krzyżaka, aby poruszać\ngłówną postacią.\n\nMożesz też użyć Krzyżaka,\naby wybierać opcje.</language>
	</row>
	<row id="msg_0219_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz obsługiwać ekrany za pomocą\nprzycisków zamiast dotykania\nEkranu Dotykowego.</language>
	</row>
	<row id="msg_0219_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Służy do potwierdzania wyboru, sprawdzania\nrzeczy, rozmowy i przewijania tekstu.\n\nSłuży do wyjścia, anulowania wyboru\ni anulowania trybu.</language>
	</row>
	<row id="msg_0219_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użyj tego, aby poruszać się w menu.\n\nNaciśnij, aby użyć Przedmiotu Kluczowego,\ntakiego jak Rower, który został\nwcześniej zarejestrowany.</language>
	</row>
	<row id="msg_0219_00018" index="18">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXX</language>
	</row>
