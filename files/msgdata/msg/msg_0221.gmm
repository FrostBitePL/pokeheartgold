<?xml version="1.0"?>
<body language="English">
	<row id="msg_0221_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">???</language>
	</row>
	<row id="msg_0221_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najlepszy Ball o najwyższym poziomie\nwydajności. Złapie każdego dzikiego\nPokémona bez pudła.</language>
	</row>
	<row id="msg_0221_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ultra-wydajny Ball, który zapewnia\nwyższy współczynnik złapania\nPokémona niż Great Ball.</language>
	</row>
	<row id="msg_0221_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobry, wysokiej jakości Ball, który\nzapewnia wyższy współczynnik złapania\nPokémona niż zwykły Poké Ball.</language>
	</row>
	<row id="msg_0221_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urządzenie do łapania dzikich\nPokémonów. Rzuca się nim jak piłką\nw cel. Zaprojektowane jako kapsuła.</language>
	</row>
	<row id="msg_0221_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Specjalny Poké Ball używany tylko\nw Great Marsh. Ozdobiony jest\nwzorem maskującym.</language>
	</row>
	<row id="msg_0221_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieco inny Poké Ball, który\ndziała szczególnie dobrze na Pokémony\ntypu Water i Bug.</language>
	</row>
	<row id="msg_0221_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieco inny Poké Ball, który\ndziała szczególnie dobrze na Pokémony\nżyjące w morzu.</language>
	</row>
	<row id="msg_0221_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieco inny Poké Ball, który\ndziała szczególnie dobrze na słabsze\nPokémony na wolności.</language>
	</row>
	<row id="msg_0221_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieco inny Poké Ball, który\ndziała szczególnie dobrze na gatunki\nPokémonów już wcześniej złapane.</language>
	</row>
	<row id="msg_0221_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieco inny Ball, który\nstaje się coraz lepszy im więcej\ntur trwa walka.</language>
	</row>
	<row id="msg_0221_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygodny Poké Ball, dzięki któremu\nzłapany dziki Pokémon szybko\nstaje się przyjazny.</language>
	</row>
	<row id="msg_0221_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieco rzadki Poké Ball, który\nzostał specjalnie wykonany na\npamiątkę pewnego wydarzenia.</language>
	</row>
	<row id="msg_0221_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieco inny Poké Ball, który\nułatwia łapanie dzikich Pokémonów\nw nocy lub w ciemnych miejscach jak jaskinie.</language>
	</row>
	<row id="msg_0221_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leczniczy Poké Ball, który przywraca\nzłapanemu Pokémonowi HP i eliminuje\nwszelkie problemy statusowe.</language>
	</row>
	<row id="msg_0221_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieco inny Poké Ball, który\nzapewnia lepszy współczynnik złapania,\njeśli użyty na początku dzikiego spotkania.</language>
	</row>
	<row id="msg_0221_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dość rzadki Poké Ball, który został\nspecjalnie wykonany na pamiątkę\npewnej okazji.</language>
	</row>
	<row id="msg_0221_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lek w sprayu na rany.\nPrzywraca HP jednego Pokémona\nzaledwie o 20 punktów.</language>
	</row>
	<row id="msg_0221_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lek w sprayu.\nUsuwa efekt zatrucia u jednego\nPokémona.</language>
