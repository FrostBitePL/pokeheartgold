	<row id="msg_0221_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dość mała perła, która lśni ładnym\nsrebrnym kolorem. Można ją tanio\nsprzedać sklepom.</language>
	</row>
	<row id="msg_0221_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dość duża perła, która lśni ładnym\nsrebrnym kolorem. Można ją sprzedać\nsklepom za wysoką cenę.</language>
	</row>
	<row id="msg_0221_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piękny, czerwony piasek o luźnej,\njedwabistej fakturze. Można go sprzedać\nsklepom za wysoką cenę.</language>
	</row>
	<row id="msg_0221_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odłamek ładnego klejnotu, który\nlśni czerwonym kolorem. Można go\nsprzedać sklepom za wysoką cenę.</language>
	</row>
	<row id="msg_0221_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bryłka czystego złota, która\nlśni blaskiem. Można ją sprzedać\nsklepom za wysoką cenę.</language>
	</row>
	<row id="msg_0221_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ładna, sercowata łuska, która jest\nniezwykle rzadka. Świeci delikatnie\nkolorami tęczy.</language>
	</row>
	<row id="msg_0221_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słodki miód o intensywnym aromacie,\nktóry przyciąga dzikie Pokémony, gdy\nużyty na trawie, w jaskiniach lub na drzewach.</language>
	</row>
	<row id="msg_0221_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawóz do rozsypania na miękkiej\nglebie. Przyspiesza wzrost Jagód.\nJednak też szybciej wysusza glebę.</language>
	</row>
	<row id="msg_0221_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawóz do rozsypania na miękkiej\nglebie. Spowalnia wzrost Jagód\ni sprawia, że gleba wysycha wolniej.</language>
	</row>
	<row id="msg_0221_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawóz do rozsypania na miękkiej\nglebie. Wydłuża czas, przez jaki\ndojrzałe Jagody pozostają na roślinie.</language>
	</row>
	<row id="msg_0221_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawóz do rozsypania na miękkiej\nglebie. Zwiększa liczbę nowych roślin\nrosnących tam, gdzie uschły dojrzałe rośliny.</language>
	</row>
	<row id="msg_0221_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skamielina prehistorycznego\nPokémona, który żył w morzu.\nWygląda jak część korzenia rośliny.</language>
	</row>
	<row id="msg_0221_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skamielina prehistorycznego\nPokémona, który żył w morzu.\nWygląda jak część pazura.</language>
	</row>
	<row id="msg_0221_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skamielina prehistorycznego\nPokémona, który żył w morzu.\nWygląda jak część muszli.</language>
	</row>
	<row id="msg_0221_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skamielina prehistorycznego\nPokémona, który żył w morzu.\nWygląda jak część skorupy.</language>
	</row>
	<row id="msg_0221_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kawałek bursztynu, który zawiera\nmateriał genetyczny prehistorycznego\nPokémona. Jest przezroczysty, z czerwonawym odcieniem.</language>
	</row>
	<row id="msg_0221_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skamielina prehistorycznego\nPokémona, który żył na lądzie.\nWygląda jak część kołnierza.</language>
	</row>
	<row id="msg_0221_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skamielina prehistorycznego\nPokémona, który żył na lądzie.\nWygląda jak część głowy.</language>
	</row>
	<row id="msg_0221_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kość niezwykle cenna dla\narcheologii Pokémonów. Można ją\nsprzedać sklepom za wysoką cenę.</language>
	</row>
	<row id="msg_0221_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Osobliwy kamień, który sprawia,\nże pewne gatunki Pokémonów\newoluują. Świeci olśniewającym światłem.</language>
	</row>
	<row id="msg_0221_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Osobliwy kamień, który sprawia,\nże pewne gatunki Pokémonów\newoluują. Jest tak ciemny, jak to możliwe.</language>
	</row>
	<row id="msg_0221_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Osobliwy kamień, który sprawia,\nże pewne gatunki Pokémonów\newoluują. Skrzy się jak oczy.</language>
	</row>
	<row id="msg_0221_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Osobliwy kamień, który sprawia,\nże pewne gatunki Pokémonów\newoluują. Ma kształt jajka.</language>
	</row>
	<row id="msg_0221_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Istotny przedmiot potrzebny, by\nzapobiec zawaleniu się kamiennej\nwieży. Czasem słychać z niego głosy.</language>
	</row>
	<row id="msg_0221_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świecąca kula do trzymania przez\nGIRATINĘ. Wzmacnia moc ruchów\ntypu Dragon i Ghost.</language>
	</row>
