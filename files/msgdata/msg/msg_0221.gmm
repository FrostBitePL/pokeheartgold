	<row id="msg_0221_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasno błyszcząca kula do trzymania\nprzez DIALGĘ. Wzmacnia moc ruchów\ntypu Dragon i Steel.</language>
	</row>
	<row id="msg_0221_00136" index="136">
