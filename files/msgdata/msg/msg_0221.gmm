		<language name="English">Pięknie świecąca kula do trzymania\nprzez PALKIĘ. Wzmacnia moc ruchów\ntypu Dragon i Water.</language>
	</row>
	<row id="msg_0221_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papeteria z nadrukiem orzeźwiająco\nzielonej łąki.\nDaj Pokémonowi do noszenia w celu wysyłki.</language>
	</row>
	<row id="msg_0221_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papeteria z nadrukiem płomieni\nw płonącej czerwieni.\nDaj Pokémonowi do noszenia w celu wysyłki.</language>
	</row>
	<row id="msg_0221_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papeteria z nadrukiem błękitnego\nświata pod wodą.\nDaj Pokémonowi do noszenia w celu wysyłki.</language>
	</row>
	<row id="msg_0221_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papeteria z nadrukiem ładnych\nkwiatowych wzorów.\nDaj Pokémonowi do noszenia w celu wysyłki.</language>
	</row>
	<row id="msg_0221_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papeteria z nadrukiem słabo\noświetlonej kopalni węgla.\nDaj Pokémonowi do noszenia w celu wysyłki.</language>
	</row>
	<row id="msg_0221_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papeteria z nadrukiem fajnych\nwzorów mechanicznych.\nDaj Pokémonowi do noszenia w celu wysyłki.</language>
	</row>
	<row id="msg_0221_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papeteria z nadrukiem ogromnych\nwzorów w kształcie serc.\nDaj Pokémonowi do noszenia w celu wysyłki.</language>
	</row>
	<row id="msg_0221_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papeteria z nadrukiem chłodnego,\npokrytego śniegiem świata.\nDaj Pokémonowi do noszenia w celu wysyłki.</language>
	</row>
	<row id="msg_0221_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Papeteria z nadrukiem ukazującym\nogromną przestrzeń kosmosu.\nDaj Pokémonowi do noszenia w celu wysyłki.</language>
	</row>
