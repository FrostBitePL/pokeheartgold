	<row id="msg_0221_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzymana przez Pokémona przywraca\njego HP, jeśli zostanie trafiony\nsuperefektywnym atakiem przeciwnika.</language>
	</row>
	<row id="msg_0221_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzymana przez Pokémona podnosi\ncelność ruchu tylko raz w krytycznej chwili.</language>
	</row>
	<row id="msg_0221_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzymana przez Pokémona sprawia,\nże wykona ruch pierwszy tylko raz\nw krytycznej chwili.</language>
	</row>
	<row id="msg_0221_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli Pokémon ją trzyma i trafi go\natak fizyczny przeciwnika, przeciwnik\nrówniez odnosi obrażenia.</language>
	</row>
	<row id="msg_0221_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli Pokémon ją trzyma i trafi go\natak specjalny przeciwnika, przeciwnik\nrówniez odnosi obrażenia.</language>
	</row>
	<row id="msg_0221_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Rzuca podstępne spojrzenie,\nktóre obniża celność przeciwnika.</language>
	</row>
	<row id="msg_0221_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Przywraca dowolną obniżoną\nstatystykę w walce. Można użyć tylko raz.</language>
	</row>
	<row id="msg_0221_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. To sztywna i ciężka opaska,\nktóra wspomaga wzrost, ale obniża Szybkość.</language>
	</row>
	<row id="msg_0221_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Posiadacz otrzymuje część\nPunktów Doświadczenia bez walki.</language>
	</row>
	<row id="msg_0221_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Lekki, ostry pazur, który\npozwala posiadaczowi czasem wykonać ruch pierwszy.</language>
	</row>
	<row id="msg_0221_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. To dzwonek o kojącym\ndźwięku, który uspokaja posiadacza i czyni go przyjaznym.</language>
	</row>
	<row id="msg_0221_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Wyrywa posiadacza z\nzauroczenia. Można użyć tylko raz.</language>
	</row>
	<row id="msg_0221_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Ta opaska podnosi Atak, ale\npozwala na użycie tylko jednego rodzaju ruchu.</language>
	</row>
	<row id="msg_0221_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Może sprawić, że przeciwnik\nwzdrygnie się, gdy posiadacz zada obrażenia.</language>
	</row>
	<row id="msg_0221_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. To błyszczący, srebrny proszek,\nktóry wzmacnia moc ruchów typu Bug.</language>
	</row>
	<row id="msg_0221_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Podwaja nagrodę pieniężną\nz walki, jeśli posiadacz bierze w niej udział.</language>
	</row>
	<row id="msg_0221_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Pomaga trzymać dzikie\nPokémony z daleka, jeśli posiadacz jest pierwszy w drużynie.</language>
	</row>
	<row id="msg_0221_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cudowna kula do trzymania przez\nLATIOSA lub LATIAS. Podnosi zarówno\nAtak Specjalny, jak i Obronę Specjalną.</language>
	</row>
	<row id="msg_0221_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nCLAMPERLA. Kieł lśniący ostrym\nsrebrem, podnosi Atak Specjalny.</language>
	</row>
	<row id="msg_0221_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nCLAMPERLA. Łuska świecąca delikatnym\nróżem, podnosi Obronę Specjalną.</language>
	</row>
	<row id="msg_0221_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Umożliwia posiadaczowi\nucieczkę od dowolnego dzikiego Pokémona bez pudła.</language>
	</row>
	<row id="msg_0221_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Pokémon trzymający ten\nosobliwy kamień nie może ewoluować.</language>
	</row>
	<row id="msg_0221_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. Posiadacz może przetrwać\npotencjalnie nokautujący atak, zostając z 1 HP.</language>
	</row>
	<row id="msg_0221_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. To jajko pełne szczęścia,\nktóre daje dodatkowe Punkty Doświadczenia w walce.</language>
	</row>
	<row id="msg_0221_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. To soczewka, która zwiększa\nszansę posiadacza na trafienie krytyczne.</language>
	</row>
	<row id="msg_0221_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. To specjalna metalowa\nbłona, która wzmacnia moc ruchów typu Steel.</language>
	</row>
	<row id="msg_0221_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPokémona. HP posiadacza jest stopniowo\nprzywracane podczas walki.</language>
	</row>
	<row id="msg_0221_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gruba i twarda łuska.\nPokémony typu Dragon mogą ją trzymać,\ngdy zostaną złapane.</language>
	</row>
	<row id="msg_0221_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmiot do trzymania przez\nPIKACHU. To zagadkowa kula, która\npodnosi Atak i Atak Specjalny.</language>
	</row>
	<row id="msg_0221_00237" index="237">
