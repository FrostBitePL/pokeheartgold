<?xml version="1.0"?>
<body language="English">
	<row id="msg_0246_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ding-ding! Czas minął!\nKonkurs Łapania Owadów jest zakończony.\r</language>
	</row>
	<row id="msg_0246_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ding-ding! Skończyły ci się Poké\nBalle. Konkurs Łapania Owadów jest zakończony.\r</language>
	</row>
	<row id="msg_0246_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0246_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zostało ci jeszcze {STRVAR_1 51, 0, 0} minut(y).\nChcesz zakończyć teraz?{YESNO 0}</language>
	</row>
	<row id="msg_0246_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziś wtorek.\rTo znaczy, że dziś odbywa się\nKonkurs Łapania Owadów.\rZasady są proste.\rUżywając jednego ze swoich Pokémonów,\nzłap Pokémona typu Bug do oceny.\rChcesz spróbować?{YESNO 0}</language>
	</row>
	<row id="msg_0246_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziś czwartek.\rTo znaczy, że dziś odbywa się\nKonkurs Łapania Owadów.\rZasady są proste.\rUżywając jednego ze swoich Pokémonów,\nzłap Pokémona typu Bug do oceny.\rChcesz spróbować?{YESNO 0}</language>
	</row>
	<row id="msg_0246_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziś sobota.\rTo znaczy, że dziś odbywa się\nKonkurs Łapania Owadów.\rZasady są proste.\rUżywając jednego ze swoich Pokémonów,\nzłap Pokémona typu Bug do oceny.\rChcesz spróbować?{YESNO 0}</language>
	</row>
	<row id="msg_0246_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Konkurs Łapania Owadów odbywa się we\nwtorek, czwartek i sobotę.\rNie tylko zdobędziesz nagrodę za sam\nudział, ale też zatrzymasz ostatniego\fzłapanego owada Pokémon.</language>
	</row>
	<row id="msg_0246_00008" index="8">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXX</language>
	</row>
	<row id="msg_0246_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXX</language>
	</row>
	<row id="msg_0246_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ups...\nMasz więcej niż jednego Pokémona.\rBędziesz musiał/a użyć {STRVAR_1 1, 0, 0},\npierwszego Pokémona w twojej drużynie.\rCzy to ci odpowiada? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00011" index="11">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXX</language>
	</row>
	<row id="msg_0246_00012" index="12">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXX</language>
	</row>
	<row id="msg_0246_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku, zajmiemy się twoimi pozostałymi\nPokémonami, gdy będziesz brał/a udział.\r{STRVAR_1 3, 0, 0} zostawił/a swoje Pokémony u\nPomocnika Konkursu.\r</language>
	</row>
	<row id="msg_0246_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oto Sport Balle na potrzeby\nKonkursu.\r{STRVAR_1 3, 0, 0} otrzymał/a 20 Sport Balli.\r</language>
	</row>
	<row id="msg_0246_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Osoba, która zdobędzie najsilniejszego\nowada Pokémon, wygrywa.\rMasz 20 minut.\rJeśli skończą ci się Sport Balle,\njesteś skończony/a.\rMożesz zatrzymać ostatniego złapanego\nPokémona jako swojego.\rWyjdź i złap najsilniejszego Pokémona\ntypu Bug, jakiego znajdziesz!\r</language>
	</row>
	<row id="msg_0246_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej!\rPrzykro mi, ale nie masz już miejsca,\nby złapać więcej Pokémonów.</language>
	</row>
	<row id="msg_0246_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. Mamy nadzieję, że weźmiesz udział\nw przyszłości.</language>
	</row>
	<row id="msg_0246_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzisiejszy Konkurs Łapania Owadów jest\nzakończony.\rMamy nadzieję, że weźmiesz udział ponownie\nw przyszłości.</language>
	</row>
	<row id="msg_0246_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niektóre Pokémony można zobaczyć\ntylko w Parku.</language>
	</row>
	<row id="msg_0246_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}?\rOto nagroda, którą dla ciebie\nprzechowywaliśmy.\r</language>
	</row>
	<row id="msg_0246_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ups...\nTwoja Torba jest pełna, {STRVAR_1 3, 0, 0}.\rZatrzymamy twoją nagrodę u siebie.\nZrób miejsce, a potem przyjdź się do mnie zgłosić.</language>
	</row>
	<row id="msg_0246_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nadzieję, że weźmiesz udział w\nKonkursie Łapania Owadów w przyszłości!</language>
	</row>
	<row id="msg_0246_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zostało ci jeszcze {STRVAR_1 51, 0, 0} minut(y).\nChcesz zakończyć teraz? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00024" index="24">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXX</language>
	</row>
	<row id="msg_0246_00025" index="25">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXX</language>
	</row>
	<row id="msg_0246_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. Wyjdź na zewnątrz i\nzakończ.\r</language>
	</row>
	<row id="msg_0246_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. Poczekaj w National Park na\nogłoszenie zwycięzców.\r</language>
	</row>
	<row id="msg_0246_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zmień kolejność swoich Pokémonów,\na potem przyjdź się do mnie zgłosić.</language>
	</row>
	<row id="msg_0246_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz ocenimy Pokémony, które\nzłapałeś/aś.\r......\n......\rWybraliśmy zwycięzców!\nJesteś gotowy/a na to?\r</language>
	</row>
	<row id="msg_0246_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzecie miejsce zajmuje {STRVAR_1 3, 0, 0},\nktóry/a złapał/a wijącego się\n{STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzecie miejsce zajmuje {STRVAR_1 14, 2, 0}\n{STRVAR_1 3, 0, 0}, który/a złapał/a wijącego\fsię {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wynik to {STRVAR_1 52, 3, 0} punktów!\r</language>
	</row>
	<row id="msg_0246_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drugie miejsce zajmuje {STRVAR_1 3, 0, 0},\nktóry/a złapał/a wijącego się\n{STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drugie miejsce zajmuje {STRVAR_1 14, 2, 0}\n{STRVAR_1 3, 0, 0}, który/a złapał/a\fwijącego się {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwycięzcą Konkursu Łapania Owadów\njest...\r{STRVAR_1 3, 0, 0}, który/a złapał/a\nogromnego {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwycięzcą Konkursu Łapania Owadów\njest...\r{STRVAR_1 14, 2, 0} {STRVAR_1 3, 0, 0}, który/a\nzłapał/a ogromnego {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0246_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, zwycięzca Pierwszego\nMiejsca, wygrywa {STRVAR_1 8, 3, 0}!\r</language>
	</row>
	<row id="msg_0246_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, zwycięzca Drugiego\nMiejsca, wygrywa {STRVAR_1 8, 3, 0}!\r</language>
	</row>
	<row id="msg_0246_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, zwycięzca Trzeciego\nMiejsca, wygrywa {STRVAR_1 8, 3, 0}!\r</language>
	</row>
	<row id="msg_0246_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszyscy pozostali otrzymują\n{STRVAR_1 8, 3, 0} jako nagrodę pocieszenia!\r</language>
	</row>
	<row id="msg_0246_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ups...\nTwoja Torba jest pełna, {STRVAR_1 3, 0, 0}.\rZatrzymamy twoją nagrodę u siebie.\nZrób miejsce, a potem przyjdź się do mnie zgłosić.\r</language>
	</row>
	<row id="msg_0246_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nadzieję, że weźmiesz udział w\nKonkursie Łapania Owadów w przyszłości!\r</language>
	</row>
	<row id="msg_0246_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadać przezwisko\n{STRVAR_1 0, 1, 0}, którego/ą złapałeś/aś? {YESNO 0}</language>
	</row>
	<row id="msg_0246_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}?\rOto nagroda, którą dla ciebie\nprzechowywaliśmy.\r</language>
	</row>
	<row id="msg_0246_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ups...\nTwoja Torba jest pełna, {STRVAR_1 3, 0, 0}.\rZatrzymamy twoją nagrodę u siebie.\nZrób miejsce, a potem przyjdź się do mnie zgłosić.\r</language>
	</row>
	<row id="msg_0246_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja drużyna jest pełna, więc\n{STRVAR_1 1, 5, 0} trafił/a do twojego\rPudełka w PC Billa.\r</language>
	</row>
	<row id="msg_0246_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwrócimy ci Pokémony, które\nprzechowywaliśmy. Proszę bardzo!\r</language>
	</row>
	<row id="msg_0246_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don: Zrozumiałeś/aś? Ja wygram!\nNie przeszkadzaj mi.</language>
	</row>
	<row id="msg_0246_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don: Szczęście odgrywa tu dużą rolę.\rNigdy nie wiadomo, czy Pokémony\nsię pojawią.</language>
	</row>
	<row id="msg_0246_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Don: Wygrałeś/aś? To ty jesteś\nzwycięzcą/zwyciężczynią!?\rTak ci zazdroszczę... To byłoby wspaniałe\nbyć zwycięzcą...</language>
	</row>
	<row id="msg_0246_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ed: Mój PARASECT usypia Pokémony\nza pomocą Spore.</language>
	</row>
	<row id="msg_0246_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ed: Nie wygrasz z Pokémonami,\nktóre są wyczerpane lub mają mało HP.</language>
	</row>
	<row id="msg_0246_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ed: Zazdroszczę ci. Tym razem po\nprostu mi nie wyszło.</language>
	</row>
	<row id="msg_0246_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Abby: Trenowałam Pokémony, które\nzadają problemy statusowe, z myślą\fo tym konkursie.</language>
	</row>
	<row id="msg_0246_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Abby: Słyszałam, że używanie Pokémonów\no pięknych kolorach ułatwia wygraną.\fCiekawe, czy to prawda?</language>
	</row>
	<row id="msg_0246_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Abby: Wspaniale! Aż lśnisz i błyszczysz\nteraz. Naprawdę!</language>
	</row>
	<row id="msg_0246_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">William: Wygrana? Bardziej interesuje\nmnie znajdowanie rzadkich Pokémonów.</language>
	</row>
	<row id="msg_0246_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">William: Cóż, jestem zadowolony,\nbo złapałem Pokémona, jakiego chciałem.</language>
	</row>
	<row id="msg_0246_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">William: To ty jesteś zwycięzcą/\nzwyciężczynią? Co złapałeś/aś? Pokaż mi, pokaż!</language>
	</row>
	<row id="msg_0246_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Benny: ...... ...... ......\n...... ...... Ciiicho!\rPrzestraszysz SCYTHERA.\nPogadamy później.</language>
	</row>
	<row id="msg_0246_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Benny: Słuchaj, kiedyś złapałem\nSCYTHERA, ale nie wygrałem.</language>
	</row>
	<row id="msg_0246_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Benny: Po prostu przyszedłem zobaczyć,\njak dziś idzie, wiesz?\rNastępnym razem naprawdę się postaram!</language>
	</row>
	<row id="msg_0246_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Barry: Powinieneś/aś najpierw osłabić\nowada Pokémona, a potem rzucić Poké Ballem.</language>
	</row>
	<row id="msg_0246_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Barry: Łatwiej wygrać, jeśli zdobędziesz\nowada Pokémona wysokiego poziomu. Ale\fmyślę, że biorą też pod uwagę inne rzeczy.</language>
	</row>
	<row id="msg_0246_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Barry: Ten Pokémon, którego złapałeś/aś...\nJest niesamowity!</language>
	</row>
	<row id="msg_0246_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cindy: Naprawdę kocham owady Pokémony!</language>
	</row>
	<row id="msg_0246_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cindy: Naprawdę kocham owady Pokémony!\rCzy już to mówiłam?</language>
	</row>
	<row id="msg_0246_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cindy: Gratulacje z okazji wygranej!\nSwoją drogą...\rCzy wspominałam, że naprawdę kocham\nowady Pokémony?</language>
	</row>
	<row id="msg_0246_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Josh: Kolekcjonuję owady Pokémony\nodkąd byłem małym dzieckiem.\rNie ma mowy, żebym przegrał!</language>
	</row>
	<row id="msg_0246_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Josh: Słyszałem, że ktoś wygrał\nz CATERPIE!</language>
	</row>
	<row id="msg_0246_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Josh: To się nazywa Konkurs Łapania\nOwadów, a nie Konkurs Łapania Ptaków!\rTy ze wszystkich osób powinieneś/aś to\nwiedzieć. W końcu wygrałeś/aś!</language>
	</row>
	<row id="msg_0246_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samuel: Co?\nJeśli masz czas na pogaduszki, idź\fposzukać jakichś owadów Pokémonów.</language>
	</row>
	<row id="msg_0246_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samuel: Więc... Myślałem, że\nzdobędę wyższy wynik...</language>
	</row>
	<row id="msg_0246_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samuel: To takie rozczarowujące...\nNie zapomnę tej porażki i...</language>
	</row>
	<row id="msg_0246_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kipp: Dużo studiowałem owady Pokémony.\nNa pewno wygram.</language>
	</row>
	<row id="msg_0246_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kipp: Dużo studiuję, ale to nie\nwystarcza, by wygrać.</language>
	</row>
	<row id="msg_0246_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kipp: Mógłbyś/Mogłabyś dać mi kilka\nwskazówek? Chcę wygrać!</language>
	</row>
	<row id="msg_0246_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{TRNAME}Don</language>
	</row>
	<row id="msg_0246_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{TRNAME}Ed</language>
	</row>
	<row id="msg_0246_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{TRNAME}Abby</language>
	</row>
	<row id="msg_0246_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{TRNAME}William</language>
	</row>
	<row id="msg_0246_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{TRNAME}Benny</language>
	</row>
	<row id="msg_0246_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{TRNAME}Barry</language>
	</row>
	<row id="msg_0246_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{TRNAME}Cindy</language>
	</row>
