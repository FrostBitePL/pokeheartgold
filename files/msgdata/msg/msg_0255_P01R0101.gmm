<?xml version="1.0"?>
<body language="English">
	<row id="msg_0255_P01R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj na pokładzie Fast Ship S.S.\nAqua.\r...Poza tym, że zespół konserwacji\nsilnika bierze sobie wolne i nie\fwiemy, kiedy będziemy mogli wypłynąć...</language>
	</row>
	<row id="msg_0255_P01R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj na pokładzie Fast Ship S.S.\nAqua. Czy mogę zobaczyć twój S.S.\fTicket?\r</language>
	</row>
	<row id="msg_0255_P01R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} spróbował(a) pokazać\nS.S. Ticket...\r...Ale nie ma tu żadnego biletu!\r</language>
	</row>
	<row id="msg_0255_P01R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam...\rJeszcze jedna osoba bez biletu\nprawdopodobnie nie zrobiłaby wielkiej\fróżnicy, myślę.\rAle zasady to zasady.\nWybacz, młody(a).</language>
	</row>
	<row id="msg_0255_P01R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} pokazał(a) S.S. Ticket.\r</language>
	</row>
	<row id="msg_0255_P01R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, masz bilet!\rZaraz wypływamy.\nWchodź szybko na pokład!\r</language>
	</row>
	<row id="msg_0255_P01R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co?\nJuż pokazałeś/aś mi bilet.</language>
	</row>
	<row id="msg_0255_P01R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj na pokładzie S.S. Aqua!\rTwój bilet jest...właśnie tam.\nProszę, przejdź dalej.\r</language>
	</row>
	<row id="msg_0255_P01R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prowadzenie statku każdego dnia\npotrafi wykończyć!\fDzisiaj nie pływa.\rWypływa do Vermilion City\nw poniedziałki i piątki!</language>
	</row>
	<row id="msg_0255_P01R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Oak: Witaj!\nZaczynasz mieć postawę Mistrza,\f{STRVAR_1 3, 0, 0}!\rCzas, żeby twój Pokédex odpowiadał\ntemu, kim jesteś.\fPokaż mi swój Pokédex na chwilę.\rUlepszę twój Pokédex Trybem\nNarodowym.\r</language>
	</row>
	<row id="msg_0255_P01R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Oak: Witaj!\nZaczynasz mieć...\fpostawę Mistrza, {STRVAR_1 3, 0, 0}!\rCzas, żeby twój Pokédex odpowiadał\ntemu, kim jesteś.\fPokaż mi swój Pokédex na chwilę.\rUlepszę twój Pokédex Trybem\nNarodowym.\r</language>
	</row>
	<row id="msg_0255_P01R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokédex {STRVAR_1 3, 0, 0} został\nulepszony Trybem Narodowym!</language>
	</row>
	<row id="msg_0255_P01R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Oak: Nie będzie łatwo\nukończyć Narodowego Pokédexu...\rJednak jestem pewien, że podejmiesz\nszczerą próbę w naszym imieniu!\r</language>
	</row>
	<row id="msg_0255_P01R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej, jak czas leci!\rMuszę nagrać program radiowy\nw Goldenrod Radio Tower.\rTy pewnie zmierzasz do Kanto.\rJeśli będziesz w pobliżu Pallet Town,\nwpadnij koniecznie do mojego\fLaboratorium Badań nad Pokémonami!\r</language>
	</row>
	<row id="msg_0255_P01R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">S.S. Aqua porusza się za pomocą\ndysz odrzutowych. Ślizga się\fpo wodzie!</language>
	</row>
	<row id="msg_0255_P01R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłeś/aś już w Kanto?\rSłyszałem, że mieszka tam wiele\nrzadkich Pokémonów.\rBrzmi ekscytująco.\nBardzo chciałbym/-abym tam pojechać!</language>
	</row>
</body>
