<?xml version="1.0"?>
<body language="English">
	<row id="msg_0256_P01R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze!\nMusisz być ostatnim pasażerem.\r</language>
	</row>
	<row id="msg_0256_P01R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hę?\nNie wygląda na to, żeby statek\fmiał wkrótce ruszyć.</language>
	</row>
	<row id="msg_0256_P01R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli uda mi się bezpiecznie wrócić\nz tej podróży i postawić pierwsze\fkroki w Olivine City, zamieszkasz\ftam ze mną?\rProszę! Błagam cię!</language>
	</row>
	<row id="msg_0256_P01R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To tylko marynarz z rejsu\nwycieczkowego.\fMa zwyczaj przesadzać.\r</language>
	</row>
	<row id="msg_0256_P01R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sabrina: Nagle...\nMam ochotę zobaczyć ocean...\rMoże byłoby zabawnie wymienić się\nz tobą numerami...\rChcesz mój? {YESNO 0}</language>
	</row>
	<row id="msg_0256_P01R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zarejestrował(a)\nSabrinę w Pokégearze!</language>
	</row>
	<row id="msg_0256_P01R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sabrina: Myślę, że zdołam dotrzymać\nobietnicy, jeśli zadzwonisz do mnie\fw niedziele około południa.</language>
	</row>
	<row id="msg_0256_P01R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sabrina: Rozumiem...\nMyślałam, że byłbyś(-abyś) dobrym\fprzyjacielem.</language>
	</row>
	<row id="msg_0256_P01R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sabrina: Teraz chcesz poznać\nmój numer?\fWidzę to w twoich oczach... {YESNO 0}</language>
	</row>
	<row id="msg_0256_P01R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sabrina: To ty...\rMoże zdjęcie tutaj, na tle\nprzyjemnej morskiej bryzy? {YESNO 0}</language>
	</row>
	<row id="msg_0256_P01R0102_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sabrina: Jesteś gotowy/a?\r</language>
	</row>
	<row id="msg_0256_P01R0102_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sabrina: Myślę, że wygląda dobrze.</language>
	</row>
	<row id="msg_0256_P01R0102_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sabrina: Rozumiem...\nMyślałam, że będziesz dobrym\fmodelem do zdjęcia...</language>
	</row>
	<row id="msg_0256_P01R0102_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Album ze Zdjęciami jest pełny.\rUzyskaj dostęp do swojego PC\ni usuń jakieś zdjęcia.</language>
	</row>
</body>
