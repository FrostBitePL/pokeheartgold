<?xml version="1.0"?>
<body language="English">
	<row id="msg_0257_P01R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj na pokładzie S.S. Aqua!\rTwój bilet jest...właśnie tam.\nProszę, przejdź dalej.\r</language>
	</row>
	<row id="msg_0257_P01R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prowadzenie statku każdego dnia\npotrafi wykończyć! Dzisiaj nie pływa.\rWypływa do Olivine City w środy\ni niedziele!</language>
	</row>
	<row id="msg_0257_P01R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj na pokładzie S.S. Aqua!\rTwój bilet jest...właśnie tam.\nProszę, przejdź dalej.</language>
	</row>
	<row id="msg_0257_P01R0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przybyłeś/aś z Johto?\rZazdroszczę ci!\nSłyszałem, że mieszka tam wiele\frzadkich Pokémonów.</language>
	</row>
</body>
