<?xml version="1.0"?>
<body language="English">
	<row id="msg_0259_P01R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship S.S. Aqua jest w drodze\ndo Vermilion City.\rPoinformujemy was, gdy dopłyniemy.</language>
	</row>
	<row id="msg_0259_P01R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship S.S. Aqua\njest w drodze do Olivine City.\rPoinformujemy was, gdy dopłyniemy.</language>
	</row>
	<row id="msg_0259_P01R0301_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship S.S. Aqua\ndotarł do Vermilion City.\r</language>
	</row>
	<row id="msg_0259_P01R0301_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship S.S. Aqua\ndotarł do Vermilion City.</language>
	</row>
	<row id="msg_0259_P01R0301_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hę?\nJuż dotarł do Vermilion City.\r</language>
	</row>
	<row id="msg_0259_P01R0301_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship S.S. Aqua\ndotarł do Olivine City.\r</language>
	</row>
	<row id="msg_0259_P01R0301_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship S.S. Aqua\ndotarł do Olivine City.</language>
	</row>
	<row id="msg_0259_P01R0301_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej! Przepraszam. Bardzo się\nśpieszyłem!\rMoja wnuczka zaginęła!\rTo jeszcze mała dziewczynka. Jeśli\nją zobaczysz, proszę, daj mi znać!\r</language>
	</row>
	<row id="msg_0259_P01R0301_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oto twoja kabina.\rJeśli twoje Pokémony są ranne,\nzdrzemnij się w łóżku.\fTo je uleczy.</language>
	</row>
	<row id="msg_0259_P01R0301_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oto twoja kabina.\rMożesz uleczyć swoje Pokémony,\nzdrzemniąc się w łóżku.\rStatek dopłynie do celu, podczas\ngdy będziesz spać.</language>
	</row>
	<row id="msg_0259_P01R0301_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Większość pasażerów to Trenerzy.\rWszyscy nie mogą się doczekać walki\nw swoich kabinach.</language>
	</row>
</body>
