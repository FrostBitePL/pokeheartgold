<?xml version="1.0"?>
<body language="English">
	<row id="msg_0260_P01R0302_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kapitanie, pobawisz się ze mną,\nproszę?\rNudzi mi się! Chcę się jeszcze\nbawić!\r</language>
	</row>
	<row id="msg_0260_P01R0302_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, pobawisz się ze mną?\rZagrajmy w chowanego!\nJa się schowam, więc zamknij oczy!\r</language>
	</row>
	<row id="msg_0260_P01R0302_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, pobawisz się ze mną?\rZagrajmy w chowanego!\nJa się schowam, więc zamknij oczy!\r</language>
	</row>
	<row id="msg_0260_P01R0302_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, pobawisz się ze mną?\rZagrajmy w chowanego!\nJa się schowam, więc zamknij oczy!\r</language>
	</row>
	<row id="msg_0260_P01R0302_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta mała dziewczynka ciągle prosi\nmnie, żebym się z nią bawił.\rAu! Proszę, nie ciągnij mnie za ucho!</language>
	</row>
	<row id="msg_0260_P01R0302_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję, że się z nią pobawiłeś/aś.\rMoże myślisz, że bycie Kapitanem\njest dość łatwą pracą, ale w\frzeczywistości jest to całkiem\fwymagające.\rTa mała pasażerka wyszła\nz pokoju.\rNie może zejść ze statku, więc\nmusi się gdzieś tutaj ukrywać.</language>
	</row>
	<row id="msg_0260_P01R0302_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak podoba ci się rejs S.S. Aqua?\rPraktycznie ślizga się po falach.</language>
	</row>
	<row id="msg_0260_P01R0302_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawno się nie widzieliśmy.\nJak się masz?\rS.S. Aqua płynie tak gładko,\njak to tylko możliwe!\rNawiasem mówiąc, znalazłem tę\ntajemniczą rzecz, gdy pojechałem\fdo Sinnoh niedawno.\rSkoro znów się spotkaliśmy,\nchciałbym, żebyś to miał/a.\r</language>
	</row>
	<row id="msg_0260_P01R0302_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja Torba jest pełna.\rMusisz bardzo lubić {STRVAR_1 8, 1, 0}.</language>
	</row>
</body>
