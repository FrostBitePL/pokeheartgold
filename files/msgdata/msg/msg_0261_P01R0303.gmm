<?xml version="1.0"?>
<body language="English">
	<row id="msg_0261_P01R0303_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygodne łóżko!\nCzas na sen...\r</language>
	</row>
	<row id="msg_0261_P01R0303_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, wypoczęty/a i odświeżony/a!\r</language>
	</row>
	<row id="msg_0261_P01R0303_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship S.S. Aqua\ndotarł do Olivine City.</language>
	</row>
	<row id="msg_0261_P01R0303_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship S.S. Aqua\ndotarł do Vermilion City.</language>
	</row>
	<row id="msg_0261_P01R0303_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzz... Zzz...\rC-co?\nOczywiście, że nie śpię...\rZzz... Zzz...</language>
	</row>
	<row id="msg_0261_P01R0303_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? Mówisz, że spałem?\nMiej trochę szacunku!\rMarynarz na służbie nigdy nie\nbyłby tak nieodpowiedzialny, żeby\fzdrzemnąć się w takim miejscu!\rOburza mnie ta sugestia!\nWyzywam cię!\r</language>
	</row>
	<row id="msg_0261_P01R0303_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrana z tobą mnie otrzeźwiła.\nPoprawię się i będę ciężko pracował.\rMożesz zachować w tajemnicy, że\ntutaj drzemałem?\fProszę, nie mów Kapitanowi.\r</language>
	</row>
</body>
