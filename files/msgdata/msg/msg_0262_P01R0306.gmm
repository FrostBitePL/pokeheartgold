<?xml version="1.0"?>
<body language="English">
	<row id="msg_0262_P01R0306_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem.\rWięc bawisz się w chowanego\nz moją wnuczką.\rChyba nie ma się czym martwić,\ndopóki jest na statku!</language>
	</row>
	<row id="msg_0262_P01R0306_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, witaj...\rMoja wnuczka wciąż zaginęła.\nSkoro jest na statku, to w porządku.\rTo energiczne dziecko, więc może\nkomuś przeszkadzać. To mnie martwi...</language>
	</row>
	<row id="msg_0262_P01R0306_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziadku, tu jestem!\rBawiłam się w chowanego\nz tym facetem!\r</language>
	</row>
	<row id="msg_0262_P01R0306_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziadku, tu jestem!\rBawiłam się w chowanego\nz tą dziewczyną!\r</language>
	</row>
	<row id="msg_0262_P01R0306_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, prawda?\nSłyszałem, że zabawiałeś/aś moją\fwnuczkę.\rChcę ci za to podziękować.\nWeź to.\r</language>
	</row>
	<row id="msg_0262_P01R0306_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, prawda?\nSłyszałem, że zabawiałeś/aś moją\fwnuczkę.\rChcę ci za to podziękować.\nWeź to.\r</language>
	</row>
	<row id="msg_0262_P01R0306_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship S.S. Aqua\ndotarł do Vermilion City.</language>
	</row>
	<row id="msg_0262_P01R0306_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podróżujemy dookoła świata.</language>
	</row>
	<row id="msg_0262_P01R0306_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świetnie się bawiłam!</language>
	</row>
</body>
