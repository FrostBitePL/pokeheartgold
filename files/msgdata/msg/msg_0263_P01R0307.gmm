<?xml version="1.0"?>
<body language="English">
	<row id="msg_0263_P01R0307_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, dzieciaku. Mógłbyś poszukać\nmojego kumpla?\rGdzieś się obija, ten nicpoń!\rChciałbym go poszukać, ale jestem\nna warcie i muszę zostać tutaj.\r</language>
	</row>
	<row id="msg_0263_P01R0307_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, dzieciaku. Mógłbyś poszukać\nmojego kumpla?\rGdzieś się obija, ten nicpoń!\fChciałbym go poszukać, ale jestem\fna warcie i muszę zostać tutaj.</language>
	</row>
	<row id="msg_0263_P01R0307_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki, dzieciaku!\nOstro na niego nakrzyczałem, żeby\fprzestał się obijać!</language>
	</row>
	<row id="msg_0263_P01R0307_00003" index="3">
