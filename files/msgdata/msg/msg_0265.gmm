<?xml version="1.0"?>
<body language="English">
	<row id="msg_0265_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hę?\n{STRVAR_1 1, 0, 0} coś trzyma...\rChcesz to wziąć?{YESNO 0}</language>
	</row>
	<row id="msg_0265_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} wygląda na zadowolonego z\nznalezienia czegoś!</language>
	</row>
	<row id="msg_0265_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och!\nWygląda na to, że jest zbyt ważne, by je puścić!</language>
	</row>
	<row id="msg_0265_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} radośnie to oddał/a!</language>
	</row>
	<row id="msg_0265_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">..................\nHę?\r{STRVAR_1 1, 0, 0} trzyma jakiś dziwny,\nBłyszczący Liść...</language>
	</row>
	<row id="msg_0265_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwraca się w tę stronę i kiwa głową.</language>
	</row>
	<row id="msg_0265_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z {STRVAR_1 1, 0, 0} dobiega\ndziwny dźwięk...</language>
	</row>
	<row id="msg_0265_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} pomrukuje w sposób,\nktóry brzmi niemal jak mowa...</language>
	</row>
	<row id="msg_0265_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hę? Wygląda na to, że usłyszał/a\nryk w oddali!</language>
	</row>
