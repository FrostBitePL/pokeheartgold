	<row id="msg_0273_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierz swój cel.</language>
	</row>
	<row id="msg_0273_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Polecieć do {STRVAR_1 4, 0, 0}?</language>
	</row>
	<row id="msg_0273_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zamknij</language>
	</row>
	<row id="msg_0273_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leć</language>
	</row>
	<row id="msg_0273_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyjdź</language>
	</row>
	<row id="msg_0273_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0273_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cicha wieś na miejscu dawnego grodu.\nNiebo jest tu wyjątkowo ciemne.</language>
	</row>
	<row id="msg_0273_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś, w której dawni wrogowie\nusiedli kiedyś przy jednym stole.</language>
	</row>
	<row id="msg_0273_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś pod lasem. W starym łomie\nleżą skamieliny sprzed epok.</language>
	</row>
	<row id="msg_0273_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś nad Bystrzycą, pamiętająca\nwielką bitwę sprzed wieków.</language>
	</row>
	<row id="msg_0273_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ciche miasteczko pamięci. W murze\ncmentarza tkwi osiem starych krzyży.</language>
	</row>
	<row id="msg_0273_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przystań pod zamkiem Grodno,\nnad jeziorem zamkniętym zaporą.</language>
	</row>
	<row id="msg_0273_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasto zegarów. Mówią, że nikt\nsię tu nigdy nie spóźnia.</language>
	</row>
	<row id="msg_0273_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mała wieś wśród buków, na skraju\nKsiążańskiego Parku.</language>
	</row>
	<row id="msg_0273_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyspa czarnej ziemi.\nOd zawsze nic tu nie rośnie.</language>
	</row>
	<row id="msg_0273_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Los wielu Trenerów dążących do\nszczytu rozstrzyga się właśnie tutaj.</language>
	</row>
	<row id="msg_0273_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stolica dawnego księstwa. Miasto\nwież, kupców i astronomów.</language>
	</row>
	<row id="msg_0273_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś z kamiennym kościołem i wieżą\ncystersów. Tu zaczyna się droga.</language>
	</row>
	<row id="msg_0273_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś nad Strzegomką, ze starym\nparkiem i ruiną pałacu.</language>
	</row>
	<row id="msg_0273_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasto mostów. Tu stanął pierwszy\nżelazny most na kontynencie.</language>
	</row>
	<row id="msg_0273_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś kowala i wypalaczy węgla,\nna skraju lasu Wostówka.</language>
	</row>
	<row id="msg_0273_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasteczko za zalewem. Jego zamek\nod wieków strzeże brodu.</language>
	</row>
	<row id="msg_0273_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasto pieców i fabryk. Wszystko\ntutaj przeszło kiedyś przez ogień.</language>
	</row>
	<row id="msg_0273_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś nad zalewem. Jej młyn miele\nmąkę od ponad pięciuset lat.</language>
	</row>
	<row id="msg_0273_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś pałacu i starych dębów,\nz samotną wieżą bez kościoła.</language>
	</row>
	<row id="msg_0273_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś przy stacji kolejowej,\nnazwana od dawnego kasztelana.</language>
	</row>
	<row id="msg_0273_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zalane wyrobisko dawnej kopalni.\nWoda ma tu mleczny kolor.</language>
	</row>
	<row id="msg_0273_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieś na wzgórzu, z najstarszym\nkościołem i bardzo głęboką studnią.</language>
	</row>
	<row id="msg_0273_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Święta góra dawnych plemion,\nwidoczna z obu regionów.</language>
	</row>
	<row id="msg_0273_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tunel wykopany przez DIGLETTY,\nłączący Zagórze Śląskie z\fMokrzeszowem.</language>
	</row>
	<row id="msg_0273_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Opuszczona kopalnia rudy. W bocznych\nchodnikach wciąż coś błyszczy.</language>
	</row>
	<row id="msg_0273_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sztolnie dawnych poszukiwaczy złota.\nNikt nie wie, jak są głębokie.</language>
	</row>
	<row id="msg_0273_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mroczny tunel, który zaczyna się\nw Pszennie i wychodzi w Burkatowie.</language>
	</row>
	<row id="msg_0273_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To dawna lokalizacja Strefy Safari,\nktóra teraz jest Pal Parkiem.</language>
	</row>
	<row id="msg_0273_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jaskinia, w której lód nie topnieje\nnawet w środku lata.</language>
	</row>
	<row id="msg_0273_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnia baszta zamku wodnego.\nStrzeże jej Bractwo Mostu.</language>
	</row>
	<row id="msg_0273_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieża, która została po zburzonym\nkościele. Podobno ktoś z niej\fpatrzy.</language>
	</row>
	<row id="msg_0273_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aleja trzystuletnich dębów.\nLiście szumią tu nawet bez wiatru.</language>
	</row>
	<row id="msg_0273_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pałac, który spłonął, gdy służył\nza lazaret. Nikt go nie odbudował.</language>
	</row>
	<row id="msg_0273_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Park przy pałacu, z drzewami\nz całego świata. Obok jest Arena.</language>
	</row>
	<row id="msg_0273_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pałac dawnego fabrykanta. Dziś\nsiedziba fundacji i radia.</language>
	</row>
	<row id="msg_0273_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miejsce, gdzie z ziemi wydobywa się\nkości i skamieliny sprzed epok.</language>
	</row>
	<row id="msg_0273_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stary kamieniołom, w którym zbiera\nsię woda. Skała kryje minerały.</language>
	</row>
	<row id="msg_0273_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy SLOWPOKE są spragnione,\nprzychodzą się tu napić.</language>
	</row>
	<row id="msg_0273_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świeci nad zalewem dzięki mocy\nPokémona, który ją zasila.</language>
	</row>
	<row id="msg_0273_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle Stadium z pięcioma różnymi\nzestawami zasad do wypróbowania.</language>
	</row>
	<row id="msg_0273_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miejsce, gdzie ludzie z całego świata\nprzybywają, by pochwalić się siłą.</language>
	</row>
	<row id="msg_0273_00051" index="51">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0273_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wielki las pełen drzew\nużywanych do produkcji węgla drzewnego.</language>
	</row>
	<row id="msg_0273_00053" index="53">
		<attribute name="window_context_name">garbage</attribute>
