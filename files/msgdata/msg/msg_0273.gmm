	<row id="msg_0273_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To dawna lokalizacja Strefy Safari,\nktóra teraz jest Pal Parkiem.</language>
	</row>
	<row id="msg_0273_00038" index="38">
		<attribute name="window_context_name">used</attribute>
