	<row id="msg_0273_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dość nowe i ciche miasteczko.\nTo małe i urokliwe miejsce.</language>
	</row>
	<row id="msg_0273_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piękne miasto spowite zielenią\nprzez cały rok.</language>
	</row>
	<row id="msg_0273_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ciche miasto zagnieżdżone wśród\nsurowych gór i skał.</language>
	</row>
	<row id="msg_0273_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piękne miasto z płynącą wodą\ni kwitnącymi kwiatami.</language>
	</row>
	<row id="msg_0273_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Małe miasteczko spowite pięknym\nodcieniem fioletu.</language>
	</row>
	<row id="msg_0273_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Południowe miasto skąpane\nw pomarańczy zachodzącego słońca.</language>
	</row>
	<row id="msg_0273_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bogate, mieniące się tęczą miasto,\ngdzie gromadzą się ludzie i Pokémony.</language>
	</row>
	<row id="msg_0273_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Historyczna wioska, która\nstała się nowa na nowo.</language>
	</row>
	<row id="msg_0273_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasteczko istniało tutaj, dopóki\nnie zmiotła go erupcja.</language>
	</row>
	<row id="msg_0273_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Los wielu Trenerów dążących do\nszczytu rozstrzyga się właśnie tutaj.</language>
	</row>
	<row id="msg_0273_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Największe miasto w Kanto, lśniące\nzłotym blaskiem.</language>
	</row>
	<row id="msg_0273_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasteczko, gdzie wiatr wieje\ni zwiastuje nadchodzącą zmianę.</language>
	</row>
	<row id="msg_0273_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasto, gdzie poczujesz zapach\nmałych kwiatów i morskiej bryzy.</language>
	</row>
	<row id="msg_0273_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta stara wioska wciąż otoczona jest\ndrzewami i innymi malowniczymi widokami.</language>
	</row>
	<row id="msg_0273_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasteczko, gdzie ludzie i Pokémony\nżyją razem w prostej harmonii.</language>
	</row>
	<row id="msg_0273_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadmorskie miasto, które wiele\nzawdzięcza morzu.</language>
	</row>
	<row id="msg_0273_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozwijające się miasto, gdzie ludzie\ni Pokémony przychodzą i odchodzą wedle woli.</language>
	</row>
	<row id="msg_0273_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasto, w którym możesz usłyszeć\nmelodię morza.</language>
	</row>
	<row id="msg_0273_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasto, które do dziś nosi\nślady swojej historii.</language>
	</row>
	<row id="msg_0273_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miasteczko o podejrzanej atmosferze.\nTo kryjówka ninja.</language>
	</row>
	<row id="msg_0273_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ogromne jezioro pełne czystej,\nbłękitnej wody.</language>
	</row>
	<row id="msg_0273_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tajemnicza górska wioska wykuta\nw ścianie skalnej.</language>
	</row>
	<row id="msg_0273_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Góra, gdzie coś tajemniczego\nczeka pod ziemią.</language>
	</row>
	<row id="msg_0273_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tunel wykopany przez DIGLETTY,\nłączący Vermilion City z Pewter City.</language>
	</row>
	<row id="msg_0273_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Góra, na którą spadła gwiazda.\nTeraz kryje w sobie tajemniczą moc.</language>
