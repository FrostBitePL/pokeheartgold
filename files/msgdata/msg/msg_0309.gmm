	<row id="msg_0309_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Miejsce: Beach Dome</language>
	</row>
	<row id="msg_0309_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Miejsce: Jump Dome</language>
	</row>
	<row id="msg_0309_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Miejsce: Clay Dome</language>
	</row>
	<row id="msg_0309_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Miejsce: Fight Dome</language>
	</row>
	<row id="msg_0309_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Miejsce: Snow Dome</language>
	</row>
	<row id="msg_0309_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Miejsce: Field Dome</language>
	</row>
	<row id="msg_0309_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Zasady Konkurencji</language>
	</row>
	<row id="msg_0309_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celuj w Gola i skacz! Biegnij!</language>
	</row>
	<row id="msg_0309_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biegnij, zbieraj Chorągiewki i wracaj!</language>
	</row>
	<row id="msg_0309_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wejdź do Kręgu!</language>
	</row>
	<row id="msg_0309_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozbij jak najwięcej Bloków!</language>
	</row>
	<row id="msg_0309_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Łap latające Dyski!</language>
	</row>
	<row id="msg_0309_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skacz i celuj w zapalone Lampy!</language>
	</row>
	<row id="msg_0309_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biegnij w Sztafecie z Pokémonami! Biegnij!</language>
	</row>
	<row id="msg_0309_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wypchnij rywali z Ringu!</language>
	</row>
	<row id="msg_0309_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trafiaj jak najwięcej Pokémonów!</language>
	</row>
	<row id="msg_0309_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umieść piłkę w Golu przeciwnika!</language>
	</row>
	<row id="msg_0309_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Sterowanie</language>
	</row>
	<row id="msg_0309_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotknij Pokémona, by skoczył!\nSteruj trzema Pokémonami jednocześnie.\nPrzeskakuj przez Płotki!</language>
	</row>
	<row id="msg_0309_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Hurdle Dash ścigasz się z czasem do\nmety. Przeskakuj przez Płotki i bądź\npierwszy na mecie. Punkty przyznawane\nsą na podstawie tego, ile sekund\nzajęło wszystkim trzem Pokémonom\ndotarcie do mety.\n\nSzybkość: Prędkość Biegu\nSkok: Długość Skoku</language>
	</row>
	<row id="msg_0309_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotknij Pokémona, by skoczył!\nSkacz, by pokonać Płotki!\n\nSteruj trzema Pokémonami jednocześnie\ni skończ przed\nwszystkimi innymi!</language>
	</row>
	<row id="msg_0309_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przesuń rysik po\nPokémonie, by go poruszyć! Uderz\ninnych od tyłu, by zabrać Chorągiewki!</language>
	</row>
	<row id="msg_0309_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Pennant Capture twoje trzy Pokémony\nbiegają na zmianę, przynosząc\nChorągiewki. Można trzymać naraz do\ndziewięciu Chorągiewek. Uderz swoich\nprzeciwników od tyłu, by ukraść im\nChorągiewki.\n\nUmiejętność: Łatwość Poruszania\nSzybkość: Prędkość Biegu</language>
	</row>
	<row id="msg_0309_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybko przesuń rysik po swoim\nPokémonie, by go poruszyć!\nIm dalej przesuniesz, tym więcej się\nporusza!\n\nBądź szybszy od wszystkich innych,\nby zebrać jak najwięcej Chorągiewek\ni je przynieść!</language>
	</row>
	<row id="msg_0309_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użyj rysika, by poruszać swoim\nPokémonem! Steruj\ntrzema Pokémonami naraz!</language>
	</row>
	<row id="msg_0309_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Circle Push to konkurencja, w której\npopychasz przeciwnika. Jeśli jesteś\nwewnątrz Kręgu po odliczeniu czasu,\notrzymujesz punkty. Liczba zapisana\nw Kręgu to liczba punktów, które\notrzymasz.\n\nSiła: Siła Pchania\nWytrzymałość: Zdolność do Ciągłego Pchania</language>
	</row>
	<row id="msg_0309_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użyj rysika, by poruszać swoim\nPokémonem!\n\nSteruj trzema Pokémonami naraz i\nceluj w Krąg z\nnajwięcej punktami!</language>
	</row>
	<row id="msg_0309_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotknij Bloki, by uderzyć!\nDotknij przycisk Przełącz, by\nprzełączyć na kolejnego Pokémona!</language>
	</row>
	<row id="msg_0309_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Block Smash to po prostu konkurencja,\nw której rozbijasz Bloki. Zmieniaj\nswojego Pokémona, gdy się zmęczy.\nOtrzymujesz punkty według liczby\nrozbitych Bloków.\n\nSiła: Siła Niszczenia\nWytrzymałość: Zdolność do Dalszej Walki</language>
	</row>
	<row id="msg_0309_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotknij Bloki, by je rozbić!\nJest cała lawina Bloków. Rozbij ich\njak najwięcej!\n\nDotknij przycisk Przełącz, by\nprzełączyć na kolejnego Pokémona!</language>
	</row>
	<row id="msg_0309_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1) Użyj rysika, by poruszać\ntrzema Pokémonami.\n2) Dotknij, by skoczyć i złapać!</language>
	</row>
	<row id="msg_0309_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Disc Catch to konkurencja, w której\nsterujesz trzema Pokémonami naraz\ni skaczesz, by łapać Dyski lecące od\nstrony morza. Im dalej na scenie\nzłapiesz Dyski, tym więcej punktów\notrzymujesz.\n\nSkok: Wysokość Skoku\nSiła: Siła Pchania</language>
	</row>
	<row id="msg_0309_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1) Użyj rysika, by poruszać swoim\nPokémonem. Steruj trzema Pokémonami\nnaraz. Odpychaj przeciwników z drogi,\nby łapać Dyski!\n\n2) Dotknij lekko swojego Pokémona,\nby skoczył! Złap jak najwięcej\nDysków!</language>
	</row>
	<row id="msg_0309_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybko pociągnij Pokémona\nw dół, by skoczył!</language>
	</row>
	<row id="msg_0309_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Lamp Jump sterujesz trzema swoimi\nPokémonami, gdy próbują skakać i\ndotykać zapalających się Lamp. Spróbuj\ndotknąć jak najwięcej Lamp w jednym\nskoku.\n\nSkok: Wysokość Skoku\nUmiejętność: Zdolność do Skoku w Bok</language>
	</row>
	<row id="msg_0309_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybko pociągnij trzy Pokémony w dół\ni patrz, jak skaczą!\n\nPociągnij je po skosie, by skakały\nna bok!</language>
	</row>
	<row id="msg_0309_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybko machnij, by ruszyć!\nMachaj jak najszybciej, by przyspieszyć!\nZmień, gdy się zmęczysz!</language>
	</row>
	<row id="msg_0309_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Relay Run to konkurencja, w której\nprzełączasz się między Pokémonami,\npróbując przebiec jak najdalej.\nZmieniaj Pokémona, gdy się zmęczy.\nPunkty przyznawane są tylko na\npodstawie przebytego dystansu.\n\nWytrzymałość: Wytrwałość\nSzybkość: Prędkość Biegu</language>
	</row>
	<row id="msg_0309_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybko machnij rysikiem w prawo,\nby twój Pokémon ruszył biegiem!\n\nIm bardziej machniesz w prawo, tym\nszybciej pobiegnie twój Pokémon!\n\nDotknij przycisk Przełącz, by\nprzełączyć na kolejnego Pokémona!</language>
	</row>
	<row id="msg_0309_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1) Użyj rysika, by się poruszać.\n2) Szybko machnij, by uderzyć!\n3) Lekko dotknij, by skoczyć!</language>
	</row>
	<row id="msg_0309_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ring Drop to konkurencja, w której\npopychasz przeciwnika. Otrzymujesz\npunkty za każdym razem, gdy wypchniesz\nprzeciwnika z Ringu. Jeśli naciśniesz\nprzycisk Przełącz w swoim rogu, możesz\nzmienić Pokémona.\n\nWytrzymałość: Zdolność Opierania się Pchaniu\nSiła: Siła Uderzenia</language>
	</row>
	<row id="msg_0309_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1) Użyj rysika, by poruszać swoim\nPokémonem!\n\n2) Szybko machnij rysikiem, by\nuderzyć! Odrzuć przeciwnika!\n\n3) Lekko dotknij swojego\nPokémona, by skoczył!\nTwój Pokémon może przydeptać innych!</language>
	</row>
	<row id="msg_0309_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1) Szybko machnij w górę na swoim\nPokémonie, by rzucić Śniegiem!\n2) Dotknij, by nagromadzić więcej Śniegu!</language>
	</row>
	<row id="msg_0309_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Snow Throw sterujesz trzema swoimi\nPokémonami naraz i trafiasz przeciwników\nŚnieżkami. Otrzymasz punkty bez\nwzględu na to, kogo trafisz w drużynie\nprzeciwnika.\n\nUmiejętność: Celność Rzutu\nSiła: Siła Śnieżki</language>
	</row>
	<row id="msg_0309_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1) Machnij w górę na swoim Pokémonie,\nby rzucić Śnieżką!\n\n2) Gdy trzymasz Śnieżkę, dotknij\nPokémona, by powiększyć Śnieżkę!\n\nWiększe Śnieżki mogą sprawić, że\nprzeciwnik zemdleje od uderzenia!</language>
	</row>
	<row id="msg_0309_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1) Steruj trzema Pokémonami! Użyj\nrysika, by się poruszać!\n2) Machnij szybko, by ruszyć biegiem!</language>
	</row>
	<row id="msg_0309_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Goal Roll starasz się wtoczyć piłkę\ndo Gola przeciwnika. Nie ma znaczenia,\nktóry z ich Goli--zdobędziesz punkty.\nAle jeśli piłka wyląduje w twoim\nwłasnym Golu, stracisz punkty.\n\nUmiejętność: Długość Toczenia\nSiła: Siła Toczenia</language>
	</row>
	<row id="msg_0309_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1) Steruj trzema Pokémonami naraz.\nUżyj rysika, by poruszać swoim\nPokémonem!\n\n2) Machnij szybko rysikiem, by\nruszyć biegiem! Jeśli biegniesz, możesz\nstrzelić w kierunku Gola!</language>
	</row>
	<row id="msg_0309_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Konkurencja {STRVAR_1 50, 0, 0}</language>
	</row>
	<row id="msg_0309_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Szczegóły</language>
	</row>
	<row id="msg_0309_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Zasady</language>
	</row>
	<row id="msg_0309_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Więcej</language>
	</row>
	<row id="msg_0309_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}Wstecz</language>
	</row>
	<row id="msg_0309_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}O Zasadach</language>
	</row>
	<row id="msg_0309_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}O Sterowaniu</language>
	</row>
	<row id="msg_0309_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze! Wyniki pierwszej konkurencji!?\r</language>
	</row>
	<row id="msg_0309_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co za emocje! Jak poszła druga\nkonkurencja?!\r</language>
	</row>
	<row id="msg_0309_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Koniec! Jak poszła trzecia konkurencja?!\r</language>
	</row>
	<row id="msg_0309_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze! Wyniki pierwszej konkurencji!?\r</language>
	</row>
	<row id="msg_0309_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co za emocje! Jak poszła druga\nkonkurencja?!\r</language>
	</row>
	<row id="msg_0309_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jeszcze nie koniec! Trzecia\nkonkurencja!?\r</language>
	</row>
	<row id="msg_0309_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Koniec! Jak poszła czwarta konkurencja?!\r</language>
	</row>
	<row id="msg_0309_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{SIZE 200}Drużyna {STRVAR_1 3, 0, 0}!{SIZE 100}\rGratulacje za Pierwsze Miejsce!\r</language>
	</row>
	<row id="msg_0309_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To...\nbyła bardzo wyrównana rywalizacja!\r</language>
	</row>
	<row id="msg_0309_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyniki tej konkurencji zostaną\nustalone na podstawie punktów!\r</language>
	</row>
	<row id="msg_0309_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celuj w zdobycie najwięcej punktów\nrównież w następnej konkurencji!\r</language>
	</row>
	<row id="msg_0309_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To dopiero początek!\nPrzygotujcie się na następną konkurencję!\r</language>
	</row>
	<row id="msg_0309_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jaką rywalizację zobaczymy w\nkolejnej konkurencji?!\r</language>
	</row>
	<row id="msg_0309_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy wciąż próbują ocenić potencjał\ninnych? Nie mogę się doczekać kolejnej!\r</language>
	</row>
	<row id="msg_0309_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwsza konkurencja zakończona!\nOd teraz robi się poważnie!\r</language>
	</row>
	<row id="msg_0309_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagle, ostatnia konkurencja! Czy tym\nrazem szale się przechylą?!\r</language>
	</row>
	<row id="msg_0309_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Następna jest ostatnia konkurencja!\nDaj z siebie wszystko!\r</language>
	</row>
	<row id="msg_0309_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagle jesteśmy przy ostatniej\nkonkurencji! Zwycięstwo może być\nw zasięgu każdego!\r</language>
	</row>
	<row id="msg_0309_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystko sprowadza się do ostatniej\nkonkurencji! Dajcie z siebie wszystko!\r</language>
	</row>
	<row id="msg_0309_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cały stadion jest podekscytowany! To\njest ostatnia konkurencja!\r</language>
	</row>
	<row id="msg_0309_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze!\nOgłoszę końcowe wyniki!\r</language>
	</row>
	<row id="msg_0309_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy będzie tak, jak się spodziewamy?!\nOgłoszę końcowe wyniki!\r</language>
	</row>
	<row id="msg_0309_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszyscy dali z siebie wszystko!\nOgłoszę końcowe wyniki!\r</language>
	</row>
	<row id="msg_0309_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Która drużyna jest numerem jeden?!\nOgłoszę końcowe wyniki!\r</language>
	</row>
	<row id="msg_0309_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Która drużyna zdobędzie mistrzostwo?!\nOgłoszę końcowe wyniki!\r</language>
	</row>
	<row id="msg_0309_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celuj w najwyższą sumę punktów w\nnastępnej konkurencji!\r</language>
	</row>
	<row id="msg_0309_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To dopiero początek!\nPrzygotujcie się na następną konkurencję!\r</language>
	</row>
	<row id="msg_0309_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jaką rywalizację zobaczymy w\nkolejnej konkurencji?!\r</language>
	</row>
	<row id="msg_0309_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy wciąż próbują ocenić potencjał\ninnych? Nie mogę się doczekać kolejnej!\r</language>
	</row>
	<row id="msg_0309_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwsza konkurencja zakończona!\nOd teraz robi się poważnie!\r</language>
	</row>
	<row id="msg_0309_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To dopiero druga konkurencja!\nJaki dramat nas czeka?\r</language>
	</row>
	<row id="msg_0309_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz jeszcze siłę?\nZa chwilę zaczyna się trzecia konkurencja!\r</language>
	</row>
	<row id="msg_0309_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeszcze nie widzieliśmy rywalizacji!\nNastępna jest trzecia konkurencja!\r</language>
	</row>
	<row id="msg_0309_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drużyna na ostatnim miejscu wciąż ma\nszansę! To jest trzecia konkurencja!\r</language>
	</row>
	<row id="msg_0309_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stadion pełen jest napięcia! Nadchodzi\ntrzecia konkurencja!\r</language>
	</row>
	<row id="msg_0309_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagle, ostatnia konkurencja! Czy tym\nrazem szale się przechylą?!\r</language>
	</row>
	<row id="msg_0309_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Następna jest ostatnia konkurencja!\nDaj z siebie wszystko!\r</language>
	</row>
	<row id="msg_0309_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagle jesteśmy przy ostatniej\nkonkurencji! Zwycięstwo może być\nw czyichkolwiek rękach!\r</language>
	</row>
	<row id="msg_0309_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystko sprowadza się do ostatniej\nkonkurencji! Dajcie z siebie wszystko!\r</language>
	</row>
	<row id="msg_0309_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cały stadion jest podekscytowany! To\njest ostatnia konkurencja!\r</language>
	</row>
	<row id="msg_0309_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze!\nOgłoszę końcowe wyniki!\r</language>
	</row>
	<row id="msg_0309_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy będzie tak, jak się spodziewamy?!\nOgłoszę końcowe wyniki!\r</language>
	</row>
	<row id="msg_0309_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszyscy dali z siebie wszystko!\nOgłoszę końcowe wyniki!\r</language>
	</row>
	<row id="msg_0309_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Która drużyna jest numerem jeden?!\nOgłoszę końcowe wyniki!\r</language>
	</row>
	<row id="msg_0309_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Która drużyna zdobędzie mistrzostwo?\nOgłoszę końcowe wyniki!\r</language>
	</row>
