<?xml version="1.0"?>
<body language="English">
	<row id="msg_0309_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witamy na Pokéathlonie!\rDzisiejsza konkurencja--\n{STRVAR_4 1, 0, 0}!\rKto dziś zabłyśnie najjaśniej?\nPoznajmy zawodników!\r</language>
	</row>
	<row id="msg_0309_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drużyna {STRVAR_1 3, 0, 0}: {STRVAR_1 1, 1, 0},\n{STRVAR_1 1, 2, 0} i {STRVAR_1 1, 3, 0}!\r</language>
	</row>
	<row id="msg_0309_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, jesteśmy gotowi!\nCelujmy w szczyt! Zaczynamy\r{ALN_CENTER}{SIZE 200}POKéATHLON!\r</language>
	</row>
	<row id="msg_0309_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świetna robota, atleci!\rKtóra drużyna walczyła najzacieklej?\nMamy wyniki!\rAle najpierw...\nkto tryska duchem walki?\r</language>
	</row>
	<row id="msg_0309_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonus za Wyzwanie\ndla Pokémona i Drużyny!\r</language>
	</row>
	<row id="msg_0309_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 52, 1, 0} punktów dla Drużyny {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0309_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kontynuujemy, nagrody indywidualne...\r</language>
	</row>
	<row id="msg_0309_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonus za Bezbłędność!\r</language>
	</row>
	<row id="msg_0309_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 1, 0} z Drużyny {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0309_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tym razem nikt go nie zdobył.\r</language>
	</row>
	<row id="msg_0309_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wszystko!\r</language>
	</row>
	<row id="msg_0309_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przechodzimy dalej...\nlider punktacji!\r</language>
	</row>
	<row id="msg_0309_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 1, 0} z Drużyny {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0309_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wszystko!\r</language>
	</row>
	<row id="msg_0309_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Następna...\nnagroda za wysiłek!\r</language>
	</row>
	<row id="msg_0309_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który skakał najwięcej...\r</language>
	</row>
	<row id="msg_0309_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który trafiał najwięcej...\r</language>
	</row>
	<row id="msg_0309_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który zawodził najwięcej...\r</language>
	</row>
	<row id="msg_0309_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który biegał najwięcej...\r</language>
	</row>
	<row id="msg_0309_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który przegapił najwięcej\npunktów...\r</language>
	</row>
	<row id="msg_0309_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 1, 0} z Drużyny {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0309_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wszystko!\r</language>
	</row>
	<row id="msg_0309_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na koniec...\nzsumujemy punkty z konkurencji!\r</language>
	</row>
	<row id="msg_0309_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Konkurencja {STRVAR_1 50, 0, 0}!</language>
	</row>
	<row id="msg_0309_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? Mamy remis!?\nCóż, remisy rozstrzygamy losowaniem!\rNie, nie, hmm...\n...\r...\nMam to!\r</language>
	</row>
	<row id="msg_0309_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ogólny zwycięzca, z {STRVAR_1 52, 0, 0} punktami...\r</language>
	</row>
	<row id="msg_0309_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}{SIZE 200}Drużyna {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0309_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drużyna {STRVAR_1 3, 0, 0} otrzymała\n{STRVAR_4 3, 1, 0}!\r</language>
	</row>
	<row id="msg_0309_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drużyna {STRVAR_1 3, 0, 0} otrzymała\n{STRVAR_4 3, 1, 0} i {STRVAR_4 3, 2, 0}!\r</language>
	</row>
	<row id="msg_0309_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drużyna {STRVAR_1 3, 0, 0} pobiła swój\nosobisty rekord w {STRVAR_4 1, 1, 0}!\r</language>
	</row>
	<row id="msg_0309_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze ci poszło w\n{STRVAR_4 1, 0, 0}!\r</language>
	</row>
	<row id="msg_0309_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje!\nTo był wspaniały Występ!\rWciąż celuj w miano najlepszego\nPokéatlety!\rBo to jest...\nPokéathlon\r{ALN_CENTER}{SIZE 200}NA ZAWSZE!\r</language>
	</row>
	<row id="msg_0309_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dołączył {STRVAR_1 55, 1, 0} razy!\nNowe nazwisko wśród Pokéatletów!\r</language>
	</row>
	<row id="msg_0309_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dołączył {STRVAR_1 55, 1, 0} razy!\nSpadająca gwiazda Pokéatletów!\r</language>
	</row>
	<row id="msg_0309_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dołączył {STRVAR_1 55, 1, 0} razy!\nSupernowa Pokéatletów!\r</language>
	</row>
	<row id="msg_0309_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dołączył {STRVAR_1 55, 1, 0} razy!\nWybuch wielkości galaktyki!\r</language>
	</row>
	<row id="msg_0309_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celuj w mistrzostwo!\nNa spadającej gwieździe Pokéathlonu!\r</language>
	</row>
	<row id="msg_0309_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ogólne zwycięstwo, {STRVAR_1 55, 1, 0} razy!\nPokéathlon należy do ciebie!\r</language>
	</row>
	<row id="msg_0309_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ogólne zwycięstwo, {STRVAR_1 55, 1, 0} razy!\nJutro zawładnij Pokéathlonem!\r</language>
	</row>
	<row id="msg_0309_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ogólne zwycięstwo, {STRVAR_1 55, 1, 0} razy!\nPokéathlon jest mój!\r</language>
	</row>
	<row id="msg_0309_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli dasz z siebie wszystko i nie\nzawiedziesz...na pewno ci się poprawi!\r</language>
	</row>
	<row id="msg_0309_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnie Miejsce, {STRVAR_1 55, 1, 0} razy!\nW porządku. Będę próbował dalej!\r</language>
	</row>
	<row id="msg_0309_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnie Miejsce, {STRVAR_1 55, 1, 0} razy!\nTo w ogóle nie ma znaczenia!\r</language>
	</row>
	<row id="msg_0309_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnie Miejsce, {STRVAR_1 55, 1, 0} razy!\nNikt jeszcze nie widział mojego grzbietu!\r</language>
	</row>
	<row id="msg_0309_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celuj w numer jeden!\nZaczyna się dziś!\r</language>
	</row>
	<row id="msg_0309_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwsze Miejsce, {STRVAR_1 55, 1, 0} razy!\nW porządku! Pójdziesz ze mną?\r</language>
	</row>
	<row id="msg_0309_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwsze Miejsce, {STRVAR_1 55, 1, 0} razy!\nCzy naprawdę wciąż liczyłeś tym razem?\r</language>
	</row>
	<row id="msg_0309_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwsze Miejsce, {STRVAR_1 55, 1, 0} razy!\nNie mów mi, że znowu pierwsze miejsce?!\r</language>
	</row>
	<row id="msg_0309_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie martw się porażką!\nUpadek to nie koniec!\r</language>
	</row>
	<row id="msg_0309_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnie Miejsce, {STRVAR_1 55, 1, 0} razy!\nUpadnij siedem razy. Wstań osiem!\r</language>
	</row>
	<row id="msg_0309_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnie Miejsce, {STRVAR_1 55, 1, 0} razy!\nTo moja cecha rozpoznawcza!\r</language>
	</row>
	<row id="msg_0309_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnie Miejsce, {STRVAR_1 55, 1, 0} razy!\nZ tego rekordu jestem słynny!\r</language>
	</row>
	<row id="msg_0309_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrywanie prawdziwą siłą?\nCzy po prostu wygrywanie szczęściem?!\r</language>
	</row>
	<row id="msg_0309_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonusy z ceremonii zamknięcia.\nSzczęście {STRVAR_1 55, 1, 0} razy?!\r</language>
	</row>
	<row id="msg_0309_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonusy z ceremonii zamknięcia.\n{STRVAR_1 55, 1, 0} razy. To prawdziwa siła!\r</language>
	</row>
	<row id="msg_0309_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonusy z ceremonii zamknięcia.\n{STRVAR_1 55, 1, 0} razy. Szczęście i siła!\r</language>
	</row>
	<row id="msg_0309_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze wydaję Pokémonom polecenia!\nWyj po stosy mistrzostw!\r</language>
	</row>
	<row id="msg_0309_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy ta praca zespołowa wystarczy, by\nzmienić historię?\r</language>
	</row>
	<row id="msg_0309_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spójrzcie na to! Ta praca zespołowa!\nNiesamowite! Czuć tę przyjaźń!\r</language>
	</row>
	<row id="msg_0309_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się. Potrafimy czytać\nsobie nawzajem w myślach!\r</language>
	</row>
	<row id="msg_0309_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To się nie kończy, gdy upadniesz! Dopóki\njest mistrzostwo do zdobycia!\r</language>
	</row>
	<row id="msg_0309_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poniósł porażkę {STRVAR_1 55, 1, 0} razy! Wzrosła\ntylko liczba twoich omdleń!\r</language>
	</row>
	<row id="msg_0309_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poniósł porażkę {STRVAR_1 55, 1, 0} razy!\nPorażka to tylko skrót do sukcesu!\r</language>
	</row>
	<row id="msg_0309_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poniósł porażkę {STRVAR_1 55, 1, 0} razy!\nPorażka to źródło sukcesu!\r</language>
	</row>
	<row id="msg_0309_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze celuj wysoko w niebo!\nCeluj we wszystko, co jest na niebie!\r</language>
	</row>
	<row id="msg_0309_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leć wysoko!\nMożesz lecieć wszędzie!\r</language>
	</row>
	<row id="msg_0309_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest jutro, które tylko ty możesz\nzobaczyć. Skacz po nie!\r</language>
	</row>
	<row id="msg_0309_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Druga strona nieba to lśniące jutro!\nUrodziłeś się, by je złapać!\r</language>
	</row>
	<row id="msg_0309_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Te punkty i tamte punkty--idziemy po\nnie!\r</language>
	</row>
	<row id="msg_0309_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden punkt nie jest bezużyteczny!\nTo skrót do sukcesu!\r</language>
	</row>
	<row id="msg_0309_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie pomijaj jednego punktu! Zawsze\npatrz o krok naprzód!\r</language>
	</row>
	<row id="msg_0309_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku! Król Punktów Pokéathlonu!\nWszystkie punkty są moje!\r</language>
	</row>
	<row id="msg_0309_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz to! I to! Zmierzę się z\nwszystkim, co stanie mi na drodze!\r</language>
	</row>
	<row id="msg_0309_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No dobrze, dobrze! Demon uderzeń!\nLiczba razy: {STRVAR_1 55, 1, 0}!\r</language>
	</row>
	<row id="msg_0309_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uderzaj po zwycięstwo!\n{STRVAR_1 55, 1, 0} razy, ni mniej ni więcej!\r</language>
	</row>
	<row id="msg_0309_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nic nie stanie mi na drodze!\nTrafiono {STRVAR_1 55, 1, 0} razy!\r</language>
	</row>
	<row id="msg_0309_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu upadłeś tak daleko?! Jest tam\ndziura czy coś?\r</language>
	</row>
	<row id="msg_0309_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spaść z takiej wysokości!\nTo emocjonujące uczucie mnie porwało!\r</language>
	</row>
	<row id="msg_0309_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokéatleta, który walczy nawet na\nkrawędzi ringu! Naprawdę poważnie!\r</language>
	</row>
	<row id="msg_0309_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To zawsze ostatnia szansa!\nDlatego zawsze jestem poważny!\r</language>
	</row>
	<row id="msg_0309_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co za zdolności biegowe! Pędź po\ncałym Pokéathlonie!\r</language>
	</row>
	<row id="msg_0309_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biegnij! Zdobądź zwycięstwo!\nDawaj! Zdobądź jutro!\r</language>
	</row>
	<row id="msg_0309_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślisz, że nadążysz?\nSzybko...szybciej...najszybciej!\r</language>
	</row>
	<row id="msg_0309_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biegnę szybko jak błyskawica!\nCzy twoje oczy za mną nadążą?!\r</language>
	</row>
	<row id="msg_0309_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Siła to nie wszystko! Strategia to\nkolejny ważny czynnik sukcesu!\r</language>
	</row>
	<row id="msg_0309_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystko sprowadza się do rozumu!\nMożesz manipulować światem!\r</language>
	</row>
	<row id="msg_0309_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze bądź przygotowany! Ta\nstrategia może zostać obalona!\r</language>
	</row>
	<row id="msg_0309_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli wiesz wszystko o Pokémonach,\nmożesz uzyskać najlepszy Występ!\r</language>
	</row>
	<row id="msg_0309_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jesteś sam!\nWszyscy tu z tobą rywalizują!\r</language>
	</row>
	<row id="msg_0309_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze rywalizujesz z każdym!\nTo jest prawdziwa siła!\r</language>
	</row>
	<row id="msg_0309_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Staniesz się silniejszy przez walkę z\ninnymi, więc wykorzystaj ich siłę!\r</language>
	</row>
	<row id="msg_0309_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W tobie jest wielu przyjaciół i\nwiele Pokémonów!\r</language>
	</row>
	<row id="msg_0309_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy walczysz z prawdziwym wojownikiem,\nzwycięstwo jest na wyciągnięcie ręki!\r</language>
	</row>
	<row id="msg_0309_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na zewnątrz jest wielu silnych\nPokémonów! Przybyli, by rywalizować!\r</language>
	</row>
	<row id="msg_0309_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie możesz z nimi przegrać! Wygrałeś\njuż zbyt wiele razy!\r</language>
	</row>
	<row id="msg_0309_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celuj w bycie silniejszym Pokéatletą!\nWtedy wygrasz więcej!\r</language>
	</row>
	<row id="msg_0309_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje wszystkie porażki dowodzą twojej\nsiły! Pokazują, że stanąłeś do walki!\r</language>
	</row>
	<row id="msg_0309_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest tam wielu silnych ludzi.\nWiesz to lepiej niż ktokolwiek!\r</language>
	</row>
	<row id="msg_0309_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze rywalizuj z kimś!\nI dziel się tą rywalizacją!\r</language>
	</row>
	<row id="msg_0309_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie martwię się wygraną czy przegraną,\ntylko tym, by mierzyć się z najlepszymi!\r</language>
	</row>
	<row id="msg_0309_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zostawcie mi Hurdle Dash! Jestem\nPokéatletą, który kocha Hurdle Dash\nnajbardziej ze wszystkiego!\r</language>
	</row>
	<row id="msg_0309_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma przeszkody, której nie przeskoczę!\nPatrzcie na moją piękną technikę!\r</language>
	</row>
	<row id="msg_0309_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę wspiąć się na każdą przeszkodę,\nmogę przeskoczyć każdy płotek!\r</language>
	</row>
	<row id="msg_0309_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Płotki to nie przeszkody! Możesz po\nprostu je obiec!\r</language>
	</row>
	<row id="msg_0309_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urodziłem się, by zgarniać Chorągiewki!\nJestem władcą tej plaży!\r</language>
	</row>
	<row id="msg_0309_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy widzisz Chorągiewki, myślisz o mnie!\nJestem bohaterem od zdobywania Chorągiewek!\r</language>
	</row>
	<row id="msg_0309_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piaszczysta plaża to moje boisko!\nBiegam po niej swobodnie!\r</language>
	</row>
	<row id="msg_0309_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma Chorągiewki, której nie zdobędę!\nZdobędę nawet mistrzostwo!\r</language>
	</row>
	<row id="msg_0309_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pchaj! Pchaj! Pchaj!\nOdepchnij na bok!\r</language>
	</row>
	<row id="msg_0309_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma niczego, czego nie mogę odepchnąć!\nWypchnę cię z Kręgu, byś był sam!\r</language>
	</row>
	<row id="msg_0309_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem w zupełnie nowym wymiarze,\njeśli chodzi o pchanie! Urodziłem się\nby pchać!\r</language>
	</row>
	<row id="msg_0309_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co z tym zastraszaniem, które możesz\nczuć? Potrafię pchać bez dotykania!\r</language>
	</row>
	<row id="msg_0309_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozwal! Roztrzaskaj! Zmiażdż!\nUrodziłem się, by niszczyć Bloki!\r</language>
	</row>
	<row id="msg_0309_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma niczego, czego nie mogę\nzmiażdżyć! Jestem Królem Zniszczenia\nPokéathlonu!\r</language>
	</row>
	<row id="msg_0309_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem pewny, że tam jest ogromny mur!\nJest tam tylko po to, bym go rozwalił!\r</language>
	</row>
	<row id="msg_0309_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wciąż łam Bloki...a zauważysz\ngórę tam w oddali.\r</language>
	</row>
	<row id="msg_0309_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje ciało automatycznie łapie każdy\nDysk, który przelatuje w moją stronę!\r</language>
	</row>
	<row id="msg_0309_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przybyłem, by łapać Dyski i zdobyć\nPokéathlon!\r</language>
	</row>
	<row id="msg_0309_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dysk, który złapałeś, to jutrzejsza\nspadająca gwiazda!\r</language>
	</row>
	<row id="msg_0309_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj. Złapię go! Złapię każdy Dysk,\nktóry poleci w moją stronę!\r</language>
	</row>
	<row id="msg_0309_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skok był jak wiatr!\nForma była jak chmura!\r</language>
	</row>
	<row id="msg_0309_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skacz wysoko w niebo!\nForma jest nieważka!\r</language>
	</row>
	<row id="msg_0309_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokéatleta, który potrafi odczytać\nprzepływ wiatru i kontrolować powietrze.\r</language>
	</row>
	<row id="msg_0309_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We mnie nie ma granicy między ziemią\na niebem!\r</language>
	</row>
	<row id="msg_0309_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nikt mnie nie zatrzyma!\nUrodziłem się, by biegać!\r</language>
	</row>
	<row id="msg_0309_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie widziałem takiej siły!\nCiągłe bieganie cały dzień!\r</language>
	</row>
	<row id="msg_0309_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy raz zacznę się ruszać, nie mogę\nprzestać! Jestem w wiecznym Pokéathlonie!\r</language>
	</row>
	<row id="msg_0309_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moim silnikiem jest przyjaźń, a moim\nmotorem jest zwycięstwo!\r</language>
	</row>
	<row id="msg_0309_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma szans! Powalę całą Pokémonową\nkonkurencję!\r</language>
	</row>
	<row id="msg_0309_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wejście do Ringu to koniec! Walcz, by\nbyć ostatnim Pokémonem stojącym!\r</language>
	</row>
	<row id="msg_0309_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Władca Ringu!\nWchodzisz do cudzego Ringu na własne ryzyko!\r</language>
	</row>
	<row id="msg_0309_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czym właściwie jesteś?\nRing ci to powie!\r</language>
	</row>
	<row id="msg_0309_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rzucanie Śniegiem jest najlepsze na\nświecie! Z taką celnością możesz wygrać!\r</language>
	</row>
	<row id="msg_0309_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śnieżki, które rzucamy, to zwinięte\nkule przyjaźni!\r</language>
	</row>
	<row id="msg_0309_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co za szybkie rzuty! Dla kogo jest ta\nŚnieżka?!\r</language>
	</row>
	<row id="msg_0309_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie wiem, skąd wyskoczy następna!\nŚnieżki jakby się dzieliły!\r</language>
	</row>
	<row id="msg_0309_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nikt nie zatrzyma tej piłki! Trafi w\nkażdy Gol, w który wycelowałem!\r</language>
	</row>
	<row id="msg_0309_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użyj tej wspaniałej pracy zespołowej\ni zdobądź Gola!\r</language>
	</row>
	<row id="msg_0309_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co za wspaniała technika nóg!\nCeluj w sukces!\r</language>
	</row>
	<row id="msg_0309_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyj z piłką.\nŻyj wewnątrz piłki!\r</language>
	</row>
	<row id="msg_0309_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podaruj im punkty w prezencie. To\nucieleśnienie fair play.\r</language>
	</row>
	<row id="msg_0309_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uśmiechaj się nawet gdy chybisz!\nPokéathlon to nie tylko wygrywanie!\r</language>
	</row>
	<row id="msg_0309_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie wahasz się celować we własnego\nGola!\r</language>
	</row>
	<row id="msg_0309_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie kłóć się o to, kto wtoczył piłkę\ndo twojego Gola! To wasza przyjaźń!\r</language>
	</row>
	<row id="msg_0309_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu tak się wyróżniasz? Wygrywanie\nto nie jedyna rzecz w Pokéathlonie.\r</language>
	</row>
	<row id="msg_0309_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oto i ono! To, na co wszyscy czekaliście!\nAutografy po zawodach!\r</language>
	</row>
	<row id="msg_0309_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chcesz zobaczyć, jak wygrywam,\npokażę ci dokładnie, jak to robię!\r</language>
	</row>
	<row id="msg_0309_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy daję z siebie wszystko i wygrywam,\nsprawiam, że wszyscy są szczęśliwi!\r</language>
	</row>
