<?xml version="1.0"?>
<body language="English">
	<row id="msg_0322_R02R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej, moje ty złote bryłki!\nJesteś pierwszym gościem, jakiego\fmiałem od dawna.\rOszalałem z radości!\nSkoro wyglądasz na tak lśniącego/ą\fjak Nugget, pozwól, że dam ci mały\fprezent.\r</language>
	</row>
	<row id="msg_0322_R02R0201_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0322_R02R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Nugget.\rNie mogę dać ci żadnej złotej myśli,\nwięc to musi wystarczyć!</language>
	</row>
</body>
