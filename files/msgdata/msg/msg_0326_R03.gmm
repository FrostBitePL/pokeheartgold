<?xml version="1.0"?>
<body language="English">
	<row id="msg_0326_R03_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przed tobą Mt. Moon.\rMt. Moon Square znajduje się\nna drodze na szczyt!</language>
	</row>
	<row id="msg_0326_R03_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy wcześniej nie widziałem/-am\ntakiego kamienia!\rCzy to może być...\nmeteoryt z kosmosu?</language>
	</row>
	<row id="msg_0326_R03_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotknięcie meteorytu zwiększyło\nSzybkość pewnego Pokémona.</language>
	</row>
	<row id="msg_0326_R03_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotknięcie meteorytu wzmocniło\nzdolności obronne\fpewnego Pokémona.</language>
	</row>
	<row id="msg_0326_R03_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotknięcie meteorytu wzmocniło\nzdolności ofensywne\fpewnego Pokémona.</language>
	</row>
	<row id="msg_0326_R03_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotknięcie meteorytu zrównoważyło\ncechy pewnego Pokémona.</language>
	</row>
</body>
