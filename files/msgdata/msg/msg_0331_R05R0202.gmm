<?xml version="1.0"?>
<body language="English">
	<row id="msg_0331_R05R0202_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie bój się. Nie jestem złym\nczłowiekiem.\rTakie miejsce jak to...\nprzyciąga podłych ludzi.\rW końcu narobiliby kłopotów...\rDlatego Wujek Wściekłość pilnuje\ntakich spraw...\rEcho w Underground Path jest...\nniesamowite...</language>
	</row>
	<row id="msg_0331_R05R0202_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie bój się. Nie jestem złym\nczłowiekiem.\rTakie miejsce jak to...\nprzyciąga podłych ludzi.\rW końcu narobiliby kłopotów...\rWkurza mnie już sama myśl\no tym...\r</language>
	</row>
	<row id="msg_0331_R05R0202_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aha!\nTo RageCandyBar!\rMogę go dostać?\nProszę! {YESNO 0}\n</language>
	</row>
	<row id="msg_0331_R05R0202_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} dał(a) RageCandyBar\nfacetowi w Underground Path.\r</language>
	</row>
	<row id="msg_0331_R05R0202_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chrup!\rTakie to denerwujące!\rAle to takie dobre!\rChrup chrup!\rAargh! Doprowadza mnie do szału!\rChrup chrup!\rAargh...\r..................Uff!\rCzuję się dużo lepiej.\nDziękuję za słodycz!\fChcę, żebyś to miał/a!\r</language>
	</row>
	<row id="msg_0331_R05R0202_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TM64 zawiera......\rtik-\n    tak\ftik-\f    tak\ftik-\f    tak\ftik-\f    tak\ftik...\f..................\f..................\r</language>
	</row>
	<row id="msg_0331_R05R0202_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{SIZE 200}Bum!!</language>
	</row>
	<row id="msg_0331_R05R0202_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Takie miejsce jak to...\nprzyciąga podłych ludzi.\rW końcu narobiliby kłopotów...\rDlatego Wujek Wściekłość pilnuje\ntakich spraw...\rEcho w Underground Path jest...\nniesamowite...</language>
	</row>
	<row id="msg_0331_R05R0202_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zamierzasz zjeść to wszystko\nsam/sama?!</language>
	</row>
	<row id="msg_0331_R05R0202_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aha! Dziękuję!\r...Ale twoja Torba jest pełna...\nZrób trochę miejsca i wróć później...</language>
	</row>
</body>
