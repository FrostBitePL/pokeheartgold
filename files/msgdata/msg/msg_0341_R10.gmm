<?xml version="1.0"?>
<body language="English">
	<row id="msg_0341_R10_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kalina: Och, juhu!\nMasz Pokémona, którego kocham\fnajbardziej: PIKACHU!\rWspaniale!\nDam ci swój numer telefonu! {YESNO 0}</language>
	</row>
	<row id="msg_0341_R10_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zarejestrował(a)\nPorucznika Kalina w Pokégearze!</language>
	</row>
	<row id="msg_0341_R10_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kalina: Zadzwoń do mnie\nw piątek rano!\rMożemy stoczyć elektryzującą walkę!</language>
	</row>
	<row id="msg_0341_R10_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kalina: Och nie!\nJakie to rozczarowujące!</language>
	</row>
	<row id="msg_0341_R10_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kalina: Aha!\nTeraz chcesz poznać mój numer\ftelefonu, prawda? {YESNO 0}</language>
	</row>
	<row id="msg_0341_R10_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kalina: Och! Jakie są szanse, że\nspotkam cię w takim miejscu?\rCzuję moc elektryczną wokół\nElektrowni.\rMoże złap jakiegoś PIKACHU w Lesie\nKsiążańskim i przynieś go tutaj!</language>
	</row>
	<row id="msg_0341_R10_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jakiś wielki Pokémon się na ciebie\ngapi...!\r</language>
	</row>
	<row id="msg_0341_R10_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">RAIKOU: Rorrrrrkoom!\r</language>
	</row>
	<row id="msg_0341_R10_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elektrownia Lubachów</language>
	</row>
	<row id="msg_0341_R10_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rock Tunnel</language>
	</row>
</body>
