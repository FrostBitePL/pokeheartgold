	<row id="msg_0344_R10R0201_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0344_R10R0201_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0344_R10R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kierownik: Mój ukochany generator!\rDalej pompuj prąd, żeby zapewnić\nprzyjemne życie mieszkańcom Kanto!</language>
	</row>
	<row id="msg_0344_R10R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będziemy musieli wzmocnić naszą\nochronę, żeby coś takiego nigdy\fwięcej się nie powtórzyło!</language>
	</row>
	<row id="msg_0344_R10R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Generator działa.\nWytwarza prąd z nadwyżką.</language>
	</row>
	<row id="msg_0344_R10R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Generator znów działa!</language>
	</row>
	<row id="msg_0344_R10R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odkąd generator naprawiono,\nKierownik jest w dobrym humorze.</language>
	</row>
	<row id="msg_0344_R10R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobra! Możemy wreszcie znów\nuruchomić Magnet Train.</language>
	</row>
	<row id="msg_0344_R10R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbieram Pokémony.\nMasz DUGTRIO?\rChcesz wymienić go na mojego\nMAGNETONA? {YESNO 0}</language>
	</row>
	<row id="msg_0344_R10R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Juhu! Mam DUGTRIO!\nDzięki!</language>
	</row>
	<row id="msg_0344_R10R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hę? To nie DUGTRIO.\nCóż za rozczarowanie...</language>
	</row>
	<row id="msg_0344_R10R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcesz się wymienić? Ech...</language>
	</row>
	<row id="msg_0344_R10R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, jak radzi sobie mój dawny\nMAGNETON?</language>
	</row>
	<row id="msg_0344_R10R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Motta Personelu:\r1. Elektryczność nie jest nieskończona.\n2. Oszczędzaj, gdzie tylko się da.\f3. Dbajcie o siebie nawzajem.\f4. Bezczynność jest zabroniona.\f5. Noś buty z gumowymi podeszwami.\f6. Kierownik jest niesamowity.</language>
	</row>
	<row id="msg_0344_R10R0201_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używaj prądu mądrze,\ndla jasnego i przyjemnego życia.\f           Kanto Power Plant</language>
	</row>
</body>
