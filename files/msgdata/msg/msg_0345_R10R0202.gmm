<?xml version="1.0"?>
<body language="English">
	<row id="msg_0345_R10R0202_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złodziej włamał się do Power Plant...\nDo czego zmierza ten świat?</language>
	</row>
	<row id="msg_0345_R10R0202_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Właśnie dostałem wieści z Cerulean.\nWygląda na to, że kręci się tam\fjakiś podejrzany typ.\r</language>
	</row>
	<row id="msg_0345_R10R0202_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy mógłbym prosić o twoją współpracę?\rPodejrzany typ kręcił się w\npobliżu Sali w Cerulean...\r</language>
	</row>
	<row id="msg_0345_R10R0202_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy mógłbym prosić o twoją współpracę?\rPodejrzany typ kręcił się w\npobliżu Sali w Cerulean...</language>
	</row>
	<row id="msg_0345_R10R0202_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ktoś ukradł część niezbędną dla\ngeneratora.\rBez niej nowy generator jest\nbezużyteczny!</language>
	</row>
	<row id="msg_0345_R10R0202_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta Power Plant była kiedyś opuszczona.\rPrzywróciliśmy ją do działania,\nżeby zasilać Magnet Train.</language>
	</row>
	<row id="msg_0345_R10R0202_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kierownik Power Plant jest tam\nz przodu.\rAle odkąd ktoś zniszczył generator,\njest zarówno smutny, jak i chwilami\fwściekły...\rCzasem wybucha śmiechem z\nrozpaczy.\fTyle musieliśmy przez to przejść...</language>
	</row>
	<row id="msg_0345_R10R0202_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Magnet Train zużywa mnóstwo\nprądu.\rNie może jeździć, jeśli nowy\ngenerator nie działa.</language>
	</row>
	<row id="msg_0345_R10R0202_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbieram Pokémony.\nMasz DUGTRIO?\rChcesz wymienić go na mojego\nMAGNETONA? {YESNO 0}</language>
	</row>
	<row id="msg_0345_R10R0202_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Juhu! Mam DUGTRIO!\nDzięki!</language>
	</row>
	<row id="msg_0345_R10R0202_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hę? To nie DUGTRIO.\nCóż za rozczarowanie...</language>
	</row>
	<row id="msg_0345_R10R0202_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcesz się wymienić? Ech...</language>
	</row>
	<row id="msg_0345_R10R0202_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, jak radzi sobie mój dawny\nMAGNETON?</language>
	</row>
	<row id="msg_0345_R10R0202_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kierownik: J-j-jestem gotowy, żeby\ncoś wysadzić!\rKto ośmieliłby się ukraść część\nz generatora?\rSpędziłem tyle czasu, naprawiając\ngo! Jeśli go złapię, zobaczy, co\fpotrafię zrobić moją Wiązką\fŁadującą!</language>
	</row>
	<row id="msg_0345_R10R0202_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kierownik: Ach! Tak!\nTo, co masz...\rCzy to ta część, którą skradziono\nz mojego ukochanego generatora?\rZnalazłeś/aś ją?\nBardzo ci dziękuję!\rTeraz muszę tylko...\npodłączyć tę część tutaj...\r</language>
	</row>
	<row id="msg_0345_R10R0202_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kierownik: Wrrrrrr!\rTak, działa!\nWrrr, wrrr!\r</language>
	</row>
	<row id="msg_0345_R10R0202_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kierownik: Wahah! Dzięki!\rProszę! Weź tę TM jako nagrodę!\r</language>
	</row>
	<row id="msg_0345_R10R0202_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kierownik: TM57 to moja Wiązka\nŁadująca!\rWystrzeliwuje wiązki i czasem\nmoże też zwiększyć Atak Specjalny!</language>
	</row>
	<row id="msg_0345_R10R0202_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Motta Personelu:\r1. Elektryczność nie jest nieskończona.\n2. Oszczędzaj, gdzie tylko się da.\f3. Dbajcie o siebie nawzajem.\f4. Bezczynność jest zabroniona.\f5. Noś buty z gumowymi podeszwami.\f6. Kierownik jest niesamowity.</language>
	</row>
	<row id="msg_0345_R10R0202_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używaj prądu mądrze,\ndla jasnego i przyjemnego życia.\f           Kanto Power Plant</language>
	</row>
</body>
