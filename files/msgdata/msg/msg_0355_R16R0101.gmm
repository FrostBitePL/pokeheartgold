<?xml version="1.0"?>
<body language="English">
	<row id="msg_0355_R16R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli pojedziesz Cycling Road w dół,\ndotrzesz do Fuchsia City.</language>
	</row>
	<row id="msg_0355_R16R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, cześć. Chciałbyś/aby usłyszeć\nmodne powiedzonko? {YESNO 0}</language>
	</row>
	<row id="msg_0355_R16R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A więc dobrze...\rModną rzeczą, którą mógłbyś\npowiedzieć, byłoby...\r{STRVAR_1 28, 0, 0}!\rTo jest coś w rodzaju modnego\npowiedzonka.</language>
	</row>
	<row id="msg_0355_R16R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ale przestań! Z takim nastawieniem\nzostaniesz w tyle za modą!</language>
	</row>
	<row id="msg_0355_R16R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam nadzieję, że będziesz używać\nmodnych powiedzonek w modny sposób.</language>
	</row>
	<row id="msg_0355_R16R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, cześć. Używasz\nmodnych powiedzonek?</language>
	</row>
</body>
