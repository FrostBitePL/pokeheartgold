<?xml version="1.0"?>
<body language="English">
	<row id="msg_0356_R16R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tutaj zaczyna się Cycling Road. Cała\ntrasa jest w dół, więc jest\fabsolutnie ekscytująca.\rNiektórzy wolą wygodne i fajne\nśrodki transportu, takie jak Fast\fShip czy Kolej Magnetyczna. A ty\nwolisz Rower, prawda?</language>
	</row>
	<row id="msg_0356_R16R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty! Stój, gdzie stoisz!\rMusisz jechać na Rowerze, żeby\nwjechać na Cycling Road!\r</language>
	</row>
</body>
