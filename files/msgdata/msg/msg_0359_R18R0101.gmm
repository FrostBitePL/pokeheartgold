<?xml version="1.0"?>
<body language="English">
	<row id="msg_0359_R18R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cycling Road z tej strony cała\njest pod górę. To naprawdę\ftrudne wyzwanie.\rChoć wjazd na górę, mocno naciskając\nna pedały, może być całkiem\fciekawy.</language>
	</row>
	<row id="msg_0359_R18R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, ty!\rCycling Road jest tylko dla\nrowerzystów. Musisz jechać na\fRowerze, żeby ruszyć dalej!\r</language>
	</row>
</body>
