<?xml version="1.0"?>
<body language="English">
	<row id="msg_0363_R25_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Ech! Dlaczego musiałeś/aś\nsię tu zjawić i nam przeszkadzać?\rWiesz, jak nazywa się takich ludzi\njak ty?\rSzkodnikami! Dobrze usłyszałeś/aś,\nszkodnik!\r...\r...Och? Te Odznaki, które masz...\nCzy to Odznaki z Sal w Johto?\rJeśli masz osiem, musisz być dobry/a.\rDobrze, w takim razie. Przyjdź do\nSali w Cerulean.\rZ przyjemnością cię przyjmę.\rJestem Misty, Liderka Sali\nw Cerulean.\r</language>
	</row>
	<row id="msg_0363_R25_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Uwielbiam tutejszy zachód\nsłońca! Daje mi odwagę, żeby iść\fdalej, wiesz?\rNo dobra!\rMoże wymienimy się numerami? {YESNO 0}</language>
	</row>
	<row id="msg_0363_R25_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zarejestrował(a)\nMisty w Pokégearze!</language>
	</row>
	<row id="msg_0363_R25_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Zadzwoń do mnie w środę\nrano, jeśli chcesz kolejnej walki\fze mną!</language>
	</row>
	<row id="msg_0363_R25_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Szkoda!</language>
	</row>
	<row id="msg_0363_R25_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Więc jednak chcesz poznać\nmój numer? {YESNO 0}</language>
	</row>
	<row id="msg_0363_R25_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Ach! Masz świetnego Pokémona\ntypu Wodnego!\fMogę zrobić sobie z nim zdjęcie? {YESNO 0}</language>
	</row>
	<row id="msg_0363_R25_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Tak trzymaj!\rPokaż wielki uśmiech!\r</language>
	</row>
	<row id="msg_0363_R25_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Dobrze wyglądamy!\nNaprawdę lubię Pokémony typu\fWodnego!</language>
	</row>
	<row id="msg_0363_R25_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Cóż za rozczarowanie...</language>
	</row>
	<row id="msg_0363_R25_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Album ze Zdjęciami jest pełny.\rUzyskaj dostęp do swojego PC\ni usuń jakieś zdjęcia.</language>
	</row>
	<row id="msg_0363_R25_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stoczyłeś/aś o jedną walkę więcej,\nniż się spodziewałeś/aś, ale i tak\fwygrałeś/aś.\rZgodnie z obietnicą, wygrywasz\nnagrodę.\r</language>
	</row>
	<row id="msg_0363_R25_00012" index="12">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0363_R25_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ale widząc, jak walczysz, chcę\nzobaczyć, jak sobie ze mną poradzisz.\fCo ty na to? Pozwól, że cię wyzwę.\r</language>
	</row>
	<row id="msg_0363_R25_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie miałem/-am tak\nwspaniałej walki!\rTy i twój Pokémon jesteście\nnaprawdę silni!</language>
	</row>
	<row id="msg_0363_R25_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sea Cottage\nDom Billa</language>
	</row>
	<row id="msg_0363_R25_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: Puf, puf...\nJa...nie dorównuję ci.\f...Tak jak przewidywałem.\r..................\n...Śmiało, idź dalej.\rOdkąd spotkałem cię w Burned\nTower w Ecruteak City, w jakiś\fsposób wiedziałem, że SUICUNE\fwybierze ciebie.\r</language>
	</row>
	<row id="msg_0363_R25_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: Spójrz na nie!\nSUICUNE czeka na ciebie!\fCzekało na walkę z godnym\fTrenerem, któremu mogłoby się\fpowierzyć!</language>
	</row>
	<row id="msg_0363_R25_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: {STRVAR_1 3, 0, 0}...\nWy dwoje jesteście naprawdę\fniesamowici...\rNigdy nie widziałem tak intensywnej\nwalki!\fNie mam żadnych żalów...\rŻegnaj, SUICUNE!\nŻegnaj...{STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0363_R25_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: {STRVAR_1 3, 0, 0}...\nNie ma się czego wstydzić.\rNikt nie może cię za to krytykować,\nże uciekłeś/aś przed SUICUNE.\rTo po prostu takie niesamowite\nPokémon, i tyle.\fW każdym razie, SUICUNE znów\fzniknęło.\fWracamy do punktu wyjścia...\r</language>
	</row>
</body>
