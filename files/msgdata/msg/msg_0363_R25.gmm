<?xml version="1.0"?>
<body language="English">
	<row id="msg_0363_R25_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weronika: Ech! Dlaczego musiałeś/aś\nsię tu zjawić i nam przeszkadzać?\rWiesz, jak nazywa się takich ludzi\njak ty?\rSzkodnikami! Dobrze usłyszałeś/aś,\nszkodnik!\r...\r...Och? Te Odznaki, które masz...\nCzy to Odznaki z Sal w Regionie\fŻarów?\rJeśli masz osiem, musisz być dobry/a.\rDobrze, w takim razie. Przyjdź do\nSali w Burkatowie.\rZ przyjemnością cię przyjmę.\rJestem Weronika, Liderka Sali\nw Burkatowie.\r</language>
	</row>
	<row id="msg_0363_R25_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weronika: Uwielbiam tutejszy zachód\nsłońca! Daje mi odwagę, żeby iść\fdalej, wiesz?\rNo dobra!\rMoże wymienimy się numerami? {YESNO 0}</language>
	</row>
	<row id="msg_0363_R25_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zarejestrował(a)\nMisty w Pokégearze!</language>
	</row>
	<row id="msg_0363_R25_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weronika: Zadzwoń do mnie w środę\nrano, jeśli chcesz kolejnej walki\fze mną!</language>
	</row>
	<row id="msg_0363_R25_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Szkoda!</language>
	</row>
	<row id="msg_0363_R25_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weronika: Więc jednak chcesz poznać\nmój numer? {YESNO 0}</language>
	</row>
	<row id="msg_0363_R25_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weronika: Ach! Masz świetnego\nPokémona typu Wodnego! Mogę zrobić\fsobie z nim zdjęcie? {YESNO 0}</language>
	</row>
	<row id="msg_0363_R25_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weronika: Tak trzymaj!\rPokaż wielki uśmiech!\r</language>
	</row>
	<row id="msg_0363_R25_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weronika: Dobrze wyglądamy!\nNaprawdę lubię Pokémony typu\fWodnego!</language>
	</row>
	<row id="msg_0363_R25_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weronika: Cóż za rozczarowanie...</language>
	</row>
	<row id="msg_0363_R25_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Album ze Zdjęciami jest pełny.\rUzyskaj dostęp do swojego PC\ni usuń jakieś zdjęcia.</language>
	</row>
	<row id="msg_0363_R25_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stoczyłeś/aś o jedną walkę więcej,\nniż się spodziewałeś/aś, ale i tak\fwygrałeś/aś.\rZgodnie z obietnicą, wygrywasz\nnagrodę.\r</language>
	</row>
	<row id="msg_0363_R25_00012" index="12">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0363_R25_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ale widząc, jak walczysz, chcę\nzobaczyć, jak sobie ze mną poradzisz.\fCo ty na to? Pozwól, że cię wyzwę.\r</language>
	</row>
	<row id="msg_0363_R25_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie miałem/-am tak\nwspaniałej walki!\rTy i twój Pokémon jesteście\nnaprawdę silni!</language>
	</row>
	<row id="msg_0363_R25_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sea Cottage\nDom Billa</language>
	</row>
	<row id="msg_0363_R25_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robert: Puf, puf... Ja...nie\ndorównuję ci. ...Tak jak\fprzewidywałem.\r.................. ...Śmiało, idź\ndalej.\rOdkąd spotkałem cię w Burned Tower w\nMrowinach, w jakiś sposób\fwiedziałem, że ARTICUNO wybierze\nciebie.\r</language>
	</row>
	<row id="msg_0363_R25_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robert: Spójrz na nie! ARTICUNO\nczeka na ciebie! Czekał na walkę z\fgodnym Trenerem, któremu mogłoby się\npowierzyć!</language>
	</row>
	<row id="msg_0363_R25_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robert: {STRVAR_1 3, 0, 0}... Wy dwoje\njesteście naprawdę niesamowici...\rNigdy nie widziałem tak intensywnej\nwalki! Nie mam żadnych żalów...\rŻegnaj, ARTICUNO! Żegnaj...{STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0363_R25_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robert: {STRVAR_1 3, 0, 0}... Nie ma się czego\nwstydzić.\rNikt nie może cię za to krytykować,\nże uciekłeś/aś przed ARTICUNO.\rTo po prostu taki niesamowity\nPokémon, i tyle. W każdym razie,\fARTICUNO znów zniknął. Wracamy do\npunktu wyjścia...\r</language>
	</row>
</body>
