<?xml version="1.0"?>
<body language="English">
	<row id="msg_0364_R25R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm? Przyszedłeś/aś do mojego\nwnuka? Nazywa się Bill.\rJest w Johto.\nZajmuje się czymś związanym\fz komputerami PC, więc pilnuję\fdomu.\r</language>
	</row>
	<row id="msg_0364_R25R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, mój wnuk wspomniał o okrągłym,\nniebieskim Pokémonie, któremu na\fgłowie rosną liście.\r</language>
	</row>
	<row id="msg_0364_R25R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bill opowiedział mi o Pokémonie,\nktóry jest bardzo lojalny wobec\fswojego Trenera.\fTo Pokémon typu Ognistego, który\fpodobno dobrze Ryczy.\r</language>
	</row>
	<row id="msg_0364_R25R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znasz tego Pokémona z wielkimi,\nokrągłymi oczami.\rTego, który śpiewa kołysankę\nswoim uroczym głosem!\r</language>
	</row>
	<row id="msg_0364_R25R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znasz tego niesamowicie popularnego\nPokémona?\rTego, który ma żółte ciało\ni jasnoczerwone policzki...\rBardzo chciałabym zobaczyć, jak\nwygląda, zanim ewoluuje.\r</language>
	</row>
	<row id="msg_0364_R25R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszałam, że w Johto jest\nniebieski, okrągły Pokémon.\rBill powiedział mi, że koniec jego\nogona działa jak pływak.\rMa biały brzuszek. Tylko brzuszek.\nBardzo chciałabym zobaczyć, jak\fwygląda.\r</language>
	</row>
	<row id="msg_0364_R25R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój wnuk Bill opowiedział mi\no Pokémonie z długim językiem.\rMówił, że ma znaki przypominające\npierścienie na przedniej części\fnóg!\r</language>
	</row>
	<row id="msg_0364_R25R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, mój wnuk wspomniał o okrągłym,\nniebieskim Pokémonie, któremu na\fgłowie rosną liście.\r</language>
	</row>
	<row id="msg_0364_R25R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znasz tego morskiego Pokémona,\nktóry ma czerwoną kulę w ciele?\fWiesz, tego, który ma kształt\fgwiazdy?\rSłyszałam, że pojawia się w nocy.\nZ pewnością chciałabym go zobaczyć.\r</language>
	</row>
	<row id="msg_0364_R25R0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszałam o uroczym Pokémonie,\nktóry ma sześć ogonów.\rBardzo chciałabym przytulić\ntakiego uroczego Pokémona.\r</language>
	</row>
	<row id="msg_0364_R25R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znasz tego niesamowicie popularnego\nPokémona?\rTego, który ma żółte ciało\ni jasnoczerwone policzki...\rBardzo chciałabym zobaczyć, jak\nwygląda, zanim ewoluuje.\r</language>
	</row>
	<row id="msg_0364_R25R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli masz tego Pokémona,\nmogę go zobaczyć, proszę? {YESNO 0}</language>
	</row>
	<row id="msg_0364_R25R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokażesz mi go?\nAle z ciebie dobra osoba!\r</language>
	</row>
	<row id="msg_0364_R25R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie masz go?\nSzkoda...</language>
	</row>
	<row id="msg_0364_R25R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hm?\rTo nie ten Pokémon, o którym mi\nopowiadano...</language>
	</row>
	<row id="msg_0364_R25R0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow!\nTen Pokémon nazywa się\f{STRVAR_1 0, 0, 0}!\rTo wspaniały Pokémon!\nJako wyraz mojej wdzięczności,\fchciałabym dać ci to!\r</language>
	</row>
	<row id="msg_0364_R25R0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odwiedź mnie znowu\nkiedyś.</language>
	</row>
	<row id="msg_0364_R25R0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję, że pokazałeś/aś mi tyle\nuroczych Pokémonów.\fNaprawdę się dobrze bawiłam.\rCieszę się, że żyłam tak długo.</language>
	</row>
	<row id="msg_0364_R25R0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pod materiałową osłoną jest\nzakurzona maszyna...\fNie była używana od jakiegoś czasu.</language>
	</row>
</body>
