		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0373_R29_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Nara!\r</language>
	</row>
	<row id="msg_0373_R29_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Nara!\r</language>
	</row>
	<row id="msg_0373_R29_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, jak się mają twoje Pokémony?\rJeśli są słabe i niegotowe\ndo walki, trzymaj się z dala\fod wysokiej trawy.</language>
	</row>
	<row id="msg_0373_R29_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz te uskoki?\nStrach z nich skakać.\rAle możesz dojść do Wierzbnej\nbez przechodzenia przez\nwysoką trawę.</language>
	</row>
	<row id="msg_0373_R29_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałem zrobić przerwę, więc\nzapisałem swoje postępy.</language>
	</row>
	<row id="msg_0373_R29_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekam na Pokémony, które\npojawiają się tylko za dnia.</language>
	</row>
	<row id="msg_0373_R29_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekam na Pokémony, które\npojawiają się tylko nocą.</language>
	</row>
	<row id="msg_0373_R29_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekam na Pokémony, które\npojawiają się tylko rano.</language>
	</row>
	<row id="msg_0373_R29_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 29\nZachód do Zastruża</language>
	</row>
	<row id="msg_0373_R29_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 29\nWschód do Wierzbnej</language>
	</row>
	<row id="msg_0373_R29_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Nareszcie cię znalazłem!\r</language>
	</row>
