<?xml version="1.0"?>
<body language="English">
	<row id="msg_0373_R29_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: {STRVAR_1 3, 0, 0}!\nMożesz łapać dzikie Pokémony\fza pomocą Poké Balli.\rChodź za mną!\r</language>
	</row>
	<row id="msg_0373_R29_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: {STRVAR_1 3, 0, 0}!\nMożesz łapać dzikie Pokémony\fza pomocą Poké Balli.\rChodź za mną!\r</language>
	</row>
	<row id="msg_0373_R29_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...O tak właśnie!\r...\nHę? Może za szybko?\rSpróbuję jeszcze raz. Chodź tędy!\r</language>
	</row>
	<row id="msg_0373_R29_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? O tak właśnie!\rLepiej obniżyć HP celu\nbardziej niż ja to zrobiłem,\flub uśpić go w jakiś sposób.\rMożesz próbować różnych rzeczy,\nby sprawdzić, co zadziała.\rDam ci te. Powodzenia!\r</language>
	</row>
	<row id="msg_0373_R29_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? O tak właśnie!\rLepiej obniżyć HP celu\nbardziej niż ja to zrobiłem,\flub uśpić go w jakiś sposób.\rMożesz próbować różnych rzeczy,\nby sprawdzić, co zadziała.\rDam ci te. Powodzenia!\r</language>
	</row>
	<row id="msg_0373_R29_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0373_R29_00006" index="6">
