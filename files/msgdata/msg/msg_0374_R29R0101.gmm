<?xml version="1.0"?>
<body language="English">
	<row id="msg_0374_R29R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie możesz wspinać się na krawędzie.\rAle możesz z nich zeskoczyć,\nżeby skorzystać ze skrótu.</language>
	</row>
	<row id="msg_0374_R29R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Za tym miejscem pojawiają się\nróżne rodzaje Pokémonów.\rJeśli chcesz je wszystkie złapać,\nmusisz szukać wszędzie.</language>
	</row>
</body>
