<?xml version="1.0"?>
<body language="English">
	<row id="msg_0377_R30R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz być {STRVAR_1 3, 0, 0}.\rTo ja wysłałem wcześniej wiadomość\ndo Profesora Mariusza.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz być {STRVAR_1 3, 0, 0}.\rTo ja wysłałem wcześniej wiadomość\ndo Profesora Mariusza.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To właśnie chcę, żeby Profesor\nMariusz zbadał.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zabrałem to z szafki, w ostatnim dniu\nzakładu. Dwadzieścia lat trzymałem\fto w kredensie.\rZalakowana fiolka, a w środku coś\njak drobina bursztynu. Ciepła w\fdotyku, jakby żywa.\rPomyślałem, że Profesor Mariusz\nbędzie w stanie powiedzieć, co to\fjest.\r„Jest najlepszy, jeśli chodzi o\nbadania nad ewolucją Pokémonów”. To\fzdanie z jego własnej wizytówki.\rOstatnio ktoś chodzi mi pod\noknami... Zanieś to prosto do niego.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wracasz do Profesora Mariusza?\rProszę. Twój Pokémon powinien\nodpocząć.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam za kłopot, że musisz\nchodzić tam i z powrotem.\rAle koniecznie przekaż to\nProfesorowi Mariuszowi!</language>
	</row>
	<row id="msg_0377_R30R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Życie jest wspaniałe!\nZawsze można coś nowego odkryć!</language>
	</row>
	<row id="msg_0377_R30R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziewczyny w Kimonach? O czym ty\nmówisz? Nie znam takich osób.\fHi hi...\r</language>
	</row>
	<row id="msg_0377_R30R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Irena z Fundacji Geneza: A skoro już\ntu jestem...\rNazywam się Irena, pracuję w\nFundacji Geneza, która wspiera\fbadaczy Pokémonów!\rWięc to ty jesteś {STRVAR_1 3, 0, 0}!\rWłaśnie odwiedzałam mojego\nznajomego, Wacka.\rSłyszałam, że załatwiasz sprawę dla\nProfesora Mariusza, więc poczekałam\ftutaj.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Irena z Fundacji Geneza: A skoro już\ntu jestem...\rNazywam się Irena, pracuję w\nFundacji Geneza, która wspiera\fbadaczy Pokémonów!\rWięc to ty jesteś {STRVAR_1 3, 0, 0}!\rWłaśnie odwiedzałam mojego\nznajomego, Wacka.\rSłyszałam, że załatwiasz sprawę dla\nProfesora Mariusza, więc poczekałam\ftutaj.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Irena z Fundacji Geneza: Och! Cóż to\ntakiego? Rzadki Pokémon!\rRozumiem! Musisz pomagać w badaniach\nProfesora Mariusza! Chyba rozumiem,\fdlaczego dał ci tego Pokémona.\rWygląda na to, że będziesz traktować\ngo z miłością i troską.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Irena z Fundacji Geneza: ...Ach!\rWyglądasz na osobę godną zaufania.\nCo powiesz na pomoc w czymś?\rWidzisz? To najnowsza wersja\nPokédexu.\rAutomatycznie zapisuje dane o\nPokémonach, które widziałeś/aś lub\fzłapałeś/aś, i przesyła je do naszej\nfundacji.\rTo zaawansowana technologicznie\nencyklopedia! Chciałabym, żebyś ją\fmiał/a.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) Pokédex od\nIreny z Fundacji Geneza!</language>
	</row>
	<row id="msg_0377_R30R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Idź poznawać różne rodzaje Pokémonów\ni uzupełnij Pokédex!\rAle zabawiłam tu za długo. Muszę\nwracać do Żarowa, do Zamku.\r{STRVAR_1 3, 0, 0}, mam przeczucie, że to nie\nostatni raz, gdy się spotkamy...\rWymieńmy się numerami, na wszelki\nwypadek.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Idź poznawać różne rodzaje Pokémonów\ni uzupełnij Pokédex!\rAle zabawiłam tu za długo. Muszę\nwracać do Żarowa, do Zamku.\r{STRVAR_1 3, 0, 0}, mam przeczucie, że to nie\nostatni raz, gdy się spotkamy...\rWymieńmy się numerami, na wszelki\nwypadek.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Irenę z Fundacji\nGeneza w Pokégearze!\r</language>
	</row>
	<row id="msg_0377_R30R0201_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hm? Ta Czerwona Łuska! Co to takiego?\nCzerwony GYARADOS?\fToż to rzadkość! Ja... ja go chcę...\r{STRVAR_1 3, 0, 0}, może wymienimy\nsię?\rMogę zaoferować Dzielony Exp.,\nktóry dostałem od profesor Kunic. {YESNO 0}</language>
	</row>
	<row id="msg_0377_R30R0201_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hm? Ta Czerwona Łuska! Co to takiego?\nCzerwony GYARADOS?\fToż to rzadkość! Ja... ja go chcę...\r{STRVAR_1 3, 0, 0}, może wymienimy\nsię?\rMogę zaoferować Dzielony Exp.,\nktóry dostałem od profesor Kunic. {YESNO 0}</language>
	</row>
	<row id="msg_0377_R30R0201_00018" index="18">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0377_R30R0201_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arrgh, chyba twoja Torba jest pełna.</language>
	</row>
	<row id="msg_0377_R30R0201_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To rozczarowujące.\nTo bardzo rzadka rzecz.</language>
	</row>
	<row id="msg_0377_R30R0201_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, {STRVAR_1 3, 0, 0}!\rMam coś, co chcę ci dać, i właśnie\nmiałem wysłać wiadomość do Ireny z\fFundacji Geneza.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, {STRVAR_1 3, 0, 0}!\rMam coś, co chcę ci dać, i właśnie\nmiałem wysłać wiadomość do Ireny z\fFundacji Geneza.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprawa wygląda tak...\nPrzyjaciel z Hoenn odwiedził mnie,\fby mi to dać.\r</language>
	</row>
	<row id="msg_0377_R30R0201_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nNiebieską Kulę!\r</language>
	</row>
	<row id="msg_0377_R30R0201_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nCzerwoną Kulę!\r</language>
	</row>
	<row id="msg_0377_R30R0201_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta Kula ma coś wspólnego ze\nstarożytnymi ruinami za Domanicami,\fzwanymi Wrytą Wieżą.\rAle tylko nieliczni Trenerzy mogą\ntam dotrzeć...\rI tu wchodzisz ty.\rPani Irena jest o tobie bardzo\ndobrego zdania, a poza tym jesteś\fdumnym Mistrzem.\rJestem pewien, że rozwiążesz zagadkę\nKuli i tajemnicę ruin.</language>
	</row>
	<row id="msg_0377_R30R0201_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wryta Wieża jest za Domanicami,\ngdzieś w Jaskini Klifowej.\rTak przynajmniej słyszałem.\rTak przynajmniej pamiętam.\rTak przynajmniej wierzę!</language>
	</row>
	<row id="msg_0377_R30R0201_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest pełno zagranicznych czasopism.\rNie potrafię nawet przeczytać\nich tytułów...</language>
	</row>
	<row id="msg_0377_R30R0201_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To duży komputer.\nHm. Jest zepsuty.</language>
	</row>
	<row id="msg_0377_R30R0201_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cała sterta dziwnych monet!\fMoże są z innego kraju...</language>
	</row>
</body>
