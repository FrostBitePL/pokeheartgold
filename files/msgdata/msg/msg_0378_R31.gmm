<?xml version="1.0"?>
<body language="English">
	<row id="msg_0378_R31_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Hnyy ...Co?\rDziś zaszedłem za daleko,\nszukając Pokémonów.\rBolą mnie stopy i chce mi się spać...\rGdybym był dzikim Pokémonem,\nłatwo byłoby mnie złapać...\r...Zzzz...</language>
	</row>
	<row id="msg_0378_R31_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Hnyy! ...Co?\rMam ochotę poczytać jakieś słowa\nna kartce papieru czy coś...\r...Zzz...\n...!!\r</language>
	</row>
	<row id="msg_0378_R31_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? Co takiego?\nCo z tym Pokémonem?\fNie mam żadnej Poczty.\rZzz...</language>
	</row>
	<row id="msg_0378_R31_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta Poczta nie jest do mnie.</language>
	</row>
	<row id="msg_0378_R31_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, hej! Dostałem e-mail!\r...\nCo?\fNie znam tego Pokémona.\fPozwolę, żebyś się nim zaopiekował.\r</language>
	</row>
	<row id="msg_0378_R31_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} przekazał(a) Pokémona\ntrzymającego Pocztę.</language>
	</row>
	<row id="msg_0378_R31_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} przekazał(a) Pocztę.</language>
	</row>
	<row id="msg_0378_R31_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zobaczmy...\r„Dziękuję za twoją Pocztę.\nTo była taka ekscytująca przygoda.\rNie polubiłem jednak ZUBATA...”\nTak tu napisano.\rWybrałem się niedawno z przyjacielem\ndo mrocznej jaskini.\rTa jaskinia prowadzi do innej trasy.\nSwoją drogą, muszę ci podziękować\fza twoją uprzejmość.\rChciałbym się jakoś odwdzięczyć.\r</language>
	</row>
	<row id="msg_0378_R31_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TM44 to...\n...Zzz...\f...\r...Yyy... Odpoczynek!\rFraza „szybka regeneracja” skróciła\nsię do „Odpoczynku”, rozumiesz?\fTo atak, który usypia i regeneruje HP.</language>
	</row>
	<row id="msg_0378_R31_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Chce mi\nsię spać...</language>
	</row>
	<row id="msg_0378_R31_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Czekaj!\nWtedy nie miałbyś\fżadnego Pokémona!</language>
	</row>
	<row id="msg_0378_R31_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znalazłem dobrego Pokémona w Mrocznej\nJaskini. Wychowam go, by stawić czoła\fFalknerowi.\rTo Lider Sali w Łażanach.</language>
	</row>
	<row id="msg_0378_R31_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mroczna Jaskinia...\rGdyby jakiś Pokémon mógł ją\noświetlić, zbadałbym ją.</language>
	</row>
	<row id="msg_0378_R31_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 31\nZachód do Łażan</language>
	</row>
	<row id="msg_0378_R31_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mroczna Jaskinia</language>
	</row>
	<row id="msg_0378_R31_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? Co to jest?\nCzy to Jajko Pokémona?\fNigdy takiego nie widziałem.\r...Zzz...</language>
	</row>
</body>
