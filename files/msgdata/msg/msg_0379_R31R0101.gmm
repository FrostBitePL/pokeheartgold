	<row id="msg_0379_R31R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz być Trenerem w podróży.\nCzy stanąłeś już do walki\fw Sali Pokémon?</language>
	</row>
