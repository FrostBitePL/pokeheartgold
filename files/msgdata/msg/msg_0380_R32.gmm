<?xml version="1.0"?>
<body language="English">
	<row id="msg_0380_R32_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekaj!\nCo za pośpiech?\r</language>
	</row>
	<row id="msg_0380_R32_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, prawda?\nSzukał cię jakiś facet w okularach.\rZobacz sam. Czeka na ciebie\nw Sklepie Pokémon.</language>
	</row>
	<row id="msg_0380_R32_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, prawda?\nSzukał cię jakiś facet w okularach.\rZobacz sam. Czeka na ciebie\nw Sklepie Pokémon.\r</language>
	</row>
	<row id="msg_0380_R32_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłeś już w Sali Pokémon?\rMożesz tam sprawdzić siebie\ni swoje Pokémony.\rTo rytuał przejścia dla\nkażdego Trenera!</language>
	</row>
	<row id="msg_0380_R32_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłeś już w Sali Pokémon?\rMożesz tam sprawdzić siebie\ni swoje Pokémony.\rTo rytuał przejścia dla\nkażdego Trenera!\r</language>
	</row>
	<row id="msg_0380_R32_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz tam niezłe Pokémony.\rTo pewnie dzięki treningowi, jaki\nim dałeś w okolicach Łażan.\rTrening w Sali musiał być\nszczególnie pomocny.\rWeź to jako pamiątkę z Łażan.\rZwiększa moc ataków\ntypu Trawiasty.\r</language>
	</row>
	<row id="msg_0380_R32_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0380_R32_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje doświadczenia z Łażan\npowinny przydać się w podróży.</language>
	</row>
	<row id="msg_0380_R32_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, twoja Torba jest zapchana.</language>
	</row>
	<row id="msg_0380_R32_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, twoja Torba jest zapchana.\r</language>
	</row>
	<row id="msg_0380_R32_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WRUUUUAAA!\rLUDZIE UCIEKAJĄ, GDY RYCZĘ!\nALE TY PRZYSZEDŁEŚ SZUKAĆ!\rTO MNIE CIESZY!\nWEŹ TO!\r</language>
	</row>
	<row id="msg_0380_R32_00011" index="11">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0380_R32_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WRUUUAAA!\nTO JEST RYK!\rNAWET POKÉMONY UCIEKAJĄ\nPRZED DOBRYM RYKIEM!</language>
	</row>
	<row id="msg_0380_R32_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WRUUUAAA! TWOJA TORBA JEST PEŁNA!</language>
	</row>
	<row id="msg_0380_R32_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co powiesz na tego smacznego,\nodżywczego SlowpokeTaila?\rDla ciebie teraz, tylko $1 000 000!\nBędziesz tego chciał! {YESNO 0}</language>
	</row>
	<row id="msg_0380_R32_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tss! Myślałem, że dzieciaki\ndzisiaj mają kasę...</language>
	</row>
	<row id="msg_0380_R32_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcesz tego?\nTo spadaj. Wynocha!</language>
	</row>
	<row id="msg_0380_R32_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 32\nPołudnie do Azalea Town</language>
	</row>
	<row id="msg_0380_R32_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruiny Alph\nWschodnie Wejście</language>
	</row>
	<row id="msg_0380_R32_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Union Cave przed tobą</language>
	</row>
</body>
