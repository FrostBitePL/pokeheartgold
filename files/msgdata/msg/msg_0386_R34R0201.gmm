<?xml version="1.0"?>
<body language="English">
	<row id="msg_0386_R34R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, kochanie. Robisz Pokédex?\rMusisz walczyć ze wszystkimi\nrodzajami Pokémonów.\rSpróbuj dla odmiany użyć tej TM.</language>
	</row>
	<row id="msg_0386_R34R0201_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0386_R34R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Drwina.\rUżyj jej, a atakowany Pokémon\nbędzie mógł przez chwilę używać\ftylko ataków, które zadają\fobrażenia twojemu Pokémonowi.</language>
	</row>
	<row id="msg_0386_R34R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BUTTERFREE: Freeh!</language>
	</row>
	<row id="msg_0386_R34R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widziałeś/aś świątynię, która oddaje\ncześć strażnikowi?\rTen strażnik obserwuje las na\nprzestrzeni czasu.\rMyślę, że to musi być Pokémon\ntypu Trawiastego.</language>
	</row>
</body>
