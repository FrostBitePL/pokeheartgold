<?xml version="1.0"?>
<body language="English">
	<row id="msg_0390_R36_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest dziwne drzewo!\nUżyć Konewki? {YESNO 0}</language>
	</row>
	<row id="msg_0390_R36_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} użył(a)\nKonewki!\r</language>
	</row>
	<row id="msg_0390_R36_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziwne drzewo nie lubi Konewki!\rDziwne drzewo zaatakowało!\r</language>
	</row>
	<row id="msg_0390_R36_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej!\rMiałeś kiedyś problem z głazem\nblokującym drogę? Oczywiście, że tak!\rDla ludzi takich jak ty jest HM,\nktóre przyjdzie ci z pomocą!\r</language>
	</row>
	<row id="msg_0390_R36_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To ty poradziłeś sobie z tym\ndziwnym drzewem na drodze?\rJesteś niezłym Trenerem!\nWeź to!\r</language>
	</row>
	<row id="msg_0390_R36_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawiera Rozłupanie Skały, które\npotrafi znokautować. Możesz nawet\fużyć go do rozbijania głazów, gdy\fzdobędziesz Odznakę Sali z Łażan!\rAle uważaj!\nUkryte ataki takie jak ten są trudne\fdo zapomnienia przez twojego\fPokémona, gdy się go nauczy.\rPowinieneś dobrze przemyśleć,\nktóry Pokémon ma się go nauczyć.</language>
	</row>
	<row id="msg_0390_R36_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja Torba jest pełna!</language>
	</row>
	<row id="msg_0390_R36_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziwne drzewo blokuje drogę\ndo Ecruteak City.\rUniemożliwia mi zakupy.\fCoś trzeba z tym zrobić.</language>
	</row>
	<row id="msg_0390_R36_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziwne drzewo zniknęło, jakby po\nprostu sobie poszło...!\fCo? To był Pokémon?\rCóż, wreszcie mogę pojechać do\nEcruteak na zakupy.\rJeśli pójdziesz ścieżką stamtąd,\ngdzie stało dziwne drzewo, dotrzesz\fdo Ecruteak City!</language>
	</row>
	<row id="msg_0390_R36_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 36\nPółnoc do Ecruteak City</language>
	</row>
	<row id="msg_0390_R36_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruiny Alph\nPółnocne Wejście</language>
	</row>
	<row id="msg_0390_R36_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porady dla Trenerów\rTen sam rodzaj Pokémona może\nwyglądać tak samo, ale mogą się\frozwijać inaczej.\rNa początku ich siła może wyglądać\ntak samo, ale ta siła może się\fzmieniać w miarę wzrostu.</language>
	</row>
	<row id="msg_0390_R36_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porady dla Trenerów\rAtak Kopanie może zabrać cię\nz powrotem do wejścia, gdy go użyjesz.\rJeśli chcesz zbadać jaskinię lub\ncoś podobnego, Pokémon znający\fKopanie będzie bardzo przydatny.</language>
	</row>
	<row id="msg_0390_R36_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Floria z Kwiaciarni!\rSłuchaj, słuchaj! Gdy skropiłam\nwodą to wijące się drzewo, aż\fpodskoczyło!\rTo musi być Pokémon.\rObstawiam, że gdybyś je oblał,\nprzestałoby się przebierać\fze wstrząsu!</language>
	</row>
	<row id="msg_0390_R36_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Floria z Kwiaciarni!\rSłuchaj, słuchaj! Gdy skropiłam\nwodą to wijące się drzewo, aż\fpodskoczyło! To musi być Pokémon.\fGdybyś je oblał...\rOch, to Konewka!\rOblej to drzewo dla mnie!\nChcę zobaczyć, co się stanie!</language>
	</row>
	<row id="msg_0390_R36_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To było zabawne!\rChcę ci dać to za\nrozrywkę!\r</language>
	</row>
	<row id="msg_0390_R36_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki Doniczkom na Jagody możesz\nhodować dowolną Jagodę z dowolnego\fregionu bez obaw!\r</language>
	</row>
	<row id="msg_0390_R36_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się!\nDam ci też trochę Jagód.\rDoniczki na Jagody na nic się\nnie zdadzą bez Jagód.\r</language>
	</row>
	<row id="msg_0390_R36_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz posadzić Jagody w ziemi.\nPowinieneś je czasem podlewać.\fWtedy urosną silne!\rMuszę wrócić do Goldenrod.\fWybierasz się do Ecruteak?\rW takim razie powinieneś pójść\nna północ stąd. Do zobaczenia!\r</language>
	</row>
</body>
