<?xml version="1.0"?>
<body language="English">
	<row id="msg_0391_R36R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Ruiny Alph.\nStarożytna tradycja utworzona\fz kamieni.\rNie zastanawiasz się, kto by\nzrobił coś takiego? I dlaczego?</language>
	</row>
	<row id="msg_0391_R36R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widziałeś to dziwne drzewo\nna drodze?\rTo może wyjaśniać, dlaczego mniej\nludzi odwiedza Ruiny Alph.</language>
	</row>
</body>
