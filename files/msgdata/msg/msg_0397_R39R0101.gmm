<?xml version="1.0"?>
<body language="English">
	<row id="msg_0397_R39R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja MILTANK już mi mleka nie\ndaje.\rTa tu farma ma słynne mleko.\rPrawie każdy chce się napić.\nDa mi dużo mleka, jak jej dam\fdużo Jagód, tak mi się zdaje.</language>
	</row>
	<row id="msg_0397_R39R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co powiesz na moje Mleko Muumuu?\rTo moja duma i radość.\fDaj je Pokémonowi, by odzyskał HP!\rDam ci je za jedyne $500. {YESNO 0}</language>
	</row>
	<row id="msg_0397_R39R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę bardzo!\nPij i ciesz się!\r</language>
	</row>
	<row id="msg_0397_R39R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi.\nBrak kasy, brak sprzedaży!</language>
	</row>
	<row id="msg_0397_R39R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdaje mi się, że twoja Torba jest pełna.</language>
	</row>
	<row id="msg_0397_R39R0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcesz tego?\nWróć innym razem, słyszysz?</language>
	</row>
	<row id="msg_0397_R39R0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lepiej idę doić.</language>
	</row>
	<row id="msg_0397_R39R0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nasze mleko jedzie nawet do Kanto.\rWięc jak nasza MILTANK nie da\nmleka, mamy kłopot.</language>
	</row>
	<row id="msg_0397_R39R0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naprawiłeś naszą MILTANK,\nkochanieńki. Teraz znów daje\fMleko Muumuu.\rMasz tu coś za fatygę.</language>
	</row>
	<row id="msg_0397_R39R0101_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0397_R39R0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To tam Naturalny Dar.\rTyp i Moc tego ataku zależą od\nJagody, którą trzyma twój Pokémon.\rGdy raz go użyjesz, Jagoda znika.\nLepiej pomyśl, jak go użyć,\fkochanieńki.</language>
	</row>
	<row id="msg_0397_R39R0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdaje mi się, że twoja Torba jest pełna.</language>
	</row>
	<row id="msg_0397_R39R0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}1 BUTELKA</language>
	</row>
	<row id="msg_0397_R39R0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}1 TUZIN</language>
	</row>
	<row id="msg_0397_R39R0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{ALN_CENTER}NIE, DZIĘKI</language>
	</row>
</body>
