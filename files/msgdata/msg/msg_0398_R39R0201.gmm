<?xml version="1.0"?>
<body language="English">
	<row id="msg_0398_R39R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muumuu jest chora...\fPotrzebuje mnóstwa Jagód Oran.\r</language>
	</row>
	<row id="msg_0398_R39R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję!\nMuumuu jest znów całkowicie zdrowa!\rDam ci te Pieczątki za twój trud.\r</language>
	</row>
	<row id="msg_0398_R39R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szok!\nBardzo chcę dać ci trochę\fPieczątek, ale nie masz Pudełka\fna Pieczątki...\rAle się nie martw.\nMoja siostra może dać ci Pudełko\fna Pieczątki!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha!\nTwoje Pudełko na Pieczątki\njest pełne!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muumuu jest znów całkowicie zdrowa!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muumuu jest chora...\fPotrzebuje mnóstwa Jagód Oran.\r</language>
	</row>
	<row id="msg_0398_R39R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję!\nMuumuu jest znów całkowicie zdrowa!\rDam ci to Pudełko na Pieczątki\nza twój trud.\r</language>
	</row>
	<row id="msg_0398_R39R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz dostosować swoje Poké Bale.\rWybierz „KAPSUŁKI DO BALI” w swoim\nPC i naklej Pieczątki na Kapsułce,\fjak chcesz, a potem załóż Kapsułkę\fna dowolny Poké Bal.\rSpróbuj różnych rzeczy, a zobaczysz.\nMoja siostra może dać ci Pieczątki!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprzedajemy Mleko Muumuu w domu.\fNie zapomnij wpaść!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MILTANK: ...Muu...\r</language>
	</row>
	<row id="msg_0398_R39R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego głos jest słaby...</language>
	</row>
	<row id="msg_0398_R39R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MILTANK: Muuu!\r</language>
	</row>
	<row id="msg_0398_R39R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aż tryska energią.</language>
	</row>
	<row id="msg_0398_R39R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dać Jagodę Oran dla MILTANK? {YESNO 0}</language>
	</row>
	<row id="msg_0398_R39R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} dał(a) Jagodę Oran\ndla MILTANK.</language>
	</row>
	<row id="msg_0398_R39R0201_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MILTANK stała się trochę zdrowsza!</language>
	</row>
	<row id="msg_0398_R39R0201_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MILTANK robi się zdrowsza!</language>
	</row>
	<row id="msg_0398_R39R0201_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MILTANK stała się całkowicie zdrowa!</language>
	</row>
	<row id="msg_0398_R39R0201_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} nie ma Jagód Oran...</language>
	</row>
	<row id="msg_0398_R39R0201_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} nie dał(a)\nJagody Oran.\rMILTANK wygląda na smutną.</language>
	</row>
	<row id="msg_0398_R39R0201_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 10, 0, 0} zostały schowane\nw Pudełku na Pieczątki!</language>
	</row>
</body>
