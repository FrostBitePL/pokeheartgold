<?xml version="1.0"?>
<body language="English">
	<row id="msg_0399_R42_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 42 Mrowiny\ndo Imbramowic</language>
	</row>
	<row id="msg_0399_R42_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Góra Krzyżowa Wewnątrz Jaskini\nWodospadu</language>
	</row>
	<row id="msg_0399_R42_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Góra Krzyżowa Wewnątrz Jaskini\nWodospadu</language>
	</row>
	<row id="msg_0399_R42_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 42 Imbramowice\ndo Mrowin</language>
	</row>
	<row id="msg_0399_R42_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{SIZE 200}Bum!{SIZE 100}\r</language>
	</row>
	<row id="msg_0399_R42_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O rety!\rPrzepraszam, że w ciebie wpadłem.\rZraniłem cię?\rProszę, nie płacz.\nProszę, weź to.\r</language>
	</row>
	<row id="msg_0399_R42_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To atak zwany Siłą!\rGdy Pokémon się go nauczy, może\nusuwać głazy z twojej drogi.\fCiesz się szczęśliwym życiem\fwspinacza górskiego!\r</language>
	</row>
	<row id="msg_0399_R42_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robert: ARTICUNO... Jaki odważny!\nJaki orzeźwiający! Jaki piękny! I\fjak szybko leci!\r</language>
	</row>
	<row id="msg_0399_R42_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}! Wygląda na to, że jesteś w\npobliżu miejsc, gdzie pojawia się\fARTICUNO.\rCóż, to w porządku. Moje pragnienie\nposzukiwania ARTICUNO jest o wiele\fwiększe niż twoje...\rMój dziadek był...dość zafascynowany\nmitami. Słyszałem od niego tak wiele\fopowieści o ARTICUNO.\r</language>
	</row>
	<row id="msg_0399_R42_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ARTICUNO...\rNie przestanę cię śledzić, dopóki\nnie dowiem się, o co ci chodzi...\rSłyszysz mnie!\r</language>
	</row>
</body>
