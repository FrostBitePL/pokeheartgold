	<row id="msg_0402_R43R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszałem, że czasami można znaleźć\nRed Scale.\rSkoro o tym mowa, znam osobę,\nktóra doceniłaby Red Scale.\fKto?\rNie pamiętam...</language>
	</row>
	<row id="msg_0402_R43R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszałem, że czasami można znaleźć\nRed Scale.\rSkoro o tym mowa, znam osobę,\nktóra doceniłaby Red Scale.\fKto?\rChyba nazywa się Pan Ktoś-tam...\rJak on się nazywał...?</language>
