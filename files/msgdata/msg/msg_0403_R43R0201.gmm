<?xml version="1.0"?>
<body language="English">
	<row id="msg_0403_R43R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stój tam, dzieciaku!\rOpłata za przejście to $1000.\r</language>
	</row>
	<row id="msg_0403_R43R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardzo dziękuję!\r</language>
	</row>
	<row id="msg_0403_R43R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W takim razie zapłać, ile masz,\nproszę.\rCi, którzy nie mają pieniędzy,\nhmm... mogą przejść za darmo!\r</language>
	</row>
	<row id="msg_0403_R43R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">He-he-he. Zbijamy niezły majątek.\rWszyscy chcą zobaczyć, co się dzieje\nprzy Lake of Rage.</language>
	</row>
	<row id="msg_0403_R43R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbiry z Team Rocket przegoniły\nmnie z mojego posterunku.\rPotem po prostu zniknęły.\nWygląda na to, że ktoś zniszczył\fich kryjówkę.\r...Jeszcze jedno!\fZnalazłem to pod ladą.\fCzuję się z tym niekomfortowo.\fMógłbym ci to dać?\r</language>
	</row>
	<row id="msg_0403_R43R0201_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0403_R43R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To zawiera Bombę Mułową!\rNie tylko zadaje obrażenia celowi,\nale czasem też go zatruwa.\fWidzisz!\rCzy to nie sprawia, że czujesz\nsię niekomfortowo?</language>
	</row>
</body>
