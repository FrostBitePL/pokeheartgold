<?xml version="1.0"?>
<body language="English">
	<row id="msg_0406_R46_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 46\nGórska Droga przed tobą</language>
	</row>
	<row id="msg_0406_R46_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dark Cave</language>
	</row>
	<row id="msg_0406_R46_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ślepy zaułek...?\rCzy poszedłem złą drogą?\rNie wiedziałem, że to tylko\njedna droga.</language>
	</row>
	<row id="msg_0406_R46_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powinieneś/aś kiedyś wypróbować\nróżne trasy.\rNigdy nie wiadomo, jakiego\nPokémona zdobędziesz!</language>
	</row>
</body>
