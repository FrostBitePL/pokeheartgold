<?xml version="1.0"?>
<body language="English">
	<row id="msg_0412_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklamy</language>
	</row>
	<row id="msg_0412_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0412_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Zawsze tam, gdzie go potrzebujesz!\nTwoje lokalne Centrum Pokémon!</language>
	</row>
	<row id="msg_0412_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Pełen uśmiechniętych twarzy!\nTwój radosny Poké Mart!</language>
	</row>
	<row id="msg_0412_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Twój przyjaciel na przygodę,\ntwój Pokégear...Pokégear...Pokégear!\nPokégear od Silph Co. Zabierz nasz\nnajnowszy model na swoją kolejną przygodę!</language>
	</row>
	<row id="msg_0412_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Przyciągnij wzrok trenera na\nintensywną walkę! Ale nie szukaj zaczepki\nz tymi, którzy trenerami nie są. To była\nwiadomość od Ligi Pokémon.</language>
	</row>
	<row id="msg_0412_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Gdziekolwiek spojrzysz,\ntam jest. Twój wierny towarzysz w\npodróży przez życie. Twój Pokémon zawsze\njest gotów pomóc. To była wiadomość\nod Ligi Pokémon.</language>
	</row>
	<row id="msg_0412_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Łagodny bieg czasu, starożytna\npostać... Delikatne wibracje Wieży\nSprout w Violet City...\nCzeka na ciebie. Ta wiadomość\npochodzi od Johtańskiego Biura\nTurystyki.</language>
	</row>
	<row id="msg_0412_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Starożytna wiadomość jest\nodkrywana właśnie teraz w Ruinach\nAlph! Ta wiadomość pochodzi od\nJohtańskiego Biura Turystyki.</language>
	</row>
	<row id="msg_0412_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Piękny dźwięk i pełen\ngracji taniec, razem w Teatrze\nTanecznym Ecruteak.\nTa wiadomość pochodzi od\nJohtańskiego Biura Turystyki.</language>
	</row>
	<row id="msg_0412_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Światło nadziei świeci nad\npełną niepokoju podróżą łodzią do\nzabytku tego portowego miasta!\nPrzyjdź zobaczyć latarnię morską!\nTa wiadomość pochodzi od Johtańskiego\nBiura Turystyki.</language>
	</row>
	<row id="msg_0412_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Chlup chlup! Pycha! Aprisok!\nAprisok! Biegaj i potrząsaj, rób Aprisok!\nChlup chlup! Wypij go! Aprisok!\nWszyscy kochają Aprisok! Tylko dla\nPokémonów! Nic dla ludzi! Aprisok!</language>
	</row>
	<row id="msg_0412_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Dopracowany design, żywa\nsylwetka. Wznoszący się tuman kurzu.\nBiegaj razem ze swoim Pokémonem w\nbutach do biegania!</language>
	</row>
	<row id="msg_0412_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Los splata spotkanie, które\nzaczyna się w Centrum Pokémon...\nWięź między dwojgiem ludzi...\nJeśli wejdziesz po schodach, znajdziesz je.\nUnion Room.</language>
	</row>
	<row id="msg_0412_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Los splata spotkanie, które\nzaczyna się w Centrum Pokémon...\nWięź między dwojgiem ludzi...\nJeśli zjedziesz schodami ruchomymi,\nznajdziesz to--Klub Wi-Fi.</language>
	</row>
	<row id="msg_0412_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Symbol miasta Goldenrod,\nGlobal Terminal! Miejsce, gdzie możesz\ndoświadczyć świata, gdzie świat może\npoznać ciebie, i Global Trade Station,\ngdzie możesz wymieniać Pokémony.</language>
	</row>
	<row id="msg_0412_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Zapraszamy wszystkich!\nWitamy w Wi-Fi Plaza, gdzie wszyscy się\nspotykają! Graj w gry z innymi\nw Wi-Fi Plaza! Wi...! Wi-Fi Plaza!</language>
	</row>
	<row id="msg_0412_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Jeśli szukasz gadżetów\nPokémon, znajdziesz tu wszystko.\nOd góry do dołu, cudowny świat\nzakupów w Domu Towarowym\nGoldenrod.</language>
	</row>
	<row id="msg_0412_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Między walkami, czemu nie\nzrobić przerwy i nie odpocząć w\nGoldenrod Game Corner?</language>
	</row>
	<row id="msg_0412_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Hej, wszyscy słuchacze\nradia tam. Tu Johtańska Sieć\nRadiowa. Wysyłamy marzenia\npoprzez nasze fale radiowe. La la la,\nRadio Johto!</language>
	</row>
	<row id="msg_0412_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: No dobrze, dobrze, dobrze!\nCzy ty też nie chcesz być pewny, że\ntwój Pokémon zwycięży? Chodźmy na\nPokéathlon! Jest dziesięć różnych\nkonkurencji, w których możesz startować!</language>
	</row>
	<row id="msg_0412_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Da da da dum dum dum da da!\nPrzyjaźń!\nWspółpraca!\nZaufanie!\nWiara w możliwości!\nCiekące poty to znak twojej\nciężkiej pracy!\n...\nHymn Pokéathlonu,\n„Wierz w Pokémony!” Wkrótce w sprzedaży!</language>
	</row>
	<row id="msg_0412_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Łapiesz Pokémony typu Bug?\nOtóż wtorki, czwartki i soboty\nkażdego tygodnia to Dni Konkursu\nŁapania Owadów!\nWy, którzy kochacie Pokémony typu Bug,\nzbierzcie się w Parku Narodowym w każdy\nwtorek, czwartek i sobotę!\nDo zobaczenia tam!</language>
	</row>
	<row id="msg_0412_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Dum da da dum dum da da\ndum dum. Pa pa pa pa da dum pa pa pa pa\nda dum Pokémon! Łap tyle Pokémonów,\nile chcesz, aż skończą się Poké Balle\nw Safari Zone strażnika Baoby...zone...</language>
	</row>
	<row id="msg_0412_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Słynny batonik Rage Candy\nz Mahogany Town! Ciężko pracują\nkażdego dnia, by robić te słynne\nRageCandyBary! Czemu nie zabrać jednego\ndo domu przyjaciołom--RageCandyBar!</language>
	</row>
	<row id="msg_0412_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Niezwykłe walki Pokémon,\nte, o jakich zawsze marzyłeś,\nznajdziesz tylko w Battle Tower.\nWeź udział w walkach najwyższej klasy.\nCzy podejmiesz wyzwanie sam czy\nz partnerem?</language>
	</row>
	<row id="msg_0412_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Znasz prawdziwe oblicze\nBattle Tower? Otwiera każde drzwi na\nplanecie; każdy trener na ciebie czeka!\nJak daleko zdołasz zajść?</language>
	</row>
	<row id="msg_0412_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Miejsce, gdzie twój ukochany\nPokémon może stać się numerem jeden.\nWalka życia w Battle Hall!\nSpraw, by twój Pokémon zabłysnął tutaj;\njesteś jedynym trenerem, który to\npotrafi!</language>
	</row>
	<row id="msg_0412_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Zbieraj Punkty Zamku!\nZarządzaj swoimi Punktami Zamku\ni użyj ich przed każdą walką w\nBattle Castle!</language>
	</row>
	<row id="msg_0412_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Szczęście jest tak zmienne\ni samolubne w Battle Arcade! Po prostu\nwierz w swojego Pokémona i idź!\nWalcz z losem w Battle Arcade!\nCzy następny krok przybliży cię do\nraju, czy do porażki?</language>
	</row>
	<row id="msg_0412_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Znasz najlepsze techniki\nwalki, by Pokémony pokazały swój\nprawdziwy potencjał? Battle Factory!\nJeśli nie wiesz, nie wygrasz! Do\nzobaczenia w Battle Factory!</language>
	</row>
	<row id="msg_0412_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Zapraszamy w błyskawiczną\npodróż między Olivine a Vermilion City\nna pokładzie łodzi przypominającej\nwodolot!</language>
	</row>
	<row id="msg_0412_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Jeśli chcesz jeździć rowerem\ntyle, ile zapragniesz, pod niebem\nKanto, czemu nie spróbować\nCycling Road?\nCzeka na ciebie przy Route 17.</language>
	</row>
	<row id="msg_0412_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Liga Pokémon czeka na\nciebie, gdy będziesz gotów nas\nwyzwać. Jeśli przybywasz z Kanto,\njesteśmy tuż na końcu\nRoute 22.\nTa wiadomość pochodzi od Ligi\nPokémon.</language>
	</row>
	<row id="msg_0412_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Człowiek, który odbudował\nmiasto zniszczone przez erupcję\nwulkanu. Tym człowiekiem nie był\nnikt inny, jak Blaine! Choć stracił\nswoją Salę Cinnabar, zdołał otworzyć ją\nponownie na Seafoam Islands!</language>
	</row>
	<row id="msg_0412_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Hej wszyscy słuchacze\nradia tam. Tu Kantońska Sieć\nRadiowa. Wysyłamy marzenia\npoprzez fale radiowe. La la la,\nRadio Kanto!</language>
	</row>
	<row id="msg_0412_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Silph Co. to specjalna,\nzaawansowana technologicznie firma\ninnowacyjna, oddana poprawianiu życia\nludzi i tworzeniu wspaniałej przyszłości.</language>
	</row>
	<row id="msg_0412_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Reklama: Z Goldenrod do miasta\nSaffron, zaskakująco szybki dojazd\ni podróż najwyższej jakości!\nJedź Magnet Trainem--transportem\nprzyszłości!</language>
	</row>
</body>
