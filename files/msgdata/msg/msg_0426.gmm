	</row>
	<row id="msg_0426_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę bardzo!\r</language>
	</row>
	<row id="msg_0426_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten mecz odbędzie się w\nostrym słońcu.</language>
	</row>
	<row id="msg_0426_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten mecz odbędzie się podczas\nsilnego deszczu.</language>
	</row>
	<row id="msg_0426_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten mecz odbędzie się podczas\nszalejącej burzy piaskowej.</language>
	</row>
	<row id="msg_0426_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten mecz odbędzie się podczas\nulewnego gradu.</language>
	</row>
	<row id="msg_0426_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten mecz odbędzie się w\ngęstej mgle.</language>
	</row>
	<row id="msg_0426_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten mecz odbędzie się na piętrze,\ngdzie czas i przestrzeń są zniekształcone.</language>
	</row>
	<row id="msg_0426_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje Pokémony zostaną zamienione\nz Pokémonami innego Trenera na czas meczu.</language>
	</row>
	<row id="msg_0426_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Od następnej gry prędkość\nplanszy zostanie zwiększona.</language>
	</row>
	<row id="msg_0426_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Od następnej gry prędkość\nplanszy zostanie zmniejszona.</language>
	</row>
	<row id="msg_0426_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W następnej grze ruch planszy\nstanie się losowy.</language>
	</row>
	<row id="msg_0426_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał/a {STRVAR_1 51, 2, 0} BP!</language>
