	<row id="msg_0426_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najpierw muszę przechować wszelkie\nprzedmioty trzymane przez twoje Pokémony.\r</language>
	</row>
	<row id="msg_0426_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę chwilę poczekać.</language>
	</row>
	<row id="msg_0426_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0426_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świetnie się spisałeś/aś!\nTeraz uleczymy twoje Pokémony.</language>
	</row>
	<row id="msg_0426_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Następna, gra nr {STRVAR_1 53, 0, 0}!\nJesteś gotowy/a?</language>
	</row>
	<row id="msg_0426_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz zapisać ostatnią walkę\njako Battle Video?</language>
	</row>
	<row id="msg_0426_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka gracza {STRVAR_1 3, 0, 0} została\nzapisana jako Battle Video.\r</language>
	</row>
	<row id="msg_0426_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wystąpił błąd.\nNie udało się zapisać Battle Video.\r</language>
	</row>
	<row id="msg_0426_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Usunąć istniejące Battle Video i\nzapisać ostatnią walkę?</language>
	</row>
	<row id="msg_0426_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapisywanie...\nNie wyłączaj zasilania.</language>
