	<row id="msg_0426_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś gotowy/a?</language>
	</row>
	<row id="msg_0426_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och! Masz szczęście!\nMożesz pominąć walkę!</language>
	</row>
	<row id="msg_0426_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szkoda!\nTym razem nie ma żadnego wydarzenia!</language>
	</row>
	<row id="msg_0426_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK! Niech zacznie się walka!</language>
	</row>
	<row id="msg_0426_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon gracza {STRVAR_1 3, 0, 0} wejdzie\ndo meczu zatruty...\rOch! Szczęśliwy traf!\r{STRVAR_1 3, 0, 0} nie ma żadnego Pokémona,\nktóry mógłby zostać zatruty!</language>
	</row>
	<row id="msg_0426_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony graczy {STRVAR_1 3, 0, 0}\ni {STRVAR_1 3, 1, 0} zaczną zatrute...\rOch! Szczęśliwy traf!\rŻaden z nich nie ma Pokémona,\nktóry mógłby zostać zatruty!</language>
	</row>
	<row id="msg_0426_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon gracza {STRVAR_1 3, 0, 0} wejdzie\ndo meczu sparaliżowany...\rOch! Szczęśliwy traf!\r{STRVAR_1 3, 0, 0} nie ma żadnego Pokémona,\nktóry mógłby zostać sparaliżowany!</language>
	</row>
	<row id="msg_0426_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony graczy {STRVAR_1 3, 0, 0}\ni {STRVAR_1 3, 1, 0} zaczną sparaliżowane...\rOch! Szczęśliwy traf!\rŻaden z nich nie ma Pokémona,\nktóry mógłby zostać sparaliżowany!</language>
	</row>
	<row id="msg_0426_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon gracza {STRVAR_1 3, 0, 0} wejdzie\ndo meczu poparzony...\rOch! Szczęśliwy traf!\r{STRVAR_1 3, 0, 0} nie ma żadnego Pokémona,\nktóry mógłby zostać poparzony!</language>
	</row>
	<row id="msg_0426_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony graczy {STRVAR_1 3, 0, 0}\ni {STRVAR_1 3, 1, 0} zaczną poparzone...\rOch! Szczęśliwy traf!\rŻaden z nich nie ma Pokémona,\nktóry mógłby zostać poparzony!</language>
	</row>
	<row id="msg_0426_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon gracza {STRVAR_1 3, 0, 0} wejdzie\ndo meczu śpiący...\rOch! Szczęśliwy traf!\r{STRVAR_1 3, 0, 0} nie ma żadnego Pokémona,\nktórego dałoby się uśpić!</language>
	</row>
	<row id="msg_0426_00063" index="63">
		<attribute name="window_context_name">used</attribute>
