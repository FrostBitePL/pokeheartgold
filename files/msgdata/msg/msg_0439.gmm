<?xml version="1.0"?>
<body language="English">
	<row id="msg_0439_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem opiekunem z Przedszkola.\rOpiekujemy się cennymi Pokémonami\ninnych Trenerów.\rJeśli chcesz, byśmy wychowali\ntwojego Pokémona, porozmawiaj z moją\fżoną.</language>
	</row>
	<row id="msg_0439_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O, to ty!\rWychowywaliśmy twojego Pokémona i,\nmój Boże, jakie to było zaskoczenie!\rTwój Pokémon trzymał jajko!\rNie wiemy, skąd się tam wzięło, ale\ntwój Pokémon je miał.\rChcesz je, prawda? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O, to ty! Miło cię widzieć.\rTwój {STRVAR_1 0, 0, 0} ma się świetnie.</language>
	</row>
	<row id="msg_0439_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No dobrze, zatrzymam je. Dziękuję!</language>
	</row>
	<row id="msg_0439_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie masz teraz miejsca...\rWróć, gdy zrobisz miejsce.</language>
	</row>
	<row id="msg_0439_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) jajko od\nopiekuna z Przedszkola.</language>
	</row>
	<row id="msg_0439_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze się nim opiekuj.</language>
	</row>
	<row id="msg_0439_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0439_00008" index="8">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0439_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O, to ty! Miło cię widzieć!\rTwój {STRVAR_1 0, 0, 0} i {STRVAR_1 0, 1, 0} mają się\nświetnie.\r</language>
	</row>
	<row id="msg_0439_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naprawdę je zatrzymam.\rChcesz to jajko, tak? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze się nim opiekuj!\rChoć... chyba już nigdy nie\nznajdziemy kolejnego...\rNie, nie, na pewno znajdziemy!\nJestem tego pewien!\r</language>
	</row>
	<row id="msg_0439_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No dobrze, wezmę je. Dziękuję.\rChoć... chyba już nigdy nie\nznajdziemy kolejnego...\rNie, nie, na pewno znajdziemy!\nJestem tego pewien!\r</language>
	</row>
	<row id="msg_0439_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}...\rJeśli opiekujemy się twoimi\nPokémonami i zauważymy, że jeden ma\fjajko, czy mam zadzwonić? Czy to ci\nodpowiada? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}...\nIf we are looking after your Pokémon\fand notice one is holding an Egg, would\fyou like me to contact you by\fphone? Would that be all right? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz na nas polegać!\rPokémony, które chcesz wychować,\nzostaw pod opieką mojej żony.</language>
	</row>
	<row id="msg_0439_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem. W porządku.\rPokémony, które chcesz wychować,\nzostaw pod opieką mojej żony.</language>
	</row>
	<row id="msg_0439_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta dwójka bardzo się lubi.</language>
	</row>
	<row id="msg_0439_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta dwójka jest zgodna.</language>
	</row>
	<row id="msg_0439_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta dwójka niezbyt się lubi.</language>
	</row>
	<row id="msg_0439_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta dwójka woli bawić się z innymi\nPokémonami niż ze sobą...</language>
	</row>
	<row id="msg_0439_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem opiekunką z Przedszkola.\nMożemy wychować Pokémona dla ciebie.\rChcesz, żebyśmy wychowali twojego\nPokémona? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Którego Pokémona mamy wychować?\r</language>
	</row>
	<row id="msg_0439_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, wychowamy twojego {STRVAR_1 0, 0, 0}\nprzez jakiś czas.\rWróć po niego później.\r</language>
	</row>
	<row id="msg_0439_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możemy wychować dwa twoje Pokémony.\rChcesz, żebyśmy wychowali jeszcze\njednego? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A, jesteś! Mój mąż cię szukał.</language>
	</row>
	<row id="msg_0439_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No dobrze. Przyjdź jeszcze.</language>
	</row>
	<row id="msg_0439_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie masz dość pieniędzy...</language>
	</row>
	<row id="msg_0439_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz odebrać też drugiego? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardzo dobrze. Przyjdź jeszcze.</language>
	</row>
	<row id="msg_0439_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O, to ty! Miło cię widzieć.\rA teraz o twoich Pokémonach...\r</language>
	</row>
	<row id="msg_0439_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój {STRVAR_1 0, 0, 0} urósł o około {STRVAR_1 51, 1, 0}\npoz.\r</language>
	</row>
	<row id="msg_0439_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja drużyna jest pełna.\rZrób miejsce i wróć do mnie.</language>
	</row>
	<row id="msg_0439_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chcesz odebrać {STRVAR_1 0, 0, 0},\nbędzie to kosztować {STRVAR_1 53, 1, 0}. {YESNO 0}</language>
	</row>
	<row id="msg_0439_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doskonale! Oto twój Pokémon.\r</language>
	</row>
	<row id="msg_0439_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0} odebrał(a) {STRVAR_1 0, 0, 0} od\nopiekunki z Przedszkola.\r</language>
	</row>
	<row id="msg_0439_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och? Masz tylko jednego Pokémona.\rNie możesz odejść bez Pokémona. Wróć\nkiedy indziej.</language>
	</row>
	<row id="msg_0439_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz odebrać swojego Pokémona? {YESNO 0}</language>
	</row>
	<row id="msg_0439_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zostawisz mi tego Pokémona,\nczym będziesz walczyć?\rWróć kiedy indziej.</language>
	</row>
	<row id="msg_0439_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? Spokojnie.\rJeśli zostawisz tego Pokémona u\nmnie, zostanie ci tylko jeden.\rLepiej złap jeszcze kilka, jeśli\nmogę coś doradzić.</language>
	</row>
	<row id="msg_0439_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spokojnie. To tylko jajko!</language>
	</row>
	<row id="msg_0439_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, wychowamy twojego {STRVAR_1 0, 0, 0}\nprzez jakiś czas.\rWróć po niego później.</language>
	</row>
