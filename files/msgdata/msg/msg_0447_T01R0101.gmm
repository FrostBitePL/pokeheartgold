<?xml version="1.0"?>
<body language="English">
	<row id="msg_0447_T01R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć!\rReda nie ma. Nie dzwonił też, więc\nnie mam pojęcia, gdzie jest ani co\frobi.\rMówią, że brak wiadomości to dobra\nwiadomość, ale i tak się o niego martwię.</language>
	</row>
	<row id="msg_0447_T01R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Martwię się, że Red się skrzywdzi\nlub zachoruje, ale to chłopak.\fJestem dumna, że robi to, co chce.</language>
	</row>
	<row id="msg_0447_T01R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mają tu programy, które nie są\nnadawane w Johto...</language>
	</row>
</body>
