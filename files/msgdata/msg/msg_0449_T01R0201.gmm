<?xml version="1.0"?>
<body language="English">
	<row id="msg_0449_T01R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Cześć! Mój młodszy brat jest\nLiderem Sali w Viridian City.\rAle tak często wyjeżdża z miasta,\nże sprawia to problemy Trenerom.</language>
	</row>
	<row id="msg_0449_T01R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Cześć! Dobry moment. Właśnie\nmam zamiar napić się herbaty.\rChcesz się przyłączyć?\rOch, wygląda na to, że twoje Pokémony\nsą trochę zabrudzone.\rPielęgnacja pomaga im stać się\npiękniejszymi i przyjaźniejszymi.\rChcesz, żebym jednego wypielęgnowała? {YESNO 0}</language>
	</row>
	<row id="msg_0449_T01R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Którego mam wypielęgnować?\r</language>
	</row>
	<row id="msg_0449_T01R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} wygląda na zadowolonego.</language>
	</row>
	<row id="msg_0449_T01R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Proszę bardzo!\nWszystko zrobione.\rWidzisz? Nie wygląda ładnie?\nTo taki uroczy Pokémon.</language>
	</row>
	<row id="msg_0449_T01R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Zawsze piję herbatę o tej\nporze. Przyłącz się.</language>
	</row>
	<row id="msg_0449_T01R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Nie chcesz, żebym któregoś\nwypielęgnowała? Dobra, po prostu\fnapijemy się herbaty.</language>
	</row>
	<row id="msg_0449_T01R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Och, przepraszam. Naprawdę\nnie mogę wypielęgnować Jajka.</language>
	</row>
	<row id="msg_0449_T01R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Naprawdę lubisz pielęgnację!\nPowiedz mi!\fChcesz numer mojego młodszego brata?\rJest Liderem Sali w Viridian City.\nRzuciłeś/aś mu już wyzwanie?\rChcesz go zapisać? {YESNO 0}</language>
	</row>
	<row id="msg_0449_T01R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Blue\nw Pokégearze!</language>
	</row>
	<row id="msg_0449_T01R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Zadzwoń do niego, kiedy\nbędziesz miał/a ochotę.\rMoże być zbyt pewny siebie, ale\ndalej potrzebuje towarzystwa.\rMówił, że nie ma żadnych planów\nna niedzielne wieczory...\fChichot!</language>
	</row>
	<row id="msg_0449_T01R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Naprawdę? Nie chcesz?\nRozumiem...\fJakie rozczarowanie.</language>
	</row>
	<row id="msg_0449_T01R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daisy: Chcesz zapisać numer\nmojego młodszego brata? {YESNO 0}</language>
	</row>
</body>
