<?xml version="1.0"?>
<body language="English">
	<row id="msg_0455_T02PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdzie u licha jest Lider Sali\nz Viridian?\fChciałem rzucić mu wyzwanie...</language>
	</row>
	<row id="msg_0455_T02PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lider Sali z Viridian nie polega\nna innych!\rLider Sali twierdzi, że jego zasadą\njest nie przegrywać z nikim, nie\fmając żadnych podwładnych.\rTo czyni go jeszcze bardziej\npopularnym, i wielu Trenerów\fprzyszło dla niego pracować.</language>
	</row>
	<row id="msg_0455_T02PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszałem, że Sali na Cinnabar\njuż nie ma.\rCiekawe, co się stało z Blaine’em,\nLiderem Sali.</language>
	</row>
	<row id="msg_0455_T02PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moim marzeniem jest zostać Liderem Sali.</language>
	</row>
</body>
