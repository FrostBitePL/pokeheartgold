<?xml version="1.0"?>
<body language="English">
	<row id="msg_0458_T02R0302_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj, zapraszamy do naszej Sali\nTreningowej.\rMożesz walczyć z naszymi najlepszymi\nTrenerami i ich ulubionymi Pokémonami\fraz dziennie.\rChcesz wziąć udział? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0458_T02R0302_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś gotowy/a!\nProszę, przejdź.\r</language>
	</row>
	<row id="msg_0458_T02R0302_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem...\nProszę, wróć innym razem.\r</language>
	</row>
	<row id="msg_0458_T02R0302_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz wyjść? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękujemy za grę!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem.\nPowodzenia!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, witaj!\nProszę, tędy!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Dom Trenera--\nmiejsce dla Trenerów.\rPokéwalker sprowadzi tu twoich\nznajomych!\rMożesz rzucić wyzwanie różnym\nTrenerom raz dziennie.\rWygrywając, zdobędziesz Punkty Walki.\fDaj z siebie wszystko!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och! Pożyczę na chwilę twój\nVs. Recorder.\rZobaczmy... Odsuwamy tę część tutaj,\ni tik-tak-klik tam!\rGotowe!\rTeraz możesz sprawdzać swoje Punkty\nWalki za pomocą Vs. Recordera!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vs. Recorder gracza {STRVAR_1 3, 0, 0}\nzostał ulepszony.</language>
	</row>
	<row id="msg_0458_T02R0302_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz wymienić swoje Punkty Walki\nna wspaniałe nagrody w Johto\fBattle Frontier!\r</language>
	</row>
	<row id="msg_0458_T02R0302_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skoro jesteś już gotowy/a,\nchcesz potrenować? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz zawalczyć? {YESNO 0}</language>
	</row>
	<row id="msg_0458_T02R0302_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Do zobaczenia jutro!</language>
	</row>
</body>
