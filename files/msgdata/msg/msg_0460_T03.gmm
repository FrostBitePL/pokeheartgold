<?xml version="1.0"?>
<body language="English">
	<row id="msg_0460_T03_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odwiedziłeś/aś już Salę w Pewter?\rLider Sali używa Pokémonów\ntypu Skalny.</language>
	</row>
	<row id="msg_0460_T03_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nocą CLEFAIRY wychodzą się bawić\nna Mt. Moon.\rAle nie każdej nocy.</language>
	</row>
	<row id="msg_0460_T03_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, przybyłeś/aś aż tutaj\nz Johto?\rTo przywołuje wspomnienia.\rGdy byłem młody, pojechałem do Johto,\nżeby trenować.\rBardzo przypominasz mi mnie samego\njako młodego mężczyznę.\rProszę. Chcę, żebyś dostał/a ten\nprzedmiot, który znalazłem w Johto.\r</language>
	</row>
	<row id="msg_0460_T03_00003" index="3">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0460_T03_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0460_T03_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odwiedzanie nowych, nieznanych miejsc\ni poznawanie nowych ludzi...\fTo są radości podróżowania.</language>
	</row>
	<row id="msg_0460_T03_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Wygląda na to, że LATIOS\nzostał tym natychmiast przyciągnięty!\r</language>
	</row>
	<row id="msg_0460_T03_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Wygląda na to, że LATIAS\nzostała tym natychmiast przyciągnięta!\r</language>
	</row>
	<row id="msg_0460_T03_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję, że LATIOS jest pełen\nducha walki!\rChętnie rzuciłbym mu wyzwanie,\nale pozwolę tobie spróbować!</language>
	</row>
	<row id="msg_0460_T03_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję, że LATIAS jest pełna\nducha walki!\rChętnie rzuciłbym jej wyzwanie,\nale pozwolę tobie spróbować!</language>
	</row>
	<row id="msg_0460_T03_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LATIOS: Shuaaaann!\r</language>
	</row>
	<row id="msg_0460_T03_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LATIAS: Huaaaaann!\r</language>
	</row>
	<row id="msg_0460_T03_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LATIOS odleciał w odległe niebo...\r</language>
	</row>
	<row id="msg_0460_T03_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LATIAS odleciała w odległe niebo...\r</language>
	</row>
	<row id="msg_0460_T03_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Imponujące!\nTo była wspaniała walka!\rNie sądzę, żebyś musiał/a dać\nz siebie wszystko, i to mnie\fprzeraża...\r</language>
	</row>
	<row id="msg_0460_T03_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbyt długo mnie nie było w Lidze\nPokémon Hoenn.\rMuszę się już pożegnać.\r..................\rOch, nigdy nie poznałem twojego\nimienia. ...Ale tym razem o nie\fnie zapytam.\rNasza zabawa musi poczekać na\nodpowiedni moment.\r</language>
	</row>
	<row id="msg_0460_T03_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Imponujące!\nTo była wspaniała walka!\rLATIOS wróci, gdy tylko dojdzie\ndo siebie, by naprawić tę porażkę.\r</language>
	</row>
	<row id="msg_0460_T03_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Imponujące!\nTo była wspaniała walka!\rLATIAS wróci, gdy tylko dojdzie\ndo siebie, by naprawić tę porażkę.\r</language>
	</row>
	<row id="msg_0460_T03_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Rozumiem.\nWolisz ukryć przede mną swoją\fprawdziwą siłę. Masz jeszcze zapas,\fi to mnie przeraża.\r</language>
	</row>
	<row id="msg_0460_T03_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Co? Nie boisz się,\nprawda? Nie krępuj się. Śmiało.</language>
	</row>
	<row id="msg_0460_T03_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pewter City\nPośród Surowych Gór</language>
	</row>
	<row id="msg_0460_T03_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Pewter City\nLider: Brock\fTrener Pokémonów Twardy Jak Skała</language>
	</row>
	<row id="msg_0460_T03_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muzeum Nauki w Pewter</language>
	</row>
	<row id="msg_0460_T03_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Pewter City!</language>
	</row>
	<row id="msg_0460_T03_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drzwi są zamknięte...</language>
	</row>
</body>
