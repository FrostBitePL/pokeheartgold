<?xml version="1.0"?>
<body language="English">
	<row id="msg_0461_T03FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Popatrz! Mam GYARADOSA!\rPowoli wychowałem go z MAGIKARPA.\nW końcu wyewoluował!</language>
	</row>
	<row id="msg_0461_T03FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Był kiedyś dziwny staruszek,\nktóry sprzedawał MAGIKARPY.\rTen chłopiec kupił jednego i trzymał\ngo bardzo długo!</language>
	</row>
</body>
