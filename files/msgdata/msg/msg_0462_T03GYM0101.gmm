<?xml version="1.0"?>
<body language="English">
	<row id="msg_0462_T03GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ignacy: Wow, niezbyt często\ndostajemy wyzwanie od kogoś z\fRegionu Żarów.\rJestem Ignacy, Lider Sali w\fMokrzeszowie. Jestem ekspertem od\fPokémonów typu Skalny.\rMoje Pokémony są odporne na\nwiększość ataków fizycznych.\rBędzie ci trudno wyrządzić\njakiekolwiek obrażenia.\rDawaj!\r</language>
	</row>
	<row id="msg_0462_T03GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ignacy: Potężne ataki twojego\nPokémona pokonały moją twardą jak\fskała obronę...\rJesteś silniejszy/a, niż\nsię spodziewałem...\fŚmiało--weź tę Odznakę.\r</language>
	</row>
	<row id="msg_0462_T03GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nOdznakę Głazu od Ignacego!</language>
	</row>
	<row id="msg_0462_T03GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ignacy: Naprawdę spodobała mi się\nnasza walka, {STRVAR_1 3, 0, 0}!\fDam ci też atak Lawina Skalna.\rMoże czasem sprawić, że przeciwnik\nsię wzdrygnie.\r</language>
	</row>
	<row id="msg_0462_T03GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ignacy: Naprawdę spodobała mi się\nnasza walka, {STRVAR_1 3, 0, 0}!\fDam ci też atak Lawina Skalna.\rMoże czasem sprawić, że przeciwnik\nsię wzdrygnie.\r</language>
	</row>
	<row id="msg_0462_T03GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ignacy: Świat jest ogromny. Wciąż\njest wielu silnych Trenerów, takich\fjak ty.\rPoczekaj tylko i zobacz.\rJa też stanę się o wiele\nsilniejszy.</language>
	</row>
	<row id="msg_0462_T03GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo! Przyszła legendo! Wyglądasz...\fnaprawdę zajefajnie.\rWalczysz ze świdnickimi Liderami\nSal?\rTo silni i oddani ludzie, tacy jak\nLiderzy Sal z Regionu Żarów.</language>
	</row>
	<row id="msg_0462_T03GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo! Przyszła legendo! Ta Sala\nnie sprawiła ci wielu problemów.\rSposób, w jaki przejąłeś/aś kontrolę,\nbył naprawdę inspirujący.\fMówię to poważnie.</language>
	</row>
	<row id="msg_0462_T03GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Mokrzeszowie</language>
	</row>
	<row id="msg_0462_T03GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Mokrzeszowie\rLider: Brock\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
