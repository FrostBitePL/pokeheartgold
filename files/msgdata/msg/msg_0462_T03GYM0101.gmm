<?xml version="1.0"?>
<body language="English">
	<row id="msg_0462_T03GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Wow, niezbyt często dostajemy\nwyzwanie od kogoś z Johto.\rJestem Brock, Lider Sali w Pewter.\fJestem ekspertem od Pokémonów\ftypu Skalny.\rMoje Pokémony są odporne na\nwiększość ataków fizycznych.\rBędzie ci trudno wyrządzić\njakiekolwiek obrażenia.\rDawaj!\r</language>
	</row>
	<row id="msg_0462_T03GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Potężne ataki twojego Pokémona\npokonały moją twardą jak skała\fobronę...\rJesteś silniejszy/a, niż\nsię spodziewałem...\fŚmiało--weź tę Odznakę.\r</language>
	</row>
	<row id="msg_0462_T03GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nOdznakę Głazu od Brocka!</language>
	</row>
	<row id="msg_0462_T03GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Naprawdę spodobała mi się\nnasza walka, {STRVAR_1 3, 0, 0}!\fDam ci też atak Lawina Skalna.\rMoże czasem sprawić, że przeciwnik\nsię wzdrygnie.\r</language>
	</row>
	<row id="msg_0462_T03GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Naprawdę spodobała mi się\nnasza walka, {STRVAR_1 3, 0, 0}!\fDam ci też atak Lawina Skalna.\rMoże czasem sprawić, że przeciwnik\nsię wzdrygnie.\r</language>
	</row>
	<row id="msg_0462_T03GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brock: Świat jest ogromny. Wciąż\njest wielu silnych Trenerów, takich\fjak ty.\rPoczekaj tylko i zobacz.\rJa też stanę się o wiele\nsilniejszy.</language>
	</row>
	<row id="msg_0462_T03GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo! Przyszła legendo! Wyglądasz...\fnaprawdę zajefajnie.\rWalczysz z Liderami Sal\nKanto?\rTo silni i oddani ludzie,\ntacy jak Liderzy Sal z Johto.</language>
	</row>
	<row id="msg_0462_T03GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo! Przyszła legendo! Ta Sala\nnie sprawiła ci wielu problemów.\rSposób, w jaki przejąłeś/aś kontrolę,\nbył naprawdę inspirujący.\fMówię to poważnie.</language>
	</row>
	<row id="msg_0462_T03GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Pewter City</language>
	</row>
	<row id="msg_0462_T03GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Pewter City\rLider: Brock\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
