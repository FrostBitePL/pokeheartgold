<?xml version="1.0"?>
<body language="English">
	<row id="msg_0463_T03PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Tak, a Sali na Cinnabar\njuż nie ma. Byłem naprawdę zdumiony.\r...Tak? Rozmawiam przez telefon.\nOdejdź!</language>
	</row>
	<row id="msg_0463_T03PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">JIGGLYPUFF: Puu pupuu.</language>
	</row>
	<row id="msg_0463_T03PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Większość Pokémonów robi się senna,\ngdy usłyszy śpiew JIGGLYPUFF.\rJest kilka ataków, których można\nużyć tylko, gdy Pokémon śpi.</language>
	</row>
	<row id="msg_0463_T03PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach...\nGdybym tylko miał HAUNTERA...\rJeśli masz HAUNTERA, wymienisz go\nna mojego XATU,\fprawda? {YESNO 0}</language>
	</row>
	<row id="msg_0463_T03PC0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, cudownie! Uszczęśliwiłeś/aś mnie!\rDzięki tobie w końcu mam Pokémona,\nktórego szukałem...\fod zawsze!</language>
	</row>
	<row id="msg_0463_T03PC0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To musi być HAUNTER!\rHAUNTER!!</language>
	</row>
	<row id="msg_0463_T03PC0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie odmówiłbyś/aś wymiany,\ngdybyś miał/a HAUNTERA.\rTo znaczy, że po prostu go nie masz.\nToż to musi być to...</language>
	</row>
	<row id="msg_0463_T03PC0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak ci się podoba ten fajny XATU,\nktórego ci wymieniłem?\rJest taki fajny, bo kiedyś był\nz fajnym mną!</language>
	</row>
</body>
