<?xml version="1.0"?>
<body language="English">
	<row id="msg_0467_T04_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elektrownia Kanto?\rJest blisko końca Route 9, drogi\nprowadzącej stąd na wschód.\rMyślę, że był tam jakiś\nwypadek.</language>
	</row>
	<row id="msg_0467_T04_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbierasz każdy pojedynczy rodzaj\nPokémona?\rTo musi być niezłe wyzwanie, ale\nbrzmi też zabawnie.</language>
	</row>
	<row id="msg_0467_T04_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przylądek na północy to dobre\nmiejsce na randki.\rDziewczyny to lubią!\rTylko między nami...\nMisty, Liderka Sali, czasem tam\fbywa, na przylądku.\rChyba nie mam żadnych szans!</language>
	</row>
	<row id="msg_0467_T04_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SLOWBRO: Yarah?</language>
	</row>
	<row id="msg_0467_T04_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SLOWBRO jest pełen ducha walki!</language>
	</row>
	<row id="msg_0467_T04_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja i mój SLOWBRO tworzymy\nniesamowitą kombinację!\rSLOWBRO, pokaż mi swoją Psychikę!\r...!\nPsychika SLOWBRO uderza mocno!</language>
	</row>
	<row id="msg_0467_T04_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten podejrzany typ zapytał mnie\nwłaśnie, jak dotrzeć do Elektrowni.\rPowiedział, że musi to zostać\n„...poufne”.\rCo to niby ma znaczyć?</language>
	</row>
	<row id="msg_0467_T04_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podejrzany typ wkradł się\ndo Sali! Jaki interes ma\fz Misty?</language>
	</row>
	<row id="msg_0467_T04_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widziałem tego podejrzanego\nfaceta w czerni, idącego w stronę\fPrzylądka.</language>
	</row>
	<row id="msg_0467_T04_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem wielkim fanem Misty z Sali\nw Cerulean.</language>
	</row>
	<row id="msg_0467_T04_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszałem o jaskini tutaj, w której\nsą przerażająco silne Pokémony.\fDlatego tu przyjechałem.\r</language>
	</row>
	<row id="msg_0467_T04_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ajuh?\rMoja Dowsing Machine reaguje...</language>
	</row>
	<row id="msg_0467_T04_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest...\nOsławiona Cerulean Cave!\rMieszkają tu przerażająco silne\nPokémony. Tylko ci, którzy pokonali\fwszystkich ośmiu Liderów Sal Kanto,\fmogą się tu zmierzyć.</language>
	</row>
	<row id="msg_0467_T04_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cerulean City\nMiasto Kwiecistej Laguny</language>
	</row>
	<row id="msg_0467_T04_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Cerulean City\nLiderka: Misty\fChłopczyca-Syrenka</language>
	</row>
	<row id="msg_0467_T04_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twórca Trendu Rowerowego Boomu\rGłówny Sklep Rowerowy w Cerulean</language>
	</row>
	<row id="msg_0467_T04_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest tu ogłoszenie...\rWytępmy złodziejstwo i uczyńmy to\nmiasto przyjaźniejszym, weselszym\fmiejscem!\fPolicja Cerulean</language>
	</row>
	<row id="msg_0467_T04_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Route 24 Przed Tobą\nNa Wschód do Cerulean Cape</language>
	</row>
	<row id="msg_0467_T04_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest zamknięte...</language>
	</row>
</body>
