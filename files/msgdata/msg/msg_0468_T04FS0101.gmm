<?xml version="1.0"?>
<body language="English">
	<row id="msg_0468_T04FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Natkniesz się na wielu Trenerów\nw drodze do Cerulean Cape.\rChcą sprawdzić, jak wypadają\nna tle innych Trenerów.</language>
	</row>
	<row id="msg_0468_T04FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty jest chyba jedyną osobą\nw mieście, która potrafi pokonać\fTrenerów na Cerulean Cape.</language>
	</row>
</body>
