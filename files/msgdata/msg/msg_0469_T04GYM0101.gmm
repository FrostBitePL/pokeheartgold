<?xml version="1.0"?>
<body language="English">
	<row id="msg_0469_T04GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{SIZE 200}Bum!{SIZE 100}\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej! Ja bardzo przepraszam!\nTy nie zraniony, dobra?\fJa bardzo zajęty.\fNie ma czas na rozmowa z tobą.\fNie dobrze dla mnie, jak ktoś widzi.\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej nie! Ty już mnie widzieć!\fJa robić duży błąd!\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, ty! Zapomnij ty widzieć ja, dobra?\nTy nic nie widzieć, nie słyszeć,\fnie wiedzieć, dobra?\fPa!\fPa-pa a go-go!\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam, będę nieobecna\nprzez jakiś czas. Misty, Liderka Sali</language>
	</row>
	<row id="msg_0469_T04GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skoro Misty jest nieobecna, my też\nsobie wyjdziemy. Trenerzy z Sali</language>
	</row>
	<row id="msg_0469_T04GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Cerulean City</language>
	</row>
	<row id="msg_0469_T04GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Cerulean City\rLiderka: Misty\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
	<row id="msg_0469_T04GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Czekałam na ciebie,\nty utrapieńcu!\rMoże i masz mnóstwo Odznak z Sal\nw Johto, ale lepiej nie lekceważ\fmnie zbytnio.\rMoje Pokémony typu Wodny są twarde!\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Naprawdę jesteś dobry/a...\rMuszę przyznać, że masz umiejętności...\rProszę bardzo.\nTo Odznaka Kaskady.\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nOdznakę Kaskady od Misty!</language>
	</row>
	<row id="msg_0469_T04GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Oto kolejna pamiątka\nz tej walki. Weź to!\r</language>
	</row>
	<row id="msg_0469_T04GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Zawiera atak\nFala Wodna.\rMoże czasem zdezorientować przeciwnika.\rUdało ci się pokonać Trenerów\naż od samego Johto.\fJestem pewna, że dobrze go wykorzystasz.</language>
	</row>
	<row id="msg_0469_T04GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Misty: Czy w Johto jest wielu\npotężnych Trenerów?\rPewnego dnia wyruszę w podróż,\nby walczyć z potężnymi Trenerami!</language>
	</row>
	<row id="msg_0469_T04GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo! Przyszła legendo!\rSkoro Misty była nieobecna, ja też\nwyszedłem się zabawić.\fHe-he-he.</language>
	</row>
	<row id="msg_0469_T04GYM0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoo, pokazałeś/aś mi, jaki/a jesteś\ntwardy/a.\rJak zawsze, to była świetna walka!</language>
	</row>
	<row id="msg_0469_T04GYM0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...!\r{STRVAR_1 3, 0, 0} podniósł/podniosła\nczarny przedmiot leżący przy basenie.\rTo Część z jakiejś maszyny!\r</language>
	</row>
</body>
