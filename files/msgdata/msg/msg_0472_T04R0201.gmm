<body language="English">
	<row id="msg_0472_T04R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszałem, że kręci się tu jakiś\npodejrzany typ.\rNie zniosę tego, jeśli okaże się\nzłodziejem.</language>
	</row>
	<row id="msg_0472_T04R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kiedyś napadli nas rabusie.</language>
	</row>
	<row id="msg_0472_T04R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DIGLETT: Dug dug.</language>
	</row>
</body>
