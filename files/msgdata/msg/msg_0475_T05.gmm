<?xml version="1.0"?>
<body language="English">
	<row id="msg_0475_T05_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niezły budynek, co?\nTo Wieża Radiowa Kanto.</language>
	</row>
	<row id="msg_0475_T05_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kanto ma wiele dobrych programów\nradiowych.</language>
	</row>
	<row id="msg_0475_T05_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ludzie przyjeżdżają z całego kraju,\nby oddać hołd duchom Pokémonów.</language>
	</row>
	<row id="msg_0475_T05_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrzebujesz Poké Flute, żeby\nobudzić śpiące Pokémony.\fKażdy Trener musi to wiedzieć!</language>
	</row>
	<row id="msg_0475_T05_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lavender Town\nSzlachetne Miasteczko</language>
	</row>
	<row id="msg_0475_T05_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stacja Radiowa Kanto\nTwoje Ulubione Programy na Antenie\fPrzez Całą Dobę!</language>
	</row>
	<row id="msg_0475_T05_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wolontariacki Dom Pokémonów\nw Lavender</language>
	</row>
	<row id="msg_0475_T05_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dom Wspomnień\nNiech Duchy Pokémonów Spoczywają w Pokoju</language>
	</row>
</body>
