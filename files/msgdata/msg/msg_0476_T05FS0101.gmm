<?xml version="1.0"?>
<body language="English">
	<row id="msg_0476_T05FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Repel to konieczność, jeśli\nplanujesz eksplorować jaskinię.\rChoć lubię eksplorować, wciąż\nnie odwiedziłem wszystkich jaskiń.</language>
	</row>
	<row id="msg_0476_T05FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszałem o rzemieślniku, który\nrobi niestandardowe Poké Bally\fw Azalea, mieście w Johto.\rChciałbym mieć trochę.</language>
	</row>
</body>
