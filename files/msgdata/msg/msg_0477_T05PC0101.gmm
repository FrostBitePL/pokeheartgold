<?xml version="1.0"?>
<body language="English">
	<row id="msg_0477_T05PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na północ od Lavender jest\nRock Tunnel.\rPrzejdź przez niego, żeby dotrzeć\ndo Elektrowni.</language>
	</row>
	<row id="msg_0477_T05PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest program radiowy, który gra\nmuzykę Poké Flute.\rOch? Ach, twoje radio potrzebuje\nkarty EXPN, żeby go złapać.</language>
	</row>
	<row id="msg_0477_T05PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli Elektrownia nie działa,\nMagnetyczny Pociąg też nie pojedzie...\rTo znaczy też, że Stacja Radiowa\nnie może nadawać...</language>
	</row>
	<row id="msg_0477_T05PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dyrektor Stacji Radiowej\nbył naprawdę szczęśliwy.\rMówił, że znowu nadają na antenie,\nbo Elektrownia znów działa\fpłynnie.</language>
	</row>
</body>
