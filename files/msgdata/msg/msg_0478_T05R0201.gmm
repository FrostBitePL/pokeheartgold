<?xml version="1.0"?>
<body language="English">
	<row id="msg_0478_T05R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pan Fuji rzeczywiście tu mieszka,\nale teraz jest nieobecny.\rPowinien być w Domu Wspomnień.</language>
	</row>
	<row id="msg_0478_T05R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzysz w to?\rNiektórym ludziom po prostu\nznudzi się opieka nad Pokémonem.\rDziadek przygarnia takie biedne,\nbezdomne Pokémony i się nimi opiekuje.</language>
	</row>
	<row id="msg_0478_T05R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PSYDUCK: Gu-guwa?</language>
	</row>
	<row id="msg_0478_T05R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NIDORINO: Gyun!</language>
	</row>
	<row id="msg_0478_T05R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PIDGEY: Pijji!</language>
	</row>
</body>
