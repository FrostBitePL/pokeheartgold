<?xml version="1.0"?>
<body language="English">
	<row id="msg_0483_T06_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vermilion Port to nadmorska\nbrama Kanto.\rLuksusowe liniowce z całego\nświata cumują tutaj.</language>
	</row>
	<row id="msg_0483_T06_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój Pokémon przygotowuje teren\npod budowę.\rAle nie mam pieniędzy, żeby\nrozpocząć ten projekt.</language>
	</row>
	<row id="msg_0483_T06_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MACHOP: Guooh gogogoh!</language>
	</row>
	<row id="msg_0483_T06_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Kanto jest osiem Sal.\rTen duży budynek to Sala Pokémon\nw Vermilion.</language>
	</row>
	<row id="msg_0483_T06_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Kanto zbierają się uzdolnieni\nTrenerzy. Liderzy Sal są szczególnie\fsilni.\rNiełatwo ich będzie pokonać.</language>
	</row>
	<row id="msg_0483_T06_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zacząłeś/aś zbierać Odznaki\nz Sal Kanto?\rNie zgadzasz się, że Trenerzy\ntutaj są twardzi?</language>
	</row>
	<row id="msg_0483_T06_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Domyślam się, że wkrótce skończysz\npodbój Sal Kanto.\rDaj mi znać, jak zdobędziesz\nwszystkie osiem Odznak.</language>
	</row>
	<row id="msg_0483_T06_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gratulacje!\nZdobyłeś/aś wszystkie Odznaki z Sal\fKanto.\rMam nagrodę za twoje wysiłki.\r</language>
	</row>
	<row id="msg_0483_T06_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PP Max to potężny przedmiot,\nktóry podnosi maksymalne PP ataku\fdo jego górnej granicy. Może\fzmienić sposób, w jaki walczysz!</language>
	</row>
	<row id="msg_0483_T06_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PP Max to potężny przedmiot,\nktóry podnosi maksymalne PP ataku\fdo jego górnej granicy. Może\fzmienić sposób, w jaki walczysz!</language>
	</row>
	<row id="msg_0483_T06_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vermilion City\nPort Przepięknych Zachodów Słońca</language>
	</row>
	<row id="msg_0483_T06_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Vermilion City\nLider: Porucznik Surge\fPiorunujący Amerykanin</language>
	</row>
	<row id="msg_0483_T06_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Klub Fanów Pokémonów\nWitamy Wszystkich Fanów Pokémonów!</language>
	</row>
	<row id="msg_0483_T06_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wejście do Vermilion Port</language>
	</row>
	<row id="msg_0483_T06_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: To było tak blisko!\nMyślałem, że uda mi się je\fzapędzić w kozi róg, urządzając tu\fzasadzkę...\rAle bieganie po wodzie...\njest ponad moje możliwości.\rMimo to zaczynam dostrzegać\nwzorzec. SUICUNE preferuje wodę!\fTo znaczy...\r</language>
	</row>
	<row id="msg_0483_T06_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam, {STRVAR_1 3, 0, 0}!\nMuszę już iść!\r</language>
	</row>
	<row id="msg_0483_T06_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć!\nNazywam się Steven.\fMistrz z regionu Hoenn.\rCzy my się już...spotkaliśmy?\rTo niemożliwe.\nWszyscy Trenerzy, z którymi\fwalczyłem, i tak wyglądają jakoś\fpodobnie.\rZwłaszcza ci, którzy dali mi\ntrudne walki...\r</language>
	</row>
	<row id="msg_0483_T06_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Swoją drogą, słyszałeś/aś\no Pokémonie zwanym LATIAS?\rBadam, dlaczego LATIAS, Pokémon\nz Hoenn, postanowiła opuścić Hoenn\fi przybyć tutaj.\r</language>
	</row>
	<row id="msg_0483_T06_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Swoją drogą, słyszałeś/aś\no Pokémonie zwanym LATIOS?\rBadam, dlaczego LATIOS, Pokémon\nz Hoenn, postanowił opuścić Hoenn\fi przybyć tutaj.\r</language>
	</row>
	<row id="msg_0483_T06_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LATIAS to Pokémon mający wiele\nwspólnego z Soul Dew, klejnotopodobną\fOrbką.\rBiorąc pod uwagę fakt, że LATIAS jest\nteraz w Kanto, można przypuszczać,\fże ma to związek z Soul Dew.\r</language>
	</row>
	<row id="msg_0483_T06_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LATIOS to Pokémon mający wiele\nwspólnego z Soul Dew, klejnotopodobną\fOrbką.\rBiorąc pod uwagę fakt, że LATIOS jest\nteraz w Kanto, można przypuszczać,\fże ma to związek z Soul Dew.\r</language>
	</row>
	<row id="msg_0483_T06_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LATIAS to Pokémon, który pokonuje\nogromne odległości.\rBędzie trudno ją znaleźć bez żadnej\nmaszyny do jej śledzenia.\rAle każdy Trener będzie do niej\nprzyciągany, prawda?\r</language>
	</row>
	<row id="msg_0483_T06_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LATIOS to Pokémon, który pokonuje\nogromne odległości.\rBędzie trudno go znaleźć bez żadnej\nmaszyny do jego śledzenia.\rAle każdy Trener będzie do niego\nprzyciągany, prawda?\r</language>
	</row>
	<row id="msg_0483_T06_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Muszę już iść.\nOby nasze drogi znów się skrzyżowały.\r</language>
	</row>
</body>
