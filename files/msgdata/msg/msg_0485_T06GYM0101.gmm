<?xml version="1.0"?>
<body language="English">
	<row id="msg_0485_T06GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porucznik Surge: Hej, ty smyku!\rRzucanie mi wyzwania może nie jest\nzbyt mądre, ale wymaga odwagi!\rJeśli chodzi o Pokémony typu\nElektryczny, jestem numerem jeden!\rNigdy nie przegrałem na polu bitwy.\rPorażę cię tak, jak wszystkich moich\nwrogów w walce!\r</language>
	</row>
	<row id="msg_0485_T06GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porucznik Surge: Arrrgh!\nJesteś silny/a!\rDobra, dzieciaku.\nDostajesz Odznakę Pioruna!\r</language>
	</row>
	<row id="msg_0485_T06GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nOdznakę Pioruna od Porucznika Surge’a!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porucznik Surge: Ta Odznaka Pioruna\npasuje tym, którzy mnie pokonali!\fZadbaj o nią dobrze, dobra?\rJest jeszcze coś.\nMasz świetne TM dla siebie!\r</language>
	</row>
	<row id="msg_0485_T06GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porucznik Surge: To TM zawiera\nFalę Wstrząsową... Zzzap!\rUżyj go, żeby ruszyć jak błyskawica!\rGdy pójdziesz na północ, zobaczysz\nwielkie miasto zwane Saffron!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porucznik Surge: Hej, dzieciaku!\nWciąż walczysz i parujesz jak lokomotywa?\rGdy pójdziesz na północ, zobaczysz\nwielkie miasto zwane Saffron!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo! Przyszła legendo!\nTym razem miałeś/aś farta.\rPułapki w tej Sali były nieczynne\nod jakiegoś czasu.\rAle teraz znów działają\ni funkcjonują!\fMoże spytasz, czemu to farta...\rBo dzięki temu możesz lepiej\nsię wytrenować!\rZdecyduj się i ruszaj na Porucznika Surge’a!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uff! To był elektryzujący pojedynek!\nAż mnie ciarki przeszły.</language>
	</row>
	<row id="msg_0485_T06GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nic z tego! Nic tu poza śmieciami.</language>
	</row>
	<row id="msg_0485_T06GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\nOch, znalazłeś/aś tajny przełącznik\nna dnie kosza na śmieci!\fLepiej go naciśnij.</language>
	</row>
	<row id="msg_0485_T06GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nic z tego! Nic tu poza śmieciami.\nOch nie, elektryczny płot znów jest\fzablokowany!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwszy elektryczny płot jest odblokowany!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drugi elektryczny płot jest\nodblokowany!\rTeraz elektryczne płoty zniknęły,\na droga do Lidera jest wolna!</language>
	</row>
	<row id="msg_0485_T06GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Vermilion City</language>
	</row>
	<row id="msg_0485_T06GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Vermilion City\rLider Sali: Porucznik Surge\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
