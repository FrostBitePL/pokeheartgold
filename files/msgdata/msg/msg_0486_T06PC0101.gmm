<?xml version="1.0"?>
<body language="English">
	<row id="msg_0486_T06PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śpiący Pokémon leży na środku\ndrogi.\rTo fantastyczna okazja, by go\nzłapać, ale jak go obudzić?</language>
	</row>
	<row id="msg_0486_T06PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kiedyś śpiący Pokémon leżał\nna środku drogi.\fAle wygląda na to, że zniknął.</language>
	</row>
	<row id="msg_0486_T06PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fast Ship to świetne miejsce, by\nspotkać Trenerów i z nimi walczyć.</language>
	</row>
	<row id="msg_0486_T06PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och? Masz jakieś Odznaki, których\nnigdy wcześniej nie widziałem.\rAch, rozumiem. Zdobyłeś/aś je w Johto.</language>
	</row>
</body>
