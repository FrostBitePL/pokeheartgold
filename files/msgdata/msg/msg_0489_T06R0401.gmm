<?xml version="1.0"?>
<body language="English">
	<row id="msg_0489_T06R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiesz coś o Magnetycznym Pociągu?\rTo linia kolejowa, która łączy\nKanto i Johto.</language>
	</row>
	<row id="msg_0489_T06R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Saffron! Saffron!\nChcę pojechać do Saffron City,\fżeby zobaczyć Magnetyczny Pociąg.\rMagnetyczny Pociąg!</language>
	</row>
</body>
