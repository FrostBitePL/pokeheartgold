<?xml version="1.0"?>
<body language="English">
	<row id="msg_0491_T07_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To mój zaufany kumpel, POLIWRATH.\rCiekawe, czy pewnego dnia stanie się\nPokémonem-Żabą.</language>
	</row>
	<row id="msg_0491_T07_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">POLIWRATH: Poli poli!</language>
	</row>
	<row id="msg_0491_T07_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej!\nGapiłeś/aś się na mnie?\rWidziałeś/aś, jak wychodzę z Game\nCorner z całą stertą Monet...\fI uśmiecham się sam do siebie?\fWidziałeś/aś, prawda?</language>
	</row>
	<row id="msg_0491_T07_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GRIMER zaczęły się ostatnio pojawiać.\nWidzisz ten staw przed domem?\rTam też są GRIMERY.\nCiekawe, skąd się wzięły.\rWestchnienie...</language>
	</row>
	<row id="msg_0491_T07_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha ha! Ta Sala jest świetna!\nJest pełna silnych Trenerów!</language>
	</row>
	<row id="msg_0491_T07_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdradzę ci sekret!\rW Celadon Condominiums są miejsca,\ndo których można dotrzeć tylko windą\fna drugim piętrze!</language>
	</row>
	<row id="msg_0491_T07_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W tamtej restauracji odbywa się\nkonkurs jedzenia.\rSłyszałem, że w tym roku mamy\nświetnego uczestnika z regionu\fSinnoh.</language>
	</row>
	<row id="msg_0491_T07_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celadon Department Store oferuje\nnajszerszy wybór przedmiotów!\fMożesz kupić wszystko, czego\fchcesz!\r...Czy brzmię jak ich\nprzedstawiciel handlowy?</language>
	</row>
	<row id="msg_0491_T07_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbiam takie miejsca, gdzie\njest dużo budynków!\rSłyszałem, że w Johto też jest\nmiasto zwane Goldenrod, gdzie\fjest wiele wysokich budynków.\fChciałbym je kiedyś odwiedzić.</language>
	</row>
	<row id="msg_0491_T07_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Cześć, Jasmine. Słyszałam, że\nWhitney z Sali w Goldenrod powiedziała,\fże jesteś zbyt prosta i powinnaś\fwyglądać bardziej wystrojenie.\fCzy to prawda?\r</language>
	</row>
	<row id="msg_0491_T07_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Tak...\rMyślę, że może powinnam wziąć\nudział w tym Konkursie w Sinnoh,\fżeby spróbować być bardziej\fpromienna...\r</language>
	</row>
	<row id="msg_0491_T07_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Jak poszło?\r</language>
	</row>
	<row id="msg_0491_T07_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Nie mogłam się zmusić,\nżeby pójść na Konkurs.\r</language>
	</row>
	<row id="msg_0491_T07_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Ach, rozumiem...\rWięc może spróbuj założyć\ncoś wyjątkowo olśniewającego?\r</language>
	</row>
	<row id="msg_0491_T07_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Ach, tak!\nMoże zdołam się zmusić,\fżeby wziąć udział w Konkursie!\r</language>
	</row>
	<row id="msg_0491_T07_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: A może wystawny, jasnoniebieski\nstrój z peleryną na wierzchu?\r</language>
	</row>
	<row id="msg_0491_T07_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Co?\nTo zbyt żenujące!\r</language>
	</row>
	<row id="msg_0491_T07_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Rozumiem.\nMyślisz, że Clair z Blackthorn jest\ftrochę żenująca...\fJa tylko notuję.\r</language>
	</row>
	<row id="msg_0491_T07_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Och, nie!\nErika, nie to miałam na myśli!</language>
	</row>
	<row id="msg_0491_T07_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Cześć, {STRVAR_1 3, 0, 0}.\rChcesz wymienić się\nnumerami? {YESNO 0}</language>
	</row>
	<row id="msg_0491_T07_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Erikę\nw Pokégearze!</language>
	</row>
	<row id="msg_0491_T07_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Często mam wolne w niedzielne\nporanki.\rZadzwoń wtedy do mnie.</language>
	</row>
	<row id="msg_0491_T07_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Ach, jaka szkoda...</language>
	</row>
	<row id="msg_0491_T07_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Chcesz wymienić się\nnumerami? {YESNO 0}</language>
	</row>
	<row id="msg_0491_T07_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Cześć!\nMiło cię tu widzieć.\rMoże zrobimy sobie razem\nzdjęcie? {YESNO 0}</language>
	</row>
	<row id="msg_0491_T07_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Spróbuj wyglądać fajnie.\r</language>
	</row>
	<row id="msg_0491_T07_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Dobra robota.\nWygląda świetnie!</language>
	</row>
	<row id="msg_0491_T07_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika: Ach, jaka szkoda...</language>
	</row>
	<row id="msg_0491_T07_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Album Zdjęć jest pełny.\rWejdź do PC i usuń\njakieś zdjęcia.</language>
	</row>
	<row id="msg_0491_T07_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Amphy ma się dobrze dzięki tobie.</language>
	</row>
	<row id="msg_0491_T07_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celadon City\nMiasto Barw Tęczy</language>
	</row>
	<row id="msg_0491_T07_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Celadon City\nLiderka: Erika\fKsiężniczka Kochająca Naturę!</language>
	</row>
	<row id="msg_0491_T07_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znajdź to, czego potrzebujesz,\nw Celadon Dept. Store!</language>
	</row>
	<row id="msg_0491_T07_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celadon Condominiums</language>
	</row>
	<row id="msg_0491_T07_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celadon Game Corner\nFajne Miejsce dla Każdego</language>
	</row>
	<row id="msg_0491_T07_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porady dla Trenerów\rGuard Spec. chroni Pokémony\nprzed atakami obniżającymi\fstatystyki podczas walki.\rZdobądź swoje przedmioty\nw Celadon Dept. Store!</language>
	</row>
</body>
