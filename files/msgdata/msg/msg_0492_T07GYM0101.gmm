<?xml version="1.0"?>
<body language="English">
	<row id="msg_0492_T07GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bartek: Witaj...\nPrzyjemna pogoda, prawda?\rTak przyjemnie...\nObawiam się, że mogłabym zdrzemnąć\fsię...\rNazywam się Bartek.\nJestem Liderką Sali w Świebodzicach.\r...Och? Mówisz, że jesteś z Regionu\fŻarów? Jak miło...\rOch. Przepraszam, nie zdawałam sobie\nsprawy, że chcesz rzucić mi wyzwanie.\rWiem.\rTrenowałam się nie tylko\nw układaniu kwiatów, ale też\fw walkach Pokémonów.\rNie przegram.\r</language>
	</row>
	<row id="msg_0492_T07GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bartek: Ach!\nUznaję porażkę...\rJesteś niezwykle silny/a...\nDam ci Tęczową Odznakę...\r</language>
	</row>
	<row id="msg_0492_T07GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nTęczową Odznakę.</language>
	</row>
	<row id="msg_0492_T07GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bartek: To był zachwycający\npojedynek. Czułam się zainspirowana.\rProszę, chciałabym, żebyś dostał/a\nto TM19 jako szczególny podarunek.\rTo Drenaż Gigantyczny.\nTo wspaniały atak, który wysysa\fpołowę zadanych obrażeń, by uleczyć\ftwojego Pokémona.\rTo rzeczywiście przerażający atak.\r</language>
	</row>
	<row id="msg_0492_T07GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bartek: Przegrana zostawia\ngorzki posmak...\rAle świadomość, że są silni Trenerzy,\nmotywuje mnie, bym była lepsza...</language>
	</row>
	<row id="msg_0492_T07GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Świebodzicach</language>
	</row>
	<row id="msg_0492_T07GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Świebodzicach\rLider Sali: Bartek\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
