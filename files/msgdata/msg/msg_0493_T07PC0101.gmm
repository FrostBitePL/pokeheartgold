<?xml version="1.0"?>
<body language="English">
	<row id="msg_0493_T07PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokégear, który masz--\njest zbyt fajny!\rCzy to...najnowszy model?</language>
	</row>
	<row id="msg_0493_T07PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Erika jest mistrzynią Pokémonów\ntypu Trawiasty.\rZapłacisz za to, jeśli się\nnie przypilnujesz.</language>
	</row>
	<row id="msg_0493_T07PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Game Corner w tym mieście kiedyś\nbyło prowadzone przez Team Rocket...\rAle gdy usunięto Team Rocket, ten\nbogaty, uwielbiający gry mężczyzna\fodnowił Game Corner dla samej\ffrajdy.</language>
	</row>
</body>
