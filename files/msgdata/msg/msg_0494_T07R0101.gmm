<?xml version="1.0"?>
<body language="English">
	<row id="msg_0494_T07R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj! Zapraszamy do Celadon\nDepartment Store!\rWykaz pięter jest na ścianie obok\nwindy.</language>
	</row>
	<row id="msg_0494_T07R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten dom towarowy jest częścią tej\nsamej sieci co ten w Goldenrod City.\rOba zostały odnowione w tym\nsamym czasie.</language>
	</row>
	<row id="msg_0494_T07R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To mój pierwszy raz tutaj.\nJest taki wielki...\fBoję się, że się zgubię.</language>
	</row>
	<row id="msg_0494_T07R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1P: Punkt Obsługi\n2P: Rynek Trenera\f3P: Sklep z TM\f4P: Prezenty Mędrca\f5P: Kolekcja Bitewna\f6P: Atrium na Dachu</language>
	</row>
</body>
