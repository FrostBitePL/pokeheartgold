<?xml version="1.0"?>
<body language="English">
	<row id="msg_0495_T07R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dopiero niedawno zostałem Trenerem.\fZachęcił mnie do tego mój syn.\rJestem pod wrażeniem wyboru\nprzydatnych przedmiotów.</language>
	</row>
	<row id="msg_0495_T07R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój tata ma trudności z zapamiętaniem\nnazw przedmiotów i tego, jak mają\fbyć używane...</language>
	</row>
	<row id="msg_0495_T07R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przedmioty Najwyższej Klasy dla\nTrenerów! 2P: Rynek Trenera</language>
	</row>
	<row id="msg_0495_T07R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: Hmm... Hmm... Hmmm...\r</language>
	</row>
	<row id="msg_0495_T07R0102_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: Ha! To jest niezła maska...\r</language>
	</row>
	<row id="msg_0495_T07R0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: Huh? Mówisz do mnie?\rTwoje oczy...są utkwione\nw mojej masce Crasher Wake?\rNie, nie, nie!\nNigdy się jej nie pozbędę!\r...\nHuh? To nie to?\fChcesz tę drugą maskę?\rHmm.\nDobrze.\r</language>
	</row>
	<row id="msg_0495_T07R0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: Co?\nTo nie wystarczy?\rJesteś niezłym negocjatorem jak\nna swój wiek... Dobra, dam ci też to!\r</language>
	</row>
	<row id="msg_0495_T07R0102_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: ...\rArrr, dobra, dobra! Dam ci\nrównież tę, bardzo cenną!\r</language>
	</row>
	<row id="msg_0495_T07R0102_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: W porządku.\nJuż za ciebie zapłaciłem.\rPrezenty dla ciebie od tego,\nkto najlepiej nosi maski.\fNie krępuj się.\fHa ha ha!\r</language>
	</row>
	<row id="msg_0495_T07R0102_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wake: Hmm... Hmm... Hmmm...\rHa! To jest niezła maska...</language>
	</row>
</body>
