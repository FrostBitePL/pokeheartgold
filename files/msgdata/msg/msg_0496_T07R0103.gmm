<?xml version="1.0"?>
<body language="English">
	<row id="msg_0496_T07R0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę się zdecydować, na którym\nPokémonie użyć tego TM...</language>
	</row>
	<row id="msg_0496_T07R0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej! Wymieniłem się moim Pokémonem,\nnie zdejmując z niego Up-Grade.</language>
	</row>
	<row id="msg_0496_T07R0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak! W końcu zdobędę PORYGONA!\rNie jestem dobry w grze o Monety,\nwięc nigdy nie mogłem zdobyć ich\fwystarczająco...\r...Huh?\rWymieniłem się PORYGONEM, a on\nzmienił się w innego Pokémona!</language>
	</row>
	<row id="msg_0496_T07R0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sklep z TM sprzedaje\nkilka rzadkich ataków.</language>
	</row>
	<row id="msg_0496_T07R0103_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wzmocnij Swojego Pokémona!\n3P: Sklep z TM</language>
	</row>
</body>
