<?xml version="1.0"?>
<body language="English">
	<row id="msg_0497_T07R0104_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Ze wszystkich Trenerów na\nświecie, najlepszym musi być\fmój tata.\r</language>
	</row>
	<row id="msg_0497_T07R0104_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Ha!\nNic nie wiesz!\rNajlepszym Trenerem na świecie jest\nKoga, jeden z Elitarnej Czwórki!\fA konkretnie--mój tata!\r</language>
	</row>
	<row id="msg_0497_T07R0104_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Mylisz się.\nMój tata traktuje Poké...\r</language>
	</row>
	<row id="msg_0497_T07R0104_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Proszę, przestań!\nCzemu po prostu nie przyznasz, że\fmój tata jest prawdziwym Trenerem!\r</language>
	</row>
	<row id="msg_0497_T07R0104_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Słuchałeś/aś, prawda?\nZgadzasz się, że mój tata jest\flepszy, prawda? {YESNO 0}</language>
	</row>
	<row id="msg_0497_T07R0104_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Zgadzasz się?\nWłaśnie tak myślałem!\rWiesz co?\nJestem pewien, że polubimy rozmowy\fo moim tacie!\fOto mój numer!\r</language>
	</row>
	<row id="msg_0497_T07R0104_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Falknera\nw Pokégearze!</language>
	</row>
	<row id="msg_0497_T07R0104_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Zadzwoń do mnie w sobotni\nporanek, jeśli chcesz posłuchać\fo moim tacie!</language>
	</row>
	<row id="msg_0497_T07R0104_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Nie zgadzasz się?\nMyślałem, że jesteś mądrzejszy/a.\rCóż.\fW końcu zmienisz zdanie.</language>
	</row>
	<row id="msg_0497_T07R0104_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Więc zmieniłeś/aś zdanie.\nTeraz myślisz, że mój tata jest\flepszy? {YESNO 0}</language>
	</row>
	<row id="msg_0497_T07R0104_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Hej, może zrobimy sobie\nrazem zdjęcie? {YESNO 0}</language>
	</row>
	<row id="msg_0497_T07R0104_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Dobrze!\nJesteś gotowy/a?\r</language>
	</row>
	<row id="msg_0497_T07R0104_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: Tak!\nDobrze wyglądamy.</language>
	</row>
	<row id="msg_0497_T07R0104_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner: W porządku.\nZrobię sobie jedno z moim tatą...</language>
	</row>
	<row id="msg_0497_T07R0104_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Album Zdjęć jest pełny.\rWejdź do PC i usuń\njakieś zdjęcia.</language>
	</row>
	<row id="msg_0497_T07R0104_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Ba!</language>
	</row>
	<row id="msg_0497_T07R0104_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem tu, żeby kupić Bloom Mail\ndo wysłania mojej dziewczynie.</language>
	</row>
	<row id="msg_0497_T07R0104_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiesz co?\rTunnel Mail jest wreszcie dostępne\nw tym domu towarowym!\rWcześniej sprzedawano je\ntylko w Violet City.</language>
	</row>
	<row id="msg_0497_T07R0104_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prezenty, by Wyrazić Siebie!\n4P: Prezenty Mędrca</language>
	</row>
</body>
