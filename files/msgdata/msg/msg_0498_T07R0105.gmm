<?xml version="1.0"?>
<body language="English">
	<row id="msg_0498_T07R0105_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcę kupić przedmioty podnoszące\nstatystyki Pokémonów, ale nie mam\fwystarczająco pieniędzy...</language>
	</row>
	<row id="msg_0498_T07R0105_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znasz PP UP?\rPodnosi maksymalne PP ataków.\rMyślałem, że znajdę je tutaj,\nale podobno nie da się go kupić...\fA niech to!</language>
	</row>
	<row id="msg_0498_T07R0105_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używanie na nich przedmiotów\nuszczęśliwia Pokémony.\fNiektórych przedmiotów jednak nienawidzą...</language>
	</row>
	<row id="msg_0498_T07R0105_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydobądź Potencjał Pokémona\n5P: Kolekcja Bitewna</language>
	</row>
</body>
