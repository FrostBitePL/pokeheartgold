<?xml version="1.0"?>
<body language="English">
	<row id="msg_0499_T07R0106_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Automat z ruletką\nnagród...\rCieszysz się, gdy dostajesz coś\nza darmo, nawet jeśli jest warte\ftylko $200.\rSzczęście nie wynika z tego,\nile rzeczy są warte.\rZależy to od serca tego, kto\nje otrzymuje...</language>
	</row>
	<row id="msg_0499_T07R0106_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww! Nie ma tu żadnych gier!\nChciałem zagrać...</language>
	</row>
	<row id="msg_0499_T07R0106_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrób sobie przerwę przy automatach\n6P: Atrium na Dachu</language>
	</row>
	<row id="msg_0499_T07R0106_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To automat z napojami.\nKtóry napój chcesz? {YESNO 0}</language>
	</row>
	<row id="msg_0499_T07R0106_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brzdęk!\rWypadła puszka {STRVAR_1 8, 0, 0}.\r</language>
	</row>
	<row id="msg_0499_T07R0106_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brzdęk!\rBonus! Wypadła kolejna puszka\n{STRVAR_1 8, 0, 0}.\r</language>
	</row>
	<row id="msg_0499_T07R0106_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Za mało pieniędzy...</language>
	</row>
	<row id="msg_0499_T07R0106_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Postanowiono nie kupować napoju.</language>
	</row>
</body>
