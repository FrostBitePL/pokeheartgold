<?xml version="1.0"?>
<body language="English">
	<row id="msg_0500_T07R0107_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj.\rNa które piętro mam cię zabrać? {YESNO 0}</language>
	</row>
	<row id="msg_0500_T07R0107_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekam, aż będę mógł znów ci służyć.</language>
	</row>
	<row id="msg_0500_T07R0107_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczywiście.\nWinda jedzie w górę!\r</language>
	</row>
	<row id="msg_0500_T07R0107_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczywiście.\nWinda jedzie w dół!\r</language>
	</row>
	<row id="msg_0500_T07R0107_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh... Już tam jesteśmy?</language>
	</row>
	<row id="msg_0500_T07R0107_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na pierwszym piętrze jest Punkt Obsługi\ni główne wejście.</language>
	</row>
	<row id="msg_0500_T07R0107_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na drugim piętrze jest Rynek Trenera,\ngdzie możesz kupić wszystko, czego\fpotrzebujesz.</language>
	</row>
	<row id="msg_0500_T07R0107_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na trzecim piętrze jest Sklep z TM,\nby wzmocnić twoje Pokémony.</language>
	</row>
	<row id="msg_0500_T07R0107_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na czwartym piętrze są Prezenty\nMędrca, gdzie znajdziesz idealne\fpodarunki.</language>
	</row>
	<row id="msg_0500_T07R0107_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na piątym piętrze jest Kolekcja\nBitewna, by podnieść statystyki.</language>
	</row>
	<row id="msg_0500_T07R0107_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na szóstym piętrze jest Atrium na\nDachu na miłą przerwę.</language>
	</row>
</body>
