<?xml version="1.0"?>
<body language="English">
	<row id="msg_0501_T07R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czegoś potrzebujesz?\nJestem zarządcą tych apartamentów.\rJest tu dość bezpiecznie, więc\nnie mam za wiele do roboty.\rLubię wyprowadzać swojego Pokémona,\nżeby czymś się zająć.\r...Swoją drogą, mamy tu dwie\nwindy.\fNie pomyl się.</language>
	</row>
	<row id="msg_0501_T07R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MEOWTH: Meow!</language>
	</row>
	<row id="msg_0501_T07R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CLEFAIRY: Clef cleff!</language>
	</row>
	<row id="msg_0501_T07R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NIDORAN♀: Kya kyaoo!</language>
	</row>
	<row id="msg_0501_T07R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę, skorzystaj z tej windy,\nby dostać się na trzecie piętro.</language>
	</row>
</body>
