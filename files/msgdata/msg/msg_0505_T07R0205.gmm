<?xml version="1.0"?>
<body language="English">
	<row id="msg_0505_T07R0205_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozwól, że opowiem ci przerażającą\nhistorię...\r</language>
	</row>
	<row id="msg_0505_T07R0205_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z drugiej strony, nie jest tak\nstraszna, gdy na zewnątrz jest\fjeszcze jasno.\rWróć po zachodzie słońca, dobra?</language>
	</row>
	<row id="msg_0505_T07R0205_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawno, dawno temu żył sobie mały\nchłopiec, któremu podarowano nowy\fRower...\fChciał go od razu wypróbować...\rBawił się tak dobrze, że nie\nzauważył, że zrobiło się już\fciemno...\rGdy jechał do domu w kompletnie\nczarnej nocy, Rower nagle\fzwolnił!\rPedały zrobiły się ciężkie!\rRower zaczął się cofać, jakby\nktoś go ciągnął!\rWyglądało to tak, jakby Rower był\nprzeklęty i próbował wciągnąć go\fw zapomnienie!\r...\r...\rŁŁŁAAA!\rChłopiec jechał pod górę\nna Cycling Road!\r...\nBa-dum, ba-dum!\rZa tak cierpliwe wysłuchanie, weź\nsobie ten przedmiot--Spell Tag!\r</language>
	</row>
	<row id="msg_0505_T07R0205_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spell Tag wzmacnia moc ataków\ntypu Duch.\rNie spowolni twojego Roweru,\nwięc się nie martw!</language>
	</row>
</body>
