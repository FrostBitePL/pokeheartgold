<?xml version="1.0"?>
<body language="English">
	<row id="msg_0506_T07R0206_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta winda jest tylko dla Game Freak.\rProszę, wybierz piętro, na które\nchcesz się udać. {YESNO 0}</language>
	</row>
	<row id="msg_0506_T07R0206_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszamy ponownie.</language>
	</row>
	<row id="msg_0506_T07R0206_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jedziemy w górę.\r</language>
	</row>
	<row id="msg_0506_T07R0206_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jedziemy w dół.\r</language>
	</row>
	<row id="msg_0506_T07R0206_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Już tam jesteśmy.</language>
	</row>
	<row id="msg_0506_T07R0206_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotarłeś/aś na pierwsze piętro.\r</language>
	</row>
	<row id="msg_0506_T07R0206_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotarłeś/aś na trzecie piętro--\nGame Freak.\r</language>
	</row>
	<row id="msg_0506_T07R0206_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotarłeś/aś na dach.\r</language>
	</row>
</body>
