<?xml version="1.0"?>
<body language="English">
	<row id="msg_0507_T07R0207_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celadon Condominiums\nTa winda jeździ bezpośrednio\fna dach.\rChcesz jechać na dach? {YESNO 0}</language>
	</row>
	<row id="msg_0507_T07R0207_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celadon Condominiums\nTa winda jeździ bezpośrednio\fna drugie piętro.\rChcesz jechać na drugie piętro? {YESNO 0}</language>
	</row>
	<row id="msg_0507_T07R0207_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszamy ponownie.</language>
	</row>
	<row id="msg_0507_T07R0207_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jedziemy w górę, na dach.\r</language>
	</row>
	<row id="msg_0507_T07R0207_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jedziemy w dół, na drugie piętro.\r</language>
	</row>
	<row id="msg_0507_T07R0207_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotarłeś/aś na dach.\r</language>
	</row>
	<row id="msg_0507_T07R0207_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotarłeś/aś na drugie piętro.\r</language>
	</row>
</body>
