<?xml version="1.0"?>
<body language="English">
	<row id="msg_0509_T07R0501_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałem PORYGONA, ale brakowało\nmi 100 Monet...</language>
	</row>
	<row id="msg_0509_T07R0501_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uff...\rMuszę zachować spokój i opanowanie...\rNie mogę stracić zimnej krwi.\nJeśli spędzę tu cały mój czas na\fgraniu, mogę mieć kłopoty w domu.</language>
	</row>
	<row id="msg_0509_T07R0501_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obudziłem się i odkryłem swój\npotencjał!\rWięc, jaki potencjał się we mnie\nobudził? Pytasz, jaka jest moja\fukryta moc?\rTo moc, która pozwala mi widzieć\nMoc Ukrytą Pokémona.\rGdy się jej uczą, mogę powiedzieć,\njakiego typu będzie ten atak.\rWięc, chcesz, żebym użył swojej\nukrytej mocy?\rPowiem ci, jakiego typu będzie\nMoc Ukryta twojego Pokémona. {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powiem ci, jakiego typu będzie\nMoc Ukryta twojego Pokémona.\rMoja własna ukryta moc pozwala\nmi to zrobić. {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdyby ten Pokémon miał nauczyć się\nMocy Ukrytej, atak byłby\ftypu {STRVAR_1 15, 0, 0}.</language>
	</row>
	<row id="msg_0509_T07R0501_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moc Ukryta tego Pokémona jest\ntypu {STRVAR_1 15, 0, 0}.</language>
	</row>
	<row id="msg_0509_T07R0501_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chcesz wiedzieć, zapytaj mnie,\na uruchomię dla ciebie swoją\fukrytą moc.</language>
	</row>
	<row id="msg_0509_T07R0501_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, którego może nauczyć się\nJajko?! To po prostu niemożliwe.</language>
	</row>
	<row id="msg_0509_T07R0501_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie. Ten Pokémon w ogóle\nnie może nauczyć się ataku Moc Ukryta.</language>
	</row>
	<row id="msg_0509_T07R0501_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj!\rWymieniamy twoje Monety na\nwspaniałe nagrody! {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze. Zbieraj swoje Monety\ni wróć ponownie!</language>
	</row>
	<row id="msg_0509_T07R0501_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam! Potrzebujesz więcej\nMonet. {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 8, 0, 0}.\nCzy to się zgadza? {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę bardzo!\r</language>
	</row>
	<row id="msg_0509_T07R0501_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam. Nie możesz nieść już\nwięcej.\r</language>
	</row>
	<row id="msg_0509_T07R0501_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja drużyna jest pełna!\nProszę, zrób trochę miejsca,\fzanim wrócisz.</language>
	</row>
	<row id="msg_0509_T07R0501_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz {STRVAR_1 0, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\n{STRVAR_1 0, 1, 0}! {YESNO 0}</language>
	</row>
	<row id="msg_0509_T07R0501_00018" index="18">
