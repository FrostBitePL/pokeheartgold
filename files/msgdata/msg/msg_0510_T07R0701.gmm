<?xml version="1.0"?>
<body language="English">
	<row id="msg_0510_T07R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć!\rOrganizujemy maraton jedzenia.\nNie możemy cię teraz obsłużyć.\fPrzepraszamy.</language>
	</row>
	<row id="msg_0510_T07R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Puff... Puff... Chrup... Chrup...\nPuff... Puff... Chrup... Chrup...\rJeśli chodzi o konkursy jedzenia,\njestem dość pewny siebie.\rAle nie radzę sobie z gorącym\njedzeniem. Jeśli muszę jeść szybko,\fmoje usta...\fGorąco, gorąco, gorąco!\r</language>
	</row>
	<row id="msg_0510_T07R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Am, żuj, chrup...\n(Proszę, nie rozmawiaj teraz ze mną!)\rAm, żuj, kaszl...\n(Jedzenie zaraz wyleci mi z ust...)\r</language>
	</row>
	<row id="msg_0510_T07R0701_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chrup chrup chrup...\n...Co? To jest maraton jedzenia?\rAu!\rMyślałem, że to konkurs\nszybkiego jedzenia...\r</language>
	</row>
	<row id="msg_0510_T07R0701_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chrup... Chrup...\rMogę jeść dalej!\nWięcej, szefie kuchni!\r</language>
	</row>
	<row id="msg_0510_T07R0701_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chrup... Chrup...\rMogę jeść dalej!\nWięcej, szefie kuchni!\r</language>
	</row>
	<row id="msg_0510_T07R0701_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maylene: Chrup chrup chrup...\nMaraton jedzenia!\rNigdy nie śniło mi się coś\ntak wspaniałego.\rPo surowej diecie podczas treningu,\nmogę jeść jak HIPPOWDON.\rZwycięzca też je za darmo.\nTo po prostu spełnienie marzeń!\r</language>
	</row>
	<row id="msg_0510_T07R0701_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maraton Jedzenia!\nBrak limitu czasu!\fWalka bez końca!\rNajwiększy żarłok dostaje\nwszystko za darmo!</language>
	</row>
</body>
