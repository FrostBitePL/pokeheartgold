<?xml version="1.0"?>
<body language="English">
	<row id="msg_0512_T08_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden z Elitarnej Czwórki był kiedyś\nLiderem Sali w Fuchsia.</language>
	</row>
	<row id="msg_0512_T08_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Córka Kogi przejęła po nim funkcję\nLidera Sali, gdy dołączył on\fdo Elitarnej Czwórki.</language>
	</row>
	<row id="msg_0512_T08_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Safari Zone przez jakiś czas\nbyło zamknięte.\rPotem, zanim się zorientowałem,\nprzeniosło się do Johto.\fTo smutne...\rByło główną atrakcją tego miasta.</language>
	</row>
	<row id="msg_0512_T08_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fuchsia City\nMiasto Zdarzeń i Przemijania</language>
	</row>
	<row id="msg_0512_T08_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Fuchsia City\nLiderka: Janine\fTrująca Mistrzyni Ninja</language>
	</row>
	<row id="msg_0512_T08_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest tu ogłoszenie...\rSafari Zone jest zamknięte.\fZamiast tego, mamy Pal Park.</language>
	</row>
	<row id="msg_0512_T08_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dom Strażnika Pal Park</language>
	</row>
	<row id="msg_0512_T08_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skorupa za Jagodę!\nSkorupa za Jagodę!\rTak, tak!\nJa wymieniam Jagodę za Skorupę.\rJeśli przyniesiesz mi jakieś Skorupy,\ndam ci trzy Jagody, tak!\r</language>
	</row>
	<row id="msg_0512_T08_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skorupa za Jagodę!\nSkorupa za Jagodę!\rTak, tak!\nJa wymieniam Jagodę za Skorupę.\rJeśli przyniesiesz mi jakieś Skorupy,\ndam ci trzy Jagody, tak!\rKtórą Skorupę wymienisz za\nJagodę? {YESNO 0}</language>
	</row>
	<row id="msg_0512_T08_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więcej Skorup do wymiany za\nJagody? {YESNO 0}</language>
	</row>
	<row id="msg_0512_T08_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, tak!\nWróć, gdy zmienisz\fzdanie, tak!\r</language>
	</row>
	<row id="msg_0512_T08_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci zestaw Jagód E\nza Czerwoną Skorupę, tak!\r</language>
	</row>
	<row id="msg_0512_T08_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci zestaw Jagód F\nza Niebieską Skorupę, tak!\r</language>
	</row>
	<row id="msg_0512_T08_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci zestaw Jagód G\nza Żółtą Skorupę, tak!\r</language>
	</row>
	<row id="msg_0512_T08_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci zestaw Jagód H\nza Zieloną Skorupę, tak!\r</language>
	</row>
	<row id="msg_0512_T08_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz już wiele Jagód\nz tego zestawu.\rWróć, gdy będziesz potrzebować więcej, tak!\r</language>
	</row>
</body>
