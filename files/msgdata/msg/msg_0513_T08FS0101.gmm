<?xml version="1.0"?>
<body language="English">
	<row id="msg_0513_T08FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miałem/-am nadzieję kupić jakieś\npamiątki z Safari Zone, ale jest\fzamknięte!\rMyślałem/-am, że jest tylko\nzamknięte dzisiaj, ale okazuje się,\fże w ogóle go już nie ma!\rNiczego się nie spodziewałem/-am.</language>
	</row>
	<row id="msg_0513_T08FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Safari Zone przeniesiono\ndo Johto...\rSłyszałem, że teraz syn Strażnika\nbędzie prowadził Pal Park!</language>
	</row>
	<row id="msg_0513_T08FS0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłeś/aś już w Pal Park?\rSyn Strażnika Safari Zone\nprowadzi go razem z żoną.\rProwadzenie parków musi być\nu nich rodzinne.</language>
	</row>
</body>
