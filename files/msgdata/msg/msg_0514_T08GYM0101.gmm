<?xml version="1.0"?>
<body language="English">
	<row id="msg_0514_T08GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fufufufu...\nPrzykro mi cię rozczarować...\rŻartuję! Jestem prawdziwa!\rJanine z Sali w Fuchsia, to ja!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Rozumiem... Pokonałeś/aś\nKogę, mojego ojca i członka\fElitarnej Czwórki, żeby tu dotrzeć.\rNic dziwnego, że jesteś silny/a!\rZdecydowanie wygrałeś/aś...\nOto Odznaka Duszy. Weź ją.\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nOdznakę Duszy od Janine!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Jesteś taki/a twardy/a!\nMam specjalny prezent!\rTo Trujący Cios, potężny atak typu\nTrującego, który może zatruć ofiarę.\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Janine: Naprawdę się przyłożę\ni ulepszę swoje umiejętności.\rChcę stać się o wiele lepsza\nzarówno od mojego ojca, jak i od ciebie!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo, przyszła legendo!\nOj! Rozejrzyj się dobrze dookoła.\rWszyscy Trenerzy wyglądają jak\nLiderka Sali, Janine.\rKtóra z nich jest prawdziwą Janine?</language>
	</row>
	<row id="msg_0514_T08GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To była wspaniała walka,\nTrenerze z Johto!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nabrałem/-am cię!\nHahaha!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No i co? Moje przebranie było\nidealne, prawda?</language>
	</row>
	<row id="msg_0514_T08GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wahahaha!\rNo pewnie! Jestem Janine!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się, jestem chłopakiem!\nCo złego w tym, że chłopak\fprzebiera się za Janine?</language>
	</row>
	<row id="msg_0514_T08GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fufufu!\rJestem Janine, Liderka Sali!\fA nie, nie jestem! Nabrałam cię!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nabrałem/-am cię!\nHahaha!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak fajnie jest przebierać się za\nJanine, naszą idolkę!</language>
	</row>
	<row id="msg_0514_T08GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Janine!\nSkąd wiedziałeś/aś, że jestem\fprawdziwa? Do walki!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Albo i nie!\r</language>
	</row>
	<row id="msg_0514_T08GYM0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję się silniejszy/a, przebierając\nsię za Janine.</language>
	</row>
	<row id="msg_0514_T08GYM0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Fuchsia City</language>
	</row>
	<row id="msg_0514_T08GYM0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Fuchsia City\rLiderka: Janine\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
