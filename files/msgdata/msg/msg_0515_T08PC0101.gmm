<?xml version="1.0"?>
<body language="English">
	<row id="msg_0515_T08PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej! Masz Pokédex!\nProfesor Oak ci go dał?</language>
	</row>
	<row id="msg_0515_T08PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miałem/-am niezły szok w Sali.\nByły tam dziewczyny, które\fwyglądały identycznie.</language>
	</row>
	<row id="msg_0515_T08PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Janine! Hokus-pokus...\nPuf!\r</language>
	</row>
	<row id="msg_0515_T08PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? Teraz wyglądam dokładnie\njak ona!\r...?\rHę? Nie zadziałało?</language>
	</row>
</body>
