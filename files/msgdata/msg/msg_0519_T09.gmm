<?xml version="1.0"?>
<body language="English">
	<row id="msg_0519_T09_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kim jesteś?\rNazywam się Blue.\nByłem kiedyś Mistrzem Kanto.\rChoć trwało to krótko, dzięki\nRedowi...\fW każdym razie, rozejrzyj się\ndobrze dookoła...\r</language>
	</row>
	<row id="msg_0519_T09_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blue: Wulkan wybucha i po prostu\ntak, całe miasto znika.\rMożemy dalej wygrywać i przegrywać\nw walkach Pokémonów, ale jeśli\fprzyroda choćby drgnie, w sekundę\fmoże nas przytłoczyć...\rTak to już jest...\nAle i tak, wciąż jestem Trenerem.\rGdy widzę silnego przeciwnika,\nmam ochotę walczyć.\r</language>
	</row>
	<row id="msg_0519_T09_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chcesz ze mną walczyć...\nnaprawdę, przyjdź do Sali\fw Viridian.\r</language>
	</row>
	<row id="msg_0519_T09_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będę na ciebie czekać!\r</language>
	</row>
	<row id="msg_0519_T09_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chcesz ze mną walczyć...\nnaprawdę, pokaż mi, ile Odznak\fz Kanto zdobyłeś/aś.\r...\n{STRVAR_1 50, 0, 0}...\rNie jesteś gotowy/a, żeby ze mną\nwalczyć...</language>
	</row>
	<row id="msg_0519_T09_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blue: Jesteś naprawdę niezły/a!\nPokonałeś/aś Reda!?\fŚwietnie!\rZróbmy sobie razem zdjęcie! {YESNO 0}</language>
	</row>
	<row id="msg_0519_T09_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blue: Dobrze!\r</language>
	</row>
	<row id="msg_0519_T09_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blue: Dzięki za fajne zdjęcie!</language>
	</row>
	<row id="msg_0519_T09_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blue: Ech, no cóż...</language>
	</row>
	<row id="msg_0519_T09_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Album ze Zdjęciami jest pełny.\rUzyskaj dostęp do swojego PC\ni usuń jakieś zdjęcia.</language>
	</row>
	<row id="msg_0519_T09_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blaine: Nigdy się nie poddam, aż\ndo dnia, gdy odbuduję Salę\fw Cinnabar!\rMoże wymienimy się numerami! {YESNO 0}</language>
	</row>
	<row id="msg_0519_T09_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zarejestrował(a)\nBlaine’a w Pokégearze!</language>
	</row>
	<row id="msg_0519_T09_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blaine: Hmmm...\nPowinniśmy móc walczyć\fwe wtorkowe wieczory!</language>
	</row>
	<row id="msg_0519_T09_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blaine: Och...jakie to rozczarowujące!</language>
	</row>
	<row id="msg_0519_T09_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blaine: Wymienimy się\nnumerami? {YESNO 0}</language>
	</row>
	<row id="msg_0519_T09_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blaine: Och, to ty!\nPowiedz, chcesz zrobić sobie\fzdjęcie ze mną właśnie tutaj? {YESNO 0}</language>
	</row>
	<row id="msg_0519_T09_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blaine: Proszę, stań obok mnie!\r</language>
	</row>
	<row id="msg_0519_T09_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blaine: Och, to dobre zdjęcie!</language>
	</row>
	<row id="msg_0519_T09_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blaine: Nieee!</language>
	</row>
	<row id="msg_0519_T09_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Album ze Zdjęciami jest pełny.\rUzyskaj dostęp do swojego PC,\nżeby usunąć jakieś zdjęcia.</language>
	</row>
	<row id="msg_0519_T09_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest tu ogłoszenie...\rSala w Cinnabar została przeniesiona\nna Seafoam Islands.\f           Blaine</language>
	</row>
	<row id="msg_0519_T09_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cinnabar Island\nZniszczone Miasto z Przeszłości</language>
	</row>
</body>
