<?xml version="1.0"?>
<body language="English">
	<row id="msg_0526_T10R0501_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Karen z Elitarnej Czwórki.\rTo ty jesteś {STRVAR_1 3, 0, 0}? Jakie to\nzabawne. Uwielbiam Pokémony typu\fMroczny.\rZnana jestem z moich przytłaczających\ntaktyk.\rMyślisz, że sobie z nimi poradzisz?\nSpróbuj mnie tylko zabawić.\rIdziemy.\r</language>
	</row>
	<row id="msg_0526_T10R0501_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Silny Pokémon.\rSłaby Pokémon.\rTo tylko egoistyczne postrzeganie\nludzi.\rNaprawdę uzdolnieni Trenerzy powinni\nstarać się wygrywać z Pokémonami,\fktóre kochają najbardziej.\rPodoba mi się twój styl.\nRozumiesz, co jest ważne.\rIdź dalej--Mistrz czeka.\r</language>
	</row>
	<row id="msg_0526_T10R0501_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Silny Pokémon.\rSłaby Pokémon.\rTo tylko egoistyczne postrzeganie\nludzi.\rNaprawdę uzdolnieni Trenerzy powinni\nstarać się wygrywać z Pokémonami,\fktóre kochają najbardziej.\rPodoba mi się twój styl.\nRozumiesz, co jest ważne.\rIdź dalej--Mistrz czeka.</language>
