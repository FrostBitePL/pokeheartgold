<?xml version="1.0"?>
<body language="English">
	<row id="msg_0528_T10R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance: Minęło sporo czasu, odkąd\nostatni raz tu byłem.\rTo tutaj upamiętniamy Mistrzów\nLigi na wieczność.\rIch odważne Pokémony również\nzostają uhonorowane.\rTu i dziś, byliśmy świadkami narodzin\nnowego Mistrza Ligi--\rTrenera, który czuje współczucie\ni zaufanie wobec wszystkich Pokémonów.\rTrenera, który odniósł sukces\ndzięki wytrwałości i determinacji.\rNowego Mistrza Ligi, który ma\nwszystko, co potrzeba do wielkości!\r{STRVAR_1 3, 0, 0}, pozwól, że wpiszę ciebie\ni twoich partnerów jako Mistrzów!\r</language>
	</row>
	<row id="msg_0528_T10R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lance: Minęło sporo czasu, odkąd\nostatni raz tu byłem.\rTo tutaj upamiętniamy Mistrzów\nLigi na wieczność.\rIch odważne Pokémony również\nzostają uhonorowane.\rTu i dziś, byliśmy świadkami narodzin\nnowego Mistrza Ligi--\rTrenera, który czuje współczucie\ni zaufanie wobec wszystkich Pokémonów.\rTrenera, który odniósł sukces\ndzięki wytrwałości i determinacji.\rNowego Mistrza Ligi, który ma\nwszystko, co potrzeba do wielkości!\r{STRVAR_1 3, 0, 0}, pozwól, że wpiszę ciebie\ni twoich partnerów jako Mistrzów!\r</language>
	</row>
