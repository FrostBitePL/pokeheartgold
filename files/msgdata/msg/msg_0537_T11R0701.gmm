<?xml version="1.0"?>
<body language="English">
	<row id="msg_0537_T11R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witamy. To budynek głównej\nsiedziby Silph Co.</language>
	</row>
	<row id="msg_0537_T11R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, ty! Ta winda jest teraz\nzepsuta.\rCoś jest nie tak z prądem\ni nie działa poprawnie.\rPrzykro mi, że zmarnowałeś/aś\npodróż, więc oto prezent dla ciebie!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To najnowszy produkt Silph Co.\nNigdzie nie jest jeszcze na sprzedaż.</language>
	</row>
	<row id="msg_0537_T11R0701_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta winda jest zepsuta.\rMoże cię porazić prądem. Trzymaj się\nz dala.</language>
	</row>
	<row id="msg_0537_T11R0701_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0537_T11R0701_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0537_T11R0701_00006" index="6">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0537_T11R0701_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Znów się spotykamy!\nByłeś/aś już kiedyś w Hoenn?\rTo takie piękne miejsce, z\nnajczystszym oceanem, jaki możesz\fsobie wyobrazić.\rPowinieneś/aś tam kiedyś pojechać.\fHej!\rMoże wymienimy się Pokémonami?\rSzukam FORRETRESSA.\nMogę wymienić za niego mojego\fBELDUMA. {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Wymienisz FORRETRESSA\nna mojego BELDUMA? {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Dobrze, wymieniamy się!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Szkoda.</language>
	</row>
	<row id="msg_0537_T11R0701_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Mówisz mi, że myślisz,\nże to jest FORRETRESS?</language>
	</row>
	<row id="msg_0537_T11R0701_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: W regionie Hoenn nie widuje\nsię FORRETRESSA.\rTo pierwszy raz, kiedy naprawdę\njakiegoś widzę. Bardzo dziękuję!\rOch, spójrz na godzinę. Naprawdę\nmuszę już iść.\r</language>
	</row>
	<row id="msg_0537_T11R0701_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Ten Pokémon wydaje się\nbardzo cię lubić. Czy przypadkiem\flubisz Pokémony typu Stalowego?\rMiałem takie przeczucie.\nTa szczególna faktura!\rChłodne, lśniące ciała!\nTakie osobliwości mają tylko\fPokémony typu Stalowego!\rJeśli chodzi o samotność i szlachetność,\nktórą wyczuwasz w tym surowym ciele,\fniemal odpychającym, gdy je\fprzytulisz, nic nie umywa się do\fBELDUMA, muszę przyznać...\rKrótko mówiąc, mój METAGROSS jest\nnaprawdę silny i wspaniały!\r...\nOch, chyba się zapędziłem.\rMiło było z tobą porozmawiać.\nDo zobaczenia!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo...\nZanika sygnał...\fMyślę, że to zależy od tego, jak\fczuje się mój tata.\rRozumiem...\nZaraz jadę. Do zobaczenia wkrótce.\r</language>
	</row>
	<row id="msg_0537_T11R0701_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Ty jesteś...\nPamiętam twoje oczy.\rGdy widzę Trenera, którego oczy\nlśnią, zawsze to zapamiętuję.\r</language>
	</row>
	<row id="msg_0537_T11R0701_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Masz Pokédex!\nWięc ty też poszukujesz Pokémonów.\fPozwól, że zobaczę...\rMyślę, że mogę ci w tym pomóc.\rWyobraź sobie, że masz przed sobą\nkamienie.\fKtóry kolor byś wybrał/a? {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ZIELONY KAMIEŃ</language>
	</row>
	<row id="msg_0537_T11R0701_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CZERWONY KAMIEŃ</language>
	</row>
	<row id="msg_0537_T11R0701_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NIEBIESKI KAMIEŃ</language>
	</row>
	<row id="msg_0537_T11R0701_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Wybrałeś/aś poprawnie!\nDam ci {STRVAR_1 0, 1, 0}!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\n{STRVAR_1 0, 1, 0} od Stevena!</language>
	</row>
	<row id="msg_0537_T11R0701_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Zaopiekuj się nim dobrze.\nTwoja troska o niego bardzo\fmnie ucieszy.\r</language>
	</row>
	<row id="msg_0537_T11R0701_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Rozumiem...\nZa wybór, którego dokonałeś/aś,\fchciałbym dać ci tego Pokémona.\rTylko że twoja drużyna jest pełna.\rMoże pójdziesz do PC, żeby zrobić\nmiejsce? Będę tu czekał.</language>
	</row>
	<row id="msg_0537_T11R0701_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Zapytam ponownie.\nKtóry kolor wybierasz? {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chciałbyś(-abyś) nadać\nprzezwisko {STRVAR_1 0, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0537_T11R0701_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Świetnie mu wymyśliłeś/aś\nimię!\r</language>
	</row>
	<row id="msg_0537_T11R0701_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANULUJ</language>
	</row>
	<row id="msg_0537_T11R0701_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Steven: Wydajesz się być dość\nostrożny/a.\rUnikasz każdej okazji, w której\nktoś mógłby cię oszukać?\fNaprawdę jesteś lepszy/a, niż\fmyślałem.</language>
	</row>
	<row id="msg_0537_T11R0701_00029" index="29">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
