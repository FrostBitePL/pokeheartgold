<?xml version="1.0"?>
<body language="English">
	<row id="msg_0538_T11R0702_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} wszedł(-a) do silnika.\r{STRVAR_1 0, 0, 0} próbuje nauczyć\nsię ataku {STRVAR_1 6, 1, 0}.\rAle {STRVAR_1 0, 0, 0} nie może\nznać więcej niż cztery ataki.\rUsunąć jakiś atak, żeby zrobić\nmiejsce dla {STRVAR_1 6, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrezygnować z nauki ataku\n{STRVAR_1 6, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} nie nauczył(a)\nsię {STRVAR_1 6, 1, 0}.\r{STRVAR_1 0, 0, 0} wyszedł(-a) z silnika.</language>
	</row>
	<row id="msg_0538_T11R0702_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak {STRVAR_1 6, 1, 0} zostanie\nzapomniany. Czy to w porządku? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1,{PAUSE 20} 2,{PAUSE 20} i...{PAUSE 20} ...{PAUSE 20} Puf!</language>
	</row>
	<row id="msg_0538_T11R0702_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} zapomniał(a),\njak używać {STRVAR_1 6, 1, 0}.\rI...</language>
	</row>
	<row id="msg_0538_T11R0702_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0} nauczył(a) się\n{STRVAR_1 6, 1, 0}!</language>
	</row>
	<row id="msg_0538_T11R0702_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Które ROTOM wybierasz?\r</language>
	</row>
	<row id="msg_0538_T11R0702_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jajko nie może wejść do silnika.</language>
	</row>
	<row id="msg_0538_T11R0702_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon nie może wejść do silnika.</language>
	</row>
	<row id="msg_0538_T11R0702_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} wszedł(-a) do silnika.\r</language>
	</row>
	<row id="msg_0538_T11R0702_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} wyszedł(-a) z silnika.\r</language>
	</row>
	<row id="msg_0538_T11R0702_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Które ROTOM przywrócić do\njego pierwotnej formy? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och? ROTOM wygląda, jakby chciał\npowrócić do swojej pierwotnej formy.\rChcesz przywołać go z silnika? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PRZYWOŁAJ</language>
	</row>
	<row id="msg_0538_T11R0702_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TAK</language>
	</row>
	<row id="msg_0538_T11R0702_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NIE</language>
	</row>
	<row id="msg_0538_T11R0702_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To ROTOM nie weszło do silnika.</language>
	</row>
	<row id="msg_0538_T11R0702_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Było tu jakieś urządzenie.\nTo z dziwnie ukształtowanym silnikiem.</language>
	</row>
	<row id="msg_0538_T11R0702_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANULUJ</language>
	</row>
	<row id="msg_0538_T11R0702_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To kuchenka mikrofalowa.\nMa dziwnie ukształtowany silnik.\r</language>
	</row>
	<row id="msg_0538_T11R0702_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To kuchenka mikrofalowa.\nMa dziwnie ukształtowany silnik.\rOch? ROTOM wygląda, jakby chciało\nwejść do silnika.\rPozwolić mu wejść do silnika? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ROTOM niechętnie zrezygnowało z\nwejścia do silnika kuchenki\fmikrofalowej...</language>
	</row>
	<row id="msg_0538_T11R0702_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To lodówka.\nMa dziwnie ukształtowany silnik.\r</language>
	</row>
	<row id="msg_0538_T11R0702_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To lodówka.\nMa dziwnie ukształtowany silnik.\rOch? ROTOM wygląda, jakby chciało\nwejść do silnika.\rPozwolić mu wejść do silnika? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ROTOM niechętnie zrezygnowało z\nwejścia do silnika lodówki...</language>
	</row>
	<row id="msg_0538_T11R0702_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To pralka.\nMa dziwnie ukształtowany silnik.\r</language>
	</row>
	<row id="msg_0538_T11R0702_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To pralka.\nMa dziwnie ukształtowany silnik.\rOch? ROTOM wygląda, jakby chciało\nwejść do silnika.\rPozwolić mu wejść do silnika? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ROTOM niechętnie zrezygnowało z\nwejścia do silnika pralki...</language>
	</row>
	<row id="msg_0538_T11R0702_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wentylator.\nMa dziwnie ukształtowany silnik.\r</language>
	</row>
	<row id="msg_0538_T11R0702_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wentylator.\nMa dziwnie ukształtowany silnik.\rOch? ROTOM wygląda, jakby chciało\nwejść do silnika.\rPozwolić mu wejść do silnika? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ROTOM niechętnie zrezygnowało z\nwejścia do silnika wentylatora...</language>
	</row>
	<row id="msg_0538_T11R0702_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To kosiarka do trawy.\nMa dziwnie ukształtowany silnik.\r</language>
	</row>
	<row id="msg_0538_T11R0702_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To kosiarka do trawy.\nMa dziwnie ukształtowany silnik.\rOch? ROTOM wygląda, jakby chciało\nwejść do silnika.\rPozwolić mu wejść do silnika? {YESNO 0}</language>
	</row>
	<row id="msg_0538_T11R0702_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ROTOM niechętnie zrezygnowało z\nwejścia do silnika kosiarki...</language>
	</row>
	<row id="msg_0538_T11R0702_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest tu tajemniczy notatnik.\nNie da się określić jego wieku.\r„Czystym przypadkiem zdobyłem\ninformacje o Pokémonie ROTOM.\r„Co niezwykłe, ROTOM ma zdolność\nwchodzenia i łączenia się ze\fspecjalnymi silnikami.\r„Wiadomo teraz, że ROTOM może\npozostawać wewnątrz silnika\fniemal w nieskończoność.\r„Jednak wyjdzie, jeśli wejdzie do\nUnion Room lub Klubu Wi-Fi.\r„ROTOM wyjdzie też z silnika,\njeśli zostanie zostawiony w Żłobku.\r„ROTOM może też zapomnieć pewne\nataki, gdy opuszcza silnik.\r„Ten Pokémon wymaga wyczerpującej\nobserwacji i analizy.\r„Aby zapewnić sobie całą chwałę,\nmoje badania nad ROTOM muszą\fpozostać tajne.\r„Będą czcić mnie jako naukowego\ngeniusza, Char...”\rReszta notatnika jest pusta.</language>
	</row>
