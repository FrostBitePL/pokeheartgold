<?xml version="1.0"?>
<body language="English">
	<row id="msg_0540_T11R0801_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja córka lubi naśladować ludzi.\nJej naśladownictwo przyniosło jej\fprzezwisko Naśladowczyni.</language>
	</row>
	<row id="msg_0540_T11R0801_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja córka jest wyjątkowa...\rZawierała przyjaźnie, a potem jej\nnaśladownictwo je odstraszało...\fMa tylko kilkoro przyjaciół.</language>
	</row>
	<row id="msg_0540_T11R0801_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnio zgubiła Poké Doll, którą\ntrzy lata temu dał jej pewien chłopiec.\rOd tego czasu jest jeszcze lepsza\nw naśladownictwie...</language>
	</row>
	<row id="msg_0540_T11R0801_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BLISSEY: Bliisii!</language>
	</row>
</body>
