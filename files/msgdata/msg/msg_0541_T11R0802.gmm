<?xml version="1.0"?>
<body language="English">
	<row id="msg_0541_T11R0802_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Cześć! Lubisz\nPokémony?\r{STRVAR_1 3, 0, 0}: Yy, nie, właśnie cię\no to zapytałem/-am.\r{STRVAR_1 3, 0, 0}: Hę? Ale z ciebie\ndziwak/dziwaczka!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Cześć. Musisz\nlubić Pokémony.\r{STRVAR_1 3, 0, 0}: Nie, nie ja. Ciebie\npytam.\r{STRVAR_1 3, 0, 0}: Słucham? Ale z\nciebie dziwak/dziwaczka!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naśladowczyni: Hmm? Przestać\nnaśladować? Ale to moje główne\fhobby!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Cześć! Słyszałem/-am,\nże zgubiłaś swoją ukochaną\fPoké Doll.\r{STRVAR_1 3, 0, 0}: Jeśli ją znajdę,\ndasz mi Magnet Train Pass?\r{STRVAR_1 3, 0, 0}: Pójdę jej dla ciebie\nposzukać.\r{STRVAR_1 3, 0, 0}: Myślisz, że zgubiłaś\nją, gdy pojechałaś do Vermilion City?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Cześć! Słyszałem/-am,\nże zgubiłaś swoją ukochaną\fPoké Doll.\r{STRVAR_1 3, 0, 0}: Jeśli ją znajdę,\ndasz mi Magnet Train Pass?\r{STRVAR_1 3, 0, 0}: Pójdę jej dla ciebie\nposzukać.\r{STRVAR_1 3, 0, 0}: Myślisz, że zgubiłaś\nją, gdy pojechałaś do Vermilion City?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naśladowczyni: Słucham?\rNie powinnam decydować, co masz\nrobić?\rAle naprawdę się martwię...\nCo jeśli ktoś ją znajdzie?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naśladowczyni: Juhu! To moja Poké\nDoll CLEFAIRY!\rWidzisz to rozdarcie tam, gdzie\nprzyszyta jest prawa ręka? To dowód!\rDobrze. Dam ci ten Magnet Train\nPass, jak obiecałam!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00007" index="7">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0541_T11R0802_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naśladowczyni: Pokazujesz go przy\nbramce, żeby wsiąść do Magnet Train.\rCzłowiek z firmy kolejowej dał mi\ngo, gdy wyburzyli nasz stary dom\fpod budowę stacji.</language>
	</row>
	<row id="msg_0541_T11R0802_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Cześć!\nWielkie dzięki za Magnet Train Pass!\r{STRVAR_1 3, 0, 0}: Słucham?\r{STRVAR_1 3, 0, 0}: Czy to takie fajne,\nnaśladować każdy mój ruch?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}: Cześć!\nWielkie dzięki za Magnet Train Pass!\r{STRVAR_1 3, 0, 0}: Słucham?\r{STRVAR_1 3, 0, 0}: Czy to takie fajne,\nnaśladować każdy mój ruch?\r</language>
	</row>
	<row id="msg_0541_T11R0802_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naśladowczyni: A jakże! To niezła\nzabawa!\r</language>
	</row>
	<row id="msg_0541_T11R0802_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta Poké Doll wygląda dokładnie\njak prawdziwa rzecz...\rŁa! Poruszyła się!\nTo prawdziwy BANETTE!</language>
	</row>
	<row id="msg_0541_T11R0802_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BANETTE: Giggle!</language>
	</row>
	<row id="msg_0541_T11R0802_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Poké Doll przypominająca kwiat...\nTo Poké Doll CHERRIM!</language>
	</row>
	<row id="msg_0541_T11R0802_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Poké Doll przypominająca nos...\nTo Poké Doll NOSEPASS!</language>
	</row>
	<row id="msg_0541_T11R0802_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To CLEFAIRY!\nHę?\rAch, no tak. To Poké Doll CLEFAIRY.</language>
	</row>
	<row id="msg_0541_T11R0802_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Poké Doll CLEFAIRY.\rMa rozdarcie tam, gdzie przyszyta\njest prawa ręka.</language>
	</row>
</body>
