<?xml version="1.0"?>
<body language="English">
	<row id="msg_0542_T20_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, twój Pokégear robi wrażenie!</language>
	</row>
	<row id="msg_0542_T20_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekaj, {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0542_T20_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekaj, {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0542_T20_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co ty sobie myślisz, co robisz?\r</language>
	</row>
	<row id="msg_0542_T20_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To niebezpieczne wychodzić bez Pokémona!\rDzikie Pokémony wyskakują z trawy\nw drodze do następnego miasta.</language>
	</row>
	<row id="msg_0542_T20_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och! Twój Pokémon jest uroczy!\nChciałbym takiego mieć!</language>
	</row>
	<row id="msg_0542_T20_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, {STRVAR_1 3, 0, 0}!\nZnowu wychodzisz?\rPowinieneś powiedzieć mamie,\njeśli wychodzisz.</language>
	</row>
	<row id="msg_0542_T20_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, {STRVAR_1 3, 0, 0}!\nZnowu wychodzisz?\rPowinieneś powiedzieć mamie,\njeśli wychodzisz.</language>
	</row>
	<row id="msg_0542_T20_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zadzwoń do mamy przez Pokégear,\nżeby wiedziała, co u ciebie słychać.</language>
	</row>
	<row id="msg_0542_T20_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podoba mi się twoja Torba!</language>
	</row>
	<row id="msg_0542_T20_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekaj chwilę!\r</language>
	</row>
	<row id="msg_0542_T20_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zostawiłeś Pokégear w domu?\rPowinieneś zapytać mamę.</language>
	</row>
	<row id="msg_0542_T20_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, {STRVAR_1 3, 0, 0}!\rSłyszałem, że Profesor Mariusz\nodkrył jakieś nowe Pokémony.</language>
	</row>
	<row id="msg_0542_T20_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Więc to jest to słynne\nLaboratorium Pokémonów Mariusza...\r</language>
	</row>
	<row id="msg_0542_T20_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Na co się gapisz?\r</language>
	</row>
	<row id="msg_0542_T20_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: {STRVAR_1 3, 0, 0}!\rWięc wybrałeś...\n{STRVAR_1 0, 1, 0}!\rMasz uroczego Pokémona!\rGdy z nim chodzisz, będzie się\nstawał bardziej przyjazny.\rPowinieneś czasem się odwrócić\ni z nim porozmawiać.\rAch, właśnie!\nCzemu nie pokażesz go mamie?\fNara!\r</language>
	</row>
	<row id="msg_0542_T20_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: {STRVAR_1 3, 0, 0}!\rWięc wybrałeś...\n{STRVAR_1 0, 1, 0}!\rMasz uroczego Pokémona!\rGdy z nim chodzisz, będzie się\nstawał bardziej przyjazny.\rPowinieneś czasem się odwrócić\ni z nim porozmawiać.\rAch, właśnie!\nCzemu nie pokażesz go mamie?\fNara!\r</language>
	</row>
	<row id="msg_0542_T20_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Mariusz: Czekaj chwilę!\r</language>
	</row>
	<row id="msg_0542_T20_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prawie zupełnie o tym zapomniałem...\fProszę, dam ci mój numer.\r</language>
	</row>
	<row id="msg_0542_T20_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Profesora\nMariusza w Pokégearze!</language>
	</row>
	<row id="msg_0542_T20_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Mariusz: Zadzwonię, jeśli\ncoś się pojawi.\r</language>
	</row>
	<row id="msg_0542_T20_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}! Dokąd idziesz?\r</language>
	</row>
	<row id="msg_0542_T20_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Mariusz na ciebie czekał.\fMówił, że ma coś dla ciebie.\r</language>
	</row>
	<row id="msg_0542_T20_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie słyszałeś, jak mówiłem, że\nProfesor Mariusz na ciebie czeka?\r</language>
	</row>
	<row id="msg_0542_T20_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaczynam się denerwować!\r</language>
	</row>
	<row id="msg_0542_T20_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Ciekawe, czego chce od ciebie\nta dziewczyna w kimonie...</language>
	</row>
	<row id="msg_0542_T20_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Ciekawe, czego chce od ciebie\nta dziewczyna w kimonie...</language>
	</row>
	<row id="msg_0542_T20_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Cześć, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0542_T20_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Hej, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0542_T20_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dokąd to niby idziesz,\n{STRVAR_1 3, 0, 0}?\r</language>
	</row>
	<row id="msg_0542_T20_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dokąd to niby idziesz,\n{STRVAR_1 3, 0, 0}?\r</language>
	</row>
	<row id="msg_0542_T20_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Hmm... Mój Pokémon chyba ostatnio\nprzybiera na wadze...</language>
	</row>
	<row id="msg_0542_T20_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emil: Hmm... Mój Pokémon chyba ostatnio\nprzybiera na wadze...</language>
	</row>
	<row id="msg_0542_T20_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PIKACHU: Pika pika!\r</language>
	</row>
	<row id="msg_0542_T20_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzbna\nWinds of a New Beginning</language>
	</row>
	<row id="msg_0542_T20_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}’s House</language>
	</row>
	<row id="msg_0542_T20_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Laboratorium Pokémonów Mariusza</language>
	</row>
	<row id="msg_0542_T20_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}’s House</language>
	</row>
	<row id="msg_0542_T20_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czujesz dziwną moc płynącą z tego kamienia...\rPodaj numer Pokédexu (1-151),\nby przywołać wybranego Pokémona.\r</language>
	</row>
	<row id="msg_0542_T20_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kamień rozbłyskuje!\rPoczułeś przypływ mocy!</language>
	</row>
	<row id="msg_0542_T20_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kamień milczy...\nNic się nie stało.</language>
	</row>
	<row id="msg_0542_T20_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kamień rozbłyska, ale nie masz\nmiejsca na nowego Pokémona!</language>
	</row>
	<row id="msg_0542_T20_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TEST: numer wpisany poprawnie,\nekran wrocil bez zawieszenia.</language>
	</row>
</body>
