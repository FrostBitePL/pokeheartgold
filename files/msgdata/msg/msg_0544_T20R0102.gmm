<?xml version="1.0"?>
<body language="English">
	<row id="msg_0544_T20R0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, {STRVAR_1 3, 0, 0}!\rMój mąż zawsze jest taki\nzajęty--mam nadzieję, że wszystko\fu niego w porządku.\rGdy pochłoną go badania nad\nPokémonami, zapomina nawet o jedzeniu.</language>
	</row>
	<row id="msg_0544_T20R0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, {STRVAR_1 3, 0, 0}!\rMój mąż zawsze jest taki\nzajęty--mam nadzieję, że wszystko\fu niego w porządku.\rGdy pochłoną go badania nad\nPokémonami, zapomina nawet o jedzeniu.</language>
	</row>
	<row id="msg_0544_T20R0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy dorosnę, pomogę mojemu\ntacie!\rZostanę wspaniałym Profesorem\nPokémonów!</language>
	</row>
	<row id="msg_0544_T20R0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">„Pokémony. Skąd się biorą?\nDokąd zmierzają?\rDlaczego nikt nigdy nie był\nświadkiem narodzin Pokémona?\rChcę to wiedzieć! Poświęcę całe\rswoje życie na badanie Pokémonów!”\r...\rTo fragment prac badawczych\nProfesora Elma.</language>
	</row>
</body>
