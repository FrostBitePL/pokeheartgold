<?xml version="1.0"?>
<body language="English">
	<row id="msg_0545_T20R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, {STRVAR_1 3, 0, 0}!\nWreszcie się obudziłeś.\fTwój przyjaciel Emil był tu przed chwilą.\rBawił się w chowanego\nze swoim PIKACHU.\rAch, prawie zapomniałam! Nasz znajomy,\nProfesor Mariusz, cię szukał.\rMówił, że ma do ciebie prośbę.\rWiesz, gdzie jest laboratorium, prawda?\nJest tuż obok nas.\rSwoją drogą, masz wszystko,\nczego potrzebujesz, żeby wyjść?\fMasz, weź tę Torbę do noszenia rzeczy...\r</language>
	</row>
	<row id="msg_0545_T20R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, {STRVAR_1 3, 0, 0}!\nWreszcie się obudziłaś.\fTwój przyjaciel Emil był tu przed chwilą.\rBawił się w chowanego\nze swoim PIKACHU.\rAch, prawie zapomniałam! Nasz znajomy,\nProfesor Mariusz, cię szukał.\rMówił, że ma do ciebie prośbę.\rWiesz, gdzie jest laboratorium, prawda?\nJest tuż obok nas.\rSwoją drogą, masz wszystko,\nczego potrzebujesz, żeby wyjść?\fMasz, weź tę Torbę do noszenia rzeczy...\r</language>
	</row>
	<row id="msg_0545_T20R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To twoja Karta Trenera...\r</language>
	</row>
	<row id="msg_0545_T20R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tutaj możesz zapisać\nswoje postępy...\r</language>
	</row>
	<row id="msg_0545_T20R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Te też się przydadzą...\r</language>
	</row>
	<row id="msg_0545_T20R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po prostu spróbuj dotknąć przycisków,\na szybko się zorientujesz.\r</language>
	</row>
	<row id="msg_0545_T20R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Mariusz na ciebie czeka,\nkochanie. Idź mu pomóc, proszę.</language>
	</row>
	<row id="msg_0545_T20R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och! {STRVAR_1 3, 0, 0}!\nJaki uroczy Pokémon.\rProfesor Mariusz musiał ci go dać?\rAch, Profesor Mariusz ma dla ciebie\nzadanie, mówisz?\fJakiego rodzaju zadanie?\r...\rRozumiem. To brzmi trochę trudno.\rAle skoro ktoś prosi cię o coś takiego,\nto musi być ważne!\rAch, właśnie!\nCałkiem zapomniałam!\rTwój Pokégear wrócił\nz naprawy!\rProszę, masz!\r</language>
	</row>
	<row id="msg_0545_T20R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nPokégear!\r</language>
	</row>
	<row id="msg_0545_T20R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon Gear...\nczyli Pokégear, jak się go często\fnazywa, powinien mieć\fkażdy Trener.\r</language>
	</row>
	<row id="msg_0545_T20R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiesz co?\nPokégeara możesz też użyć,\fżeby zadzwonić.\fPamiętasz jak? {YESNO 0}</language>
	</row>
	<row id="msg_0545_T20R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po prostu włącz Pokégeara\ni dotknij przycisku telefonu, dobrze?\r</language>
	</row>
	<row id="msg_0545_T20R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierz przycisk POKéGEAR na\nEkranie Dotykowym. Potem wybierz\fprzycisk telefonu.\r</language>
	</row>
	<row id="msg_0545_T20R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Imiona osób, do których możesz\nzadzwonić, rejestrują się automatycznie.\rWystarczy wybrać jedną, żeby\nzadzwonić.\rWow, nie mogę uwierzyć, że dzwonienie\njest teraz takie proste!</language>
	</row>
	<row id="msg_0545_T20R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co się stało?\rZapomniałeś, jak dotrzeć\ndo domu Wacka?\rIdź na północ, w stronę Łażan.\nUważaj na siebie, kochanie.</language>
	</row>
	<row id="msg_0545_T20R0201_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\nWięc wyruszasz w przygodę...\rDobrze! Ja też pomogę.\nAle co mogę dla ciebie zrobić?\rWiem!\nZa każdym razem, gdy dostaniesz\fnagrodę pieniężną, część odłożę dla ciebie.\rW długiej podróży pieniądze są ważne.\rChcesz, żebym odkładała\ntwoje pieniądze? {YESNO 0}</language>
	</row>
	<row id="msg_0545_T20R0201_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcę cię wspierać w twojej\nprzygodzie, {STRVAR_1 3, 0, 0}.\fDobrze! Ja też pomogę.\fAle co mogę dla ciebie zrobić?\rWiem!\rZa każdym razem, gdy dostaniesz\nnagrodę pieniężną, część odłożę dla ciebie.\rW długiej podróży pieniądze są ważne.\nChcesz, żebym odkładała\ftwoje pieniądze? {YESNO 0}</language>
	</row>
	<row id="msg_0545_T20R0201_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, zajmę się twoimi pieniędzmi.\rUważaj na siebie.\rPokémony są twoimi przyjaciółmi.\nGdy działacie jako zespół,\fmożecie osiągnąć wszystko!\fA teraz, idź już!</language>
	</row>
	<row id="msg_0545_T20R0201_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, ale uważaj tam na siebie.\rPokémony są twoimi przyjaciółmi.\nGdy działacie jako zespół,\fmożecie osiągnąć wszystko!\fA teraz, idź już!</language>
	</row>
	<row id="msg_0545_T20R0201_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, trzymaj się mocno!\nZawsze jestem tu dla ciebie!</language>
	</row>
	<row id="msg_0545_T20R0201_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć! Witaj w domu!\nWidzę, że dobrze sobie radzisz.\rTrzymałam twój pokój w czystości\ni porządku. Albo...\fChodzi o twoje pieniądze? {YESNO 0}</language>
	</row>
	<row id="msg_0545_T20R0201_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rób, co możesz.</language>
	</row>
	<row id="msg_0545_T20R0201_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och!\nNie masz żadnych odłożonych pieniędzy.</language>
	</row>
	<row id="msg_0545_T20R0201_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje pieniądze są tu bezpieczne!\nUważaj na siebie!</language>
	</row>
	<row id="msg_0545_T20R0201_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}\nZastanów się dobrze, jak je wydajesz!</language>
	</row>
	<row id="msg_0545_T20R0201_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz odłożyć trochę pieniędzy? {YESNO 0}</language>
	</row>
	<row id="msg_0545_T20R0201_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och!\nNie masz już pieniędzy do odłożenia.\rNie marnuj pieniędzy na\nbłahostki, dobrze?\rWiem, że jesteś rozsądny/rozsądna jak ja\ni że mogę na tobie polegać!</language>
	</row>
	<row id="msg_0545_T20R0201_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odłożyłam już tak dużo.\nNie mogę odłożyć więcej.</language>
	</row>
	<row id="msg_0545_T20R0201_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz już tak dużo pieniędzy.\nNie mogę dać ci więcej.</language>
	</row>
	<row id="msg_0545_T20R0201_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WYPŁAĆ</language>
	</row>
	<row id="msg_0545_T20R0201_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WPŁAĆ PIENIĄDZE</language>
	</row>
	<row id="msg_0545_T20R0201_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ZMIEŃ</language>
	</row>
	<row id="msg_0545_T20R0201_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WYJDŹ</language>
	</row>
	<row id="msg_0545_T20R0201_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, {STRVAR_1 3, 0, 0}!\nProfesor Mariusz powiedział mi,\fże ma coś dla ciebie!\r</language>
	</row>
	<row id="msg_0545_T20R0201_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesor Mariusz powiedział mi,\nże ma coś dla ciebie.\fMoże odwiedzisz jego laboratorium?</language>
	</row>
	<row id="msg_0545_T20R0201_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W telewizji leci film!\rDwóch chłopców szuka skarbu\nw jaskini!\rMuszę już iść...</language>
	</row>
	<row id="msg_0545_T20R0201_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wulkaniczny Burger!\nSpecjalność mamy!</language>
	</row>
	<row id="msg_0545_T20R0201_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lśniący czysty zlew!\nMama uwielbia, gdy jest czysto.</language>
	</row>
	<row id="msg_0545_T20R0201_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co jest w lodówce...?\rDużo wody do picia i\nsłodziutka lemoniada!</language>
	</row>
</body>
