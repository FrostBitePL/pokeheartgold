<?xml version="1.0"?>
<body language="English">
	<row id="msg_0549_T20R0402_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: {STRVAR_1 3, 0, 0}!\rProfesor Elm cię szukał.\nByłeś/aś w jego laboratorium?</language>
	</row>
	<row id="msg_0549_T20R0402_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: {STRVAR_1 3, 0, 0}!\rProfesor Elm cię szukał.\nByłeś/aś w jego laboratorium?</language>
	</row>
	<row id="msg_0549_T20R0402_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Mój MARILL jest super uroczy...\nAle twój {STRVAR_1 0, 1, 0} też wygląda\fcałkiem nieźle, {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0549_T20R0402_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Mój MARILL jest super fajny...\nAle twój {STRVAR_1 0, 1, 0} też wygląda\fcałkiem nieźle, {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0549_T20R0402_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MARILL: Qurururoon.</language>
	</row>
	<row id="msg_0549_T20R0402_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Czy to nie dziwne, że gdy\njesteśmy z Pokémonami, wychodzenie\fna zewnątrz jest o wiele fajniejsze!\r{STRVAR_1 3, 0, 0}!\nSpróbuj chodzić w różne miejsca\fi rozmawiać ze swoim Pokémonem!\rZałożę się, że dowiesz się o nim\ntak wielu rzeczy!</language>
	</row>
	<row id="msg_0549_T20R0402_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Czy to nie dziwne, że gdy\njesteśmy z Pokémonami, wychodzenie\fna zewnątrz jest o wiele fajniejsze!\r{STRVAR_1 3, 0, 0}!\nSpróbuj chodzić w różne miejsca\fi rozmawiać ze swoim Pokémonem!\rZałożę się, że dowiesz się o nim\ntak wielu rzeczy!</language>
	</row>
	<row id="msg_0549_T20R0402_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Cześć, {STRVAR_1 3, 0, 0}!\nJak się mają twoje Pokémony?\fNie zapomnij rozmawiać z...\rCo to jest?\nTwój Pokémon trzyma jakiś liść...\rCzy to może być Lśniący Liść?\nLegenda głosi, że tylko Pokémony,\fktóre nawiązały bliską więź\fz ludźmi, potrafią znaleźć takie liście...\rLudzie dawniej przerabiali te liście\nw piękną koronę, gdy udało im\fsię zebrać pięć z nich.\rWow!\nWiedziałam, że zdołasz jeden zdobyć,\f{STRVAR_1 3, 0, 0}!\fPokaż mi, gdy znajdziesz kolejny!</language>
	</row>
	<row id="msg_0549_T20R0402_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Cześć, {STRVAR_1 3, 0, 0}!\nJak się mają twoje Pokémony?\fNie zapomnij rozmawiać z...\rCo to jest?\nTwój Pokémon trzyma jakiś liść...\rCzy to może być Lśniący Liść?\nLegenda głosi, że tylko Pokémony,\fktóre nawiązały bliską więź\fz ludźmi, potrafią znaleźć takie liście...\rLudzie dawniej przerabiali te liście\nw piękną koronę, gdy udało im\fsię zebrać pięć z nich.\rWow!\nWiedziałem, że zdołasz jeden zdobyć,\f{STRVAR_1 3, 0, 0}!\fPokaż mi, gdy znajdziesz kolejny!</language>
	</row>
	<row id="msg_0549_T20R0402_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Cześć, {STRVAR_1 3, 0, 0}!\nJak się miewa Pokémon, z którym\fspacerujesz?\rMożesz do niego czasem rozmawiać\npodczas spaceru, żeby wzmocnić\fwaszą przyjaźń!\r...\nOch!\rZnalazłeś/aś Lśniący Liść!\nPokaż mi!\rHa! Zebrałeś/aś już...\r{STRVAR_1 50, 1, 0}!\rTak trzymaj!\nZbierz jeszcze {STRVAR_1 50, 2, 0}!</language>
	</row>
	<row id="msg_0549_T20R0402_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Cześć, {STRVAR_1 3, 0, 0}!\nJak się miewa Pokémon, z którym\fspacerujesz?\rMożesz do niego czasem rozmawiać\npodczas spaceru, żeby wzmocnić\fwaszą przyjaźń!\r...\nOch!\rZnalazłeś/aś Lśniący Liść!\nPokaż mi!\rHa! Zebrałeś/aś już...\r{STRVAR_1 50, 1, 0}!\rTak trzymaj!\nZbierz jeszcze {STRVAR_1 50, 2, 0}!</language>
	</row>
	<row id="msg_0549_T20R0402_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Cześć, {STRVAR_1 3, 0, 0}!\nJak się miewa Pokémon, z którym\fspacerujesz?\rMożesz do niego czasem rozmawiać\npodczas spaceru, żeby wzmocnić\fwaszą przyjaźń!\r...\rHa! Zebrałeś/aś już pięć\fLśniących Liści!\rPozwól, że zrobię z nich koronę!\nA co więcej...\fdam ci też to!\r</language>
	</row>
