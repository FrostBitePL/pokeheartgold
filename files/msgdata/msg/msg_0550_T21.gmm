<?xml version="1.0"?>
<body language="English">
	<row id="msg_0550_T21_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś początkującym Trenerem,\nprawda? Widać to!\rNic straconego! Każdy kiedyś\nzaczynał!\rJeśli chcesz, mogę nauczyć cię\nkilku rzeczy.\fW takim razie, chodź za mną!\r</language>
	</row>
	<row id="msg_0550_T21_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej... Przepraszam.\nZapomniałem, że nie masz jeszcze\fButów do Biegania!\rPostaram się iść jak najwolniej,\nwięc spróbuj nadążyć!\r</language>
	</row>
	<row id="msg_0550_T21_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest Centrum Pokémon. Leczą\ntwoje Pokémony w mgnieniu oka.\rBędziesz z nich często korzystać,\nwięc lepiej się z nimi zapoznaj.\r</language>
	</row>
	<row id="msg_0550_T21_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest Sklep Pokémon.\nSprzedają Poké Bale do łapania\fdzikich Pokémonów i inne\fprzydatne przedmioty.\r</language>
	</row>
	<row id="msg_0550_T21_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 30 jest w tamtą stronę.\rTrenerzy będą tam walczyć\nswoimi Pokémonami.\rJeśli pójdziesz trochę dalej,\nzobaczysz dom Pana Pokémon.\r</language>
	</row>
	<row id="msg_0550_T21_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest morze, jak widzisz.\rNiektóre Pokémony można znaleźć\ntylko w wodzie.\r</language>
	</row>
	<row id="msg_0550_T21_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tutaj...\nTo mój dom!\rZa trud nadążania za mną,\ndam ci moje Buty do Biegania!\fWciąż są ciepłe!\r...\n...\rNabrałem cię, co?\nSpokojnie, są zupełnie nowe!\r</language>
	</row>
	<row id="msg_0550_T21_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nButy do Biegania od Przewodnika!</language>
	</row>
	<row id="msg_0550_T21_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W instrukcji napisano:\n„Dotknij przycisku Biegu na\fEkranie Dotykowym, by biec”.\rJest tam też napisane:\n„Przytrzymaj przycisk B, by biec”.\r</language>
	</row>
	<row id="msg_0550_T21_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Hff... Hff...\nUdało się...\rZapomniałem o jednej rzeczy.\nMam dla ciebie jeszcze coś!\rProszę, weź to.\r</language>
	</row>
	<row id="msg_0550_T21_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przewodnik wgrał Kartę Mapy\ndo Pokégearu {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0550_T21_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokégear {STRVAR_1 3, 0, 0}\nmoże teraz pokazać Mapę Miasta!\r</language>
	</row>
	<row id="msg_0550_T21_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierz Pokégear na Ekranie\nDotykowym, a następnie wybierz\fikonę Mapy Miasta.\rZobaczysz mapę regionu, w którym\naktualnie się znajdujesz!\rPokégear staje się coraz\nbardziej przydatny wraz z\fdodawaniem Kart.\rŻyczę powodzenia w podróży!\r</language>
	</row>
	<row id="msg_0550_T21_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\rDostałeś Pokémona w Laboratorium.\nCóż za marnotrawstwo.\rTo Pokémon zbyt dobry\ndla takiego mięczaka jak ty.\r...\nNie rozumiesz, co mówię?\rCóż, ja też mam dobrego Pokémona.\nPokażę ci, o co mi chodzi!\r</language>
	</row>
	<row id="msg_0550_T21_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\rChcesz wiedzieć, kim jestem?\n...\rZostanę najlepszym Trenerem\nPokémon na świecie.\r</language>
	</row>
	<row id="msg_0550_T21_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oddaj to!\nTo moja Karta Trenera!\rO nie!\nWidziałeś moje imię...\r</language>
	</row>
	<row id="msg_0550_T21_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozmawiałeś ze starszym panem\nprzy Centrum Pokémon?\rDoda mapę Regionu Żarów do\ntwojego Pokégearu.</language>
	</row>
	<row id="msg_0550_T21_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jesteś z Pokémonami,\nkażda podróż jest przyjemnością.</language>
	</row>
	<row id="msg_0550_T21_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dom Pana Pokémon jest jeszcze\nkawałek dalej.\rMógłbyś użyć Butów do Biegania,\ngdybyś je miał.\rAle uważaj na dzikie Pokémony\ni Trenerów!\rGdy biegniesz, hałas\nprzyciąga ich uwagę.</language>
	</row>
	<row id="msg_0550_T21_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczyłem z Trenerami na drodze.\nMoje Pokémony przegrały.\rSą w opłakanym stanie! Muszę\nzabrać je do Centrum Pokémon.</language>
	</row>
	<row id="msg_0550_T21_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złapany przeze mnie Pokémon miał\nprzedmiot. Chyba to Mistyczna Woda.\rNie potrzebuję go, chcesz go wziąć?\r</language>
	</row>
	<row id="msg_0550_T21_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No to wracam do wędkowania.</language>
	</row>
	<row id="msg_0550_T21_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie masz na to miejsca.</language>
	</row>
	<row id="msg_0550_T21_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zastruże\nMiasto Pachnących Kwiatów</language>
	</row>
	<row id="msg_0550_T21_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dom Przewodnika\nPełen Energii, Szybki Staruszek</language>
	</row>
	<row id="msg_0550_T21_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czujesz dziwną moc płynącą z tego kamienia...\rPodaj numer Pokédexu (1-151),\nby przywołać wybranego Pokémona.\r</language>
	</row>
	<row id="msg_0550_T21_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a) {STRVAR_1 0, 1, 0}!\rKamień rozbłyskuje!</language>
	</row>
	<row id="msg_0550_T21_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kamień milczy...\nNic się nie stało.</language>
	</row>
	<row id="msg_0550_T21_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kamień rozbłyska, ale nie masz\nmiejsca na nowego Pokémona!</language>
	</row>
	<row id="msg_0550_T21_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kamień jest zimny i milczący.\nMoże obudzi się, gdy zacznę\nswoją podróż z Pokémonem?</language>
	</row>
</body>
