<?xml version="1.0"?>
<body language="English">
	<row id="msg_0552_T21PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wspaniałe. Mogę przechowywać\ndowolną liczbę Pokémonów, i wszystko\fto za darmo.</language>
	</row>
	<row id="msg_0552_T21PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten komputer PC może za darmo\nużywać każdy Trener.</language>
	</row>
	<row id="msg_0552_T21PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Centrum Komunikacyjne na górze\nwłaśnie zbudowano.\rAle wciąż je wykańczają.</language>
	</row>
	<row id="msg_0552_T21PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Centrum Komunikacyjne na górze\nwłaśnie zbudowano.\rJuż wymieniłem/-am tam Pokémona!</language>
	</row>
	<row id="msg_0552_T21PC0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Union Room Klubu\nBezprzewodowego Pokémon.\r...Och, właśnie próbowałem/-am\nnauczyć się tej kwestii na pamięć.\rZajmie nam trochę więcej czasu,\nzanim otworzymy Union Room.</language>
	</row>
	<row id="msg_0552_T21PC0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Colosseum Klubu\nKomunikacyjnego Pokémon.\r...Och, właśnie próbowałem/-am\nnauczyć się tej kwestii na pamięć.\rZajmie nam trochę więcej czasu,\nzanim otworzymy Colosseum.</language>
	</row>
</body>
