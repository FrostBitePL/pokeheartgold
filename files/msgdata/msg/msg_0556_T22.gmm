<?xml version="1.0"?>
<body language="English">
	<row id="msg_0556_T22_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}? Odkryliśmy\ncoś w sprawie Jajka!\rMój asystent jest w Centrum Pokémon\nw Łażanach.\fMógłbyś z nim porozmawiać?</language>
	</row>
	<row id="msg_0556_T22_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bonjour!\nTy być Trener?\rWalka z Liderem Sali, wygrałeś ty? {YESNO 0}</language>
	</row>
	<row id="msg_0556_T22_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, la la!\nBardzo, bardzo miło!</language>
	</row>
	<row id="msg_0556_T22_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak to jest? Zatem uczyć się będziesz!\fChodź za mną!\r</language>
	</row>
	<row id="msg_0556_T22_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tutaj, nauczyciel ja jestem.\nDobrze to, że się uczysz tu!\r</language>
	</row>
	<row id="msg_0556_T22_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Były doniesienia o Pokémonach typu\nDuch pojawiających się w Wieży Kiełków.\rMówią, że ataki typu Normalny\nnie mają na nie żadnego wpływu.</language>
	</row>
	<row id="msg_0556_T22_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, jesteś Trenerem Pokémon?\rJeśli pokonasz tutejszego Lidera Sali,\nbędziesz gotowy na wielkie rzeczy!</language>
	</row>
	<row id="msg_0556_T22_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Falkner, z Sali Pokémon w Łażanach,\nto świetny Trener!\rOdziedziczył Salę po ojcu i\nwspaniale sobie z nią radzi.</language>
	</row>
	<row id="msg_0556_T22_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W niektórych miejscach nie możesz\nchodzić z Pokémonem poza Poké Balem.\rW budynkach, jaskiniach oraz tam,\ngdzie panuje duży tłok.\rWystarczy jednak włożyć go\ndo Poké Bala!</language>
	</row>
	<row id="msg_0556_T22_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Łażany\nMiasto Nostalgicznych Zapachów</language>
	</row>
	<row id="msg_0556_T22_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Łażanach\nLider: Falkner\fElegancki Mistrz Pokémonów Latających</language>
	</row>
	<row id="msg_0556_T22_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieża Kiełków\rDoświadcz Drogi Pokémonów,\nby odrzucić swoje wątpliwości.</language>
	</row>
	<row id="msg_0556_T22_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szkoła Pokémon\rEarl pokaże ci wszystko,\nco trzeba wiedzieć o Pokémonach!</language>
	</row>
	<row id="msg_0556_T22_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O rety...\nTo Jajko musi być...!\r</language>
	</row>
	<row id="msg_0556_T22_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem...\nWięc trafiło od Wacka do Profesora\fMariusza, a od Profesora Mariusza\fdo ciebie.\rTeraz rozumiem...\r</language>
	</row>
	<row id="msg_0556_T22_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Jajko jest naprawdę ważne.\nProszę, zaopiekuj się nim dla mnie.\rZrozumiano?\r</language>
	</row>
	<row id="msg_0556_T22_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Liczę na ciebie.\r</language>
	</row>
	<row id="msg_0556_T22_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odłamek za Jagodę!\nOdłamek za Jagodę!\rTak, tak!\nWymieniam Jagodę za Odłamek.\rJeśli przyniesiesz mi kilka Odłamków,\ndam ci trzy Jagody, tak.\r</language>
	</row>
	<row id="msg_0556_T22_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odłamek za Jagodę!\nOdłamek za Jagodę!\rTak, tak!\nWymieniam Jagodę za Odłamek.\rJeśli przyniesiesz mi kilka Odłamków,\ndam ci trzy Jagody, tak.\rKtóry Odłamek wymienisz\nza Jagodę? {YESNO 0}</language>
	</row>
	<row id="msg_0556_T22_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więcej Odłamków do wymiany\nna Jagody? {YESNO 0}</language>
	</row>
	<row id="msg_0556_T22_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, tak!\nWróć, gdy zmienisz\fzdanie, tak.\r</language>
	</row>
	<row id="msg_0556_T22_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci zestaw Jagód A\nza Czerwony Odłamek, tak.\r</language>
	</row>
	<row id="msg_0556_T22_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci zestaw Jagód B\nza Niebieski Odłamek, tak.\r</language>
	</row>
	<row id="msg_0556_T22_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci zestaw Jagód C\nza Żółty Odłamek, tak.\r</language>
	</row>
	<row id="msg_0556_T22_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci zestaw Jagód D\nza Zielony Odłamek, tak.\r</language>
	</row>
	<row id="msg_0556_T22_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz już wiele Jagód\nz tego zestawu.\rWróć, gdy będziesz potrzebować\nwięcej, tak.\r</language>
	</row>
	<row id="msg_0556_T22_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dbamy tutaj o tradycyjne budynki.\nDlatego nawet Sklep Pokémon\fi Centrum Pokémon są pomalowane\fw stonowanych barwach, by pasować.</language>
	</row>
	<row id="msg_0556_T22_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy wiesz, że Pokégear pozwala\nzaznaczać miejsca i notatki na Mapie?\rBardzo chciałbym mieć taki\nPokégear, ale mama mi nie pozwala.</language>
	</row>
</body>
