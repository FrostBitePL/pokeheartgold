<?xml version="1.0"?>
<body language="English">
	<row id="msg_0562_T22R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon otrzymany w wymianie\nrośnie szybciej.\rAle jeśli nie masz odpowiedniej\nOdznaki Sali, może cię nie słuchać.</language>
	</row>
	<row id="msg_0562_T22R0601_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kolekcjonuję Pokémony.\nMasz może BELLSPROUT?\rChcesz wymienić go na mojego ONIX? {YESNO 0}</language>
	</row>
	<row id="msg_0562_T22R0601_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hurra! Mam własnego BELLSPROUT!\nDzięki!</language>
	</row>
	<row id="msg_0562_T22R0601_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? To nie jest BELLSPROUT.\fCóż za rozczarowanie...</language>
	</row>
	<row id="msg_0562_T22R0601_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcesz się wymienić? Ech...</language>
	</row>
	<row id="msg_0562_T22R0601_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, jak się miewa mój dawny ONIX?</language>
	</row>
</body>
