	<row id="msg_0563_T22R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnio nie widuję ludzi\nprzyjeżdżających z Goldenrod City.</language>
	</row>
	<row id="msg_0563_T22R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnio jest tu ruchliwie, bo\nmamy wielu ludzi przyjeżdżających\fz Goldenrod i Ecruteak!</language>
	</row>
	<row id="msg_0563_T22R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rośliny też są żywymi istotami!\nChciałyby się czasem\fgdzieś przemieszczać!</language>
