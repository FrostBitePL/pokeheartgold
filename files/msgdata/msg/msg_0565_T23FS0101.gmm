<?xml version="1.0"?>
<body language="English">
	<row id="msg_0565_T23FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Liczba Odznak Sali, jakie masz,\npokazuje, jak silnym jesteś Trenerem.\rIm więcej Odznak masz, tym lepsze\nprzedmioty zobaczysz w sklepach!</language>
	</row>
	<row id="msg_0565_T23FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Great Ball lepiej łapie Pokémony\nniż Poké Bal.\rAle te od Kurta czasem mogą być\njeszcze lepsze.</language>
	</row>
</body>
