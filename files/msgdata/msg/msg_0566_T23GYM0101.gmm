<?xml version="1.0"?>
<body language="English">
	<row id="msg_0566_T23GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, śmiałku! Dorota stworzyła tę\nSalę w środku lasu Wostówka. To\fogromny ogród Pokémonów typu Grass.\rDorota jest młoda, ale zna każdy\nliść w okolicy!\rBędzie ci ciężko bez mojej rady.\rZobaczmy... Pokémony typu Grass nie\nlubią ognia.\rAtaki typu Flying i Poison też są\nsuperefektywne.</language>
	</row>
	<row id="msg_0566_T23GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świetnie! To było wspaniałe starcie\nutalentowanych młodych Trenerów.\rZ ludźmi takimi jak ty, przyszłość\nPokémonów jest jasna!</language>
	</row>
	<row id="msg_0566_T23GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Kalnie</language>
	</row>
	<row id="msg_0566_T23GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Kalnie\rLiderka: Dorota\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
