<?xml version="1.0"?>
<body language="English">
	<row id="msg_0566_T23GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, śmiałku!\nBugsy stworzył tę Salę. To ogromne\fgniazdo Pokémonów typu Robaczkowy.\rBugsy jest młody, ale jest mistrzem\nPokémonów typu Robaczkowy!\rBędzie ciężko bez mojej rady.\rZobaczmy... Pokémony typu Robaczkowy\nnie lubią ognia.\rAtaki typu Latający też są\nsuperefektywne.</language>
	</row>
	<row id="msg_0566_T23GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świetnie! To było wspaniałe starcie\nutalentowanych młodych Trenerów.\rZ ludźmi takimi jak ty, przyszłość\nPokémonów jest jasna!</language>
	</row>
	<row id="msg_0566_T23GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Azalea Town</language>
	</row>
	<row id="msg_0566_T23GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Azalea Town\rLider: Bugsy\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
