<?xml version="1.0"?>
<body language="English">
	<row id="msg_0567_T23GYM0102_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dorota: Jestem Dorota! Nigdy nie\nprzegrywam, gdy chodzi o Pokémony\ftypu Grass.\rMoje badania nad lasem Wostówka\nuczynią mnie autorytetem w tej\fdziedzinie!\rPozwól, że pokażę ci, czego\nnauczyłam się z moich studiów.\r</language>
	</row>
	<row id="msg_0567_T23GYM0102_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dorota: Wow, niesamowite! Jesteś\nekspertem od Pokémonów!\rMoje badania jeszcze nie są\nukończone. Dobrze, wygrałeś/aś.\rWeź tę Odznakę.\r</language>
	</row>
	<row id="msg_0567_T23GYM0102_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nOdznakę Wostówki od Doroty!</language>
	</row>
	<row id="msg_0567_T23GYM0102_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dorota: Znasz korzyści płynące z\nOdznaki Wostówki?\rDzięki niej Pokémony do poziomu 30\nbędą cię słuchać, nawet wymienione.\rPokémony znające atak Cięcie będą\nmogły go używać też poza walką.\rProszę, chcę też, żebyś miał/a to.\r</language>
	</row>
	<row id="msg_0567_T23GYM0102_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0567_T23GYM0102_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dorota: TM89 zawiera atak Zwrot.\rPozwala twojemu Pokémonowi zaatakować,\na potem zamienić się z kolejnym\fPokémonem w drużynie.\rCzyż to nie wspaniałe?</language>
	</row>
	<row id="msg_0567_T23GYM0102_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dorota: Pokémony typu Grass są\nzłożone. Jest wiele tajemnic do\fodkrycia.\rDokładnie badaj swoich faworytów.</language>
	</row>
</body>
