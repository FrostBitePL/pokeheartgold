<?xml version="1.0"?>
<body language="English">
	<row id="msg_0570_T23R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystkie SLOWPOKE zniknęły\nz miasta.\rOpiekun lasu może być\nna nas zły...\rTo może być zły omen. Powinniśmy\nzostać w domach.</language>
	</row>
	<row id="msg_0570_T23R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SLOWPOKE wróciły...\rAle moje FARFETCH’D nie wróciły.\nMój uczeń poszedł ich szukać\fdo Ilex Forest.\rMinęło już mnóstwo czasu.\nGdzie u licha jest ten leniwiec?</language>
	</row>
	<row id="msg_0570_T23R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegoniłeś Team Rocket i sam\nposzedłeś do Ilex Forest?\rTo wymaga odwagi!\nPodoba mi się to. Chodź trenować\fz nami.</language>
	</row>
	<row id="msg_0570_T23R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdzie podziały się wszystkie\nSLOWPOKE? Bawią się gdzieś?</language>
	</row>
	<row id="msg_0570_T23R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam - zapomniałem ci\npodziękować. To Węgiel Drzewny,\fktóry zrobiłem.\rAtaki typu Ognisty stają się\nsilniejsze, gdy Pokémon\fto trzyma.</language>
	</row>
	<row id="msg_0570_T23R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nWęgiel Drzewny!</language>
	</row>
	<row id="msg_0570_T23R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SLOWPOKE wróciły, a ty nawet\nznalazłeś FARFETCH’D.\fJesteś najlepszy, ziomek!</language>
	</row>
	<row id="msg_0570_T23R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojej, twoja Torba jest zapchana.</language>
	</row>
	<row id="msg_0570_T23R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">FARFETCH’D: Kwaa!</language>
	</row>
</body>
