<?xml version="1.0"?>
<body language="English">
	<row id="msg_0571_T23R0501_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hm? Kim jesteś?\r{STRVAR_1 3, 0, 0}, tak? Chcesz, żebym\nzrobił ci jakieś Bale?\rPrzykro mi, ale to będzie musiało\npoczekać.\rZnasz Team Rocket?\nAch, nie martw się. Powiem ci\ftak czy inaczej.\rTeam Rocket to zła banda, która\nwykorzystuje Pokémony do brudnej\froboty.\rPodobno rozwiązali się trzy\nlata temu.\rW każdym razie są teraz przy studni\ni obcinają SlowpokeTaile na sprzedaż!\rWięc idę dać im nauczkę!\rTrzymaj się, SLOWPOKE!\nStary Kurt już idzie!</language>
	</row>
	<row id="msg_0571_T23R0501_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: Cześć, {STRVAR_1 3, 0, 0}!\nSpisałeś się jak prawdziwy bohater.\rJak wspominałem wcześniej, Team\nRocket rozwiązał chłopak zwany Red,\ftrzy lata temu.\rSkoro teraz wrócili...\nMam co do tego złe przeczucie...\rW każdym razie, byłoby mi bardzo\nmiło zrobić Poké Bale dla Trenera\ftakiego jak ty, {STRVAR_1 3, 0, 0}.\fTo wszystko, co teraz mam, ale weź to.\r</language>
	</row>
	<row id="msg_0571_T23R0501_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0571_T23R0501_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: Robię Poké Bale z Apricornów.\rZbierz je z drzew i przynieś\nmi je.\rZrobię z nich Poké Bale.</language>
	</row>
	<row id="msg_0571_T23R0501_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: Masz dla mnie Apricorny?\fDobrze! Zamienię je w Poké Bale.\r</language>
	</row>
	<row id="msg_0571_T23R0501_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: Zrobienie Poké Bala zajmie\ndzień. Wróć po niego później.</language>
	</row>
	<row id="msg_0571_T23R0501_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: Och...\nCóż za rozczarowanie.</language>
	</row>
	<row id="msg_0571_T23R0501_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: Pracuję!\nNie przeszkadzaj mi!</language>
	</row>
	<row id="msg_0571_T23R0501_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: Ach, {STRVAR_1 3, 0, 0}!\fWłaśnie skończyłem twój Poké Bal.\fProszę!\r</language>
	</row>
	<row id="msg_0571_T23R0501_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: Twoja Torba jest pełna!\nWróć, gdy będzie lżejsza.</language>
	</row>
	<row id="msg_0571_T23R0501_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kurt: To wyszło świetnie.\rSpróbuj nim złapać Pokémona.</language>
	</row>
	<row id="msg_0571_T23R0501_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SLOWPOKE zniknęły...\nCzy zabrali je źli ludzie?</language>
	</row>
	<row id="msg_0571_T23R0501_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziadek zniknął...\nJest mi tak samotno...</language>
	</row>
	<row id="msg_0571_T23R0501_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SLOWPOKE, którego dał mi tata,\nwrócił! Jego ogon też odrósł!</language>
	</row>
	<row id="msg_0571_T23R0501_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tata pracuje w Silph, gdzie bada\nPoké Bale.\rMuszę zostać w domu z Dziadkiem\ni SLOWPOKE.</language>
	</row>
	<row id="msg_0571_T23R0501_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się!\nDam ci numer mojego dziadka. {YESNO 0}</language>
	</row>
	<row id="msg_0571_T23R0501_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Kurta\nw Pokégearze!</language>
	</row>
	<row id="msg_0571_T23R0501_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój dziadek może ci powiedzieć\nwięcej o Apricornach.</language>
	</row>
	<row id="msg_0571_T23R0501_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie? Dlaczego?\nNie chcesz rozmawiać z moim dziadkiem?</language>
	</row>
	<row id="msg_0571_T23R0501_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz porozmawiać z moim\ndziadkiem, prawda? {YESNO 0}</language>
	</row>
	<row id="msg_0571_T23R0501_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SLOWPOKE: ...\nZiew?</language>
	</row>
	<row id="msg_0571_T23R0501_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz trzy osoby, z krajobrazem\nw tle.\rTo Kurt, Profesor Oak, a pośrodku...\nkobieta o zdecydowanym spojrzeniu.</language>
	</row>
	<row id="msg_0571_T23R0501_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To posąg opiekuna lasu.</language>
	</row>
	<row id="msg_0571_T23R0501_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Radio jest włączone.\rTo Pogaduszki o Pokémonach\nProfesora Oaka!</language>
	</row>
	<row id="msg_0571_T23R0501_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Radio ogłasza powrót\nTeam Rocket!</language>
	</row>
</body>
