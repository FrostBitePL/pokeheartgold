<?xml version="1.0"?>
<body language="English">
	<row id="msg_0572_T24_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepłynąłeś morze, żeby tu dotrzeć?\rTo musiało być trudne.\rByłoby dużo łatwiej, gdyby twój\nPokémon znał atak Lot...\r</language>
	</row>
	<row id="msg_0572_T24_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ale nie użyjesz Lotu bez Odznaki\nz tutejszej Sali.\rJeśli pokonasz miejscowego Lidera,\nprzyjdź do mnie.\fBędę mieć dla ciebie miły prezent.</language>
	</row>
	<row id="msg_0572_T24_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Odznaka z Cianwood!\rW takim razie weź to HM.\r</language>
	</row>
	<row id="msg_0572_T24_00003" index="3">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0572_T24_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naucz swojego Pokémona Lotu.\rBędziesz mógł/mogła natychmiast\nlecieć do dowolnego znanego miejsca.</language>
	</row>
	<row id="msg_0572_T24_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój mąż przegrał z tobą, więc musi\ntrenować mocniej.\rI dobrze, bo zaczynał\ntrochę tyć.</language>
	</row>
	<row id="msg_0572_T24_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój plecak jest pełny.</language>
	</row>
	<row id="msg_0572_T24_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego jedynym hobby są pojedynki\nz silnymi Trenerami.\rChcesz dostać numer telefonu\nmojego męża? {YESNO 0}</language>
	</row>
	<row id="msg_0572_T24_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Chucka\nw Pokégearze!</language>
	</row>
	<row id="msg_0572_T24_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robi sobie przerwę od walenia\nw wodospad w środowe wieczory.\rWtedy powinien mieć czas\nna pogaduchy.</language>
	</row>
	<row id="msg_0572_T24_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, rozumiem.\nMój mąż nie byłby dobrym przeciwnikiem?</language>
	</row>
	<row id="msg_0572_T24_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz wymienić swój numer\nna numer mojego męża? {YESNO 0}</language>
	</row>
	<row id="msg_0572_T24_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używając Lotu, możesz natychmiast\nwrócić do Olivine.</language>
	</row>
	<row id="msg_0572_T24_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Głazy na północ od miasta można\nrozbić.\rMoże coś pod nimi ukrywają.\nTwój Pokémon mógłby użyć ataku\fRozbijanie Skał, żeby je zniszczyć.</language>
	</row>
	<row id="msg_0572_T24_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck, Lider Sali, trenuje sparingi\nze swoimi Pokémonami typu Walczący.</language>
	</row>
	<row id="msg_0572_T24_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eusine: Ej, {STRVAR_1 3, 0, 0}.\rCzy to przed chwilą nie było SUICUNE?\rZłapałem tylko krótkie spojrzenie,\nale wydawało mi się, że widziałem\fSUICUNE biegnące po falach.\rSUICUNE jest piękne i wspaniałe.\nA do tego pędzi przez miasta\fi drogi w niesamowitym tempie.\rTo cudowne...\rChcę zobaczyć SUICUNE z bliska...\rZdecydowałem.\nStoczę z tobą pojedynek jako Trener,\fżeby zdobyć szacunek SUICUNE!\rChodź, {STRVAR_1 3, 0, 0}.\nWalczmy teraz!</language>
	</row>
	<row id="msg_0572_T24_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś niesamowity/a, {STRVAR_1 3, 0, 0}!\rZaczynam rozumieć, czemu SUICUNE\nma na ciebie oko.\rBędę dalej szukał\nSUICUNE.\rCzuję, że jeszcze się spotkamy.\nDo zobaczenia!\r</language>
	</row>
	<row id="msg_0572_T24_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Między tym miejscem a Olivine\njest kilka wysp.\rPodobno mieszka tam mityczne\nmorskie stworzenie.</language>
	</row>
	<row id="msg_0572_T24_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cianwood City\nPort Rozbijających się Fal</language>
	</row>
	<row id="msg_0572_T24_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Cianwood City\nLider: Chuck\fJego Ryczące Pięści Mówią Same za Siebie</language>
	</row>
	<row id="msg_0572_T24_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Apteka w Cianwood City\r500 Lat Tradycji\nCzekamy na Twoje Pytania o Lekarstwa</language>
	</row>
	<row id="msg_0572_T24_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To dom Camerona,\nFotografa.\fZrób sobie zdjęcie na pamiątkę!</language>
	</row>
	<row id="msg_0572_T24_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wejście na drogę do\nSafari Zone.\rPrzeżyj ekscytujące spotkania\nz dzikimi Pokémonami i nawiąż\fprawdziwą więź!\rSafari Zone jest tuż za rogiem\nod tego wejścia!</language>
	</row>
</body>
