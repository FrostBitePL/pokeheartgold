<?xml version="1.0"?>
<body language="English">
	<row id="msg_0574_T24GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Ooomph!\nWalący wodospad prosto na\fmoją głowę...\fArrgh!\rCzemu zatrzymałeś/aś wodospad,\nżeby na mnie nie lał!\rWłaśnie zepsułeś/aś mi trening!\nMuszę cię ostrzec, że jestem silnym\fTrenerem, trenującym codziennie pod\ftym wodospadem!\rCo?\nTo nie ma nic wspólnego z Pokémonami?\r...\nTo prawda!\r...\n...\rChodź. Stoczymy pojedynek!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Urggh!\n...\rOooarrgh!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz! No, przestraszyłeś/aś się?\rCo?\nTo nie ma nic wspólnego z Pokémonami?\fTo prawda!\fChodź. Stoczymy pojedynek!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Hmm... Przegrałem?\rNo proszę!\nDobra. Zasługujesz na\fSztormową Odznakę!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nSztormową Odznakę od Chucka!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Sztormowa Odznaka pozwala\ntwojemu Pokémonowi lecieć do\fkażdego miasta, w którym już byłeś/aś!\rProszę, weź jeszcze to!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: To jest Skupiona Pięść.\rNie trafi, jeśli przeciwnik, którego\natakujesz, uderzy cię pierwszy, ale\fjeśli trafi, jest bardzo potężna!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Argh... Twój plecak jest pełny!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chuck: Wahahah!\nSpodobał mi się nasz pojedynek!\rAle przegrana to przegrana!\rOd teraz będę trenować\n24 godziny na dobę!</language>
	</row>
	<row id="msg_0574_T24GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest tak pochłonięty treningiem,\nże chyba cię nie zauważa.</language>
	</row>
	<row id="msg_0574_T24GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest tu duża korba.\nObrócisz ją? {YESNO 0}</language>
	</row>
	<row id="msg_0574_T24GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} obrócił(a) korbę\nz czystą siłą!\r</language>
	</row>
	<row id="msg_0574_T24GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Już się nie obraca.</language>
	</row>
	<row id="msg_0574_T24GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Cianwood City</language>
	</row>
	<row id="msg_0574_T24GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Cianwood City\rLider: Chuck\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
