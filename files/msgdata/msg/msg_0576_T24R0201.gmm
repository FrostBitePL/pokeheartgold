<?xml version="1.0"?>
<body language="English">
	<row id="msg_0576_T24R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja... Jestem w szoku!\rWszedł tu facet mniej więcej w twoim\nwieku, z przeszywającym spojrzeniem\fi długimi włosami.\rZastraszył mnie i zabrał mojego\nnajcenniejszego Pokémona!\rZostał mi jeszcze jeden, ale co jeśli\non wróci?\rWyglądasz na silnego/silną.\nMógłbyś/Mogłabyś zaopiekować się\fmoim Pokémonem na jakiś czas? {YESNO 0}</language>
	</row>
	<row id="msg_0576_T24R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, dziękuję!\nProszę, zaopiekuj się nim dobrze!\r</language>
	</row>
	<row id="msg_0576_T24R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nPokémona!</language>
	</row>
	<row id="msg_0576_T24R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja drużyna Pokémonów jest pełna.</language>
	</row>
	<row id="msg_0576_T24R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie... Co zrobię, jeśli on wróci?</language>
	</row>
	<row id="msg_0576_T24R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć! Jak tam mój Pokémon?\rChyba jestem już bezpieczny, więc czy\nmogę go odzyskać? {YESNO 0}</language>
	</row>
	<row id="msg_0576_T24R0201_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć! Jak tam mój Pokémon?</language>
	</row>
	<row id="msg_0576_T24R0201_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję!</language>
	</row>
	<row id="msg_0576_T24R0201_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, to nie jest mój Pokémon.</language>
	</row>
	<row id="msg_0576_T24R0201_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój Pokémon cię polubił.\rDobrze, powinieneś/aś go zatrzymać.\nAle obiecaj, że będziesz dla niego dobry/a!</language>
	</row>
	<row id="msg_0576_T24R0201_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie, nie...\nTo tak, jakby mnie okradziono.</language>
	</row>
	<row id="msg_0576_T24R0201_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dla Pokémona szczęściem jest bycie\nz osobą, która dobrze go traktuje.</language>
	</row>
	<row id="msg_0576_T24R0201_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\nOn niesie jakiś przedmiot.\fPowinieneś/aś go zatrzymać.</language>
	</row>
	<row id="msg_0576_T24R0201_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\nJego Poké Ball ma na sobie Kapsułę Balla!\fProszę, zdejmij ją.</language>
	</row>
	<row id="msg_0576_T24R0201_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh?\nTy... masz tylko jednego Pokémona!\fW takim razie nie możesz mi go oddać.</language>
	</row>
</body>
