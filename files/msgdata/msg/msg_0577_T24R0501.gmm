	</row>
	<row id="msg_0577_T24R0501_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój Tajemny Eliksir jest odrobinę za mocny.\fPodaję go tylko w nagłych wypadkach.</language>
	</row>
	<row id="msg_0577_T24R0501_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co tam?\nPotrzebujesz lekarstwa? {YESNO 0}</language>
	</row>
