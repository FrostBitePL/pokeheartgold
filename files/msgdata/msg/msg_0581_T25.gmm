<?xml version="1.0"?>
<body language="English">
	<row id="msg_0581_T25_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbudowali nową Wieżę Radiową,\nby zastąpić starą, skrzypiącą.</language>
	</row>
	<row id="msg_0581_T25_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłeś już w Kopule Pokéathlonu?\nTo ogromny obiekt sportowy, gdzie\fPokémony rywalizują ze sobą.\rTo było niesamowite widowisko!</language>
	</row>
	<row id="msg_0581_T25_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiem, że jest nowy Sklep\nz Rowerami, ale nigdzie go\fnie mogę znaleźć.</language>
	</row>
	<row id="msg_0581_T25_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skoro masz Rower...\nto znaczy, że dostałeś go ze Sklepu\fz Rowerami, prawda?\rDobrze!\nMogę więc powiedzieć, że gdzieś\fw tym mieście jest Sklep z Rowerami!</language>
	</row>
	<row id="msg_0581_T25_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy ten mężczyzna w czerni jest\nprzebrany za członka Team Rocket?\fCóż za głupota!</language>
	</row>
	<row id="msg_0581_T25_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy ten mężczyzna w czerni naprawdę\nnależał do Team Rocket?\fNie mogę w to uwierzyć!</language>
	</row>
	<row id="msg_0581_T25_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieża Radiowa w Goldenrod City to\nzabytkowy punkt orientacyjny.\rProwadzą teraz kampanię promocyjną.\rZmodyfikują twój Pokégear, by mógł\ntakże działać jako radio.</language>
	</row>
	<row id="msg_0581_T25_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieża Radiowa w Goldenrod City to\nzabytkowy punkt orientacyjny.\rProwadzą teraz kampanię promocyjną.\rZmodyfikują twój Pokégear, by mógł\ntakże działać jako radio.\rOch, twój Pokégear działa jako radio!</language>
	</row>
	<row id="msg_0581_T25_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">E-he-he-he...\nMiałem kłopoty za zabawę w piwnicy\fdomu towarowego.</language>
	</row>
	<row id="msg_0581_T25_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mężczyzna w tym namiocie ocenia\nimiona twoich Pokémonów.\rMoże nawet zmienić przezwisko\ntwojego Pokémona.</language>
	</row>
	<row id="msg_0581_T25_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że dam moim Pokémonom fajne\nprzezwiska jako nagrodę, jeśli dobrze\fspiszą się w Pokéathlonie.</language>
	</row>
	<row id="msg_0581_T25_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uff! To naprawdę duże miasto.\nNie wiem, gdzie co jest.</language>
	</row>
	<row id="msg_0581_T25_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiem, że można znaleźć Kopułę\nPokéathlonu, idąc Trasą 35 na północ\fi mijając lewą bramę...\rAle wygląda na to, że gubię się\nza każdym razem, gdy tu przyjeżdżam...</language>
	</row>
	<row id="msg_0581_T25_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc to jest Wieża Radiowa...\r</language>
	</row>
	<row id="msg_0581_T25_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czego chcesz, szkodniku?\nWynocha!\r</language>
	</row>
	<row id="msg_0581_T25_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co ty robisz?\nNatychmiast wracaj na stanowisko!\r</language>
	</row>
	<row id="msg_0581_T25_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony? To nic więcej jak\nnarzędzia do zarabiania pieniędzy!</language>
	</row>
	<row id="msg_0581_T25_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pilnujemy tu porządku.\nNie martw się!</language>
	</row>
	<row id="msg_0581_T25_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przejąć Wieżę Radiową...\rCo? To nie twoja sprawa!</language>
	</row>
	<row id="msg_0581_T25_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyglądasz strasznie młodo...\nJesteś nowy?</language>
	</row>
	<row id="msg_0581_T25_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, bachorze! Nie miejsce tu\ndla ciebie!\fSpadaj!</language>
	</row>
	<row id="msg_0581_T25_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, hej!\nMam to pod kontrolą!\rMoże pójdziesz do Wieży Radiowej?</language>
	</row>
	<row id="msg_0581_T25_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyjaźń z Pokémonami?\rTo mnie rozśmiesza!</language>
	</row>
	<row id="msg_0581_T25_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nasze marzenie wkrótce się spełni...\nTo była taka długa walka...</language>
	</row>
	<row id="msg_0581_T25_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kim jesteś? Nowy?\rSkończyły nam się mundury\nTeam Rocket.\rJeden z moich ludzi idzie po\nwięcej...\rCo mu tak długo zajmuje?\rStudio w tunelu jest\ntuż za rogiem.</language>
	</row>
	<row id="msg_0581_T25_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Że taki młody jak ty zdecydował się\nzostać członkiem Team Rocket...\fŚwietnie, dzieciaku!</language>
	</row>
	<row id="msg_0581_T25_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zejdź mi z drogi!\rMy, jako Trenerzy Sali, nigdy nie\npozwolimy Team Rocket na paskudztwa\fw naszym mieście!</language>
	</row>
	<row id="msg_0581_T25_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi hi!\rWy, Trenerzy Sali, potraficie być\nproblemem. Siedźcie w Sali i nie\fwchodźcie w drogę!</language>
	</row>
	<row id="msg_0581_T25_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Liderka Sali, Whitney, przebiegła,\nmówiąc: „Muszę zdobyć\fKartę Radiową!”</language>
	</row>
	<row id="msg_0581_T25_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C-co próbujesz zrobić?\nNie widzisz tego fajnego,\fczarnego jak smoła munduru,\fktóry noszę?\rNie boisz się Team Rocket? Co?</language>
	</row>
	<row id="msg_0581_T25_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie wyglądasz wystarczająco strasznie\nna członka Team Rocket w tym mundurze...\fZrób straszniejszą minę i powiedz:\f„Yyy!”\rI zaciśnij przy tym zęby!</language>
	</row>
	<row id="msg_0581_T25_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dokąd niby idziesz?\nJesteśmy właśnie w trakcie misji!</language>
	</row>
	<row id="msg_0581_T25_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dokąd niby idziesz?\nWieża Radiowa nie jest tutaj!</language>
	</row>
	<row id="msg_0581_T25_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GTS pozwala wymieniać Pokémony\nna całym świecie!\r...Poza tym, że mamy teraz coś\nważniejszego do zrobienia!</language>
	</row>
	<row id="msg_0581_T25_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli tak bardzo lubisz wymianę,\nzaczekaj, aż misja w Wieży Radiowej\fsię skończy.\rWtedy będziesz mieć mnóstwo czasu!</language>
	</row>
	<row id="msg_0581_T25_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwolnij!\rJestem jedynym, którego tu wysłano.\fNie sprawiaj mi więcej kłopotów,\fdobrze?\r</language>
	</row>
	<row id="msg_0581_T25_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kolej Magnetyczna Żarów-Kanto\nStacja Goldenrod City</language>
	</row>
	<row id="msg_0581_T25_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wieża Radiowa w Goldenrod City\rSieć Dostarczająca Regionowi Żarów\nCiekawe Informacje</language>
	</row>
	<row id="msg_0581_T25_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Goldenrod City\nLiderka: Whitney\fNiesamowicie Ładna Dziewczyna!</language>
	</row>
	<row id="msg_0581_T25_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Goldenrod City\nTętniące Życiem Wielkie Miasto</language>
	</row>
	<row id="msg_0581_T25_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sklep z Rowerami, Oddział Goldenrod\nŚwiat to Ścieżka Rowerowa!</language>
	</row>
	<row id="msg_0581_T25_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salon Gier w Goldenrod City\nBezpieczne i Solidne Miejsce Zabawy!</language>
	</row>
	<row id="msg_0581_T25_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oceniacz Imion\nOceń Przezwiska Swoich Pokémonów</language>
	</row>
	<row id="msg_0581_T25_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważaj!\nZejdź z Roweru w Tunelu</language>
	</row>
	<row id="msg_0581_T25_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważaj!\nZejdź z Roweru w Tunelu</language>
	</row>
	<row id="msg_0581_T25_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Globalny Terminal\rNiesamowity i Całkowicie\nGlobalny Terminal!\n</language>
	</row>
	<row id="msg_0581_T25_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kwiaciarnia w Goldenrod\rMały Sklep Dostarczający\nMnóstwo Piękna</language>
	</row>
</body>
