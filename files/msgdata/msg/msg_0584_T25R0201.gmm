<?xml version="1.0"?>
<body language="English">
	<row id="msg_0584_T25R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ech... Otworzyłem tu oddział,\nale nie mogę sprzedać moich\fRowerów. Dlaczego tak jest?\rMógłbyś pojeździć Rowerem\ni zareklamować go dla mnie? {YESNO 0}</language>
	</row>
	<row id="msg_0584_T25R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naprawdę? Świetnie!\rPodaj mi swoje imię i numer\ntelefonu, a pożyczę ci Rower. {YESNO 0}</language>
	</row>
	<row id="msg_0584_T25R0201_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0584_T25R0201_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Główny sklep jest w Cerulean\nw Kanto.\rPozdrów kierownika sklepu,\njeśli tam kiedyś trafisz!\rNasze Rowery są pierwszej klasy!\nMożesz jeździć nimi też w Kanto!</language>
	</row>
	<row id="msg_0584_T25R0201_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ech... Ach, ta ludzka\nuprzejmość...</language>
	</row>
	<row id="msg_0584_T25R0201_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To lśniący, nowy Rower!</language>
	</row>
</body>
