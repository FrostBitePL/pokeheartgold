<?xml version="1.0"?>
<body language="English">
	<row id="msg_0585_T25R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli dobrze traktujesz swojego\nPokémona, pokocha cię w zamian.\rOch? Pokaż mi swojego Pokémona...\r</language>
	</row>
	<row id="msg_0585_T25R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na naprawdę szczęśliwego!\nMusi cię bardzo kochać.</language>
	</row>
	<row id="msg_0585_T25R0301_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam wrażenie, że naprawdę\nci ufa.</language>
	</row>
	<row id="msg_0585_T25R0301_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest do ciebie przyjaźnie\nnastawiony. Wygląda na dość\fszczęśliwego.</language>
	</row>
	<row id="msg_0585_T25R0301_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest całkiem uroczy.</language>
	</row>
	<row id="msg_0585_T25R0301_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powinieneś traktować go lepiej.\nNie jest do ciebie przyzwyczajony.</language>
	</row>
	<row id="msg_0585_T25R0301_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na to, że w ogóle cię\nnie lubi. Wygląda złośliwie.</language>
	</row>
	<row id="msg_0585_T25R0301_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ciągle przegrywam walki, a moje\nPokémony w końcu mdleją...\rMoże dlatego moje Pokémony\nmnie nie lubią...</language>
	</row>
	<row id="msg_0585_T25R0301_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy używam przedmiotu na moim\nPokémonie, jest naprawdę zadowolony!</language>
	</row>
</body>
