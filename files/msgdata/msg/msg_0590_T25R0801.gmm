<?xml version="1.0"?>
<body language="English">
	<row id="msg_0590_T25R0801_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kiedyś podczas walki mój Pokémon\nnie mógł użyć żadnego ataku.\rPunkty Mocy, czyli PP, jego\nataków całkowicie się skończyły.</language>
	</row>
	<row id="msg_0590_T25R0801_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czasem zdrowy Pokémon może nie\nmóc użyć swoich ataków.\rJeśli tak się stanie, wylecz go\nw Centrum Pokémon lub użyj przedmiotu.</language>
	</row>
</body>
