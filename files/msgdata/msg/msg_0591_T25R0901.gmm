<?xml version="1.0"?>
<body language="English">
	<row id="msg_0591_T25R0901_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj, witaj!\nJestem oficjalnym Oceniaczem Imion!\rChcesz, żebym ocenił przezwiska\ntwoich Pokémonów? {YESNO 0}</language>
	</row>
	<row id="msg_0591_T25R0901_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Które przezwisko Pokémona\nmam ocenić?</language>
	</row>
	<row id="msg_0591_T25R0901_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}, tak? Hmm...\nTo przyzwoite przezwisko!\rAle mógłbym nadać lepsze?\nCo powiesz? {YESNO 0}</language>
	</row>
	<row id="msg_0591_T25R0901_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze więc. Jakie ma być nowe\nprzezwisko?\r</language>
	</row>
	<row id="msg_0591_T25R0901_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gotowe!\nI jak?\rOd teraz ten Pokémon będzie znany\njako {STRVAR_1 1, 0, 0}!\rTo lepsze imię niż wcześniej,\nprawda?\fGratulacje!</language>
	</row>
	<row id="msg_0591_T25R0901_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, dobrze. Rozumiem.\nOdwiedź mnie ponownie, jeśli\fzmienisz zdanie.</language>
	</row>
	<row id="msg_0591_T25R0901_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gotowe! Od teraz ten Pokémon będzie\nznany jako {STRVAR_1 1, 0, 0}!\rWygląda tak samo jak wcześniej?\nTo tylko ci się wydaje!\fJest znacznie lepsze!\fCóż za szczęście dla ciebie!</language>
	</row>
	<row id="msg_0591_T25R0901_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 1, 0, 0}, tak?\nTo naprawdę nienaganne przezwisko!\rZaopiekuj się dobrze {STRVAR_1 1, 0, 0}!</language>
	</row>
	<row id="msg_0591_T25R0901_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No, no.\nToż to zwykłe Jajko!</language>
	</row>
</body>
