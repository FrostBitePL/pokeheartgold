<?xml version="1.0"?>
<body language="English">
	<row id="msg_0592_T25R1001_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj w Domu Towarowym\nw Goldenrod.</language>
	</row>
	<row id="msg_0592_T25R1001_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dom towarowy ma przyzwoity\nasortyment.\rAle niektóre przedmioty są dostępne\ntylko jako nagrody z Salonu Gier.</language>
	</row>
	<row id="msg_0592_T25R1001_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jaki interes miałby tu członek\nTeam Rocket?\rNie sprzedajemy tu rozsądku.</language>
	</row>
	<row id="msg_0592_T25R1001_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aż nie mogę się doczekać, żeby\nznów dziś iść na zakupy!</language>
	</row>
	<row id="msg_0592_T25R1001_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy to Team Rocket, „Team Pocket”,\nczy cokolwiek innego... zostaw mnie\fw spokoju!\rJestem zajęty zakupami i nie mam\nczasu do stracenia!</language>
	</row>
	<row id="msg_0592_T25R1001_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mama jest dobra w polowaniu na\nokazje.\rZawsze kupuje rzeczy taniej.</language>
	</row>
	<row id="msg_0592_T25R1001_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mama powiedziała mi, żebym trzymał\nsię z dala od ludzi w czarnych\fgarniturach.</language>
	</row>
	<row id="msg_0592_T25R1001_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">1P Punkt Obsługi\n2P Rynek Trenera\f3P Kolekcja Bojowa\f4P Skrzynka z Lekami\f5P Kącik TM\f6P Atrium na Dachu</language>
	</row>
</body>
