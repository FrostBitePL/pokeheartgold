<?xml version="1.0"?>
<body language="English">
	<row id="msg_0593_T25R1002_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Panie w tym domu towarowym witają\nnawet takie dzieciaki jak ja\fz szacunkiem.\rTo nazywam profesjonalizmem!</language>
	</row>
	<row id="msg_0593_T25R1002_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Panie w tym domu towarowym nigdy nie\nzmieniają swojego podejścia.\rCzy to przed zwykłym klientem, czy\nprzed pracownikiem Genezy.\rTo nazywam profesjonalizmem!</language>
	</row>
	<row id="msg_0593_T25R1002_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Istnienie tego domu towarowego\nmówi mi, że Żarów to duże miasto.\rAsortyment tutaj jest niezrównany\nnigdzie indziej.</language>
	</row>
	<row id="msg_0593_T25R1002_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lepiej mnie posłuchaj.\rPrzestań już być pracownikiem\nGenezy!</language>
	</row>
	<row id="msg_0593_T25R1002_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dostałem mojego ABRA w Salonie Gier.\fTeraz to mój najlepszy partner.</language>
	</row>
	<row id="msg_0593_T25R1002_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, Geneza! Proszę, nie zabierajcie\nmi ABRA!</language>
	</row>
	<row id="msg_0593_T25R1002_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Towarzysz Podróży\n2P Rynek Trenera</language>
	</row>
</body>
