<?xml version="1.0"?>
<body language="English">
	<row id="msg_0594_T25R1003_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">J-j-jestem naprawdę niecierpliwy!\rUżywam X Szybkości w walce, by\nprzyspieszyć mojego Pokémona.</language>
	</row>
	<row id="msg_0594_T25R1003_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O rety...\nTeam Rocket już tu dotarł!</language>
	</row>
	<row id="msg_0594_T25R1003_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej! Gdy walczysz, używasz\nX Specjalnego?\rTo niesamowite. Naprawdę podbija\nAtak Specjalny!</language>
	</row>
	<row id="msg_0594_T25R1003_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy o tym nie myślałem, ale\nTeam Rocket też chodzi na zakupy...</language>
	</row>
	<row id="msg_0594_T25R1003_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dla Poszukiwaczy Zwycięstwa\n3P Kolekcja Bojowa</language>
	</row>
</body>
