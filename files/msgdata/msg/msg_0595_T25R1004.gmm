<?xml version="1.0"?>
<body language="English">
	<row id="msg_0595_T25R1004_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej. Uwielbiam silne Pokémony.\rKarmię je Proteiną, by podbić\nich Atak.</language>
	</row>
	<row id="msg_0595_T25R1004_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważam się za złego typa, ale\nnigdy nie lubiłem zadawać się\fz innymi złymi typami jak\fTeam Rocket.</language>
	</row>
	<row id="msg_0595_T25R1004_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żelazo dodaje twojemu\nPokémonowi Obrony.</language>
	</row>
	<row id="msg_0595_T25R1004_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team Rocket...\nCo tu robicie?</language>
	</row>
	<row id="msg_0595_T25R1004_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niektóre Pokémony ewoluują tylko\npoprzez wymianę.\rZnam cztery: MACHOKE, KADABRA,\nHAUNTER i, yy, GRAVELER.\fSłyszałem, że są też inne.</language>
	</row>
	<row id="msg_0595_T25R1004_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet Team Rocket nie okradłby\nwłasnych członków z Pokémonów,\fprawda?</language>
	</row>
	<row id="msg_0595_T25R1004_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozwól nam Wzmocnić Twojego\nPokémona! 4P Skrzynka z Lekami</language>
	</row>
</body>
