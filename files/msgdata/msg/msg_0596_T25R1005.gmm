<?xml version="1.0"?>
<body language="English">
	<row id="msg_0596_T25R1005_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj. Och, twój Pokémon...\r</language>
	</row>
	<row id="msg_0596_T25R1005_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest bardzo do ciebie przywiązany.\rTen atak powinien być idealny dla\ntakiej pary jak wy.\r</language>
	</row>
	<row id="msg_0596_T25R1005_00002" index="2">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0596_T25R1005_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest uroczy!\rPowinieneś nauczyć go dobrych\nataków z TM.</language>
	</row>
	<row id="msg_0596_T25R1005_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda trochę złowrogo.\nMoże to TM dla niego?\r</language>
	</row>
	<row id="msg_0596_T25R1005_00005" index="5">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0596_T25R1005_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na pewno są TM, które idealnie\npasują do twojego Pokémona.</language>
	</row>
	<row id="msg_0596_T25R1005_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tajemniczy Prezent.\rWystarczy krótki sygnał, a dostajesz\nprezent.</language>
	</row>
	<row id="msg_0596_T25R1005_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Opcja Tajemniczego Prezentu nie jest\nkompatybilna z Game Boy Color.</language>
	</row>
	<row id="msg_0596_T25R1005_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kolekcjonuję Pokémony.\nMasz może DROWZEE?\rChcesz wymienić go na mojego\nMACHOP? {YESNO 0}</language>
	</row>
	<row id="msg_0596_T25R1005_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hurra! Mam własnego DROWZEE!\fDzięki!</language>
	</row>
	<row id="msg_0596_T25R1005_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? To nie jest DROWZEE.\nCóż za rozczarowanie...</language>
	</row>
	<row id="msg_0596_T25R1005_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcesz się wymienić? Ech...</language>
	</row>
	<row id="msg_0596_T25R1005_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cześć, jak się miewa mój dawny MACHOP?</language>
	</row>
	<row id="msg_0596_T25R1005_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? Ty... należysz do Team Rocket?\nOd kiedy?</language>
	</row>
	<row id="msg_0596_T25R1005_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W niedziele przychodzi pewna pani,\nby sprawdzać Pokémony.\rNawet rozdaje TM!</language>
	</row>
	<row id="msg_0596_T25R1005_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team Rocket...\nCo oni tu robią?</language>
	</row>
	<row id="msg_0596_T25R1005_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie możesz zmienić imienia\nPokémonowi otrzymanemu w wymianie.\rImię odzwierciedla uczucia\npierwotnego Trenera do niego.</language>
	</row>
	<row id="msg_0596_T25R1005_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie powinieneś nosić takiego\nczarnego garnituru. Ludzie pomyślą,\fże należysz do Team Rocket.\rCo? Naprawdę do nich należysz?</language>
	</row>
	<row id="msg_0596_T25R1005_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ulepsz Swojego Pokémona\n5P Kącik TM</language>
	</row>
</body>
