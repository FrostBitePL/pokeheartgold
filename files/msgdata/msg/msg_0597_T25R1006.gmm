<?xml version="1.0"?>
<body language="English">
	<row id="msg_0597_T25R1006_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słuchasz radia?\rKtóre programy wolisz?\rJa lubię Hasło Bueny!\rGdy je łapię, robię notatki, żeby\nnie zapomnieć hasła.\rDlatego mój Pokégear jest pełen\ngryzmołów!</language>
	</row>
	<row id="msg_0597_T25R1006_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet Team Rocket zrozumiałby, jak\norzeźwiające jest słuchanie Radia\fna dachu, prawda?</language>
	</row>
	<row id="msg_0597_T25R1006_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jesteś zmęczony, spróbuj\nnapojów z Automatu.\fTwój Pokémon też je pokocha.</language>
	</row>
	<row id="msg_0597_T25R1006_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Team Rocket...\rPowinniście napić się czegoś\nz automatu i zrobić sobie przerwę.\rNajwyższy czas, żebyście zaczęli\nmyśleć, jak chcecie żyć.</language>
	</row>
	<row id="msg_0597_T25R1006_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrób sobie Przerwę od Zakupów!\n6P Atrium na Dachu</language>
	</row>
	<row id="msg_0597_T25R1006_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To automat z napojami.\nKtóry napój chcesz? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Klong!\rWypadła puszka {STRVAR_1 8, 0, 0}.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Klong!\rBonus! Wypadła kolejna puszka\n{STRVAR_1 8, 0, 0}.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Za mało pieniędzy...</language>
	</row>
	<row id="msg_0597_T25R1006_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdecydowano się nie kupować napoju.</language>
	</row>
	<row id="msg_0597_T25R1006_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obowiązkowa atrakcja Domu\nTowarowego w Goldenrod!\fWitaj w Kąciku Codziennego Losowania!\rMożesz spróbować za $300, a mamy\nwspaniałe nagrody!\rChcesz spróbować? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze. Proszę, wylosuj jeden!\r...\n...\r</language>
	</row>
	<row id="msg_0597_T25R1006_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow!\nWygrałeś nagrodę nr {STRVAR_1 50, 0, 0}!\rProszę, weź ją.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00013" index="13">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0597_T25R1006_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O rety...</language>
	</row>
	<row id="msg_0597_T25R1006_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O rety...\nTwoja Torba jest pełna.\rW takim razie zwrócimy ci pieniądze.\r</language>
	</row>
	<row id="msg_0597_T25R1006_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O rety...\nBrakuje ci pieniędzy.\rZapraszamy ponownie.</language>
	</row>
	<row id="msg_0597_T25R1006_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapraszamy ponownie.</language>
	</row>
	<row id="msg_0597_T25R1006_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagrody w niedzielę to:\rNr 1, TM02!\nNr 2, Luxury Ball!\fLub Nr 3, Jagoda!</language>
	</row>
	<row id="msg_0597_T25R1006_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagrody w poniedziałek to:\rNr 1, TM65!\nNr 2, Nest Ball!\fLub Nr 3, Jagoda!</language>
	</row>
	<row id="msg_0597_T25R1006_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagrody we wtorek to:\rNr 1, TM91!\nNr 2, Repeat Ball!\fLub Nr 3, Jagoda!</language>
	</row>
	<row id="msg_0597_T25R1006_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagrody w środę to:\rNr 1, TM57!\nNr 2, Net Ball!\fLub Nr 3, Jagoda!</language>
	</row>
	<row id="msg_0597_T25R1006_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagrody w czwartek to:\rNr 1, TM60!\nNr 2, Quick Ball!\fLub Nr 3, Jagoda!</language>
	</row>
	<row id="msg_0597_T25R1006_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagrody w piątek to:\rNr 1, TM42!\nNr 2, Dusk Ball!\fLub Nr 3, Jagoda!</language>
	</row>
	<row id="msg_0597_T25R1006_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagrody w sobotę to:\rNr 1, TM62!\nNr 2, Timer Ball!\fLub Nr 3, Jagoda!</language>
	</row>
	<row id="msg_0597_T25R1006_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Cóż za zbieg okoliczności!\nTo musiało się tak stać.\rChcesz wymienić się\nnumerami telefonu? Proszę? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Whitney\nw Pokégearze!</language>
	</row>
	<row id="msg_0597_T25R1006_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Jestem dostępna około\npołudnia w soboty.\rZadzwoń, gdy będziesz mieć czas.</language>
	</row>
	<row id="msg_0597_T25R1006_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Nie bądź taki niemiły.</language>
	</row>
	<row id="msg_0597_T25R1006_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Chcesz teraz poznać\nmój numer telefonu? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Może zrobimy sobie\nwspólne zdjęcie? {YESNO 0}</language>
	</row>
	<row id="msg_0597_T25R1006_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Dobrze!\nStań tuż obok mnie, właśnie tutaj!\r</language>
	</row>
	<row id="msg_0597_T25R1006_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Czyż nie wyglądamy razem\ndobrze?</language>
	</row>
	<row id="msg_0597_T25R1006_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whitney: Szkoda!</language>
	</row>
	<row id="msg_0597_T25R1006_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Album Zdjęć jest pełny.\rWejdź do PC, by usunąć\njakieś zdjęcia.</language>
	</row>
</body>
