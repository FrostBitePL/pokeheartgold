		<language name="English">MASZYNA TECHNICZNA</language>
	</row>
	<row id="msg_0603_T25SP0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TRZYMANE PRZEDMIOTY</language>
	</row>
	<row id="msg_0603_T25SP0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PODMIANKA\n2000 Monet</language>
