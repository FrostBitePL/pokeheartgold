		<language name="English">PIORUN\n10 000 Monet</language>
	</row>
	<row id="msg_0603_T25SP0101_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">JEDWABNY SZALIK\n1000 Monet</language>
	</row>
	<row id="msg_0603_T25SP0101_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">SZEROKI OBIEKTYW\n1000 Monet</language>
