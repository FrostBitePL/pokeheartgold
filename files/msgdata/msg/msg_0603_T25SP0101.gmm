		<language name="English">METRONOM\n1000 Monet</language>
	</row>
	<row id="msg_0603_T25SP0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ABRA{CURSOR_X 103}200 Monet</language>
	</row>
	<row id="msg_0603_T25SP0101_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">EKANS{CURSOR_X 103}700 Monet</language>
	</row>
	<row id="msg_0603_T25SP0101_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DRATINI{CURSOR_X 90}2100 Monet</language>
	</row>
	<row id="msg_0603_T25SP0101_00027" index="27">
