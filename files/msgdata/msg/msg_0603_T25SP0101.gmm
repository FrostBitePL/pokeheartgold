<?xml version="1.0"?>
<body language="English">
	<row id="msg_0603_T25SP0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wymieniamy twoje Monety na\nwspaniałe nagrody! {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbieraj Monety i wróć\nponownie!</language>
	</row>
	<row id="msg_0603_T25SP0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi! Potrzebujesz więcej\nMonet. {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 8, 0, 0}.\nZgadza się? {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę bardzo!\r</language>
	</row>
	<row id="msg_0603_T25SP0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi. Nie możesz nosić więcej.\r</language>
	</row>
	<row id="msg_0603_T25SP0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja drużyna jest pełna!\nZrób trochę miejsca, zanim\fwrócisz.</language>
	</row>
	<row id="msg_0603_T25SP0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz {STRVAR_1 0, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\n{STRVAR_1 0, 1, 0}! {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj!\rWymieniamy twoje Monety na\nwspaniałe nagrody! {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Schowałeś {STRVAR_1 8, 0, 0}\nw kieszeni {STRVAR_1 18, 1, 0}. {YESNO 0}</language>
	</row>
	<row id="msg_0603_T25SP0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ANULUJ</language>
	</row>
	<row id="msg_0603_T25SP0101_00012" index="12">
