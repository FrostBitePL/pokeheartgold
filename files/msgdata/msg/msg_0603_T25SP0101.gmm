		<language name="English">MIOTACZ OGNIA\n10 000 Monet</language>
	</row>
	<row id="msg_0603_T25SP0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PROMIEŃ LODU\n10 000 Monet</language>
	</row>
	<row id="msg_0603_T25SP0101_00019" index="19">
