<?xml version="1.0"?>
<body language="English">
	<row id="msg_0606_T26GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Dziękuję za pomoc w Latarni\nMorskiej...\rAle to jest coś innego. Pozwól, że\nsię przedstawię.\rJestem Wojas, Lider Sali. Mój młyn\nchodził na wodę, na parę i na prąd.\fPięćset lat i ani jednego dnia\nprzerwy.\rUżywam Pokémonów typu Electric!\rNie lekceważ ich. Prąd to nie żart.\r</language>
	</row>
	<row id="msg_0606_T26GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: ...Jesteś lepszym Trenerem\nniż ja, zarówno umiejętnościami, jak\fi życzliwością.\rZgodnie z zasadami Ligi, przyznaję\nci tę Odznakę.\r</language>
	</row>
	<row id="msg_0606_T26GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał(a)\nOdznakę Młyna od Wojas!</language>
	</row>
	<row id="msg_0606_T26GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Dzięki tej Odznace wszystkie\nPokémony, włącznie z wymienionymi do\fpoziomu 70, będą cię słuchać bez\nwahania.\rWeź proszę też to...\r</language>
	</row>
	<row id="msg_0606_T26GYM0101_00004" index="4">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0606_T26GYM0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Nazywa się Żelazny Ogon...\rTwój Pokémon uderzy cel swoim\ntwardym ogonem, czasem obniżając\fObronę celu...</language>
	</row>
	<row id="msg_0606_T26GYM0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Nie wiem, jak to powiedzieć,\nale powodzenia...</language>
	</row>
	<row id="msg_0606_T26GYM0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Dawno się nie widzieliśmy.\rYym... Mam się dobrze, dziękuję.\rNie wiem, jak to powiedzieć,\nale... nic...</language>
	</row>
	<row id="msg_0606_T26GYM0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Yym... E...\rWymienisz się swoim Pokémonem na\nmojego? {YESNO 0}</language>
	</row>
	<row id="msg_0606_T26GYM0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Naprawdę? Bardzo dziękuję!\rBędę zadowolony z każdego Pokémona!\r</language>
	</row>
	<row id="msg_0606_T26GYM0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Och, aha, rozumiem.\nTo rozczarowujące, ale rozumiem.</language>
	</row>
	<row id="msg_0606_T26GYM0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Bardzo dziękuję.\nZaopiekuję się nim dobrze.</language>
	</row>
	<row id="msg_0606_T26GYM0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Nie masz czasem ochoty\nwyszorować Pokémonów typu\fStalowy? Prawda?</language>
	</row>
	<row id="msg_0606_T26GYM0101_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wymienisz się {STRVAR_1 1, 1, 0}? {YESNO 0}</language>
	</row>
	<row id="msg_0606_T26GYM0101_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Ja też lubię Jajka, ale\nchciałbym Pokémona, {STRVAR_1 3, 0, 0}.\rTakiego, który ma trochę treningu...</language>
	</row>
	<row id="msg_0606_T26GYM0101_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas: Byłabym bardzo wdzięczna...\nAle nie mogę przyjąć tak\fcennego Pokémona.</language>
	</row>
	<row id="msg_0606_T26GYM0101_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas, Lider Sali? Jest w Latarni\nMorskiej.\rOpiekuje się chorym Pokémonem.\rSilny Trener jest jednocześnie\nwspółczujący...</language>
	</row>
	<row id="msg_0606_T26GYM0101_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wojas używa Pokémonów typu Electric.\rStara się ukryć swoją czułość za\nchłodną rzeczowością.</language>
	</row>
	<row id="msg_0606_T26GYM0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To było niesamowite.\fTyp Stalowy, co?\fCóż za zacięta walka!</language>
	</row>
	<row id="msg_0606_T26GYM0101_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiedziałem, że tu przyjdziesz.\rDziękuję za pomoc Liderce Sali,\nale walka to osobna sprawa.\rDawaj!</language>
	</row>
	<row id="msg_0606_T26GYM0101_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Imponujące!\rPowinieneś kontynuować podróż\nw różne miejsca.\rSkoro potrafisz Surfować, może\nspróbujesz na Jeziorze Wściekłości?</language>
	</row>
	<row id="msg_0606_T26GYM0101_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chichot...\rWiem, jak zdolny jesteś, z Latarni\nMorskiej.\rCzas pokazać tę stronę siebie\nWojasowi! Powodzenia!</language>
	</row>
	<row id="msg_0606_T26GYM0101_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś niesamowity...\rPowinieneś celować jeszcze wyżej,\nskoro masz taki potencjał.\rByłeś już w Imbramowicach?</language>
	</row>
	<row id="msg_0606_T26GYM0101_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Siedlimowicach</language>
	</row>
	<row id="msg_0606_T26GYM0101_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Siedlimowicach\rLider: Wojas\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
