<?xml version="1.0"?>
<body language="English">
	<row id="msg_0607_T26PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony stają się bardziej\nprzyjazne, gdy spędzasz z nimi czas.</language>
	</row>
	<row id="msg_0607_T26PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogą świecić jak jasne światło -\njak latarnia nocą, by nas prowadzić...\rMogą przenieść nas przez wodę na\nswoich grzbietach, gdy nie mamy\fłodzi...\rPokémony pomagają nam wszędzie.\fNie wyobrażam sobie bez nich życia!</language>
	</row>
	<row id="msg_0607_T26PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest ktoś w Cianwood City,\nza morzem.\rSłyszałem, jak przechwalał się\nswoim rzadkim Pokémonem.</language>
	</row>
	<row id="msg_0607_T26PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...No!\nGotowe!\fNa pewno kogoś zaskoczy!\r</language>
	</row>
	<row id="msg_0607_T26PC0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, jesteś Trenerem?\rPrzybyłeś w idealnym momencie!\nWłaśnie skończyłem zakładać moją\fKapsułkę do Bala na Poké Bal.\rChcesz zawalczyć i zachwycić się\nmoją dekoracją? {YESNO 0}</language>
	</row>
	<row id="msg_0607_T26PC0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze!\nJuż idę!\r</language>
	</row>
	<row id="msg_0607_T26PC0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz zmienić swoje Poké Bale\nw swoje własne, wyjątkowe dzieła,\fdodając Pieczątki.\rCzyż to nie super, mieć Poké Bal,\njaki tylko ty masz na całym\fświecie? Spróbuj!\rOch, pamiętaj, żeby założyć\nKapsułkę do Bala na Poké Bal,\fgdy będzie gotowa!</language>
	</row>
	<row id="msg_0607_T26PC0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, naprawdę?\rPorozmawiaj ze mną, jeśli kiedyś\nzechcesz zobaczyć moją Kapsułkę\fdo Bala!</language>
	</row>
	<row id="msg_0607_T26PC0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz chcesz zobaczyć moją\nKapsułkę do Bala?\rZawalcz ze mną, żebym mógł ci\nją pokazać! {YESNO 0}</language>
	</row>
</body>
