<?xml version="1.0"?>
<body language="English">
	<row id="msg_0611_T26R0701_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty!\nJak idzie trening twojego\nPokémona?\rZauważyłeś kiedyś, że w górach\nczasem są okrągłe głazy prosto\fna twojej drodze...?\rMożesz je przesunąć ukrytym\natakiem Siła!\rWędrowcy na Mt. Mortar czasem mają\nzapasowe, tak przynajmniej słyszałem...</language>
	</row>
	<row id="msg_0611_T26R0701_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chlip...chlip...\r...Krztuszę się!\nUch... Krztuszę się!\rFff! To było blisko.\nPowinienem żuć, zanim połknę jedzenie.</language>
	</row>
	<row id="msg_0611_T26R0701_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ilekroć trafiam do Olivine,\nzawsze odwiedzam Kawiarnię Olivine.\rWszystko w menu sprawia, że czuję\nsię silniejszy. Nie mogę przestać\fjeść!</language>
	</row>
	<row id="msg_0611_T26R0701_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Menu Kawiarni Olivine jest pełne\nsytych dań dla krzepkich Żeglarzy!</language>
	</row>
	<row id="msg_0611_T26R0701_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Cześć!\n...!\rTe puste talerze przede mną\nnie wszystkie są moje...\rEe...\rTak naprawdę, osoba, która siedziała\ntu przede mną, dużo zjadła...\rW każdym razie, chcesz wymienić\nsię numerami telefonu? {YESNO 0}</language>
	</row>
	<row id="msg_0611_T26R0701_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} zapisał(a) Jasmine\nw Pokégearze!</language>
	</row>
	<row id="msg_0611_T26R0701_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Teraz możemy się\nkontaktować w każdej chwili.\rPowinnam móc z tobą walczyć\nokoło południa w środy.\fBędę czekać na twój telefon!</language>
	</row>
	<row id="msg_0611_T26R0701_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Och... Rozumiem...</language>
	</row>
	<row id="msg_0611_T26R0701_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Zmieniłeś zdanie?\nWymienisz się numerami? {YESNO 0}</language>
	</row>
	<row id="msg_0611_T26R0701_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Wygląda na to, że...\nczęsto się na siebie wpadamy.\rMoże zrobimy sobie zdjęcie\nna pamiątkę? {YESNO 0}</language>
	</row>
	<row id="msg_0611_T26R0701_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Gotowy?\r</language>
	</row>
	<row id="msg_0611_T26R0701_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Świetnie ci poszło.\nDobrze wyglądamy.</language>
	</row>
	<row id="msg_0611_T26R0701_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasmine: Rozumiem...</language>
	</row>
	<row id="msg_0611_T26R0701_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Album Zdjęć jest pełny.\rWejdź do PC, by usunąć\njakieś zdjęcia.</language>
	</row>
</body>
