<?xml version="1.0"?>
<body language="English">
	<row id="msg_0613_T27FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój EEVEE wyewoluował w ESPEON.\rAle EEVEE mojego przyjaciela\nzmienił się w UMBREON.\rZastanawiam się, dlaczego? Oboje\nwychowywaliśmy nasze EEVEE tak samo...</language>
	</row>
	<row id="msg_0613_T27FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli użyjesz Ożywiacza, zemdlony\nPokémon od razu się obudzi.</language>
	</row>
</body>
