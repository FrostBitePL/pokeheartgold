<?xml version="1.0"?>
<body language="English">
	<row id="msg_0618_T27R0501_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{SIZE 200}Hej! Hej!{SIZE 100}\r</language>
	</row>
	<row id="msg_0618_T27R0501_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przestań tańczyć taki poważny\ntaniec! Pokaż mi coś w stylu\ftańca hula!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Nie powinieneś narzucać mi\ntakiej prośby.\r</language>
	</row>
	<row id="msg_0618_T27R0501_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co?\nMówisz mi, że nie szanujesz tego,\fczego chce klient?\r</language>
	</row>
	<row id="msg_0618_T27R0501_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, w takim razie pokażę ci,\njak się tańczy.\rPokażę ci coś świetnego.\nUahahaha!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? Kim jesteś?\rŚmiesz stawać mi na drodze?\r</language>
	</row>
	<row id="msg_0618_T27R0501_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O nie!\nSprawiasz, że wyglądam jak łotr!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ups!\nMam ważną misję.\rJeśli dowiedzą się, że marnowałem\ntu czas, każą mi zaczynać od nowa\fjako najniższy szeregowiec Team\fRocket!\rLepiej już sobie pójdę!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...</language>
	</row>
	<row id="msg_0618_T27R0501_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz być {STRVAR_1 3, 0, 0}, prawda?\nTo było naprawdę znakomite.\fMiły i silny...\fDobry też w wychowywaniu Pokémonów...\rTa osoba naprawdę wie, czego szukać\nu ludzi...\rOhoho! To ja tylko mówiłam do\nsiebie.\fNieważne.</language>
	</row>
	<row id="msg_0618_T27R0501_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dla Dziewczyn w Kimonach takich\njak ja, taniec jest wszystkim.\rNigdy nie było dnia bez ćwiczeń\ntaneczych.\rZ Pokémonami jest tak samo.\rRosną z tobą po trochu każdego dnia.</language>
	</row>
	<row id="msg_0618_T27R0501_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj.\nMam na imię Zuki.\fSpotkałam cię wcześniej w Łażanach.\rBy sprowadzić z powrotem HO-OH,\npotrzebowaliśmy kogoś z odpowiednią\fwięzią z Pokémonami.\rPoprosiliśmy Wacka, by dał to\nTajemnicze Jajko temu, kto pokaże\fprawdziwy potencjał.\rJajko trafiło od Wacka do Profesora\nMariusza, a następnie do ciebie.\rJednak sama czystość serca nie\nwystarczy, by stawić czoła mocy\ftego Pokémona.\fMuszę cię sprawdzić.\rJesteś gotowy? {YESNO 0}</language>
	</row>
	<row id="msg_0618_T27R0501_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj.\nMam na imię Zuki.\fSpotkałam cię wcześniej w Łażanach.\rBy sprowadzić z powrotem LUGIĘ,\npotrzebowaliśmy kogoś z odpowiednią\fwięzią z Pokémonami.\rPoprosiliśmy Wacka, by dał to\nTajemnicze Jajko temu, kto pokaże\fprawdziwy potencjał.\rJajko trafiło od Wacka do Profesora\nMariusza, a następnie do ciebie.\rJednak sama czystość serca nie\nwystarczy, by stawić czoła mocy\ftego Pokémona.\fMuszę cię sprawdzić.\rJesteś gotowy? {YESNO 0}</language>
	</row>
	<row id="msg_0618_T27R0501_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprawdzę, czy jesteś dobrym\nTrenerem Pokémon.\rJesteś gotowy? {YESNO 0}</language>
	</row>
	<row id="msg_0618_T27R0501_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku...\nPoczekam, aż będziesz gotowy.</language>
	</row>
	<row id="msg_0618_T27R0501_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś dość silny.\rPomogłeś mi w Ilex Forest.\rMam na imię Naoko. To ja jestem\ntą, która nie radzi sobie zbyt\fdobrze z kierunkami.\rNa własne oczy widziałam, jak\npokonałeś Team Rocket, gdy Kurt\fmiał kłopoty przy Studni SLOWPOKE.\rPozwól, że rzucę ci wyzwanie,\ntobie i twojemu Pokémonowi!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś niezłym Trenerem.\rPamiętam, jak przegoniłeś tego\nszeregowca Team Rocket właśnie\fstąd.\rMuszę ci za to podziękować.\rChociaż tak naprawdę sama też\njestem Trenerem.\rTa, która wie najwięcej, mówi\nnajmniej!\fJestem Miki - Dziewczyna\nw Kimonie!\rPozwól, że rzucę ci wyzwanie,\ntobie i twojemu Pokémonowi!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znakomity duch walki!\rZepchnąłeś mnie z lodu, popychając\nod tyłu.\rTo ja jeżdżę na łyżwach w sandałach.\fJestem Sayo - Dziewczyna\nw Kimonie!\rSłuchałam w Legowisku Smoków, gdy\nzdałeś próbę Starszego.\rPozwól, że rzucę ci wyzwanie,\ntobie i twojemu Pokémonowi!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem ostatnia.\rByłeś tak niezawodny w Tunelu\nGoldenrod. To ja kręcę się nawet\fpod ziemią.\rJestem Kuni - Dziewczyna\nw Kimonie!\rPatrzyłam na ciebie z podziwem,\ngdy udaremniłeś misję Team Rocket,\fby przejąć Wieżę Radiową.\fTeraz musisz pokazać mi swoją siłę.\rPozwól, że rzucę ci wyzwanie,\ntobie i twojemu Pokémonowi!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porozmawiaj z Zuki na środku,\ngdy będziesz gotowy.</language>
	</row>
	<row id="msg_0618_T27R0501_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie myliłyśmy się co do ciebie.\nRzeczywiście jesteś tego godny...\rProszę, weź to.\r</language>
	</row>
	<row id="msg_0618_T27R0501_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starsze siostry!\rWłaśnie zobaczyłam wielki cień\nPokémona nad Wieżą Dzwonów!\rTo może być...\r</language>
	</row>
	<row id="msg_0618_T27R0501_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starsze siostry!\rWłaśnie zobaczyłam wielki cień\nPokémona w wodach Wysp Wirów!\rTo może być...\r</language>
	</row>
	<row id="msg_0618_T27R0501_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zuki: {STRVAR_1 3, 0, 0}!\nBędziemy w Wieży Dzwonów.\fDo zobaczenia tam!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zuki: {STRVAR_1 3, 0, 0}!\nBędziemy na Wyspach Wirów.\fDo zobaczenia tam!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co jest z tym szeregowcem Team\nRocket, czepiającym się mojej\fDziewczyny w Kimonie?\rJesteś Trenerem, prawda?\fProszę, pomóż jej!</language>
	</row>
	<row id="msg_0618_T27R0501_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wspaniale!\nByłeś tak odważny jak na swój wiek!\rTo był rzadki widok!\nChcę, żebyś to dostał.\fNie wstydź się - weź to!\r</language>
	</row>
	<row id="msg_0618_T27R0501_00027" index="27">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0618_T27R0501_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Surfowanie.\nTo atak, który pozwala Pokémonowi\fłatwo pływać po wodzie.\r</language>
	</row>
	<row id="msg_0618_T27R0501_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziewczyny w Kimonach to nie tylko\nznakomite tancerki, są też biegłe\fw Pokémonach.\rAle walczą tylko z dobrych powodów.\rNie wiem, czy zdołałbyś je pokonać,\ngdyby pokazały, na co je stać...</language>
	</row>
	<row id="msg_0618_T27R0501_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">PSYDUCK: Kwa kwa!</language>
	</row>
	<row id="msg_0618_T27R0501_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten mężczyzna jest zawsze ze swoim\nPSYDUCK.\rMówi, że chce Pokémona, który\numie surfować i tańczyć.\rCzy próbuje stworzyć gwiazdę\npływania synchronicznego?</language>
	</row>
	<row id="msg_0618_T27R0501_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och... Au...!\rTen ból brzucha!\rNie pozwoliłbym temu facetowi tak\nsię zachowywać, gdyby nie ten ból...!</language>
	</row>
	<row id="msg_0618_T27R0501_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miałem być bohaterem...!\rTyle dobrego ze zbliżenia się do\nDziewczyny w Kimonie!\n</language>
	</row>
	<row id="msg_0618_T27R0501_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och... Au...!\rTen ból pleców!\rNie pozwoliłbym temu facetowi tak\nsię zachowywać, gdyby nie ten ból...!</language>
	</row>
	<row id="msg_0618_T27R0501_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och... Au...!\rTen ból zęba!\rNie pozwoliłbym temu facetowi tak\nsię zachowywać, gdyby nie ten ból...! </language>
	</row>
	<row id="msg_0618_T27R0501_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziewczyny w Kimonach są takie\npiękne...\rAle muszą przejść przez rygorystyczny\ntrening.\rI muszą nauczyć się przestrzegać\nzwyczajów, zanim pojawią się\fpublicznie.\rAle jeśli coś kochasz, wszystko\njest możliwe.</language>
	</row>
	<row id="msg_0618_T27R0501_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrobić coś tak strasznego\nDziewczynie w Kimonie!\rNie rozumiem, jak młodzi ludzie\nzachowują się w dzisiejszych czasach.</language>
	</row>
	<row id="msg_0618_T27R0501_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naprawdę niezły Trener jak na\nswój wiek!</language>
	</row>
	<row id="msg_0618_T27R0501_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To biurko jest używane do\npewnych programów...</language>
	</row>
	<row id="msg_0618_T27R0501_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję za pomoc onegdaj.</language>
	</row>
	<row id="msg_0618_T27R0501_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ćwiczymy taniec.</language>
	</row>
	<row id="msg_0618_T27R0501_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję za pomoc onegdaj.\rPięknie udowodniłeś, że więź między\nludźmi może rozciągać się na więź\fmiędzy ludźmi a Pokémonami...\rWszystkie doceniamy, że sprostałeś\nnaszym oczekiwaniom, {STRVAR_1 3, 0, 0}!\rJeśli czujesz, że to doświadczenie\ncię czegoś nauczyło, osobami, którym\fpowinieneś podziękować, nie jesteśmy\fmy, lecz Wacek i Profesor Mariusz...</language>
	</row>
	<row id="msg_0618_T27R0501_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ćwiczymy taniec.</language>
	</row>
	<row id="msg_0618_T27R0501_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję za pomoc onegdaj.</language>
	</row>
	<row id="msg_0618_T27R0501_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprawdzę, jak silną więź masz\nze swoim Pokémonem!\r</language>
	</row>
</body>
