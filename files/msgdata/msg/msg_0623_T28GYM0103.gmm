<?xml version="1.0"?>
<body language="English">
	<row id="msg_0623_T28GYM0103_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beniamin to weteran, który przez\ntrzydzieści lat pracował w\f„Silesii”.\rJak się przekonasz, jego ataki mają\nw sobie coś zjadliwego.\rJesteś gotowy/a na truciznę?\rTo znaczy... zachowaj gorącego ducha\nwalki, bo będzie ci potrzebny!</language>
	</row>
	<row id="msg_0623_T28GYM0103_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beniamin to coś, ale ty jesteś coś\njeszcze innego!\rTo była gorąca walka, która\nprzekroczyła pokolenia!</language>
	</row>
	<row id="msg_0623_T28GYM0103_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Imbramowicach</language>
	</row>
	<row id="msg_0623_T28GYM0103_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sala Pokémon w Imbramowicach\rLider: Beniamin\nCertyfikowany Trener!\f{STRVAR_1 3, 0, 0}</language>
	</row>
</body>
