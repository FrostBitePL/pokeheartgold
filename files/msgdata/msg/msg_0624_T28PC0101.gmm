<?xml version="1.0"?>
<body language="English">
	<row id="msg_0624_T28PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co to ma być? Team Rocket\nwrócił?\rWidziałem jakichś ludzi w czerni\nnad Lake of Rage.</language>
	</row>
	<row id="msg_0624_T28PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie pozwalam moim Pokémonom\nzbyt wcześnie ewoluować.\rUczę je najpierw pewnych ataków,\nzanim pozwolę im ewoluować.</language>
	</row>
	<row id="msg_0624_T28PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony faktycznie stają się silniejsze,\ngdy ewoluują, ale wolniej uczą się\fteż nowych ataków.</language>
	</row>
</body>
