<?xml version="1.0"?>
<body language="English">
	<row id="msg_0625_T28R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszałem, że nad Lake of Rage\npojawił się czerwony GYARADOS.\rTo dziwne, bo nawet zwykłe\nGYARADOSY są w tym jeziorze rzadkie...</language>
	</row>
	<row id="msg_0625_T28R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój ulubiony program radiowy?\nPowiedziałbym, że Pokémon Music.</language>
	</row>
	<row id="msg_0625_T28R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszę w radiu jakiś śmiech...\fTo przerażające.</language>
	</row>
</body>
