<?xml version="1.0"?>
<body language="English">
	<row id="msg_0627_T29R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Zawędrowałeś/aś daleko...\nTutaj medytowałem. We mnie\fobudziła się nowa moc.\rPozwól, że podzielę się moją mocą\nz twoim Pokémonem. Weź to, dziecko.\r</language>
	</row>
	<row id="msg_0627_T29R0101_00001" index="1">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0627_T29R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz to? To Moc Ukryta!\rCzerpie z mocy Pokémona,\nby zaatakować.\rPamiętaj: jej typ i siła zależą\nod Pokémona, który jej używa.</language>
	</row>
	<row id="msg_0627_T29R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie masz na to miejsca...</language>
	</row>
	<row id="msg_0627_T29R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Medytuję...</language>
	</row>
</body>
