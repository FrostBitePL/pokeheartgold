<?xml version="1.0"?>
<body language="English">
	<row id="msg_0632_T30PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Głęboko w odległym Indigo Plateau\nznajduje się Liga Pokémon.\rSłyszałem, że zbierają się tam\nnajlepsi Trenerzy z całego kraju.</language>
	</row>
	<row id="msg_0632_T30PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Był taki atak, którego musiałem\nnauczyć mojego Pokémona.\rWięc poszedłem do Kasownika Ataków,\nżeby zapomniał atak z HM.</language>
	</row>
	<row id="msg_0632_T30PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówią, że za Salą Pokémon jest\nspecjalna jaskinia, gdzie Liderzy Sal\fmogą trenować.</language>
	</row>
</body>
