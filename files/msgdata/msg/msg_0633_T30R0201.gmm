	<row id="msg_0633_T30R0201_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Klan Trenerów, którzy potrafią swobodnie\ndowodzić Pokémonami typu Smoczy,\fmieszka właśnie tutaj, w Blackthorn.\rDlatego w tym mieście krąży\nwiele legend o smokach.</language>
	</row>
	<row id="msg_0633_T30R0201_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Clair i Lance też trenowali tutaj,\nzdobywając umiejętności jako\fTrenerzy Pokémonów!</language>
	</row>
	<row id="msg_0633_T30R0201_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DRATINI: Draa!</language>
	</row>
