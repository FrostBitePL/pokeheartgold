<?xml version="1.0"?>
<body language="English">
	<row id="msg_0634_T30R0301_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DRAGONAIR jest słodki, ale go nie mam.\nMasz DRAGONAIRA㊛?\rChcesz go wymienić na mojego DODRIO? {YESNO 0}</language>
	</row>
	<row id="msg_0634_T30R0301_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow! Dziękuję!\nZawsze chciałem DRAGONAIRA!</language>
	</row>
	<row id="msg_0634_T30R0301_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To nie jest DRAGONAIR㊛.\nProszę, wymień się ze mną, jeśli takiego zdobędziesz.</language>
	</row>
	<row id="msg_0634_T30R0301_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcesz się wymienić?\nOch, szkoda...</language>
	</row>
	<row id="msg_0634_T30R0301_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak się miewa ten DODRIO, którego ci\ndałem w zamian?\rTwój DRAGONAIR jest taki słodki!</language>
	</row>
	<row id="msg_0634_T30R0301_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och?\nTwój {STRVAR_1 0, 0, 0}...\r</language>
	</row>
	<row id="msg_0634_T30R0301_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pracował niesamowicie ciężko,\nprawda?\rW nagrodę, proszę, daj mu\nWstążkę Wysiłku.\r</language>
	</row>
	<row id="msg_0634_T30R0301_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0} otrzymał(a)\nWstążkę Wysiłku.\r</language>
	</row>
	<row id="msg_0634_T30R0301_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1, 0} przypiął(ęła) Wstążkę\nWysiłku Pokémonowi {STRVAR_1 0, 0, 0}.</language>
	</row>
	<row id="msg_0634_T30R0301_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musi popracować trochę ciężej.\rJeśli to zrobi, dam twojemu\nPokémonowi coś fajnego.</language>
	</row>
	<row id="msg_0634_T30R0301_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzę, że pracuje trochę ciężej.\rAle będzie potrzebować jeszcze\nwięcej wysiłku!</language>
	</row>
	<row id="msg_0634_T30R0301_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzę, że pracuje ciężko.\rAle będzie potrzebować jeszcze\ntrochę więcej wysiłku!</language>
	</row>
	<row id="msg_0634_T30R0301_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzę, że pracuje całkiem ciężko.\rAle będzie potrzebować odrobinę\nwięcej wysiłku!</language>
	</row>
	<row id="msg_0634_T30R0301_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzę, że pracuje tak ciężko.\rJest już prawie u celu.\nJeszcze odrobina wysiłku,\fi będzie gotowy!</language>
	</row>
	<row id="msg_0634_T30R0301_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och! Ta Wstążka Wysiłku dobrze\nwygląda na twoim {STRVAR_1 0, 0, 0}!</language>
	</row>
</body>
