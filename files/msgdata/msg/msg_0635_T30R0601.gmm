<?xml version="1.0"?>
<body language="English">
	<row id="msg_0635_T30R0601_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um...\nKim mówiłeś/aś, że jestem?\r...\n...\rAch, tak, już pamiętam!\nJestem Kasownikiem Ataków!\r</language>
	</row>
	<row id="msg_0635_T30R0601_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyszedłeś/aś, żebym sprawił,\nby twój Pokémon zapomniał jakiś atak? {YESNO 0}</language>
	</row>
	<row id="msg_0635_T30R0601_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Który Pokémon powinien zapomnieć atak?\r</language>
	</row>
	<row id="msg_0635_T30R0601_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pamiętaj o mnie, gdy będzie trzeba\nzapomnieć jakiś atak.</language>
	</row>
	<row id="msg_0635_T30R0601_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon zna tylko jeden atak,\nwięc nie może go zapomnieć...\r</language>
	</row>
	<row id="msg_0635_T30R0601_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? To Jajko.\nŻadne Jajko nie powinno znać ataków.\r</language>
	</row>
	<row id="msg_0635_T30R0601_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze więc.\nKtóry atak ma zostać zapomniany?\r</language>
	</row>
	<row id="msg_0635_T30R0601_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hm! Atak {STRVAR_1 6, 0, 0}?\nCzy ten atak ma zostać zapomniany? {YESNO 0}</language>
	</row>
	<row id="msg_0635_T30R0601_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zadziałało idealnie!\rTwój Pokémon całkowicie zapomniał\natak {STRVAR_1 6, 0, 0}.</language>
	</row>
	<row id="msg_0635_T30R0601_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja?\nJestem Maniakiem Ataków Pokémonów.\rZnam każdy atak, jakiego Pokémony\nuczą się, awansując na poziomy, i mogę\fsprawić, że Pokémon sobie przypomni\ftaki atak.\rMogę sprawić, że twój Pokémon\nprzypomni sobie atak, jeśli chcesz.\rAle...ehem! To będzie cię coś\nkosztować.\rSprawię, że Pokémon przypomni sobie\natak, jeśli wymienisz się ze mną\fŁuską Serca.</language>
	</row>
	<row id="msg_0635_T30R0601_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ha! To to! To prawdziwa,\nautentyczna Łuska Serca!\rZgadnę, chcesz, żebym nauczył\njednego z twoich Pokémonów ataku?\r</language>
	</row>
	<row id="msg_0635_T30R0601_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli któryś z twoich Pokémonów\nbędzie musiał nauczyć się ataku,\fwróć z Łuską Serca.</language>
	</row>
	<row id="msg_0635_T30R0601_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Który Pokémon potrzebuje nauki?\r</language>
	</row>
	<row id="msg_0635_T30R0601_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Który atak ma sobie przypomnieć?\r</language>
	</row>
	<row id="msg_0635_T30R0601_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przykro mi...\rNie ma ataku, który mógłbym sprawić,\nby ten Pokémon sobie przypomniał.</language>
	</row>
	<row id="msg_0635_T30R0601_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hunh?\rNie sądzisz, że byłoby trudno\nJajku przypomnieć sobie atak?\rPrzecież się jeszcze nie wykluło.</language>
	</row>
	<row id="msg_0635_T30R0601_00016" index="16">
