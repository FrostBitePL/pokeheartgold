<?xml version="1.0"?>
<body language="English">
	<row id="msg_0664_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mama</language>
	</row>
	<row id="msg_0664_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? {STRVAR_1 3, 0, 0}? Tak się\nprzyzwyczaiłam do twojego głosu, ale\fprzez telefon brzmisz prawie jak\nktoś inny. Dziwne...</language>
	</row>
	<row id="msg_0664_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? {STRVAR_1 3, 0, 0}? Tak się\nprzyzwyczaiłam do twojego głosu, ale\fprzez telefon brzmisz prawie jak\nktoś inny. Dziwne...</language>
	</row>
	<row id="msg_0664_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? To brzmi naprawdę trudno.\fAle, {STRVAR_1 3, 0, 0}, wiem, że jesteś\nnaprawdę zdeterminowany/a. Dasz\fradę, prawda?</language>
	</row>
	<row id="msg_0664_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Czy\nProfesor Mariusz nie czekał na\fciebie?</language>
	</row>
	<row id="msg_0664_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! No i jak\nidzie zadanie, w którym pomagasz\fProfesorowi Mariuszowi? Wiem, że\njesteś zdeterminowany/a. Dasz radę!</language>
	</row>
	<row id="msg_0664_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? Cześć, {STRVAR_1 3, 0, 0}! Jeśli\nskończyłeś/aś zadanie, wracaj do\fdomu, kochanie.</language>
	</row>
	<row id="msg_0664_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Co\nsłychać? Jak się dogadujesz z\fPokémonami? Wiesz, zauważyłam, że\njeśli jesteś czuły/a dla Pokémonów,\fodpowiadają tym samym.\r</language>
	</row>
	<row id="msg_0664_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hello?\rOh, hi, {STRVAR_1 3, 0, 0}! Working hard?\nYou’re visiting Zastruże?\rYou know, you’re pretty close...\nHow about coming home for a bit?\r</language>
	</row>
	<row id="msg_0664_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? O, jesteś w Łażanach...\fTo tam jest Wodna Wieża, prawda?\nPoszedłeś/Poszłaś ją zobaczyć?\r</language>
	</row>
	<row id="msg_0664_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? O, jesteś w Kalnie... To\ftam jest Stara Studnia, prawda?\nPoszedłeś/Poszłaś ją zobaczyć?\r</language>
	</row>
	<row id="msg_0664_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? O, jesteś w Domanicach...\fTo tam budują tę Ostoję Ptaków,\nprawda? Już otwarta?\r</language>
	</row>
	<row id="msg_0664_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? O, jesteś w Żarowie... To\ftam jest Zamek, prawda?\nPoszedłeś/Poszłaś go zobaczyć?\r</language>
	</row>
	<row id="msg_0664_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? O, jesteś w\fSiedlimowicach... To tam jest ten\nwielki młyn, prawda?\fPoszedłeś/Poszłaś go zobaczyć?\r</language>
	</row>
	<row id="msg_0664_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? O, jesteś w Mrowinach...\fTo tam jest Samotna Wieża, prawda?\nPoszedłeś/Poszłaś ją zobaczyć?\r</language>
	</row>
	<row id="msg_0664_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? Wow, jesteś w {STRVAR_1 4, 2, 0}?\fPowodzenia w twojej pokémonowej\nwyprawie!\r</language>
	</row>
	<row id="msg_0664_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? Wow, jesteś w {STRVAR_1 4, 2, 0}?\fJako mama wiem, że dajesz z siebie\nwszystko, gdziekolwiek jesteś!\r</language>
	</row>
	<row id="msg_0664_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Brzmisz\nradośnie! Od razu lepiej się czuję!\r</language>
	</row>
	<row id="msg_0664_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? To brzmi naprawdę trudno.\fAle, {STRVAR_1 3, 0, 0}, wiem, że jesteś\nnaprawdę zdeterminowany/a. Dasz\fradę, prawda?\r</language>
	</row>
	<row id="msg_0664_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Ciężko\npracujesz? Jesteś w Regionie\fŚwidnica?! Wow, to wspaniałe,\n{STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0664_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Próbujesz\nPokéathlonu? Dawaj z siebie\fwszystko! Jako mama trzymam kciuki!\r</language>
	</row>
	<row id="msg_0664_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie poszedłeś/aś jeszcze po te\nprzedmioty, które ci kupiłam,\fprawda? Nie zapomnij zajrzeć do\nPokémon Mart i porozmawiać z\fdostawcą.</language>
	</row>
	<row id="msg_0664_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? ...{STRVAR_1 3, 0, 0}? Słyszałam od\nProfesora Mariusza, że wybrałeś/aś\fsię w długą podróż. Chciałabym,\nżebyś mi powiedział/a... Co z twoimi\fpieniędzmi? Mam je odkładać?</language>
	</row>
	<row id="msg_0664_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przy okazji, odłożyłam już {STRVAR_1 55, 10, 0}\nzłotych. Chcesz dalej odkładać?</language>
	</row>
	<row id="msg_0664_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przy okazji, {STRVAR_1 3, 0, 0}, odłożyłam już\n{STRVAR_1 55, 10, 0} złotych. Chcesz znów zacząć\fodkładać?</language>
	</row>
	<row id="msg_0664_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze. Będę odkładać twoje\npieniądze. {STRVAR_1 3, 0, 0}, tak trzymaj!\fKibicuję ci, kochanie!</language>
	</row>
	<row id="msg_0664_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze. Nie będę odkładać twoich\npieniędzy. {STRVAR_1 3, 0, 0}, tak trzymaj!\fKibicuję ci, kochanie!</language>
	</row>
	<row id="msg_0664_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ważne jest, żeby oszczędzać\npieniądze.</language>
	</row>
	<row id="msg_0664_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, {STRVAR_1 3, 0, 0}, nic nie odkładasz.\nChcesz zacząć? {YESNO 0}</language>
	</row>
	<row id="msg_0664_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo? O, cześć, {STRVAR_1 3, 0, 0}! Jak się\nmasz? Znalazłam przydatny przedmiot\fpodczas zakupów i kupiłam go za\ntwoje pieniądze. Przepraszam! Ale\fpoprosiłam dostawcę, żeby ci go\nprzyniósł, więc zajrzyj do\fnajbliższego Pokémon Mart albo domu\ntowarowego i go odbierz! Wiem, że ci\fsię przyda!</language>
	</row>
</body>
