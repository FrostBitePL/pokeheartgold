<?xml version="1.0"?>
<body language="English">
	<row id="msg_0666_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prof. Oak</language>
	</row>
	<row id="msg_0666_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak...\rHmm... To dziwne.\nZnam twój głos, {STRVAR_1 3, 0, 0}, ale\fjakoś przez telefon brzmisz\ftak inaczej.</language>
	</row>
	<row id="msg_0666_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak...\rHmm... To dziwne.\nZnam twój głos, {STRVAR_1 3, 0, 0}, ale\fjakoś przez telefon brzmisz\ftak inaczej.</language>
	</row>
	<row id="msg_0666_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak!\rŁapiesz mnóstwo Pokémonów,\nprawda?</language>
	</row>
	<row id="msg_0666_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak!\nTwój Pokédex naprawdę się zapełnia!</language>
	</row>
	<row id="msg_0666_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak!\rPoruszasz się w niesamowitym\ntempie! Przypominasz mi mnie\fsamego, gdy byłem młodszy!</language>
	</row>
	<row id="msg_0666_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak!\rJeśli poczujesz się zmęczony, powinieneś\nzrobić przerwę. Nie przemęczaj się\fzbytnio!</language>
	</row>
	<row id="msg_0666_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tu profesor Oak...\rGdy nagrywam mój program radiowy,\nmuszę podróżować tam i z powrotem\fmiędzy Kanto a Johto. To trochę\fmęczące...\rOch, ale nieważne! Świetnie ci idzie\nzapełnianie Pokédexu!</language>
	</row>
	<row id="msg_0666_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak!\rWygląda na to, że znalazłeś jakieś\nPokémony, które nie pochodzą z regionu\fJohto ani Kanto, prawda?\rJesteś silnym trenerem i naprawdę\ndokonujesz odkryć!</language>
	</row>
	<row id="msg_0666_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Tu profesor Oak.\nByłem tak zajęty moimi badaniami,\fże ostatnio niewiele\fspałem...\rOch, ale nieważne!\nZrobiłeś taki dobry postęp w swoim\fPokédexie. Nie mogę się doczekać, by go\fzobaczyć!</language>
	</row>
	<row id="msg_0666_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak!\rZauważyłeś, że twój krąg przyjaciół\nposzerzył się, odkąd zacząłeś\fpracować nad Pokédexem?\fTo najlepsza rzecz w Pokémonach!</language>
	</row>
	<row id="msg_0666_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak!\nWiesz, nie widuję zbyt wielu wspaniałych\ftrenerów takich jak ty ostatnio!\rBędę musiał podziękować profesorowi\nElmowi za to, że nas przedstawił!</language>
	</row>
	<row id="msg_0666_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak!\nOch, nie musisz nic mówić!\fWiem lepiej niż ktokolwiek inny, jak\fciężko pracujesz!\rPomyślałem, że powinienem dać ci\nprezent czy coś w ramach podziękowania...\fCóż, coś wziąłem, ale\fcałkowicie zapomniałem ci to dać!\fHa ha ha!\rOch, nie musisz się w ogóle nad tym\nzastanawiać. Wiem, że to coś, co bardzo\fci się przyda. Powinieneś po prostu\ftu przyjść i to odebrać!\rBędę czekał na ciebie w moim\nLaboratorium w Pallet Town!\n</language>
	</row>
	<row id="msg_0666_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak...\nOch, cześć, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0666_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, tu profesor Oak...\nOch, cześć, {STRVAR_1 3, 0, 0}!\r</language>
	</row>
	<row id="msg_0666_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No i jak, jak ci idzie z Pokédexem?</language>
	</row>
	<row id="msg_0666_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zakończ</language>
	</row>
	<row id="msg_0666_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oceń Pokédex</language>
	</row>
	<row id="msg_0666_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oceń Pokédex Johto</language>
	</row>
	<row id="msg_0666_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oceń Narodowy Pokédex</language>
	</row>
	<row id="msg_0666_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm, zobaczmy...\nWidziałeś {STRVAR_1 52, 5, 0} Pokémonów, a\fzłapałeś {STRVAR_1 52, 6, 0} Pokémonów!\fRozumiem!\r</language>
	</row>
	<row id="msg_0666_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokaż mi swój Pokédex ponownie kiedy\nindziej!</language>
	</row>
	<row id="msg_0666_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow!\nTo kompletny Pokédex Johto!\rDzięki tobie, {STRVAR_1 3, 0, 0}, Pokédex\nJohto jest kompletny!\rWow...\nWykonałeś niesamowitą pracę!</language>
	</row>
	<row id="msg_0666_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow!\nTo kompletny Pokédex Johto!\rDzięki tobie, {STRVAR_1 3, 0, 0}, Pokédex\nJohto jest kompletny!\rWow...\nWykonałeś niesamowitą pracę!</language>
	</row>
	<row id="msg_0666_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doskonale!\nTo niesamowity Narodowy Pokédex!\rWow...\nSpełniłeś moje oczekiwania\fwspaniale!\rNie, przewyższyłeś je,\n{STRVAR_1 3, 0, 0}. Stałeś się\fniesamowitym trenerem!\rDziękuję, {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0666_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doskonale!\nTo niesamowity Narodowy Pokédex!\rWow...\nSpełniłeś moje oczekiwania\fwspaniale!\rNie, przewyższyłeś je,\n{STRVAR_1 3, 0, 0}. Stałeś się\fniesamowitym trenerem!\rDziękuję, {STRVAR_1 3, 0, 0}!</language>
	</row>
	<row id="msg_0666_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naprawdę, zaskoczyłeś mnie!\rAle tak jak się spodziewałem, ukończyłeś\nPokédex Johto.\fJestem tak wdzięczny!\rJeśli masz tyle determinacji,\nto jeszcze bardziej ekscytujące\fprzygody czekają na ciebie w świecie\fPokémonów!</language>
	</row>
	<row id="msg_0666_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naprawdę mnie zaskoczyłeś!\rPrzewyższyłeś moje oczekiwania.\nPoszedłeś daleko poza nie,\fkończąc\fNarodowy Pokédex!\rJestem bez słów...!\rDzięki temu świat Pokémonów\ni trenerów jest większy, głębszy\fi bogatszy!\rTeraz badania nad Pokémonami\nnigdy się nie skończą!</language>
	</row>
	<row id="msg_0666_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szukaj Pokémonów w porośniętych\ntrawą obszarach!\r</language>
	</row>
	<row id="msg_0666_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze. Widzę, że rozumiesz, jak\nużywać Poké Balli.\r</language>
	</row>
	<row id="msg_0666_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robisz się w tym coraz lepszy,\nale masz jeszcze długą drogę przed sobą.\r</language>
	</row>
	<row id="msg_0666_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm, łapiesz Pokémony w\nprzyzwoitym tempie!\r</language>
	</row>
	<row id="msg_0666_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starasz się--widzę to.\nTwój Pokédex zaczyna się układać.\r</language>
	</row>
	<row id="msg_0666_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze je trenujesz. Wiesz, że\nniektóre Pokémony nie ewoluują\ftylko przez walkę z innymi, prawda?\r</language>
	</row>
	<row id="msg_0666_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz Wędkę?\nSą Pokémony, które można znaleźć\ftylko przez wędkowanie!\r</language>
	</row>
	<row id="msg_0666_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doskonale! Wygląda na to, że jesteś\ndobry w zbieraniu rzeczy!\r</language>
	</row>
	<row id="msg_0666_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niektóre Pokémony pojawiają się\ntylko o określonych porach dnia.\r</language>
	</row>
	<row id="msg_0666_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Pokédex naprawdę się zapełnia.\nTak trzymaj!\r</language>
	</row>
	<row id="msg_0666_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem pod wrażeniem.\nEwoluujesz Pokémony, nie tylko\fje łapiesz.\r</language>
	</row>
	<row id="msg_0666_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli nauczysz się skutecznie używać\nspecjalnych Poké Balli robionych przez\fKurta, będziesz lepiej łapać Pokémony!\r</language>
	</row>
	<row id="msg_0666_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy wymieniasz Pokémony, możesz też\nwymieniać informacje. Twoi przyjaciele\fnaprawdę mogą ci pomóc!\r</language>
	</row>
	<row id="msg_0666_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wymieniasz swoje Pokémony?\nRobienie tego samemu jest trudne!\r</language>
	</row>
	<row id="msg_0666_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow! Osiągnąłeś 200!\nTwój Pokédex wygląda świetnie!\r</language>
	</row>
	<row id="msg_0666_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znalazłeś tak wiele Pokémonów!\nNaprawdę pomogłeś moim badaniom!\r</language>
	</row>
	<row id="msg_0666_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wspaniale! Masz zdolności, by pewnego\ndnia zostać wielkim profesorem\fPokémonów!\r</language>
	</row>
	<row id="msg_0666_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój Pokédex jest niesamowity!\nJesteś gotów zostać profesjonalistą!\r</language>
	</row>
	<row id="msg_0666_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cel może być daleko, ale jeszcze się\nnie poddawaj! Tak trzymaj!\r</language>
	</row>
	<row id="msg_0666_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie zapominaj, niektóre Pokémony\npojawiają się tylko o określonych\fporach dnia!\r</language>
	</row>
	<row id="msg_0666_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli rozbijesz skały, niektóre\nPokémony, które się tam ukrywały,\fmogą z nich wyskoczyć!\r</language>
	</row>
	<row id="msg_0666_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wspaniale, że udało ci się zebrać\ntyle Pokémonów! Droga przed tobą\fjest długa. Tak trzymaj!\r</language>
	</row>
	<row id="msg_0666_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli uderzysz Headbuttem w drzewo,\nczasem może z niego wypaść Pokémon!\r</language>
	</row>
	<row id="msg_0666_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiele Pokémonów, których nie ma\nw regionie Johto, lubi zbierać się w\fSafari Zone.\r</language>
	</row>
	<row id="msg_0666_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muzyka w radiu może też skłonić\nPokémony do wyskoczenia!\r</language>
	</row>
	<row id="msg_0666_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, zaszedłeś tak daleko...!\nJestem właściwie trochę zaskoczony!\r</language>
	</row>
	<row id="msg_0666_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To krytyczny moment!\nNie możesz się zniechęcać!\r</language>
	</row>
	<row id="msg_0666_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeszcze tylko trochę!\nMam wobec ciebie wysokie oczekiwania!\r</language>
	</row>
	<row id="msg_0666_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy przez wszystkie moje lata\nnie widziałem tak niesamowitego trenera!\r</language>
	</row>
	<row id="msg_0666_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No i jak, jak ci idzie z Pokédexem?\n{YESNO 0}</language>
	</row>
</body>
