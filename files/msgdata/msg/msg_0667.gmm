	<row id="msg_0667_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo?\nOch, cześć, {STRVAR_1 3, 0, 0}!\rPrzepraszam, wciąż myślę nad kolejnym\nwyzwaniem. Mógłbyś dać mi jeszcze\ftrochę czasu?</language>
	</row>
