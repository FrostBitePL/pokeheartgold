	<row id="msg_0667_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo?\nOch, cześć, {STRVAR_1 3, 0, 0}!\rPróbuję wymyślić nowy sposób\nzabawy w Safari Zone.\rJeśli coś wymyślę, na pewno\nzadzwonię do ciebie!</language>
	</row>
