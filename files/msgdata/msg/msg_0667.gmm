<?xml version="1.0"?>
<body language="English">
	<row id="msg_0667_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Baoba</language>
	</row>
	<row id="msg_0667_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To musi być pierwszy raz, kiedy robię\ncoś takiego z tak bliska!\rMam na myśli rozmowę przez telefon!</language>
	</row>
	<row id="msg_0667_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rPrzepraszam, że kazałem ci czekać!\nWreszcie otworzyliśmy Safari Zone!\rWiesz, gdzie to jest?\rZnasz bramę wewnątrz jaskini w\nCianwood City?\rJeśli przejdziesz przez nią i pójdziesz\nkawałek, powinieneś wkrótce zobaczyć\fSafari Zone!\rJesteśmy trochę na uboczu, ale\nproszę, odwiedź nas!</language>
	</row>
	<row id="msg_0667_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rPrzepraszam, że kazałem ci czekać!\nWreszcie otworzyliśmy Safari Zone!\rWiesz, gdzie to jest?\rZnasz bramę wewnątrz jaskini w\nCianwood City?\rJeśli przejdziesz przez nią i pójdziesz\nkawałek, powinieneś wkrótce zobaczyć\fSafari Zone!\rJesteśmy trochę na uboczu, ale\nproszę, odwiedź nas!</language>
	</row>
	<row id="msg_0667_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rPrzepraszam, że kazałem ci czekać!\nWreszcie wymyśliłem następny test.\rPodam ci więcej szczegółów w Safari\nZone. Do zobaczenia tam!</language>
	</row>
	<row id="msg_0667_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rPrzepraszam, że kazałem ci czekać!\nWreszcie wymyśliłem następny test.\rPodam ci więcej szczegółów w Safari\nZone. Do zobaczenia tam!</language>
	</row>
	<row id="msg_0667_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rPrzepraszam, że kazałem ci czekać!\nWymyśliłem nowy sposób zabawy!\rNazywa się Rozmieszczanie Obiektów!\rPodam ci więcej szczegółów w\nSafari Zone. Do zobaczenia tam!</language>
	</row>
	<row id="msg_0667_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rPrzepraszam, że kazałem ci czekać!\nWymyśliłem nowy sposób zabawy!\rNazywa się Rozmieszczanie Obiektów!\rPodam ci więcej szczegółów w\nSafari Zone. Do zobaczenia tam!</language>
	</row>
	<row id="msg_0667_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rWymyśliliśmy nowe obiekty.\rDzięki nim powinieneś być w stanie\nspotkać wiele różnych Pokémonów.\rPowodzenia!</language>
	</row>
	<row id="msg_0667_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rWymyśliliśmy nowe obiekty.\rDzięki nim powinieneś być w stanie\nspotkać wiele różnych Pokémonów.\rPowodzenia!</language>
	</row>
	<row id="msg_0667_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rWymyśliliśmy nowe obiekty!\nJest ich teraz tak dużo!\rZ tymi nowymi dodatkami to powinno\nwystarczyć, jak sądzę!\rPowinieneś spróbować rozstawić różne\nobiekty, by zobaczyć, jakie różne\fPokémony możesz spotkać.</language>
	</row>
	<row id="msg_0667_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rWymyśliliśmy nowe obiekty!\nJest ich teraz tak dużo!\rZ tymi nowymi dodatkami to powinno\nwystarczyć, jak sądzę!\rPowinieneś spróbować rozstawić różne\nobiekty, by zobaczyć, jakie różne\fPokémony możesz spotkać.</language>
	</row>
	<row id="msg_0667_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rWymyśliłem nowy sposób zabawy!\nNazywa się Rozmieszczanie Obiektów!\r...Czekaj...\nCzy już ci o tym mówiłem?\rCóż, mamy nowe obiekty do\nRozmieszczania Obiektów...\r...Już ci też o tym\nmówiłem...\rCóż, nic nie szkodzi!\nJeśli przyjdziesz do Safari Zone,\nzobaczysz dokładnie, o czym mówię!\rNo to do zobaczenia tam!</language>
	</row>
	<row id="msg_0667_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rWymyśliłem nowy sposób zabawy!\nNazywa się Rozmieszczanie Obiektów!\r...Czekaj...\nCzy już ci o tym mówiłem?\rCóż, mamy nowe obiekty do\nRozmieszczania Obiektów...\r...Już ci też o tym\nmówiłem...\rCóż, nic nie szkodzi!\nJeśli przyjdziesz do Safari Zone,\nzobaczysz dokładnie, o czym mówię!\rNo to do zobaczenia tam!</language>
	</row>
	<row id="msg_0667_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rWygląda na to, że nastąpiła zmiana\nw Pokémonach w {STRVAR_1 4, 10, 0}...\rPo pewnym czasie z tymi samymi obiektami\nw tym samym Area, rodzaje Pokémonów,\fktóre się tam osiedlają, zmieniają się.\rOdkryliśmy, że jeśli całkowicie usuniesz\nArea, a potem przywrócisz ją z tymi\fsamymi obiektami, oryginalne Pokémony\fwracają.\fNie ma powodu do zmartwień!</language>
	</row>
	<row id="msg_0667_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rWygląda na to, że nastąpiła zmiana\nw Pokémonach w {STRVAR_1 4, 10, 0}...\rPo pewnym czasie z tymi samymi obiektami\nw tym samym Area, rodzaje Pokémonów,\fktóre się tam osiedlają, zmieniają się.\rOdkryliśmy, że jeśli całkowicie usuniesz\nArea, a potem przywrócisz ją z tymi\fsamymi obiektami, oryginalne Pokémony\fwracają.\fNie ma powodu do zmartwień!</language>
	</row>
	<row id="msg_0667_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, cześć, {STRVAR_1 3, 0, 0}!\nTu strażnik Baoba.\rWygląda na to, że nastąpiła niewielka\nzmiana w Pokémonach w Safari Zone!\rTo w {STRVAR_1 4, 10, 0} i w\n{STRVAR_1 4, 11, 0}.\rJeśli rozstawisz kilka obiektów\npasujących do Area, rodzaje Pokémonów,\fktóre się tam osiedlają, zmieniają się.\rOdkryliśmy, że jeśli całkowicie usuniesz\nArea, a potem przywrócisz ją z tymi\fsamymi obiektami, oryginalne Pokémony\fwracają.\fNie ma powodu do zmartwień!</language>
	</row>
	<row id="msg_0667_00017" index="17">
		<attribute name="window_context_name">used</attribute>
