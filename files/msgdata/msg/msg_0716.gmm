<?xml version="1.0"?>
<body language="English">
	<row id="msg_0716_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prof. Elm</language>
	</row>
	<row id="msg_0716_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rCo się dzieje?\nJeśli jesteś w pobliżu, powinieneś\fprzyjść porozmawiać osobiście!</language>
	</row>
	<row id="msg_0716_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rCo się dzieje?\nJeśli jesteś w pobliżu, powinieneś\fprzyjść porozmawiać ze mną osobiście!</language>
	</row>
	<row id="msg_0716_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rStaraj się nie przesadzać.\nPamiętaj, by leczyć swoje Pokémony,\fjeśli są ranne.</language>
	</row>
	<row id="msg_0716_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rStaraj się nie przesadzać.\nPamiętaj, by leczyć swoje Pokémony,\fjeśli są ranne.</language>
	</row>
	<row id="msg_0716_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, {STRVAR_1 3, 0, 0}...\rWłaśnie na chwilę się odwróciłem...\nJak to możliwe...?</language>
	</row>
	<row id="msg_0716_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, {STRVAR_1 3, 0, 0}...\rWłaśnie na chwilę się odwróciłem...\nJak to możliwe...?</language>
	</row>
	<row id="msg_0716_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rSprawdzamy teraz Jajko. Rzeczywiście\nwygląda na Jajko Pokémona.\rZrobimy jeszcze kilka testów!</language>
	</row>
	<row id="msg_0716_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rSprawdzamy teraz Jajko. Rzeczywiście\nwygląda na Jajko Pokémona.\rZrobimy jeszcze kilka testów!</language>
	</row>
	<row id="msg_0716_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rWidziałeś mojego asystenta? Jest w\nPoké Marcie w Violet City.\rMa coś bardzo ważnego, więc koniecznie\nodbierz to od niego!</language>
	</row>
	<row id="msg_0716_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rWidziałeś mojego asystenta? Jest w\nPoké Marcie w Violet City.\rMa coś bardzo ważnego, więc koniecznie\nodbierz to od niego!</language>
	</row>
	<row id="msg_0716_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rJak tam Jajko? Coś się zmieniło?\rJeśli coś się stanie, proszę zadzwoń.</language>
	</row>
	<row id="msg_0716_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rJak tam Jajko? Coś się zmieniło?\rJeśli coś się stanie, proszę zadzwoń.</language>
	</row>
	<row id="msg_0716_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, {STRVAR_1 3, 0, 0}, mam świetne\nwiadomości! Z tego Jajka wykluł się\nPokémon!\rWiedziałem, że danie ci tego Jajka,\n{STRVAR_1 3, 0, 0}, było słuszną decyzją.\fPo prostu to wiedziałem!\rPowinieneś tu przyjść i pokazać mi,\njaki to rodzaj Pokémona!</language>
	</row>
	<row id="msg_0716_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, {STRVAR_1 3, 0, 0}, mam świetne\nwiadomości! Z tego Jajka wykluł się\nPokémon!\rWiedziałem, że danie ci tego Jajka,\n{STRVAR_1 3, 0, 0}, było słuszną decyzją.\fPo prostu to wiedziałem!\rPowinieneś tu przyjść i pokazać mi,\njaki to rodzaj Pokémona!</language>
	</row>
	<row id="msg_0716_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rWłaśnie dokonałem nowego odkrycia.\rCzas, jaki zajmuje wyklucie się z\nJajka, zależy od Pokémona.</language>
	</row>
	<row id="msg_0716_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rWłaśnie dokonałem nowego odkrycia.\rCzas, jaki zajmuje wyklucie się z\nJajka, zależy od Pokémona.</language>
	</row>
	<row id="msg_0716_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rWciąż jest tajemnicą, jakie ruchy\nznają wyklute Pokémony.\rBadamy to teraz.</language>
	</row>
	<row id="msg_0716_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rWciąż jest tajemnicą, jakie ruchy\nznają wyklute Pokémony.\rBadamy to teraz.</language>
	</row>
	<row id="msg_0716_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rDzieje się coś dziwnego w\nradiu.\rCzy coś się dzieje w Goldenrod?</language>
	</row>
	<row id="msg_0716_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rDzieje się coś dziwnego w\nradiu.\rCzy coś się dzieje w Goldenrod?</language>
	</row>
	<row id="msg_0716_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, czy to {STRVAR_1 3, 0, 0}?\rJeszcze tylko jedna Odznaka, zanim\nzbierzesz wszystkie Odznaki Johto!\rLider Sali w Blackthorn ponoć jest\npotężnym Poskromicielem Smoków!</language>
	</row>
	<row id="msg_0716_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, czy to {STRVAR_1 3, 0, 0}?\rJeszcze tylko jedna Odznaka, zanim\nzbierzesz wszystkie Odznaki Johto!\rLider Sali w Blackthorn ponoć jest\npotężnym Poskromicielem Smoków!</language>
	</row>
	<row id="msg_0716_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\nWygląda na to, że dobrze ci idzie.\rTak dobrze ci idzie, że nie mam się o\nciebie czym martwić.\rMyślę, że mógłbyś zrobić wszystko,\nczego byś spróbował!</language>
	</row>
	<row id="msg_0716_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\nWygląda na to, że dobrze ci idzie.\rTak dobrze ci idzie, że nie mam się o\nciebie czym martwić.\rMyślę, że mógłbyś zrobić wszystko,\nczego byś spróbował!</language>
	</row>
	<row id="msg_0716_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rMam tu coś dla ciebie od\nprofesora Oaka.\rMógłbyś wpaść do mojego Laboratorium?\nDo zobaczenia później!</language>
	</row>
	<row id="msg_0716_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rMam tu coś dla ciebie od\nprofesora Oaka.\rMógłbyś wpaść do mojego Laboratorium?\nDo zobaczenia później!</language>
	</row>
	<row id="msg_0716_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rJest tak wiele różnych sposobów, w\njakie Pokémony ewoluują, prawda?!\rNiektóre Pokémony nie ewoluują nawet,\ndopóki nie spełnią najpierw pewnych\fwarunków!</language>
	</row>
	<row id="msg_0716_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rJest tak wiele różnych sposobów, w\njakie Pokémony ewoluują, prawda?!\rNiektóre Pokémony nie ewoluują nawet,\ndopóki nie spełnią najpierw pewnych\fwarunków!</language>
	</row>
	<row id="msg_0716_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rSpodziewam się, że są jakieś Pokémony\nw regionie Kanto, których nie znam.\rSą też pewnie metody ewolucji, których\njeszcze nie znam.\rPowinienem wykorzystać tę perspektywę\ni odkryć, co się da!</language>
	</row>
	<row id="msg_0716_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rSpodziewam się, że są jakieś Pokémony\nw regionie Kanto, których nie znam.\rSą też pewnie metody ewolucji, których\njeszcze nie znam.\rPowinienem wykorzystać tę perspektywę\ni odkryć, co się da!</language>
	</row>
	<row id="msg_0716_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rWygląda na to, że Pokémony zarażone\nPokérusem lepiej awansują poziomy.\fNie do końca wiemy, dlaczego...</language>
	</row>
	<row id="msg_0716_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rWygląda na to, że Pokémony zarażone\nPokérusem lepiej awansują poziomy.\fNie do końca wiemy, dlaczego...</language>
	</row>
	<row id="msg_0716_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">H-halo? {STRVAR_1 3, 0, 0}?\rTo katastrofa!\nEch, um, to po prostu straszne!\rCo mam zrobić?\nTo... Och, nie...\rProszę, wróć tu teraz!</language>
	</row>
	<row id="msg_0716_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">H-halo? {STRVAR_1 3, 0, 0}?\rTo katastrofa!\nEch, um, to po prostu straszne!\rCo mam zrobić?\nTo... Och, nie...\rProszę, wróć tu teraz!</language>
	</row>
	<row id="msg_0716_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\nOdkryliśmy coś!\rSzczegóły są...cóż, nie mogę tak\nnaprawdę nic powiedzieć, ale chcemy,\fbyś niósł to Jajko!\rMój asystent jest w Poké Marcie w\nViolet City. Mógłbyś się z nim spotkać\fi odebrać to Jajko?</language>
	</row>
	<row id="msg_0716_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\nOdkryliśmy coś!\rSzczegóły są...cóż, nie mogę tak\nnaprawdę nic powiedzieć, ale chcemy,\fbyś niósł to Jajko!\rMój asystent jest w Poké Marcie w\nViolet City. Mógłbyś się z nim spotkać\fi odebrać to Jajko?</language>
	</row>
	<row id="msg_0716_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, jak tam sprawy?\rZadzwoniłem, bo dzieje się coś\ndziwnego z audycjami radiowymi.\rMówili o Team Rocket.\r{STRVAR_1 3, 0, 0}, wiesz coś na ten\ntemat?\rMoże Team Rocket powrócił.\nNie, to po prostu nie może być prawda.\rPrzepraszam, że zawracam ci głowę.\nTrzymaj się!</language>
	</row>
	<row id="msg_0716_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0}, jak tam sprawy?\rZadzwoniłem, bo dzieje się coś\ndziwnego z audycjami radiowymi.\rMówili o Team Rocket.\r{STRVAR_1 3, 0, 0}, wiesz coś na ten\ntemat?\rMoże Team Rocket powrócił.\nNie, to po prostu nie może być prawda.\rPrzepraszam, że zawracam ci głowę.\nTrzymaj się!</language>
	</row>
	<row id="msg_0716_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\nJak leci?\rZdobyłem coś fajnego.\nWpadnij do mojego Laboratorium i\nodbierz to!\rDo zobaczenia później!</language>
	</row>
	<row id="msg_0716_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\nJak leci?\rZdobyłem coś fajnego.\nWpadnij do mojego Laboratorium i\nodbierz to!\rDo zobaczenia później!</language>
	</row>
	<row id="msg_0716_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rMam tu coś dla ciebie.\nMógłbyś wpaść do mojego Laboratorium?\rDo zobaczenia później!</language>
	</row>
	<row id="msg_0716_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rMam tu coś dla ciebie.\nMógłbyś wpaść do mojego Laboratorium?\rDo zobaczenia później!</language>
	</row>
	<row id="msg_0716_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rOdkryłem dziwną rzecz.\nWygląda na to, że istnieje coś, co\fnazywa się Pokérus, co zaraża Pokémony.\rTak, to jest jak wirus, więc nazywa\nsię to Pokérus.\rSzybko się namnaża i zaraża też inne\nPokémony. Ale to wszystko.\rWygląda na to, że nic nie robi, i\nz czasem ustępuje.\rChyba nie ma się czym martwić.\nPa!</language>
	</row>
	<row id="msg_0716_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, {STRVAR_1 3, 0, 0}?\rOdkryłem dziwną rzecz.\nWygląda na to, że istnieje coś, co\fnazywa się Pokérus, co zaraża Pokémony.\rTak, to jest jak wirus, więc nazywa\nsię to Pokérus.\rSzybko się namnaża i zaraża też inne\nPokémony. Ale to wszystko.\rWygląda na to, że nic nie robi, i\nz czasem ustępuje.\rChyba nie ma się czym martwić.\nPa!</language>
	</row>
