	<row id="msg_0723_00916" index="916">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To była wspaniała\nwalka! Odwiedź mnie znowu!\r</language>
	</row>
	<row id="msg_0723_00917" index="917">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrać z wybitnym\ntrenerem jak ty... Mogę z tym\nżyć.\r</language>
