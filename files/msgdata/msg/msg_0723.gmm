<?xml version="1.0"?>
<body language="English">
	<row id="msg_0723_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadchodzę!</language>
	</row>
	<row id="msg_0723_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak!\r</language>
	</row>
	<row id="msg_0723_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blee!\r</language>
	</row>
	<row id="msg_0723_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, żółtodziobie!\nDawaj!</language>
	</row>
	<row id="msg_0723_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, wiedziałem.\nJesteś żółtodziobem w końcu.\r</language>
	</row>
	<row id="msg_0723_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blee!\nJesteś tylko żółtodziobem!\r</language>
	</row>
	<row id="msg_0723_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę to powiedzieć, szorty\nsą najlepsze! Są wygodne i\nłatwe do noszenia!</language>
	</row>
	<row id="msg_0723_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szorty są najlepsze!\r</language>
	</row>
	<row id="msg_0723_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie przestanę nosić\nszortów. Dla nikogo!\r</language>
	</row>
	<row id="msg_0723_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam za zasadę nosić\nminispódnice!</language>
	</row>
	<row id="msg_0723_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Minispódnice to coś\nnajlepsze!\r</language>
	</row>
	<row id="msg_0723_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jaka jest twoja zasada?\r</language>
	</row>
	<row id="msg_0723_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham moją minispódnicę!</language>
	</row>
	<row id="msg_0723_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyłapałem cię na\ndrzemce!\r</language>
	</row>
	<row id="msg_0723_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Minispódnice sprawiają, że\nnogi wyglądają dłużej! Czy to\ndobra rzecz?\r</language>
	</row>
	<row id="msg_0723_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szukam uroczych Akcesoriów.</language>
	</row>
	<row id="msg_0723_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daj mi znać, jeśli\nznajdziesz jakieś niezłe\nAkcesoria!\r</language>
	</row>
	<row id="msg_0723_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałbym móc się wystroić!\r</language>
	</row>
	<row id="msg_0723_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcę przetestować coś,\nczego nauczyłam się w prywatnej\nszkole.</language>
	</row>
	<row id="msg_0723_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak!\nZadziałało idealnie!\r</language>
	</row>
	<row id="msg_0723_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm...\nCoś tu jest nie tak.\r</language>
	</row>
	<row id="msg_0723_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh... Wroar!</language>
	</row>
	<row id="msg_0723_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka to kwestia rozmachu\ni siły woli.\r</language>
	</row>
	<row id="msg_0723_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, więc siła woli sama\nnie wystarcza.\r</language>
	</row>
	<row id="msg_0723_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uczę się codziennie, bo\nchcę pracować na całym świecie.</language>
	</row>
	<row id="msg_0723_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój sen jest\nogólnoświatowy!\r</language>
	</row>
	<row id="msg_0723_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę się douczyć na\ntemat walk Pokémon.\r</language>
	</row>
	<row id="msg_0723_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy dorosnę, zostanę\nprofesorem Pokémon!</language>
	</row>
	<row id="msg_0723_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Er-hem! Er-hem!\nMasz wiele do nauczenia się,\nmłodziku!\r</language>
	</row>
	<row id="msg_0723_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Er-hem! Er-hem!\nWygląda na to, że ja też mam\njeszcze wiele do nauczenia!\r</language>
	</row>
	<row id="msg_0723_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy temat to Pokémony, po\nprostu nie przegrywam!</language>
	</row>
	<row id="msg_0723_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To zwycięstwo wiedzy!\r</language>
	</row>
	<row id="msg_0723_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powtórzę ten temat!\nI poddam cię mojej zemście!\r</language>
	</row>
	<row id="msg_0723_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, teraz wyglądasz\nżałośnie. Może wygram.</language>
	</row>
	<row id="msg_0723_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak to zrobiłem!\r</language>
	</row>
	<row id="msg_0723_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ał, to zabolało.\r</language>
	</row>
	<row id="msg_0723_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku, w porządku.\nNie trzeba mówić ani słowa.</language>
	</row>
	<row id="msg_0723_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku, w porządku.\nStarałeś się, jak najlepiej,\nwiem.\r</language>
	</row>
	<row id="msg_0723_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku, w porządku...\nNie trzeba mówić ani słowa...\r</language>
	</row>
	<row id="msg_0723_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem bogaty!</language>
	</row>
	<row id="msg_0723_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, oczywiście.\nJestem bogaty.\r</language>
	</row>
	<row id="msg_0723_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co się stało?\nJestem bogaty, prawda?\r</language>
	</row>
	<row id="msg_0723_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm. Więc jesteś dobry,\nco?</language>
	</row>
	<row id="msg_0723_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm. Nie jesteś wielką\nrzeczą.\nHmm?\r</language>
	</row>
	<row id="msg_0723_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm. Więc jesteś dobry.\nHmm.\r</language>
	</row>
	<row id="msg_0723_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, tak.\nZaatakuję teraz.</language>
	</row>
	<row id="msg_0723_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrobiłem to!\r</language>
	</row>
	<row id="msg_0723_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, jak rozczarowujące.\r</language>
	</row>
	<row id="msg_0723_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Koniec jest, twojej\nprzygody. Przyjdź tu i dostań\nlanie!</language>
	</row>
	<row id="msg_0723_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrobione, było.\r</language>
	</row>
	<row id="msg_0723_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, jak frustrujące to\njest. Zaiste, dziękuję ci.\r</language>
	</row>
	<row id="msg_0723_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak nudno...</language>
	</row>
	<row id="msg_0723_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak bardzo nudno...\r</language>
	</row>
	<row id="msg_0723_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To był dobry sposób, by\nzmarnować trochę czasu.\r</language>
	</row>
	<row id="msg_0723_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hunh?\nGdzie są wszyscy?</language>
	</row>
	<row id="msg_0723_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, ludzie!\nGdzie jesteście?!\r</language>
	</row>
	<row id="msg_0723_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyszedłem na biwak, ale\nmyślę, że rozdzieliłem się od\nprzyjaciół...\r</language>
	</row>
	<row id="msg_0723_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och!\nTy też nie masz Pokétcha?</language>
	</row>
	<row id="msg_0723_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bawiłem się z moim\nPokétchem, ale i tak wygrałem!\r</language>
	</row>
	<row id="msg_0723_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bawiłem się z moim\nPokétchem, i przegrałem...\r</language>
	</row>
	<row id="msg_0723_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój Pokémon trenował w\nlasach.</language>
	</row>
	<row id="msg_0723_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To moc lasów.\r</language>
	</row>
	<row id="msg_0723_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wracam do lasu.\r</language>
	</row>
	<row id="msg_0723_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawalczę z tobą, jakbym\nbył na pikniku!</language>
	</row>
	<row id="msg_0723_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lalala!\r</language>
	</row>
	<row id="msg_0723_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Udawanie, że to piknik,\nnie pozwoli mi wygrać.\r</language>
	</row>
	<row id="msg_0723_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh-la-la!\nNadchodzimy!</language>
	</row>
	<row id="msg_0723_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh-la-la!\nTak szczęśliwa, że wygrałam!\r</language>
	</row>
	<row id="msg_0723_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh-la-la!\nNawet przegrana nie zdoła\nprzygasić mojego ducha!\r</language>
	</row>
	<row id="msg_0723_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nauczę cię, co jest\nzabawne w walczeniu.</language>
	</row>
	<row id="msg_0723_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka ze mną była zabawna,\nprawda?\r</language>
	</row>
	<row id="msg_0723_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, mój, to było\ninspirujące! Jesteś najlepszy!\r</language>
	</row>
	<row id="msg_0723_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja... Ja umiem pływać,\nnaprawdę! Nie potrzebuję mojej\ndętki!</language>
	</row>
	<row id="msg_0723_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To... To prawda!\r</language>
	</row>
	<row id="msg_0723_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja...Nie kłamię!\r</language>
	</row>
	<row id="msg_0723_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardziej wolę rzeki niż\nmorze. Co ty preferujesz?</language>
	</row>
	<row id="msg_0723_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Woda w rzekach jest\nzimna, ale czuje się super.\r</language>
	</row>
	<row id="msg_0723_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie lubię morza, bo\nsolona woda szczypie mnie w\noczy!\r</language>
	</row>
	<row id="msg_0723_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj, dawaj, dawaj!\nDawaj, mój Pokémonie!</language>
	</row>
	<row id="msg_0723_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O to! Właśnie tak,\nmój Pokémonie!\r</language>
	</row>
	<row id="msg_0723_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobry wysiłek!\nWłaśnie tak, mój Pokémonie!\r</language>
	</row>
	<row id="msg_0723_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piaseczek na plaży jest\ntak gorący! Sprawia, że mówię,\n„Ał, ał, ał!”</language>
	</row>
	<row id="msg_0723_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham morze!\r</language>
	</row>
	<row id="msg_0723_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ał, ał, ał!\r</language>
	</row>
	<row id="msg_0723_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pluch, plusk!</language>
	</row>
	<row id="msg_0723_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ker-plusk!\nKer-plusk!\r</language>
	</row>
	<row id="msg_0723_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Klap, klap!\r</language>
	</row>
	<row id="msg_0723_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem dziewczyną\nzakochaną w swojej dętce! Miło\ncię poznać!</language>
	</row>
	<row id="msg_0723_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki! Jestem\ndziewczyną zakochaną w swojej\ndętce!\r</language>
	</row>
	<row id="msg_0723_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Do widzenia! Jestem\ndziewczyną zakochaną w swojej\ndętce!\r</language>
	</row>
	<row id="msg_0723_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, tak! Czuję to!\nJestem nastawiona na twoją\nfalę!</language>
	</row>
	<row id="msg_0723_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tadaaaah!\r</language>
	</row>
	<row id="msg_0723_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tch!\nPrzegrana zbiła mnie z\nrytmu!\r</language>
	</row>
	<row id="msg_0723_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rock? Jazz? Techno?\nCokolwiek nada się na mój\nsoundtrack!</language>
	</row>
	<row id="msg_0723_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Squeeeeeal!\r</language>
	</row>
	<row id="msg_0723_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, tak... Masz mnie w\nnastroju do śpiewania bluesa...\r</language>
	</row>
	<row id="msg_0723_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaczynamy tę sesję!</language>
	</row>
	<row id="msg_0723_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczywiście brakuje ci\npraktyki.\r</language>
	</row>
	<row id="msg_0723_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje marzenie o światowej\ntrasie...\nWydaje się tak odległe...\r</language>
	</row>
	<row id="msg_0723_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, witaj...\nCóż, czyż to nie szykowny\nszalik!</language>
	</row>
	<row id="msg_0723_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdzie kupiłeś ten szalik?\r</language>
	</row>
	<row id="msg_0723_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, ty! Nie jesteś tylko\nmodny, jesteś dobry w\nPokémonach! Jak to\nniesprawiedliwe!\r</language>
	</row>
	<row id="msg_0723_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki za wsparcie!</language>
	</row>
	<row id="msg_0723_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och?\nNie jesteś moim fanem?\r</language>
	</row>
	<row id="msg_0723_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co za straszny sposób\ntraktowania Idolki...\r</language>
	</row>
	<row id="msg_0723_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La, lala, lah.</language>
	</row>
	<row id="msg_0723_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">La lalala.\nLalalah lah.\r</language>
	</row>
	<row id="msg_0723_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pa-pa, lalah!\r</language>
	</row>
	<row id="msg_0723_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zobaczmy, kto bardziej\nkocha Pokémony, ty czy ja.</language>
	</row>
	<row id="msg_0723_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fuhaha! Wygląda na to, że\nmoja miłość do Pokémonów\npobiła twoją!\r</language>
	</row>
	<row id="msg_0723_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grr... Twoja miłość do\nPokémonów jest silniejsza niż\nmoja?\r</language>
	</row>
	<row id="msg_0723_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powiem ci, moje Pokémony\nsą jakąś odmianą twardości.</language>
	</row>
	<row id="msg_0723_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcesz mnie\nniedocenić.\r</language>
	</row>
	<row id="msg_0723_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś jakąś odmianą\npotężności.\r</language>
	</row>
	<row id="msg_0723_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, pokaż mi swojego\nulubionego Pokémona. Nie bądź\nteraz nieśmiały, dawaj.</language>
	</row>
	<row id="msg_0723_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem...\nUroczy, ale po słabszej\nstronie.\r</language>
	</row>
	<row id="msg_0723_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem!\nUroczy, a jednak twardy.\r</language>
	</row>
	<row id="msg_0723_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje Pokémony są\nurocze, ale nie są bardzo\ntwarde!</language>
	</row>
	<row id="msg_0723_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och?\nWygraliśmy? Serio?\r</language>
	</row>
	<row id="msg_0723_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To OK. Kocham moje\nPokémony. To wszystko, co się\nliczy.\r</language>
	</row>
	<row id="msg_0723_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozpieszczam moją grupę\ntrochę za dużo ostatnio. Czy\nmogą to zrobić?</language>
	</row>
	<row id="msg_0723_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, zrobili to!\nWiedziałem, że mogę liczyć\nna moją grupę!\r</language>
	</row>
	<row id="msg_0723_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozpieszczanie Pokémonów\nza dużo nie jest dobre...\r</language>
	</row>
	<row id="msg_0723_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie dołączysz do naszego\nFan Clubu Pokémon?</language>
	</row>
	<row id="msg_0723_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest wszelkiego rodzaju\nzabawne rzeczy do robienia,\njeśli dołączysz!\r</language>
	</row>
	<row id="msg_0723_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dołącz do nas!\nStań się fanem Pokémonów jak\nja!\r</language>
	</row>
	<row id="msg_0723_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę przyjąć twoje\nzamówienie, proszę?</language>
	</row>
	<row id="msg_0723_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, świetny wybór.\nJedna przegrana, podana na\nświeżo.\r</language>
	</row>
	<row id="msg_0723_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, doskonały wybór.\nJedna wygrana, podana na\nświeżo.\r</language>
	</row>
	<row id="msg_0723_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tym, kim naprawdę miałem\nnadzieję stać się, był kucharz.</language>
	</row>
	<row id="msg_0723_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie przeszkadza mi ta\npraca teraz, wiesz.\r</language>
	</row>
	<row id="msg_0723_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po prostu uważam, że\ntrudno rozmawiać z\nnieznajomymi.\r</language>
	</row>
	<row id="msg_0723_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Do walk i przyjmowania\nzamówień, szybkość jest\nniezbędna!</language>
	</row>
	<row id="msg_0723_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak, chop-chop!\nTwoje zamówienie już\ngotowe.\r</language>
	</row>
	<row id="msg_0723_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jedzenie jest jak walka.\nSerwuj je, gdy jest gorące!\r</language>
	</row>
	<row id="msg_0723_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja praca to serwowanie\ninnych. Ale nie oczekuj, że\nserwuję tu.</language>
	</row>
	<row id="msg_0723_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mufufu.\r</language>
	</row>
	<row id="msg_0723_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu nie mogłeś mi\nserwować? Tak nie zrobisz\nprzyjaciół!\r</language>
	</row>
	<row id="msg_0723_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy to nie urocze?\nMój mundurek.</language>
	</row>
	<row id="msg_0723_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To mój ulubiony!\r</language>
	</row>
	<row id="msg_0723_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zniszczyłeś mój mundurek!\r</language>
	</row>
	<row id="msg_0723_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś dobry, prawda?</language>
	</row>
	<row id="msg_0723_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ups.\nJestem trochę\nrozczarowany.\r</language>
	</row>
	<row id="msg_0723_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiedziałem, że jesteś\ntwardym trenerem.\r</language>
	</row>
	<row id="msg_0723_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Łapię i wychowuję\nwszelkiego rodzaju Pokémony.</language>
	</row>
	<row id="msg_0723_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz?\nWychowałem je całkiem dobrze.\r</language>
	</row>
	<row id="msg_0723_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę wychować moje\nPokémony jeszcze trochę!\r</language>
	</row>
	<row id="msg_0723_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złapię cię swoją siecią!</language>
	</row>
	<row id="msg_0723_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Już w worku!\r</language>
	</row>
	<row id="msg_0723_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej!\nNie uciekaj!\r</language>
	</row>
	<row id="msg_0723_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdzie mogę znaleźć\ngigantycznego HERACROSSA?</language>
	</row>
	<row id="msg_0723_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcę ogromnego\nHERACROSSA. Jak, rozmiar króla!\r</language>
	</row>
	<row id="msg_0723_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdybym tylko miał\ngigantycznego HERACROSSA...\r</language>
	</row>
	<row id="msg_0723_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przygotuj się na przegraną!</language>
	</row>
	<row id="msg_0723_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wróg jest mój!\r</language>
	</row>
	<row id="msg_0723_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leżę roztrzaskany...\r</language>
	</row>
	<row id="msg_0723_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spójrz na moją\nprzerażającą technikę ninja!</language>
	</row>
	<row id="msg_0723_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahah!\nWidziałeś to!\r</language>
	</row>
	<row id="msg_0723_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie dałeś się na moją\nfałszywą chwalbę ninja!\r</language>
	</row>
	<row id="msg_0723_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stanę się prawdziwym\nninja, gdy dorosnę!</language>
	</row>
	<row id="msg_0723_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doskonale! Doskonale!\r</language>
	</row>
	<row id="msg_0723_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, co powinien robić\nprawdziwy ninja?\r</language>
	</row>
	<row id="msg_0723_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy powinienem cię\nmęczyć?</language>
	</row>
	<row id="msg_0723_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jej! Jej!\r</language>
	</row>
	<row id="msg_0723_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie!\nNie męcz mnie!\r</language>
	</row>
	<row id="msg_0723_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja mamusia zrobiła mi\nten strój.</language>
	</row>
	<row id="msg_0723_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy to nie urocze?\r</language>
	</row>
	<row id="msg_0723_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja mamusia jest\nnaprawdę dobra w szyciu.\r</language>
	</row>
	<row id="msg_0723_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dajmy z siebie\nwszystko, wszyscy!</language>
	</row>
	<row id="msg_0723_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki, wszyscy!\r</language>
	</row>
	<row id="msg_0723_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waaaaah!\r</language>
	</row>
	<row id="msg_0723_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasne, będziemy walczyć,\nale nie przesadzaj z tym.</language>
	</row>
	<row id="msg_0723_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, spokojnie,\nspokojnie. Najlepiej być\nnaturalnym, rozumiesz?\r</language>
	</row>
	<row id="msg_0723_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz się jeszcze trochę\nrozluźnić.\r</language>
	</row>
	<row id="msg_0723_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ryby, ryby, ryby, to to,\nco robię! Złowię je wszystkie!</language>
	</row>
	<row id="msg_0723_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kahahah!\nJestem w szczytowej\nformie!\r</language>
	</row>
	<row id="msg_0723_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, waah!\nPuściłem to!\r</language>
	</row>
	<row id="msg_0723_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eksplorowanie w\nposzukiwaniu relikwii to nie\ntylko zabawa i gry!</language>
	</row>
	<row id="msg_0723_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twój poziom umiejętności\nmówi, że pewnie nie będziesz\ndobrym Łowcą Ruin.\r</language>
	</row>
	<row id="msg_0723_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niebezpieczeństwo czai\nsię wszędzie w ruinach!\r</language>
	</row>
	<row id="msg_0723_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ci oto towarzysze\npodróżowali ze mną po świecie!</language>
	</row>
	<row id="msg_0723_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co ty na to?\nCałkiem twarde, nie?\r</language>
	</row>
	<row id="msg_0723_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może czas, by znowu\nwyruszyć w drogę...\r</language>
	</row>
	<row id="msg_0723_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, tam! Zobacz to!\nMój rzadki Pokémon!</language>
	</row>
	<row id="msg_0723_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie tylko rzadki.\nMoje Pokémony są też twarde!\r</language>
	</row>
	<row id="msg_0723_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aiyah! Hej! Czekaj!\nNie! Stop! Nie dotykaj!\r</language>
	</row>
	<row id="msg_0723_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz po prostu bądź\ncierpliwy. Pokażę ci moją\nprywatną kolekcję!</language>
	</row>
	<row id="msg_0723_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz, widzisz? Czy\nnie były niesamowite? Są\nnajsuper z najlepszych!\r</language>
	</row>
	<row id="msg_0723_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Awawawah... Mój...\nMój Pokémon...\r</language>
	</row>
	<row id="msg_0723_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spójrz! To mój\nulubiony parasol! Och, i mój\nfantastyczny Pokémon!</language>
	</row>
	<row id="msg_0723_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy obaj nie są uroczy?\r</language>
	</row>
	<row id="msg_0723_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tylko ci pokazuję!\nNie możesz żadnego mieć!\r</language>
	</row>
	<row id="msg_0723_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widziałeś kiedyś tęczę?</language>
	</row>
	<row id="msg_0723_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zastanawiałeś się, co\nkryje się za tęczą?\r</language>
	</row>
	<row id="msg_0723_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzenie tęczy sprawia,\nże myślę, że dobre rzeczy mnie\nczekają.\r</language>
	</row>
	<row id="msg_0723_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli byłbyś pogodą,\nkim byłbyś teraz?</language>
	</row>
	<row id="msg_0723_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz czuję się słonecznie,\nbez chmury na niebie!\r</language>
	</row>
	<row id="msg_0723_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję się zamglony...\r</language>
	</row>
	<row id="msg_0723_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naprawdę nie lubię\nsłabych trenerów!</language>
	</row>
	<row id="msg_0723_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie wzbudzasz zbyt\nwiele zaufania...\r</language>
	</row>
	<row id="msg_0723_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trener Pokémon powinien\nbyć twardy i pełen życia!\r</language>
	</row>
	<row id="msg_0723_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatnio miałem wiele\nzmartwień...</language>
	</row>
	<row id="msg_0723_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrana sprawia, że\nwszystkie moje zmartwienia\nwydają się nieistotne!\r</language>
	</row>
	<row id="msg_0723_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Właśnie dodałeś się do\nmoich zmartwień...\r</language>
	</row>
	<row id="msg_0723_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To może odrobinę\nzaboleć, ale szybko skończymy.\nNie ruszaj się!</language>
	</row>
	<row id="msg_0723_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tam! Zrobione!\r</language>
	</row>
	<row id="msg_0723_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, nie!\nTo boli!\r</language>
	</row>
	<row id="msg_0723_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pociąganie nosem...\nPociąganie...</language>
	</row>
	<row id="msg_0723_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pociąganie...\nChyba mam przeziębienie...\r</language>
	</row>
	<row id="msg_0723_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pociąganie...\nMój nos się zatyka...\r</language>
	</row>
	<row id="msg_0723_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pociąganie...</language>
	</row>
	<row id="msg_0723_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A teraz, czym może być\nten aromat?\r</language>
	</row>
	<row id="msg_0723_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz na sobie jakąś\nwodę kolońską? Pachniesz\ncałkiem miło!\r</language>
	</row>
	<row id="msg_0723_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrasz, ale będziesz\nmógł zachwycać się miłym\naromatem!</language>
	</row>
	<row id="msg_0723_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kyahaha! Tak to\nwłaśnie masz za omdlenie od\nmojego aromatu!\r</language>
	</row>
	<row id="msg_0723_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kiiiih!\nJestem tak zły!\r</language>
	</row>
	<row id="msg_0723_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niech moja gitara zawyje!\nUsłysz, jak krzyczę!</language>
	</row>
	<row id="msg_0723_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeahey!\r</language>
	</row>
	<row id="msg_0723_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giyaaaah!\r</language>
	</row>
	<row id="msg_0723_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powinieneś przekazywać\nswoje uczucia w pieśniach z\nszczerością, stary.</language>
	</row>
	<row id="msg_0723_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak się teraz czuję?\nTo rock!\r</language>
	</row>
	<row id="msg_0723_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak się teraz czuję, to\njakby folkowo.\r</language>
	</row>
	<row id="msg_0723_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz usłysz mnie!\nCredo numer jeden Opiekuna\nPtaków!</language>
	</row>
	<row id="msg_0723_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybuj wysoko na\nwygranej!\r</language>
	</row>
	<row id="msg_0723_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odpocznij swoim\nskrzydłom na porażce!\r</language>
	</row>
	<row id="msg_0723_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dajmy z siebie\noboje wszystko!</language>
	</row>
	<row id="msg_0723_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jup, obaj daliśmy z\nsiebie wszystko, co mogliśmy!\r</language>
	</row>
	<row id="msg_0723_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobra robota!\r</language>
	</row>
	<row id="msg_0723_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leć, leć, leć!\nBędziemy władać tą walką!</language>
	</row>
	<row id="msg_0723_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zoom!\r</language>
	</row>
	<row id="msg_0723_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaraz się rozbijemy!\r</language>
	</row>
	<row id="msg_0723_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Marynarzem z\nMarynarzy! Urodziłem się na\notwartym morzu!</language>
	</row>
	<row id="msg_0723_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fale kołysały mnie do\nsnu! Morze było moją matką!\r</language>
	</row>
	<row id="msg_0723_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urp... Gweh... Więc,\ngdy wchodzę na ląd,\ndostaję choroby bez ruchu...\r</language>
	</row>
	<row id="msg_0723_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham morze w sumie...</language>
	</row>
	<row id="msg_0723_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och... Słyszę je...\nSłyszę dźwięk fal...\r</language>
	</row>
	<row id="msg_0723_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcę stać się wielkim\nczłowiekiem. Wielkim jak morze\njest wielkie.\r</language>
	</row>
	<row id="msg_0723_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yahoo!</language>
	</row>
	<row id="msg_0723_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj!\nTy też wyj!\r</language>
	</row>
	<row id="msg_0723_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gweff! Hack! Hack!\nWycie mnie zakrztusiło!\r</language>
	</row>
	<row id="msg_0723_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powinieneś dążyć do\nstylu życia Hikera!</language>
	</row>
	<row id="msg_0723_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz?\nKochasz mój styl życia,\nprawda?\r</language>
	</row>
	<row id="msg_0723_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj teraz!\nPowinieneś spojrzeć z\nuznaniem na to, jak żyję!\r</language>
	</row>
	<row id="msg_0723_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja i moje Pokémony\njesteśmy Idolami!</language>
	</row>
	<row id="msg_0723_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mów, co chcesz!\nJesteśmy Idolami!\r</language>
	</row>
	<row id="msg_0723_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pobijamy was, gdy\nmowa o popularności...\r</language>
	</row>
	<row id="msg_0723_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Patrz na mnie!\nWszystkie oczy na mnie!</language>
	</row>
	<row id="msg_0723_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh...\nTo jest to, dla czego żyję...\r</language>
	</row>
	<row id="msg_0723_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stałam się Idolką, bo\nchciałam, żeby wszyscy mnie\nwidzieli!\r</language>
	</row>
	<row id="msg_0723_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbyt lubię walczyć...\nMogą mnie wyrzucić jako\nIdolkę...</language>
	</row>
	<row id="msg_0723_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczenie jest zbyt\nzabawne!\r</language>
	</row>
	<row id="msg_0723_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę się powstrzymać.\nNikt nie może mnie powstrzymać\nod walczenia.\r</language>
	</row>
	<row id="msg_0723_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biegam w maratonie\nkażdego ranka! To świetne!</language>
	</row>
	<row id="msg_0723_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja muskularna\npostawa daje łatwe wygrane!\r</language>
	</row>
	<row id="msg_0723_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc przegrałem!\nWciąż mogę biegać świetne\nmaratony!\r</language>
	</row>
	<row id="msg_0723_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będę biegać w miejscu,\nwalcząc, dla dobra mojego\nzdrowia.</language>
	</row>
	<row id="msg_0723_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wysłuchajmy tego, by\nzdrowie było dobre!\r</language>
	</row>
	<row id="msg_0723_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Łał!\nMoja kostka! Skręciłem\nkostkę!\r</language>
	</row>
	<row id="msg_0723_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z drogi!\nMam dostawy do zrobienia!</language>
	</row>
	<row id="msg_0723_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? Chcesz, żebym\ndoręczył też ciebie\ngdzieś?\r</language>
	</row>
	<row id="msg_0723_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cały dowóz, który robię\nkażdego dnia...\nMam głęboki ból mięśni!\r</language>
	</row>
	<row id="msg_0723_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To ja postawiłem\nbudynki w tych okolicach.</language>
	</row>
	<row id="msg_0723_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, co myślisz?\nSuper rzeczy, nie?\r</language>
	</row>
	<row id="msg_0723_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moim snem jest zbudowanie\nbudynku wyższego niż góra!\r</language>
	</row>
	<row id="msg_0723_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czujesz to? To zapach\nsiana przyklejony do mojego\nciała.</language>
	</row>
	<row id="msg_0723_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Łał!\r</language>
	</row>
	<row id="msg_0723_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten zapach, który mam,\nto słodki aromat siana, które\nz pewnością kochają Pokémony.\r</language>
	</row>
	<row id="msg_0723_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku, zaatakuj\nmnie! Moja klatka piersiowa\njak baryłka to zniesie!</language>
	</row>
	<row id="msg_0723_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? To wszystko, co\nmasz? Możesz uderzyć mnie\nmocniej!\r</language>
	</row>
	<row id="msg_0723_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh... Ał... To zabolało...\nJakbyś złamał mi klatkę\npiersiową jak baryłkę...\r</language>
	</row>
	<row id="msg_0723_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie staję się młodszy.\nNie mogę się przemęczać.</language>
	</row>
	<row id="msg_0723_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czego mi brakuje w\nmłodości, nadrabiam\ndoświadczeniem.\r</language>
	</row>
	<row id="msg_0723_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, jesteś dobry i\nmłody. Jest w tobie jakiś\nblask.\r</language>
	</row>
	<row id="msg_0723_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej! Ty tam, trenerze!\nTy i ja, walczymy!</language>
	</row>
	<row id="msg_0723_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pobity!\r</language>
	</row>
	<row id="msg_0723_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niewiarygodne!\r</language>
	</row>
	<row id="msg_0723_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To tu są moje Pokémony.\nWychowałem je z moją mamą i\ntatą.</language>
	</row>
	<row id="msg_0723_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Całkiem twarde, prawda?\r</language>
	</row>
	<row id="msg_0723_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, niech mnie!\nPrzegraliśmy tę jedną!\r</language>
	</row>
	<row id="msg_0723_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam wszystko, na co\njestem zdolny. Lepiej dotrzymaj\nkroku!</language>
	</row>
	<row id="msg_0723_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uff! Daliśmy z siebie\nwszystko!\r</language>
	</row>
	<row id="msg_0723_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jup! Staraliśmy się,\nwszyscy!\r</language>
	</row>
	<row id="msg_0723_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, wszyscy!\nWielkie uśmiechy!</language>
	</row>
	<row id="msg_0723_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wielkie uśmiechy!\nDawaj!\r</language>
	</row>
	<row id="msg_0723_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To świetny uśmiech!\nTwoja poza zwycięstwa też\njest idealna na zdjęcie!\r</language>
	</row>
	<row id="msg_0723_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbliżenie na ciebie!</language>
	</row>
	<row id="msg_0723_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Precyzyjny fokus!\r</language>
	</row>
	<row id="msg_0723_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oddalenie, zanik...\r</language>
	</row>
	<row id="msg_0723_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten aparat jest\nwłaściwie całkiem masywny.</language>
	</row>
	<row id="msg_0723_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje ramię jest\nzawsze sztywne jak skała...\nMój aparat mnie zahartował.\r</language>
	</row>
	<row id="msg_0723_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oof...\nCzuję się zamroczony...\r</language>
	</row>
	<row id="msg_0723_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj tam, trenerze!\nProszę, zawalcz ze mną!</language>
	</row>
	<row id="msg_0723_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki za pomoc!\r</language>
	</row>
	<row id="msg_0723_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doceniam tę lekcję!\r</language>
	</row>
	<row id="msg_0723_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrobię wszystko dla\ndobrej historii do wiadomości!</language>
	</row>
	<row id="msg_0723_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem nieustępliwy co\ndo walczenia też!\r</language>
	</row>
	<row id="msg_0723_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stop! Proszę, stop!\nZłamiesz mój mikrofon!\r</language>
	</row>
	<row id="msg_0723_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, pytanie jest, jaka\njest twoja opinia o mnie?</language>
	</row>
	<row id="msg_0723_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">„Co za twardy trener!”\nTak myślisz?\r</language>
	</row>
	<row id="msg_0723_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robię relację na żywo na\ntemat samego siebie!\r</language>
	</row>
	<row id="msg_0723_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj!\nPobiegniemy! Wspólnie!</language>
	</row>
	<row id="msg_0723_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gooooooooaaaaal!\r</language>
	</row>
	<row id="msg_0723_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekaj!\nNie zostawiaj mnie!\r</language>
	</row>
	<row id="msg_0723_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zmiana biegu!\nAtakujemy na maksymalnej\nprędkości!</language>
	</row>
	<row id="msg_0723_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vrooooom!\r</language>
	</row>
	<row id="msg_0723_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kaboom!\r</language>
	</row>
	<row id="msg_0723_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dasz radę dotrzymać kroku\nmojemu Pokémonowi w pełnym\nbiegu?</language>
	</row>
	<row id="msg_0723_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Za wolno!\r</language>
	</row>
	<row id="msg_0723_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zabieram to do strefy\npoza prędkość!\r</language>
	</row>
	<row id="msg_0723_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wolałbym jeździć spokojnie\nniż na pełnej prędkości.</language>
	</row>
	<row id="msg_0723_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weźmy to na spokojnie.\r</language>
	</row>
	<row id="msg_0723_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powinieneś podejść do\nrzeczy bardziej na spokojnie...\r</language>
	</row>
	<row id="msg_0723_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znam tylko jedną\nprędkość--pełną moc, nawet\nprzeciwko młodszemu wrogowi!</language>
	</row>
	<row id="msg_0723_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pełna moc to sposób, w\njaki wygrywam!\r</language>
	</row>
	<row id="msg_0723_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę! Pozwól mi\nnazywać cię Mistrzem Trenerem\nod teraz!\r</language>
	</row>
	<row id="msg_0723_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój duch płonie, moje\npięści są ze stali, a mój\npot się leje!</language>
	</row>
	<row id="msg_0723_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hrrumph!\r</language>
	</row>
	<row id="msg_0723_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pociłem się bardziej. To\nczyni mnie zwycięzcą!\r</language>
	</row>
	<row id="msg_0723_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">En garde!</language>
	</row>
	<row id="msg_0723_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wciąż jestem gotów na\nwięcej.\r</language>
	</row>
	<row id="msg_0723_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urgh... Nie zapomnij o\ntym!\r</language>
	</row>
	<row id="msg_0723_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej! Dawaj!</language>
	</row>
	<row id="msg_0723_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niezła walka!\r</language>
	</row>
	<row id="msg_0723_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jesteś taki zły, ty.\r</language>
	</row>
	<row id="msg_0723_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostateczny z moich\ntechnik! Poczuj go w całej\npełni!</language>
	</row>
	<row id="msg_0723_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem najlepszy!\nGwahahaha!\r</language>
	</row>
	<row id="msg_0723_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Upadłem w porażce?\nGw-gwaaah!\r</language>
	</row>
	<row id="msg_0723_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi! Mały dzieciaku!\nProszę o walkę!</language>
	</row>
	<row id="msg_0723_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mały dzieciaku!\nDziękuję bardzo serdecznie!\r</language>
	</row>
	<row id="msg_0723_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mały dzieciaku!\nJestem naprawdę zrozpaczony\nprzez to!\r</language>
	</row>
	<row id="msg_0723_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja, um... Nigdy nie\nnauczyłem się naprawdę karate.</language>
	</row>
	<row id="msg_0723_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żartujesz?!\nJestem naturalnie\nutalentowany?!\r</language>
	</row>
	<row id="msg_0723_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czarny Pas jest cool,\nhuh? Więc po prostu się tak\nprzebieram.\r</language>
	</row>
	<row id="msg_0723_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Minęło pięć lat, odkąd\nudałem się w góry. Moje włosy\nurosły dziko!</language>
	</row>
	<row id="msg_0723_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kąpię się codziennie!\nJak śmiesz?\r</language>
	</row>
	<row id="msg_0723_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kolejnych pięć lat...?\r</language>
	</row>
	<row id="msg_0723_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złapałem cię, jak się\nuśmiechasz z moich ośmiopaków?</language>
	</row>
	<row id="msg_0723_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie doceniasz piękna\nczystych mięśni!\r</language>
	</row>
	<row id="msg_0723_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muskulatura to\nostateczna piękność!\r</language>
	</row>
	<row id="msg_0723_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W miłości i w walkach,\nnigdy nie zaznałem porażki!</language>
	</row>
	<row id="msg_0723_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? Wygraliśmy\nznowu!\r</language>
	</row>
	<row id="msg_0723_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc przegrałem. Nie\nobchodzi mnie to! Mam randkę\nwkrótce, więc nie obchodzi mnie\nto!\r</language>
	</row>
	<row id="msg_0723_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest to! Przez szczyt!\nWszyscy, szarża!</language>
	</row>
	<row id="msg_0723_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wrogi trener upadł!\nZwycięstwo jest nasze!\r</language>
	</row>
	<row id="msg_0723_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wycofać się!\nOgłoś odwrót!\r</language>
	</row>
	<row id="msg_0723_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja kariera jako\ntrenera trwa od 75 lat. Myślisz,\nże możesz wygrać?</language>
	</row>
	<row id="msg_0723_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oto toast za moją\nhistorię!\r</language>
	</row>
	<row id="msg_0723_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja historia chwały...\r</language>
	</row>
	<row id="msg_0723_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś przygotowany?</language>
	</row>
	<row id="msg_0723_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, to była wspaniała\nwalka.\r</language>
	</row>
	<row id="msg_0723_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kłaniam się przed tobą.\r</language>
	</row>
	<row id="msg_0723_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, mój...\nTaki uroczy trener...</language>
	</row>
	<row id="msg_0723_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy jesteśmy\nrozczarowani? Jak uroczo...\r</language>
	</row>
	<row id="msg_0723_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem...\nJesteś czymś więcej niż po\nprostu uroczy.\r</language>
	</row>
	<row id="msg_0723_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eee-yeah!</language>
	</row>
	<row id="msg_0723_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porywający krzyk, nie\nsądzisz? Znajduję go całkiem\norzeźwiającym.</language>
	</row>
	<row id="msg_0723_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zipnięcie... Zipnięcie...\nOch, kochanie... Jestem\nwyczerpany.\r</language>
	</row>
	<row id="msg_0723_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bycie bogatym nie chroni\nmnie od zmartwień...</language>
	</row>
	<row id="msg_0723_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczywiście, być dobrze\nsytuowanym jest dużo lepsze\nniż ubóstwo, ale...\r</language>
	</row>
	<row id="msg_0723_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ekstrawaganckie przyjęcia\ndzień po dniu...\nTo staje się raczej\nnużące, muszę powiedzieć.\r</language>
	</row>
	<row id="msg_0723_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poznaj porażkę...\nNaucz się, co znaczy walczyć...</language>
	</row>
	<row id="msg_0723_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzę, że stajesz się\ncoraz silniejszy...\r</language>
	</row>
	<row id="msg_0723_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokonani po prostu się\nwymykają...\r</language>
	</row>
	<row id="msg_0723_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spójrz w moje oczy!</language>
	</row>
	<row id="msg_0723_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Padłeś pod moim\nurokiem!\r</language>
	</row>
	<row id="msg_0723_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja moc sugestii nie\nzdołała cię zauroczyć!\r</language>
	</row>
	<row id="msg_0723_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...</language>
	</row>
	<row id="msg_0723_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Zrobiłem to.\r</language>
	</row>
	<row id="msg_0723_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skoncentrowałem swój\numysł w ciszy...\r</language>
	</row>
	<row id="msg_0723_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje moce!\nNie ma w nich żadnego\noszustwa!</language>
	</row>
	<row id="msg_0723_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest moc psychiczna!\r</language>
	</row>
	<row id="msg_0723_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naprawdę nie ma żadnego\noszustwa...\r</language>
	</row>
	<row id="msg_0723_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Weź to wszystko!</language>
	</row>
	<row id="msg_0723_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ahaha!\r</language>
	</row>
	<row id="msg_0723_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gah!\r</language>
	</row>
	<row id="msg_0723_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zamknij oczy i licz...\nWolno... Wolniej...</language>
	</row>
	<row id="msg_0723_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To było odliczanie do\nmojej wygranej!\r</language>
	</row>
	<row id="msg_0723_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tch...\nMyślałem, że mogę cię\nukołysać do snu.\r</language>
	</row>
	<row id="msg_0723_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyję wśród Pokémonów.</language>
	</row>
	<row id="msg_0723_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie byłem dobrym\nwalczącym, ale...\r</language>
	</row>
	<row id="msg_0723_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po prostu nie jestem\nzbyt dobrym walczącym.\r</language>
	</row>
	<row id="msg_0723_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...To Pokémony, które\nwychowałem z moim tatą...\r</language>
	</row>
	<row id="msg_0723_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Tato, widzisz to?\nZrobiłem to...\r</language>
	</row>
	<row id="msg_0723_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tato, nie mogę...\nMuszę je jeszcze trochę\nwychować.\r</language>
	</row>
	<row id="msg_0723_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wychowywanie Pokémonów\nwymaga wiele uczciwego\nwysiłku!</language>
	</row>
	<row id="msg_0723_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yahaha! Miałem praktyczny\nczas, wychowując te Pokémony!\r</language>
	</row>
	<row id="msg_0723_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urgwah!\nZobacz, co zrobiłeś mojemu\nPokémonowi!\r</language>
	</row>
	<row id="msg_0723_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz spojrzeć na\nPokémona, którego wychowałam?</language>
	</row>
	<row id="msg_0723_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No?\nUrocze, nieprawdaż?\r</language>
	</row>
	<row id="msg_0723_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daj dziewczynie trochę\nwytchnienia!\r</language>
	</row>
	<row id="msg_0723_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Specjalizuję się w\nwychowywaniu uroczych Pokémonów!</language>
	</row>
	<row id="msg_0723_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uroczy, a jednak silny!\nPrawda?\r</language>
	</row>
	<row id="msg_0723_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, ale są tak urocze!\r</language>
	</row>
	<row id="msg_0723_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miło cię poznać!\nNie doceniaj mnie na własne\nryzyko!</language>
	</row>
	<row id="msg_0723_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówiłem ci!\r</language>
	</row>
	<row id="msg_0723_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że cię\nniedoceniłem...\r</language>
	</row>
	<row id="msg_0723_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmhm... Muszę\npowiedzieć, że lubię wyraz\ntwoich oczu.</language>
	</row>
	<row id="msg_0723_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje oczy pozostają\nniezmętnione w porażce. Są\njak klejnoty!\r</language>
	</row>
	<row id="msg_0723_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje oczy świecą\njaśniej niż jakikolwiek wielki\nklejnot, który mam w domu!\r</language>
	</row>
	<row id="msg_0723_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy byłem w twoim wieku,\nbyłem całkiem ryzykantem,\nmuszę powiedzieć.</language>
	</row>
	<row id="msg_0723_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widok ciebie przypomina\nmi moją własną dziką\nmłodość.\r</language>
	</row>
	<row id="msg_0723_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odważę się rzec, że ty\nsam jesteś całkiem\nryzykantem!\r</language>
	</row>
	<row id="msg_0723_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chcesz pobiec do\ndomu do mamusi, oto twoja\nszansa, pankerze!</language>
	</row>
	<row id="msg_0723_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Geheheh!\r</language>
	</row>
	<row id="msg_0723_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waah!\nChcę moją mamusię!\r</language>
	</row>
	<row id="msg_0723_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walki niczego nie\nosiągają! Weź moją rękę!\nTo chodzi o miłość!</language>
	</row>
	<row id="msg_0723_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie miałem na myśli\nwalki--ale weź moją rękę! To\nchodzi o miłość!\r</language>
	</row>
	<row id="msg_0723_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczenie jest\nbezcelowe! Weź moją rękę! To\nchodzi o miłość!\r</language>
	</row>
	<row id="msg_0723_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgubiłem moje okulary.\nNie widzę dobrze.</language>
	</row>
	<row id="msg_0723_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że wygrałem. Nie\nwidzę wystarczająco, by\npowiedzieć.\r</language>
	</row>
	<row id="msg_0723_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że przegrałem.\nNie widzę wystarczająco, by\npowiedzieć.\r</language>
	</row>
	<row id="msg_0723_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stabilnie i pewnie.\nBudujesz od małych rzeczy w\ngórę.</language>
	</row>
	<row id="msg_0723_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stabilnie i pewnie, tak\nwygrałem!\r</language>
	</row>
	<row id="msg_0723_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ale robiłem rzeczy\nstabilnie i pewnie...\r</language>
	</row>
	<row id="msg_0723_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hehehehe...</language>
	</row>
	<row id="msg_0723_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gehahahaha!\r</language>
	</row>
	<row id="msg_0723_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szloch, szloch, szloch...\r</language>
	</row>
	<row id="msg_0723_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszyscy, zbierzcie się\nwokół mnie na mój fenomenalny\npokaz Pokémonów!</language>
	</row>
	<row id="msg_0723_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy to nie było zabawne?\r</language>
	</row>
	<row id="msg_0723_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nrrgh...\nNie jestem rozbawiony.\r</language>
	</row>
	<row id="msg_0723_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będę trenować z tobą.</language>
	</row>
	<row id="msg_0723_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokaż, że masz\ncharakter! Na nogi!\r</language>
	</row>
	<row id="msg_0723_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze!\nTo wystarczy!\r</language>
	</row>
	<row id="msg_0723_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu robić z tego\nwielki intelektualny problem?\nJeśli to zabawne, czemu\npytać?</language>
	</row>
	<row id="msg_0723_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz, wciąż mogę\nwygrać. Nie widzę problemu!\r</language>
	</row>
	<row id="msg_0723_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc przegrałem!\nJeśli to zabawne, to jest\ncool!\r</language>
	</row>
	<row id="msg_0723_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczekuję, że będziesz\ndobry... Nie zawiedź mnie!</language>
	</row>
	<row id="msg_0723_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja nadzieja była\nniesłusznie umieszczona...\r</language>
	</row>
	<row id="msg_0723_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz dobre rzeczy.\r</language>
	</row>
	<row id="msg_0723_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój tata i mama też są\ntrenerami wysokiego poziomu.</language>
	</row>
	<row id="msg_0723_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest w mojej\nlinii krwi!\r</language>
	</row>
	<row id="msg_0723_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tato, mamo!\nTak mi przykro!\r</language>
	</row>
	<row id="msg_0723_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Idę na całość w walce,\nbez względu na wszystko.</language>
	</row>
	<row id="msg_0723_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieunikniony wniosek!\r</language>
	</row>
	<row id="msg_0723_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyznaję się do\nprzegranej!\r</language>
	</row>
	<row id="msg_0723_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest to! Największa\nwalka w moim życiu! Nie mogę\npozwolić sobie na przegraną!</language>
	</row>
	<row id="msg_0723_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Woot, tak!\r</language>
	</row>
	<row id="msg_0723_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To ustawia mnie z\npowrotem do bycia Panienką...\r</language>
	</row>
	<row id="msg_0723_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja miłość do natury\ni Pokémonów uczyniła ze mnie\nStrażnika!</language>
	</row>
	<row id="msg_0723_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja też kocham walczyć!\r</language>
	</row>
	<row id="msg_0723_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh...\nWciąż kocham walczyć, też.\r</language>
	</row>
	<row id="msg_0723_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi! Rozważałeś\nkiedykolwiek karierę jako\nStrażnik?</language>
	</row>
	<row id="msg_0723_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, może nie uda ci\nsię na twoim poziomie\numiejętności.\r</language>
	</row>
	<row id="msg_0723_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, masz w sobie\nhart. Bycie Strażnikiem to\nwielka zabawa!\r</language>
	</row>
	<row id="msg_0723_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrana czy przegrana,\nwalka zdarza się tylko raz!</language>
	</row>
	<row id="msg_0723_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz jakieś żale?\r</language>
	</row>
	<row id="msg_0723_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mam żadnych żali!\r</language>
	</row>
	<row id="msg_0723_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To moja przysięgła\npowinność, by chronić naturę i\nPokémony w niej.</language>
	</row>
	<row id="msg_0723_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest wymagające\nżycie, ale jest wiele do\ncieszenia się każdego dnia.\r</language>
	</row>
	<row id="msg_0723_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To satysfakcjonująca\nkariera.\nJak ci się to podoba?\r</language>
	</row>
	<row id="msg_0723_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój ukochany Pokémon\nciebie poliże!</language>
	</row>
	<row id="msg_0723_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No? Zadowolony?\r</language>
	</row>
	<row id="msg_0723_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, czy nie jesteś\ntwardy? Jestem lekko\nzaskoczony!\r</language>
	</row>
	<row id="msg_0723_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie spałem, próbując\nwymyślić tę nową strategię!</language>
	</row>
	<row id="msg_0723_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja strategia\nzadziałała!\r</language>
	</row>
	<row id="msg_0723_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, ale...\nNaprawdę musiałem dziś się\nwyspać...\r</language>
	</row>
	<row id="msg_0723_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Credo Poskromiciela\nSmoków! Numer jeden!</language>
	</row>
	<row id="msg_0723_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W zwycięstwie, ryknij!\nRyknij ze swoim smokiem!\r</language>
	</row>
	<row id="msg_0723_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet w porażce, ryknij!\nRyknij ze swoim smokiem!\r</language>
	</row>
	<row id="msg_0723_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potężny! Jak smok!</language>
	</row>
	<row id="msg_0723_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Silny, jestem!\r</language>
	</row>
	<row id="msg_0723_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Urf...\nChciałem być silny...\r</language>
	</row>
	<row id="msg_0723_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zobacz to! Poczuj to!\nOstateczna moc... Pewnie!</language>
	</row>
	<row id="msg_0723_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma porażki dla mnie,\nostatecznego... Pewnie!\r</language>
	</row>
	<row id="msg_0723_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tytuł ostatecznego pewnie!\nPrzyznaję ci go!\r</language>
	</row>
	<row id="msg_0723_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, wow!\nRzadki Pokémon!</language>
	</row>
	<row id="msg_0723_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hihihi... To właśnie\ndostajesz za spuszczenie gardy.\r</language>
	</row>
	<row id="msg_0723_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tch.\nNie mogłeś mnie oszukać.\r</language>
	</row>
	<row id="msg_0723_00468" index="468">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę znieść zimna,\nale jestem całkiem dobry.</language>
	</row>
	<row id="msg_0723_00469" index="469">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ch-chatter...\nWa-wahaha. Wygrałem,\nwygrałem!\r</language>
	</row>
	<row id="msg_0723_00470" index="470">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ch-chatter... Urr...\nRobię się śpiący...\r</language>
	</row>
	<row id="msg_0723_00471" index="471">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje asy Pokémon są w\nruchu!</language>
	</row>
	<row id="msg_0723_00472" index="472">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaskakujesz mnie!\nNie tak źle!\r</language>
	</row>
	<row id="msg_0723_00473" index="473">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podoba mi się sens,\njaki pokazujesz!\r</language>
	</row>
	<row id="msg_0723_00474" index="474">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śnieg jest cudowny!\nWszystko staje się białe.</language>
	</row>
	<row id="msg_0723_00475" index="475">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śnieg jest tak\nromantyczny!\r</language>
	</row>
	<row id="msg_0723_00476" index="476">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robię się cały biały...\r</language>
	</row>
	<row id="msg_0723_00477" index="477">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie myślisz, że ten\npłaszcz jest uroczy? Ogranicza\nmoje ruchy, jednak.</language>
	</row>
	<row id="msg_0723_00478" index="478">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest przyjemnie ciepło.\r</language>
	</row>
	<row id="msg_0723_00479" index="479">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję się zasypany\nśniegiem...\r</language>
	</row>
	<row id="msg_0723_00480" index="480">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem tym jedynym!\nNumer jeden ze wszystkich\ndzieci w szortach!</language>
	</row>
	<row id="msg_0723_00481" index="481">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? O to właśnie\nchodzi w byciu numerem jeden!\r</language>
	</row>
	<row id="msg_0723_00482" index="482">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A niech to...\nJestem numerem jeden...\r</language>
	</row>
	<row id="msg_0723_00483" index="483">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem tym jedynym!\nJedynym prawdziwym wśród\ndzieci noszących szorty!</language>
	</row>
	<row id="msg_0723_00484" index="484">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? O to właśnie\nchodzi w byciu jedynym!\r</language>
	</row>
	<row id="msg_0723_00485" index="485">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ack...\nJestem jedynym...\r</language>
	</row>
	<row id="msg_0723_00486" index="486">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um...\nJestem zachwycony,\npoznawszy cię.</language>
	</row>
	<row id="msg_0723_00487" index="487">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Awawa... Wygraliśmy?\nUm? P-przepraszam.\r</language>
	</row>
	<row id="msg_0723_00488" index="488">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Er, um...\nDz-dziękuję...\r</language>
	</row>
	<row id="msg_0723_00489" index="489">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No dalej!</language>
	</row>
	<row id="msg_0723_00490" index="490">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brawo!\r</language>
	</row>
	<row id="msg_0723_00491" index="491">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jip!\r</language>
	</row>
	<row id="msg_0723_00492" index="492">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty też się uczysz!</language>
	</row>
	<row id="msg_0723_00493" index="493">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Surowe realia walczenia!\r</language>
	</row>
	<row id="msg_0723_00494" index="494">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Radość zwycięstwa!\r</language>
	</row>
	<row id="msg_0723_00495" index="495">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozwól mi cię zbadać.</language>
	</row>
	<row id="msg_0723_00496" index="496">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie dałeś mi niczego\nnowego do nauczenia się.\r</language>
	</row>
	<row id="msg_0723_00497" index="497">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz rozumiem. W tej\nsytuacji powinienem był użyć\ntego ruchu.\r</language>
	</row>
	<row id="msg_0723_00498" index="498">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój nauczyciel dał mi\nradę na temat walczenia.</language>
	</row>
	<row id="msg_0723_00499" index="499">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój nauczyciel miał\nrację! To było tak łatwe!\r</language>
	</row>
	<row id="msg_0723_00500" index="500">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, mój nauczyciel się\nmylił! Nic z tego nie\nzadziałało!\r</language>
	</row>
	<row id="msg_0723_00501" index="501">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu walczymy?\nNie rozumiem tego.</language>
	</row>
	<row id="msg_0723_00502" index="502">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu? Nie rozumiem.\r</language>
	</row>
	<row id="msg_0723_00503" index="503">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu wygrałeś?\nCo się teraz stanie?\r</language>
	</row>
	<row id="msg_0723_00504" index="504">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostatecznie, Pokémon to\ntylko kolejna marka. Wiesz,\nkto wygra, prawda?</language>
	</row>
	<row id="msg_0723_00505" index="505">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jestem\nzainteresowany tym, co było\nnieuniknionym wynikiem.\r</language>
	</row>
	<row id="msg_0723_00506" index="506">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ale jak... Mój...\nPokémon, którego wychowałem...\r</language>
	</row>
	<row id="msg_0723_00507" index="507">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma niczego, czego\nnie mogę kupić. Pieniądze\nmogą kupić walki!</language>
	</row>
	<row id="msg_0723_00508" index="508">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma nic, czego\npieniądze nie mogą kupić.\r</language>
	</row>
	<row id="msg_0723_00509" index="509">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dam ci moje kieszonkowe,\njeśli pozwolisz mi wygrać.\r</language>
	</row>
	<row id="msg_0723_00510" index="510">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiesz, naprawdę nie jestem\nstworzona do bycia tą panną z\ntowarzystwa...</language>
	</row>
	<row id="msg_0723_00511" index="511">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gahahahah!\r</language>
	</row>
	<row id="msg_0723_00512" index="512">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty prosiaku! Teraz\njestem wściekła!\r</language>
	</row>
	<row id="msg_0723_00513" index="513">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skończę z tobą w mig!</language>
	</row>
	<row id="msg_0723_00514" index="514">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W mig to jak zostałeś\nskończony!\r</language>
	</row>
	<row id="msg_0723_00515" index="515">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W mig to jak się\nwytłumaczę!\r</language>
	</row>
	<row id="msg_0723_00516" index="516">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chrup-chrup...\nChrup-chrup...</language>
	</row>
	<row id="msg_0723_00517" index="517">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham te chrupiące\nCiasteczka Lawowe...\r</language>
	</row>
	<row id="msg_0723_00518" index="518">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na czym stoję?\nNa rozbitych Poké Ballach?\r</language>
	</row>
	<row id="msg_0723_00519" index="519">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Droga Łowcy Owadów!\nBądź świadkiem tego!</language>
	</row>
	<row id="msg_0723_00520" index="520">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest droga Łowcy\nOwadów!\r</language>
	</row>
	<row id="msg_0723_00521" index="521">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chwała Łowcom Owadów!\r</language>
	</row>
	<row id="msg_0723_00522" index="522">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Napas oczy tajnymi\ntechnikami starożytnych!</language>
	</row>
	<row id="msg_0723_00523" index="523">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? Co myślisz?\nJesteś w zdumieniu?\r</language>
	</row>
	<row id="msg_0723_00524" index="524">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To mój sygnał, by zniknąć\nw obłoku dymu.\r</language>
	</row>
	<row id="msg_0723_00525" index="525">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzę to!</language>
	</row>
	<row id="msg_0723_00526" index="526">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie myśl o mnie źle...\r</language>
	</row>
	<row id="msg_0723_00527" index="527">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gyoeeeh!\r</language>
	</row>
	<row id="msg_0723_00528" index="528">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikaaa!</language>
	</row>
	<row id="msg_0723_00529" index="529">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikapikaaah!\r</language>
	</row>
	<row id="msg_0723_00530" index="530">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pi pika...\r</language>
	</row>
	<row id="msg_0723_00531" index="531">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka, mówisz?\nNigdy z tobą nie przegram!</language>
	</row>
	<row id="msg_0723_00532" index="532">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yeehah! Jippie!\nWygrałem, wygrałem!\r</language>
	</row>
	<row id="msg_0723_00533" index="533">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urk...\nPrzegraliśmy...\r</language>
	</row>
	<row id="msg_0723_00534" index="534">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To moja praca, by być\nuroczą!</language>
	</row>
	<row id="msg_0723_00535" index="535">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samo bycie uroczą to\npieniądze w banku!\r</language>
	</row>
	<row id="msg_0723_00536" index="536">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ugagaah!\nTy zgniły złodzieju!\r</language>
	</row>
	<row id="msg_0723_00537" index="537">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz uścisnąć mi rękę!\nTo byłby dla ciebie wielki\nhonor!</language>
	</row>
	<row id="msg_0723_00538" index="538">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdybyś wygrał, dałabym\nci nawet mój autograf!\r</language>
	</row>
	<row id="msg_0723_00539" index="539">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój zespół menadżerski\nbędzie miał coś do powiedzenia\nna ten temat!\r</language>
	</row>
	<row id="msg_0723_00540" index="540">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biegnij!\nNie myśl! Biegnij!</language>
	</row>
	<row id="msg_0723_00541" index="541">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybciej!\nWięcej! Więcej! Szybciej!\r</language>
	</row>
	<row id="msg_0723_00542" index="542">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biegnij!\nBiegnij dalej dla mnie!\r</language>
	</row>
	<row id="msg_0723_00543" index="543">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hiya.\nMiło cię poznać.</language>
	</row>
	<row id="msg_0723_00544" index="544">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku.\nMiło cię widzieć.\r</language>
	</row>
	<row id="msg_0723_00545" index="545">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku.\nDzięki, że przyszedłeś.\r</language>
	</row>
	<row id="msg_0723_00546" index="546">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moi koledzy nazywają\nmnie imperatorem wędkowania!</language>
	</row>
	<row id="msg_0723_00547" index="547">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złowiłem kolejną wielką\nrybę dzisiaj!\r</language>
	</row>
	<row id="msg_0723_00548" index="548">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu imperator\nwędkowania? To starożytna\nchińska legenda...\r</language>
	</row>
	<row id="msg_0723_00549" index="549">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy staniesz się tak\ndobry jak ja, możesz łatwo\nwygrywać, nawet śpiąc.</language>
	</row>
	<row id="msg_0723_00550" index="550">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzz... Zzz...\r</language>
	</row>
	<row id="msg_0723_00551" index="551">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sssnore...\r</language>
	</row>
	<row id="msg_0723_00552" index="552">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja mama i ja\npodróżujemy, szukając\nzaginionych skarbów.</language>
	</row>
	<row id="msg_0723_00553" index="553">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Resztę czasu łowimy\nryby i pielęgnujemy uprawy\nkażdego dnia.\r</language>
	</row>
	<row id="msg_0723_00554" index="554">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z pewnością wydajesz się\nzajęty.\r</language>
	</row>
	<row id="msg_0723_00555" index="555">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrana! To jest to, co\nzrobię dziś znowu! Wygram też\njutro!</language>
	</row>
	<row id="msg_0723_00556" index="556">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nahaha! Nahaha!\nNie przegram przez całe moje\nżycie!\r</language>
	</row>
	<row id="msg_0723_00557" index="557">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nooooo! Nie ma szans!\nNie przegrałem!\r</language>
	</row>
	<row id="msg_0723_00558" index="558">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozwól mi zbadać twoje\numiejętności jako kolekcjonera.</language>
	</row>
	<row id="msg_0723_00559" index="559">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeszcze ci brakuje.\nZachęcam, żebyś nad tym dalej\npracował.\r</language>
	</row>
	<row id="msg_0723_00560" index="560">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To całkiem niezła\nkolekcja. Jestem skłonny\nodciążyć cię od całości.\r</language>
	</row>
	<row id="msg_0723_00561" index="561">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tam! Tam! I tam!</language>
	</row>
	<row id="msg_0723_00562" index="562">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak jest!\r</language>
	</row>
	<row id="msg_0723_00563" index="563">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Owowowoooh!\r</language>
	</row>
	<row id="msg_0723_00564" index="564">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcę, żebyś to usłyszał!\nKrzyk z głębi serca!</language>
	</row>
	<row id="msg_0723_00565" index="565">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham muzykę!\r</language>
	</row>
	<row id="msg_0723_00566" index="566">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zażądajmy bisu!\r</language>
	</row>
	<row id="msg_0723_00567" index="567">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka?\nJestem gotów na to.</language>
	</row>
	<row id="msg_0723_00568" index="568">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow.\nNiezła sprawa.\r</language>
	</row>
	<row id="msg_0723_00569" index="569">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki wielkie.\r</language>
	</row>
	<row id="msg_0723_00570" index="570">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwoom!</language>
	</row>
	<row id="msg_0723_00571" index="571">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepot! Trzepot!\r</language>
	</row>
	<row id="msg_0723_00572" index="572">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyrwę ci piórka za to!\r</language>
	</row>
	<row id="msg_0723_00573" index="573">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasne, zmierzmy się!</language>
	</row>
	<row id="msg_0723_00574" index="574">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczmy znowu!\r</language>
	</row>
	<row id="msg_0723_00575" index="575">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jesteś taki zły!\r</language>
	</row>
	<row id="msg_0723_00576" index="576">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Patrzenie na łamiące\nsię fale morza... To przywraca\nwspomnienia.</language>
	</row>
	<row id="msg_0723_00577" index="577">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wroaaaaaar!\nTatusiu!\r</language>
	</row>
	<row id="msg_0723_00578" index="578">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wroaaaar!\nMamusiu!\r</language>
	</row>
	<row id="msg_0723_00579" index="579">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj! Zaatakuj mnie!\nMogę to znieść!</language>
	</row>
	<row id="msg_0723_00580" index="580">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, co myślisz? Byłem\nza masywny, żeby sobie z nim\nporadzić?\r</language>
	</row>
	<row id="msg_0723_00581" index="581">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobra robota!\nTak trzymać, by pokonać mój\nrozmiar!\r</language>
	</row>
	<row id="msg_0723_00582" index="582">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waah! Czekaj! Czekaj\nsekundę! Mój umysł jeszcze nie\njest w to nastawiony!</language>
	</row>
	<row id="msg_0723_00583" index="583">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hunh? Już koniec?\nCo? Wygrałem, mówisz?\r</language>
	</row>
	<row id="msg_0723_00584" index="584">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? Hah? Już koniec?\nCo? Przegrałem, mówisz?\r</language>
	</row>
	<row id="msg_0723_00585" index="585">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój ulubiony napój to\nMleko Moomoo. Masz coś?</language>
	</row>
	<row id="msg_0723_00586" index="586">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wahaha! Dostaję\nwygraną! Świętujmy przy\nMleku Moomoo!\r</language>
	</row>
	<row id="msg_0723_00587" index="587">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gwaah! Mleko Moomoo!\nPrzynieś mi trochę Mleka\nMoomoo!\r</language>
	</row>
	<row id="msg_0723_00588" index="588">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś aresztowany!\nJesteś aresztowany!</language>
	</row>
	<row id="msg_0723_00589" index="589">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obalenie!\r</language>
	</row>
	<row id="msg_0723_00590" index="590">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Funkcjonariusz powalony!\r</language>
	</row>
	<row id="msg_0723_00591" index="591">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jestem prawdziwym\nPolicjantem. Jestem\nkolekcjonerem mundurów.</language>
	</row>
	<row id="msg_0723_00592" index="592">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyglądasz, jakby mundur\nby ci pasował. Powinieneś\nspróbować znaleźć taki, który\nci się podoba.\r</language>
	</row>
	<row id="msg_0723_00593" index="593">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę powiedzieć, że\nwalczenie jest wspaniałą\nrzeczą.\r</language>
	</row>
	<row id="msg_0723_00594" index="594">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kto wie, co stanie się\njutro?</language>
	</row>
	<row id="msg_0723_00595" index="595">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz przegrać jednego\ndnia, a wygrać następnego.\nTak to się dzieje.\r</language>
	</row>
	<row id="msg_0723_00596" index="596">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę wygrać jutro. To,\nw co wierzę.\r</language>
	</row>
	<row id="msg_0723_00597" index="597">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wkładam w ten mecz\nwszystko, co mam!</language>
	</row>
	<row id="msg_0723_00598" index="598">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak! Jahoo!\r</language>
	</row>
	<row id="msg_0723_00599" index="599">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To koniec!\r</language>
	</row>
	<row id="msg_0723_00600" index="600">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niezłomny Biwakowicz\nstaje na posterunku!</language>
	</row>
	<row id="msg_0723_00601" index="601">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz stać się moim\nwyznawcą, jeśli chcesz.\r</language>
	</row>
	<row id="msg_0723_00602" index="602">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałbym, żebym mógł\nstać się twoim wyznawcą.\r</language>
	</row>
	<row id="msg_0723_00603" index="603">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie myślę, że mam\njakiekolwiek szanse na\nwygraną, ale jasne, zawalczę.</language>
	</row>
	<row id="msg_0723_00604" index="604">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, nie oczekiwałem,\nże wygram.\r</language>
	</row>
	<row id="msg_0723_00605" index="605">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiedziałem, że przegram.\nTak mi przykro z tego powodu.\r</language>
	</row>
	<row id="msg_0723_00606" index="606">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że jesteś strasznie\nzainteresowany mną, prawda?</language>
	</row>
	<row id="msg_0723_00607" index="607">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałeś, bo\nzwracałeś na mnie za dużo\nuwagi.\r</language>
	</row>
	<row id="msg_0723_00608" index="608">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu wygrałeś?\nMyślałem, że mnie lubisz.\r</language>
	</row>
	<row id="msg_0723_00609" index="609">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrana czy przegrana,\nnie żywmy żadnych pretensji.</language>
	</row>
	<row id="msg_0723_00610" index="610">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jej, jej, jej!\nZrobiliśmy to!\r</language>
	</row>
	<row id="msg_0723_00611" index="611">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, ty!\nNigdy o tym nie zapomnij!\r</language>
	</row>
	<row id="msg_0723_00612" index="612">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony są też dla\ndorosłych... Pozwól, że ci\npokażę...</language>
	</row>
	<row id="msg_0723_00613" index="613">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co myślisz?\nCzy jestem głęboki jak\nstary bluesman?\r</language>
	</row>
	<row id="msg_0723_00614" index="614">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć tnie mnie to\ngłęboko, to los mężczyzny, by\nznosić ten ból...\r</language>
	</row>
	<row id="msg_0723_00615" index="615">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To, co tu mam, to\nnaprawdę nie gitara.</language>
	</row>
	<row id="msg_0723_00616" index="616">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Beep, boop, bzzt...\r</language>
	</row>
	<row id="msg_0723_00617" index="617">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To tu jest syntezator\nklawiszowy.\r</language>
	</row>
	<row id="msg_0723_00618" index="618">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W pracy czasem mogę\nbyć Pływaczką albo Pięknotką.</language>
	</row>
	<row id="msg_0723_00619" index="619">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Idolka może stać się\nkimkolwiek!\r</language>
	</row>
	<row id="msg_0723_00620" index="620">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ale prawdziwa ja...\nWciąż jestem Panienką w\nminispódnicy!\r</language>
	</row>
	<row id="msg_0723_00621" index="621">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bawmy się dobrze.\nNienawidzę wszystkiego, co\nma związek z bólem!</language>
	</row>
	<row id="msg_0723_00622" index="622">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh! To było zabawne!\r</language>
	</row>
	<row id="msg_0723_00623" index="623">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jowch! Uważaj!\nGrasz zbyt szorstko!\r</language>
	</row>
	<row id="msg_0723_00624" index="624">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skończę z tym!\nZ moim ulubionym Pokémonem!</language>
	</row>
	<row id="msg_0723_00625" index="625">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miłość, jaką mam do\nmojego Pokémona, jest\nkompletna i absolutnie silna...\r</language>
	</row>
	<row id="msg_0723_00626" index="626">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu? Czemu?!\nCzemu przegrałem?!\r</language>
	</row>
	<row id="msg_0723_00627" index="627">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Życie z Pokémonami...\nKażdy dzień jest najlepszy.</language>
	</row>
	<row id="msg_0723_00628" index="628">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ehehe...\nPokémony są najlepsze...\r</language>
	</row>
	<row id="msg_0723_00629" index="629">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To nie problem, jeśli\nprzegram. Wciąż mam moje\nPokémony...\r</language>
	</row>
	<row id="msg_0723_00630" index="630">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam moje Pokémony.\nNie potrzebuję niczego innego.</language>
	</row>
	<row id="msg_0723_00631" index="631">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z moimi Pokémonami,\nmogę być szczęśliwa każdego\ndnia.\r</language>
	</row>
	<row id="msg_0723_00632" index="632">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy to nie to samo dla\nciebie? Czy nie?\r</language>
	</row>
	<row id="msg_0723_00633" index="633">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie zgadniesz teraz, ale\nbyłam całkiem imprezową\ndziewczyną w swoim czasie.</language>
	</row>
	<row id="msg_0723_00634" index="634">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, wciąż to mam,\nwiesz.\r</language>
	</row>
	<row id="msg_0723_00635" index="635">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję nostalgię za\ntymi dniami...\r</language>
	</row>
	<row id="msg_0723_00636" index="636">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dajcie z siebie\nwszystko! Moje ukochane dzieci!</language>
	</row>
	<row id="msg_0723_00637" index="637">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wahaha! Dobra robota!\nMama jest z was dumna!\r</language>
	</row>
	<row id="msg_0723_00638" index="638">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje Pokémony są moją\nukochaną rodziną.\r</language>
	</row>
	<row id="msg_0723_00639" index="639">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mały chłopiec? Mała\ndziewczynka? Nie ma znaczenia\nktóry. Zrobimy to!</language>
	</row>
	<row id="msg_0723_00640" index="640">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mały chłopiec? Mała\ndziewczynka? Nie ma znaczenia\nktóry, ale przepraszam.\r</language>
	</row>
	<row id="msg_0723_00641" index="641">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mały chłopiec? Mała\ndziewczynka? Nie ma znaczenia\nktóry, ale jesteś naprawdę\ntwardy!\r</language>
	</row>
	<row id="msg_0723_00642" index="642">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja jazda kończy się\ntutaj.</language>
	</row>
	<row id="msg_0723_00643" index="643">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówiłem ci, że to koniec.\r</language>
	</row>
	<row id="msg_0723_00644" index="644">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To za dużo, bym mógł\nto znieść!\r</language>
	</row>
	<row id="msg_0723_00645" index="645">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Idziemy po wygraną!\nHej-ho, dawaj!</language>
	</row>
	<row id="msg_0723_00646" index="646">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jej! Vavavoom!\r</language>
	</row>
	<row id="msg_0723_00647" index="647">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, przegraliśmy...\nPociąganie nosem...\r</language>
	</row>
	<row id="msg_0723_00648" index="648">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozwól, że przedstawię\nci moich cenionych\npartnerów!</language>
	</row>
	<row id="msg_0723_00649" index="649">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak je znalazłeś? Moi\ncenieni partnerzy.\r</language>
	</row>
	<row id="msg_0723_00650" index="650">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Awawa...\nMoi partnerzy...\r</language>
	</row>
	<row id="msg_0723_00651" index="651">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrywanie i\nprzegrywanie nie jest\nwszystkim w walczeniu.</language>
	</row>
	<row id="msg_0723_00652" index="652">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, jasne, czyni mnie\nszczęśliwą, gdy wygrywam.\r</language>
	</row>
	<row id="msg_0723_00653" index="653">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wysiłek, jaki wkładasz,\nto to, co jest ważne.\r</language>
	</row>
	<row id="msg_0723_00654" index="654">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jest dobrze być\nzbyt surowym... Ale\nrozpieszczanie też jest\nwykluczone...</language>
	</row>
	<row id="msg_0723_00655" index="655">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bycie Pokémon Breederem\nto głębokie i skomplikowane\nwyzwanie.\r</language>
	</row>
	<row id="msg_0723_00656" index="656">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Balans jest kluczem do\nwychowywania dobrych\nPokémonów.\r</language>
	</row>
	<row id="msg_0723_00657" index="657">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprawdzę, jak twoje\nPokémony się rozwinęły dla\nciebie.</language>
	</row>
	<row id="msg_0723_00658" index="658">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niewystarczająco dobre!\nTwój styl treningu nie jest\nna poziomie.\r</language>
	</row>
	<row id="msg_0723_00659" index="659">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest imponujące! Dokładnie\nwychowałeś swoje Pokémony.\r</language>
	</row>
	<row id="msg_0723_00660" index="660">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygram.\nNie żartuję.</language>
	</row>
	<row id="msg_0723_00661" index="661">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz?\r</language>
	</row>
	<row id="msg_0723_00662" index="662">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh!\r</language>
	</row>
	<row id="msg_0723_00663" index="663">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwaah! Fwaah!\nMyślisz, że możesz mnie\npokonać?</language>
	</row>
	<row id="msg_0723_00664" index="664">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwaah! Fwaah!\nWygrywam!\r</language>
	</row>
	<row id="msg_0723_00665" index="665">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwaah!\r</language>
	</row>
	<row id="msg_0723_00666" index="666">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złapałem cię teraz.\nPoddaj się.</language>
	</row>
	<row id="msg_0723_00667" index="667">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie byłeś zły.\nSpotkamy się znowu.\r</language>
	</row>
	<row id="msg_0723_00668" index="668">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak to możliwe...?\r</language>
	</row>
	<row id="msg_0723_00669" index="669">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo, yo!\nMiejmy dobry czas!</language>
	</row>
	<row id="msg_0723_00670" index="670">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję!\nZagrajmy znowu!\r</language>
	</row>
	<row id="msg_0723_00671" index="671">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki!\nZagraj ze mną znowu!\r</language>
	</row>
	<row id="msg_0723_00672" index="672">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wcale nie jesteś\ndobry. Lepiej cię nauczę.</language>
	</row>
	<row id="msg_0723_00673" index="673">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie, nie, to w ogóle\nnie wystarczy. Na nogi.\nNigdy się nie poddawaj!\r</language>
	</row>
	<row id="msg_0723_00674" index="674">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz dobre\numiejętności. Też się\nstarałeś. Doskonale!\r</language>
	</row>
	<row id="msg_0723_00675" index="675">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwiększam moc do maksimum!\nAż do jedenastki!</language>
	</row>
	<row id="msg_0723_00676" index="676">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, tak! Czuję się\nelektryczny!\r</language>
	</row>
	<row id="msg_0723_00677" index="677">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eeyow! Zostałem porażony!\r</language>
	</row>
	<row id="msg_0723_00678" index="678">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, dawaj!</language>
	</row>
	<row id="msg_0723_00679" index="679">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hah! Za słaby!\nSpróbuj dalej!\r</language>
	</row>
	<row id="msg_0723_00680" index="680">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoh! Jesteś twardy!\nDaj mi rewanż!\r</language>
	</row>
	<row id="msg_0723_00681" index="681">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz być ze mną\nserio!</language>
	</row>
	<row id="msg_0723_00682" index="682">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och? To wszystko?\r</language>
	</row>
	<row id="msg_0723_00683" index="683">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK...\nCałkiem niezwykłe...\r</language>
	</row>
	<row id="msg_0723_00684" index="684">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ahaha! Szkoda dla\nciebie! Jestem twoim\nprzeciwnikiem!</language>
	</row>
	<row id="msg_0723_00685" index="685">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ahaha!\r</language>
	</row>
	<row id="msg_0723_00686" index="686">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aha...\nAhaha...\r</language>
	</row>
	<row id="msg_0723_00687" index="687">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś nerwowy?\nZostaw to facetowi!</language>
	</row>
	<row id="msg_0723_00688" index="688">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To była dobra walka.\nNadzieja, że możemy się\nznowu spotkać.\r</language>
	</row>
	<row id="msg_0723_00689" index="689">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uff...\nTen facet nie oczekiwał\nprzegranej.\r</language>
	</row>
	<row id="msg_0723_00690" index="690">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moc natury!\nPozwól, że ci pokażę!</language>
	</row>
	<row id="msg_0723_00691" index="691">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest moc natury!\r</language>
	</row>
	<row id="msg_0723_00692" index="692">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chroń naturalne\nśrodowisko...</language>
	</row>
	<row id="msg_0723_00693" index="693">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka ze mną? Nie wiem,\no czym mówisz.</language>
	</row>
	<row id="msg_0723_00694" index="694">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz?\nMyślałem, że to się\nstanie.\r</language>
	</row>
	<row id="msg_0723_00695" index="695">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Boo! Boo!\nTo nie jest w porządku!\r</language>
	</row>
	<row id="msg_0723_00696" index="696">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fuhahaha!\nTwoim następnym wyzwaniem\njestem ja!</language>
	</row>
	<row id="msg_0723_00697" index="697">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fuhahaha! Naprawdę\nwierzyłeś, że mnie pokonasz?\r</language>
	</row>
	<row id="msg_0723_00698" index="698">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fuhahaha!\nSpotkajmy się znowu!\r</language>
	</row>
	<row id="msg_0723_00699" index="699">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Idź! Stań przed moją\ndrużyną całkowicie\nwytrenowanych Pokémonów!</language>
	</row>
	<row id="msg_0723_00700" index="700">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brawo!\nWiedziałem, że moje\nPokémony to zrobią!\r</language>
	</row>
	<row id="msg_0723_00701" index="701">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie! To straszne!\nCo zrobiłeś mojemu Pokémonowi?!\r</language>
	</row>
	<row id="msg_0723_00702" index="702">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka to śmiertelnie\nserio sprawa! Ani jednej\nchwili nieuwagi!</language>
	</row>
	<row id="msg_0723_00703" index="703">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie spuszczaj\ngardy!\r</language>
	</row>
	<row id="msg_0723_00704" index="704">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydaje się, że dałem\nmoim myślom pobłądzić...\r</language>
	</row>
	<row id="msg_0723_00705" index="705">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej!</language>
	</row>
	<row id="msg_0723_00706" index="706">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heeej!\r</language>
	</row>
	<row id="msg_0723_00707" index="707">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej...\r</language>
	</row>
	<row id="msg_0723_00708" index="708">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem twardy, to\nwszystko.</language>
	</row>
	<row id="msg_0723_00709" index="709">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrałem, to wszystko.\r</language>
	</row>
	<row id="msg_0723_00710" index="710">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałem, to wszystko.\r</language>
	</row>
	<row id="msg_0723_00711" index="711">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shaah!</language>
	</row>
	<row id="msg_0723_00712" index="712">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hwooh!\r</language>
	</row>
	<row id="msg_0723_00713" index="713">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hawah!\r</language>
	</row>
	<row id="msg_0723_00714" index="714">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłem tu lata, ale\nnigdy nie znudzi mnie to.</language>
	</row>
	<row id="msg_0723_00715" index="715">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może nie myślisz, że\ntak, ale wciąż jestem\ndzieciakiem. Jestem w tej samej\nklasie co ty.\r</language>
	</row>
	<row id="msg_0723_00716" index="716">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałbym wciąż walczyć\nPokémonami, nawet gdy moje\nwłosy posiwieją.\r</language>
	</row>
	<row id="msg_0723_00717" index="717">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozwól mi coś wyjaśnić...\nNie jesteś zdolny mnie pokonać.</language>
	</row>
	<row id="msg_0723_00718" index="718">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy nie mówiłem? Nie\nma żadnej szansy, że mnie\npokonasz.\r</language>
	</row>
	<row id="msg_0723_00719" index="719">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak to możliwe...? Tylko\nta dziewczyna z dętką mnie\npokonała...\r</language>
	</row>
	<row id="msg_0723_00720" index="720">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, mój, zwykłe dziecko.</language>
	</row>
	<row id="msg_0723_00721" index="721">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzieci w dzisiejszych\nczasach...\nSą tak nieuważne.\r</language>
	</row>
	<row id="msg_0723_00722" index="722">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzieci w dzisiejszych\nczasach...\nCałkiem żywiołowe, myślę.\r</language>
	</row>
	<row id="msg_0723_00723" index="723">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałbym, by moje\ndzieci stały się silnymi i\nwyróżniającymi się trenerami.</language>
	</row>
	<row id="msg_0723_00724" index="724">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie byłoby dobrze, gdyby\nmoje dzieci były tylko tak\ndobre jak ty...\r</language>
	</row>
	<row id="msg_0723_00725" index="725">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłoby miło, gdyby były\ntak wprawne jak ty...\r</language>
	</row>
	<row id="msg_0723_00726" index="726">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zobaczysz!\nMoc mistycznie-psychiczna!</language>
	</row>
	<row id="msg_0723_00727" index="727">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz?\nMoc mistycznie-psychiczna!\r</language>
	</row>
	<row id="msg_0723_00728" index="728">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie, ale...\nMoc mistycznie-psychiczna...\r</language>
	</row>
	<row id="msg_0723_00729" index="729">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja rodzina pokaże ci\ndobry czas!</language>
	</row>
	<row id="msg_0723_00730" index="730">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaczekaj, moja rodzino!\nWystarczy już tego!\r</language>
	</row>
	<row id="msg_0723_00731" index="731">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja ukochana rodzina...\r</language>
	</row>
	<row id="msg_0723_00732" index="732">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiruj, wiruj, wiruj...</language>
	</row>
	<row id="msg_0723_00733" index="733">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czujesz zawroty głowy?\r</language>
	</row>
	<row id="msg_0723_00734" index="734">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooorgh...\nMoja głowa wiruje...\r</language>
	</row>
	<row id="msg_0723_00735" index="735">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój starszy brat mi\npowiedział! Oczy! Celuj w\noczy!</language>
	</row>
	<row id="msg_0723_00736" index="736">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jej! Zrobiłem to!\nPlan mojego starszego brata\nzadziałał!</language>
	</row>
	<row id="msg_0723_00737" index="737">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój starszy brat\npowiedział mi, by obniżyć\ncelność wroga!</language>
	</row>
	<row id="msg_0723_00738" index="738">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoy! Wyglądasz całkiem\ntwardo. To będzie zabawne!</language>
	</row>
	<row id="msg_0723_00739" index="739">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak myślałem!\nJesteś twardy!\r</language>
	</row>
	<row id="msg_0723_00740" index="740">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jup, z pewnością\njesteś twardy. Tak dalej!\r</language>
	</row>
	<row id="msg_0723_00741" index="741">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, witaj!\nJestem twoim kelnerem\ndziś!</language>
	</row>
	<row id="msg_0723_00742" index="742">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy chciałbyś rozliczyć\nswój rachunek?\r</language>
	</row>
	<row id="msg_0723_00743" index="743">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję bardzo!\r</language>
	</row>
	<row id="msg_0723_00744" index="744">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witaj.\nCo zamawiasz?</language>
	</row>
	<row id="msg_0723_00745" index="745">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję bardzo!\r</language>
	</row>
	<row id="msg_0723_00746" index="746">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Do zobaczenia!\r</language>
	</row>
	<row id="msg_0723_00747" index="747">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham uroczych\nklientów jak ty! Obsłużę cię\nwłaściwie!</language>
	</row>
	<row id="msg_0723_00748" index="748">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, byłeś zadowolony\nz tego, jak cię obsłużyłem?\r</language>
	</row>
	<row id="msg_0723_00749" index="749">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, ale...\nNie skończyłem cię\nobsługiwać.\r</language>
	</row>
	<row id="msg_0723_00750" index="750">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wpatruję się...</language>
	</row>
	<row id="msg_0723_00751" index="751">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz coś na nosie.\r</language>
	</row>
	<row id="msg_0723_00752" index="752">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś cool, w porządku.\nMusiałem się wpatrywać.\r</language>
	</row>
	<row id="msg_0723_00753" index="753">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekałem długo na\ntrenera jak ty, by się pojawił.</language>
	</row>
	<row id="msg_0723_00754" index="754">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jup, jesteś tak twardy,\njak myślałem. Nawet\nnastręczyłeś mi problemów!\r</language>
	</row>
	<row id="msg_0723_00755" index="755">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiedziałem to!\nJesteś twardym trenerem!\r</language>
	</row>
	<row id="msg_0723_00756" index="756">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A teraz, jak powinienem\nprzeprowadzić tę ofensywę?</language>
	</row>
	<row id="msg_0723_00757" index="757">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, teraz, potrzebuję\nlepszego wysiłku od ciebie niż\nto.\r</language>
	</row>
	<row id="msg_0723_00758" index="758">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, skończyłeś i\njesteś usatysfakcjonowany? OK,\ninnym razem, wtedy.\r</language>
	</row>
	<row id="msg_0723_00759" index="759">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje Pokémony mają\nróżny gust od zwykłej gromady.</language>
	</row>
	<row id="msg_0723_00760" index="760">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zauważyłeś różnicę?\nMoja drużyna ma bogatą\ngłębię.\r</language>
	</row>
	<row id="msg_0723_00761" index="761">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zauważyłeś różnicę?\nMoja drużyna jest odświeżająco\nwytrawna.\r</language>
	</row>
	<row id="msg_0723_00762" index="762">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hiya!\nTwardo wyglądający trener,\nnie sądzisz!</language>
	</row>
	<row id="msg_0723_00763" index="763">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To uczucie euforii\nbąbluje we mnie!\r</language>
	</row>
	<row id="msg_0723_00764" index="764">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooch...\nJesteś za dużo, bym mógł\nto znieść.\r</language>
	</row>
	<row id="msg_0723_00765" index="765">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Varrroooom!\nZobacz, jak jadę na pełnym\ngazie!</language>
	</row>
	<row id="msg_0723_00766" index="766">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vavavaroooom!\nNawet się nie zbliżam do\ngranicy obrotów!\r</language>
	</row>
	<row id="msg_0723_00767" index="767">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Vrrr... Vrruuu...\nZabrakło mi zupełnie gazu...\r</language>
	</row>
	<row id="msg_0723_00768" index="768">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzyń, dzyń!</language>
	</row>
	<row id="msg_0723_00769" index="769">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skreeeech!\r</language>
	</row>
	<row id="msg_0723_00770" index="770">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Łubu!\r</language>
	</row>
	<row id="msg_0723_00771" index="771">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To mój sen, by jeździć\nrowerem z moim chłopakiem.</language>
	</row>
	<row id="msg_0723_00772" index="772">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ale żadnej jazdy w\ndwójkę!\r</language>
	</row>
	<row id="msg_0723_00773" index="773">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałabym, żebym miała\nchłopaka!\r</language>
	</row>
	<row id="msg_0723_00774" index="774">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jaki jest twój motyw?\nCo cię tu przywiodło?</language>
	</row>
	<row id="msg_0723_00775" index="775">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrywasz.\nCo teraz zrobisz?\r</language>
	</row>
	<row id="msg_0723_00776" index="776">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zagraj to znowu.\r</language>
	</row>
	<row id="msg_0723_00777" index="777">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zachowamy ten mecz\nwytrawny.</language>
	</row>
	<row id="msg_0723_00778" index="778">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podziwiam twoją\ntechnikę.\r</language>
	</row>
	<row id="msg_0723_00779" index="779">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wciąż jestem\nupokorzony...\r</language>
	</row>
	<row id="msg_0723_00780" index="780">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś serio? Walka?\nI to przeciwko mnie?</language>
	</row>
	<row id="msg_0723_00781" index="781">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chichot!\nNie powinieneś był próbować!\r</language>
	</row>
	<row id="msg_0723_00782" index="782">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podwójne wow!\r</language>
	</row>
	<row id="msg_0723_00783" index="783">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zatańczę, zaśpiewam i\nprzykuję twoją uwagę!</language>
	</row>
	<row id="msg_0723_00784" index="784">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, baby!\r</language>
	</row>
	<row id="msg_0723_00785" index="785">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tyle z przykuwania\ntwojej uwagi. Pokonałeś moje\nPokémony!\r</language>
	</row>
	<row id="msg_0723_00786" index="786">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gotowi, start!</language>
	</row>
	<row id="msg_0723_00787" index="787">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwszy przez linię\nfinisza!\r</language>
	</row>
	<row id="msg_0723_00788" index="788">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waah! Czekaj na mnie!\r</language>
	</row>
	<row id="msg_0723_00789" index="789">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz wyjaśnić, czemu\njestem tutaj?</language>
	</row>
	<row id="msg_0723_00790" index="790">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chodzi mi o to, kim\njesteś?\r</language>
	</row>
	<row id="msg_0723_00791" index="791">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu walczę tutaj?\r</language>
	</row>
	<row id="msg_0723_00792" index="792">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja technika obsługi\nwędki jest najlepsza w całym\nSinnoh. Zobacz to!</language>
	</row>
	<row id="msg_0723_00793" index="793">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz to?\nZaskoczony, obstawiam!\r</language>
	</row>
	<row id="msg_0723_00794" index="794">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak obsługuję wędkę,\nnie ma nic do czynienia z\nwalczeniem...\r</language>
	</row>
	<row id="msg_0723_00795" index="795">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dwie miłości mojego\nżycia to wędkowanie i\nwalczenie.</language>
	</row>
	<row id="msg_0723_00796" index="796">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję się fantastycznie,\ngdy złowię wielką rybę albo\nwygram wielką walkę.\r</language>
	</row>
	<row id="msg_0723_00797" index="797">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urodziłem się, by łowić\nryby i walczyć!\r</language>
	</row>
	<row id="msg_0723_00798" index="798">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przybyłem tu na\nstatku. Wielki statek to był.</language>
	</row>
	<row id="msg_0723_00799" index="799">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sinnoh, podoba mi się.\nBardzo miłe miejsce.\r</language>
	</row>
	<row id="msg_0723_00800" index="800">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz iść na morze?\nMój statek, zobaczymy\nwspaniałe rzeczy.\r</language>
	</row>
	<row id="msg_0723_00801" index="801">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? Jesteś moim\nprzeciwnikiem? To jest\nniepokojące...</language>
	</row>
	<row id="msg_0723_00802" index="802">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem zaskoczony...\nNie myślałem, że wygram.\r</language>
	</row>
	<row id="msg_0723_00803" index="803">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz, mówiłem ci...\nMyślałem, że jesteś twardy.\r</language>
	</row>
	<row id="msg_0723_00804" index="804">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahah! Witaj!</language>
	</row>
	<row id="msg_0723_00805" index="805">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahah! Dalej tak!\r</language>
	</row>
	<row id="msg_0723_00806" index="806">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki za twój czas!\r</language>
	</row>
	<row id="msg_0723_00807" index="807">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bądźmy dobrymi\nsportowcami w tej kwestii!\nWielki uśmiech!</language>
	</row>
	<row id="msg_0723_00808" index="808">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ahaha! Ahaha!\nDawaj, ty też się śmiej!\r</language>
	</row>
	<row id="msg_0723_00809" index="809">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem pogodny nawet\nw porażce! Ahaha! Ahaha!\r</language>
	</row>
	<row id="msg_0723_00810" index="810">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nabierz odwagi.</language>
	</row>
	<row id="msg_0723_00811" index="811">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie zły.\r</language>
	</row>
	<row id="msg_0723_00812" index="812">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś dobry.\r</language>
	</row>
	<row id="msg_0723_00813" index="813">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najlepsza rzecz w\nwalczeniu? Kończące uderzenie!</language>
	</row>
	<row id="msg_0723_00814" index="814">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz to!\nTo mój finałowy ruch!\r</language>
	</row>
	<row id="msg_0723_00815" index="815">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oof...\nCzuję twoje ostatnie\nstrzały...\r</language>
	</row>
	<row id="msg_0723_00816" index="816">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, wyglądasz\nszykownie!</language>
	</row>
	<row id="msg_0723_00817" index="817">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, starałeś się,\nprawda?\r</language>
	</row>
	<row id="msg_0723_00818" index="818">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, jesteś całkiem\ntwardy.\r</language>
	</row>
	<row id="msg_0723_00819" index="819">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słuchaj! To jest moja\ngrupa chórowa. Ja i mój\nPokémon!</language>
	</row>
	<row id="msg_0723_00820" index="820">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Shooby-dooby doowop!\r</language>
	</row>
	<row id="msg_0723_00821" index="821">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, czekaj!\nJeszcze nie skończyliśmy\nśpiewać!\r</language>
	</row>
	<row id="msg_0723_00822" index="822">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dostałem wskazówki od\nmoich internetowych przyjaciół\no tym, jak najlepiej wychować\nmoją grupę.</language>
	</row>
	<row id="msg_0723_00823" index="823">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę podziękować moim\ninternetowym przyjaciołom.\nNie wiem, kim są, jednak.\r</language>
	</row>
	<row id="msg_0723_00824" index="824">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, to porażka!\nMoi internetowi kumple mnie\nzawiedli!\r</language>
	</row>
	<row id="msg_0723_00825" index="825">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę mieć moment?\nPróbuję napisać trochę\nemaili.</language>
	</row>
	<row id="msg_0723_00826" index="826">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę szybko wrócić do\ndomu i sprawdzić moje emaile.\r</language>
	</row>
	<row id="msg_0723_00827" index="827">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co myślisz, że robisz?\nJuż chcę iść.\r</language>
	</row>
	<row id="msg_0723_00828" index="828">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojcze... Matko...\nProszę, patrzcie nade mną...</language>
	</row>
	<row id="msg_0723_00829" index="829">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojcze... Matko...\nPatrzyliście...?\r</language>
	</row>
	<row id="msg_0723_00830" index="830">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ojcze... Matko...\nProszę, wybaczcie mi...\r</language>
	</row>
	<row id="msg_0723_00831" index="831">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę szczerze\npowiedzieć, że bardzo lubię\nwalczenie, mówię ci.</language>
	</row>
	<row id="msg_0723_00832" index="832">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrałem, ale...\nWciąż się trzęsę...\r</language>
	</row>
	<row id="msg_0723_00833" index="833">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grr...\nJestem tak zły, że mógłbym\npłakać...\r</language>
	</row>
	<row id="msg_0723_00834" index="834">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To moc nauki!</language>
	</row>
	<row id="msg_0723_00835" index="835">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widziałeś? Byłeś\nzdumiony? To jest moc nauki!\r</language>
	</row>
	<row id="msg_0723_00836" index="836">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To niewyobrażalne... Jak\nmoc nauki mogła zostać\npokonana?\r</language>
	</row>
	<row id="msg_0723_00837" index="837">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szarżuj, mój Pokémonie!\nZademonstruj owoce naszego\neksperymentowania!</language>
	</row>
	<row id="msg_0723_00838" index="838">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, mój Pokémon\ndowiódł mojej teorii! Zdobędę\nteraz mój profesorski tytuł!\r</language>
	</row>
	<row id="msg_0723_00839" index="839">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jakiego rodzaju\neksperymenty? To\ntajne.</language>
	</row>
	<row id="msg_0723_00840" index="840">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powrócę do mojego\ndzieciństwa na tę walkę.</language>
	</row>
	<row id="msg_0723_00841" index="841">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gugu gaga.\r</language>
	</row>
	<row id="msg_0723_00842" index="842">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gaga...\r</language>
	</row>
	<row id="msg_0723_00843" index="843">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwahahaha!\nZaszedłeś daleko!</language>
	</row>
	<row id="msg_0723_00844" index="844">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwahahahaha!\r</language>
	</row>
	<row id="msg_0723_00845" index="845">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwahahaha!\nJesteś błogosławiony, mając\nswoich przyjaciół!\r</language>
	</row>
	<row id="msg_0723_00846" index="846">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zezłomuję cię.</language>
	</row>
	<row id="msg_0723_00847" index="847">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrecykluję cię.\r</language>
	</row>
	<row id="msg_0723_00848" index="848">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myśl ekologicznie. Myśl\nzielono.\r</language>
	</row>
	<row id="msg_0723_00849" index="849">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu, jasne! Brzmi\nświetnie! Musimy to zrobić!</language>
	</row>
	<row id="msg_0723_00850" index="850">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bam! Wszystko zrobione!\r</language>
	</row>
	<row id="msg_0723_00851" index="851">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka podczas pracy...\nTo dobry sposób, by zrobić\nprzerwę.\r</language>
	</row>
	<row id="msg_0723_00852" index="852">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Postaram się dać z\nsiebie wszystko! Proszę, dajcie\nmi tę szansę!</language>
	</row>
	<row id="msg_0723_00853" index="853">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrobiłem to!\nOsiągnąłem mój cel!\r</language>
	</row>
	<row id="msg_0723_00854" index="854">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starałem się jak\nnajlepiej! Dziękuję za wasze\nwsparcie!\r</language>
	</row>
	<row id="msg_0723_00855" index="855">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka to... To list\nmiłosny napisany na piasku.</language>
	</row>
	<row id="msg_0723_00856" index="856">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrozumiałeś, co próbuję\npowiedzieć? Zgaduję, że nie.\r</language>
	</row>
	<row id="msg_0723_00857" index="857">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrozumiałeś, co próbuję\npowiedzieć? Zgaduję, że nie.\r</language>
	</row>
	<row id="msg_0723_00858" index="858">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Halo, ty tam! Tak, ty!\nZaczekaj. Zaczekaj, mówię!</language>
	</row>
	<row id="msg_0723_00859" index="859">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, dzieci nie powinny\nbyć teraz na zewnątrz. Idź do\ndomu, i bądź szybki w tym.\r</language>
	</row>
	<row id="msg_0723_00860" index="860">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie powinieneś\nzadzierać z policjantem jak ten.\r</language>
	</row>
	<row id="msg_0723_00861" index="861">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sssnork... Zzz...</language>
	</row>
	<row id="msg_0723_00862" index="862">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CLEFAIRY... Mamrotanie...\nCzekaj na mnie... Sssnork...\r</language>
	</row>
	<row id="msg_0723_00863" index="863">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mruczenie...\nEhehe... Ssssnore...\r</language>
	</row>
	<row id="msg_0723_00864" index="864">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zachowajmy to elegancko!</language>
	</row>
	<row id="msg_0723_00865" index="865">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mmm, tak!\r</language>
	</row>
	<row id="msg_0723_00866" index="866">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś całkiem\ntrenerem sam!\r</language>
	</row>
	<row id="msg_0723_00867" index="867">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka to nie coś, co\nmożesz obliczyć.</language>
	</row>
	<row id="msg_0723_00868" index="868">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co ci mówiłem?\nWygrywasz, gdy wygrywasz.\r</language>
	</row>
	<row id="msg_0723_00869" index="869">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co mówiłem, huh?\nPrzegrywasz, gdy przegrywasz.\r</language>
	</row>
	<row id="msg_0723_00870" index="870">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest wiele w życiu,\nco nie idzie, jak chcesz.</language>
	</row>
	<row id="msg_0723_00871" index="871">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jippie!\nRzeczy poszły po mojemu!\r</language>
	</row>
	<row id="msg_0723_00872" index="872">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz...?\r</language>
	</row>
	<row id="msg_0723_00873" index="873">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma dokąd uciekać\nani się skryć!</language>
	</row>
	<row id="msg_0723_00874" index="874">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To był z góry\nprzesądzony wniosek!\r</language>
	</row>
	<row id="msg_0723_00875" index="875">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pożegnanie!\r</language>
	</row>
	<row id="msg_0723_00876" index="876">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekam tu na twardych\ntrenerów, niezależnie od\npogody.</language>
	</row>
	<row id="msg_0723_00877" index="877">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z tego powodu stałem\nsię tak bardzo silny...\r</language>
	</row>
	<row id="msg_0723_00878" index="878">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy nie twardy... Nie,\nzapomnij o tym. Potrzebuję\ncool trenera, by się zjawił...\r</language>
	</row>
	<row id="msg_0723_00879" index="879">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest do ochrony\nprzed słońcem.</language>
	</row>
	<row id="msg_0723_00880" index="880">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem silny w\nwalczeniu, ale nie mogę\nznieść światła słonecznego...\r</language>
	</row>
	<row id="msg_0723_00881" index="881">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcę przypiec sobie\nskóry.\r</language>
	</row>
	<row id="msg_0723_00882" index="882">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż...\nTo są rzadkie Pokémony...</language>
	</row>
	<row id="msg_0723_00883" index="883">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie złapałem\ntakich... Twoje Pokémony są\nróżne, w porządku.\r</language>
	</row>
	<row id="msg_0723_00884" index="884">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, jesteś trenerem?\nNie jesteś Pokémonem?\r</language>
	</row>
	<row id="msg_0723_00885" index="885">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gotowy?</language>
	</row>
	<row id="msg_0723_00886" index="886">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cool.\r</language>
	</row>
	<row id="msg_0723_00887" index="887">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pa.\r</language>
	</row>
	<row id="msg_0723_00888" index="888">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pobić mnie?\nSpróbuj znowu za kolejnych\ndziesięć lat!</language>
	</row>
	<row id="msg_0723_00889" index="889">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żadnego charakteru!\r</language>
	</row>
	<row id="msg_0723_00890" index="890">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś twardy!\nInspirujesz mnie!\r</language>
	</row>
	<row id="msg_0723_00891" index="891">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapach słodkich aromatów\nsprawia, że jestem tak\nśpiąca...</language>
	</row>
	<row id="msg_0723_00892" index="892">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Ziewnięcie...\nOch? Już skończyliśmy\ntak szybko?\r</language>
	</row>
	<row id="msg_0723_00893" index="893">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Ziewnięcie...\nOch, serio? Przegrałam?\r</language>
	</row>
	<row id="msg_0723_00894" index="894">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś pewny, że możesz\nmnie znieść? Jestem\nultragwiezdnym talentem.</language>
	</row>
	<row id="msg_0723_00895" index="895">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie czuj się źle!\nJestem ultragwiezdnym\ntalentem!\r</language>
	</row>
	<row id="msg_0723_00896" index="896">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś w klasie\ncud-gwiazda!\r</language>
	</row>
	<row id="msg_0723_00897" index="897">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyję tylko dla walk.\nTylko zwycięstwa dają mi\nnadzieję.</language>
	</row>
	<row id="msg_0723_00898" index="898">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Naturalnie.\r</language>
	</row>
	<row id="msg_0723_00899" index="899">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kim jesteś...?\r</language>
	</row>
