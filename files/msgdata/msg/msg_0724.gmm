<?xml version="1.0"?>
<body language="English">
	<row id="msg_0724_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No to jedziemy!</language>
	</row>
	<row id="msg_0724_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrobiliśmy to, tak!\r</language>
	</row>
	<row id="msg_0724_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wujek!\r</language>
	</row>
	<row id="msg_0724_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje Pokémony są o\ncałe cięcie lepsze od zwykłych.\nMoże nawet o dwa cięcia!</language>
	</row>
	<row id="msg_0724_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ich intensywność ciosów\ni solidny atak... Najwyższa\nklasa, co nie?\r</language>
	</row>
	<row id="msg_0724_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grr...\nUczyniono mnie bezbronnym...\r</language>
	</row>
	<row id="msg_0724_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Książę wśród Młodzików\nnoszących szorty, to ja!</language>
	</row>
	<row id="msg_0724_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadzieja, że żyłem na\nmiarę mojego tytułu księcia\nwśród noszących szorty.\r</language>
	</row>
	<row id="msg_0724_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę tu przegrać!\nNie jako książę wśród\nnoszących szorty!\r</language>
	</row>
	<row id="msg_0724_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę znieść tego\nnapięcia. Byliby wściekli,\njeśli pójdę do domu?</language>
	</row>
	<row id="msg_0724_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrobiłem to!\nWygrałem jakoś!\r</language>
	</row>
	<row id="msg_0724_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To przeszło moją\ngranicę! Muszę się wymówić!\r</language>
	</row>
	<row id="msg_0724_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jestem w tym bardzo\ndobry, ale proszę, nie\npowstrzymuj się.</language>
	</row>
	<row id="msg_0724_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie mówiłem?\nNie powinieneś był się\npowstrzymywać.\r</language>
	</row>
	<row id="msg_0724_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fweh! Chciałbym, żebyś\ntrochę się powstrzymał!\r</language>
	</row>
	<row id="msg_0724_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W romansie, modzie i\nPokémonach! Dzisiejsze\ndziewczyny chcą wszystkiego!</language>
	</row>
	<row id="msg_0724_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciwość dzisiejszych\ndziewczyn nie ma granic!\r</language>
	</row>
	<row id="msg_0724_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy bycie chciwą\nskończyło się kosztując mnie\nwszystko?\r</language>
	</row>
	<row id="msg_0724_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zastanawiam się usilnie,\nczemu wszyscy tak kochają\nwalczenie.</language>
	</row>
	<row id="msg_0724_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu wygranie walki\nczyni ludzi szczęśliwymi?\r</language>
	</row>
	<row id="msg_0724_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu przegranie walki\njest tak absolutnie\nwkurzające?\r</language>
	</row>
	<row id="msg_0724_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Próbuję nadążyć z\ntreningiem mojego Pokémona i\nmoją własną szkołą.</language>
	</row>
	<row id="msg_0724_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałbym myśleć, że\nznalazłem odpowiedni balans\nzabawy i edukacji.\r</language>
	</row>
	<row id="msg_0724_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To nie zadziała?\nMoje oceny są najlepsze w\nklasie, ale...\r</language>
	</row>
	<row id="msg_0724_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wkuwałem na to ciężko.\nNie mogę po prostu zawieść!</language>
	</row>
	<row id="msg_0724_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak! Dostaję wygraną!\nTak się cieszę, że\ntrzymałem się tego!\r</language>
	</row>
	<row id="msg_0724_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To znaczy, że muszę\nuczyć się w domu jeszcze\ntrochę.\r</language>
	</row>
	<row id="msg_0724_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje Pokémony są moimi\nskarbami. Pokażę ci je.\nTylko tobie.</language>
	</row>
	<row id="msg_0724_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? Uroczy i\nsilny! Eheheheh.\r</language>
	</row>
	<row id="msg_0724_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz? Są urocze\nnawet gdy przegrywają.\nEheheheh.\r</language>
	</row>
	<row id="msg_0724_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie przegram!\nProszę, zastosuj się do mojej\nreguły!</language>
	</row>
	<row id="msg_0724_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję bardzo!\nZawdzięczam tę wygraną tobie!\r</language>
	</row>
	<row id="msg_0724_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak bardzo nie chciałam\nprzegrać...\r</language>
	</row>
	<row id="msg_0724_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę to zrobić...\nMogę zabłysnąć też tutaj!</language>
	</row>
	<row id="msg_0724_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak! Wygrałam!\nStanę się gwiazdą!\r</language>
	</row>
	<row id="msg_0724_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pewnego dnia będę\nzabłyśnie jako najjaśniejsza\ngwiazda na świecie!\r</language>
	</row>
	<row id="msg_0724_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie bądź nieśmiały.\nMożesz dać z siebie wszystko,\njak chcesz.</language>
	</row>
	<row id="msg_0724_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, wiedziałem, że\nbędziesz taki. Heh.\r</language>
	</row>
	<row id="msg_0724_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W-więc, czasem muszę\nprzegrać, po prostu żebym nie\nzdeptał wszystkich. Ahaha...\r</language>
	</row>
	<row id="msg_0724_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój ojciec jest\nbogaty. Nie ma nic, na co\nnie może sobie pozwolić.</language>
	</row>
	<row id="msg_0724_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pieniądze mojego ojca\nkupiły mojego Pokémona.\r</language>
	</row>
	<row id="msg_0724_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Są rzeczy, których\npieniądze nie mogą kupić. Wiem\nto...\r</language>
	</row>
	<row id="msg_0724_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, może zaczniemy?\nCzas to pieniądz, a licznik\ndziała.</language>
	</row>
	<row id="msg_0724_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, odejdę. Jeszcze\njedna wystawna randka na\nkolacji, wiesz. Adieu!\r</language>
	</row>
	<row id="msg_0724_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To moja przegrana, tak?\nTak więc niech będzie.\nMusiałem iść na randkę i tak.\r</language>
	</row>
	<row id="msg_0724_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przestrzegaj zasad\netykiety i uprzejmości... To\nwłaśnie robi dama.</language>
	</row>
	<row id="msg_0724_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdybym nie mogła się\nrozładować w ten sposób,\nstraciłabym moją damską\nkompozycję.\r</language>
	</row>
	<row id="msg_0724_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałabym być wolna\njak ptasie Pokémony na\nniebie...\r</language>
	</row>
	<row id="msg_0724_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdybym była Miodem,\nto ty byłbyś Śliskim Mułem,\nmyślę.</language>
	</row>
	<row id="msg_0724_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz teraz? Jak\nróżni jesteśmy w poziomie i\nklasie?\r</language>
	</row>
	<row id="msg_0724_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak śmiesz!\nNigdy nie zapomnę tego\nupokorzenia!\r</language>
	</row>
	<row id="msg_0724_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Impreza, zakupy,\nkolacja... Kochany, znudziłam\nsię tym wszystkim.</language>
	</row>
	<row id="msg_0724_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ekscytacji w moim\nżyciu jest tak mało. Co\nsprawi, że moje serce\nzapompuje?\r</language>
	</row>
	<row id="msg_0724_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tylko walczenie wyrywa\nmnie z tej bezczynnej\negzystencji nudy i apatii...\r</language>
	</row>
	<row id="msg_0724_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem zadowolony, że\nmogę cię poznać! Niech ta\nprzyjaźń będzie owocna!</language>
	</row>
	<row id="msg_0724_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję bardzo!\nDziękuję bardzo serdecznie!\r</language>
	</row>
	<row id="msg_0724_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję bardzo...\n...Pah.\r</language>
	</row>
	<row id="msg_0724_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najbardziej naturalnym\ntrenerem jest...\nOch, czemu to skrywać? Nikt\ninny jak ja!</language>
	</row>
	<row id="msg_0724_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest naturalny\nwynik. Był nieunikniony!\r</language>
	</row>
	<row id="msg_0724_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczyłem naturalnie,\ni skończyłem z porażką.\r</language>
	</row>
	<row id="msg_0724_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak! Nie dorosły!\nSzczęściarz ja! Mam szansę!</language>
	</row>
	<row id="msg_0724_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jup, walczenie z innym\ndzieciakiem jest dużo mniej\nstraszne.\r</language>
	</row>
	<row id="msg_0724_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Robię się naprawdę\nnerwowy przed dorosłymi.\r</language>
	</row>
	<row id="msg_0724_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trudno utrzymać passę\nprzy życiu, ale walki są\nzabawne.</language>
	</row>
	<row id="msg_0724_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zabawniej jest\nwygrywać, oczywiście!\r</language>
	</row>
	<row id="msg_0724_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet przegrywanie jest\nzabawne. To cud Pokémonów!\r</language>
	</row>
	<row id="msg_0724_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój tatuś jest\nprawdziwym góralem. Czy to\nczyni moją mamę góralką?</language>
	</row>
	<row id="msg_0724_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Góralka brzmi\nobrzydliwie. Nie dla mnie,\ndzięki!\r</language>
	</row>
	<row id="msg_0724_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem ich córką. Czy\nbycie góralką to moje\nprzeznaczenie?\r</language>
	</row>
	<row id="msg_0724_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam gotowy pakowany\nlunch, i oczywiście mam\ntrochę przekąsek.</language>
	</row>
	<row id="msg_0724_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje ulubione Pokémony\nsprawiają, że wygrywanie jest\ntak łatwe!\r</language>
	</row>
	<row id="msg_0724_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie, nie!\nZapomniałam zabrać mojego\nulubionego Pokémona!\r</language>
	</row>
	<row id="msg_0724_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Baraszkuję z moimi\nwodnymi Pokémonami w basenie\nciągle.</language>
	</row>
	<row id="msg_0724_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To naprawdę czyni mnie\nszczęśliwym wygrywanie z moimi\nulubionymi Pokémonami.\r</language>
	</row>
	<row id="msg_0724_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kochałabym pływać w\nbasenie pełnym wodnych\nPokémonów.\r</language>
	</row>
	<row id="msg_0724_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obiecałam mamusi, że\nbędę ćwiczyć pływanie, jeśli\nprzegram.</language>
	</row>
	<row id="msg_0724_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jej! Nie będę musiała\niść na basen z mamusią\ndzisiaj!\r</language>
	</row>
	<row id="msg_0724_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, przegrałam. Teraz\nbędę musiała iść na trening\npływania dzisiaj.\r</language>
	</row>
	<row id="msg_0724_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poszedłem i złapałem\nmojego Pokémona z moim\ntatusiem.</language>
	</row>
	<row id="msg_0724_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrałem, Tatusiu!\nTatusiu, dziękuję!\r</language>
	</row>
	<row id="msg_0724_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zastanawiam się, czy\ntatuś pokaże mi, jak trenować\nmojego Pokémona następnie?\r</language>
	</row>
	<row id="msg_0724_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem w drodze do\ndomu z basenu, ale OK, mogę\nwalczyć.</language>
	</row>
	<row id="msg_0724_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadzieja, że wkrótce\nmogę iść do domu. Potrzebuję\nsuchych ubrań!\r</language>
	</row>
	<row id="msg_0724_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah-ah-aptsik! Aww...\nAptsik! Przegraliśmy...\r</language>
	</row>
	<row id="msg_0724_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem kapitanem\nheroicznego statku pośród\nłamiących się fal burzy!</language>
	</row>
	<row id="msg_0724_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dotarłem do brzegu z\nłatwością prawdziwego\nawanturnika morza!\r</language>
	</row>
	<row id="msg_0724_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To był większy upadek,\nniż chciałem!\r</language>
	</row>
	<row id="msg_0724_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Właśnie wróciłem z\nwakacji.</language>
	</row>
	<row id="msg_0724_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plaża jest dobrym\nmiejscem, by się popisać.\r</language>
	</row>
	<row id="msg_0724_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, moje poparzenie\nsłoneczne swędzi.\r</language>
	</row>
	<row id="msg_0724_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hunh? Walka, to to?\nJasne, jasne.</language>
	</row>
	<row id="msg_0724_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, jesteś czymś\nspecjalnym, huh?\r</language>
	</row>
	<row id="msg_0724_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, dzięki za twój\nczas.\r</language>
	</row>
	<row id="msg_0724_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest dla wszystkich\ndam. Dziewczyny, śpiewam i\nwalczę dla was!</language>
	</row>
	<row id="msg_0724_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje damy, moje\ndziewczyny, wygrałem dla was.\nWasza miłość to moja moc,\nprawda?\r</language>
	</row>
	<row id="msg_0724_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałem, ale moja\nmiłość do dziewczyn nie może\nzostać pokonana...może.\r</language>
	</row>
	<row id="msg_0724_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To nie jest gitara,\nktórą tu mam. To tradycyjny i\njapoński instrument.</language>
	</row>
	<row id="msg_0724_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma tylko trzy struny.\nMożesz powiedzieć, co to jest?\r</language>
	</row>
	<row id="msg_0724_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój instrument nazywa\nsię shamisen.\r</language>
	</row>
	<row id="msg_0724_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My, nastoletnie Idolki,\nmamy tajny kodeks postępowania,\nktóry jest ściśle wymuszany.</language>
	</row>
	<row id="msg_0724_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na przykład, jeśli\nIdolka wygra, musi piszczeć i\nskakać wokół.\r</language>
	</row>
	<row id="msg_0724_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli Idolka przegra,\nnigdy nie może zachowywać się\nźle. To wielkie nie-nie.\r</language>
	</row>
	<row id="msg_0724_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrób potworny Meteor\nMash! To moje hasło!</language>
	</row>
	<row id="msg_0724_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój Meteor Mash idzie\nprosto do twojego serca!\r</language>
	</row>
	<row id="msg_0724_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystkie Idolki\npotrzebują hasła, zwłaszcza\nzaraz po debiucie.\r</language>
	</row>
	<row id="msg_0724_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś tak bardzo\nszczęśliwy, by mieć szansę\nzawalczyć ze mną.</language>
	</row>
	<row id="msg_0724_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś super\nszczęśliwy, że w ogóle walczysz\nz Idolką jak ja. Nie rozumiesz\ntego?\r</language>
	</row>
	<row id="msg_0724_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Huh? Huh? No, czemu\nwygrałeś? Wiesz, że ja mam\nwygrywać!\r</language>
	</row>
	<row id="msg_0724_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Krink... Krak...\nHeheheh. Pozwól mi się\nrozgrzać do tego.</language>
	</row>
	<row id="msg_0724_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hah!\nSłabe, nawet jako żart!\r</language>
	</row>
	<row id="msg_0724_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gnnrrr...\nMogę winić tylko siebie...\r</language>
	</row>
	<row id="msg_0724_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy nie są piękne?\nUrocze? To moje ukochane\nPokémony.</language>
	</row>
	<row id="msg_0724_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pracowałeś tak ciężko!\nDam ci miły masaż w domu.\r</language>
	</row>
	<row id="msg_0724_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co robisz moim\nPokémonom?! Co jeśli je\nzranisz?!\r</language>
	</row>
	<row id="msg_0724_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Staję przed tobą jako\nczłonek Fan Clubu Pokémon!\nEn garde!</language>
	</row>
	<row id="msg_0724_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niech żyje Fan Club\nPokémon! Niech będzie zawsze\nwspaniały!\r</language>
	</row>
	<row id="msg_0724_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To zaledwie\nposmakowanie tego, co może\nznieść Fan Club Pokémon...\r</language>
	</row>
	<row id="msg_0724_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kierowniczka Departamentu\nFan Clubu... Przyjmuję twoje\nwyzwanie.</language>
	</row>
	<row id="msg_0724_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heheh... Szczerze,\nmyślałeś, że masz szansę\nprzeciwko Fan Clubowi?\r</language>
	</row>
	<row id="msg_0724_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gwah! Zostanę\nzemszczona... Pr-przez\nKierowniczkę Departamentu...\r</language>
	</row>
	<row id="msg_0724_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wychowywanie Pokémonów\nz miłością nie jest tym samym\nco ich rozpieszczanie. Nie\nwidzisz tego?</language>
	</row>
	<row id="msg_0724_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, zrobiłaś to! Och,\nkocham cię tak! Mój kochany,\nsłodki Pokémonie!\r</language>
	</row>
	<row id="msg_0724_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak mogłeś?!\nCo jeśli moje Pokémony są\nranne?!\r</language>
	</row>
	<row id="msg_0724_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W imieniu mojej wioski,\npodejmuję to wyzwanie!</language>
	</row>
	<row id="msg_0724_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję, wszyscy!\nDziękuję za wasze głosowe\nwsparcie!\r</language>
	</row>
	<row id="msg_0724_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Koledzy wioskowi,\nprzepraszam! Moje najlepsze\nnie było wystarczające!\r</language>
	</row>
	<row id="msg_0724_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję za twoją\ncierpliwość. Tu jest walka,\nktórą zamówiłeś.</language>
	</row>
	<row id="msg_0724_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzę, że byłeś\nusatysfakcjonowany? Czuję się\ntrochę oszukany.\r</language>
	</row>
	<row id="msg_0724_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzę, że byłeś\nusatysfakcjonowany? Mam swoje\ndość.\r</language>
	</row>
	<row id="msg_0724_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Praca jest zabawna, i\nPokémony też. Jestem\nszczęśliwy, że przybyłem do\ntego kraju.</language>
	</row>
	<row id="msg_0724_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam zabawę ja! Mam\nnadzieję żyć tu na zawsze.\r</language>
	</row>
	<row id="msg_0724_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, czemu mnie\npokonałeś? Tak niemiło! Chcę\niść do domu do mojego kraju.\r</language>
	</row>
	<row id="msg_0724_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem cool, prawda?\nWięc, gdziekolwiek pracuję,\nrobią mnie maitre d’em...</language>
	</row>
	<row id="msg_0724_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem też dobrym\nwalczącym. Nie mogę pomóc\ntemu, że damy padają dla\nmnie.\r</language>
	</row>
	<row id="msg_0724_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śnię o ewolucji z\nmaitre d’a do celebryty\nszefa kuchni.\r</language>
	</row>
	<row id="msg_0724_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma darmowych ofert\nna walkę. Dostaniesz pełen\nkurs, jednak.</language>
	</row>
	<row id="msg_0724_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdzie jest zabawa, jeśli\nnie walczysz tak, jakbyś to\nmyślał?\r</language>
	</row>
	<row id="msg_0724_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Traktuję pracę i\nzabawę poważnie. To rozpala\nmoją pasję!\r</language>
	</row>
	<row id="msg_0724_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi, czy mogę\nzainteresować cię zestawem\nobiadowym?\n...Jestem tak przyzwyczajona\nmówić to w pracy!</language>
	</row>
	<row id="msg_0724_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję, i miłego\ndnia! ...Co ja mówię?\r</language>
	</row>
	<row id="msg_0724_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekamy na twoją\nkolejną wizytę! ...O czym\nmyślę?\r</language>
	</row>
	<row id="msg_0724_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja drużyna wygląda\nimponująco. Czy będę w\nporządku...?</language>
	</row>
	<row id="msg_0724_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, co?\nCzy te Pokémony są tylko do\nKonkursów?\r</language>
	</row>
	<row id="msg_0724_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ał! Powiedziałem ał!\nTo było za dużo! Dużo, dużo\nza dużo!\r</language>
	</row>
	<row id="msg_0724_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham Pokémony typu\nBug! Kocham moją siatkę na\nowady jeszcze bardziej!</language>
	</row>
	<row id="msg_0724_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złapałem mojego Pokémona,\nużywając mojej wiernej\nsiatki na owady.\r</language>
	</row>
	<row id="msg_0724_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłoby cool, gdyby\nistniał Pokémon-siatka na\nowady.\r</language>
	</row>
	<row id="msg_0724_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Owady są moimi\nsługusami, a ja jestem szefem.\nCzy jesteś przygotowany na\nprzegraną?</language>
	</row>
	<row id="msg_0724_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wahaha!\nDobra robota, moi słudzy!\r</language>
	</row>
	<row id="msg_0724_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zostaliśmy pokoszeni...\nMoi słudzy nauczyli się tego\nciężko!\r</language>
	</row>
	<row id="msg_0724_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyłamuję się ze swojej\nskorupy! Przechodzę na\nnastępny poziom!</language>
	</row>
	<row id="msg_0724_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jak gdybym\nwyrosnął w skrzydła! Niech\nżyje nowy ja!\r</language>
	</row>
	<row id="msg_0724_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy jeszcze nie mój\nczas? Muszę pozostać w mojej\nskorupie dłużej?\r</language>
	</row>
	<row id="msg_0724_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty przestępco!\nStań nieruchomo, mówię!</language>
	</row>
	<row id="msg_0724_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zmusiłem się do\nzwycięstwa!\r</language>
	</row>
	<row id="msg_0724_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">P-przekleństwa...\nPrzyniosłem nam niesławę...\r</language>
	</row>
	<row id="msg_0724_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, hej, co jest tam?\nTo jest... To jest legendarny\nPokémon!</language>
	</row>
	<row id="msg_0724_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kekeke... Dezorientacja\nninjutsu! Zadziałała\nperfekcyjnie!\r</language>
	</row>
	<row id="msg_0724_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dezorientacja ninjutsu\nzawiodła! Zniknę w obłoku\ndymu!\r</language>
	</row>
	<row id="msg_0724_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zostaniesz\nzdezorientowany moją\noślepiającą szybkością!</language>
	</row>
	<row id="msg_0724_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje ruchy...\nTo jakbyś poruszał się w\nmelasie.\r</language>
	</row>
	<row id="msg_0724_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie musiałem robić\ncałego tego biegania, prawda?\r</language>
	</row>
	<row id="msg_0724_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Noszę te ubrania od\ndłuższego czasu. Kąpanie się\njest dla ptaków!</language>
	</row>
	<row id="msg_0724_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zmiana ubrań zajmuje\nzbyt dużo wysiłku. Kąpanie się\njest jeszcze gorsze!\r</language>
	</row>
	<row id="msg_0724_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie, nie, nie!\nNie wezmę kąpieli!\r</language>
	</row>
	<row id="msg_0724_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lubię moją mamusię,\nPIKACHU, i mojego tatusia też.</language>
	</row>
	<row id="msg_0724_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słaby trener nie jest\ncool. Nie lubię cię.\r</language>
	</row>
	<row id="msg_0724_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie-słabeuszowaty\ntrener jest cool. Lubię cię.\r</language>
	</row>
	<row id="msg_0724_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikapika pikaah!\nPikka! Pikachuuuh!</language>
	</row>
	<row id="msg_0724_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piika pikapikka!\nPikka pikkachuuh!\r</language>
	</row>
	<row id="msg_0724_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pikka ppi pi piii...\r</language>
	</row>
	<row id="msg_0724_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy wkraczam do walki,\nwyobrażam sobie rozległe\nmorze w umyśle.</language>
	</row>
	<row id="msg_0724_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy mogę wyobrazić\nsobie morze, czuję, że nigdy\nnie mógłbym przegrać.\r</language>
	</row>
	<row id="msg_0724_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy wyobrażam sobie\nmorze, nie czuję ukłucia\nporażki.\r</language>
	</row>
	<row id="msg_0724_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W walce i w miłości,\ntrzeba wiedzieć, kiedy\nnajlepiej się wycofać.</language>
	</row>
	<row id="msg_0724_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W końcu, i walka, i\nromans mogą stać się bagnami\nrozpaczy.\r</language>
	</row>
	<row id="msg_0724_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może przegrałem, ale\npowiedziałem coś głębokiego,\nw sposób niekończącego się\nbagna.\r</language>
	</row>
	<row id="msg_0724_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Boję się, że zostałem\nprzeklęty podczas naszej\nostatniej eksploracji\nstarożytnych ruin. Ehehe.</language>
	</row>
	<row id="msg_0724_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet teraz nie mam\npojęcia, jak wygrałem.\nHeeheehee.\r</language>
	</row>
	<row id="msg_0724_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może jestem przeklęty,\nale to zabawne. To wszystko\njest tak dobre. Heeheehee.\r</language>
	</row>
	<row id="msg_0724_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widok budynków i miast\nz dawnych wieków sprawia, że\nmój puls przyspiesza.</language>
	</row>
	<row id="msg_0724_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ludzie zainteresowani\nstarą architekturą to\npotencjalni Łowcy Ruin.</language>
	</row>
	<row id="msg_0724_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Otwórz oczy w\nmiastach. Będą ekscytujące nowe\nodkrycia. Mówię to serio.</language>
	</row>
	<row id="msg_0724_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złożyłem tę drużynę z\nmoimi internetowymi kumplami.\nZajęło nam to cały dzień!</language>
	</row>
	<row id="msg_0724_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygraliśmy! Muszę\npodziękować moim internetowym\nkumplom za ich radę!\r</language>
	</row>
	<row id="msg_0724_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, a niech to!\nPrzegraliśmy?! Zgłoszę to moim\ninternetowym kumplom!\r</language>
	</row>
	<row id="msg_0724_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem głównym\nbohaterem tej historii. To\nniemożliwe, bym przegrał.</language>
	</row>
	<row id="msg_0724_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś dobry! Jednak,\njako postać drugiego planu,\njesteś trochę za silny.\r</language>
	</row>
	<row id="msg_0724_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Bohater musi trochę\nwycierpieć, by publiczność\nczuła więcej empatii.\r</language>
	</row>
	<row id="msg_0724_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem bardzo\nniestały. Nie mogę trzymać się\njednej rzeczy zbyt długo.</language>
	</row>
	<row id="msg_0724_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrałem, i to mi\nwystarczy. Sprawdzę Wi-Fi\nPlaza.\r</language>
	</row>
	<row id="msg_0724_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałem, więc to\nwystarczy. Pójdę do Safari\nZone.\r</language>
	</row>
	<row id="msg_0724_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam dużo więcej\ndoświadczenia niż ty. Co z\ntym zrobisz?</language>
	</row>
	<row id="msg_0724_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie zły, ale musisz\njeszcze dorosnąć.\r</language>
	</row>
	<row id="msg_0724_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samo doświadczenie nie\nzapewnia żadnych wygranych,\nuczę się.\r</language>
	</row>
	<row id="msg_0724_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie myślisz, że walki\nPokémon są jak pogoda?</language>
	</row>
	<row id="msg_0724_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrywanie sprawia, że\nczuję się ciepły i radosny\njak słoneczny dzień.\r</language>
	</row>
	<row id="msg_0724_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrywanie sprawia,\nże czuję się smutny jak\npochmurny, szary dzień.\r</language>
	</row>
	<row id="msg_0724_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłem na imprezie całą\nnoc znowu. Czuję zawroty\ngłowy od grania w gry!</language>
	</row>
	<row id="msg_0724_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem tak znudzony\nwystawnymi imprezami i\ngłupimi grami, też.\r</language>
	</row>
	<row id="msg_0724_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urp...!\r</language>
	</row>
	<row id="msg_0724_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, czy nie jesteś\nnajmilszą rzeczą! Możesz\nwygrać uśmiech od mnie?</language>
	</row>
	<row id="msg_0724_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, słodziaku, ja\nwygrywam, więc żadnego\nuśmiechu! Pamiętaj, by wygrać\nnastępny raz!\r</language>
	</row>
	<row id="msg_0724_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie czuję się na\nuśmiech teraz...ale z\nradością pomacham na\npożegnanie!\r</language>
	</row>
	<row id="msg_0724_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Och, poczekaj\nsekundę. Muszę odebrać ten\ntelefon.</language>
	</row>
	<row id="msg_0724_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, jup... Tak,\nwalczę... Uh-huh... Jup,\nwygrałem... Cóż, duh... LOL...\r</language>
	</row>
	<row id="msg_0724_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, jup... Tak,\nwłaśnie walczyłem... Nope...\nDzieciak mnie pobił... Uh-huh...\r</language>
	</row>
	<row id="msg_0724_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pociąganie! Hnurrff!\nFuczek! Ten katar sienny to\nzłośliwa niedola...</language>
	</row>
	<row id="msg_0724_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hnurrff! Pociąganie!\nPociąganie! Pociąganie! Wygrałem,\nale niedola trwa!\r</language>
	</row>
	<row id="msg_0724_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pociąganie. Pociąganie.\nFuczek. Nie płaczę. Mam\nkatar.\r</language>
	</row>
	<row id="msg_0724_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój wyczulony węch mówi\nmi, jak twardy jest trener.</language>
	</row>
	<row id="msg_0724_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spróbuj dalej. Mój\nnos mówi mi, że masz wielki\npotencjał.\r</language>
	</row>
	<row id="msg_0724_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pociąganie, pociąganie...\nFuczek! Mój nos mówi mi,\nże ciężko pracowałeś!\r</language>
	</row>
	<row id="msg_0724_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kyahaha! Wyczuwam\npotężną walkę w przygotowaniu!</language>
	</row>
	<row id="msg_0724_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słodki zapach sukcesu!\r</language>
	</row>
	<row id="msg_0724_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porażka pachnie jak\nSKUNTANK!\r</language>
	</row>
	<row id="msg_0724_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lubię twardy, szybki\nrytm w walczeniu i moim\nrock’n’rollu! Zawódźmy!</language>
	</row>
	<row id="msg_0724_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I, bam! Ten wzór\nrytmiczny rządził, jeśli mogę\ntak powiedzieć!\r</language>
	</row>
	<row id="msg_0724_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ał! To jest zniewaga\ndla uszu! Te rytmy były\nofensywne, stary!\r</language>
	</row>
	<row id="msg_0724_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By pokazać ci, jak dużo\nto dla mnie znaczy, użyję\nefektów dźwiękowych od teraz.</language>
	</row>
	<row id="msg_0724_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Raaaah! Dun dun! Dun\ndun! Oompa-oompa-oompapa!\r</language>
	</row>
	<row id="msg_0724_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blip-bip, blip-bip...\nBlip... Bweeee...\r</language>
	</row>
	<row id="msg_0724_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekaj, proszę, czekaj...\nWiatry... Słyszę je...</language>
	</row>
	<row id="msg_0724_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę je słyszeć...\nWiatry się śmieją...\r</language>
	</row>
	<row id="msg_0724_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę je słyszeć...\nWiatry... Są we łzach...\r</language>
	</row>
	<row id="msg_0724_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę latać...\nAle te maleństwa mogą\nszybować...</language>
	</row>
	<row id="msg_0724_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój duch został\nwzniesiony do nieba... Dziękuję,\nwszyscy...\r</language>
	</row>
	<row id="msg_0724_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Złamałeś moje\nskrzydła... Nigdy cię nie\nzapomnę...\r</language>
	</row>
	<row id="msg_0724_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Każdego dnia jestem\njak ptak migrujący, ale\nlecę we wszystkich kardynalnych\nkierunkach.</language>
	</row>
	<row id="msg_0724_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdobyłem doświadczenie,\npodróżując do wszelkiego\nrodzaju miejsc.\r</language>
	</row>
	<row id="msg_0724_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałbym żyć\ngdzieś, gdzie mogę znaleźć\nwięcej trenerów jak ty.\r</language>
	</row>
	<row id="msg_0724_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urodziłem się na\ntoczących się falach, które\nmyły mnie, z plażą jako moją\nkołyską.</language>
	</row>
	<row id="msg_0724_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urodziłem się i\nwyrosłem na morzach. To\nsprawiło, że jestem tym\nwielkim człowiekiem.\r</language>
	</row>
	<row id="msg_0724_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałem, tak? Czas,\nby pójść do morza i\nniezbadanie na nie patrzeć.</language>
	</row>
	<row id="msg_0724_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Młodzież dnia\ndzisiejszego mierzy w cały\nświat! Jakie to głębokie!</language>
	</row>
	<row id="msg_0724_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byliby jacyś mocno\ncool trenerzy na całym\nświecie. Jestem tego pewien.\r</language>
	</row>
	<row id="msg_0724_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj, dzieciaku!\nWeź na siebie cały świat!\nBędę czekać na twój powrót!\r</language>
	</row>
	<row id="msg_0724_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co to jest? Pachnę\nzapylony? Nie znasz aromatu\ngleby?</language>
	</row>
	<row id="msg_0724_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz, to właśnie\ndostajesz! Twoja drużyna\nmusiała zjeść ziemię, rozumiesz?\r</language>
	</row>
	<row id="msg_0724_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Upadłem w ziemi przez\njakiegoś dzieciaka, który nie\nznał zapachu gleby!\r</language>
	</row>
	<row id="msg_0724_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam, że\nwyglądam tak niechlujnie i\nbrudno. Byłem zamknięty w\ngórach.</language>
	</row>
	<row id="msg_0724_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie byłem naprawdę\nzamknięty, przynajmniej nie\ncelowo. Byłem tam zagubiony.\r</language>
	</row>
	<row id="msg_0724_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lepiej być zamknięty\nw górach niż w swoim pokoju,\npowiadam.\r</language>
	</row>
	<row id="msg_0724_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie powinienem być\ntutaj. Możemy to zrobić po\nkryjomu?</language>
	</row>
	<row id="msg_0724_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet walczenie może\nprzyciągać uwagę. Nie jest\nłatwo być gwiazdą popu.\r</language>
	</row>
	<row id="msg_0724_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gwiazdy popu są\nzwykłymi dziewczynami w sercu.\nTeż chcemy cieszyć się naszymi\nPokémonami!\r</language>
	</row>
	<row id="msg_0724_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem celebrytką\nz własnej ręki. Masz z tym\nproblem?</language>
	</row>
	<row id="msg_0724_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celebrytka to\ncelebrytka, nawet jeśli\ntylko w mojej głowie.\r</language>
	</row>
	<row id="msg_0724_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcę być centrum\nuwagi, tylko ja i nikt\ninny.\r</language>
	</row>
	<row id="msg_0724_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaraz czeka mnie\nemerytura... Nigdy nie byłam\npodziwiana jako Idolka.</language>
	</row>
	<row id="msg_0724_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zabłysnę jako\ngwiazda-walcząca Pokémonami!\r</language>
	</row>
	<row id="msg_0724_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałabym zakończyć\nswoją karierę wygraną w tym\nmeczu...\r</language>
	</row>
	<row id="msg_0724_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że trenowanie\nPokémonów ma wiele podobieństw\nz maratonem. Zgadzasz się?</language>
	</row>
	<row id="msg_0724_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest sens w trzymaniu\nsię swojego planu treningowego\nkażdego dnia.\r</language>
	</row>
	<row id="msg_0724_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli nie\nnadasz sobie tempa, nie możesz\nwygrać.\r</language>
	</row>
	<row id="msg_0724_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witajcie! Zachowajmy\nto czyste, sprawiedliwe,\norzeźwiające i przyjemne!</language>
	</row>
	<row id="msg_0724_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uff, czuję się\norzeźwiony! Pokémony są\nnajlepsze!\r</language>
	</row>
	<row id="msg_0724_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh, haha...ha... To\nfaktycznie czuje się trochę\noczyszczająco, być tak\nzmiażdżonym.\r</language>
	</row>
	<row id="msg_0724_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To Robotnicy świata\njak my, którzy trzymają świat\nw ruchu.</language>
	</row>
	<row id="msg_0724_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Są chwile, gdy\nchcielibyśmy odłożyć nasze\nnarzędzia i odpocząć.\r</language>
	</row>
	<row id="msg_0724_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie zapominaj, jak\nRobotnicy jak my pracują dla\nciebie.\r</language>
	</row>
	<row id="msg_0724_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja żona i syn czekają\nna mnie w domu. Nie mogę\npozwolić sobie na przegraną!</language>
	</row>
	<row id="msg_0724_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam, ale\nmusiałem to zrobić. Staniesz\nsię twardszy, mając rodzinę za\nsobą.\r</language>
	</row>
	<row id="msg_0724_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie! Jak teraz\npokażę twarz przed moją\nukochaną żoną i synem?\r</language>
	</row>
	<row id="msg_0724_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony są dla mnie\njak rodzina.\n...Nah, są rodziną.</language>
	</row>
	<row id="msg_0724_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak! Moja rodzino,\nzrobiliście to! Powaliliśmy tego\nniemiłego trenera!\r</language>
	</row>
	<row id="msg_0724_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwaaaah! To okrutne!\nMoja rodzina jest ranna!\r</language>
	</row>
	<row id="msg_0724_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłem zbyt pobłażliwy\nz moim Pokémonem. Wyrosły mi\ncałkowicie egoistyczne.</language>
	</row>
	<row id="msg_0724_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, teraz, wystarczy.\nStop atakowanie! Walka\ndawno się skończyła.\r</language>
	</row>
	<row id="msg_0724_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, teraz, walka się\nskończyła. Żadnego atakowania\ntrenera.\r</language>
	</row>
	<row id="msg_0724_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty, tam. Nie oglądaj\nsię teraz. Skup się na mnie.\nSkoncentruj się.</language>
	</row>
	<row id="msg_0724_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzieciaku, jesteś\nskandalicznie niedoładowany.\nPowinieneś trenować ze mną.\r</language>
	</row>
	<row id="msg_0724_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, tak. Jesteś\nlepszy niż wyglądasz.\nMyliłem się co do ciebie,\ndzieciaku.\r</language>
	</row>
	<row id="msg_0724_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawajcie, moje\nPokémony. Ale nie przemęczajcie\nsię.</language>
	</row>
	<row id="msg_0724_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, wow, lubię, jak\ntwardzi wszyscy byli. Nasze\nPokémony i ty, jup.\r</language>
	</row>
	<row id="msg_0724_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, niezła próba,\nekipa. Dzięki wielkie za\nstaranie.\r</language>
	</row>
	<row id="msg_0724_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sen mojego tatusia...\nZamierzam go urzeczywistnić.</language>
	</row>
	<row id="msg_0724_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tato, widziałeś?\nZrobiliśmy to wszystko dla\nciebie...\r</language>
	</row>
	<row id="msg_0724_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegraliśmy...\nTato, tak mi przykro...\r</language>
	</row>
	<row id="msg_0724_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałbym zrobić\nprzerwę. ...Nie? Musimy zaczynać\nod razu?</language>
	</row>
	<row id="msg_0724_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, widzisz? Powinieneś\nzrobić przerwę ze mną wcześniej.\r</language>
	</row>
	<row id="msg_0724_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, czyż nie jesteś\ntwardy? Powinieneś robić\nprzerwy, jednak.\r</language>
	</row>
	<row id="msg_0724_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, tak, wyglądasz\ndobrze! Potrzebuję teraz\nuśmiechu. Możesz to zrobić?</language>
	</row>
	<row id="msg_0724_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie, nie, nie.\nPotrzebuję od ciebie uśmiechu.\nZobaczmy te zęby błyszczące!\r</language>
	</row>
	<row id="msg_0724_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, to dobry\nuśmiech! Teraz przechyl głowę\nw moją stronę.\r</language>
	</row>
	<row id="msg_0724_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pewnie nie możesz\npowiedzieć, ale widzę aż do\ntwoich porów.</language>
	</row>
	<row id="msg_0724_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, widzę to,\nnaprawdę. Widzę cię jasno.\r</language>
	</row>
	<row id="msg_0724_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbliżyłem się na\ntobie za dużo. Nie mogłem\nzobaczyć twojego Pokémona.\r</language>
	</row>
	<row id="msg_0724_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podczas walki, będę\nciągle szukać najlepszego\nkadru z tobą.</language>
	</row>
	<row id="msg_0724_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tam! I znowu tam!\nDecydujące momenty w czasie!\r</language>
	</row>
	<row id="msg_0724_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdjęcia mnie, gdy\nprzegrywam? Te są usuwane\nnatychmiast.\r</language>
	</row>
	<row id="msg_0724_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyniosę ci relację\nna żywo z mojej nadchodzącej\nwalki!</language>
	</row>
	<row id="msg_0724_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nasza nieustraszona i\npiękna Reporterka zwyciężyła\ndzień! Dawaj, ja!\r</language>
	</row>
	<row id="msg_0724_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nasza nieustraszona i\npiękna Reporterka poniosła\nporażkę. Zlituj się nad mną!\r</language>
	</row>
	<row id="msg_0724_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chcę tego\nprzyznawać, ale też chciałem\nbyć Idolem.</language>
	</row>
	<row id="msg_0724_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie chciałem przegrać\nz żadnym Idolem. To mnie\nmotywowało do treningu.\r</language>
	</row>
	<row id="msg_0724_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To przytłaczające...\nPracuję tak dużo ciężej niż\njakikolwiek głupi Idol...\r</language>
	</row>
	<row id="msg_0724_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten mikrofon uczynił\nmnie gwiazdą. To moje\nwszystko.</language>
	</row>
	<row id="msg_0724_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet na walkę nie\npuszczam tego mikrofonu z\nręki.\r</language>
	</row>
	<row id="msg_0724_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Łup. Bzzzzt...\r</language>
	</row>
	<row id="msg_0724_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, co słychać.\nPowinienem ostrzec cię, że\njestem naprawdę szybki,\ntrenerze. Przytrzymaj kapelusz.</language>
	</row>
	<row id="msg_0724_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trenerze, od teraz\nmożesz zaczynać dodawać Pan\ndo mojego imienia.\r</language>
	</row>
	<row id="msg_0724_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trenerze, to była\nprawdziwa nauka. Dziękuję,\nserio.\r</language>
	</row>
	<row id="msg_0724_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Rower stał się\nprzedłużeniem mojej samej\nistoty.</language>
	</row>
	<row id="msg_0724_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jakakolwiek szkoda\nmojego Roweru, czuję ten ból,\njakby był mój do zniesienia.\r</language>
	</row>
	<row id="msg_0724_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę! Poproszę cię,\nby trzymał swoje brudne ręce\nz daleka od mojego Roweru.\r</language>
	</row>
	<row id="msg_0724_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy byłem mały,\nnienawidziłem jazdy na\nrowerze. Nie mogłem tego\nskapować.</language>
	</row>
	<row id="msg_0724_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham jazdę na\nrowerze teraz. Zdobyłem wielu\nprzyjaciół, jeżdząc.\r</language>
	</row>
	<row id="msg_0724_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umiesz jeździć na\nrowerze? Jest to zdrowe i\nbardzo zabawne.\r</language>
	</row>
	<row id="msg_0724_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będę jeździł w\nstronę łamiącego się świtu z\ntobą na myśli.</language>
	</row>
	<row id="msg_0724_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przełączę biegi\nwyżej i wyżej, aż cię dogonię...\r</language>
	</row>
	<row id="msg_0724_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje opony się\nspuściły, a tak samo moje\nserce...\r</language>
	</row>
	<row id="msg_0724_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niech kurtyny się\nwzniosą na uroczystość\nmięśni i Pokémonów!</language>
	</row>
	<row id="msg_0724_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy podobała się\ntobie nasza demonstracja\nmięśni i Pokémonów?\r</language>
	</row>
	<row id="msg_0724_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć przegrałem, moje\nmięśnie i Pokémony są\nwypalone w twoim umyśle.\r</language>
	</row>
	<row id="msg_0724_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówią, że mam pięści\nze stali i serce dziecka.</language>
	</row>
	<row id="msg_0724_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, jej! Jippie!\nWygrałem, wygrałem!\r</language>
	</row>
	<row id="msg_0724_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, boo! Boo! To\nśmierdzi! Nie rozmawiam z\ntobą!\r</language>
	</row>
	<row id="msg_0724_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hwoaaah...\nHwoaaah...</language>
	</row>
	<row id="msg_0724_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Howatchah!\nHowaaatchaah!\r</language>
	</row>
	<row id="msg_0724_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fweeeh...\nFweeehhh...\r</language>
	</row>
	<row id="msg_0724_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W moim słowniku nie\nma wpisu dla „umiaru”.</language>
	</row>
	<row id="msg_0724_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Największa oznaka\nrespektu wśród trenerów to\nwalczyć na całość.\r</language>
	</row>
	<row id="msg_0724_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dałem z siebie\nwszystko i wciąż przegrałem.\nOczywiście, że boli.\r</language>
	</row>
	<row id="msg_0724_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Profesjonalny mistrz\nsztuk walki ma stałą kontrolę\nnad swoim ciałem.</language>
	</row>
	<row id="msg_0724_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mistrz sztuk walki musi\nbyć więcej niż silny. Musi\nteż być mądry.\r</language>
	</row>
	<row id="msg_0724_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gah! Przesadziłem z\ntreningiem i wcześnie\nskończyła mi się\nwytrzymałość...\r</language>
	</row>
	<row id="msg_0724_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy zamykam oczy,\nmogę sobie wyobrazić, że cię\npokonuję. Dawaj.</language>
	</row>
	<row id="msg_0724_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu smutny?\nWiedziałeś, że to się stanie.\r</language>
	</row>
	<row id="msg_0724_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Besztam się za\nwłasny brak uwagi...\r</language>
	</row>
	<row id="msg_0724_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie lubię się dużo\nporuszać. Trenowałem, używając\nInternetu i TV.</language>
	</row>
	<row id="msg_0724_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uhihi! Jestem\nnaturalnie utalentowanym profesjonalistą\nw karate i Pokémonach, to ja.\r</language>
	</row>
	<row id="msg_0724_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, stary, to\nnieznośne! Jestem zmęczony i\ngłodny i chcę iść do domu!\r</language>
	</row>
	<row id="msg_0724_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...By zajść tak daleko,\nmusiałem poczynić poświęcenia.\nWiele, wiele poświęceń.</language>
	</row>
	<row id="msg_0724_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To dla tego jednego\nmomentu żyję.\r</language>
	</row>
	<row id="msg_0724_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co jeszcze muszę\noddać, by cię pokonać?\r</language>
	</row>
	<row id="msg_0724_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najpierw, walczmy.\nRozmowa może czekać.</language>
	</row>
	<row id="msg_0724_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wcale nie było\nźle, jup. To dotyczy ciebie i\ntwojego Pokémona.\r</language>
	</row>
	<row id="msg_0724_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś twardy, jup.\nGdzie trenujesz?\r</language>
	</row>
	<row id="msg_0724_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uroczy mały trenerze!\nZgnieciemy cię na płask.</language>
	</row>
	<row id="msg_0724_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eheh! Jesteś tak\nuroczy, gdy wyglądasz na\nzłego i sfrustrowanego!\r</language>
	</row>
	<row id="msg_0724_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co myślisz, że robisz?\nNienawidzę przegrywać, daję ci\nznać!\r</language>
	</row>
	<row id="msg_0724_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój cenny Pokémon\nzaraz cię naprostuje!</language>
	</row>
	<row id="msg_0724_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje Pokémony nie mają\nwad, które mógłbyś\nwykorzystać!\r</language>
	</row>
	<row id="msg_0724_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam, mój\ndrogi Pokémonie... Zostałem\nzłapany nieprzygotowany...\r</language>
	</row>
	<row id="msg_0724_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwo-fwo-fwo. Młodziku,\nco jest najważniejsze, to nigdy\nsię nie poddawać.</language>
	</row>
	<row id="msg_0724_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli poddasz się,\nto to. Gra się kończy.\r</language>
	</row>
	<row id="msg_0724_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwo-fwo-fwo.\nJesteś już godnym podziwu\ntrenerem.\r</language>
	</row>
	<row id="msg_0724_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę powiedzieć po\ntym, jak wyglądasz, że jesteś\ncałkiem zafascynowany moim\nelegantowskim stylem!</language>
	</row>
	<row id="msg_0724_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie powinieneś być\ntak zahipnotyzowany mną. Jak\nMOTHIM przyciągnięty do płomienia!\r</language>
	</row>
	<row id="msg_0724_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie jesteś\nzainteresowany mną? Jesteś\nzwyczajnie SHELLOS, jeśli mogę\ntak powiedzieć.\r</language>
	</row>
	<row id="msg_0724_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, witaj, czy nie\njesteś słodziakiem! Jesteś\npewien, że jesteś gotów na\nto?</language>
	</row>
	<row id="msg_0724_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, teraz, proszę,\nnie płacz. Powinieneś być z\nsiebie dumny, drogi.\r</language>
	</row>
	<row id="msg_0724_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, mój... Jesteś\ncałkiem zdolnym praktykiem\ntej sztuki.\r</language>
	</row>
	<row id="msg_0724_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty i twój Pokémon\nmoglibyście skorzystać z\nlekcji posłuszeństwa od mnie.</language>
	</row>
	<row id="msg_0724_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To nie koniec, aż ja\ntak powiem. Jeszcze raz.\r</language>
	</row>
	<row id="msg_0724_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwstawiasz mi się?\nJak bardzo zabawne.\r</language>
	</row>
	<row id="msg_0724_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przez te wszystkie\nlata skrzyżowałem ścieżki z\nwielu trenerami.</language>
	</row>
	<row id="msg_0724_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszyscy byli\nwspaniałymi trenerami na swój\nwłasny sposób. Wszystko to są\nteraz miłe wspomnienia...\r</language>
	</row>
	<row id="msg_0724_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś jednym z\ntych wielu trenerów. Przykro\nmi, że nie byłem młodszy.\r</language>
	</row>
	<row id="msg_0724_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Psychicą,\nchoć może nie wyglądam jak\njedna. Zrobię coś\npsychicznego.</language>
	</row>
	<row id="msg_0724_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie użyłem żadnej\nmocy psychicznej, by wygrać.\nNie, naprawdę.\r</language>
	</row>
	<row id="msg_0724_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zauważyłeś? Lewitowałem,\ngdy byłem w walce z tobą.\r</language>
	</row>
	<row id="msg_0724_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwazzam!\nWięc! Jesteś moją kolejną\nofiarą!</language>
	</row>
	<row id="msg_0724_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwazzam!\nNie masz charakteru?!\r</language>
	</row>
	<row id="msg_0724_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwizzle...\nNie myśl, że będzie następny\nraz!</language>
	</row>
	<row id="msg_0724_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę używać mocy\npsychicznej, ale wolę zwyczajne\nsztuczki magiczne.</language>
	</row>
	<row id="msg_0724_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To moja opinia, że\nmoc psychiczna powinna być\nzostawiona Pokémonom.\r</language>
	</row>
	<row id="msg_0724_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Psychicą, ale\njestem też studentem\nszkoły magicznej.\r</language>
	</row>
	<row id="msg_0724_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W następnych kilku\nminutach poznasz prawdziwy\nterror z moich rąk!</language>
	</row>
	<row id="msg_0724_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hah! Za słaby! Za\nsłaby! Co za żałosny opór!\r</language>
	</row>
	<row id="msg_0724_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieee!\nNie mogę przegrać!</language>
	</row>
	<row id="msg_0724_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzę to, do czego\nnie mam prawa widzieć... Jak\ntam. Za tobą.</language>
	</row>
	<row id="msg_0724_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och? Nie możesz tego\nzobaczyć? Więc masz\nszczęście. Chichot...\r</language>
	</row>
	<row id="msg_0724_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie pytałbym, co\nwidzę. Lepiej nie wiedzieć.\nNaprawdę.\r</language>
	</row>
	<row id="msg_0724_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wielka niewidzialna\nmoc... Proszę cię o pomoc...</language>
	</row>
	<row id="msg_0724_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, wielka\nniewidzialna moc... Dziękuję\nci za przybycie mi na pomoc...\r</language>
	</row>
	<row id="msg_0724_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och... Wielka\nniewidzialna moc... Czemu\nmnie opuściłaś...\r</language>
	</row>
	<row id="msg_0724_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu wychowuję\nPokémony? Bo są tam!</language>
	</row>
	<row id="msg_0724_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że powiedziałem\ncoś głębokiego i cool!\nCzyż nie?\r</language>
	</row>
	<row id="msg_0724_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wcale nie powód?\nTo właśnie jest powodem samym\nw sobie!\r</language>
	</row>
	<row id="msg_0724_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja drużyna była\nwychowywana z troską. Mam w\nnich absolutne zaufanie.</language>
	</row>
	<row id="msg_0724_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powinieneś zwracać\nwiększą uwagę na unikalne\naspekty swojego Pokémona.\r</language>
	</row>
	<row id="msg_0724_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak znalazłeś mojego\nPokémona? Zauważyłeś ich\nznaczenie?\r</language>
	</row>
	<row id="msg_0724_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszyscy, czas na\npokaz! Wyjdźcie i trochę\nnawalczcie!</language>
	</row>
	<row id="msg_0724_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, brawo!\nŚwietnie wygrane!\r</language>
	</row>
	<row id="msg_0724_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arrgh! Jak\nupokarzające! Szybko! Z\nreflektora!\r</language>
	</row>
	<row id="msg_0724_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham wychowywanie\nPokémonów. Właśnie dla tego\nżyję!</language>
	</row>
	<row id="msg_0724_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widok, jak starają\nsię tak bardzo, by zadowolić...\nTo jest tak nieznośnie\nurocze.\r</language>
	</row>
	<row id="msg_0724_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie waż się zrobić\ntego znowu!\r</language>
	</row>
	<row id="msg_0724_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Opracowuję sposoby\nwychowywania twardych\nPokémonów od poziomu\ngenetycznego.</language>
	</row>
	<row id="msg_0724_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie możesz\nprzeoczyć roli wiedzy w\nwychowywaniu twardych\nPokémonów.\r</language>
	</row>
	<row id="msg_0724_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę studiować i\nzrozumieć, czym jest genetyka\nnajpierw.\r</language>
	</row>
	<row id="msg_0724_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wychowaj je z miłością,\ni Pokémony odpowiedzą w\nnaturze. Pewnie.</language>
	</row>
	<row id="msg_0724_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odpowiedziały na moją\nmiłość. Pewnie.\r</language>
	</row>
	<row id="msg_0724_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wychowujesz swojego\nPokémona z wielką miłością.\nMyślę.\r</language>
	</row>
	<row id="msg_0724_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzę, że podejdę\ndo tej walki z perspektywy\nnoworodka.</language>
	</row>
	<row id="msg_0724_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Abuboo dah.\r</language>
	</row>
	<row id="msg_0724_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ababaa.\nManmaa.\r</language>
	</row>
	<row id="msg_0724_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zwyciężysz,\nopowiem ci historię z mojej\nmłodości.</language>
	</row>
	<row id="msg_0724_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widok ciebie\nprzywraca powódź wspomnień.\nAch, tak, naprawdę...\r</language>
	</row>
	<row id="msg_0724_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Hm?\nWydaje się, że zapomniałem...\r</language>
	</row>
	<row id="msg_0724_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma końca ani\ndla dorastania, ani dla\nPokémonów.</language>
	</row>
	<row id="msg_0724_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Do zobaczenia! To\nbyło zabawne! Ciesz się swoją\nmłodością!\r</language>
	</row>
	<row id="msg_0724_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wciąż jestem\nmarzycielem. Cenny,\nniesplamiony płatek śniegu...\r</language>
	</row>
	<row id="msg_0724_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tatusiu... Mamusiu...\nSłyszycie mnie? Proszę, patrzcie\nnade mną...</language>
	</row>
	<row id="msg_0724_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tatusiu... Mamusiu...\nWidzieliście? Wygrałem, i to\nwszystko dla was...\r</language>
	</row>
	<row id="msg_0724_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och... Tatusiu...\nMamusiu... Nie mogłem wygrać...\r</language>
	</row>
	<row id="msg_0724_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nareszcie... Nadszedł\nczas, by owoce moich badań\npoddać testowi...</language>
	</row>
	<row id="msg_0724_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sukces...\nPoświęcenie mojej młodości było\nwarte.\r</language>
	</row>
	<row id="msg_0724_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie! Nieeeeee!\nOddaj mi moją młodość!\r</language>
	</row>
	<row id="msg_0724_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Opracowałem specjalny\nnapój Pokémon. Weź trochę!\nDo dna!</language>
	</row>
	<row id="msg_0724_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Glug, glug... Bek!\nUczyni cię silnym! Nie\nmarnuj go!\r</language>
	</row>
	<row id="msg_0724_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój napój Pokémon\nnie zawiera żadnych\nprawdziwych Pokémonów ani ich\nproduktów pochodnych.\r</language>
	</row>
	<row id="msg_0724_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Analogia do\nwalczenia to...\nPowiedziałbym, że kawaler.</language>
	</row>
	<row id="msg_0724_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heheh, rozumiesz to?\nWątpię, że byś to zrozumiał.\nNikt nie rozumie.\r</language>
	</row>
	<row id="msg_0724_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiesz, co mówię?\nWątpię, że byś to zrozumiał.\nNikt nigdy nie rozumie.\r</language>
	</row>
	<row id="msg_0724_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja sam, urodziłem\nsię, wychowałem i spędziłem\nżycie pod namiotem cyrkowym.</language>
	</row>
	<row id="msg_0724_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój Pokémon też.\nUrodzili się i wychowali pod\nnamiotem cyrkowym.\r</language>
	</row>
	<row id="msg_0724_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świat zewnętrzny jest\ntak bardzo okrutny... Wrócimy\ndo naszego namiotu cyrkowego.</language>
	</row>
	<row id="msg_0724_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oi, ty! Tak, ty!\nZbierz się! Będę cię trenować!</language>
	</row>
	<row id="msg_0724_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co?! Jesteś już\npowalony?! To nie łóżko! Wstań!\r</language>
	</row>
	<row id="msg_0724_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze! Wystarczy!\nTo wystarczy na dzisiaj!\r</language>
	</row>
	<row id="msg_0724_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwah? Masz na myśli,\nby mnie wyzwać?</language>
	</row>
	<row id="msg_0724_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwahaha! Wygrywam!\nWięcej szczęścia następny raz,\npankerze!\r</language>
	</row>
	<row id="msg_0724_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwaah?! Pokonałeś\nmnie? Kim jesteś, by to\nzrobić?!\r</language>
	</row>
	<row id="msg_0724_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, dostaję od tego\nciarek... Żyję dla tego\nmomentu.</language>
	</row>
	<row id="msg_0724_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, tak... To jest\nto... Perfekcja nie bywa\nlepsza...\r</language>
	</row>
	<row id="msg_0724_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Doszło do tego, że\nnie mogę już żyć bez\nwalczenia.\r</language>
	</row>
	<row id="msg_0724_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK! Zamierzam to\nzrobić! Pokażę ci moje\nnajlepsze!</language>
	</row>
	<row id="msg_0724_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zipnięcie, zipnięcie...\r</language>
	</row>
	<row id="msg_0724_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy więcej!\nMożesz zapomnieć o następnym\nrazie!\r</language>
	</row>
	<row id="msg_0724_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Um... Jestem szczerze\ncałkiem twardy. Proszę,\ndotrzymuj kroku.</language>
	</row>
	<row id="msg_0724_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam.\nNie myślę, że dorastasz do\ntego w końcu.\r</language>
	</row>
	<row id="msg_0724_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem zdumiony.\nNie myślałem, że wygrasz...\r</language>
	</row>
	<row id="msg_0724_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj, ja! Dawaj, ja,\ndawaj!\nNie przegrywaj, nie przegrywaj,\nrah, rah, rah!</language>
	</row>
	<row id="msg_0724_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak trzymać, ja!\nJestem tak wspaniały!\nRah, rah, rah! Dawaaaaj, ja!\r</language>
	</row>
	<row id="msg_0724_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To OK, ja! Nie płacz!\nNie płacz!\nIdź do domu, idź do domu,\nidźżżż!\r</language>
	</row>
	<row id="msg_0724_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Woohoo! Nadchodzi\ncool trener! Zobaczmy, co\nmożesz pokazać!</language>
	</row>
	<row id="msg_0724_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak! Brawo!\nMasz jakieś dobre ataki,\ntrenerze!\r</language>
	</row>
	<row id="msg_0724_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Coooo?! Nieeee!\nNie mogę się pogodzić z tym,\njak twardy jesteś!\r</language>
	</row>
	<row id="msg_0724_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Służyć i chronić\nPokémony i naturę. To moja\nmisja!</language>
	</row>
	<row id="msg_0724_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje umiejętności\nrozwinąłem w ramionach\nMatki Natury!\r</language>
	</row>
	<row id="msg_0724_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja misja mnie\npotrzebuje! To tutaj\npożegnamy się!\r</language>
	</row>
	<row id="msg_0724_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie bój się, ten\nPokémon Ranger jest tu, by\nchronić mój własny osobisty\npokój!</language>
	</row>
	<row id="msg_0724_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój osobisty pokój\nzostał ochroniony!\r</language>
	</row>
	<row id="msg_0724_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty nikczemny trenerze,\nty! Zburzyłeś mój spokój!\r</language>
	</row>
	<row id="msg_0724_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy jakieś niedobre\ndzieci śmiecą na polach?\nCzy jakieś niedobre dzieci\nzanieczyszczają morze?</language>
	</row>
	<row id="msg_0724_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pamiętaj, żeby\nsortować swoje odpady do\nrecyklingu od śmieci, gdy je\nwyrzucasz!</language>
	</row>
	<row id="msg_0724_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śmieci są jak\nwalka. Nie wyrzucaj ich za\nszybko!</language>
	</row>
	<row id="msg_0724_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Patrz na mnie,\nkochanie! Wkładam w to moje\nnajlepsze!</language>
	</row>
	<row id="msg_0724_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz, kochanie?\nWidziałeś? Dałem w to mój\nnajlepszy wysiłek dla ciebie.\r</language>
	</row>
	<row id="msg_0724_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę pozwolić, by\nmoja kochana widziała mnie\ntakim. Jak żałośnie muszę\nwyglądać...\r</language>
	</row>
	<row id="msg_0724_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, zaczynam od\ntego... Potem, kontra...\nUgh, nie mogę zrobić naszej\nstrategii dobrze!</language>
	</row>
	<row id="msg_0724_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeanalizowanie\nzbyt dokładne może być złą\nrzeczą, zgaduję.\r</language>
	</row>
	<row id="msg_0724_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waaah! Nie mogłeś\npoczekać? Przynajmniej, aż\nbędę gotowy?\r</language>
	</row>
	<row id="msg_0724_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak podoba ci się\nmoja peleryna? Zrobiłem ją na\nspecjalne zamówienie!</language>
	</row>
	<row id="msg_0724_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z czego jest moja\npeleryna zrobiona? Boję się,\nże nie mogę ci powiedzieć.\r</language>
	</row>
	<row id="msg_0724_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rip... Riiiiiiiiiiiipppppp!\n...Co?! Moja peleryna!\nWaaaaah!\r</language>
	</row>
	<row id="msg_0724_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiesz, co to jest\nprawdziwy terror? Znam go.\nIntymnie tak...</language>
	</row>
	<row id="msg_0724_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nauczyłeś się czegoś\ndziś, tak? Prawdziwego\nznaczenia terroru.\r</language>
	</row>
	<row id="msg_0724_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aiyeeh! Co z tobą?\nProszę o łaskę tutaj!\r</language>
	</row>
	<row id="msg_0724_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zobacz to! Usłysz to!\nPowąchaj to! Zdziw się moją\nmocą!</language>
	</row>
	<row id="msg_0724_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się! Użyj\nwszystkich zmysłów i zrozum,\nz czym walczyłeś!\r</language>
	</row>
	<row id="msg_0724_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie widziałem niczego!\nNie słucham! I niczego nie\nczuję!\r</language>
	</row>
	<row id="msg_0724_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niefortunnie dla\nciebie, twoja seria wygranych\nkończy się ze mną.</language>
	</row>
	<row id="msg_0724_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałeś ze mną,\nale wciąż stoisz na nogach.\nSzacunek dla ciebie!\r</language>
	</row>
	<row id="msg_0724_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To nie może być.\nNie przyjmę tego. Musi być\ngdzieś błąd.\r</language>
	</row>
	<row id="msg_0724_00468" index="468">
		<attribute name="window_context_name">used</attribute>
		<language name="English">N-nie mogę\nprzestać się trząść. A-ale\nto jest w-walka. Muszę.</language>
	</row>
	<row id="msg_0724_00469" index="469">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urrff... Ch-chatter...\nWygrałem, wygrałem...\r</language>
	</row>
	<row id="msg_0724_00470" index="470">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dr-drżenie... Urf...\nMoje powieki robią się\nciężkie...\r</language>
	</row>
	<row id="msg_0724_00471" index="471">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powiem ci teraz do\nwidzenia. Walki zawsze\nkończą się we łzach.</language>
	</row>
	<row id="msg_0724_00472" index="472">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fweeeeh!\nMoje łzy radości płyną\nswobodnie!\r</language>
	</row>
	<row id="msg_0724_00473" index="473">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fweeeeh!\nMoje łzy męki płyną\nswobodnie!\r</language>
	</row>
	<row id="msg_0724_00474" index="474">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak zabawne! Przyszedłeś\ntutaj, znając swoją\npewną porażkę?</language>
	</row>
	<row id="msg_0724_00475" index="475">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ahahahah! Bardzo\nzabawne! Będę szczęśliwy,\nby cię znowu zobaczyć!\r</language>
	</row>
	<row id="msg_0724_00476" index="476">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co... Co się\ndzieje...? M-moja wizja\nrobi się mlecznobiała...\r</language>
	</row>
	<row id="msg_0724_00477" index="477">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trenerem jestem, nowym\npromieniem nadziei z krainy\npółnocnego słońca.</language>
	</row>
	<row id="msg_0724_00478" index="478">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W mroźnych\nwodospadach północy wyostrzyłem\nswoje umiejętności. Z nimi,\nsprowadziłem cię do upadku.\r</language>
	</row>
	<row id="msg_0724_00479" index="479">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje podłe sztuczki\nzasługują na pogardę. Ale\nefektywne były, też.\r</language>
	</row>
	<row id="msg_0724_00480" index="480">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zastanawiam się\nostatnio... Jak długo jeszcze\nbędę noszę szorty?</language>
	</row>
	<row id="msg_0724_00481" index="481">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy wciąż będę w\nszortach jako dorosły?\r</language>
	</row>
	<row id="msg_0724_00482" index="482">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli się tak\npostarzeję, czy nazwą mnie\ncoś głupiego jak „Pan Szorty”?\r</language>
	</row>
	<row id="msg_0724_00483" index="483">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się, jestem\nlegendarnym dzieciakiem w\nszortach, o którym mówi całe\nmiasto.</language>
	</row>
	<row id="msg_0724_00484" index="484">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet Młodzik w\nszortach jak ja może być\nmateriałem na legendę albo\ndwie.\r</language>
	</row>
	<row id="msg_0724_00485" index="485">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja legenda się\nkończy...\r</language>
	</row>
	<row id="msg_0724_00486" index="486">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh... Um... W-witaj.\nM-miło cię poznać.</language>
	</row>
	<row id="msg_0724_00487" index="487">
		<attribute name="window_context_name">used</attribute>
		<language name="English">P-p-przepraszam.\nJestem n-naprawdę n-nerwowy.\r</language>
	</row>
	<row id="msg_0724_00488" index="488">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uh... Dz-dziękuję.\nTo było z-zabawne.\r</language>
	</row>
	<row id="msg_0724_00489" index="489">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, to miejsce jest\ntak passé teraz. Przegapiam\nzakupy.</language>
	</row>
	<row id="msg_0724_00490" index="490">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś całkiem\nstylowy, właściwie. Och,\nchciałbym mieć nowe ubrania.\r</language>
	</row>
	<row id="msg_0724_00491" index="491">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może zbiorę\nAkcesoria na jakieś Konkursy...\r</language>
	</row>
	<row id="msg_0724_00492" index="492">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sezon egzaminów\nnadchodzi, ale jestem po uszy\nw walczeniu...</language>
	</row>
	<row id="msg_0724_00493" index="493">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mama mnie odciąży od\nkieszonkowego. Wiem to już...\r</language>
	</row>
	<row id="msg_0724_00494" index="494">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę nadążać z\nnauką i Pokémonami...\r</language>
	</row>
	<row id="msg_0724_00495" index="495">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hiya, ty, trenerze\ntam! Nałóż okulary. Będą\nlepiej na tobie wyglądać.</language>
	</row>
	<row id="msg_0724_00496" index="496">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nic nie jest z moimi\noczami. Noszę okulary dla\nwyglądu, jaki dostaję.\r</language>
	</row>
	<row id="msg_0724_00497" index="497">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ups!\nMoje okulary, moje okulary.\r</language>
	</row>
	<row id="msg_0724_00498" index="498">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uczono mnie, że\nkażdy przeciwnik ma słabość.\nJeśli znajdę twoją...</language>
	</row>
	<row id="msg_0724_00499" index="499">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eheheh.\nWykombinowałem twoją\nsłabość.\r</language>
	</row>
	<row id="msg_0724_00500" index="500">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wykombinowałeś moją\nsłabość?\r</language>
	</row>
	<row id="msg_0724_00501" index="501">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Minęło tyle czasu\nod mojej ostatniej walki.</language>
	</row>
	<row id="msg_0724_00502" index="502">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiesz, walczenie\njest zabawne w końcu.\r</language>
	</row>
	<row id="msg_0724_00503" index="503">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczenie jest tak\nzabawne, ale...\r</language>
	</row>
	<row id="msg_0724_00504" index="504">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiek pieniędzy\nnadszedł w walkach Pokémon.\nNauczę cię, kto ma rację.</language>
	</row>
	<row id="msg_0724_00505" index="505">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiesz, prawda?\nCo jest słuszne, i kto jest\nsilniejszy?\r</language>
	</row>
	<row id="msg_0724_00506" index="506">
		<attribute name="window_context_name">used</attribute>
		<language name="English">M-mój Pokémon! Co\nzrobiłeś? Co mam teraz\nzrobić?!\r</language>
	</row>
	<row id="msg_0724_00507" index="507">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś moim\nprzeciwnikiem? Och, w\nporządku... Postaraj się nie\nzawieść mnie zbyt mocno.</language>
	</row>
	<row id="msg_0724_00508" index="508">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje Pokémony są\nnajwyższej luksusowej klasy.\nWidzisz? Oto o co chodzi w\nmocy.\r</language>
	</row>
	<row id="msg_0724_00509" index="509">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nyah! Nie obchodzi\nmnie to! Mam wystarczająco\npieniędzy, by wypełnić basen!\r</language>
	</row>
	<row id="msg_0724_00510" index="510">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty tam. Tak, ty.\nCzuję się raczej znudzony.</language>
	</row>
	<row id="msg_0724_00511" index="511">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przypuszczam, że to\nbyło przyjemne na to, co\nbyło. Dziękuję ci za to.\r</language>
	</row>
	<row id="msg_0724_00512" index="512">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś raczej dobry.\nCałkiem niezwykły, nawet.\r</language>
	</row>
	<row id="msg_0724_00513" index="513">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę zatopić twój\ngatunek minimalnym wysiłkiem.</language>
	</row>
	<row id="msg_0724_00514" index="514">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zajęło to najmniejszy\nwysiłek, by wygrać ten mecz.\r</language>
	</row>
	<row id="msg_0724_00515" index="515">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zalaliście nas bez\nżadnego wysiłku...\r</language>
	</row>
	<row id="msg_0724_00516" index="516">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój pokój jest\nzawsze pełen owadów. To\nsprowadza moją mamę do szału.</language>
	</row>
	<row id="msg_0724_00517" index="517">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcę zebrać więcej\nPokémonów typu Bug na moje\nstanowisko doceniania owadów.\r</language>
	</row>
	<row id="msg_0724_00518" index="518">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Owady chodzą\nswobodnie pod moją koszulą.\nZaczynam się drapać...\r</language>
	</row>
	<row id="msg_0724_00519" index="519">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ludzie twierdzą, że\njestem jak dorosły. Co by to\nmogło oznaczać, myślisz?</language>
	</row>
	<row id="msg_0724_00520" index="520">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach, tak, całkiem\nprzyjemne! Musimy to zrobić\nznowu, z pewnością.\r</language>
	</row>
	<row id="msg_0724_00521" index="521">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, tak! Rozwalające!\nTo zmroziło mnie do palców\nu nóg, tak było!\r</language>
	</row>
	<row id="msg_0724_00522" index="522">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dokonałem mojego\nwyboru. Gdy upadnę, będzie to\nnaprzód!</language>
	</row>
	<row id="msg_0724_00523" index="523">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brakuje ci\nprzekonania.\r</language>
	</row>
	<row id="msg_0724_00524" index="524">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Łup.\r</language>
	</row>
	<row id="msg_0724_00525" index="525">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, czym\nwłaściwie jest ninja, możesz\nzapytać.</language>
	</row>
	<row id="msg_0724_00526" index="526">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ninja jest\npotężny. To zrobi na początek.\r</language>
	</row>
	<row id="msg_0724_00527" index="527">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może jacyś ninja są\nsłabi?\r</language>
	</row>
	<row id="msg_0724_00528" index="528">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kiedyś widziałem\ndamę noszącą ten sam strój\nco ja.</language>
	</row>
	<row id="msg_0724_00529" index="529">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powiedziała, „Pokazujesz\nserio modowy zmysł.”\r</language>
	</row>
	<row id="msg_0724_00530" index="530">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powiedziała,\n„Żartujesz sobie ze mnie,\nprawda?”\r</language>
	</row>
	<row id="msg_0724_00531" index="531">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy wierzysz, że\nwewnątrz tego kostiumu jest\ndorosła Pięknotka?</language>
	</row>
	<row id="msg_0724_00532" index="532">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moim snem jest żyć\njako Pokémon pewnego dnia.\nStać się Pokémonem!\r</language>
	</row>
	<row id="msg_0724_00533" index="533">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem dorosła, ale\nchcę być Pokémonem. Czy to\nczyni mnie dziwną?\r</language>
	</row>
	<row id="msg_0724_00534" index="534">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój profil jest\nteraz na wysokości, więc mój\nharmonogram jest w pełni\nzapełniony!</language>
	</row>
	<row id="msg_0724_00535" index="535">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nie! Jest już\ntak późno? Lepiej sprawdzę\nmój harmonogram!\r</language>
	</row>
	<row id="msg_0724_00536" index="536">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Menadżerko talentów!\nMam czas na rewanż?\r</language>
	</row>
	<row id="msg_0724_00537" index="537">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś jeszcze\njednym z moich fanów? Mogę\ndać ci autograf, jeśli\nprzegrasz?</language>
	</row>
	<row id="msg_0724_00538" index="538">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oto twój autograf!\nPielęguj go! Och, przepraszam!\nNie podaję ręki.\r</language>
	</row>
	<row id="msg_0724_00539" index="539">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam, zachowywałem\nsię jak GASTLY! To było\nbardzo DELCATTY z mojej\nstrony!\r</language>
	</row>
	<row id="msg_0724_00540" index="540">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę być na diecie.\nMuszę iść pobiegać.</language>
	</row>
	<row id="msg_0724_00541" index="541">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, myślę, że pójdę\nna szybki trucht tutaj...\r</language>
	</row>
	<row id="msg_0724_00542" index="542">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje Pokémony wiedzą,\njak uderzać mocno. Widzisz,\njestem naprawdę bokserem.\r</language>
	</row>
	<row id="msg_0724_00543" index="543">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Patrzę na Pokémony\ntypu Bug, by szukać podpowiedzi\no bieganiu cały czas.</language>
	</row>
	<row id="msg_0724_00544" index="544">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podziwiam lekki i\nzwinny krok Pokémonów typu\nBug.\r</language>
	</row>
	<row id="msg_0724_00545" index="545">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skitter...\r</language>
	</row>
	<row id="msg_0724_00546" index="546">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słuchaj, czuję się\nwyczerpany dzisiaj. Możemy\nzrobić to jutro na pierwszą\nrzecz?</language>
	</row>
	<row id="msg_0724_00547" index="547">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, w porządku.\nJesteś niecierpliwy. Nie\nmogłeś poczekać do jutra, och\nnie.\r</language>
	</row>
	<row id="msg_0724_00548" index="548">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dlatego powiedziałem\njutro. Mogę ledwie zostać\nobudzony teraz.\r</language>
	</row>
	<row id="msg_0724_00549" index="549">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nakarm Pokémona,\nktórego łapiesz, albo ucieknie.\nWidzisz?</language>
	</row>
	<row id="msg_0724_00550" index="550">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy raz Pokémon\nucieknie, nigdy nie wróci.\nWidzisz?\r</language>
	</row>
	<row id="msg_0724_00551" index="551">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To, co powiedziałem\no Pokémonach--to przypowieść.\nWidzisz?\r</language>
	</row>
	<row id="msg_0724_00552" index="552">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy byłem młodszy,\nchodziłem na wykopaliska,\nścigając plotki o skrytych\nskarbach.</language>
	</row>
	<row id="msg_0724_00553" index="553">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oczywiście, nie ma\ntakich rzeczy. Ale to jest o\nścigania snu.\r</language>
	</row>
	<row id="msg_0724_00554" index="554">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, to z pewnością\nzostawiło ogromne dziury...\nW ziemi i na moim koncie\nbankowym.\r</language>
	</row>
	<row id="msg_0724_00555" index="555">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wypuszczę lawinę\nruchów! Przetestuję twoje\ngranice wytrzymałości!</language>
	</row>
	<row id="msg_0724_00556" index="556">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, trenerze?\nCzy powinienem spróbować\njeszcze kilku ruchów?\r</language>
	</row>
	<row id="msg_0724_00557" index="557">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wszystko! Skończył\nmi się magazyn! Chciałbym,\nżebyś wyszedł, bym mógł\nzamknąć!\r</language>
	</row>
	<row id="msg_0724_00558" index="558">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbieram i walczę z\nPokémonami, żeby móc się\nchwalić przed znajomymi.</language>
	</row>
	<row id="msg_0724_00559" index="559">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jestem wcale\nzainteresowany wygraną czy\nporażką na początek.\r</language>
	</row>
	<row id="msg_0724_00560" index="560">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrałeś walkę. Ale,\npod względem Pokémonów\nzaangażowanych, jasno ja\nwygrywam.\r</language>
	</row>
	<row id="msg_0724_00561" index="561">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałeś zobaczyć\nmojego Pokémona? OK, jasne.\nTylko jedno spojrzenie,\njednak.</language>
	</row>
	<row id="msg_0724_00562" index="562">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak to na szyk? Moje\nPokémony są najlepsze\ntak w ruchach, jak w\ncharakterze.\r</language>
	</row>
	<row id="msg_0724_00563" index="563">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaczekaj tam!\nMożesz patrzeć, ale nie\ndotykaj!\r</language>
	</row>
	<row id="msg_0724_00564" index="564">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rock? Samba?\nTradycyjny folk? Mogę grać w\nkażdym stylu. Wszystko jest\ndobre!</language>
	</row>
	<row id="msg_0724_00565" index="565">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muzyka i Pokémony\nmnie wznoszą! Jestem\nunoszony wśród gwiazd!\r</language>
	</row>
	<row id="msg_0724_00566" index="566">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sigh... Widzę gwiazdy...\nMasz mnie, śpiewam bluesa...\r</language>
	</row>
	<row id="msg_0724_00567" index="567">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niech moja wyborna\nmelodia zabrzmi! Usłysz mój\nPokémon wykrzykujący!</language>
	</row>
	<row id="msg_0724_00568" index="568">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Melodia od mojego\nPokémona i mnie... Czy dotarła\ni poruszyła twoje serce?\r</language>
	</row>
	<row id="msg_0724_00569" index="569">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłem znany z\nprzegrywania meczów, ale\nnigdy nie odstawię gitary na\nscenie!\r</language>
	</row>
	<row id="msg_0724_00570" index="570">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem wolny jak\nptak! Czuję, że mógłbym latać!</language>
	</row>
	<row id="msg_0724_00571" index="571">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To tak stałem się\nOpiekunem Ptaków.\r</language>
	</row>
	<row id="msg_0724_00572" index="572">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak większość\nptaków, nie widzę bardzo\ndobrze w nocy.\r</language>
	</row>
	<row id="msg_0724_00573" index="573">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jako trener, jestem\nkruchy jak jajko. Proszę,\nbądź wobec mnie delikatny.</language>
	</row>
	<row id="msg_0724_00574" index="574">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślisz, że szykuję\nsię, by wzlecieć?\r</language>
	</row>
	<row id="msg_0724_00575" index="575">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jednego z tych dni,\nwyłamię się ze skorupy i\ncię pokonam.\r</language>
	</row>
	<row id="msg_0724_00576" index="576">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bądź świadkiem mojej\ndemonstracji macho i\nmęskości!</language>
	</row>
	<row id="msg_0724_00577" index="577">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tam!\nTak żyje i walczy\nprawdziwy mężczyzna!\r</language>
	</row>
	<row id="msg_0724_00578" index="578">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Waaaah! Waaaah!\nMamusiu!\r</language>
	</row>
	<row id="msg_0724_00579" index="579">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam nadchodzącą\nrozgrywkę z Hikerem. Zobaczmy,\nczy jestem gotów!</language>
	</row>
	<row id="msg_0724_00580" index="580">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jup, powiedziałbym,\nże moja drużyna jest\ngotowa. Ten Hiker nie\nwiedział, co go uderzyło!\r</language>
	</row>
	<row id="msg_0724_00581" index="581">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aww, a niech to, nie!\nNie mogę pobić tego Hikera\ntak!\r</language>
	</row>
	<row id="msg_0724_00582" index="582">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja rozgrywka\nprzeciwko człowiekowi morza\nnadchodzi! Przetestuję moją\ndrużynę!</language>
	</row>
	<row id="msg_0724_00583" index="583">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystko poszło jak\nzaplanowano... Bądź gotowy na\nmnie, człowiek morza!\r</language>
	</row>
	<row id="msg_0724_00584" index="584">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pobicie człowieka\nmorza jest niemożliwe z\nwynikiem tak słabym...\r</language>
	</row>
	<row id="msg_0724_00585" index="585">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uhho uho-uho uhho\nhohoi! Ten taniec używam, by\nsię zmobilizować.</language>
	</row>
	<row id="msg_0724_00586" index="586">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uhho uho-uho uhho\nhohoi! Tak zabawne, że nie\nmogę przestać.\r</language>
	</row>
	<row id="msg_0724_00587" index="587">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uhho uho-uho uhho\nhohoi! Tańczę, by wstrzymać\nmoje łzy od przegranej...\r</language>
	</row>
	<row id="msg_0724_00588" index="588">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jestem naprawdę\nz policją. Jestem kolekcjonerem\nmundurów.</language>
	</row>
	<row id="msg_0724_00589" index="589">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczenie jako\nPolicjant uczyniło to bardzo\nzabawną walką, tak było.\r</language>
	</row>
	<row id="msg_0724_00590" index="590">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wszystko dla\nmnie. Pożegnam cię z czułością.\r</language>
	</row>
	<row id="msg_0724_00591" index="591">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Policjantem.\nAle w wolne dni, jestem\ncałkowicie innym rodzajem\nfacetem.</language>
	</row>
	<row id="msg_0724_00592" index="592">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle gonię\nzłoczyńców jako Policjant.\r</language>
	</row>
	<row id="msg_0724_00593" index="593">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W wolne dni ścigam\nfale i damy jako Pływak.\r</language>
	</row>
	<row id="msg_0724_00594" index="594">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wytrwałość się\nzwraca. Sprawa może się na\ntym odwrócić.</language>
	</row>
	<row id="msg_0724_00595" index="595">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To daje więcej\nemocji, gdy wygrywasz,\nwracając z tyłu.\r</language>
	</row>
	<row id="msg_0724_00596" index="596">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To było bardziej\nemocjonujące niż jakakolwiek\nobserwacja! Dzięki za to!\r</language>
	</row>
	<row id="msg_0724_00597" index="597">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja obecna sprawa\nmoże pójść w obie strony. To\nrzut monetą.</language>
	</row>
	<row id="msg_0724_00598" index="598">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, wygrałem tym\nrazem... Wszystko zdecydowane\nprzez kapryśną monetę...\r</language>
	</row>
	<row id="msg_0724_00599" index="599">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dwa z trzech?\r</language>
	</row>
	<row id="msg_0724_00600" index="600">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyję w lesie.\nWiesz, jestem Biwakowiczem.</language>
	</row>
	<row id="msg_0724_00601" index="601">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pracuję nad tym, by\nżycie na biwaku było\nwygodniejsze.\r</language>
	</row>
	<row id="msg_0724_00602" index="602">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem chory i\nznudzony biwakowaniem w lesie...\r</language>
	</row>
	<row id="msg_0724_00603" index="603">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie, nie, nie mogę\ntego zrobić! Nie jestem\nstworzona do walczenia!</language>
	</row>
	<row id="msg_0724_00604" index="604">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, wow! Wygrałam!\nCo teraz zrobię? Nie jesteś\nna mnie zły, prawda?\r</language>
	</row>
	<row id="msg_0724_00605" index="605">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz! Mówiłam\nci, przed zaczęciem!\nWalczenie po prostu nie jest\ndla mnie.\r</language>
	</row>
	<row id="msg_0724_00606" index="606">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trener zauważony!\nCzas na gotowanie!</language>
	</row>
	<row id="msg_0724_00607" index="607">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka powinna być\nrozkoszowana jak smaczny\nposiłek!\r</language>
	</row>
	<row id="msg_0724_00608" index="608">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skończyłem, będąc\nugotowany!\r</language>
	</row>
	<row id="msg_0724_00609" index="609">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fweeoo-fwee-fwee-fyoo...\nPodchodzę do walki, pogwizdując...</language>
	</row>
	<row id="msg_0724_00610" index="610">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Za łatwe! Gwizdałem\nprzez cały czas.\r</language>
	</row>
	<row id="msg_0724_00611" index="611">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fwee-ooo fwee-ooo\nfwee-ooo... Przełączyłem się\nna syrenę ambulansu...\r</language>
	</row>
	<row id="msg_0724_00612" index="612">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę to słyszeć...\nKrzyczący uwielbienie 100 000\nfanów wznoszący się razem...</language>
	</row>
	<row id="msg_0724_00613" index="613">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O tak, wszyscy!\nWidzieliście to! Dedykuję\nmoją wygraną wam!\r</language>
	</row>
	<row id="msg_0724_00614" index="614">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozpalasz...\nZrobiłeś ze mnie fana.\r</language>
	</row>
	<row id="msg_0724_00615" index="615">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Numer jeden na\nświecie, to jest mój sen.\nCóż, na początek, w każdym\nrazie.</language>
	</row>
	<row id="msg_0724_00616" index="616">
		<attribute name="window_context_name">used</attribute>
		<language name="English">„Numer jeden na\nświecie,” czy to nie brzmi\ndobrze?\r</language>
	</row>
	<row id="msg_0724_00617" index="617">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę się\ncałkiem zdecydować, w czym\npowinnam być numerem jeden\nna świecie.\r</language>
	</row>
	<row id="msg_0724_00618" index="618">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jestem jakąś\ntandetną Idolką! Jestem\naktorką! Proszę, pamiętaj o\ntym!</language>
	</row>
	<row id="msg_0724_00619" index="619">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja kariera nie jest\nniczym jak typowa kariera\nIdolki!\r</language>
	</row>
	<row id="msg_0724_00620" index="620">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem aktorką...\nTo brzmi tak rozkosznie\nwłaściwie...\r</language>
	</row>
	<row id="msg_0724_00621" index="621">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jesteśmy tu na\ndługo, więc uczyńmy to dobrym\nczasem!</language>
	</row>
	<row id="msg_0724_00622" index="622">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki! To było\ntaaak zabawne! Naprawdę mam\nnadzieję, że możemy walczyć\nznowu!\r</language>
	</row>
	<row id="msg_0724_00623" index="623">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To mnie smuci, że\nmuszę mówić pa... Proszę,\nprzyjdź znowu mnie zobaczyć!\r</language>
	</row>
	<row id="msg_0724_00624" index="624">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Kierownikiem\nDepartamentu Fan Clubu...\nPrzynieś swoje najlepsze...</language>
	</row>
	<row id="msg_0724_00625" index="625">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uklęknij przed mocą\nFan Clubu!\r</language>
	</row>
	<row id="msg_0724_00626" index="626">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gweh! Ale dałem z\nsiebie wszystko! Żadnych\nżali, nie mam!\r</language>
	</row>
	<row id="msg_0724_00627" index="627">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witam cię, młody\ntrenerze. Pozwól, że\nzademonstruję moją moc.</language>
	</row>
	<row id="msg_0724_00628" index="628">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Młody trenerze, masz\njakiś pomysł, co znaczy moja\nmoc?\r</language>
	</row>
	<row id="msg_0724_00629" index="629">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przewyższyłeś mnie\nw swojej miłości do\nPokémonów. Jesteś najprawdziwszym\nz fanów.\r</language>
	</row>
	<row id="msg_0724_00630" index="630">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że\nwypróbuję TM, który dała mi\nkobieta z sąsiedztwa.</language>
	</row>
	<row id="msg_0724_00631" index="631">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem pod\nwrażeniem. Ta kobieta\nfaktycznie dała mi coś\nużytecznego.\r</language>
	</row>
	<row id="msg_0724_00632" index="632">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, ta wredna\nkobieta! Ten TM jest\nbezwartościowy!\r</language>
	</row>
	<row id="msg_0724_00633" index="633">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Usłyszałam to!\nMoże jestem wystarczająco\nstara, by być twoją mamą, ale\njestem wciąż młoda!</language>
	</row>
	<row id="msg_0724_00634" index="634">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spójrz na mój\nodcień skóry i mojego\nPokémona! Oba twarde, ale\ngiętkie!\r</language>
	</row>
	<row id="msg_0724_00635" index="635">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Proszę, nie\npowtarzaj tego błędu! Jestem\nmłoda, mówię ci!\r</language>
	</row>
	<row id="msg_0724_00636" index="636">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy to praca czy\nzabawa, jestem z moim\nPokémonem cały dzień.</language>
	</row>
	<row id="msg_0724_00637" index="637">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Życie bez\nPokémonów? Nie mogę sobie\ntego wyobrazić.\r</language>
	</row>
	<row id="msg_0724_00638" index="638">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jakbym była\nzamężna z moim Pokémonem.\nNie jestem zamężna, jednak.\r</language>
	</row>
	<row id="msg_0724_00639" index="639">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stajesz się najlepszy,\npracując ciężej niż wszyscy\ninni.</language>
	</row>
	<row id="msg_0724_00640" index="640">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że byłem\nciężko pracującym.\r</language>
	</row>
	<row id="msg_0724_00641" index="641">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pracuj nad\nwalczeniem w kółko. Twoja\ngwiazda zaświeci pewnego dnia.\r</language>
	</row>
	<row id="msg_0724_00642" index="642">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stanę się tu sławny,\nbym mógł odbudować rancho.</language>
	</row>
	<row id="msg_0724_00643" index="643">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę przegrać.\nTo dla mojego tatusia i\nmamusi.\r</language>
	</row>
	<row id="msg_0724_00644" index="644">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli mogę stać się\nsławny, ludzie zapłacą, by\nodwiedzić moje rancho...\r</language>
	</row>
	<row id="msg_0724_00645" index="645">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Od zachodu słońca,\nżyję przy świecy, aż zasnę.</language>
	</row>
	<row id="msg_0724_00646" index="646">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To nie znaczy, że\nnie mam elektryczności na\nzagrodzie.\r</language>
	</row>
	<row id="msg_0724_00647" index="647">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Światło świecy może\nbyć bardzo romantyczne.\r</language>
	</row>
	<row id="msg_0724_00648" index="648">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałbym\nprzedstawić cię moim cenionym\npartnerom.</language>
	</row>
	<row id="msg_0724_00649" index="649">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, dobrze.\nDobra robota, ekipo. Wszyscy\nzrobiliście świetnie.\r</language>
	</row>
	<row id="msg_0724_00650" index="650">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rzężenie... Rzężenie...\nCzuję się słabo...\r</language>
	</row>
	<row id="msg_0724_00651" index="651">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mam\nzielonego kciuka do uprawy\nJagód. Wychowywanie Pokémonów\njest tym, w czym błyszczę.</language>
	</row>
	<row id="msg_0724_00652" index="652">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę dać ci\nwskazówki na temat\nwychowywania Pokémonów, by\nstały się twarde.\r</language>
	</row>
	<row id="msg_0724_00653" index="653">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wychowywanie żywej\nistoty nigdy nie jest łatwym\nzadaniem...\r</language>
	</row>
	<row id="msg_0724_00654" index="654">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony to\nPokémony, bez względu na\nto, jak twarde, słabe, słodkie\nczy straszne.</language>
	</row>
	<row id="msg_0724_00655" index="655">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wychowaj Pokémony z\nmiłością, i odwzajemnią ją.\r</language>
	</row>
	<row id="msg_0724_00656" index="656">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślę, że to trener\nmusi tutaj przyspieszyć\ntempo.\r</language>
	</row>
	<row id="msg_0724_00657" index="657">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prawidłowe\nwychowywanie Pokémona wymaga\npieniędzy i czasu.</language>
	</row>
	<row id="msg_0724_00658" index="658">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ale to wszystko jest\nwarte, gdy Pokémon dorośnie.\r</language>
	</row>
	<row id="msg_0724_00659" index="659">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By wychować idealnego\nPokémona, jestem gotów\npracować ciężko.\r</language>
	</row>
	<row id="msg_0724_00660" index="660">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zgadza się, jestem\ntwardy. Nie przegram. Nie\nmyślę, że przegranie jest\nmożliwe.</language>
	</row>
	<row id="msg_0724_00661" index="661">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jup, jestem tak\ntwardy... Ehehe... Heeheehee...\r</language>
	</row>
	<row id="msg_0724_00662" index="662">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałem? Ale,\njak...? Co teraz? Co robię?\r</language>
	</row>
	<row id="msg_0724_00663" index="663">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem Asem Trenerem,\nwięc to na prawo do\nchwalenia się.</language>
	</row>
	<row id="msg_0724_00664" index="664">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jup, zrobiłeś dobrze.\nNie, serio.\r</language>
	</row>
	<row id="msg_0724_00665" index="665">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heh...\nMam długą drogę przed\nsobą...\r</language>
	</row>
	<row id="msg_0724_00666" index="666">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekałem na walkę\nz tobą!</language>
	</row>
	<row id="msg_0724_00667" index="667">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miałem rację! Jesteś\ncałkiem przyzwoity. Czemu nie\nzostać Asem Trenerem?\r</language>
	</row>
	<row id="msg_0724_00668" index="668">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś tak dobry, jak\nmówią plotki... Mogę mieć\nrewanż pewnego dnia?\r</language>
	</row>
	<row id="msg_0724_00669" index="669">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spójrz na mnie.\nJestem tym, kim powinieneś\nchcieć się stać.</language>
	</row>
	<row id="msg_0724_00670" index="670">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spodziewałeś się\nczegoś innego?\r</language>
	</row>
	<row id="msg_0724_00671" index="671">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Już mnie przewyższyłeś.\nAle możesz celować tak\nwiele wyżej.\r</language>
	</row>
	<row id="msg_0724_00672" index="672">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Całe moje życie\nzależy od tej jednej walki!\n...Przegraj dla mnie, bardzo\nproszę?</language>
	</row>
	<row id="msg_0724_00673" index="673">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak! Wygrałem! To\nwszystko gładkie żeglowanie\ndla mnie teraz!\r</language>
	</row>
	<row id="msg_0724_00674" index="674">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie miałem przegrać...\nTo moje życie wykolejone.\r</language>
	</row>
	<row id="msg_0724_00675" index="675">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam tu gorączkę.\nTylko żebyś wiedział.</language>
	</row>
	<row id="msg_0724_00676" index="676">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oogh, moja głowa\nsię pali. To sprawia, że\nczuję się bardziej zainspirowany.\r</language>
	</row>
	<row id="msg_0724_00677" index="677">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak powiedziałem,\nmam przeziębienie. Nie jestem\nna szczycie formy.\r</language>
	</row>
	<row id="msg_0724_00678" index="678">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy walczymy, chcę,\nbyś był bardzo ostrożny. Mój\npłaszcz jest bardzo drogi.</language>
	</row>
	<row id="msg_0724_00679" index="679">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Łał! Eek! Uważaj!\nPrawie wylądował na moim\npłaszczu pot Pokémona!\r</language>
	</row>
	<row id="msg_0724_00680" index="680">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Martwiłem się o\nzabrudzenie płaszcza. Kogo\nobchodzi twoja walka?\r</language>
	</row>
	<row id="msg_0724_00681" index="681">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chciałbym, żebyś\nodszedł. Nie chcę widzieć,\njak przegrywasz.</language>
	</row>
	<row id="msg_0724_00682" index="682">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówiłem ci...\nMożesz odejść, proszę?\r</language>
	</row>
	<row id="msg_0724_00683" index="683">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słuchaj...czy bycie\ntwardym nie jest zawsze\ndobrą rzeczą?\r</language>
	</row>
	<row id="msg_0724_00684" index="684">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Whoa-whoa-whoa...\nOstrożnie teraz! Zachowanie\nbalansu jest kluczem!</language>
	</row>
	<row id="msg_0724_00685" index="685">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ups...! Prawie się\nprzewróciłem! Muszę być\nostrożny tutaj...\r</language>
	</row>
	<row id="msg_0724_00686" index="686">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Waaaaaah...\nŁup!\r</language>
	</row>
	<row id="msg_0724_00687" index="687">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz nie martw się\no nic. Zostaw wszystko mi,\nOK?</language>
	</row>
	<row id="msg_0724_00688" index="688">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co powiesz? Zabawne,\nhej? Byłoby miło, gdybyśmy\nznowu się spotkali.\r</language>
	</row>
	<row id="msg_0724_00689" index="689">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, niech mnie!\nNa pewno wziąłeś mnie z\ngóry!\r</language>
	</row>
	<row id="msg_0724_00690" index="690">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będę walczyć. Nie\njest prawdopodobne, że\nprzegram. Jestem twardy.</language>
	</row>
	<row id="msg_0724_00691" index="691">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrywam. Mógłbym\nzatańczyć prosto teraz.\r</language>
	</row>
	<row id="msg_0724_00692" index="692">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co się dzieje?\nCzemu nie mogłem wygrać?\r</language>
	</row>
	<row id="msg_0724_00693" index="693">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Matko Naturo, błagam\ncię! Proszę, pożycz mi siły!</language>
	</row>
	<row id="msg_0724_00694" index="694">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, Matko Naturo,\ndziękuję ci! Tobie\ndedykuję to zwycięstwo!\r</language>
	</row>
	<row id="msg_0724_00695" index="695">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam, Matko\nNaturo! Przepraszam, że cię\nzawiodłem!\r</language>
	</row>
	<row id="msg_0724_00696" index="696">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobry trener\npodejmuje wszystkie wyzwania\nbez względu na wroga czy\nreguły.</language>
	</row>
	<row id="msg_0724_00697" index="697">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żaden trener nie\nmoże być uznany za złego,\njeśli walczy jak najlepiej\nmoże.\r</language>
	</row>
	<row id="msg_0724_00698" index="698">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobry trener nie\nchwali się wygraną. Po\nprostu przygotowuje się na\nnastępną walkę.\r</language>
	</row>
	<row id="msg_0724_00699" index="699">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyjdźcie tu, moje\nPokémony! Proszę, pozbądźcie\nsię tego niemiłego trenera!</language>
	</row>
	<row id="msg_0724_00700" index="700">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooh, tak, kocham\nwas, moje skarbeńki!\rPrzyjdźcie tu i dajcie mi\nbuziaka!</language>
	</row>
	<row id="msg_0724_00701" index="701">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak mogłeś?!\nZraniłeś moje słodkie\nmaleństwa!\r</language>
	</row>
	<row id="msg_0724_00702" index="702">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem w porządku z\npraktyką i treningiem, ale\nwiotczeję, gdy przychodzi do\nzakładów.</language>
	</row>
	<row id="msg_0724_00703" index="703">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję się chory od\nnapięcia! Wolałbym być w domu\ni praktykować!\r</language>
	</row>
	<row id="msg_0724_00704" index="704">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chodzi o\npraktykę, byłbym mistrzem\nbez wątpienia.\r</language>
	</row>
	<row id="msg_0724_00705" index="705">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi-yah! Hah! Hah!\nJeszcze jeden! Hah! Hah!</language>
	</row>
	<row id="msg_0724_00706" index="706">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Boo-yah!\r</language>
	</row>
	<row id="msg_0724_00707" index="707">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi-yah! ...Nie,\nczekaj! Nie!\r</language>
	</row>
	<row id="msg_0724_00708" index="708">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chcesz?</language>
	</row>
	<row id="msg_0724_00709" index="709">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heh...\r</language>
	</row>
	<row id="msg_0724_00710" index="710">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokonałeś mnie?\nGdzie jest twoje dojo?\r</language>
	</row>
	<row id="msg_0724_00711" index="711">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No daaalej! Dawaj,\ndawaj! Hej! Hej! Dawaj, hej!</language>
	</row>
	<row id="msg_0724_00712" index="712">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, taaak!\r</language>
	</row>
	<row id="msg_0724_00713" index="713">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, nieeee!\r</language>
	</row>
	<row id="msg_0724_00714" index="714">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje oczy są\nniezmętnione wątpliwością.\nTen mecz będzie zabawny...</language>
	</row>
	<row id="msg_0724_00715" index="715">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z głębi mojego\nserca, czekam na twój powrót.\r</language>
	</row>
	<row id="msg_0724_00716" index="716">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uff... Najzabawniejszy\nmecz. Mam nadzieję, że dasz\nmi rewanż.\r</language>
	</row>
	<row id="msg_0724_00717" index="717">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Musisz być\nnauczony, co znaczy mądrość\nwieku w walce!</language>
	</row>
	<row id="msg_0724_00718" index="718">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niech wiesz, że\nżadne dziecko nie może mieć\nnadziei mnie pokonać!\r</language>
	</row>
	<row id="msg_0724_00719" index="719">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To się nie stało!\nNiesprawiedliwe! Żądam\nrewanżu teraz!\r</language>
	</row>
	<row id="msg_0724_00720" index="720">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję się dziś\nkapryśny! Pomóż mi oderwać\nsię od tego!</language>
	</row>
	<row id="msg_0724_00721" index="721">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uff... Walka to\nidealny środek na stres!\r</language>
	</row>
	<row id="msg_0724_00722" index="722">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Eeeeeeeeh!\nPchnęłaś mnie w furię!\r</language>
	</row>
	<row id="msg_0724_00723" index="723">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Włącz muzykę walki,\nproszę! Chcę zagrać fanfary\nmojej wygranej!</language>
	</row>
	<row id="msg_0724_00724" index="724">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham muzykę walki.\nSprawia, że moje serce\nprzyspiesza.\r</language>
	</row>
	<row id="msg_0724_00725" index="725">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobrze, to zrobi.\nWracamy do normalnej\nmuzyki tematycznej.\r</language>
	</row>
	<row id="msg_0724_00726" index="726">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jesteś\ntrenerem tak długo, jak ja,\npowiedzmy tylko, że zobaczysz\nwiele.</language>
	</row>
	<row id="msg_0724_00727" index="727">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rzeczy jak ta się\nzdarzają. Nie pozwól, by to\ncię zmartwiło.\r</language>
	</row>
	<row id="msg_0724_00728" index="728">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ludzie i Pokémony są\nwszyscy różni. Czy to nie\nczyni tego pięknym?</language>
	</row>
	<row id="msg_0724_00729" index="729">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój starszy brat\npowiedział mi, by celować w\noczy! Celuj w oczy!</language>
	</row>
	<row id="msg_0724_00730" index="730">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrobiłem to,\nstarszy bracie!\r</language>
	</row>
	<row id="msg_0724_00731" index="731">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój starszy brat\npowiedział mi, by zepsuć\ncelność innego trenera!\r</language>
	</row>
	<row id="msg_0724_00732" index="732">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszę mojego\nPokémona wołającego... Wołają\no walkę...</language>
	</row>
	<row id="msg_0724_00733" index="733">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszę mojego\nPokémona wołającego... Wołają\no twój powrót...\r</language>
	</row>
	<row id="msg_0724_00734" index="734">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słyszę mojego\nPokémona wołającego...\nMówią mi o zabawie, jaką\nmieli...\r</language>
	</row>
	<row id="msg_0724_00735" index="735">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Za tobą widzę\nświatło. Co to znaczy?</language>
	</row>
	<row id="msg_0724_00736" index="736">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślałem, że widziałem\naurę niezwyciężalności.\nMusiałem się mylić.\r</language>
	</row>
	<row id="msg_0724_00737" index="737">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz widzę...\nŚwiecisz światłem zwycięstwa...\r</language>
	</row>
	<row id="msg_0724_00738" index="738">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dostarczę ci porażkę\nelegancko i szybko.</language>
	</row>
	<row id="msg_0724_00739" index="739">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję za twoją\ncierpliwość!\r</language>
	</row>
	<row id="msg_0724_00740" index="740">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest mi tak strasznie\nprzykro. Skończyłem z twoją\nzamierzoną porażką.\r</language>
	</row>
	<row id="msg_0724_00741" index="741">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Super, jeszcze\njeden twardo wyglądający\ntrener. Zabawa nigdy się dla\nmnie nie kończy.</language>
	</row>
	<row id="msg_0724_00742" index="742">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bleah, to było za\nblisko na komfort. Nic\nnigdy nie przychodzi mi\nłatwo.\r</language>
	</row>
	<row id="msg_0724_00743" index="743">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, widzisz?\nWiedziałem, że przegram.\nGdyby tylko ten ruch\ntrafił...\r</language>
	</row>
	<row id="msg_0724_00744" index="744">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Każdy ma za dużo do\npowiedzenia o Pokémonach!\nJeśli to zabawne, to\nwystarczy!</language>
	</row>
	<row id="msg_0724_00745" index="745">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam, ale\nczy wszystko w porządku?\nMoże jesteś trochę za\nzmęczony?\r</language>
	</row>
	<row id="msg_0724_00746" index="746">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zbyt dasz się\nwciągnąć w wygrywanie i\nprzegrywanie, wypalisz się.\r</language>
	</row>
	<row id="msg_0724_00747" index="747">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy nie jesteś\nnajsłodszym gościem! Możesz\noczekiwać najlepszej obsługi\node mnie!</language>
	</row>
	<row id="msg_0724_00748" index="748">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więc, byłeś pod\nwrażeniem poziomu obsługi,\njaką zapewniłem?\r</language>
	</row>
	<row id="msg_0724_00749" index="749">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och, czekaj,\nproszę! Nie skończyłem cię\nobsługiwać!\r</language>
	</row>
	<row id="msg_0724_00750" index="750">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prowadzę dziennik o\nżyciach trenerów, którzy tu\nprzybywają.</language>
	</row>
	<row id="msg_0724_00751" index="751">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W naszym ogromnym\nświecie, zastanawiam się, ile\ntrenerów przetnie moją\nścieżkę?\r</language>
	</row>
	<row id="msg_0724_00752" index="752">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Każde spotkanie\nkończy się rozstaniem. Dlatego\nprowadzę dziennik.\r</language>
	</row>
	<row id="msg_0724_00753" index="753">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekałem całe moje\nżycie na kogoś jak ty. Nigdy\ncię nie wypuszczę.</language>
	</row>
	<row id="msg_0724_00754" index="754">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To był zabieg, by\nzmylić cię słowami z jakiegoś\nfilmu romantycznego.\r</language>
	</row>
	<row id="msg_0724_00755" index="755">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz, idź dalej, nie\npozwól, żebym cię zatrzymał.\nChwyć swoją szansę na\nszczęście!\r</language>
	</row>
	<row id="msg_0724_00756" index="756">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dasz mi wywiad, jeśli\nwygrasz?</language>
	</row>
	<row id="msg_0724_00757" index="757">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uczyniłeś moją pracę\nza łatwą. Musisz się\nskoncentrować.\r</language>
	</row>
	<row id="msg_0724_00758" index="758">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje odczucia\nteraz, w jednym słowie!\nKrzyknij to do mikrofonu,\nproszę!\r</language>
	</row>
	<row id="msg_0724_00759" index="759">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem na diecie...\nJestem tak wygłodzony...</language>
	</row>
	<row id="msg_0724_00760" index="760">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem szczęśliwy,\nale jeśli się podniecę,\nbędę głodny. Nie, dzięki...\r</language>
	</row>
	<row id="msg_0724_00761" index="761">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och...\nTwoje Pokémony wyglądają\npysznie...\r</language>
	</row>
	<row id="msg_0724_00762" index="762">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyjaśnię to teraz\njasno, jestem twardszy, niż\nmożesz znieść!</language>
	</row>
	<row id="msg_0724_00763" index="763">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz?\nNie przesadzałem!\r</language>
	</row>
	<row id="msg_0724_00764" index="764">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kim ty\nwłaściwie jesteś?!\r</language>
	</row>
	<row id="msg_0724_00765" index="765">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zejdź z drogi!\nZ drogi! Czekaj! Nie idź!\nMusimy walczyć!</language>
	</row>
	<row id="msg_0724_00766" index="766">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj, przełóż bieg\nwyżej! Dotrzymaj mi kroku!\r</language>
	</row>
	<row id="msg_0724_00767" index="767">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, z drogi! Zejdź z\ndrogi! Niech ten przegrany\nucieknie!\r</language>
	</row>
	<row id="msg_0724_00768" index="768">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bezpieczna jazda i\nbezpieczniejsze walczenie.\nTo moje motto.</language>
	</row>
	<row id="msg_0724_00769" index="769">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz być\ncierpliwy w walce.\nZwycięstwo nadejdzie z\nczasem.\r</language>
	</row>
	<row id="msg_0724_00770" index="770">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będę trzymać\nswojego tempa. Dogonię cię\npewnego dnia.\r</language>
	</row>
	<row id="msg_0724_00771" index="771">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam ten Rower\ntylko, by dobrze wyglądać\nprzed chłopakami. Nie umiem\nnaprawdę jeździć.</language>
	</row>
	<row id="msg_0724_00772" index="772">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To był ból,\nżeby dostać ten Rower tutaj.\nMusiałem go pchać całą\ndrogę!\r</language>
	</row>
	<row id="msg_0724_00773" index="773">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zajmuje mnie\ntylko dobre wyglądanie. Nie\npraktykuję wystarczająco.\r</language>
	</row>
	<row id="msg_0724_00774" index="774">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie szukam\nżadnej ekscytacji. Nie\npotrzebuję żadnego dramatu.</language>
	</row>
	<row id="msg_0724_00775" index="775">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walka to cała\nekscytacja, jaka mi potrzeba.\r</language>
	</row>
	<row id="msg_0724_00776" index="776">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niedawno\nzrozumiałam, że nie jestem\nstworzona do tej strasznej\npracy.\r</language>
	</row>
	<row id="msg_0724_00777" index="777">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będę walczyć\nmoim sposobem. Ty walcz\ntwoim.</language>
	</row>
	<row id="msg_0724_00778" index="778">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ludzie to ludzie.\nPójdę swoją drogą.\r</language>
	</row>
	<row id="msg_0724_00779" index="779">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ludzie to ludzie.\nIdź swoją drogą.\r</language>
	</row>
	<row id="msg_0724_00780" index="780">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziś mam\nspecjalny poczęstunek dla\nwszystkich moich fanów!</language>
	</row>
	<row id="msg_0724_00781" index="781">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję!\nKocham wasze wsparcie!\r</language>
	</row>
	<row id="msg_0724_00782" index="782">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś naprawdę\njednym z moich fanów?\r</language>
	</row>
	<row id="msg_0724_00783" index="783">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem wypalona\nbyciem Idolką. Chcę iść do\ndomu na wieś...</language>
	</row>
	<row id="msg_0724_00784" index="784">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę teraz\nprzestać! Dzieci marzą, by\nbyć jak ja!\r</language>
	</row>
	<row id="msg_0724_00785" index="785">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tęsknię za\ngłosem mojej matki...\r</language>
	</row>
	<row id="msg_0724_00786" index="786">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem\njedyna w swoim rodzaju.\nTo właśnie mówię.</language>
	</row>
	<row id="msg_0724_00787" index="787">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem\nprawdziwa. To właśnie czyni\nmnie twardą.\r</language>
	</row>
	<row id="msg_0724_00788" index="788">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłam\nprawdziwa, ale ty i tak\nwygrałeś. Twoja prawdziwość\nbyła prawdziwsza.\r</language>
	</row>
	<row id="msg_0724_00789" index="789">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi! Jesteś\nmoim kolejnym przeciwnikiem?\nZachowajmy to czyste i\nsprawiedliwe!</language>
	</row>
	<row id="msg_0724_00790" index="790">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świetnie się\nczuje dawanie z siebie\nwszystkiego bez brudnych\nsztuczek.\r</language>
	</row>
	<row id="msg_0724_00791" index="791">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To był\nniesamowity trening! Musimy\nto zrobić znowu kiedyś!\r</language>
	</row>
	<row id="msg_0724_00792" index="792">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje potrzeby\nsą proste. Wędkowanie i\nMleko Moomoo to wszystko,\nczego potrzebuję.</language>
	</row>
	<row id="msg_0724_00793" index="793">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrana czy\nporażka nie jest czymś, czemu\nprzywiązuję uwagę.\r</language>
	</row>
	<row id="msg_0724_00794" index="794">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przydałoby się\ntrochę Mleka Moomoo właśnie\nteraz.\r</language>
	</row>
	<row id="msg_0724_00795" index="795">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty tam!\nSpójrz na Pokémona, którego\nzłowiłem innego dnia.</language>
	</row>
	<row id="msg_0724_00796" index="796">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mogę powiedzieć,\nże jesteś pod wrażeniem. Ten\ngość, nie wiem, ile zajęło\nmi go wyciągnięcie.\r</language>
	</row>
	<row id="msg_0724_00797" index="797">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słowo rady: gdy\nstarsza osoba się chwali,\nudawaj zainteresowanie.\r</language>
	</row>
	<row id="msg_0724_00798" index="798">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś trenerem.\nNiech twój Pokémon mówi za\nciebie.</language>
	</row>
	<row id="msg_0724_00799" index="799">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdzie jest twój\nduch? To do mnie wcale nie\nprzemówiło.\r</language>
	</row>
	<row id="msg_0724_00800" index="800">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Świetnie!\nŚwietnie! Twoje uczucia\nprzebiły się!\r</language>
	</row>
	<row id="msg_0724_00801" index="801">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadchodzi twoja\nofiara! Złap ją! Szarżaaa!</language>
	</row>
	<row id="msg_0724_00802" index="802">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gaahahaha!\nTo to! Dobra robota!\r</language>
	</row>
	<row id="msg_0724_00803" index="803">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegraliśmy!\nWycofajcie się, chłopaki!\nUciekajmy!\r</language>
	</row>
	<row id="msg_0724_00804" index="804">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawaj!\nOoooh! Haaah!</language>
	</row>
	<row id="msg_0724_00805" index="805">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziękuję\nserdecznie!\r</language>
	</row>
	<row id="msg_0724_00806" index="806">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki, że\nmnie zaprosiłeś!\r</language>
	</row>
	<row id="msg_0724_00807" index="807">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem\nzafascynowany górami. Są\ngłówną rzeczą w moim życiu!</language>
	</row>
	<row id="msg_0724_00808" index="808">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Góry znaczą dla\nmnie więcej niż jakakolwiek\nwalka, bez względu, jak\nzabawna!\r</language>
	</row>
	<row id="msg_0724_00809" index="809">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoje\numiejętności walki są\nimponujące, ale nie mogę się\ndoczekać, by wrócić do gór.\r</language>
	</row>
	<row id="msg_0724_00810" index="810">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zmiażdżymy\ncię, dzieciaku. Nie zamarznij\ni nie zamknij oczu.</language>
	</row>
	<row id="msg_0724_00811" index="811">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lubię, jak\npozostajesz zbuntowany, nawet\npo przegranej. Dobra postawa,\ndzieciaku.\r</language>
	</row>
	<row id="msg_0724_00812" index="812">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szczerze, nie\nodpuściłem ani odrobiny, i\nnie spuściłem gardy, bo\njesteś dzieciakiem.\r</language>
	</row>
	<row id="msg_0724_00813" index="813">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczę na\ncałym świecie. Jestem\nświatowym zuchwalcem!</language>
	</row>
	<row id="msg_0724_00814" index="814">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie przegrywam w\nwalkach. Nie mogę przestać się\nzachwycać, jak cool jestem!\r</language>
	</row>
	<row id="msg_0724_00815" index="815">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyruszam w\ndrogę po tej przegranej. To\npa-pa dla starego mnie!\r</language>
	</row>
	<row id="msg_0724_00816" index="816">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W walkach,\njestem dobry. Ale talent\nmuzyczny? Zapomnij o tym.</language>
	</row>
	<row id="msg_0724_00817" index="817">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Całe to\nwalczenie jest dobre, ale\nchciałbym, żebym mógł też\ngrać muzykę.\r</language>
	</row>
	<row id="msg_0724_00818" index="818">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muzyka czy\nPokémony... To trudny\nwybór.\r</language>
	</row>
	<row id="msg_0724_00819" index="819">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Napisałem\npiosenkę, używając krzyków\nPokémonów. Chciałbym, żebyś\njej usłyszał.</language>
	</row>
	<row id="msg_0724_00820" index="820">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Graaah wagyaaah!\nWagyaaaah! Chu! Chu!\nGyaroooh-gah!\r</language>
	</row>
	<row id="msg_0724_00821" index="821">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Giiyaaaah!\nDrundundun! Garoo-gah!\nWawawaaah!\r</language>
	</row>
	<row id="msg_0724_00822" index="822">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem\nznudzony zbieraniem i\ngromadzeniem. Pozbywam się\nwszystkiego teraz.</language>
	</row>
	<row id="msg_0724_00823" index="823">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma\nniczego, czego naprawdę teraz\nchcę. Może stanę się\nklaunem...\r</language>
	</row>
	<row id="msg_0724_00824" index="824">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oddałem ten\nmecz na początek. Przyjemnie\njest być odciążonym od\nrzeczy.\r</language>
	</row>
	<row id="msg_0724_00825" index="825">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och! Czekaj\nsekundę! Przychodzący SMS!</language>
	</row>
	<row id="msg_0724_00826" index="826">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ticka-ticka-ticka...\nTicka-tick... Hę? Już\nkoniec?\r</language>
	</row>
	<row id="msg_0724_00827" index="827">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, przestań!\nNie zaglądaj do moich SMS-ów!\r</language>
	</row>
	<row id="msg_0724_00828" index="828">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie ma\nżadnego znaczenia dla tej\nwalki! Pokémony mają być o\nmiłości!</language>
	</row>
	<row id="msg_0724_00829" index="829">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczenie\npozostawia mnie pustym.\nPrzytul swojego Pokémona i\npokaż mu swoją miłość!\r</language>
	</row>
	<row id="msg_0724_00830" index="830">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczenie\nniczego nie tworzy. Przytul\nswojego Pokémona i pokaż mu\nswoją miłość!\r</language>
	</row>
	<row id="msg_0724_00831" index="831">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyzywasz\nmnie? ...Tak. Dzieci w\ndzisiejszych czasach...</language>
	</row>
	<row id="msg_0724_00832" index="832">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Teraz pobiegnij\ndo domu i pomóż mamusi z\njej obowiązkami!\r</language>
	</row>
	<row id="msg_0724_00833" index="833">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, ty... Jeśli\nmyślisz, że czas zabawy\nbędzie trwał wiecznie, skończysz\njak ja.\r</language>
	</row>
	<row id="msg_0724_00834" index="834">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak\nskontrujesz moją\nnieugiętą logikę?</language>
	</row>
	<row id="msg_0724_00835" index="835">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wszystko\nwedług kalkulacji... To\nzwycięstwo jest kompletne.\r</language>
	</row>
	<row id="msg_0724_00836" index="836">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przekalkulowałeś\nmnie. Nie mogę w to uwierzyć.\r</language>
	</row>
	<row id="msg_0724_00837" index="837">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Byłem\nuwięziony w laboratorium.\nMoje ramiona są wszystkie\nzaplatane.</language>
	</row>
	<row id="msg_0724_00838" index="838">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co za\norzeźwiająca przerwa! Czuję\nsię swobodnie i zrelaksowany\nteraz.\r</language>
	</row>
	<row id="msg_0724_00839" index="839">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja i mój\nPokémon musimy wyjść na\ndwór i więcej się ruszać.\r</language>
	</row>
	<row id="msg_0724_00840" index="840">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmmm... Tak\nmłody... Może muszę\nodpuścić...</language>
	</row>
	<row id="msg_0724_00841" index="841">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś tak\ndepresyjnie młody... W\nporządku. Możesz iść.\r</language>
	</row>
	<row id="msg_0724_00842" index="842">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozważ\nodczucia pokonanego. To\nwłaśnie w tym wy, młodzi,\nzawodzicie...\r</language>
	</row>
	<row id="msg_0724_00843" index="843">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz\nstarego człowieka, tak? Nie\ndaj się zwieść temu, jak\nwyglądam.</language>
	</row>
	<row id="msg_0724_00844" index="844">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważam za\nwstrętne przegrać z jakimkolwiek\nmłodym trenerem.\r</language>
	</row>
	<row id="msg_0724_00845" index="845">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zostałem\nzwiedziony przez twoją\nmłodość. Głupi, głupi ja...\r</language>
	</row>
	<row id="msg_0724_00846" index="846">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jako\nRobotnik, moją pracą jest i\nbudować, i rozbierać.</language>
	</row>
	<row id="msg_0724_00847" index="847">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu nie\nstaniesz się też Robotnikiem?\nUważam to za zabawne i\nsatysfakcjonujące.\r</language>
	</row>
	<row id="msg_0724_00848" index="848">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tworzenie\nrzeczy jest trudniejsze niż\nich rozbieranie, ale jest\nbardziej satysfakcjonujące.\r</language>
	</row>
	<row id="msg_0724_00849" index="849">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ty i twój\nPokémon, wyczyszczę was z\nłatwością.</language>
	</row>
	<row id="msg_0724_00850" index="850">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No, no, jakie\nto było żałosne. Zabierz\nswoich pasażerów i idź do\ndomu.\r</language>
	</row>
	<row id="msg_0724_00851" index="851">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gwaah... Tak\nciężkie... Moi chłopaki\nugięli się pod ciężarem.\r</language>
	</row>
	<row id="msg_0724_00852" index="852">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybitna\nsprawność fizyczna i świetne\npoczucie humoru; to właśnie\nklaun!</language>
	</row>
	<row id="msg_0724_00853" index="853">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Klaun to\npraca wielkości. Tylko\nwybrani mogą się nim stać!\r</language>
	</row>
	<row id="msg_0724_00854" index="854">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdolność, by\nśmiać się z rozczarowania, to\nkolejny wymóg dla klauna!\r</language>
	</row>
	<row id="msg_0724_00855" index="855">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śmiej się\ntwarzą i płacz sercem; tak\nżyje klaun.</language>
	</row>
	<row id="msg_0724_00856" index="856">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ahahahahaha!\r</language>
	</row>
	<row id="msg_0724_00857" index="857">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gah!\n...Ahahahaha!\r</language>
	</row>
	<row id="msg_0724_00858" index="858">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oi, słuchaj!\nJestem Policjantem, jasne,\nale trenerem wcześniej!</language>
	</row>
	<row id="msg_0724_00859" index="859">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co?\nPolicjant nie może stracić\nnad sobą kontroli?\r</language>
	</row>
	<row id="msg_0724_00860" index="860">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak, jestem\nPolicjantem, ale mam marzenia\ni aspiracje, i, i...\nPociąganie...\r</language>
	</row>
	<row id="msg_0724_00861" index="861">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ręce do\ngóry! Trzymaj je tam, gdzie\nmogę je widzieć! Wszyscy\njesteście aresztowani!</language>
	</row>
	<row id="msg_0724_00862" index="862">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprawa\nzamknięta!\r</language>
	</row>
	<row id="msg_0724_00863" index="863">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest\nokrutne wypaczenie\nsprawiedliwości!\r</language>
	</row>
	<row id="msg_0724_00864" index="864">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niech wiesz,\nże jestem internetowym\ndetektywem.</language>
	</row>
	<row id="msg_0724_00865" index="865">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje moce\nobserwacji i logiki\nzwyciężyły!\r</language>
	</row>
	<row id="msg_0724_00866" index="866">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Myślisz, że\nmnie przechytrzyłeś? Może to\nbyła tylko operacja pod\nprzykrywką!\r</language>
	</row>
	<row id="msg_0724_00867" index="867">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdziekolwiek,\nkiedykolwiek, i z kimkolwiek.\nTo moje motto!</language>
	</row>
	<row id="msg_0724_00868" index="868">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kiedy, gdzie,\nczy z kim... Nie ma to dla\nmnie żadnego znaczenia.\r</language>
	</row>
	<row id="msg_0724_00869" index="869">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hahaha! To\njest świetne! Chcę to\nkontynuować!\r</language>
	</row>
	<row id="msg_0724_00870" index="870">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrany\nmusi udawać STUNKY, OK?</language>
	</row>
	<row id="msg_0724_00871" index="871">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chichot,\nprzegrywasz. Chcę zobaczyć\ntwoją imitację STUNKY!\r</language>
	</row>
	<row id="msg_0724_00872" index="872">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK, oto moja\nimitacja STUNKY! Trzy, dwa,\njeden...\r</language>
	</row>
	<row id="msg_0724_00873" index="873">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobra bryza\nnarosła... To jest dobre!\nMogę to wygrać!</language>
	</row>
	<row id="msg_0724_00874" index="874">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiatr w\nżaglach postawił nas na\nszczyt! ...Jak to mówią!\r</language>
	</row>
	<row id="msg_0724_00875" index="875">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwny\nwiatr zadziałał przeciwko\nnam! ...Jak to mówią!\r</language>
	</row>
	<row id="msg_0724_00876" index="876">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć zawsze\nmam parasolkę rozłożoną,\nnaprawdę lubię słoneczne\ndni.</language>
	</row>
	<row id="msg_0724_00877" index="877">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam\nnadzieję, że jutro będzie\nsłonecznie...\r</language>
	</row>
	<row id="msg_0724_00878" index="878">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ulewa w\nmoim sercu... Kiedy w końcu\nustanie...?\r</language>
	</row>
	<row id="msg_0724_00879" index="879">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój, jesteś\nbardzo chętny, by iść.\nLepiej podkręcę napięcie\ntakże!</language>
	</row>
	<row id="msg_0724_00880" index="880">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miałem\nmnóstwo zabawy w tym\nmeczu! Czy nie byłoby miło\nzobaczyć się znowu!\r</language>
	</row>
	<row id="msg_0724_00881" index="881">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś tak\npełen energii! Czemu, ja\nteż czuję się naenergetyzowany!\r</language>
	</row>
	<row id="msg_0724_00882" index="882">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak długo\njeszcze muszę czekać na\ntrenera, który jest\njakikolwiek dobry?</language>
	</row>
	<row id="msg_0724_00883" index="883">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem tak\nznudzony tą słabą\nkonkurencją. Może po prostu\nprzejdę na emeryturę.\r</language>
	</row>
	<row id="msg_0724_00884" index="884">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och,\nwitaj, tam. Teraz, jesteś\ntrochę specjalny.\r</language>
	</row>
	<row id="msg_0724_00885" index="885">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój\ndamski urok nie znaczy\nniczego dla małego\ndzieciaka...</language>
	</row>
	<row id="msg_0724_00886" index="886">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To było\nza bliskie na komfort! Nie\nopłaca się nie doceniać\nwrogów.\r</language>
	</row>
	<row id="msg_0724_00887" index="887">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczenie\nuczciwie i sprawiedliwie nie\nprzemawia do mnie. Wolałbym\nwygrać.\r</language>
	</row>
	<row id="msg_0724_00888" index="888">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak\nwszystko inne, ludzie mają\nupodobania i niechęci, gdy\nchodzi o zapachy.</language>
	</row>
	<row id="msg_0724_00889" index="889">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocham, jak\nPokémony pachną po walce.\r</language>
	</row>
	<row id="msg_0724_00890" index="890">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czuję\nmały dreszczyk, jeśli złowię\nzapach intensywnego wysiłku\npo walce.\r</language>
	</row>
	<row id="msg_0724_00891" index="891">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pociąg, pociąg...\nTak! Oto i ono! Moc\naromatu!</language>
	</row>
	<row id="msg_0724_00892" index="892">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z mocą\naromatu, jestem niezwyciężona!\r</language>
	</row>
	<row id="msg_0724_00893" index="893">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fizzle...\nSkończyła mi się moc\naromatu...\r</language>
	</row>
	<row id="msg_0724_00894" index="894">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obrót, krok,\nobrót, obrót... Potrenuję\nmoje kroki taneczne podczas\nwalki!</language>
	</row>
	<row id="msg_0724_00895" index="895">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tańczę z\npasją i precyzją. Jak może\nistnieć słabość?\r</language>
	</row>
	<row id="msg_0724_00896" index="896">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbijasz mnie\nz rytmu! Mój układ taneczny\njest zepsuty!\r</language>
	</row>
	<row id="msg_0724_00897" index="897">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem\nzawsze gotowa na oczy\npubliczności. Możesz podejść\nw swoim tempie.</language>
	</row>
	<row id="msg_0724_00898" index="898">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dlatego\nludzie uważają mnie za\nidealną Idolkę.\r</language>
	</row>
	<row id="msg_0724_00899" index="899">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie wiedziałam, jak\nźle czuje się przegrana. To\ndla mnie pierwszy raz.\r</language>
	</row>
