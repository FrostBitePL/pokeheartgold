	<row id="msg_0728_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Czemu...\nCzemu przegrywam?\rZebrałem najtwardsze Pokémony.\nNie zwalniałem gazu.\rWięc czemu przegrywam?\n</language>
