	<row id="msg_0728_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heh heh heh... Nie jesteś na\nto przygotowany. Powalimy cię!\n</language>
	</row>
	<row id="msg_0728_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może to ja byłem tym,\nkto był nieprzygotowany?\n</language>
	</row>
	<row id="msg_0728_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jest prawdziwa moc Johto...\n</language>
	</row>
	<row id="msg_0728_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ah ha ha! Swędzi! Swędzi!\n</language>
	</row>
	<row id="msg_0728_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oj oj oj oj oj...\n</language>
	</row>
	<row id="msg_0728_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na to, że ty jesteś\nsilniejszy...\n</language>
	</row>
	<row id="msg_0728_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm... Jesteś całkiem dobry...\n</language>
	</row>
	<row id="msg_0728_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na to, że nie jesteś\ntylko kimś, kto wchodzi w drogę...\n</language>
	</row>
	<row id="msg_0728_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na to, że to koniec...\n</language>
	</row>
	<row id="msg_0728_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To jeszcze nie koniec. Dopiero\nsię zaczyna!\n</language>
	</row>
	<row id="msg_0728_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oj, ostatni! Nigdy się nie\npoddawaj!\n</language>
	</row>
	<row id="msg_0728_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja elektryczna sztuczka...\n</language>
	</row>
	<row id="msg_0728_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie łagodź mi tego.\nDaj mi wszystko, co masz!\n</language>
	</row>
	<row id="msg_0728_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, to trochę bezwzględne!\n</language>
	</row>
	<row id="msg_0728_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na to, że cię\nnie doceniłem...\n</language>
	</row>
	<row id="msg_0728_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz świetną technikę walki!\n</language>
	</row>
	<row id="msg_0728_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niedobrze. Serio niedobrze.\n</language>
	</row>
	<row id="msg_0728_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...!!!\nTak... Tak silny!\n</language>
	</row>
	<row id="msg_0728_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co się stanie po tym?\nJuż wiem.\n</language>
	</row>
	<row id="msg_0728_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy przyszłość, którą\nwidziałem...była błędna?\n</language>
	</row>
	<row id="msg_0728_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem...\n</language>
	</row>
	<row id="msg_0728_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokażę ci ducha tej jaskiniowej\nSali!\n</language>
	</row>
	<row id="msg_0728_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wciąż możemy to zrobić!\n</language>
	</row>
	<row id="msg_0728_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój duch nie został pokonany!\n</language>
	</row>
	<row id="msg_0728_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Heh heh heh... Nie jesteś na\nto przygotowany. Powalimy cię!\n</language>
	</row>
