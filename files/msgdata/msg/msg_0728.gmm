	</row>
	<row id="msg_0728_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeszcze nie przegraliśmy!\n</language>
	</row>
	<row id="msg_0728_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie... Jeszcze...nie...\n</language>
	</row>
	<row id="msg_0728_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegra...liśmy...\n</language>
	</row>
	<row id="msg_0728_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmpf... Jesteś naprawdę niezłym\ntrenerem.\n</language>
	</row>
	<row id="msg_0728_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzba to moje drugie imię.\nWierzba jest giętka i nie łamie się łatwo.\fJeszcze się nie poddaję.\n</language>
	</row>
	<row id="msg_0728_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm. Wygląda na to, że moje\nszczęście się skończyło.\n</language>
	</row>
	<row id="msg_0728_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden Pokémon został?\nTutaj zaczyna się prawdziwa walka!\n</language>
	</row>
	<row id="msg_0728_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żartujesz, prawda?\nTo ja mam wygrać! Już zdecydowałem!\n</language>
	</row>
	<row id="msg_0728_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałem? ...\rNie wierzę w to.\nMusi być jakiś błąd...\n</language>
	</row>
	<row id="msg_0728_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiatr jest nareszcie z nami!\n</language>
	</row>
	<row id="msg_0728_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wciąż możemy latać!\n</language>
	</row>
	<row id="msg_0728_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem...\nWycofam się z godnością.\n</language>
	</row>
	<row id="msg_0728_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć to mój ostatni Pokémon,\nPokémony typu Bug są twarde!\n</language>
	</row>
	<row id="msg_0728_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzymaj się! Jeszcze tylko trochę!\n</language>
	</row>
	<row id="msg_0728_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ech, to już koniec...\n</language>
	</row>
	<row id="msg_0728_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">H-hej! Tylko jeden został?\nAle... Nie przegrywam, słyszysz?\n</language>
	</row>
	<row id="msg_0728_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biedny ja!\n</language>
	</row>
	<row id="msg_0728_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ugh...\n</language>
	</row>
	<row id="msg_0728_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie, to jeszcze nie koniec--nie\nkoniec! Wciąż wierzę, że możemy\nto zrobić!\n</language>
	</row>
	<row id="msg_0728_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy więcej dyscypliny niż\nktokolwiek inny!\n</language>
	</row>
	<row id="msg_0728_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak to możliwe...\n</language>
	</row>
	<row id="msg_0728_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Właściwie zahartowana stal nie\nzardzewieje przez takie rzeczy!\n</language>
	</row>
	<row id="msg_0728_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stal wytrzyma do samego końca!\n</language>
	</row>
	<row id="msg_0728_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dobra robota...\n</language>
	</row>
	<row id="msg_0728_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeszcze nie przegraliśmy!\n</language>
	</row>
	<row id="msg_0728_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie... Jeszcze...nie...\n</language>
	</row>
	<row id="msg_0728_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegra...liśmy...\n</language>
	</row>
	<row id="msg_0728_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmpf... Jesteś naprawdę niezłym\ntrenerem.\n</language>
	</row>
	<row id="msg_0728_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzba to moje drugie imię.\nWierzba jest giętka i nie łamie się łatwo.\fJeszcze się nie poddaję.\n</language>
	</row>
	<row id="msg_0728_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hmm. Wygląda na to, że moje\nszczęście się skończyło.\n</language>
	</row>
	<row id="msg_0728_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden Pokémon został?\nTutaj zaczyna się prawdziwa walka!\n</language>
	</row>
	<row id="msg_0728_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żartujesz, prawda?\nTo ja mam wygrać! Już zdecydowałem!\n</language>
	</row>
	<row id="msg_0728_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałem? ...\rNie wierzę w to.\nMusi być jakiś błąd...\n</language>
	</row>
	<row id="msg_0728_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ho ho!\rJesteś jakąś ważną personą? Zobaczymy,\nco się stanie, gdy cię tu\fpopchną. Myślisz, że się zatoczysz\ni upadniesz?\rLudzie tutaj trenują dzień i\nnoc, by stać się mistrzami\fptasich Pokémonów.\rDawaj!\r</language>
	</row>
	<row id="msg_0728_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gaaah!\n</language>
	</row>
	<row id="msg_0728_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umiejętności Falknera są\nprawdziwe!\rNie bądź zarozumiały!</language>
	</row>
	<row id="msg_0728_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie mogę uwierzyć, jak\nśmiesznie wysoko to jest! Ale z\ftej wysokości wiesz, jak to jest\nbyć ptasim Pokémonem!\rZobaczmy, czy jesteś wystarczająco\ndobry, by stanąć przed Falknerem!\r</language>
	</row>
	<row id="msg_0728_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To nie może być prawda!\n</language>
	</row>
	<row id="msg_0728_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć jesteś trenerem-nowicjuszem,\nte wysokości ci wcale nie\fprzeszkadzają... Jesteś naprawdę\nkimś!\n</language>
	</row>
	<row id="msg_0728_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Amy: Hej, wyzywasz Lidera?\nNie ma szans!\r</language>
	</row>
	<row id="msg_0728_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Amy: O rety!</language>
	</row>
	<row id="msg_0728_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Amy: Jesteś naprawdę silny!</language>
	</row>
	<row id="msg_0728_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Amy: Masz tylko jednego\nPokémona? To trochę samotne...</language>
	</row>
	<row id="msg_0728_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mimi: Jeśli się uprzesz,\nbędziemy twoimi przeciwnikami.\r</language>
	</row>
	<row id="msg_0728_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mimi: Czuję się trochę\nzawrócona w głowie...\n</language>
	</row>
	<row id="msg_0728_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mimi: Nasz Pokémon typu Bug\nprzegrał! Ach, co za wstyd.\n</language>
	</row>
	<row id="msg_0728_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mimi: To trochę nieuczciwe\nwalczyć z kimś, kto ma tylko\njednego Pokémona.\n</language>
	</row>
	<row id="msg_0728_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony typu Bug ewoluują\nmłodo. Więc stają się silniejsze\ndużo szybciej.\r</language>
	</row>
	<row id="msg_0728_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samo ewoluowanie to nie\nwystarczy!\n</language>
	</row>
	<row id="msg_0728_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli chcesz spotkać Lidera\nSali, musisz przesunąć sieć\nprzełącznikiem.\n</language>
	</row>
	<row id="msg_0728_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeszedłeś całą tę drogę,\nprzekraczając sieć jak Pokémon\ftypu Bug!\rPozwól, że nauczę cię, w czym\ntkwi urok Pokémonów typu Bug!\r</language>
	</row>
	<row id="msg_0728_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Udowodniłeś, jak jesteś\ntwardy...\n</language>
	</row>
	<row id="msg_0728_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Samo bycie w tej Sali sprawia,\nże czuję się, jakbym zmienił się\nw Pokémona typu Bug!\n</language>
	</row>
	<row id="msg_0728_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uratowałeś wszystkie SLOWPOKE?\nOj, jesteś mocny!\rAle moje dorosłe Pokémony są\ntakże całkiem twarde!\r</language>
	</row>
	<row id="msg_0728_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urrgggh!\n</language>
	</row>
	<row id="msg_0728_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli przesuniesz sieć\nprzełącznikiem, dowiesz się, dokąd\fjedzie winda.\n</language>
	</row>
	<row id="msg_0728_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie powinieneś spuszczać\ngardy tylko dlatego, że nie\fwyglądam na twardego!\r</language>
	</row>
	<row id="msg_0728_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O rany...\nMyślałem, że jesteś słaby...\n</language>
	</row>
	<row id="msg_0728_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co myślisz, kto jest silniejszy--\nchłopcy czy dziewczyny?\n</language>
	</row>
	<row id="msg_0728_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardziej wolę słodkie\nPokémony niż silne.\rAle mam silne i słodkie Pokémony!\r</language>
	</row>
	<row id="msg_0728_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O nie, nie, nie!\n</language>
	</row>
	<row id="msg_0728_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trenuję bardzo ciężko, by\npróbować pokonać Whitney, ale\fzaczynam się zniechęcać...\rCo robić...\nCóż... Jeśli przegram, po prostu\fnastępny raz spróbuję ciężej!\n</language>
	</row>
	<row id="msg_0728_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">O, jesteś słodkim małym\ntrenerem!\nPodobasz mi się, ale nie będę się\fpowstrzymywać!\r</language>
	</row>
	<row id="msg_0728_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zobaczmy...\nOps, już koniec?\n</language>
	</row>
	<row id="msg_0728_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wow, musisz być dobry, by\nmnie pokonać!\nTak dalej!\n</language>
	</row>
	<row id="msg_0728_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Daj z siebie wszystko, albo\ncię powalę!\r</language>
	</row>
	<row id="msg_0728_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie!\nOch, MEOWTH, tak mi przykro!\n</language>
	</row>
	<row id="msg_0728_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nauczyłam MEOWTHA ruchów na\nkażdy typ...\n</language>
	</row>
	<row id="msg_0728_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwyciężę!\r</language>
	</row>
	<row id="msg_0728_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja... Ja... Przegrałem!\n</language>
	</row>
	<row id="msg_0728_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten, kto najbardziej chce\nwygrać--wygra!\n</language>
	</row>
	<row id="msg_0728_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jesteś pewny swojej drogi?\nPokonaj mnie, jeśli chcesz podpowiedzi!\r</language>
	</row>
	<row id="msg_0728_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">C-co?\n</language>
	</row>
	<row id="msg_0728_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Masz problem ze znalezieniem\ndrogi? Ścieżka jest tuż przed\fnaszymi oczami!\n</language>
	</row>
	<row id="msg_0728_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spędziłem wiosnę z moim\nPokémonem. Potem lato, jesień i\fzimę...\rPotem znów przyszła wiosna.\nŻyliśmy razem przez długi czas.\r</language>
	</row>
	<row id="msg_0728_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygrane i porażki--doświadczyłem\nobu.\n</language>
	</row>
	<row id="msg_0728_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skąd pochodzą Pokémony?\n</language>
	</row>
	<row id="msg_0728_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czy potrafisz zadać\njakiekolwiek obrażenia naszym\fPokémonom?\r</language>
	</row>
	<row id="msg_0728_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach! Dobra robota!\n</language>
	</row>
	<row id="msg_0728_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używamy tylko Pokémonów\ntypu Ghost.\rŻaden atak typu Normal nie może\nich zranić!\n</language>
	</row>
	<row id="msg_0728_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja i moje Pokémony jesteśmy\nzwiązani przyjaźnią.\fNasza więź nigdy się nie zerwie!\r</language>
	</row>
	<row id="msg_0728_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To nie może być prawda!\n</language>
	</row>
	<row id="msg_0728_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda na to, że ty też masz\nsilną więź ze swoimi Pokémonami!\n</language>
	</row>
	<row id="msg_0728_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My, mistrzowie sztuk walki,\nniczego się nie boimy!\r</language>
	</row>
	<row id="msg_0728_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To zaskakujące!\n</language>
	</row>
	<row id="msg_0728_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémony typu Fighting boją\nsię typu Psychic...\n</language>
	</row>
	<row id="msg_0728_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słowa są bezużyteczne.\nNiech pięści mówią za ciebie!\r</language>
	</row>
	<row id="msg_0728_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...\n</language>
	</row>
	<row id="msg_0728_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegrałem!\nNie mam słów!\n</language>
	</row>
	<row id="msg_0728_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moje szalejące pięści\nrozbiją twoje Pokémony!\r</language>
	</row>
	<row id="msg_0728_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zostałem rozbity!\n</language>
	</row>
	<row id="msg_0728_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mój Pokémon przegrał...\nMoja...moja duma jest\frozbita...\n</language>
	</row>
	<row id="msg_0728_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By dotrzeć do Pryce’a, naszego\nLidera Sali, musisz myśleć,\fzanim pojedziesz na łyżwach.\r</language>
	</row>
	<row id="msg_0728_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie przegrałbym z tobą w\njeździe na łyżwach...\n</language>
	</row>
	<row id="msg_0728_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli nie jeździsz precyzyjnie,\nnie zajedziesz daleko w tej Sali.\n</language>
	</row>
	<row id="msg_0728_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zobacz mój skręt równoległy!\r</language>
	</row>
	<row id="msg_0728_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie!\nSprawiłeś, że się wywaliłem!\n</language>
	</row>
	<row id="msg_0728_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie powinienem chwalić się\nswoją jazdą na łyżwach...\n</language>
	</row>
	<row id="msg_0728_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hej, hej, czy się trzęsiesz?\nBoisz się ze mną walczyć?\r</language>
	</row>
	<row id="msg_0728_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jesteś tak silny, że to\nstraszne!\n</language>
	</row>
	<row id="msg_0728_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najsilniejsi zwykle nie\nwyglądają bardzo silnie. Myślę,\fże pasujesz do tego opisu.\n</language>
	</row>
	<row id="msg_0728_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta Sala ma śliską podłogę.\nZabawne, prawda?\rAle hej--to nie są tu żadne\nzabawy!\r</language>
	</row>
	<row id="msg_0728_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widzisz, jak bardzo jesteśmy\npoważni?\n</language>
	</row>
	<row id="msg_0728_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta Sala jest świetna.\nKocham jeździć na snowboardzie\nz moimi Pokémonami!\n</language>
	</row>
	<row id="msg_0728_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znam sekret Pryce’a.\r</language>
	</row>
	<row id="msg_0728_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">OK. Powiem ci sekret Pryce’a.\n</language>
	</row>
	<row id="msg_0728_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powód, dla którego Pryce jest\nsilny...\rTo dlatego, że każdego dnia siada\nna bardzo zimnym lodzie i trenuje\fswoje ciało i ducha!\n</language>
	</row>
	<row id="msg_0728_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja pierwsza walka ze\nsmokami?\nPokażę ci, jak są twarde!\r</language>
	</row>
	<row id="msg_0728_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To straszne.\n</language>
	</row>
	<row id="msg_0728_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spotkałeś Poskromiciela\nSmoków Lance’a?\nNie wierzę ci.\n</language>
	</row>
	<row id="msg_0728_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie tak, że wszyscy używamy\nPokémonów typu Dragon. To więcej\rniż to--\nInteresują nas silne Pokémony.\nTo mój temat!\r</language>
	</row>
	<row id="msg_0728_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tego właśnie się spodziewałem.\n</language>
	</row>
	<row id="msg_0728_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Muszę uczynić moje Pokémony\nsilniejszymi!\rPokémony i trenerzy muszą\nsię trenować!\n</language>
	</row>
	<row id="msg_0728_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moja szansa na przegranie?\nNie nawet jeden procent!\r</language>
	</row>
	<row id="msg_0728_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To dziwne.\n</language>
	</row>
	<row id="msg_0728_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znam teraz moje słabości.\nDzięki, że mi je pokazałeś!\n</language>
	</row>
	<row id="msg_0728_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trenuję ciężko z Clair.\nNie ma mowy, żebym przegrał!\r</language>
	</row>
	<row id="msg_0728_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Och, to rozczarowujące!\n</language>
	</row>
	<row id="msg_0728_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Och...\nWygląda na to, że potrzebuję\nwięcej treningu, co?\n</language>
	</row>
	<row id="msg_0728_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Smoki to święte Pokémony.\nSą pełne energii życiowej.\rJeśli nie jesteś poważny, nie\nbędziesz w stanie ich pokonać.\r</language>
	</row>
	<row id="msg_0728_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak jest!\n</language>
	</row>
	<row id="msg_0728_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Smoki są słabe przeciwko\nruchom typu Dragon.\n</language>
	</row>
	<row id="msg_0728_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My, Psychicy, nie poddajemy\nsię, nawet gdy zostajemy z\frostatnim Pokémonem.\nTo właśnie czyni nas tak groźnymi!\n</language>
	</row>
	<row id="msg_0728_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dopóki nie spadniemy do zera,\nnasza moc jest nieograniczona.\nNie poddaję się jeszcze!\n</language>
	</row>
	<row id="msg_0728_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ja... Ja nie...mogę w to\nuwierzyć...\n</language>
	</row>
	<row id="msg_0728_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden Pokémon został?\rHa ha ha! Liczyłem na tego od\nsamego początku!\n</language>
	</row>
	<row id="msg_0728_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ooooch...\n</language>
	</row>
	<row id="msg_0728_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ach!\nUdowodniłeś swoją wartość!\n</language>
	</row>
	<row id="msg_0728_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walcz tak ciężko, jak możesz,\naż zemdlejesz!\n</language>
	</row>
	<row id="msg_0728_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stoimy pewnie!\n</language>
	</row>
	<row id="msg_0728_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czemu?!\n...Jak mogliśmy przegrać?\n</language>
	</row>
	<row id="msg_0728_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To daleko od bycia wpartym\nw kąt!\n</language>
	</row>
	<row id="msg_0728_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jesteś zwykłym trenerem,\nskoro zaszedłeś tak daleko.\n</language>
	</row>
	<row id="msg_0728_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cóż, jesteś dobry.\nLubię to u trenera.\n</language>
	</row>
	<row id="msg_0728_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W porządku!\nMyślałem, że to się nigdy nie\fstanie!\n</language>
	</row>
	<row id="msg_0728_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy się nie poddaję, bez\nwzględu na wszystko. Ty też\ntaki jesteś?\n</language>
	</row>
	<row id="msg_0728_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">...Koniec.\rAle to dziwne uczucie. Nie\njestem zły, że przegrałem.\fW rzeczywistości czuję się szczęśliwy.\rSzczęśliwy, że byłem świadkiem\npowstania wielkiego nowego Czempiona!\n</language>
	</row>
	<row id="msg_0728_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">My, Psychicy, nie poddajemy\nsię, nawet gdy zostajemy z\frostatnim Pokémonem.\nTo właśnie czyni nas tak groźnymi!\n</language>
	</row>
	<row id="msg_0728_00236" index="236">
