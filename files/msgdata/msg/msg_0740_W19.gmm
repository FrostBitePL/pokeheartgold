<?xml version="1.0"?>
<body language="English">
	<row id="msg_0740_W19_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Usunąłem głaz, który był na drodze,\nale może jeszcze trochę potrwać,\fzanim wyrównam teren...</language>
	</row>
	<row id="msg_0740_W19_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Roboty drogowe wreszcie się\nskończyły.\rTeraz mogę znowu wędkować.</language>
	</row>
	<row id="msg_0740_W19_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przepraszam. Ta droga jest zamknięta\nz powodu prac budowlanych.\rJeśli chcesz dostać się do Cinnabar,\nlepiej idź na południe od Pallet Town.</language>
	</row>
	<row id="msg_0740_W19_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jestem cały spocony.\nCzas popływać!</language>
	</row>
	<row id="msg_0740_W19_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trasa 19 Fuchsia City do\nSeafoam Islands</language>
	</row>
	<row id="msg_0740_W19_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co to za ogłoszenie?\rProszę zachować ostrożność podczas\npływania do Seafoam Islands.\fPolicja z Fuchsia</language>
	</row>
</body>
