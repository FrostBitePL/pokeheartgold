<?xml version="1.0"?>
<body language="English">
	<row id="msg_0741_W19R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plaża prowadząca na Trasę 19 jest\nzamknięta na czas nieokreślony\fz powodu erupcji wulkanu Cinnabar.\rCiekawe, czy mieszkańcy Cinnabar\nsą bezpieczni...</language>
	</row>
	<row id="msg_0741_W19R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tak się cieszę, że słyszę, że żaden\nmieszkaniec Cinnabar nie został ranny\fw wyniku erupcji!</language>
	</row>
</body>
