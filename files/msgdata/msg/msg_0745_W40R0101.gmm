<?xml version="1.0"?>
<body language="English">
	<row id="msg_0745_W40R0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co? Jestem pierwszy!\rWkrótce będzie tu Battle Frontier.\rStoję w kolejce, żeby być tam\npierwszym. Nie spałem od kilku dni.\rStań w kolejce, jeśli chcesz być\ndrugi!\r</language>
	</row>
	<row id="msg_0745_W40R0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzz...\n...\rStoi...ale śpi!\r</language>
	</row>
	<row id="msg_0745_W40R0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zzz... Zzz...\n...\rNie wygląda na to, żeby miał się\nwkrótce obudzić!</language>
	</row>
	<row id="msg_0745_W40R0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To wejście do Battle Frontier.\fNie powinieneś/aś tu stać\fw kolejce.</language>
	</row>
	<row id="msg_0745_W40R0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Battle Frontier jest otwarte!\rProszę, przejdź dalej.</language>
	</row>
</body>
