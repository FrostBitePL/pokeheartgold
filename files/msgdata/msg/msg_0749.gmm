<?xml version="1.0"?>
<body language="English">
	<row id="msg_0749_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">\n\n\n\n</language>
	</row>
	<row id="msg_0749_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest fizycznie\nokładany długim ogonem\nlub przednią łapą itp.\n</language>
	</row>
	<row id="msg_0749_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\nostrym ciosem karate.\nMa wysoką szansę na\ntrafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest okładany\nna zmianę raz za razem,\nod dwóch do pięciu razy\nz rzędu.</language>
	</row>
	<row id="msg_0749_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest zasypywany\ngradem ciosów, które\ntrafiają od dwóch do\npięciu razy z rzędu.</language>
	</row>
	<row id="msg_0749_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik dostaje cios\npięścią rzuconą z pełną\nsiłą mięśni.\n</language>
	</row>
	<row id="msg_0749_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W przeciwnika rzucane są\nliczne monety, zadając\nobrażenia. Po walce\nzarabiane są pieniądze.</language>
	</row>
	<row id="msg_0749_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik dostaje cios\npłonącą pięścią.\nMoże zostawić celowi\npoparzenie.</language>
	</row>
	<row id="msg_0749_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik dostaje cios\nlodowatą pięścią.\nMoże zostawić cel\nzamrożony.</language>
	</row>
	<row id="msg_0749_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik dostaje cios\nnaładowaną elektrycznie\npięścią. Może zostawić\ncel sparaliżowany.</language>
	</row>
	<row id="msg_0749_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twarde, ostro zakończone\npazury rozdrapują\nprzeciwnika, zadając\nobrażenia.\n</language>
	</row>
	<row id="msg_0749_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ogromne, imponujące\nszczypce chwytają\ni ściskają\nprzeciwnika.\n</language>
	</row>
	<row id="msg_0749_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brutalny, rozrywający\natak szczypcami.\nPrzeciwnik zemdleje\nnatychmiast, jeśli\natak trafi.</language>
	</row>
	<row id="msg_0749_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak trwający dwie tury.\nOstrza wiatru trafiają\nprzeciwnika w drugiej\nturze. Ma wysoką szansę\nna trafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frenetyczny taniec\npodnoszący ducha walki.\nOstro podnosi Atak\nużytkownika.</language>
	</row>
	<row id="msg_0749_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest cięty\nkosą lub pazurem.\nMoże też być użyty do\nścinania cienkich\ndrzew.</language>
	</row>
	<row id="msg_0749_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podmuch wiatru wzbity\nskrzydłami trafia w\nprzeciwnika, zadając\nobrażenia.\n</language>
	</row>
	<row id="msg_0749_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest uderzany\nszeroko rozłożonymi,\nimponującymi skrzydłami,\nzadając obrażenia.\n</language>
	</row>
	<row id="msg_0749_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik zostaje\nzdmuchnięty i zastąpiony\ninnym Pokémonem z\ndrużyny. W walce z\ndzikim Pokémonem walka się kończy.</language>
	</row>
	<row id="msg_0749_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wzbija się\nw powietrze, po czym\natakuje w drugiej turze.\nMożna go też użyć do\nlotu do znanych miejsc.</language>
	</row>
	<row id="msg_0749_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Długie ciało lub macki\nsą użyte do związania\ni ściskania przeciwnika\nprzez dwie do pięciu\ntur.</language>
	</row>
	<row id="msg_0749_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest okładany\ndługim ogonem, pnączami\nitp., zadając\nobrażenia.\n</language>
	</row>
	<row id="msg_0749_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest smagany\ncienkimi, biczującymi\npnączami, zadając\nobrażenia.\n</language>
	</row>
	<row id="msg_0749_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest tratowany\ndużą stopą.\nMoże też sprawić, że\ncel się wzdrygnie.\n</language>
	</row>
	<row id="msg_0749_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest szybko\nkopany dwukrotnie z\nrzędu obiema stopami.\n</language>
	</row>
	<row id="msg_0749_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\nkopnięciem rzuconym z\npełną siłą mięśni.\n</language>
	</row>
	<row id="msg_0749_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wyskakuje\nwysoko w górę, po czym\nuderza kopnięciem. Jeśli\nkopnięcie chybi,\nużytkownik rani samego siebie.</language>
	</row>
	<row id="msg_0749_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zadaje\nszybkie, wirujące\nkopnięcie. Może też\nsprawić, że cel się\nwzdrygnie.</language>
	</row>
	<row id="msg_0749_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piasek jest rzucany w\ntwarz przeciwnika,\nobniżając jego\ncelność.\n</language>
	</row>
	<row id="msg_0749_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\ngłową. Może sprawić, że\nprzeciwnik się wzdrygnie.\nBy znaleźć Pokémony,\nuderzaj w drzewa.</language>
	</row>
	<row id="msg_0749_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest kłuty\nostro zakończonym\nrogiem, zadając\nobrażenia.\n</language>
	</row>
	<row id="msg_0749_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest kłuty\nrogiem lub dziobem od\ndwóch do pięciu razy\nz rzędu.\n</language>
	</row>
	<row id="msg_0749_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest przebijany\nrogiem obracającym się\njak wiertło.\nPrzeciwnik mdleje\nnatychmiast, jeśli atak trafi.</language>
	</row>
	<row id="msg_0749_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak fizyczny, w którym\nużytkownik szarżuje i\nwbija się w przeciwnika\ncałym swoim\nciałem.</language>
	</row>
	<row id="msg_0749_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik spada na\nprzeciwnika całym\nciężarem ciała.\nMoże zostawić\nprzeciwnika sparaliżowanego.</language>
	</row>
	<row id="msg_0749_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Długie ciało lub pnącza\nsą użyte do owinięcia\ni ściskania przeciwnika\nprzez dwie do pięciu\ntur.</language>
	</row>
	<row id="msg_0749_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brawurowy atak całym\nciałem polegający na\nwbiciu się w przeciwnika.\nRani też lekko\nużytkownika.</language>
	</row>
	<row id="msg_0749_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik szaleje i\natakuje przez dwie do\ntrzech tur. Potem\njednak zostaje\nsplątany.</language>
	</row>
	<row id="msg_0749_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brawurowy szarżujący\natak, ryzykujący życiem.\nRani też użytkownika w\ndość dużym\nstopniu.</language>
	</row>
	<row id="msg_0749_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uroczo\nmerda ogonem, sprawiając,\nże przeciwnik jest mniej\nostrożny. Obniża\nObronę celu.</language>
	</row>
	<row id="msg_0749_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest kłuty\njakimś jadowitym\nkolcem.\nMoże też zatruć\ncel.</language>
	</row>
	<row id="msg_0749_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest dwukrotnie\nkłuty parą żądeł.\nMoże też zatruć\ncel.</language>
	</row>
	<row id="msg_0749_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostre kolce są wystrzeliwane\nw przeciwnika w szybkim\ntempie.\nTrafiają od dwóch do\npięciu razy z rzędu.</language>
	</row>
	<row id="msg_0749_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik dostaje\nzastraszające spojrzenie\nostrych oczu.\nObniża to Obronę\ncelu.</language>
	</row>
	<row id="msg_0749_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest gryziony\nostro zakończonymi\nkłami. Może sprawić,\nże cel się\nwzdrygnie.</language>
	</row>
	<row id="msg_0749_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik warczy w\nujmujący sposób, sprawiając,\nże przeciwnik jest mniej\nostrożny. Obniża Atak\ncelu.</language>
	</row>
	<row id="msg_0749_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik zostaje\nprzestraszony i zastąpiony\ninnym Pokémonem z\ndrużyny. W walce z\ndzikim Pokémonem walka się kończy.</language>
	</row>
	<row id="msg_0749_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kojąca kołysanka jest\nśpiewana uspokajającym\ngłosem, wprowadzając\nprzeciwnika w głęboki\nsen.</language>
	</row>
	<row id="msg_0749_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik generuje\ndziwne fale dźwiękowe\nze swojego ciała.\nMoże wprowadzić cel\nw splątanie.</language>
	</row>
	<row id="msg_0749_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest trafiany\nniszczycielską falą\nuderzeniową, która zawsze\nzadaje 20 punktów\nobrażeń.</language>
	</row>
	<row id="msg_0749_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przez kilka tur ten\nruch uniemożliwia\nprzeciwnikowi użycie\nruchu, którego użył\nostatnio.</language>
	</row>
	<row id="msg_0749_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\nsprayem żrącego kwasu.\nMoże też obniżyć\nObronę Specjalną\ncelu.</language>
	</row>
	<row id="msg_0749_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\nmałymi płomieniami.\nCel może też zostać\npoparzony.\n</language>
	</row>
	<row id="msg_0749_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest osmalany\nintensywnym wybuchem\nognia. Cel może też\nzostać\npoparzony.</language>
	</row>
	<row id="msg_0749_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik otula swoje\nciało białą mgłą, która\nprzez pięć tur zapobiega\nobniżeniu\nwszystkich jego statystyk.</language>
	</row>
	<row id="msg_0749_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nobezwładniany silnym\nstrumieniem wody.\n\n</language>
	</row>
	<row id="msg_0749_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nobezwładniany ogromną\nilością wody wystrzelonej\npod wielkim\nciśnieniem.\n</language>
	</row>
	<row id="msg_0749_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zalewa całe pole walki\nolbrzymią falą.\nMoże też być użyty do\nprzeprawy przez wodę.\n</language>
	</row>
	<row id="msg_0749_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest trafiany\nlodowato zimną wiązką\nenergii. Może też\ncałkowicie zamrozić\ncel.</language>
	</row>
	<row id="msg_0749_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyjąca zamieć jest\nprzyzywana, by uderzyć\nprzeciwnika.\nMoże też całkowicie\nzamrozić cel.</language>
	</row>
	<row id="msg_0749_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\ndziwnym promieniem.\nMoże też wprowadzić\ncel w splątanie.\n</language>
	</row>
	<row id="msg_0749_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strumień baniek jest\ngwałtownie wystrzeliwany\nw przeciwnika.\nMoże też obniżyć\nSzybkość celu.</language>
	</row>
	<row id="msg_0749_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest trafiany\ntęczową wiązką.\nMoże też obniżyć\nAtak\ncelu.</language>
	</row>
	<row id="msg_0749_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\npotężną wiązką.\nUżytkownik musi\nodpocząć w następnej\nturze, by odzyskać energię.</language>
	</row>
	<row id="msg_0749_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest kłuty\nostro zakończonym\ndziobem lub rogiem.\n</language>
	</row>
	<row id="msg_0749_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wirujący atak z ostrym\ndziobem działającym\njak wiertło.\n</language>
	</row>
	<row id="msg_0749_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik chwyta\nprzeciwnika i brawurowo\nnurkuje ku ziemi.\nRani też lekko\nużytkownika.</language>
	</row>
	<row id="msg_0749_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potężne niskie kopnięcie,\nktóre przewraca\nprzeciwnika. Zadaje\nwiększe obrażenia\ncięższym przeciwnikom.</language>
	</row>
	<row id="msg_0749_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruch odwetowy, który\nkontruje każdy atak\nfizyczny, zadając\npodwójne obrażenia.</language>
	</row>
	<row id="msg_0749_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest rzucany\nsiłą grawitacji.\nZadaje obrażenia równe\npoziomowi\nużytkownika.</language>
	</row>
	<row id="msg_0749_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik dostaje cios\npięścią rzuconą z\nmaksymalną siłą.\nMożna go też użyć do\nprzesuwania głazów.</language>
	</row>
	<row id="msg_0749_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak wysysający\nsubstancje odżywcze.\nHP użytkownika jest\nprzywracane o połowę\nobrażeń zadanych celowi.</language>
	</row>
	<row id="msg_0749_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak wysysający\nsubstancje odżywcze.\nHP użytkownika jest\nprzywracane o połowę\nobrażeń zadanych celowi.</language>
	</row>
	<row id="msg_0749_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na przeciwniku sadzone\njest nasiono. Wysysa\nono trochę HP przeciwnika,\nby leczyć użytkownika\nw każdej turze.</language>
	</row>
	<row id="msg_0749_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ciało użytkownika\nzmuszone jest urosnąć\nnaraz. Podnosi to\nAtak Specjalny.\n</language>
	</row>
	<row id="msg_0749_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostro zakończone liście\nsą wystrzeliwane, by\nciąć przeciwnika. Ma\nwysoką szansę na\ntrafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak trwający dwie tury.\nUżytkownik gromadzi\nświatło, po czym\nwystrzeliwuje skupioną\nwiązkę w drugiej turze.</language>
	</row>
	<row id="msg_0749_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chmura trującego pyłu\njest rozsypywana na\nprzeciwniku.\nMoże zatruć\ncel.</language>
	</row>
	<row id="msg_0749_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rozsypuje\nchmurę paraliżującego\npyłku.\nMoże sparaliżować\ncel.</language>
	</row>
	<row id="msg_0749_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rozsypuje\nwielką chmurę usypiającego\npyłu wokół\nprzeciwnika.\n</language>
	</row>
	<row id="msg_0749_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje,\nrozsypując płatki przez\ndwie do trzech tur.\nPotem użytkownik\nzostaje splątany.</language>
	</row>
	<row id="msg_0749_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest wiązany\njedwabiem wydmuchiwanym\nz ust użytkownika.\nObniża to Szybkość\ncelu.</language>
	</row>
	<row id="msg_0749_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest trafiany\nfalą uderzeniową.\nTen atak zawsze zadaje\n40 punktów\nobrażeń.</language>
	</row>
	<row id="msg_0749_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik zostaje\nuwięziony w gwałtownym\nwirze ognia, który\nszaleje przez dwie do\npięciu tur.</language>
	</row>
	<row id="msg_0749_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyładowanie elektryczności\njest rzucane w przeciwnika,\nzadając obrażenia.\nMoże też zostawić\nprzeciwnika sparaliżowanego.</language>
	</row>
	<row id="msg_0749_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Silne wyładowanie\nelektryczne jest\nuwalniane na przeciwnika.\nMoże też zostawić\nprzeciwnika sparaliżowanego.</language>
	</row>
	<row id="msg_0749_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słaby ładunek elektryczny\njest wystrzeliwany w\nprzeciwnika.\nJeśli trafi, powoduje\nparaliż.</language>
	</row>
	<row id="msg_0749_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Groźny piorun spada\nna przeciwnika, zadając\nobrażenia. Może też\nzostawić cel\nsparaliżowany.</language>
	</row>
	<row id="msg_0749_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik podnosi i\nrzuca w przeciwnika\nmałym kamieniem, by\nzaatakować.\n</language>
	</row>
	<row id="msg_0749_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wywołuje\ntrzęsienie ziemi, które\ntrafia wszystkie Pokémony\nw walce.\n</language>
	</row>
	<row id="msg_0749_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik otwiera\nszczelinę w ziemi i\nwrzuca do niej przeciwnika.\nCel mdleje natychmiast,\njeśli atak trafi.</language>
	</row>
	<row id="msg_0749_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zakopuje się,\npo czym atakuje w\ndrugiej turze.\nMożna go też użyć do\nwyjścia z lochów.</language>
	</row>
	<row id="msg_0749_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruch, który pozostawia\ncel poważnie zatruty.\nObrażenia od trucizny\npogarszają się z\nkażdą turą.</language>
	</row>
	<row id="msg_0749_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest trafiany\nsłabą siłą telekinetyczną.\nMoże też wprowadzić\nprzeciwnika w\nsplątanie.</language>
	</row>
	<row id="msg_0749_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest trafiany\nsilną siłą telekinetyczną.\nMoże też obniżyć\nObronę Specjalną\nprzeciwnika.</language>
	</row>
	<row id="msg_0749_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik stosuje\nhipnotyczną sugestię, by\nwprowadzić cel w\ngłęboki sen.\n</language>
	</row>
	<row id="msg_0749_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik medytuje,\nby obudzić moc głęboko\nukrytą w swoim ciele\ni podnieść swój\nAtak.</language>
	</row>
	<row id="msg_0749_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rozluźnia\nsię i odchudza swoje\nciało, by poruszać się\nszybciej.\nOstro podnosi Szybkość.</language>
	</row>
	<row id="msg_0749_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rusza na\nprzeciwnika z prędkością,\nktóra czyni go niemal\nniewidzialnym. Zawsze\natakuje jako pierwszy.</language>
	</row>
	<row id="msg_0749_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy ten ruch jest\nużywany, zyskuje siłę\nataku za każdym razem,\ngdy użytkownik zostaje\ntrafiony w walce.</language>
	</row>
	<row id="msg_0749_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użyj go, by uciec przed\ndowolnym dzikim Pokémonem.\nMoże też przenieść do\nostatnio odwiedzonego\nCentrum Pokémon.</language>
	</row>
	<row id="msg_0749_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik sprawia, że\nprzeciwnik widzi\nmiraż. Zadaje obrażenia\nrówne poziomowi\nużytkownika.</language>
	</row>
	<row id="msg_0749_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik kopiuje\nruch, którego ostatnio\nużył przeciwnik. Ruch\nmożna używać do\nkońca walki.</language>
	</row>
	<row id="msg_0749_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ogłuszający zgrzyt jest\nwydawany, by ostro\nobniżyć Obronę\nprzeciwnika.\n</language>
	</row>
	<row id="msg_0749_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poruszając się szybko,\nużytkownik tworzy złudne\nkopie samego siebie, by\npodnieść swój\nunik.\n</language>
	</row>
	<row id="msg_0749_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruch samoleczący.\nUżytkownik przywraca\nsobie HP o maksymalnie\npołowę swojego\nmaksymalnego HP.\n</language>
	</row>
	<row id="msg_0749_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik napina\nwszystkie mięśnie ciała,\nby podnieść swoją\nObronę.\n</language>
	</row>
	<row id="msg_0749_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik ściska swoje\nciało, by wyglądać na\nmniejsze.\nPodnosi to unik\nużytkownika.</language>
	</row>
	<row id="msg_0749_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\nzasłaniającą chmurę\ndymu lub atramentu.\nObniża to celność\nprzeciwnika.</language>
	</row>
	<row id="msg_0749_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest wystawiony\nna złowieszczy promień,\nktóry wywołuje\nsplątanie.\n</language>
	</row>
	<row id="msg_0749_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik chowa swoje\nciało w twardej skorupie,\npodnosząc swoją\nObronę.\n</language>
	</row>
	<row id="msg_0749_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zwija się,\nby ukryć słabe punkty i\npodnieść swoją\nObronę.\n</language>
	</row>
	<row id="msg_0749_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wznosi\nwytrzymałą ścianę, która\nostro podnosi jego\nObronę.\n</language>
	</row>
	<row id="msg_0749_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cudowna ściana światła\njest wznoszona, by przez\npięć tur tłumić obrażenia\nod ataków\nspecjalnych.</language>
	</row>
	<row id="msg_0749_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tworzy mgłę,\nktóra eliminuje wszystkie\nzmiany statystyk u\nwszystkich Pokémonów\nbiorących udział w walce.</language>
	</row>
	<row id="msg_0749_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cudowna ściana światła\njest wznoszona, by przez\npięć tur tłumić obrażenia\nod ataków\nfizycznych.</language>
	</row>
	<row id="msg_0749_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik bierze\ngłęboki oddech i skupia\nsię, by podnieść szansę\nna trafienia\nkrytyczne.</language>
	</row>
	<row id="msg_0749_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik znosi ataki\nprzez dwie tury, po czym\nkontruje, zadając\npodwójne otrzymane\nobrażenia.</language>
	</row>
	<row id="msg_0749_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik porusza\npalcem i pobudza mózg\ndo losowego użycia\nniemal dowolnego\nruchu.</language>
	</row>
	<row id="msg_0749_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik kontruje\nprzeciwnika, naśladując\nruch, którego ostatnio\nużył\nprzeciwnik.</language>
	</row>
	<row id="msg_0749_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik eksploduje,\nzadając obrażenia\nwszystkim Pokémonom\nw walce. Użytkownik\nmdleje po użyciu tego ruchu.</language>
	</row>
	<row id="msg_0749_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Duże jajko jest rzucane\nz maksymalną siłą w\nprzeciwnika, zadając\nobrażenia.\n</language>
	</row>
	<row id="msg_0749_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest lizany\ndługim językiem, co\nzadaje obrażenia.\nMoże też sparaliżować\ncel.</language>
	</row>
	<row id="msg_0749_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\nwyładowaniem cuchnących\ngazów.\nMoże też zatruć\ncel.</language>
	</row>
	<row id="msg_0749_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieczyste błoto jest\nrzucane w przeciwnika.\nMoże też zatruć\ncel.\n</language>
	</row>
	<row id="msg_0749_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik okłada\nprzeciwnika kością.\nMoże też sprawić, że\ncel się wzdrygnie.\n</language>
	</row>
	<row id="msg_0749_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\nintensywnym wybuchem\nwszechpochłaniającego\nognia. Może też zostawić\ncel poparzony.</language>
	</row>
	<row id="msg_0749_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik szarżuje na\nprzeciwnika szybko i\nmoże sprawić, że się\nwzdrygnie. Może też\nzostać użyty do wspinaczki na wodospad.</language>
	</row>
	<row id="msg_0749_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest zaciskany\ni ściskany przez bardzo\ngrubą i wytrzymałą\nskorupę użytkownika\nprzez dwie do pięciu tur.</language>
	</row>
	<row id="msg_0749_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Promienie w kształcie\ngwiazd są wystrzeliwane\nw przeciwnika.\nTen atak nigdy nie\nchybia.\n</language>
	</row>
	<row id="msg_0749_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wciąga głowę,\nby podnieść Obronę w\npierwszej turze, a\npotem uderza przeciwnika\nw następnej turze.</language>
	</row>
	<row id="msg_0749_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostre kolce są\nwystrzeliwane w przeciwnika,\ntrafiając od dwóch do\npięciu razy w szybkim\ntempie.</language>
	</row>
	<row id="msg_0749_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\ndługimi, pełzającymi\nmackami lub pnączami.\nMoże też obniżyć\nSzybkość celu.</language>
	</row>
	<row id="msg_0749_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik na chwilę\nopróżnia umysł, by\nzapomnieć o troskach.\nOstro podnosi Obronę\nSpecjalną użytkownika.</language>
	</row>
	<row id="msg_0749_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rozprasza\nprzeciwnika, wyginając\nłyżkę.\nMoże obniżyć celność\ncelu.</language>
	</row>
	<row id="msg_0749_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przywraca\nsobie HP o maksymalnie\npołowę swojego\nmaksymalnego HP. Może\nteż uleczyć HP sojusznika.</language>
	</row>
	<row id="msg_0749_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\nkopnięciem kolanem z\nwyskoku. Jeśli chybi,\nużytkownik zostaje\nzraniony zamiast celu.</language>
	</row>
	<row id="msg_0749_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zastrasza\nprzeciwnika wzorem na\nbrzuchu, wywołując\nparaliż.\n</language>
	</row>
	<row id="msg_0749_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, który działa\ntylko na śpiącym\nprzeciwniku. Wysysa\npołowę zadanych obrażeń,\nby uleczyć HP użytkownika.</language>
	</row>
	<row id="msg_0749_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chmura trującego gazu\njest rozpylana w twarz\nprzeciwnika.\nMoże zatruć\ncel.</language>
	</row>
	<row id="msg_0749_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Okrągłe przedmioty są\nrzucane w przeciwnika,\ntrafiając od dwóch do\npięciu razy z\nrzędu.</language>
	</row>
	<row id="msg_0749_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak wysysający krew.\nHP użytkownika jest\nprzywracane o połowę\nobrażeń zadanych\ncelowi.</language>
	</row>
	<row id="msg_0749_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ze straszną miną\nużytkownik próbuje\nzmusić przeciwnika do\npocałunku. Jeśli mu\nsię uda, cel zasypia.</language>
	</row>
	<row id="msg_0749_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak wykonywany w\ndrugiej turze, o wysokiej\nszansie na trafienie\nkrytyczne. Może też\nsprawić, że cel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przekształca\nsię w kopię przeciwnika,\naż po ten sam zestaw\nruchów.\n</language>
	</row>
	<row id="msg_0749_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strumień niezliczonych\nbaniek jest wystrzeliwany\nw przeciwnika.\nMoże też obniżyć\nSzybkość celu.</language>
	</row>
	<row id="msg_0749_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest trafiany\nrytmicznie wyrzucanymi\nciosami, które mogą też\nwprowadzić go w\nsplątanie.\n</language>
	</row>
	<row id="msg_0749_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rozsypuje\nwybuchy zarodników,\nktóre wywołują sen.\n\n</language>
	</row>
	<row id="msg_0749_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik błyska\nświatłem, które obniża\ncelność przeciwnika.\nMoże też być użyty do\noświetlania jaskiń.</language>
	</row>
	<row id="msg_0749_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\ndziwną, gorącą falą\nenergii.\nSiła ataku jest\nzmienna.</language>
	</row>
	<row id="msg_0749_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik po prostu\npluska się bez żadnego\nefektu...\n\n</language>
	</row>
	<row id="msg_0749_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zmienia swoją\nstrukturę komórkową,\nby się upłynnić, ostro\npodnosząc swoją\nObronę.</language>
	</row>
	<row id="msg_0749_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest okładany\ndużymi szczypcami.\nTen ruch ma wysoką\nszansę na trafienie\nkrytyczne.\n</language>
	</row>
	<row id="msg_0749_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik eksploduje,\nzadając obrażenia\nwszystkim Pokémonom\nw walce. Użytkownik\nmdleje po użyciu tego ruchu.</language>
	</row>
	<row id="msg_0749_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nrozdrapywany ostrymi\npazurami lub kosami od\ndwóch do pięciu razy w\nszybkim tempie.</language>
	</row>
	<row id="msg_0749_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rzuca\ntrzymaną kością. Kość\nokrąża i trafia\nprzeciwnika dwukrotnie,\nw obie strony.</language>
	</row>
	<row id="msg_0749_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zasypia na\ndwie tury.\nCałkowicie przywraca\nHP użytkownika i leczy\nwszelkie problemy statusowe.</language>
	</row>
	<row id="msg_0749_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Duże głazy są rzucane\nw przeciwnika, zadając\nobrażenia.\nMoże też sprawić, że\ncel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gryzie mocno\nprzeciwnika ostrymi\nprzednimi kłami.\nMoże też sprawić, że\ncel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zmniejsza\nliczbę swoich poligonów,\nby wyglądać bardziej\nkanciasto, podnosząc\nswój Atak.</language>
	</row>
	<row id="msg_0749_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zmienia swój\ntyp, by stał się taki\nsam jak typ jednego z\njego ruchów.\n</language>
	</row>
	<row id="msg_0749_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uderza\njednoczesnym atakiem\ntrzech wiązek. Może też\nsparaliżować, poparzyć\nlub zamrozić cel.</language>
	</row>
	<row id="msg_0749_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gryzie\nmocno przeciwnika\nostrymi przednimi\nkłami. Ucina HP celu\ndo połowy.</language>
	</row>
	<row id="msg_0749_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest atakowany\ncięciem pazurów itp.\nMa wysoką szansę na\ntrafienie krytyczne.\n</language>
	</row>
	<row id="msg_0749_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tworzy swoją\nkopię, wykorzystując\nczęść swojego HP.\nKopia służy jako wabik\nużytkownika.</language>
	</row>
	<row id="msg_0749_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak używany w\ndesperacji tylko wtedy,\ngdy użytkownikowi\nzabraknie PP. Rani też\nlekko użytkownika.</language>
	</row>
	<row id="msg_0749_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umożliwia użytkownikowi\nnauczenie się na stałe\nruchu, którego ostatnio\nużył przeciwnik. Po\nużyciu Szkic znika.</language>
	</row>
	<row id="msg_0749_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzy kolejne kopnięcia,\nktóre stają się\nsilniejsze z każdym\nkolejnym\ntrafieniem.</language>
	</row>
	<row id="msg_0749_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje i\njednocześnie kradnie\ntrzymany przedmiot\nprzeciwnika. Nie może\nkraść, jeśli sam trzyma przedmiot.</language>
	</row>
	<row id="msg_0749_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik oplata\nprzeciwnika cienkim,\nlepkim jedwabiem, by\nnie mógł uciec z\nwalki.\n</language>
	</row>
	<row id="msg_0749_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wyczuwa\nruchy przeciwnika swoim\numysłem, by upewnić się,\nże jego następny atak\nnie chybi.</language>
	</row>
	<row id="msg_0749_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śpiącemu przeciwnikowi\npokazywany jest koszmar,\nktóry zadaje trochę\nobrażeń w każdej\nturze.\n</language>
	</row>
	<row id="msg_0749_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik otula się\nogniem i szarżuje na\nprzeciwnika. Może też\nzostawić cel\npoparzony.</language>
	</row>
	<row id="msg_0749_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, którego można\nużyć tylko wtedy, gdy\nużytkownik śpi. Ostry\nhałas może też sprawić,\nże przeciwnik się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruch, który działa\ninaczej na typ Ghost\nniż na wszystkie\ninne typy.\n</language>
	</row>
	<row id="msg_0749_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik miota się\nbezładnie, by zaatakować.\nStaje się silniejszy,\nim mniej HP ma\nużytkownik.</language>
	</row>
	<row id="msg_0749_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zmienia swój\ntyp, by stać się\nodpornym na typ ataku,\nktóry ostatnio\notrzymał.</language>
	</row>
	<row id="msg_0749_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wir powietrza jest\nwystrzeliwany w\nprzeciwnika, zadając\nobrażenia. Ma wysoką\nszansę na trafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\nzarodniki przypominające\nwatę, które przywierają\ndo przeciwnika, ostro\nobniżając jego Szybkość.</language>
	</row>
	<row id="msg_0749_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Totalny atak, który\nstaje się silniejszy,\nim mniej HP ma\nużytkownik.\n</language>
	</row>
	<row id="msg_0749_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wyładowuje\nurazę na ruchu, którego\nostatnio użył przeciwnik,\nodejmując mu 4\nPP.</language>
	</row>
	<row id="msg_0749_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nmroźnym podmuchem\nsypkiego śniegu.\nMoże też zamrozić\ncel.</language>
	</row>
	<row id="msg_0749_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umożliwia użytkownikowi\nunikanie wszystkich\nataków. Szansa na\nniepowodzenie rośnie\nprzy kolejnym użyciu.</language>
	</row>
	<row id="msg_0749_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rzuca cios\nz oślepiającą\nprędkością.\nZawsze atakuje jako\npierwszy.</language>
	</row>
	<row id="msg_0749_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik straszy\nprzeciwnika przerażającą\nminą, ostro obniżając\njego Szybkość.\n</language>
	</row>
	<row id="msg_0749_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik podchodzi\nrozbrajająco do przeciwnika,\npo czym zadaje\npodstępny cios.\nTrafia bez pudła.</language>
	</row>
	<row id="msg_0749_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik całuje\nprzeciwnika ze słodką,\nanielską uroczością,\nco wywołuje\nsplątanie.\n</language>
	</row>
	<row id="msg_0749_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik maksymalizuje\nswój Atak w zamian za\nHP równe połowie\nswojego maksymalnego\nHP.</language>
	</row>
	<row id="msg_0749_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje,\nrzucając brudnym\nbłotem w przeciwnika.\nMoże też zatruć\ncel.</language>
	</row>
	<row id="msg_0749_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rzuca\nbłotem w twarz przeciwnika,\nzadając obrażenia i\nobniżając jego\ncelność.\n</language>
	</row>
	<row id="msg_0749_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje,\nrozpylając atrament w\ntwarz lub oczy przeciwnika.\nMoże też obniżyć\ncelność celu.</language>
	</row>
	<row id="msg_0749_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zastawia\npułapkę z kolców pod\nnogami przeciwnika.\nPułapka rani przeciwników\nwchodzących do walki.</language>
	</row>
	<row id="msg_0749_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wystrzeliwuje\nwyładowanie elektryczne\njak z armaty, zadając\nobrażenia i wywołując\nparaliż.</language>
	</row>
	<row id="msg_0749_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umożliwia użytkownikowi\ntrafienie typu Ghost\ndowolnym typem ruchu.\nUmożliwia też trafienie\nunikającego przeciwnika.</language>
	</row>
	<row id="msg_0749_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy ten ruch jest\nużywany, jeśli użytkownik\nzemdleje, przeciwnik,\nktóry zadał decydujący\ncios, także mdleje.</language>
	</row>
	<row id="msg_0749_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Każdy Pokémon, który\nusłyszy tę piosenkę,\nmdleje po trzech turach,\nchyba że opuści\nwalkę.</language>
	</row>
	<row id="msg_0749_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\npodmuchem lodowatego\npowietrza.\nObniża też Szybkość\ncelu.\n</language>
	</row>
	<row id="msg_0749_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umożliwia użytkownikowi\nunikanie wszystkich\nataków. Szansa na\nniepowodzenie rośnie\nprzy kolejnym użyciu.</language>
	</row>
	<row id="msg_0749_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uderza\nprzeciwnika twardą\nkością od dwóch do\npięciu razy z\nrzędu.</language>
	</row>
	<row id="msg_0749_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik dokładnie\nceluje w przeciwnika.\nZapewnia to, że\nnastępny atak na pewno\ntrafi.</language>
	</row>
	<row id="msg_0749_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik szaleje i\natakuje przez dwie do\ntrzech tur. Potem\njednak zostaje\nsplątany.</language>
	</row>
	<row id="msg_0749_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pięcioturowa burza\npiaskowa jest przyzywana,\nby ranić wszystkie typy\nwalczących oprócz Rock,\nGround i Steel.</language>
	</row>
	<row id="msg_0749_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak wysysający\nsubstancje odżywcze.\nHP użytkownika jest\nprzywracane o połowę\nobrażeń zadanych celowi.</language>
	</row>
	<row id="msg_0749_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik znosi\ndowolny atak z co\nnajmniej 1 HP. Szansa\nna niepowodzenie rośnie\nprzy kolejnym użyciu.</language>
	</row>
	<row id="msg_0749_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uroczo\nwpatruje się w przeciwnika,\nsprawiając, że jest\nmniej ostrożny. Ostro\nobniża Atak celu.</language>
	</row>
	<row id="msg_0749_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik ciągle\ntoczy się w przeciwnika\nprzez pięć tur.\nStaje się silniejszy\nz każdym trafieniem.</language>
	</row>
	<row id="msg_0749_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powściągnięty atak,\nktóry nie pozwala\nprzeciwnikowi zemdleć.\nCel zostaje z co\nnajmniej 1 HP.</language>
	</row>
	<row id="msg_0749_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wprawia\nprzeciwnika w rozjuszenie\ni splątanie. Ostro\npodnosi jednak Atak\nprzeciwnika.</language>
	</row>
	<row id="msg_0749_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przywraca\nsobie HP o maksymalnie\npołowę swojego\nmaksymalnego HP. Może\nteż uleczyć HP sojusznika.</language>
	</row>
	<row id="msg_0749_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rzuca się\nna przeciwnika naładowanym\nelektrycznie szarżą.\nMoże też zostawić\ncel sparaliżowany.</language>
	</row>
	<row id="msg_0749_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest cięty\nkosami lub pazurami.\nSiła ataku rośnie przy\nkolejnych\ntrafieniach.</language>
	</row>
	<row id="msg_0749_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nuderzany stalowymi\nskrzydłami.\nMoże też podnieść\nObronę użytkownika.\n</language>
	</row>
	<row id="msg_0749_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przygważdża\nprzeciwnika mrocznym,\naresztującym spojrzeniem.\nCel nie może\nuciec.</language>
	</row>
	<row id="msg_0749_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jest płci\nprzeciwnej niż\nużytkownik, przeciwnik\nzostaje zauroczony i\nrzadziej atakuje.</language>
	</row>
	<row id="msg_0749_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podczas snu użytkownik\nlosowo używa jednego z\nruchów, które zna.\n\n</language>
	</row>
	<row id="msg_0749_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wydaje\nkojący dźwięk dzwonka,\nby uleczyć problemy\nstatusowe wszystkich\nPokémonów z drużyny.</language>
	</row>
	<row id="msg_0749_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak pełnej mocy, który\nrośnie w siłę, im\nbardziej użytkownik\nlubi swojego\nTrenera.</language>
	</row>
	<row id="msg_0749_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje,\ndając przeciwnikowi\nzatruty prezent.\nCzasami jednak\nprzywraca HP.</language>
	</row>
	<row id="msg_0749_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak pełnej mocy, który\nrośnie w siłę, im\nmniej użytkownik lubi\nswojego\nTrenera.</language>
	</row>
	<row id="msg_0749_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tworzy pole\nochronne, które przez\npięć tur zapobiega\nproblemom\nstatusowym.</language>
	</row>
	<row id="msg_0749_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik dodaje swoje\nHP do HP przeciwnika, a\npotem dzieli się\nrówno połączonym\nHP z przeciwnikiem.</language>
	</row>
	<row id="msg_0749_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nniszczony mistycznym\nogniem wielkiej\nintensywności.\nMoże też zostawić cel poparzony.</language>
	</row>
	<row id="msg_0749_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\nwstrząs ziemi, który\nrazi wszystkich\nuczestników walki.\nJego siła jest zmienna.</language>
	</row>
	<row id="msg_0749_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik dostaje cios\npełną, skoncentrowaną\nmocą użytkownika.\nWprowadza przeciwnika\nw splątanie, jeśli trafi.</language>
	</row>
	<row id="msg_0749_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wykorzystując swój\ntwardy i imponujący\nróg, użytkownik\nnieustannie wbija się\nw przeciwnika.\n</language>
	</row>
	<row id="msg_0749_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wydycha\npotężny podmuch, który\nzadaje obrażenia.\nMoże też sparaliżować\ncel.</language>
	</row>
	<row id="msg_0749_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zamienia\nsię miejscami z\noczekującym Pokémonem\nz drużyny, przekazując\nmu wszelkie zmiany statystyk.</language>
	</row>
	<row id="msg_0749_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zmusza\nprzeciwnika do używania\ntylko ostatnio użytego\nruchu przez trzy do\nsiedmiu tur.</language>
	</row>
	<row id="msg_0749_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, który zadaje\npodwójne obrażenia, gdy\nużyty na przeciwniku\nzmieniającym Pokémona\nw walce.\n</language>
	</row>
	<row id="msg_0749_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wirujący atak, który\nmoże też usunąć takie\nruchy jak Bind, Wrap,\nLeech Seed i\nSpikes.</language>
	</row>
	<row id="msg_0749_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słodki zapach, który\nobniża unik przeciwnika.\nWabi też dzikie Pokémony,\njeśli użyty w wysokiej\ntrawie itp.</language>
	</row>
	<row id="msg_0749_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest okładany\ntwardym jak stal\nogonem. Może też\nobniżyć Obronę\ncelu.</language>
	</row>
	<row id="msg_0749_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nrozdrapywany stalowymi\npazurami.\nMoże też podnieść\nAtak użytkownika.\n</language>
	</row>
	<row id="msg_0749_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik pozwala\nprzeciwnikowi zaatakować\npierwszemu. W zamian\nten rzucający ruch\ngwarantuje trafienie.</language>
	</row>
	<row id="msg_0749_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przywraca\nsobie HP.\nIlość odzyskanego HP\nzależy od pogody.\n</language>
	</row>
	<row id="msg_0749_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przywraca\nsobie HP.\nIlość odzyskanego HP\nzależy od pogody.\n</language>
	</row>
	<row id="msg_0749_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przywraca\nsobie HP.\nIlość odzyskanego HP\nzależy od pogody.\n</language>
	</row>
	<row id="msg_0749_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Unikalny atak, który\nróżni się typem i\nsiłą w zależności od\nPokémona, który go\nużywa.</language>
	</row>
	<row id="msg_0749_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zadaje\npodwójny cios,\nkrzyżując przedramiona.\nMa wysoką szansę na\ntrafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wzbija\nzłośliwe tornado, by\nrozerwać przeciwnika.\nMoże też sprawić, że\nprzeciwnik się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przyzywa\nulewny deszcz, który\npada przez pięć tur,\nwzmacniając ruchy typu\nWater.</language>
	</row>
	<row id="msg_0749_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wzmaga\nsłońce na pięć tur,\nwzmacniając ruchy typu\nFire.\n</language>
	</row>
	<row id="msg_0749_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik chrupie\nprzeciwnika ostrymi\nkłami. Może też\nobniżyć Obronę\ncelu.</language>
	</row>
	<row id="msg_0749_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruch odwetowy, który\nkontruje każdy atak\nspecjalny, zadając\npodwójne obrażenia.</language>
	</row>
	<row id="msg_0749_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik hipnotyzuje\nsamego siebie, by\nskopiować dowolną\nzmianę statystyk\ndokonaną przez przeciwnika.</language>
	</row>
	<row id="msg_0749_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik szarżuje na\nprzeciwnika z\noślepiającą prędkością.\nTen atak zawsze wyprzedza\nkażdy inny ruch.</language>
	</row>
	<row id="msg_0749_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nprehistoryczną mocą.\nMoże też podnieść\nwszystkie statystyki\nużytkownika naraz.</language>
	</row>
	<row id="msg_0749_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rzuca\nmroczną kulą w przeciwnika.\nMoże też obniżyć\nObronę Specjalną\nprzeciwnika.</language>
	</row>
	<row id="msg_0749_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dwie tury po użyciu\ntego ruchu przeciwnik\njest atakowany bryłą\npsychicznej\nenergii.</language>
	</row>
	<row id="msg_0749_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik trafia\nciosem, który może\nobniżyć Obronę celu.\nMoże też rozbijać\npopękane głazy.</language>
	</row>
	<row id="msg_0749_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwięzia przeciwnika w\nwirze wodnym, który\ntrwa od dwóch do\npięciu tur. Użytkownik\nmoże przechodzić przez wiry.</language>
	</row>
	<row id="msg_0749_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik nakłania\nwszystkie Pokémony z\ndrużyny do zaatakowania\nprzeciwnika. Im więcej\nPokémonów, tym więcej obrażeń.</language>
	</row>
	<row id="msg_0749_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, który trafia\npierwszy i sprawia, że\ncel się wzdrygnie.\nDziała tylko w\npierwszej turze walki użytkownika.</language>
	</row>
	<row id="msg_0749_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje w\nzgiełku przez dwie do\npięciu tur. W tym\nczasie nikt nie może\nzasnąć.</language>
	</row>
	<row id="msg_0749_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gromadzi\nmoc i podnosi zarówno\nObronę, jak i Obronę\nSpecjalną. Ruchu można\nużyć trzy razy.</language>
	</row>
	<row id="msg_0749_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moc zgromadzona za\npomocą ruchu Stockpile\njest uwalniana naraz\nw ataku.\n</language>
	</row>
	<row id="msg_0749_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moc zgromadzona za\npomocą ruchu Stockpile\njest wchłaniana przez\nużytkownika, by\nuleczyć jego HP.</language>
	</row>
	<row id="msg_0749_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wydycha\nrozgrzany oddech na\nprzeciwnika, atakując.\nMoże też zostawić\ncel poparzony.</language>
	</row>
	<row id="msg_0749_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przyzywa\ngradobicie trwające\npięć tur. Rani wszystkie\nPokémony oprócz\ntypu Ice.</language>
	</row>
	<row id="msg_0749_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik dręczy i\nwprowadza przeciwnika\nw furię, uniemożliwiając\nużycie tego samego\nruchu dwa razy z rzędu.</language>
	</row>
	<row id="msg_0749_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pochlebstwo jest\nużywane, by wprowadzić\nprzeciwnika w splątanie.\nPodnosi jednak Atak\nSpecjalny celu.</language>
	</row>
	<row id="msg_0749_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik strzela\nzłowieszczym, niebieskawym\npłomieniem w przeciwnika,\nzadając\npoparzenie.\n</language>
	</row>
	<row id="msg_0749_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik mdleje po\nużyciu tego ruchu.\nW zamian ostro obniża\nAtak i Atak Specjalny\ncelu.</language>
	</row>
	<row id="msg_0749_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, który podwaja\nsiłę, jeśli użytkownik\njest zatruty, sparaliżowany\nlub ma\npoparzenie.</language>
	</row>
	<row id="msg_0749_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik skupia\numysł przed rzuceniem\nciosu. Zawiedzie, jeśli\nużytkownik zostanie\ntrafiony przed jego użyciem.</language>
	</row>
	<row id="msg_0749_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten atak zadaje\npodwójne obrażenia\nsparaliżowanemu\nprzeciwnikowi. Leczy\njednak paraliż celu.</language>
	</row>
	<row id="msg_0749_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zwraca na\nsiebie uwagę, sprawiając,\nże wszyscy przeciwnicy\ncelują tylko w\nużytkownika.\n</language>
	</row>
	<row id="msg_0749_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak wykorzystujący\nmoc natury.\nJego efekty zależą od\nśrodowiska\nużytkownika.</language>
	</row>
	<row id="msg_0749_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wzmacnia\nmoc następnego użytego\nruchu typu Electric.\nPodnosi też Obronę\nSpecjalną użytkownika.</language>
	</row>
	<row id="msg_0749_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik zostaje\ndoprowadzony do furii,\nprzez co przez dwie do\nczterech tur może używać\ntylko ruchów atakujących.</language>
	</row>
	<row id="msg_0749_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruch, który wzmacnia\nsiłę ataku sojusznika\nw Walce\nPodwójnej.\n</language>
	</row>
	<row id="msg_0749_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zaskakuje\nprzeciwnika i zamienia\ntrzymany przedmiot\nprzeciwnika ze swoim\nwłasnym.\n</language>
	</row>
	<row id="msg_0749_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik naśladuje\nprzeciwnika całkowicie,\nkopiując naturalną\numiejętność\nprzeciwnika.\n</language>
	</row>
	<row id="msg_0749_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruch samoleczący.\nUżytkownik przywraca\nsobie HP o maksymalnie\npołowę swojego\nmaksymalnego HP w następnej turze.</language>
	</row>
	<row id="msg_0749_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik pospiesznie\ni losowo używa ruchu\nznanego przez innego\nPokémona z\ndrużyny.</language>
	</row>
	<row id="msg_0749_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zapuszcza\nkorzenie, które przywracają\nHP w każdej turze.\nPonieważ jest zakorzeniony,\nnie może zmienić Pokémona.</language>
	</row>
	<row id="msg_0749_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nprzeciwnika z wielką\nmocą. Obniża jednak\ntakże Atak i Obronę\nużytkownika.</language>
	</row>
	<row id="msg_0749_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bariera odbija z\npowrotem na przeciwnika\nruchy takie jak Leech\nSeed oraz ruchy\nszkodzące statusowi.</language>
	</row>
	<row id="msg_0749_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik odzyskuje\ntrzymany przedmiot,\nktóry został użyty w\nwalce, by można go\nbyło użyć ponownie.</language>
	</row>
	<row id="msg_0749_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, który zadaje\npodwójne obrażenia,\njeśli użytkownik został\nzraniony przez przeciwnika\nw tej samej turze.</language>
	</row>
	<row id="msg_0749_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\ntwardymi pięściami itp.\nMoże też przełamać\ndowolną barierę, taką\njak Light Screen i Reflect.</language>
	</row>
	<row id="msg_0749_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wypuszcza\nogromne ziewnięcie,\nktóre usypia przeciwnika\nw następnej\nturze.\n</language>
	</row>
	<row id="msg_0749_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uderza w\ntrzymany przedmiot\nprzeciwnika, uniemożliwiając\njego użycie przez\ncałą walkę.</language>
	</row>
	<row id="msg_0749_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, który obniża HP\nprzeciwnika do poziomu\nrównego HP\nużytkownika.\n</language>
	</row>
	<row id="msg_0749_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje w\neksplozywnej furii.\nIm niższe HP użytkownika,\ntym słabszy staje się\nten atak.</language>
	</row>
	<row id="msg_0749_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik używa\nswojej mocy psychicznej,\nby wymienić się\numiejętnościami z\nprzeciwnikiem.\n</language>
	</row>
	<row id="msg_0749_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli przeciwnik zna\nruch znany także przez\nużytkownika, przeciwnik\nzostaje zablokowany\nprzed jego użyciem.</language>
	</row>
	<row id="msg_0749_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik odpoczywa,\nby wyleczyć się z\nzatrucia, poparzenia\nlub\nparaliżu.\n</language>
	</row>
	<row id="msg_0749_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli użytkownik\nzemdleje, uraza\nużytkownika całkowicie\nwyczerpuje PP ruchu\nprzeciwnika, który go pokonał.</language>
	</row>
	<row id="msg_0749_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik kradnie\nefekty dowolnego\nruchu leczącego lub\nzmieniającego statystyki,\nktórego próbuje użyć przeciwnik.</language>
	</row>
	<row id="msg_0749_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\ntajemną mocą. Dodatkowe\nefekty zależą od\nśrodowiska\nużytkownika.</language>
	</row>
	<row id="msg_0749_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak trwający dwie\ntury. Użytkownik nurkuje\npod wodę w pierwszej\nturze, a trafia w\nnastępnej.</language>
	</row>
	<row id="msg_0749_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\ngrad otwartodłoniowych\npchnięć, które trafiają\nod dwóch do pięciu\nrazy z rzędu.</language>
	</row>
	<row id="msg_0749_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Typ użytkownika\nzmienia się w zależności\nod środowiska, np. nad\nwodą, w trawie lub w\njaskini.</language>
	</row>
	<row id="msg_0749_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wpatruje\nsię w migoczące światła,\nby skupić umysł, ostro\npodnosząc Atak\nSpecjalny.</language>
	</row>
	<row id="msg_0749_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\nszkodliwy błysk\nświatła. Może też\nobniżyć Obronę\nSpecjalną celu.</language>
	</row>
	<row id="msg_0749_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mglista chmura puchu\notula i rani przeciwnika.\nMoże też obniżyć\nAtak Specjalny\ncelu.</language>
	</row>
	<row id="msg_0749_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik pokrywa\nprzeciwnika masą puchu,\nktóra ostro obniża\njego Atak.\n</language>
	</row>
	<row id="msg_0749_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wykonuje\nchwiejny taniec, który\nwprowadza w splątanie\nwszystkie Pokémony w\nwalce.\n</language>
	</row>
	<row id="msg_0749_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zadaje\nkopniak o wysokiej\nszansie na trafienie\nkrytyczne. Może też\nzostawić cel poparzony.</language>
	</row>
	<row id="msg_0749_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik pokrywa się\nbłotem. Osłabia to\nruchy typu Electric,\ndopóki użytkownik jest\nw walce.</language>
	</row>
	<row id="msg_0749_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik ciągle\ntoczy się w przeciwnika\nprzez pięć tur.\nStaje się silniejszy\nz każdym trafieniem.</language>
	</row>
	<row id="msg_0749_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje,\ndziko wymachując\ncierniowymi ramionami.\nMoże też sprawić, że\ncel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik obija się,\nprzywracając sobie HP\no maksymalnie połowę\nswojego maksymalnego\nHP.\n</language>
	</row>
	<row id="msg_0749_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wydaje\nstraszliwie echowy\nokrzyk o mocy\nzadawania\nobrażeń.</language>
	</row>
	<row id="msg_0749_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gryzie\nprzeciwnika toksycznymi\nkłami.\nMoże też poważnie\nzatruć przeciwnika.\n</language>
	</row>
	<row id="msg_0749_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tnie\nprzeciwnika twardymi i\nostrymi pazurami.\nMoże też obniżyć\nObronę celu.</language>
	</row>
	<row id="msg_0749_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nniszczony ognistą\neksplozją. Użytkownik\nmusi jednak odpocząć w\nnastępnej turze.</language>
	</row>
	<row id="msg_0749_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\ntrafiany wodnym\nwybuchem. Użytkownik\nmusi jednak odpocząć w\nnastępnej turze.</language>
	</row>
	<row id="msg_0749_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik dostaje\ntwardy cios wystrzelony\njak meteor.\nMoże też podnieść\nAtak użytkownika.</language>
	</row>
	<row id="msg_0749_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nprzeciwnika, krzycząc w\nprzerażający sposób.\nMoże też sprawić, że\ncel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ruch atakujący, który\nzmienia się w sile i\ntypie w zależności od\npogody.\n</language>
	</row>
	<row id="msg_0749_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\nkojący zapach, który\nleczy wszystkie problemy\nstatusowe drużyny\nużytkownika.</language>
	</row>
	<row id="msg_0749_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik udaje\npłacz, by wprawić\nprzeciwnika w zakłopotanie,\nostro obniżając jego\nObronę Specjalną.</language>
	</row>
	<row id="msg_0749_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wystrzeliwuje\nostry jak brzytwa wiatr,\nby ciąć przeciwnika.\nMa wysoką szansę na\ntrafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nprzeciwnika z pełną\nmocą. Odrzut ataku\nostro obniża Atak\nSpecjalny użytkownika.</language>
	</row>
	<row id="msg_0749_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umożliwia użytkownikowi\ntrafienie typu Ghost\ndowolnym typem ruchu.\nUmożliwia też trafienie\nunikającego przeciwnika.</language>
	</row>
	<row id="msg_0749_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Głazy są rzucane w\nprzeciwnika.\nObniża też Szybkość\nprzeciwnika, uniemożliwiając\nmu ruch.</language>
	</row>
	<row id="msg_0749_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\natakowany sypkimi\nłuskami niesionymi\nprzez wiatr.\nMoże też podnieść wszystkie statystyki użytkownika.</language>
	</row>
	<row id="msg_0749_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Straszny dźwięk\nprzypominający zgrzytanie\nmetalu jest wydawany,\nby ostro obniżyć\nObronę Specjalną celu.</language>
	</row>
	<row id="msg_0749_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gra\nprzyjemną melodię, która\nusypia przeciwnika\ngłębokim\nsnem.\n</language>
	</row>
	<row id="msg_0749_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik łaskocze\nprzeciwnika do śmiechu,\nobniżając jego Atak i\nObronę.\n</language>
	</row>
	<row id="msg_0749_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wchłania\nmistyczną moc z kosmosu,\nby podnieść swoją\nObronę i Obronę\nSpecjalną.</language>
	</row>
	<row id="msg_0749_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wypluwa\nwodę, by zranić przeciwnika.\nIm niższe HP użytkownika,\ntym słabszy staje się\nten atak.</language>
	</row>
	<row id="msg_0749_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nzłowieszczą wiązką\nświatła.\nMoże też wprowadzić\ncel w splątanie.\n</language>
	</row>
	<row id="msg_0749_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rzuca cios\nw przeciwnika z ukrycia\nw cieniu.\nCios trafia bez\npudła.</language>
	</row>
	<row id="msg_0749_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\ndziwną, niewidzialną\nmocą.\nMoże też sprawić, że\nprzeciwnik się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nprzeciwnika sierpowym\nciosem rzuconym w\ngórę z siłą.\n</language>
	</row>
	<row id="msg_0749_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwięzia\nprzeciwnika w gwałtownie\nszalejącej burzy\npiaskowej przez dwie\ndo pięciu tur.\n</language>
	</row>
	<row id="msg_0749_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\natakowany wybuchem\nzimna bliskiego zeru\nabsolutnemu.\nCel mdleje natychmiast, jeśli atak trafi.</language>
	</row>
	<row id="msg_0749_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje,\nwystrzeliwując mętną\nwodę.\nMoże też obniżyć\ncelność przeciwnika.\n</language>
	</row>
	<row id="msg_0749_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gwałtownie\nwystrzeliwuje nasiona w\nprzeciwnika. Od dwóch\ndo pięciu nasion jest\nwystrzeliwanych w szybkim tempie.</language>
	</row>
	<row id="msg_0749_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zbija\nprzeciwnika z tropu\nprędkością, po czym\ntnie. Atak trafia bez\npudła.</language>
	</row>
	<row id="msg_0749_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wystrzeliwuje\nostre sople w przeciwnika.\nTrafia od dwóch do\npięciu razy z\nrzędu.</language>
	</row>
	<row id="msg_0749_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik hartuje\npowierzchnię swojego\nciała jak żelazo, ostro\npodnosząc swoją\nObronę.</language>
	</row>
	<row id="msg_0749_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik blokuje\ndrogę przeciwnika,\nrozkładając szeroko\nramiona, by uniemożliwić\nucieczkę.\n</language>
	</row>
	<row id="msg_0749_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wyje\ngłośno, by podnieść\nswojego ducha, wzmacniając\nswój\nAtak.\n</language>
	</row>
	<row id="msg_0749_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tnie\nprzeciwnika ogromnymi,\nostrymi pazurami.\n\n</language>
	</row>
	<row id="msg_0749_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nokładany ogromnym\ndrzewem.\nUżytkownik nie może\nporuszyć się w następnej turze.</language>
	</row>
	<row id="msg_0749_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik napina\nmięśnie, by wzmocnić\nswoje ciało, wzmacniając\nzarówno swój Atak, jak\ni Obronę.</language>
	</row>
	<row id="msg_0749_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik odbija się\nwysoko, po czym spada\nna przeciwnika w\ndrugiej turze. Może też\nsparaliżować przeciwnika.</language>
	</row>
	<row id="msg_0749_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje,\nrzucając bryłą błota w\nprzeciwnika.\nObniża też Szybkość\ncelu.</language>
	</row>
	<row id="msg_0749_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak o wysokiej szansie\nna trafienie krytyczne.\nTen atak ogonem może\ntakże zatruć\nprzeciwnika.</language>
	</row>
	<row id="msg_0749_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik ujmująco\npodchodzi do przeciwnika,\npo czym kradnie\ntrzymany przez niego\nprzedmiot.\n</language>
	</row>
	<row id="msg_0749_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik naelektryzowuje\nsamego siebie, po czym\nszarżuje na przeciwnika.\nPowoduje to znaczne\nobrażenia także u użytkownika.</language>
	</row>
	<row id="msg_0749_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rozsypuje\nciekawe liście, które\nścigają przeciwnika.\nTen atak nie\nchybi.</language>
	</row>
	<row id="msg_0749_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik moczy się\nwodą. Ruch osłabia\nruchy typu Fire, dopóki\nużytkownik jest w\nwalce.</language>
	</row>
	<row id="msg_0749_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik spokojnie\nskupia umysł i uspokaja\nducha, podnosząc swój\nAtak Specjalny i Obronę\nSpecjalną.</language>
	</row>
	<row id="msg_0749_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest cięty\nostrym liściem.\nMa wysoką szansę na\ntrafienie\nkrytyczne.\n</language>
	</row>
	<row id="msg_0749_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik energicznie\nwykonuje mistyczny,\npotężny taniec, który\nwzmacnia jego Atak i\nSzybkość.</language>
	</row>
	<row id="msg_0749_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rzuca\ntwardymi kamieniami w\nprzeciwnika. Od dwóch\ndo pięciu kamieni\nwystrzeliwuje w szybkim tempie.</language>
	</row>
	<row id="msg_0749_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uderza\nprzeciwnika szybkim\nwyładowaniem elektrycznym.\nTego ataku nie da się\nuniknąć.</language>
	</row>
	<row id="msg_0749_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nprzeciwnika pulsującym\nwybuchem wody.\nMoże też wprowadzić\ncel w splątanie.</language>
	</row>
	<row id="msg_0749_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dwie tury po użyciu\ntego ruchu użytkownik\nrazi przeciwnika\nskoncentrowanym\npęczkiem światła.</language>
	</row>
	<row id="msg_0749_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nprzeciwnika z pełną\nmocą. Odrzut ataku\nostro obniża Atak\nSpecjalny użytkownika.</language>
	</row>
	<row id="msg_0749_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik ląduje i\nodpoczywa.\nPrzywraca to HP\nużytkownika o maksymalnie\npołowę jego maksymalnego HP.</language>
	</row>
	<row id="msg_0749_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grawitacja jest\nwzmacniana na pięć tur,\nczyniąc ruchy związane\nz lataniem bezużytecznymi\ni znosząc lewitację.</language>
	</row>
	<row id="msg_0749_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Umożliwia użytkownikowi\ntrafienie typu Dark\ndowolnym typem ruchu.\nUmożliwia też trafienie\nunikającego przeciwnika.</language>
	</row>
	<row id="msg_0749_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten atak zadaje wysokie\nobrażenia śpiącemu\nprzeciwnikowi. Budzi\njednak\nprzeciwnika.</language>
	</row>
	<row id="msg_0749_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zamachuje\nsię i trafia swoją\nsilną, ciężką pięścią.\nObniża jednak Szybkość\nużytkownika.</language>
	</row>
	<row id="msg_0749_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nprzeciwnika szybkim\nwirowaniem. Im wolniejszy\nużytkownik, tym większe\nobrażenia.</language>
	</row>
	<row id="msg_0749_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik mdleje. W\nzamian Pokémon, który\nzajmie jego miejsce,\nbędzie miał przywrócone\nHP i wyleczony status.</language>
	</row>
	<row id="msg_0749_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli HP przeciwnika\nspadło do około połowy,\nten atak trafi z\npodwójną\nmocą.</language>
	</row>
	<row id="msg_0749_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik czerpie moc\nz trzymanej Jagody, by\nzaatakować.\nJagoda określa typ i\nsiłę ataku.</language>
	</row>
	<row id="msg_0749_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, który trafia\nprzeciwnika używającego\nProtect lub Detect.\nZnosi też efekty tych\nruchów.</language>
	</row>
	<row id="msg_0749_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik dziobie\nprzeciwnika. Jeśli\nprzeciwnik trzyma Jagodę,\nużytkownik zabiera ją i\nzyskuje jej efekt.</language>
	</row>
	<row id="msg_0749_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wzbija\nturbulentny wicher,\nktóry przez trzy tury\npodnosi Szybkość\nwszystkich Pokémonów z drużyny.</language>
	</row>
	<row id="msg_0749_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik naciska na\npunkty stresowe, ostro\nwzmacniając jedną ze\nswoich\nstatystyk.</language>
	</row>
	<row id="msg_0749_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik odpłaca\nprzeciwnikowi, który\nostatnio zadał mu\nobrażenia, z dużo\nwiększą mocą.</language>
	</row>
	<row id="msg_0749_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po ataku użytkownik\nspiesznie wraca, by\nzamienić się miejscami\nz oczekującym Pokémonem\nz drużyny.</language>
	</row>
	<row id="msg_0749_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik walczy z\nprzeciwnikiem z bliska\nbez osłaniania się.\nObniża też Obronę i\nObronę Specjalną użytkownika.</language>
	</row>
	<row id="msg_0749_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli użytkownik może\nużyć tego ataku po\nataku przeciwnika, jego\nsiła jest\npodwojona.\n</language>
	</row>
	<row id="msg_0749_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli przeciwnik\nposiadał już obrażenia\nw tej samej turze,\nsiła tego ataku jest\npodwojona.</language>
	</row>
	<row id="msg_0749_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uniemożliwia\nprzeciwnikowi użycie\ntrzymanego przedmiotu.\nJego Trenerowi także\nzabrania użycia na nim przedmiotów.</language>
	</row>
	<row id="msg_0749_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik ciska\nswoim trzymanym\nprzedmiotem w przeciwnika,\nby zaatakować. Siła i\nefekty zależą od przedmiotu.</language>
	</row>
	<row id="msg_0749_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wykorzystując\npsychiczną moc sugestii,\nużytkownik przenosi\nswoje problemy statusowe\nna cel.</language>
	</row>
	<row id="msg_0749_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Im mniej PP ma ten\nruch, tym większą ma\nsiłę\nataku.\n</language>
	</row>
	<row id="msg_0749_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uniemożliwia\nprzeciwnikowi użycie\njakiegokolwiek ruchu\nprzywracającego HP\nprzez pięć tur.\n</language>
	</row>
	<row id="msg_0749_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik potężnie\nwyżyma przeciwnika.\nIm więcej HP ma\nprzeciwnik, tym większa\nsiła tego ataku.</language>
	</row>
	<row id="msg_0749_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik używa\nswojej mocy psychicznej,\nby zamienić swój Atak\nze swoją\nObroną.</language>
	</row>
	<row id="msg_0749_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wyrzuca z\nsiebie kwasy żołądkowe\nna przeciwnika. Płyn\nznosi efekt umiejętności\nprzeciwnika.</language>
	</row>
	<row id="msg_0749_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wypowiada\nzaklęcie skierowane ku\nniebu, uniemożliwiając\nprzeciwnikowi zadawanie\ntrafień krytycznych.</language>
	</row>
	<row id="msg_0749_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik próbuje\nuprzedzić przeciwnika,\nby ukraść i użyć\nzamierzonego ruchu\nprzeciwnika z większą siłą.</language>
	</row>
	<row id="msg_0749_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik naśladuje\nruch użyty bezpośrednio\nprzed nim. Ruch zawodzi,\njeśli żaden inny ruch\nnie został jeszcze użyty.</language>
	</row>
	<row id="msg_0749_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik używa\nswojej mocy psychicznej,\nby zamienić się z\nprzeciwnikiem zmianami\nAtaku i Ataku Specjalnego.</language>
	</row>
	<row id="msg_0749_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik używa\nswojej mocy psychicznej,\nby zamienić się z\nprzeciwnikiem zmianami\nObrony i Obrony Specjalnej.</language>
	</row>
	<row id="msg_0749_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Siła tego ataku\nrośnie, im bardziej\nprzeciwnik wzmocnił\nsię zmianami\nstatystyk.\n</language>
	</row>
	<row id="msg_0749_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tego ruchu można użyć\ntylko po tym, jak\nużytkownik użył już\nwszystkich innych\nznanych ruchów w walce.</language>
	</row>
	<row id="msg_0749_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nasiono wywołujące\nniepokój jest sadzone\nna przeciwniku.\nZapobiega snu, nadając\nmu umiejętność Insomnia.</language>
	</row>
	<row id="msg_0749_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten ruch umożliwia\nużytkownikowi\nzaatakowanie pierwszego.\nZawodzi, jeśli przeciwnik\nnie szykuje się do ataku.</language>
	</row>
	<row id="msg_0749_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zastawia\npułapkę z trujących\nkolców pod nogami\nprzeciwnika. Zatruwają\nprzeciwników wchodzących do walki.</language>
	</row>
	<row id="msg_0749_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik używa\nswojej mocy psychicznej,\nby zamienić się z\nprzeciwnikiem zmianami\nstatystyk.\n</language>
	</row>
	<row id="msg_0749_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik otula się\nzasłoną z wody.\nOdzyskuje trochę HP w\nkażdej\nturze.</language>
	</row>
	<row id="msg_0749_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik lewituje,\nwykorzystując elektrycznie\nwytworzony magnetyzm\nprzez pięć\ntur.\n</language>
	</row>
	<row id="msg_0749_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik otula się\nogniem i szarżuje na\nprzeciwnika. Użytkownik\nteż ponosi poważne\nobrażenia.</language>
	</row>
	<row id="msg_0749_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\natakowany falą\nuderzeniową.\nMoże też zostawić cel\nsparaliżowany.\n</language>
	</row>
	<row id="msg_0749_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\nwybuch mocy aury z\ngłębi swojego ciała.\nTen ruch na pewno\ntrafi.</language>
	</row>
	<row id="msg_0749_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik poleruje\nswoje ciało, by zmniejszyć\nopór. Może ostro\npodnieść\nSzybkość.\n</language>
	</row>
	<row id="msg_0749_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest kłuty\nmacką lub ramieniem\nnasączonym trucizną.\nMoże też zatruć\nprzeciwnika.</language>
	</row>
	<row id="msg_0749_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\nstraszliwą aurę przesyconą\nmrocznymi myślami.\nMoże też sprawić, że\ncel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tnie\nprzeciwnika w chwili,\ngdy pojawia się okazja.\nMa wysoką szansę na\ntrafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje,\nmachając ogonem, jakby\nbyła to złośliwa fala\nw szalejącej\nburzy.\n</language>
	</row>
	<row id="msg_0749_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zsypuje\ngrad twardych nasion na\nprzeciwnika z\ngóry.\n</language>
	</row>
	<row id="msg_0749_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nostrzem powietrza, które\ntnie nawet niebo.\nMoże też sprawić, że\ncel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tnie\nprzeciwnika, krzyżując\nswoje kosy lub pazury\njak parę\nnożyc.\n</language>
	</row>
	<row id="msg_0749_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wibruje\nskrzydłami, generując\nszkodliwą falę dźwiękową.\nMoże też obniżyć Obronę\nSpecjalną celu.</language>
	</row>
	<row id="msg_0749_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\natakowany falą\nuderzeniową powstałą z\nrozwartej paszczy\nużytkownika.\n</language>
	</row>
	<row id="msg_0749_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nprzeciwnika, okazując\nprzytłaczającą groźbę.\nMoże też sprawić, że\ncel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\npromieniem światła,\nktóry lśni, jakby\nzrobiony był z\nklejnotów.\n</language>
	</row>
	<row id="msg_0749_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cios wysysający\nenergię.\nHP użytkownika jest\nprzywracane o połowę\nobrażeń zadanych celowi.</language>
	</row>
	<row id="msg_0749_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zawiruje\npięściami, by wysłać\nfalę czystej próżni w\nprzeciwnika. Ten ruch\nzawsze trafia jako pierwszy.</language>
	</row>
	<row id="msg_0749_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wzmaga\nkoncentrację umysłu i\nuwalnia swoją moc.\nMoże też obniżyć Obronę\nSpecjalną celu.</language>
	</row>
	<row id="msg_0749_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik czerpie moc\nz natury i wystrzeliwuje\nją w przeciwnika.\nMoże też obniżyć Obronę\nSpecjalną celu.</language>
	</row>
	<row id="msg_0749_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik chowa\nskrzydła i szarżuje z\nniskiej wysokości.\nUżytkownik też ponosi\npoważne obrażenia.</language>
	</row>
	<row id="msg_0749_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik sprawia, że\nziemia pod przeciwnikiem\nwybucha mocą.\nMoże też obniżyć Obronę\nSpecjalną celu.</language>
	</row>
	<row id="msg_0749_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wymienia\ntrzymane przedmioty z\nprzeciwnikiem szybciej,\nniż oko może\nnadążyć.\n</language>
	</row>
	<row id="msg_0749_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik szarżuje na\nprzeciwnika, wykorzystując\ncałą swoją moc.\nUżytkownik musi\nodpocząć w następnej turze.</language>
	</row>
	<row id="msg_0749_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik pobudza\nswój mózg, myśląc o\nzłych rzeczach.\nOstro podnosi Atak\nSpecjalny użytkownika.</language>
	</row>
	<row id="msg_0749_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uderza\ntwardym ciosem szybkim\njak pocisk.\nTen ruch zawsze\ntrafia jako pierwszy.</language>
	</row>
	<row id="msg_0749_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak, który zadaje\npodwójne obrażenia,\njeśli użytkownik został\nzraniony przez przeciwnika\nw tej samej turze.</language>
	</row>
	<row id="msg_0749_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik błyskawicznie\nzamraża kawałki lodu i\nrzuca nimi.\nTen ruch zawsze\ntrafia jako pierwszy.</language>
	</row>
	<row id="msg_0749_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tnie ostrym\npazurem uformowanym z\ncieni.\nMa wysoką szansę na\ntrafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gryzie\nnaelektryzowanymi kłami.\nMoże też sprawić, że\nprzeciwnik się wzdrygnie\nlub zostanie sparaliżowany.</language>
	</row>
	<row id="msg_0749_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gryzie\nkłami przesyconymi\nzimnem. Może też sprawić,\nże przeciwnik się\nwzdrygnie lub zamarznie.</language>
	</row>
	<row id="msg_0749_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gryzie\nkłami otulonymi\npłomieniem. Może też\nsprawić, że przeciwnik\nsię wzdrygnie lub zostanie poparzony.</language>
	</row>
	<row id="msg_0749_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wydłuża\nswój cień i atakuje\nprzeciwnika od tyłu.\nTen ruch zawsze\ntrafia jako pierwszy.</language>
	</row>
	<row id="msg_0749_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wystrzeliwuje\nzbitą kulę błota, by\nzaatakować.\nMoże też obniżyć\ncelność celu.</language>
	</row>
	<row id="msg_0749_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rozdziera\nprzeciwnika ostrzami\nutworzonymi z mocy\npsychicznej. Ma wysoką\nszansę na trafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik skupia swoją\nsiłę woli w głowie i\nwbija się w przeciwnika.\nMoże też sprawić, że\ncel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\nbłysk energii ze swojego\nwypolerowanego ciała.\nMoże też obniżyć\ncelność celu.</language>
	</row>
	<row id="msg_0749_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gromadzi\ncałą swoją energię\nświetlną i uwalnia ją\nnaraz. Może też obniżyć\nObronę Specjalną przeciwnika.</language>
	</row>
	<row id="msg_0749_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak szarżujący, który\nmoże też wprowadzić\nprzeciwnika w splątanie.\nMoże też zostać użyty\ndo wspinaczki po skalnych ścianach.</language>
	</row>
	<row id="msg_0749_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obniża unik przeciwnika.\nUsuwa też kolce,\nekrany świetlne\nitp.\n</language>
	</row>
	<row id="msg_0749_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tworzy\ndziwaczny obszar, w\nktórym wolniejsze\nPokémony ruszają się\npierwsze przez pięć tur.</language>
	</row>
	<row id="msg_0749_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Komety są przyzywane\nz nieba.\nOdrzut ataku ostro\nobniża Atak\nSpecjalny użytkownika.</language>
	</row>
	<row id="msg_0749_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyładowanie elektryczności\njest uwalniane, by\nuderzyć wszystkie\nPokémony w walce. Może\ntakże wywołać paraliż.</language>
	</row>
	<row id="msg_0749_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Piekło szkarłatnych\npłomieni zalewa\nwszystkie Pokémony w\nwalce. Może też\nspowodować poparzenia.</language>
	</row>
	<row id="msg_0749_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Burza ostrych liści\njest wzbijana.\nOdrzut ataku ostro\nobniża Atak\nSpecjalny użytkownika.</language>
	</row>
	<row id="msg_0749_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gwałtownie\nwiruje swoimi pnączami\nlub mackami, by mocno\nsmagnąć\nprzeciwnika.\n</language>
	</row>
	<row id="msg_0749_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wystrzeliwuje\nogromny głaz w\nprzeciwnika, by zaatakować.\nMusi jednak odpocząć w\nnastępnej turze.</language>
	</row>
	<row id="msg_0749_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atak tnący, który\nmoże też zatruć cel.\nMa wysoką szansę na\ntrafienie\nkrytyczne.</language>
	</row>
	<row id="msg_0749_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wystrzeliwuje\nbrudne śmieci w\nprzeciwnika, by zaatakować.\nMoże też zatruć\ncel.</language>
	</row>
	<row id="msg_0749_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik okłada\ncel swoją twardą jak\nstal głową.\nMoże też sprawić, że\ncel się wzdrygnie.</language>
	</row>
	<row id="msg_0749_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wystrzeliwuje\nstalową bombę, która\nprzywiera do celu.\nTen atak nie\nchybi.</language>
	</row>
	<row id="msg_0749_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przebija\nprzeciwnika naostrzonym\nkamieniem. Ma wysoką\nszansę na trafienie\nkrytyczne.\n</language>
	</row>
	<row id="msg_0749_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jest płci\nprzeciwnej niż\nużytkownik, przeciwnik\nzostaje zauroczony,\nostro obniżając Atak Specjalny.</language>
	</row>
	<row id="msg_0749_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zastawia\npułapkę z lewitujących\nkamieni wokół przeciwnika.\nPułapka rani przeciwników\nwchodzących do walki.</language>
	</row>
	<row id="msg_0749_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zaplątuje\nprzeciwnika w trawę i\npodcina mu nogi. Im\ncięższy przeciwnik, tym\nwiększe obrażenia.</language>
	</row>
	<row id="msg_0749_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik atakuje\nfalą dźwiękową opartą\nna nauczonych słowach.\nMoże też wprowadzić\ncel w splątanie.</language>
	</row>
	<row id="msg_0749_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uwalnia\nniezliczone strzały\nświatła. Jego typ\nzależy od rodzaju\ntrzymanej Płytki.</language>
	</row>
	<row id="msg_0749_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik gryzie\nprzeciwnika. Jeśli\nprzeciwnik trzyma Jagodę,\nużytkownik zjada ją i\nzyskuje jej efekt.</language>
	</row>
	<row id="msg_0749_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik wystrzeliwuje\nskoncentrowaną wiązkę\nelektryczności. Może\ntakże podnieść Atak\nSpecjalny użytkownika.</language>
	</row>
	<row id="msg_0749_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik uderza\nswoim nierównym ciałem\nw przeciwnika, by\nzaatakować. Użytkownik\ntakże ponosi poważne obrażenia.</language>
	</row>
	<row id="msg_0749_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rusza na\nprzeciwnika z prędkością,\nktóra czyni go niemal\nniewidzialnym. Zawsze\natakuje jako pierwszy.</language>
	</row>
	<row id="msg_0749_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przyzywa\nswoich podwładnych, by\nzmiażdżyć przeciwnika.\nMa wysoką szansę na\ntrafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przyzywa\nswoich podwładnych, by\nosłonili jego ciało,\npodnosząc jego Obronę\ni Obronę Specjalną.</language>
	</row>
	<row id="msg_0749_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik przyzywa\nswoich podwładnych, by\ngo uleczyli. Użytkownik\nodzyskuje do połowy\nswojego maksymalnego HP.</language>
	</row>
	<row id="msg_0749_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik zadaje\nniebezpieczny dla życia\natak pełnej mocy.\nUżytkownik też ponosi\nstraszliwe obrażenia.</language>
	</row>
	<row id="msg_0749_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nokładany długim ogonem,\npnączami itp. Cel\njest trafiany dwa razy\nz rzędu.</language>
	</row>
	<row id="msg_0749_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik razi\nprzeciwnika mocą, która\nzniekształca nawet czas.\nUżytkownik musi\nodpocząć w następnej turze.</language>
	</row>
	<row id="msg_0749_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik rozrywa\nprzeciwnika razem z\nprzestrzenią wokół\nniego. Ten ruch ma\nwysoką szansę na trafienie krytyczne.</language>
	</row>
	<row id="msg_0749_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik mdleje. W\nzamian Pokémon, który\nzajmie jego miejsce,\nbędzie miał w pełni\nprzywrócone HP i status.</language>
	</row>
	<row id="msg_0749_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik jest\nmiażdżony wielką siłą.\nAtak jest silniejszy,\nim więcej HP zostało\nprzeciwnikowi.</language>
	</row>
	<row id="msg_0749_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik zostaje\nuwięziony w wirze ognia,\nktóry szaleje przez\ndwie do pięciu\ntur.</language>
	</row>
	<row id="msg_0749_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przeciwnik zostaje\nwciągnięty w świat\ncałkowitej ciemności,\nktóra usypia\ngo.\n</language>
	</row>
	<row id="msg_0749_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik generuje\nfalę uderzeniową z\nwnętrza swojego ciała.\nMoże też obniżyć Obronę\nSpecjalną celu.</language>
	</row>
	<row id="msg_0749_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik tworzy\npodmuch odrażającego\nwiatru. Może też\npodnieść wszystkie\nstatystyki użytkownika naraz.</language>
	</row>
	<row id="msg_0749_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Użytkownik znika, po\nczym trafia przeciwnika\nw drugiej turze.\nTrafia nawet, jeśli\nprzeciwnik się osłania.</language>
	</row>
</body>
