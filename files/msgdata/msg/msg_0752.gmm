<?xml version="1.0"?>
<body language="English">
	<row id="msg_0752_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: Miło cię poznać. Jestem Monica\nz Poniedziałku.\rW dowód naszej przyjaźni, mam dla\nciebie prezent!\r</language>
	</row>
	<row id="msg_0752_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: To przedmiot, który podnosi\nsiłę ruchów typu Flying.\rPowinieneś wyposażyć w niego jakiegoś\nptasiego Pokémona.</language>
	</row>
	<row id="msg_0752_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: Moje rodzeństwo jest\nrozsiane po całej okolicy.\rSprawdź, czy uda ci się znaleźć ich\nwszystkich!</language>
	</row>
	<row id="msg_0752_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: Och nie! Dziś nie jest\nponiedziałek. Do zobaczenia innym razem!</language>
	</row>
	<row id="msg_0752_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Pozwól, że się przedstawię.\nJestem Tuscany z Wtorku.\rNa powitanie, proszę, przyjmij ten\nprezent, Wygiętą Łyżkę.\r</language>
	</row>
	<row id="msg_0752_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Czyż nie zgodzisz się, że jest\nnajbardziej urocza?\rWzmacnia ruchy typu Psychic.\rJestem pewna, że się przyda.</language>
	</row>
	<row id="msg_0752_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Poznałeś Monicę, moją starszą\nsiostrę?\rAlbo mojego młodszego brata, Wesleya?\rJestem drugą z siedmiorga dzieci.</language>
	</row>
	<row id="msg_0752_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Wtorek minął, zanim\nw ogóle zauważyłam...\rZobaczymy się znowu w następny\nwtorek...</language>
	</row>
	<row id="msg_0752_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: Jestem Wesley ze Środy.\rMiło cię poznać. Proszę, weź\npamiątkę.\r</language>
	</row>
	<row id="msg_0752_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: Czarny Pas wzmacnia siłę\nruchów typu Fighting.</language>
	</row>
	<row id="msg_0752_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: Skoro mnie znalazłeś, musiałeś\nspotkać moje rodzeństwo.\rCzy może po prostu miałeś szczęście?</language>
	</row>
	<row id="msg_0752_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wesley: Nie ma mowy!\nŚroda już się skończyła!\fDo zobaczenia w przyszłym tygodniu!</language>
	</row>
	<row id="msg_0752_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: Kim jesteś?\rJestem Arthur z Czwartku.\rMasz, weź to!\r</language>
	</row>
	<row id="msg_0752_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: Jeśli używasz ruchów typu\nRock, powinieneś dać to swojemu\nPokémonowi.\rPodnosi to siłę ruchów\ntypu Rock.</language>
	</row>
	<row id="msg_0752_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: Jestem Arthur z Czwartku!\nJestem drugim synem w linii siedmiorga\frodzeństwa!</language>
	</row>
	<row id="msg_0752_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Arthur: Myślisz, że środek tygodnia\nto środa?\fCzy może myślisz, że to czwartek?\rZdecyduj się, a zobaczymy się\nw następny czwartek!</language>
	</row>
	<row id="msg_0752_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: Juhu! To piątek!\rJestem Frieda z Piątku!\nMiło cię poznać!\rMasz Trujący Kolec dla ciebie!\r</language>
	</row>
	<row id="msg_0752_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: Daj go Pokémonowi, który zna\nruchy typu Poison.\rOch! To jest niesamowite!\rBędziesz w szoku, jak dobrze wzmacnia\nruchy typu Poison!</language>
	</row>
	<row id="msg_0752_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: Cześć! Jaki dzień lubisz?\rJa uwielbiam piątek. Bez wątpienia!\rNie sądzisz, że to też jest świetne?</language>
	</row>
	<row id="msg_0752_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frieda: Och, dziś nie jest piątek?\rEch... Chciałabym, żeby każdy dzień był\npiątkiem, to byłaby taka zabawa!</language>
	</row>
	<row id="msg_0752_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: ...Jest sobota...\rJestem Santos z Soboty...\rWeź to...\r</language>
	</row>
	<row id="msg_0752_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: ...\rMiękki Piasek...\rRuchy typu Ground stają się\nsilniejsze...\nBędziesz zaskoczony...</language>
	</row>
	<row id="msg_0752_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: ...\rZobaczymy się znów w inną sobotę...</language>
	</row>
	<row id="msg_0752_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Santos: Dziś jest sobota...\nNie... Czekaj... Co?\rZobaczymy się w następną sobotę\nwięc...</language>
	</row>
	<row id="msg_0752_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sunny: Cześć! Jestem Sunny z Niedzieli,\nco znaczy, że dziś jest niedziela!\rKazano mi to dać, jeśli cię zobaczę!\r</language>
	</row>
	<row id="msg_0752_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sunny: Ta rzecz...\rUm...\r...Co to było...\r...\rOch! Teraz pamiętam!\rPokémon, który zna ruchy typu Electric,\npowinien to trzymać.\rMoja siostra Monica mówiła, że wzmacnia\nruchy typu Electric!</language>
	</row>
	<row id="msg_0752_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sunny: Moja siostra Monica...\nMoja siostra Tuscany...\fMój brat Wesley...\fMój brat Arthur...\fMoja siostra Frieda...\fI mój brat Santos.\rWszyscy są ode mnie starsi!</language>
	</row>
	<row id="msg_0752_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sunny: Co? Czy dziś nie jest niedziela?\nUm... Zapomniałam!</language>
	</row>
	<row id="msg_0752_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: Hej, ty!\nTen, który znalazł całe moje rodzeństwo!\fTak, ty!\rJesteśmy teraz całkiem dobrymi\nprzyjaciółmi, prawda?\rSkoro jesteśmy tak dobrymi przyjaciółmi,\ndam ci tę Wstążkę Czujności!\r</language>
	</row>
	<row id="msg_0752_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Monica: Ta Wstążka Czujności świetnie\nwygląda na twoim Pokémonie...</language>
	</row>
	<row id="msg_0752_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 0, 0, 0} założył Wstążkę Czujności!</language>
	</row>
	<row id="msg_0752_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz dostać tylko jedną wstążkę na\ntydzień...\rJeśli chcesz kolejną wstążkę, znajdź\nmnie znowu w przyszłym tygodniu!</language>
	</row>
	<row id="msg_0752_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tuscany: Hej, ty!\nTen, który znalazł całe moje rodzeństwo!\fTak, ty!\rJesteśmy teraz całkiem dobrymi\nprzyjaciółmi, prawda?\rSkoro jesteśmy tak dobrymi przyjaciółmi,\ndam ci tę Wstążkę Szoku!\r</language>
	</row>
	<row id="msg_0752_00033" index="33">
