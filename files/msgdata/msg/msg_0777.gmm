	<row id="msg_0777_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przycisk X: Zmień Profil</language>
	</row>
	<row id="msg_0777_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Goldver</language>
	</row>
	<row id="msg_0777_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Opuścić Wi-Fi Plaza i wrócić do\nPokémon Center?\r</language>
	</row>
	<row id="msg_0777_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NIE</language>
	</row>
