<?xml version="1.0"?>
<body language="English">
	<row id="msg_0777_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witamy w Wi-Fi Plaza!\rKażdy gość otrzymuje w wypożyczenie\nZabawkę Stukacz. Oto twoja!\r</language>
	</row>
	<row id="msg_0777_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} otrzymał/a {STRVAR_3 2, 1, 0}!</language>
	</row>
	<row id="msg_0777_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mam nadzieję, że spodoba ci się\ntwój pobyt do samego końca.\r</language>
	</row>
	<row id="msg_0777_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twoja wizyta w Wi-Fi Plaza dobiega\nkońca.\rDziękujemy za odwiedziny.\nMamy nadzieję, że wrócisz!\r</language>
	</row>
	<row id="msg_0777_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A tak przy okazji, jaki jest dziś twój\ntyp?\rChcesz określić siebie dwoma\ntypami?\r</language>
	</row>
	<row id="msg_0777_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jaki jest dziś twój pierwszy typ?</language>
	</row>
	<row id="msg_0777_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 15, 0, 0}</language>
	</row>
	<row id="msg_0777_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie wybieram</language>
	</row>
	<row id="msg_0777_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wybierasz typ {STRVAR_1 15, 0, 0}?</language>
	</row>
	<row id="msg_0777_00009" index="9">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0777_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jaki jest dziś twój drugi typ?</language>
	</row>
	<row id="msg_0777_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem! Wybrałeś/aś typy\n{STRVAR_1 15, 0, 0} i {STRVAR_1 15, 1, 0}.\r</language>
	</row>
	<row id="msg_0777_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumiem!\nWybrałeś/aś typ {STRVAR_1 15, 0, 0}.\r</language>
	</row>
	<row id="msg_0777_00013" index="13">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0777_00014" index="14">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0777_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Witamy w Wi-Fi Plaza!\rTo jest stanowisko informacji ogólnej.\r</language>
	</row>
	<row id="msg_0777_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Co chciałbyś/chciałabyś wiedzieć?\r</language>
	</row>
	<row id="msg_0777_00017" index="17">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0777_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przy wejściu do Wi-Fi Plaza znajduje\nsię ogromny globus.\rTen globus, zwany Profilami Gości,\npokazuje lokalizacje i lokalny czas\fodwiedzających Wi-Fi Plaza.\rBy zobaczyć gości, sprawdź panel,\nktóry pojawia się po naciśnięciu\fprzycisku A.\rWarto też sprawdzać balony, które\nod czasu do czasu przelatują obok.\r</language>
	</row>
	<row id="msg_0777_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Plaza News to elektroniczny wyświetlacz\npokazujący wydarzenia w Wi-Fi Plaza.\rJeśli nie wiesz, co robić, sprawdź\nPlaza News.\r</language>
	</row>
	<row id="msg_0777_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stempel Odcisków to panel, na którym\nmożesz bawić się odciskami łapek\fPokémonów z twojej drużyny.\rSą dwa panele, czarny i biały.\nBaw się dowolnym z nich.\r</language>
	</row>
	<row id="msg_0777_00021" index="21">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</language>
	</row>
	<row id="msg_0777_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mamy nadzieję, że dobrze się bawisz\nw Wi-Fi Plaza, zanim skończy się czas.\r</language>
	</row>
	<row id="msg_0777_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zabawki Stukacz to zabawki, którymi\nmożna bawić się tylko w Wi-Fi Plaza.\rOprócz zabawy nimi samemu,\nmożesz też dzielić się nimi\fz przyjaciółmi.\rZabawki Stukacz można też ulepszać,\ngrając w Gry Plaza.\rMamy nadzieję, że wymyślisz\nwłasne sposoby zabawy nimi!\r</language>
	</row>
	<row id="msg_0777_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_3 0, 0, 0} to jedna\nz Gier Plaza.\rMoże w niej brać udział do czterech\nosób.\rZasada jest prosta: wystrzeliwuj Jagody\nprosto do pyska obracającego się\fSWALOTA.\rGracz z najwyższym wynikiem otrzyma\nulepszenie Zabawki Stukacz.\r</language>
	</row>
	<row id="msg_0777_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_3 0, 0, 0} to jedna\nz Gier Plaza.\rMoże w niej brać udział do czterech\nosób.\rZasada jest prosta: tocz piłkę tak,\nby MIME JR. z niej nie spadł.\rGracz, który utrzyma MIME JR. na piłce\nnajdłużej, otrzyma ulepszenie\fZabawki Stukacz.\r</language>
	</row>
	<row id="msg_0777_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_3 0, 0, 0} to jedna\nz Gier Plaza.\rMoże w niej brać udział do czterech\nosób.\rZasada jest prosta: pompuj balony,\naż pękną.\rPęknij co najmniej dziesięć, a wszyscy\nuczestnicy otrzymają ulepszenie\fZabawki Stukacz.\r</language>
	</row>
	<row id="msg_0777_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy pozostały czas wizyty spadnie\nponiżej połowy, w Wi-Fi Plaza\fwłączają się reflektory.\rMamy nadzieję, że spodoba ci się\natmosfera, jaką tworzą.\r</language>
	</row>
	<row id="msg_0777_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy twój czas wizyty prawie się\nkończy, oświetlenie zostaje wyłączone.\rNastępnie w całej Wi-Fi Plaza\nodbywają się pokazy fajerwerków.\rMamy nadzieję, że spodobają ci się\nfajerwerki na zakończenie wizyty.\r</language>
	</row>
	<row id="msg_0777_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy twój czas wizyty się kończy, od\ntylnej prawej strony Wi-Fi Plaza\fpojawiają się Platformy Paradne.\rTe Platformy to pojazdy wzorowane\nna Pokémonach.\rMożesz wsiąść na Platformę i wrócić\nsamemu do Pokémon Center, albo\fpożegnać przyjaciół.\rPamiętaj, że po wejściu na Platformę\nnie możesz z niej zejść, aż opuści\fWi-Fi Plaza, po czym zostaniesz\frozłączony/a z Nintendo WFC.\r</language>
	</row>
	<row id="msg_0777_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Możesz wziąć udział w Ankiecie Plaza,\nkorzystając z maszyny obok\fstanowiska informacji ogólnej.\rSzczegóły uzyskasz u\nobsługi przy monitorze.\r</language>
	</row>
	<row id="msg_0777_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ZABAWKI STUKACZ</language>
	</row>
