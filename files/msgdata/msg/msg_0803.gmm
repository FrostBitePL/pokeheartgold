<?xml version="1.0"?>
<body language="English">
	<row id="msg_0803_00000" index="0">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0803_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nasiono na jego grzbiecie jest\npełne substancji odżywczych. Rośnie\nono stopniowo wraz z ciałem.</language>
	</row>
	<row id="msg_0803_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ekspozycja na słońce zwiększa\njego siłę. Słońce sprawia też, że\npąk na jego grzbiecie rośnie.</language>
	</row>
	<row id="msg_0803_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozkładając szerokie płatki\nswojego kwiatu i łapiąc promienie\nsłońca, napełnia ciało mocą.</language>
	</row>
	<row id="msg_0803_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Płomień na jego ogonie pokazuje\nsiłę jego życiowej energii. Gdy jest\nsłaby, płomień też słabo płonie.</language>
	</row>
	<row id="msg_0803_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest z natury bardzo porywczy,\nwięc stale szuka przeciwników.\nUspokaja się tylko po wygranej.</language>
	</row>
	<row id="msg_0803_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli CHARIZARD wpada w furię,\npłomień na czubku jego ogona\nrozbłyska jasnoniebieskim odcieniem.</language>
	</row>
	<row id="msg_0803_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skorupa jest miękka, gdy się rodzi.\nSzybko staje się tak twarda, że\nszturchające palce się od niej odbijają.</language>
	</row>
	<row id="msg_0803_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest uznanym symbolem\ndługowieczności. Jeśli jego skorupa ma\nalgi, ten WARTORTLE jest bardzo stary.</language>
	</row>
	<row id="msg_0803_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Celowo czyni się cięższy,\nby wytrzymać odrzut strumieni\nwody, które wystrzeliwuje.</language>
	</row>
	<row id="msg_0803_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dla ochrony wydziela okropny\nodór z czułków na głowie,\nby odstraszyć wrogów.</language>
	</row>
	<row id="msg_0803_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wewnątrz skorupy jest miękki i\nsłaby, gdy przygotowuje się do\newolucji. Pozostaje nieruchomy.</language>
	</row>
	<row id="msg_0803_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbiera miód każdego dnia. Rozciera\nmiód na włoskach na nogach, by\nzanieść go do gniazda.</language>
	</row>
	<row id="msg_0803_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego trujące żądło jest bardzo\npotężne. Jego jaskrawe ciało ma\nostrzegać jego wrogów.</language>
	</row>
	<row id="msg_0803_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć jest kokonem, potrafi się\ntrochę poruszać. Może wysunąć\ntrujący kolec, gdy zostanie zaatakowany.</language>
	</row>
	<row id="msg_0803_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może pokonać każdego przeciwnika\nswoimi potężnymi trującymi żądłami.\nCzasem atakuje w rojach.</language>
	</row>
	<row id="msg_0803_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle ukrywa się w wysokiej\ntrawie. Ponieważ nie lubi walczyć,\nchroni się, wzbijając piasek.</language>
	</row>
	<row id="msg_0803_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma wyjątkowy wzrok. Bez względu\nna to, jak wysoko leci, potrafi\nrozróżnić ruchy swojej ofiary.</language>
	</row>
	<row id="msg_0803_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego dobrze rozwinięte mięśnie\nklatki piersiowej pozwalają mu\nwzbić porywisty wicher kilkoma machnięciami.</language>
	</row>
	<row id="msg_0803_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Je wszystko. Gdziekolwiek jest\njedzenie, osiedla się i nieustannie\nwydaje potomstwo.</language>
	</row>
	<row id="msg_0803_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gryzie wszystko swoimi twardymi\nkłami. Może nawet obalić betonowe\nbudynki, gryząc je.</language>
	</row>
	<row id="msg_0803_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepocze krótkimi skrzydłami,\nby wypłoszyć owady z wysokiej\ntrawy. Potem chwyta je krótkim dziobem.</language>
	</row>
	<row id="msg_0803_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagle wystrzeliwuje wysoko w\nniebo, po czym spada jednym\nskokiem, by uderzyć swoją ofiarę.</language>
	</row>
	<row id="msg_0803_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może swobodnie odczepić szczękę,\nby połknąć dużą ofiarę w całości.\nMoże jednak stać się zbyt ciężki, by się ruszyć.</language>
	</row>
	<row id="msg_0803_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Paraliżując ofiarę wzorem\nprzypominającym twarz na brzuchu,\nwiąże i truje przerażoną ofiarę.</language>
	</row>
	<row id="msg_0803_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten inteligentny Pokémon piecze\ntwarde jagody elektrycznością,\nby zmiękczyć je do jedzenia.</language>
	</row>
	<row id="msg_0803_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jego elektryczność narasta,\njego mięśnie są pobudzone, staje\nsię bardziej agresywny niż zwykle.</language>
	</row>
	<row id="msg_0803_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdyby spadł z dużej wysokości,\nten Pokémon mógłby się uratować,\nzwijając się w kulę i odbijając.</language>
	</row>
	<row id="msg_0803_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Próbując się ukryć, biega z\nmaksymalną prędkością, by wzbić\noślepiającą burzę piaskową.</language>
	</row>
	<row id="msg_0803_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trucizna ukryta w jego małym\nrogu jest niezwykle silna. Nawet\nmałe zadrapanie może być śmiertelne.</language>
	</row>
	<row id="msg_0803_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Karmiąc swoje młode, najpierw\nprzeżuwa jedzenie na pastę, a potem\nwypluwa ją dla potomstwa.</language>
	</row>
	<row id="msg_0803_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało pokryte jest łuskami\nprzypominającymi igły. Nigdy nie\nokazuje strachu przed żadnym atakiem.</language>
	</row>
	<row id="msg_0803_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest mały, ale jego róg jest pełen\ntrucizny. Szarżuje, a potem dźga\nrogiem, by wstrzyknąć truciznę.</language>
	</row>
	<row id="msg_0803_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podnosi swoje duże uszy, by\nsprawdzić otoczenie. Jeśli coś\nwyczuje, natychmiast atakuje.</language>
	</row>
	<row id="msg_0803_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wymachuje swoim dużym ogonem\npodczas walki. Jeśli przeciwnik się\nwzdrygnie, szarżuje swoim mocnym ciałem.</language>
	</row>
	<row id="msg_0803_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Blask księżyca, który magazynuje\nw skrzydłach na grzbiecie, najwyraźniej\ndaje mu zdolność unoszenia się w powietrzu.</language>
	</row>
	<row id="msg_0803_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki wyostrzonemu słuchowi\npotrafi wychwycić dźwięki z daleka.\nZwykle ukrywa się w cichych miejscach.</language>
	</row>
	<row id="msg_0803_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W miarę rozwoju jego pojedynczy\nbiały ogon nabiera koloru i dzieli\nsię na sześć. Jest bardzo ciepły i przytulny.</language>
	</row>
	<row id="msg_0803_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niektóre legendy głoszą, że każdy\nz jego dziewięciu ogonów posiada\nwłasny, unikalny rodzaj mistycznej mocy.</language>
	</row>
	<row id="msg_0803_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli nadyma się, by zaśpiewać\nkołysankę, może grać dłużej i\nwywołać pewną senność u słuchaczy.</language>
	</row>
	<row id="msg_0803_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ich futro jest tak przyjemne w\ndotyku, że gdy dwa się przytulą,\nnie chcą się rozdzielić.</language>
	</row>
	<row id="msg_0803_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podczas lotu nieustannie\nwydaje z ust fale ultradźwiękowe,\nby sprawdzać otoczenie.</language>
	</row>
	<row id="msg_0803_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bez względu na to, jak twarda\njest skóra ofiary, przebija ją\nostrymi kłami i pije jej krew.</language>
	</row>
	<row id="msg_0803_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obudzony blaskiem księżyca,\naktywnie wędruje nocą. W dzień\nspokojnie przebywa pod ziemią.</language>
	</row>
	<row id="msg_0803_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To, co wygląda na ślinę, to\nw rzeczywistości słodki miód. Jest\nbardzo lepki i uparcie przywiera po dotknięciu.</language>
	</row>
	<row id="msg_0803_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma największe płatki na świecie.\nZ każdym krokiem płatki strząsają\nciężkie chmury toksycznego pyłku.</language>
	</row>
	<row id="msg_0803_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest oblewany zarodnikami\ngrzybów przy narodzinach. Wraz\nz rozwojem ciała, na jego grzbiecie wyrastają grzyby.</language>
	</row>
	<row id="msg_0803_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przebywa głównie w ciemnych,\nwilgotnych miejscach, co jest\npreferencją nie owada, lecz dużego grzyba na jego grzbiecie.</language>
	</row>
	<row id="msg_0803_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego oczy działają też jak radar.\nŁapie i zjada małe owady ukryte\nw ciemności.</language>
	</row>
	<row id="msg_0803_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy atakuje, gwałtownie trzepocze\nswoimi dużymi skrzydłami, by\nrozsiać wokół siebie trujący pył.</language>
	</row>
	<row id="msg_0803_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego skóra jest bardzo cienka.\nJeśli jest wystawiona na światło,\njego krew się rozgrzewa, przez co słabnie.</language>
	</row>
	<row id="msg_0803_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego trzy głowy kiwają się\nniezależnie w górę i w dół, by\nrozluźnić pobliską ziemię, ułatwiając kopanie.</language>
	</row>
	<row id="msg_0803_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest zafascynowany okrągłymi\nprzedmiotami. Nie może przestać\nsię nimi bawić, aż się zmęczy i zaśnie.</language>
	</row>
	<row id="msg_0803_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wielu uwielbia go za wyrafinowany\nsposób bycia. Jednak potrafi się\nrzucić i podrapać bez większego powodu.</language>
	</row>
	<row id="msg_0803_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma mistyczne moce, ale nie\npamięta, że ich użył. Dlatego\nzawsze wygląda na zdezorientowanego.</language>
	</row>
	<row id="msg_0803_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy pływa z pełną prędkością,\nużywając długich, błoniastych\nkończyn, jego czoło zaczyna jakoś świecić.</language>
	</row>
	<row id="msg_0803_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest niezwykle drażliwy.\nGrupy tych Pokémonów zaatakują\nkażdy dostępny cel bez powodu.</language>
	</row>
	<row id="msg_0803_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli podejść do niego, gdy śpi,\nmoże się obudzić i wściekle\nrzucić w pogoń w stanie zamroczenia.</language>
	</row>
	<row id="msg_0803_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma odważną i godną zaufania\nnaturę. Bez lęku staje naprzeciw\nwiększym i silniejszym przeciwnikom.</language>
	</row>
	<row id="msg_0803_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten legendarny chiński Pokémon\nuchodzi za wspaniałego. Wiele\nosób jest zauroczonych jego wielką grzywą.</language>
	</row>
	<row id="msg_0803_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ nie radzi sobie z\nchodzeniem na nowo wyrosłych\nnogach, zawsze pływa w wodzie.</language>
	</row>
	<row id="msg_0803_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wir na jego brzuchu delikatnie\nfaluje. Wpatrywanie się w niego\nmoże stopniowo wywoływać senność.</language>
	</row>
	<row id="msg_0803_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten silny i wprawny pływak jest\nnawet w stanie przepłynąć Ocean\nSpokojny, samymi kopnięciami.</language>
	</row>
	<row id="msg_0803_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyczuwa nadchodzące ataki i\nteleportuje się w bezpieczne\nmiejsce, zanim atak faktycznie trafi.</language>
	</row>
	<row id="msg_0803_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Posiada silną moc duchową. Im\nwiększe niebezpieczeństwo, na\njakie natrafi, tym silniejsza jego moc psychiczna.</language>
	</row>
	<row id="msg_0803_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zamknięcie obu oczu wyostrza\nwszystkie jego pozostałe zmysły.\nDzięki temu może wykorzystywać swoje zdolności do granic możliwości.</language>
	</row>
	<row id="msg_0803_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze pełen mocy, spędza czas,\npodnosząc głazy. Robiąc to,\nstaje się jeszcze silniejszy.</language>
	</row>
	<row id="msg_0803_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze działa z pełną mocą,\nale ten bardzo wytrzymały i\nodporny Pokémon nigdy się nie męczy.</language>
	</row>
	<row id="msg_0803_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybko wymachuje swoimi\nczterema ramionami, by wstrząsnąć\nprzeciwnikami nieustannymi ciosami i uderzeniami z każdej strony.</language>
	</row>
	<row id="msg_0803_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć jego ciało jest niezwykle\nchude, jest oślepiająco szybkie,\ngdy łapie swoją ofiarę.</language>
	</row>
	<row id="msg_0803_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć jest pełen kwasu, nie\ntopi się, bo wydziela też\nochronny płyn.</language>
	</row>
	<row id="msg_0803_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kwas, który rozpuścił wiele\nofiar, staje się słodszy, co czyni\ngo jeszcze skuteczniejszym w przyciąganiu ofiar.</language>
	</row>
	<row id="msg_0803_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy odpływ się cofa, na brzegu\nmożna znaleźć wysuszone szczątki\nTENTACOOL.</language>
	</row>
	<row id="msg_0803_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego 80 macek wchłania wodę i\nrozciąga się niemal w nieskończoność,\nby oplatać ofiary i wrogów.</language>
	</row>
	<row id="msg_0803_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Większość ludzi tego nie\nzauważa, ale przy bliższym spojrzeniu\nda się dostrzec wiele GEODUDE dookoła.</language>
	</row>
	<row id="msg_0803_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z wolną i beztroską naturą,\nnie przeszkadza mu, gdy kawałki\nodpadają, kiedy toczy się z gór.</language>
	</row>
	<row id="msg_0803_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrzuca skórę raz w roku.\nOdrzucona skorupa natychmiast\ntwardnieje i się kruszy.</language>
	</row>
	<row id="msg_0803_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaraz po urodzeniu jest\nsłabym biegaczem. Stopniowo\nstaje się szybszy, ścigając rodziców.</language>
	</row>
	<row id="msg_0803_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W pełnym galopie jego cztery\nkopyta ledwie dotykają ziemi,\nbo porusza się niewiarygodnie szybko.</language>
	</row>
	<row id="msg_0803_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leniwie leży w pobliżu wody.\nJeśli coś ugryzie go w ogon,\nmoże nawet nie zauważyć tego przez cały dzień.</language>
	</row>
	<row id="msg_0803_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli SHELLDER gryzące go za\nogon zostanie zrzucone podczas\nzaciekłej walki, wraca do bycia zwykłym SLOWPOKE.</language>
	</row>
	<row id="msg_0803_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest przyciągane przez fale\nelektromagnetyczne. Może zbliżać\nsię do trenerów używających Pokégeara.</language>
	</row>
	<row id="msg_0803_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzy MAGNEMITE są połączone\nsilną siłą magnetyczną. Ból ucha\nwystąpi, jeśli podejdziesz zbyt blisko.</language>
	</row>
	<row id="msg_0803_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli ktoś próbuje zaburzyć\nmiejsce, gdzie rosną niezbędne\nłodygi roślin, używa własnej łodygi, by go powstrzymać.</language>
	</row>
	<row id="msg_0803_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naprzemiennie podnosząc i\nopuszczając swoje dwie głowy,\nbalansuje, by być stabilniejszy podczas biegu.</language>
	</row>
	<row id="msg_0803_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbiera dane i planuje trzy\nrazy mądrzej, ale może myśleć\nzbyt dużo i popaść w stan bezruchu.</language>
	</row>
	<row id="msg_0803_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć nie potrafi dobrze chodzić\nna lądzie, jest wdzięcznym\npływakiem. Szczególnie kocha przebywać w lodowatych morzach.</language>
	</row>
	<row id="msg_0803_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego opływowe ciało ma\nniewielki opór w wodzie. Im\nzimniejsza temperatura, tym bardziej jest żwawy.</language>
	</row>
	<row id="msg_0803_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy się porusza, traci kawałki\nswojego ciała, z których wyłaniają\nsię nowe GRIMER. To pogarsza smród wokół niego.</language>
	</row>
	<row id="msg_0803_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbiają gromadzić się w\nśmierdzących miejscach, gdzie\ngromadzi się szlam, pogarszając smród wokół siebie.</language>
	</row>
	<row id="msg_0803_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pływa tyłem, otwierając i\nzamykając swoją dwuczęściową\nskorupę. Jest zaskakująco szybki.</language>
	</row>
	<row id="msg_0803_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy raz zatrzaśnie swoją\nskorupę, nie da się jej otworzyć,\nnawet siłą osób o nadzwyczajnej mocy.</language>
	</row>
	<row id="msg_0803_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki gazopodobnemu ciału\nmoże wśliznąć się w dowolne\nmiejsce. Może jednak zostać zdmuchnięty przez wiatr.</language>
	</row>
	<row id="msg_0803_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W całkowitej ciemności, gdzie\nnic nie widać, HAUNTER czai\nsię, cicho śledząc swoją kolejną ofiarę.</language>
	</row>
	<row id="msg_0803_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kradnie ciepło z otoczenia.\nJeśli poczujesz nagły chłód, to\nna pewno pojawił się GENGAR.</language>
	</row>
	<row id="msg_0803_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wije się i przeciska przez\nziemię. Grzmiący huk jego\ndrążenia rozchodzi się daleko.</language>
	</row>
	<row id="msg_0803_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli myślisz, że miałeś dobry\nsen, ale nie możesz go sobie\nprzypomnieć, prawdopodobnie zjadł go DROWZEE.</language>
	</row>
	<row id="msg_0803_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jest bardzo głodny,\nusypia napotkanych ludzi, a\npotem ucztuje na ich snach.</language>
	</row>
	<row id="msg_0803_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli wyczuje zbliżające się\nniebezpieczeństwo, otula się\nbańkami z ust, by wyglądać na większego.</language>
	</row>
	<row id="msg_0803_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ledwie może unieść swoje\nmasywne, przerośnięte szczypce.\nRozmiar szczypiec utrudnia mu celne uderzenia.</language>
	</row>
	<row id="msg_0803_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toczy się, by się poruszać.\nJeśli teren jest nierówny, nagły\nwstrząs od uderzenia w wybój może spowodować jego wybuch.</language>
	</row>
	<row id="msg_0803_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest niebezpieczny. Jeśli ma\nzbyt dużo elektryczności i nie\nma nic do roboty, bawi się, wybuchając.</language>
	</row>
	<row id="msg_0803_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ich skorupy są bardzo\nwytrzymałe. Nawet jeśli pękną,\nmogą przetrwać bez rozlania zawartości.</language>
	</row>
	<row id="msg_0803_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego trzy głowy myślą\nniezależnie. Jednak są przyjazne\ni nigdy nie wydają się kłócić.</language>
	</row>
	<row id="msg_0803_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jest smutny lub samotny,\nczaszka, którą nosi, trzęsie się\ni wydaje żałosny, żałobny dźwięk.</language>
	</row>
	<row id="msg_0803_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widziano, jak wali głazami\nkością, którą nosi, by wystukiwać\nwiadomości dla innych.</language>
	</row>
	<row id="msg_0803_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten niesamowity Pokémon ma\ndoskonałe wyczucie równowagi.\nMoże kopać kolejno z dowolnej pozycji.</language>
	</row>
	<row id="msg_0803_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciosy rozcinają powietrze.\nJednak wydaje się, że po walce\ntrwającej trzy minuty potrzebuje krótkiej przerwy.</language>
	</row>
	<row id="msg_0803_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego język ma dobrze rozwinięte\nnerwy sięgające samego czubka,\nwięc może być zręcznie kontrolowany.</language>
	</row>
	<row id="msg_0803_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego cienkie, błoniaste ciało\njest wypełnione gazami, które\npowodują ciągłe pociąganie nosem, kaszel i łzawienie oczu.</language>
	</row>
	<row id="msg_0803_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jeden z bliźniaczych\nKOFFING nadmie się, drugi\nzwiotczeje. Nieustannie miesza swoje trujące gazy.</language>
	</row>
	<row id="msg_0803_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma trudności ze skręcaniem\nz powodu czterech krótkich nóg.\nMoże tylko szarżować i biec w jednym kierunku.</language>
	</row>
	<row id="msg_0803_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego szorstka skóra chroni go\nnawet przed żarem lawy. Jednak\nskóra sprawia też, że jest mało czuły.</language>
	</row>
	<row id="msg_0803_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chodzi ostrożnie, by zapobiec\nstłuczeniu swojego jajka. Jednak\njest niezwykle szybki w ucieczce.</language>
	</row>
	<row id="msg_0803_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pnącza, które okrywają całe\njego ciało, zawsze delikatnie\ndrgają. Skutecznie niepokoją jego wrogów.</language>
	</row>
	<row id="msg_0803_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jest bezpiecznie, młode\nwychodzi z brzusznej torby, by\nsię bawić. Dorosły uważnie obserwuje młodego.</language>
	</row>
	<row id="msg_0803_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zaatakuje go większy\nwróg, szybko odpływa w\nbezpieczne miejsce, sprawnie kontrolując swoją dobrze rozwiniętą płetwę grzbietową.</language>
	</row>
	<row id="msg_0803_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Badanie jego komórek ujawniło\nobecność genu, którego nie ma\nu HORSEA. Stało się to gorącym tematem.</language>
	</row>
	<row id="msg_0803_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego płetwy grzbietowa,\npiersiowe i ogonowa falują elegancko\nw wodzie. Dlatego znany jest jako tancerz wody.</language>
	</row>
	<row id="msg_0803_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W sezonie tarła SEAKING\ngromadzą się zewsząd, sprawiając,\nże rzeki wydają się lśniąco czerwone.</language>
	</row>
	<row id="msg_0803_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nocą środkowa część jego ciała\npowoli migocze w tym samym\nrytmie, co ludzkie bicie serca.</language>
	</row>
	<row id="msg_0803_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Środkowa część jego ciała\nnazywana jest rdzeniem. Świeci\ninnym kolorem za każdym razem, gdy jest widziany.</language>
	</row>
	<row id="msg_0803_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Utalentowany mim od urodzenia,\nz wiekiem zyskuje zdolność\ntworzenia niewidzialnych przedmiotów.</language>
	</row>
	<row id="msg_0803_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przecina trawę swoimi ostrymi\nkosami, poruszając się zbyt\nszybko, by ludzkie oko mogło za nim nadążyć.</language>
	</row>
	<row id="msg_0803_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kołysze ciałem w rytmiczny\nsposób. Wygląda na to, że zmienia\nrytm w zależności od nastroju.</language>
	</row>
	<row id="msg_0803_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elektryczność przebiega po\npowierzchni jego ciała. W ciemności\ncałe jego ciało świeci biało-niebieskim blaskiem.</language>
	</row>
	<row id="msg_0803_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie lubi zimnych miejsc, więc\nwydmuchuje palące płomienie, by\nuczynić otoczenie odpowiednim dla siebie.</language>
	</row>
	<row id="msg_0803_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swoimi szczypcowymi rogami\nkopie nory, w których śpi nocą.\nRano wilgotna ziemia przywiera do jego ciała.</language>
	</row>
	<row id="msg_0803_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczą ze sobą, splatając\nrogi. Obrońca stada jest dumny\nze swoich pokrytych bliznami rogów.</language>
	</row>
	<row id="msg_0803_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Osłabiony, żałosny Pokémon.\nMoże czasem skoczyć wysoko, ale\nzwykle nie wyżej niż siedem stóp.</language>
	</row>
	<row id="msg_0803_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że w czasach dawnych\nkonfliktów GYARADOS pojawiał\nsię i zostawiał za sobą płonące ruiny.</language>
	</row>
	<row id="msg_0803_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mają łagodne serca. Ponieważ\nrzadko walczą, wiele z nich\nzłapano. Ich liczba się zmniejszyła.</language>
	</row>
	<row id="msg_0803_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może przekształcić się w\ncokolwiek. Gdy śpi, zamienia się\nw kamień, by uniknąć ataku.</language>
	</row>
	<row id="msg_0803_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma zdolność zmiany składu\nswojego ciała, by dopasować się\ndo otaczającego środowiska.</language>
	</row>
	<row id="msg_0803_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy płetwy VAPOREONA zaczynają\ndrgać, jest to znak, że w ciągu\nkilku godzin nadejdzie deszcz.</language>
	</row>
	<row id="msg_0803_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Koncentruje słabe ładunki\nelektryczne wydzielane przez\nswoje komórki i wystrzeliwuje złowieszcze pioruny.</language>
	</row>
	<row id="msg_0803_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Magazynuje część powietrza,\nktóre wdycha, w wewnętrznym\nworku ognia, który podgrzewa je do ponad 1650 stopni Celsjusza.</language>
	</row>
	<row id="msg_0803_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest sztucznym Pokémonem.\nPonieważ nie oddycha, ludzie\nchętnie wypróbowują go w dowolnym środowisku.</language>
	</row>
	<row id="msg_0803_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ożywiony ze starożytnej\nskamieliny, ten Pokémon używa\npowietrza zmagazynowanego w skorupie, by tonąć i wynurzać się w wodzie.</language>
	</row>
	<row id="msg_0803_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podobno rozłupał skorupę\nSHELLDERA swoimi ostrymi\nkłami i wyssał jej wnętrze.</language>
	</row>
	<row id="msg_0803_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czasem znajdowano niektóre\njako skamieliny, w które zamieniły\nsię, ukrywając się na dnie oceanu.</language>
	</row>
	<row id="msg_0803_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W wodzie chowa kończyny, by\nstać się bardziej opływowy, po\nczym macha skorupą, by szybko pływać.</language>
	</row>
	<row id="msg_0803_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Okrutny Pokémon z odległej\nprzeszłości, wygląda na to, że\nlatał, rozkładając skrzydła i szybując.</language>
	</row>
	<row id="msg_0803_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To, co brzmi jak jego krzyk, może\nw rzeczywistości być jego\nchrapaniem lub burczeniem głodnego brzucha.</language>
	</row>
	<row id="msg_0803_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wspaniałe, pozornie\nprzezroczyste skrzydła tego\nlegendarnego ptasiego Pokémona podobno zrobione są z lodu.</language>
	</row>
	<row id="msg_0803_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten legendarny ptasi Pokémon\nwywołuje gwałtowne burze,\ntrzepocząc swoimi lśniącymi skrzydłami.</language>
	</row>
	<row id="msg_0803_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten legendarny Pokémon\nrozsypuje żar z każdym uderzeniem\nskrzydeł. To ekscytujący widok.</language>
	</row>
	<row id="msg_0803_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Od razu rodzi się duży.\nWielokrotnie zrzuca skórę, stopniowo\nstając się coraz dłuższy.</language>
	</row>
	<row id="msg_0803_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jeśli wydzieli\naurę z całego ciała, pogoda\nzacznie się natychmiast zmieniać.</language>
	</row>
	<row id="msg_0803_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten Pokémon\nnieustannie lata nad ogromnymi\nmorzami, ratując tonących ludzi.</language>
	</row>
	<row id="msg_0803_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ jego zdolności bojowe\nzostały podniesione do ostatecznego\npoziomu, myśli tylko o pokonaniu swoich wrogów.</language>
	</row>
	<row id="msg_0803_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podobno pojawia się tylko\nprzed ludźmi o czystym sercu i\nsilnym pragnieniu, by go zobaczyć.</language>
	</row>
	<row id="msg_0803_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słodki aromat delikatnie unosi\nsię z liścia na jego głowie. Jest\nłagodny i uwielbia wygrzewać się w słońcu.</language>
	</row>
	<row id="msg_0803_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapach przypraw dochodzi z\nokolic jego szyi. Jakoś, wąchanie\ngo sprawia, że chce się walczyć.</language>
	</row>
	<row id="msg_0803_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aromat unoszący się z jego\npłatków zawiera substancję, która\nuspokaja agresywne emocje.</language>
	</row>
	<row id="msg_0803_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest nieśmiały i zawsze zwija\nsię w kulę. Jeśli zostanie\nzaatakowany, rozpala swój grzbiet dla ochrony.</language>
	</row>
	<row id="msg_0803_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważaj, jeśli odwróci się\ntyłem podczas walki. Oznacza to,\nże zaatakuje ogniem na swoim grzbiecie.</language>
	</row>
	<row id="msg_0803_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jego wściekłość osiągnie\nszczyt, staje się tak gorący, że\nwszystko, co go dotknie, natychmiast staje w płomieniach.</language>
	</row>
	<row id="msg_0803_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego potężne, dobrze rozwinięte\nszczęki są w stanie zmiażdżyć\nwszystko. Nawet jego trener musi być ostrożny.</language>
	</row>
	<row id="msg_0803_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli straci kieł, w jego miejsce\nwyrasta nowy. W jego pysku\nzawsze znajduje się 48 kłów.</language>
	</row>
	<row id="msg_0803_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy gryzie swoimi masywnymi i\npotężnymi szczękami, potrząsa\ngłową i dziko rozrywa swoją ofiarę.</language>
	</row>
	<row id="msg_0803_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardzo ostrożny Pokémon,\npodnosi się na swoim ogonie, by\nlepiej widzieć otoczenie.</language>
	</row>
	<row id="msg_0803_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buduje gniazdo dopasowane do\nswojego długiego, chudego ciała.\nInne Pokémony nie mogą się do niego dostać.</language>
	</row>
	<row id="msg_0803_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze stoi na jednej nodze.\nZmienia nogi tak szybko, że ten\nruch rzadko można zobaczyć.</language>
	</row>
	<row id="msg_0803_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego oczy są specjalnie\nprzystosowane. Skupiają nawet\nsłabe światło, umożliwiając mu widzenie w ciemności.</language>
	</row>
	<row id="msg_0803_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest bardzo nieśmiały. Boi się\nporuszać, gdy jest sam. Ale jest\naktywny, gdy jest w grupie.</language>
	</row>
	<row id="msg_0803_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy gwiazdy migoczą na\nnocnym niebie, trzepocze wokół,\nrozsypując świecący pyłek.</language>
	</row>
	<row id="msg_0803_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leży nieruchomo w tej samej\npozie przez wiele dni w swojej\npajęczynie, czekając, aż niczego niespodziewająca się ofiara podejdzie blisko.</language>
	</row>
	<row id="msg_0803_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wytwarza nić nie tylko z tyłu\nciała, ale też z ust. Trudno\nrozróżnić, który koniec jest który.</language>
	</row>
	<row id="msg_0803_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lata tak cicho przez ciemność\nna swoich czterech skrzydłach,\nże może nie zostać zauważony nawet z bliska.</language>
	</row>
	<row id="msg_0803_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wystrzeliwuje dodatnią i ujemną\nelektryczność między końcówkami\nswoich dwóch czułków, rażąc wrogów.</language>
	</row>
	<row id="msg_0803_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Światło, które emituje, jest\ntak jasne, że może oświetlić\npowierzchnię morza z głębokości ponad pięciu kilometrów.</language>
	</row>
	<row id="msg_0803_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jest jeszcze wprawny w\nmagazynowaniu elektryczności.\nMoże wysłać wyładowanie, gdy jest rozbawiony lub przestraszony.</language>
	</row>
	<row id="msg_0803_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ze względu na swoją\nniezwykłą, gwiaździstą sylwetkę,\nludzie wierzą, że przybył tu na meteorze.</language>
	</row>
	<row id="msg_0803_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma bardzo miękkie ciało. Jeśli\nzacznie się toczyć, będzie się\nodbijać wszędzie i nie da się go zatrzymać.</language>
	</row>
	<row id="msg_0803_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skorupa wydaje się być pełna\nradości. Mówi się, że dzieli\nsię szczęściem, gdy jest dobrze traktowana.</language>
	</row>
	<row id="msg_0803_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że pojawia się przed\ndobrymi, troskliwymi ludźmi i\nobsypuje ich szczęściem.</language>
	</row>
	<row id="msg_0803_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ jego skrzydła nie są\njeszcze w pełni rozwinięte, musi\nskakać, by się przemieszczać. Zawsze wpatruje się w coś.</language>
	</row>
	<row id="msg_0803_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że pozostaje\nnieruchomy i cichy, ponieważ\nwidzi jednocześnie przeszłość i przyszłość.</language>
	</row>
	<row id="msg_0803_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli w jego ciele narośnie\nelektryczność statyczna, jego\nwełna podwaja objętość. Dotknięcie go poraża.</language>
	</row>
	<row id="msg_0803_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W wyniku magazynowania zbyt\ndużej ilości elektryczności\nrozwinęły się u niego łaty, gdzie nie rośnie nawet puszysta wełna.</language>
	</row>
	<row id="msg_0803_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czubek jego ogona jasno\nświeci i widać go z daleka.\nDziała jak latarnia dla zagubionych ludzi.</language>
	</row>
	<row id="msg_0803_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BELLOSSOM czasem gromadzą się\ni wydają się tańczyć. Mówi się,\nże ten taniec to rytuał przywoływania słońca.</language>
	</row>
	<row id="msg_0803_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czubek jego ogona, zawierający\nolej lżejszy od wody, pozwala mu\npływać bez tonięcia.</language>
	</row>
	<row id="msg_0803_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozostając w bezruchu i\nuważnie nasłuchując, może rozpoznać,\nco kryje się nawet w dzikich, wartkich rzekach.</language>
	</row>
	<row id="msg_0803_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć zawsze udaje drzewo, jego\nbudowa wydaje się bardziej\npodobna do skały niż do roślinności.</language>
	</row>
	<row id="msg_0803_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli POLIWAG i POLIWHIRL\nusłyszą jego echoczący krzyk,\nodpowiadają, gromadząc się z daleka i szeroka.</language>
	</row>
	<row id="msg_0803_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By nie zostać zdmuchniętymi\nprzez wiatr, gromadzą się w\ngronach. Ale uwielbiają łagodne powiewy.</language>
	</row>
	<row id="msg_0803_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kwiat na czubku jego głowy\notwiera się i zamyka wraz ze\nzmieniającą się temperaturą.</language>
	</row>
	<row id="msg_0803_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy raz złapie wiatr, sprawnie\nkontroluje swoje bawełniane\nzarodniki--może nawet unosić się dookoła świata.</language>
	</row>
	<row id="msg_0803_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ogon jest tak silny, że\nmoże nim chwycić gałąź drzewa\ni utrzymać się w powietrzu.</language>
	</row>
	<row id="msg_0803_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może spaść z nieba. Jeśli\nzostanie zaatakowany przez\nSPEAROW, gwałtownie potrząśnie liśćmi.</language>
	</row>
	<row id="msg_0803_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przekształca światło słoneczne\nw energię. W ciemności po\nzachodzie słońca zamyka płatki i znieruchomieje.</language>
	</row>
	<row id="msg_0803_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli macha skrzydłami\nnaprawdę szybko, może wytworzyć\nfale uderzeniowe, które roztrzaskają okna w okolicy.</language>
	</row>
	<row id="msg_0803_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon żyje w zimnej\nwodzie. Opuszcza wodę, by szukać\njedzenia, gdy na zewnątrz robi się zimno.</language>
	</row>
	<row id="msg_0803_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten beztroski Pokémon ma\nlekkoduchą naturę. Podczas\npływania zawsze wpada na kadłuby łodzi.</language>
	</row>
	<row id="msg_0803_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa cienkich włosków\npokrywających ciało, by wyczuwać\nprądy powietrza i przewidywać ruchy wroga.</language>
	</row>
	<row id="msg_0803_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jest pobudzony, ten\nPokémon chroni się, wypryskując\ntrujący pot ze swoich porów.</language>
	</row>
	<row id="msg_0803_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wielu się go boi i nim gardzi,\nwierzy się, że przynosi\nnieszczęście każdemu, kto go zobaczy nocą.</language>
	</row>
	<row id="msg_0803_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma niesamowitą inteligencję i\nintuicję. Bez względu na sytuację,\npozostaje spokojny i opanowany.</language>
	</row>
	<row id="msg_0803_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lubi płatać psikusy, takie jak\nkrzyczenie i zawodzenie, by\nprzestraszyć ludzi nocą.</language>
	</row>
	<row id="msg_0803_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ich kształty przypominają\nhieroglify na starożytnych\ntablicach. Mówi się, że oba są ze sobą powiązane.</language>
	</row>
	<row id="msg_0803_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nienawidzi światła i\nwstrząsów. Jeśli zostanie\nzaatakowany, nadyma ciało, by wzmocnić kontratak.</language>
	</row>
	<row id="msg_0803_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ogon ma własny, niewielki\nmózg. Uważaj! Jeśli podejdziesz\nblisko, może zareagować na twój zapach ugryzieniem.</language>
	</row>
	<row id="msg_0803_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lubi pogrubiać swoją skorupę,\ndodając warstwy kory drzewa.\nDodatkowa waga mu nie przeszkadza.</language>
	</row>
	<row id="msg_0803_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Całe jego ciało chronione jest\nskorupą twardą jak stal. To, co\nkryje się wewnątrz tej skorupy, to całkowita tajemnica.</language>
	</row>
	<row id="msg_0803_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy zostanie zauważony, ten\nPokémon ucieka do tyłu,\nzawzięcie wwiercając się ogonem w ziemię.</language>
	</row>
	<row id="msg_0803_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Leci prosto w twarz swojego\ncelu, po czym zaciska się na\nzaskoczonej ofierze, wstrzykując truciznę.</language>
	</row>
	<row id="msg_0803_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało zostało sprasowane\ngłęboko pod ziemią. W\nrezultacie jest twardsze nawet od diamentu.</language>
	</row>
	<row id="msg_0803_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć wygląda przerażająco,\njest w rzeczywistości miły i\nczuły. Jest bardzo popularny wśród kobiet.</language>
	</row>
	<row id="msg_0803_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest w rzeczywistości nieśmiały\ni łatwo się przestraszy. Jeśli\nzostanie zaatakowany, wymachuje, by odeprzeć napastnika.</language>
	</row>
	<row id="msg_0803_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By wystrzelić swoje trujące\nkolce, musi nadmuchać swoje\nciało, wypijając ponad dziesięć litrów wody naraz.</language>
	</row>
	<row id="msg_0803_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wymachuje szczypcami z\nwzorem przypominającym oczy,\nby wystraszyć wrogów. To sprawia, że wygląda, jakby miał trzy głowy.</language>
	</row>
	<row id="msg_0803_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jagody, które przechowuje w\nswojej skorupie w kształcie wazonu,\nrozkładają się i stają się kleistą cieczą.</language>
	</row>
	<row id="msg_0803_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten potężny Pokémon wbija\nswój cenny róg pod brzuchy\nwrogów, po czym unosi ich i rzuca.</language>
	</row>
	<row id="msg_0803_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego łapy skrywają ostre\npazury. Jeśli zostanie zaatakowany,\nnagle je wysuwa i przestrasza wroga.</language>
	</row>
	<row id="msg_0803_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli znajdzie miód, jego\nksiężycowaty znak świeci. Zawsze\noblizuje łapy, bo są nasączone miodem.</language>
	</row>
	<row id="msg_0803_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć jest dobrym wspinaczem,\npreferuje łamanie drzew\nprzednimi łapami i jedzenie spadłych jagód.</language>
	</row>
	<row id="msg_0803_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie śpi. Musi ciągle się\nporuszać, bo gdyby przestał,\njego magmowe ciało by ostygło i stwardniało.</language>
	</row>
	<row id="msg_0803_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skorupa na jego grzbiecie to\npo prostu skóra, która ostygła i\nstwardniała. Łamie się łatwo przy lekkim dotknięciu.</language>
	</row>
	<row id="msg_0803_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ociera pyskiem o ziemię, by\nznaleźć i wykopać jedzenie.\nCzasem odkrywa gorące źródła.</language>
	</row>
	<row id="msg_0803_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ długie włosy na\ncałym ciele przesłaniają mu\nwzrok, po prostu ciągle szarżuje.</language>
	</row>
	<row id="msg_0803_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieustannie zrzuca i odrasta.\nCzubek jego głowy ceniony jest\njako skarb za swoje piękno.</language>
	</row>
	<row id="msg_0803_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma znakomitą celność. Woda,\nktórą wystrzeliwuje, może trafić\nporuszającą się ofiarę z odległości ponad 90 metrów.</language>
	</row>
	<row id="msg_0803_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Więzi wrogów przyssawkami na\nswoich mackach, po czym rozbija\nich swoją twardą jak skała głową.</language>
	</row>
	<row id="msg_0803_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nosi jedzenie przez cały\ndzień. Krążą opowieści o\nzagubionych ludziach uratowanych dzięki jego zapasom jedzenia.</language>
	</row>
	<row id="msg_0803_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy majestatycznie pływa,\nnie przeszkadza mu, gdy\nprzyczepiają się do niego REMORAID, żywiąc się jego resztkami.</language>
	</row>
	<row id="msg_0803_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego solidne skrzydła wyglądają\nna ciężkie, ale są w\nrzeczywistości puste i lekkie, co pozwala mu swobodnie latać po niebie.</language>
	</row>
	<row id="msg_0803_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa różnych rodzajów\nkrzyków do komunikowania się z\ninnymi z jego gatunku i ścigania ofiar.</language>
	</row>
	<row id="msg_0803_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zostaniesz poparzony\npłomieniami, które wystrzeliwuje\nz pyska, ból nigdy nie zniknie.</language>
	</row>
	<row id="msg_0803_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że zwykle ukrywa\nsię w podwodnych jaskiniach.\nMoże tworzyć wiry, ziewając.</language>
	</row>
	<row id="msg_0803_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wymachuje swoim długim\npyskiem zabawowo, ale ponieważ\njest tak silny, może to być niebezpieczne.</language>
	</row>
	<row id="msg_0803_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma ostre, twarde kły i\nszorstką skórę. Jego szarża jest\nna tyle silna, by zwalić dom.</language>
	</row>
	<row id="msg_0803_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ta ulepszona wersja PORYGONA\nzaprojektowana jest do eksploracji\nkosmosu. Nie potrafi jednak latać.</language>
	</row>
	<row id="msg_0803_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zakrzywione rogi subtelnie\nzmieniają przepływ powietrza,\ntworząc dziwną przestrzeń, w której zniekształca się rzeczywistość.</language>
	</row>
	<row id="msg_0803_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Specjalny płyn wycieka z\nczubka jego ogona. Maluje nim\nwszędzie, by wyznaczyć swoje terytorium.</language>
	</row>
	<row id="msg_0803_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze tryska energią. By\nstać się silniejszym, wciąż\nwalczy, nawet jeśli przegrywa.</language>
	</row>
	<row id="msg_0803_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli oczaruje cię jego\ngładkie, taneczne kopnięcia,\nmożesz doświadczyć bliższego kontaktu z nim, niż byś chciał.</language>
	</row>
	<row id="msg_0803_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego usta są najbardziej\nczułą częścią ciała. Zawsze\nnajpierw używa ust, by zbadać rzeczy.</language>
	</row>
	<row id="msg_0803_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obraca ramionami, by\nwytworzyć elektryczność, ale\nszybko się męczy, więc ładuje się tylko trochę.</language>
	</row>
	<row id="msg_0803_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Za każdym razem, gdy wdycha\ni wydycha powietrze, z jego ust\ni nozdrzy kapią gorące żarzące się iskry.</language>
	</row>
	<row id="msg_0803_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego mleko jest pełne\nsubstancji odżywczych, co czyni\nje najlepszym napojem dla chorych lub zmęczonych.</language>
	</row>
	<row id="msg_0803_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Każdy, kto choć raz spróbuje\njajka BLISSEY, staje się\nniezawodnie troskliwy i miły dla wszystkich.</language>
	</row>
	<row id="msg_0803_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chmury deszczowe, które niesie,\npozwalają mu wystrzeliwać\npioruny na życzenie. Mówi się, że zstąpił z błyskawicą.</language>
	</row>
	<row id="msg_0803_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wulkany wybuchają, gdy\nszczeka. Nie mogąc powstrzymać\nswojej ogromnej mocy, pędzi na oślep po całej krainie.</language>
	</row>
	<row id="msg_0803_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważany za ucieleśnienie\npółnocnych wiatrów, potrafi\nnatychmiast oczyścić brudną, mętną wodę.</language>
	</row>
	<row id="msg_0803_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żywi się ziemią. Po zjedzeniu\ncałej wielkiej góry, zasypia,\nby móc rosnąć.</language>
	</row>
	<row id="msg_0803_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego skorupa jest twarda jak\npłyta skalna i jest też bardzo\nsilny. Jego szamotanina może przewrócić górę.</language>
	</row>
	<row id="msg_0803_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało nie może zostać\nzranione żadnym rodzajem ataku,\nwięc chętnie rzuca wyzwania wrogom.</language>
	</row>
	<row id="msg_0803_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że spędza czas\nspokojnie głęboko na dnie morza,\nbo jego moce są zbyt silne.</language>
	</row>
	<row id="msg_0803_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Legendy głoszą, że ten\nPokémon nieustannie lata po\nniebie świata na swoich wspaniałych, siedmiobarwnych skrzydłach.</language>
	</row>
	<row id="msg_0803_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon wędruje przez\nczas. Trawa i drzewa kwitną w\nlasach, w których się pojawił.</language>
	</row>
	<row id="msg_0803_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Małe haczyki pod jego\nstopami zaczepiają się o ściany\ni sufity. Tak może zwisać nad głową.</language>
	</row>
	<row id="msg_0803_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skacze z gałęzi na gałąź\ndość zwinnie. Wykazuje\nzdumiewającą zwinność.</language>
	</row>
	<row id="msg_0803_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwinnie skacze po dżungli i\nużywa ostrych liści na\nramionach, by uderzyć swoją ofiarę.</language>
	</row>
	<row id="msg_0803_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wewnątrz jego ciała jest\nmiejsce, gdzie przechowuje mały\npłomień. Przytul go! Będzie ciepły jak termofor.</language>
	</row>
	<row id="msg_0803_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podczas walki gorący płomień\nw jego ciele nasila się. Jego\nkopnięcia mają niesamowitą siłę niszczenia.</language>
	</row>
	<row id="msg_0803_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może pokonać 30-piętrowy\nbudynek jednym skokiem. Jego\nogniste ciosy palą wrogów.</language>
	</row>
	<row id="msg_0803_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego siła może zmiażdżyć\ngłazy. Odpoczywa, okrywając\nsię błotem na dnie rzeki.</language>
	</row>
	<row id="msg_0803_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Życie na błotnistej ziemi,\ndającej słabe oparcie, wzmocniło\njego nogi.</language>
	</row>
	<row id="msg_0803_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ramiona są twarde jak\nskała. Jednym uderzeniem może\nrozbić głaz na kawałki.</language>
	</row>
	<row id="msg_0803_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ściga swoją ofiarę, aż ta\nsię wyczerpie. Jednak ucieka,\njeśli ofiara zaatakuje z powrotem.</language>
	</row>
	<row id="msg_0803_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ściga ofiarę w watasze\nliczącej około dziesięciu. Pokonują\nwrogów dzięki doskonale skoordynowanej pracy zespołowej.</language>
	</row>
	<row id="msg_0803_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Interesuje go wszystko,\ndlatego kluczy. Jest dobry w\nznajdowaniu przedmiotów.</language>
	</row>
	<row id="msg_0803_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biegnąc w linii prostej, może\nłatwo przekroczyć 100 km/h. Ma\ntrudności z zakrętami.</language>
	</row>
	<row id="msg_0803_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje wśród wysokiej trawy i w\nlasach. Odpiera ataki, unosząc\nkolce na tylnej części ciała.</language>
	</row>
	<row id="msg_0803_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Owinąwszy jedwab wokół\ngałęzi drzewa, spokojnie czeka\nna ewolucję.</language>
	</row>
	<row id="msg_0803_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wyróżniającą cechą są\nskrzydła w żywych wzorach.\nSsie słodki nektar kwiatów swoim długim pyszczkiem.</language>
	</row>
	<row id="msg_0803_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znosi ataki cierpliwie, bo\nim więcej bólu przed ewolucją,\ntym twardszy się staje.</language>
	</row>
	<row id="msg_0803_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozsypuje swój drobny pył\nwszędzie, gdy zostanie\nzaatakowany. To nocny Pokémon.</language>
	</row>
	<row id="msg_0803_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego liść urósł zbyt duży,\nby mógł żyć na lądzie. Tak\nzaczął żyć, unosząc się na wodzie.</language>
	</row>
	<row id="msg_0803_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest nocny i staje się\naktywny o zmierzchu. Żywi się\nwodnymi mchami rosnącymi w korycie rzeki.</language>
	</row>
	<row id="msg_0803_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli usłyszy świąteczną\nmuzykę, zaczyna się poruszać w\nrytm, by wzmocnić swoją moc.</language>
	</row>
	<row id="msg_0803_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyczepia się do gałęzi\ndrzewa czubkiem głowy. Silne\nwiatry czasem mogą sprawić, że spadnie.</language>
	</row>
	<row id="msg_0803_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje głęboko w lasach.\nZ liścia na głowie robi flet,\nktórego melodia sprawia, że słuchaczom robi się nieswojo.</language>
	</row>
	<row id="msg_0803_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje spokojnie w głębokim\nlesie. Mówi się, że wachlarzami,\nktóre trzyma, tworzy chłodne zimowe wiatry.</language>
	</row>
	<row id="msg_0803_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy robi się zimno, migrują,\nprzelatując ponad 290 kilometrów\ndziennie. Poluje na smaczną ofiarę.</language>
	</row>
	<row id="msg_0803_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nurkuje pod ostrym kątem, gdy\ntylko dostrzeże swoją ofiarę.\nŁapie ją ostrymi pazurami.</language>
	</row>
	<row id="msg_0803_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybuje na prądach\nwznoszących, nie machając\nskrzydłami. Buduje gniazdo na stromych klifach nad morzem.</language>
	</row>
	<row id="msg_0803_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chroni swoje młode w\ndziobie. Kołysze się na falach,\nodpoczywając na nich w spokojne dni.</language>
	</row>
	<row id="msg_0803_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rogi na jego głowie dają mu\nsilną moc, która pozwala mu\nwyczuwać emocje ludzi.</language>
	</row>
	<row id="msg_0803_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma moc psychiczną, która\npozwala mu zniekształcać przestrzeń\nwokół siebie i widzieć przyszłość.</language>
	</row>
	<row id="msg_0803_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwalnia energię psychokinetyczną\nz pełną mocą, chroniąc trenera,\nz którym blisko się związał.</language>
	</row>
	<row id="msg_0803_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydziela gęsty, słodko\npachnący syrop z czubka głowy.\nŻyje w stawach zarośniętych chwastami.</language>
	</row>
	<row id="msg_0803_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepocze czterema skrzydłami,\nby zawisnąć i swobodnie latać\nw dowolnym kierunku--tam i z powrotem oraz w bok.</language>
	</row>
	<row id="msg_0803_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli wyczuje niebezpieczeństwo,\nrozsypuje zarodniki z czubka\ngłowy, by się chronić.</language>
	</row>
	<row id="msg_0803_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozsypuje trujące zarodniki i\nrzuca potężne ciosy, podczas\ngdy jego wróg jest osłabiony wdychanymi zarodnikami.</language>
	</row>
	<row id="msg_0803_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sposób, w jaki SLAKOTH się\nrozwala, sprawia, że każdy, kto\nna niego patrzy, ma ochotę zrobić to samo.</language>
	</row>
	<row id="msg_0803_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego poziom stresu wzrasta,\njeśli nie może się nieustannie\nporuszać. Zbyt duży stres sprawia, że czuje się chory.</language>
	</row>
	<row id="msg_0803_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najleniwszy Pokémon na\nświecie. Przenosi się w inne\nmiejsce, gdy w zasięgu nie ma już jedzenia.</language>
	</row>
	<row id="msg_0803_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czasem może żyć pod ziemią\nprzez ponad 10 lat. Wchłania\nsubstancje odżywcze z korzeni drzew.</language>
	</row>
	<row id="msg_0803_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego krzyk pozostawia trwały\nból głowy, jeśli słucha się go\nzbyt długo. Porusza się tak szybko, że jest niemal niewidoczny.</language>
	</row>
	<row id="msg_0803_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziwny Pokémon--lata bez\nporuszania skrzydłami, ma pustą\nskorupę zamiast ciała i nie oddycha.</language>
	</row>
	<row id="msg_0803_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli wyczuje niebezpieczeństwo,\nstrasza wroga, krzycząc z\ngłośnością silnika odrzutowca.</language>
	</row>
	<row id="msg_0803_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Krzyczy głośno, wdychając\npowietrze, a potem wydycha\nje, używając dobrze rozwiniętych mięśni brzucha.</language>
	</row>
	<row id="msg_0803_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ryk podczas walki wstrząsa\nziemią jak drżenie--albo jak\ntrzęsienie ziemi.</language>
	</row>
	<row id="msg_0803_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hartuje się, uderzając\nwielokrotnie w grube drzewa.\nZyskuje wytrzymałe ciało i nieustraszonego ducha.</language>
	</row>
	<row id="msg_0803_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbia wyzywać innych na\npróby siły. Ma moc, by zatrzymać\npociąg jednym klaśnięciem.</language>
	</row>
	<row id="msg_0803_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ogon jest pełen\nsubstancji odżywczych, których\npotrzebuje, by rosnąć.</language>
	</row>
	<row id="msg_0803_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli spotka się dwóch z\nnich, nie mogą podejść zbyt\nblisko, bo ich nosy się odpychają.</language>
	</row>
	<row id="msg_0803_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest urocze, gdy ściga\nwłasny ogon. Trudno zdobyć jego\nzaufanie.</language>
	</row>
	<row id="msg_0803_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie lubi brudnych miejsc.\nCzęsto szuka wygodnego miejsca,\nby się wypielęgnować.</language>
	</row>
	<row id="msg_0803_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mieszka w ciemności jaskiń.\nUżywa ostrych pazurów, by\nwykopywać klejnoty, którymi się odżywia.</language>
	</row>
	<row id="msg_0803_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kłapie szeroko otwartym\npyskiem. Jego ogromne szczęki\nto w rzeczywistości przekształcone stalowe rogi.</language>
	</row>
	<row id="msg_0803_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy ewoluuje, zrzuca stalowy\npancerz, który pokrywał całe\njego ciało, i wykształca nowy.</language>
	</row>
	<row id="msg_0803_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbia rudę żelaza. Grupy\nz nich walczą o terytorium,\nuderzając się nawzajem swoimi stalowymi ciałami.</language>
	</row>
	<row id="msg_0803_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wiek można poznać po\ndługości żelaznych rogów.\nRości sobie prawo do całej góry jako swojego terytorium.</language>
	</row>
	<row id="msg_0803_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Medytuje, by wzmocnić\nwewnętrzną energię i unosić\nsię w powietrzu. Je jedną jagodę dziennie.</language>
	</row>
	<row id="msg_0803_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki treningowi jogi\nzyskał moc psychiczną, by\nprzewidywać kolejny ruch wroga.</language>
	</row>
	<row id="msg_0803_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Magazynuje elektryczność w\nswoim futrze. Wydziela iskry z\ncałego ciała w porach roku, gdy powietrze jest suche.</language>
	</row>
	<row id="msg_0803_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego gniazdo można znaleźć\ntam, gdzie uderzył piorun.\nWyładowuje elektryczność ze swojej grzywy.</language>
	</row>
	<row id="msg_0803_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wchłania elektryczność ze\nsłupów telefonicznych. Zwiera\nswoje ciało, tworząc trzaskające dźwięki.</language>
	</row>
	<row id="msg_0803_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ekspozycja na elektryczność\nod MINUN i PLUSLE poprawia\nkrążenie krwi i rozluźnia mięśnie.</language>
	</row>
	<row id="msg_0803_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emituje światło z ogona, by\nsię komunikować. Uwielbia słodki\naromat wydzielany przez ILLUMISE.</language>
	</row>
	<row id="msg_0803_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego zapach przyciąga roje\nVOLBEAT, więc razem rysują\nponad 200 wzorów na nocnym niebie.</language>
	</row>
	<row id="msg_0803_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ROSELIA, które piją bogatą\nw substancje odżywcze wodę ze\nźródeł, podobno ujawniają rzadkie zabarwienie podczas kwitnienia.</language>
	</row>
	<row id="msg_0803_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma małe serce i mózg. Jego\nżołądek stanowi większość\nciała, z enzymami, które rozpuszczają wszystko.</language>
	</row>
	<row id="msg_0803_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Połyka wszystko, co zmieści\nsię w jego pysku. Jego specjalne\nenzymy potrafią rozpuścić wszystko.</language>
	</row>
	<row id="msg_0803_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tworzą watahy, by atakować\nłodzie i rozrywać ich kadłuby,\nby je zatopić. Żyją w rzekach w dżungli.</language>
	</row>
	<row id="msg_0803_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może pływać z prędkością\n120 km/h, wystrzeliwując wodę\nmorską przez swoje ciało. To bandyta morza.</language>
	</row>
	<row id="msg_0803_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odbija się zabawowo jak\npiłka. Im więcej wody morskiej\npołknie, tym wyżej się odbija.</language>
	</row>
	<row id="msg_0803_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest największym ze\nwszystkich zidentyfikowanych\nPokémonów. Skaczą stadem, by spędzić swoją ofiarę.</language>
	</row>
	<row id="msg_0803_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Płonąca magma, którą\nmagazynuje w garbie na grzbiecie,\njest źródłem jego ogromnej mocy.</language>
	</row>
	<row id="msg_0803_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w kraterze wulkanu.\nPowszechnie wiadomo, że garby\nna jego grzbiecie wybuchają co 10 lat.</language>
	</row>
	<row id="msg_0803_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Można znaleźć porzucone\nkopalnie węgla pełne tych\nPokémonów. Niestrudzenie kopią w poszukiwaniu węgla.</language>
	</row>
	<row id="msg_0803_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odbija się na swoim ogonie,\nby jego serce nadal pompowało.\nNosi na głowie perłę z CLAMPERL.</language>
	</row>
	<row id="msg_0803_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrafi wykonywać dziwne\nkroki taneczne, by wpływać na\nwrogów. Jego styl tańca stał się ogromnie popularny za granicą.</language>
	</row>
	<row id="msg_0803_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szanse, że dwa SPINDA mają\nidentyczne wzory plamek, są\nmniejsze niż jeden na cztery miliardy.</language>
	</row>
	<row id="msg_0803_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego gniazdo to nachylony,\nprzypominający miskę dół na\npustyni. Gdy coś w niego wpadnie, nie ma ucieczki.</language>
	</row>
	<row id="msg_0803_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Energicznie wibruje\nskrzydłami, tworząc fale\nultradźwiękowe, które wywołują poważne bóle głowy.</language>
	</row>
	<row id="msg_0803_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nazywany jest „Duchem\nPustyni”, bo trzepot jego\nskrzydeł brzmi jak śpiew kobiety.</language>
	</row>
	<row id="msg_0803_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w suchych miejscach.\nJego żółte kwiaty kwitną raz w\nroku.</language>
	</row>
	<row id="msg_0803_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Watahy z nich podążają za\npodróżnikami przez pustynię,\naż podróżnicy nie mogą się już poruszyć.</language>
	</row>
	<row id="msg_0803_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego skrzydła przywodzą na\nmyśl bawełniane chmury. Pielęgnuje\nsię wodą ze źródła i uwielbia siadać na głowach.</language>
	</row>
	<row id="msg_0803_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lata wdzięcznie po niebie.\nJego melodyjne buczenie sprawia,\nże czujesz się jak we śnie.</language>
	</row>
	<row id="msg_0803_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego futro stanęłoby dęba,\ngdyby wyczuł w pobliżu SEVIPERA.\nJego ostre pazury rozrywają wrogów.</language>
	</row>
	<row id="msg_0803_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W walce używa swojego\nostrzowego ogona, by kontrować\nkażdego ZANGOOSE. Wydziela śmiertelną truciznę w ogonie.</language>
	</row>
	<row id="msg_0803_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odkryto go w miejscu\nuderzenia meteorytu 40 lat temu.\nJego spojrzenie może uśpić wrogów.</language>
	</row>
	<row id="msg_0803_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy się obraca, wydaje\nświatło podobne do słonecznego,\noślepiając w ten sposób swoich wrogów.</language>
	</row>
	<row id="msg_0803_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BARBOACH używa swoich\nwąsów, by smakować rzeczy tak,\njak człowiek używa języka.</language>
	</row>
	<row id="msg_0803_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rości sobie prawo do dużego\nbagna. Jeśli zbliży się wróg,\nwywołuje wstrząsy, szamocząc się.</language>
	</row>
	<row id="msg_0803_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwotnie był Pokémonem z\ndaleka, który uciekł na wolność.\nMoże przystosować się do najbrudniejszej rzeki.</language>
	</row>
	<row id="msg_0803_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brutalny Pokémon, który uwielbia\nwalkę. Wbije się w każdego wroga,\nktóry zbliży się do jego gniazda.</language>
	</row>
	<row id="msg_0803_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porusza się, wirując na\njednej stopie. Widziano niektóre\nBALTOY wirujące na głowach.</language>
	</row>
	<row id="msg_0803_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że wywodzi się z\ngliniach lalek robionych przez\nstarożytną cywilizację.</language>
	</row>
	<row id="msg_0803_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maskuje swoje macki jako\nkwiaty, by przyciągnąć i złapać\nofiarę. Wymarł w czasach starożytnych.</language>
	</row>
	<row id="msg_0803_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w ciepłych morzach.\nJego ciężkie ciało utrzymuje go\nw miejscu, by nie zostało zniesione podczas burzy.</language>
	</row>
	<row id="msg_0803_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przodkowski Pokémon, który\nżył w oceanie. Z czasem jego\nosiem nóg przekształciło się w skrzydła.</language>
	</row>
	<row id="msg_0803_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ogromne, chowane pazury\nmogą przeciąć niemal wszystko.\nCałe jego ciało pokryte jest wytrzymałymi płytami.</language>
	</row>
	<row id="msg_0803_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest najbardziej nędznym ze\nwszystkich Pokémonów. Tworzy\nławice i żyje na dnie rzek.</language>
	</row>
	<row id="msg_0803_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jedno spojrzenie\nna MILOTIC i jego piękno\nukoi każdą wrogą emocję, jaką czujesz.</language>
	</row>
	<row id="msg_0803_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon może zmieniać\nswoje komórki, przyjmując różne\nformy w zależności od temperatury i wilgotności.</language>
	</row>
	<row id="msg_0803_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zmienia swoje odcienie, by\ndopasować się do otoczenia, dzięki\nczemu może podkraść się do ofiary. Tylko wzory na brzuchu pozostają stałe.</language>
	</row>
	<row id="msg_0803_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podobno używa rogu, by\nżywić się zawiścią i złośliwością.\nJest bardzo aktywny nocą.</language>
	</row>
	<row id="msg_0803_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon powstał z\nporzuconej lalki, która zgromadziła\nurazę. Widywany jest w mrocznych zaułkach.</language>
	</row>
	<row id="msg_0803_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli znajdzie niegrzeczne\ndzieci, które nie słuchają\nrodziców, podobno je porywa.</language>
	</row>
	<row id="msg_0803_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Każdy, kto odważy się\nspojrzeć w jego ciało, by zobaczyć\njego widmową kulę ognia, straci swojego ducha.</language>
	</row>
	<row id="msg_0803_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grono owoców wokół jego\nszyi dojrzewa dwa razy w roku i\njest przepyszne. To wysoko ceniona tropikalna przekąska.</language>
	</row>
	<row id="msg_0803_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa przyssawki na głowie,\nby zwisać z drzewa lub okapu.\nPotrafi wydawać siedem różnych tonów.</language>
	</row>
	<row id="msg_0803_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma zdolność przewidywania\nklęsk żywiołowych. Jego długość\nżycia przekracza sto lat.</language>
	</row>
	<row id="msg_0803_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma tendencję do poruszania\nsię w watasze. Osobniki ściskają\nsię wzajemnie, by hartować swojego ducha.</language>
	</row>
	<row id="msg_0803_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jeśli zostaną\nzobaczone o północy, spowodują\nobfite opady śniegu. Żywią się śniegiem i lodem, by przetrwać.</language>
	</row>
	<row id="msg_0803_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może natychmiast zamrozić\nwilgoć w atmosferze. Używa tej\nmocy, by zamrażać swoich wrogów.</language>
	</row>
	<row id="msg_0803_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przemierza oceany, tocząc\nsię na dryfującym lodzie.\nPuszyste futro ogrzewa go, gdy temperatura spada poniżej zera.</language>
	</row>
	<row id="msg_0803_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma bardzo wrażliwy nos.\nDotyka nim nowe rzeczy, by je\nzbadać.</language>
	</row>
	<row id="msg_0803_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozłupuje dryfujący lód\nswoimi silnymi kłami. Jego gruba\nwarstwa tłuszczu odpiera ataki wrogów.</language>
	</row>
	<row id="msg_0803_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy ewoluuje, tworzy\ntajemniczą perłę, która wzmacnia\nmoce psychiczne, gdy się ją trzyma.</language>
	</row>
	<row id="msg_0803_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje głęboko w morzu, w\nczarnej ciemności. Przyciąga\nofiary, poruszając ogonem, naśladując małe zwierzę.</language>
	</row>
	<row id="msg_0803_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego różowe ciało staje się\nbardziej intensywne wraz ze\nwzrostem temperatury wody wiosną.</language>
	</row>
	<row id="msg_0803_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odkryty przypadkiem podczas\ngłębinowych eksploracji, nie\nzmienił się od czasów starożytnych.</language>
	</row>
	<row id="msg_0803_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało w kształcie serca\nczyni go popularnym. W niektórych\nmiejscach dałbyś LUVDISCA komuś, kogo kochasz.</language>
	</row>
	<row id="msg_0803_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego dobrze rozwinięte mięśnie\nszyi i żelazna głowa mogą\nrozbić głazy na kawałki.</language>
	</row>
	<row id="msg_0803_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Otacza swoje ciało twardą jak\nżelazo skorupą, by zgromadzić\nwystarczająco mocy do ewolucji.</language>
	</row>
	<row id="msg_0803_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest niekontrolowany, gdy\nrozwścieczony. Lata dookoła,\ntryskając płomieniami i paląc pola i góry.</language>
	</row>
	<row id="msg_0803_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Siła magnetyczna wytwarzana\nprzez jego ciało odpycha naturalny\nmagnetyzm ziemi, pozwalając mu unosić się.</language>
	</row>
	<row id="msg_0803_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy dwa BELDUM łączą się,\nmagnetyczny system nerwowy\nłączy ich mózgi w jedno.</language>
	</row>
	<row id="msg_0803_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Składa cztery nogi podczas\nlotu. Jego cztery mózgi podobno\nprzewyższają superkomputer.</language>
	</row>
	<row id="msg_0803_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Te same skały, z których\nzbudowane jest jego ciało, znaleziono\nw warstwach ziemi na całym świecie.</language>
	</row>
	<row id="msg_0803_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że spał w\nlodowcu przez tysiące lat. Jego\nciała nie można stopić, nawet magmą.</language>
	</row>
	<row id="msg_0803_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podobno jego ciało jest\ntwardsze niż jakikolwiek metal.\nBadania wykazały, że jego ciało jest puste.</language>
	</row>
	<row id="msg_0803_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Komunikuje się telepatycznie.\nJego ciało pokryte jest puchem,\nktóry załamuje światło, czyniąc go niewidzialnym.</language>
	</row>
	<row id="msg_0803_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumie ludzką mowę i jest\nniezwykle inteligentny. To czuły\nPokémon, który nie lubi walczyć.</language>
	</row>
	<row id="msg_0803_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mityczny Pokémon, o którym\nmówi się, że wzburzył morza\ndeszczem i falami przypływowymi. Walczył z GROUDONEM.</language>
	</row>
	<row id="msg_0803_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że powiększył\nlądy, odparowując wodę szalejącym\nżarem. Toczył tytaniczną walkę z KYOGRE.</language>
	</row>
	<row id="msg_0803_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lata w warstwie ozonowej,\nwysoko na niebie. Do niedawna\nnikt go nigdy nie widział.</language>
	</row>
	<row id="msg_0803_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokolenia wierzyły, że\njakiekolwiek życzenie zapisane na\nkartce na jego głowie spełni się, gdy się obudzi.</language>
	</row>
	<row id="msg_0803_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DNA z kosmicznego wirusa\nzmutowało i stało się Pokémonem.\nPojawia się tam, gdzie widoczne są zorze polarne.</language>
	</row>
	<row id="msg_0803_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fotosynteza zachodzi na\ncałym jego ciele pod słońcem.\nSkorupa na jego grzbiecie to w rzeczywistości stwardniała ziemia.</language>
	</row>
	<row id="msg_0803_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GROTLE, który żyje w lesie,\npodobno ma własne, tajemne\nźródło wody.</language>
	</row>
	<row id="msg_0803_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starożytni ludzie wyobrażali\nsobie, że pod ziemią mieszka\nolbrzymi TORTERRA.</language>
	</row>
	<row id="msg_0803_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gaz wytwarzany w jego\nbrzuchu spala się z tylnej\nczęści ciała. Ogień pali się słabo, gdy czuje się chory.</language>
	</row>
	<row id="msg_0803_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Większy ogień na ogonie i\njaśniejszy niebieski wzór na\ntwarzy oznaczają wyższą rangę w watasze.</language>
	</row>
	<row id="msg_0803_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rzuca swoimi wrogami ze\nzwinnością. Używa wszystkich\nkończyn, by walczyć we własnym, unikalnym stylu.</language>
	</row>
	<row id="msg_0803_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie lubi, gdy się nim\nopiekują. Trudno się z nim\nzwiązać, bo nie słucha swojego trenera.</language>
	</row>
	<row id="msg_0803_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w samotności. Jego\nskrzydła zadają złowieszcze ciosy,\nktóre mogą złamać nawet najgrubsze drzewa.</language>
	</row>
	<row id="msg_0803_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Unika niepotrzebnych sporów,\nale zniszczy wszystko, co zagraża\njego dumie.</language>
	</row>
	<row id="msg_0803_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gromadzą się wokół gór i\npól, ścigając owadzie Pokémony.\nIch śpiew jest głośny i irytujący.</language>
	</row>
	<row id="msg_0803_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Utrzymują ogromne stada, choć\nmiędzy różnymi stadami wybuchają\nzaciekłe potyczki.</language>
	</row>
	<row id="msg_0803_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy STARAVIA ewoluują w\nSTARAPTORA, opuszczają stado, by\nżyć samotnie. Mają wytrzymałe skrzydła.</language>
	</row>
	<row id="msg_0803_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w grupach nad wodą.\nGryzie głazy i drzewa wokół\nswojego gniazda swoimi siekaczami.</language>
	</row>
	<row id="msg_0803_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pilnie buduje swoje gniazdo\nze stosów gałęzi i korzeni,\nktóre pocięło swoimi ostrymi siekaczami.</language>
	</row>
	<row id="msg_0803_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jego czułki się uderzają,\nbrzmi to jak muzyka ksylofonu.\n</language>
	</row>
	<row id="msg_0803_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozwalając, by jego krzyk\nrezonował w wydrążonym brzuchu,\nwytwarza urzekający dźwięk.</language>
	</row>
	<row id="msg_0803_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozciąganie i kurczenie\njego mięśni wytwarza elektryczność.\nJego futro świeci, gdy jest w kłopotach.</language>
	</row>
	<row id="msg_0803_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbierając swoje ogony razem,\nwspólnie wytwarzają potężną\nelektryczność ze swoich pazurów.</language>
	</row>
	<row id="msg_0803_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdolność LUXRAYA do widzenia\nprzez przedmioty przydaje się,\ngdy wypatruje niebezpieczeństwa.</language>
	</row>
	<row id="msg_0803_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy poczuje ciepły dotyk\nsłońca, otwiera pąk, by uwolnić\npyłek. Żyje przy czystych stawach.</language>
	</row>
	<row id="msg_0803_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego słodki aromat\nprzyciąga ofiary. Potem wypluwa\ntruciznę. Im bardziej toksyczny, tym słodszy jego aromat.</language>
	</row>
	<row id="msg_0803_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CRANIDOS hartują swoje i tak\njuż twarde jak skała głowy,\nuderzając się nawzajem głowami.</language>
	</row>
	<row id="msg_0803_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego czaszka wytrzymuje\nuderzenia dowolnej mocy. W\nrezultacie jego mózg nigdy nie ma szansy urosnąć.</language>
	</row>
	<row id="msg_0803_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powstał ze skamieliny\nwykopanej z warstwy gliny\nstarszej, niż ktokolwiek wie. Ma wytrzymałą twarz.</language>
	</row>
	<row id="msg_0803_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy są atakowane, tworzą\nmur. Ich twarde jak skała twarze\nsłużą do ochrony przed atakami.</language>
	</row>
	<row id="msg_0803_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Okrywa się płaszczem, by\nschronić się przed zimnem. Gdy\njest gorąco, jego płaszcz jest cieńszy.</language>
	</row>
	<row id="msg_0803_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że WORMADAM, który\newoluuje w zimny dzień, będzie\nmiał grubszy płaszcz.</language>
	</row>
	<row id="msg_0803_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepocze wokół nocą i\nkradnie miód z ula COMBEE.</language>
	</row>
	<row id="msg_0803_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nocą COMBEE śpią w grupie\nokoło tysiąca, ściśnięte razem\nw grudę.</language>
	</row>
	<row id="msg_0803_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoduje larwy w otworach w\nswoim ciele. Wydziela feromony,\nby kontrolować COMBEE.</language>
	</row>
	<row id="msg_0803_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest jednym z rodzajów\nPokémonów z elektrycznymi\nworkami policzkowymi. Wystrzeliwuje ładunki z ogona.</language>
	</row>
	<row id="msg_0803_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadyma swój pęcherz\npływny, trzymając twarz nad\nwodą, by obserwować ruchy ofiary.</language>
	</row>
	<row id="msg_0803_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z nadmuchanym pęcherzem\npływnym może nosić ludzi na\ngrzbiecie. Zdmuchuje pęcherz, zanim zanurkuje.</language>
	</row>
	<row id="msg_0803_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ewoluuje, wysysając energię\nz małej kuli, w której magazynował\nsubstancje odżywcze.</language>
	</row>
	<row id="msg_0803_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W czasie silnego światła\nsłonecznego jego pąk kwitnie,\npłatki w pełni się rozwijają, a on staje się bardzo aktywny.</language>
	</row>
	<row id="msg_0803_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego kształt i zabarwienie\nzmieniają się w zależności od\nsiedliska.</language>
	</row>
	<row id="msg_0803_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy atakuje go naturalny\nwróg, wydziela fioletowy płyn\ni ucieka.</language>
	</row>
	<row id="msg_0803_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyją na dużych drzewach.\nMówi się, że komunikują się,\nłącząc swoje ogony z ogonami innych.</language>
	</row>
	<row id="msg_0803_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szepcze się, że każde\ndziecko, które pomyli DRIFLOON z\nbalonem i się go złapie, może zniknąć.</language>
	</row>
	<row id="msg_0803_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może wytwarzać i uwalniać\ngaz wewnątrz swojego ciała.\nDzięki temu potrafi kontrolować wysokość dryfowania.</language>
	</row>
	<row id="msg_0803_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po sposobie, w jaki zwija\nuszy, można poznać jego nastrój.\nGdy jest przestraszony, oba uszy są zwinięte.</language>
	</row>
	<row id="msg_0803_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrzuca futro dwa razy w\nroku. Jego zimowe futro jest\nmiękkie i puszyste.</language>
	</row>
	<row id="msg_0803_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego krzyki brzmią jak\nzaklęcia dręczące wroga. Pojawia\nsię tam, gdzie najmniej się go spodziewasz.</language>
	</row>
	<row id="msg_0803_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest bezlitosny z natury.\nMówi się, że nigdy nie wybacza\nbłędów swoich podwładnych MURKROW.</language>
	</row>
	<row id="msg_0803_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jest szczęśliwy, GLAMEOW\ndemonstruje piękne ruchy ogonem,\njak tańcząca wstążka.</language>
	</row>
	<row id="msg_0803_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zająłby cudze gniazdo jako\nswoje, gdyby uznał je za\nwystarczająco wygodne.</language>
	</row>
	<row id="msg_0803_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydaje wysokoczęstotliwościowe\nkrzyki, których ludzie nie\nsłyszą. Gdy zaczyna, może krzyczeć strasznie długo.</language>
	</row>
	<row id="msg_0803_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cuchnący płyn z jego tylnej\nczęści jest tak obrzydliwy, że\nmoże wywołać mdłości nawet z odległości dwóch kilometrów.</language>
	</row>
	<row id="msg_0803_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atakuje, rozpylając\nobrzydliwy płyn z ogona, ale\nsmród słabnie po kilku pryskach.</language>
	</row>
	<row id="msg_0803_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starożytni ludzie wierzyli,\nże wzór na grzbiecie BRONZORA\nkrył tajemniczą moc.</language>
	</row>
	<row id="msg_0803_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starożytni ludzie wierzyli,\nże proszenie BRONZONGA o deszcz\njest sposobem na wzrost upraw.</language>
	</row>
	<row id="msg_0803_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By dostosować poziom płynów\nw swoim ciele, wydziela wodę z\noczu. Sprawia to, że wygląda, jakby płakał.</language>
	</row>
	<row id="msg_0803_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Próbując zmylić wroga,\nnaśladuje jego ruchy. Potem\nnie traci czasu i się ulatnia!</language>
	</row>
	<row id="msg_0803_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostrożnie nosi okrągły,\nbiały kamień, który uważa za\njajko. Przeszkadza mu, jak kędzierzawe wyglądają jego włosy.</language>
	</row>
	<row id="msg_0803_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naśladuje krzyki innych\nPokémonów, by oszukać je, że\njest jednym z nich. Dzięki temu go nie atakują.</language>
	</row>
	<row id="msg_0803_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powstał z połączenia 108\nduchów. Został przywiązany do\nDziwnego Kamienia Węgielnego, by nie robił psikusów.</language>
	</row>
	<row id="msg_0803_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gnieździ się w poziomych\nnorach ogrzewanych ciepłem\ngeotermalnym. Wrogowie, którzy podejdą zbyt blisko, mogą spodziewać się skoku i ukąszenia.</language>
	</row>
	<row id="msg_0803_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kopiąc, by rozszerzyć swoje\ngniazdo, zwyczajowo wykopuje\nklejnoty, które potem gromadzi w gnieździe.</language>
	</row>
	<row id="msg_0803_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało pokryte jest\ndrobnymi łuskami, które zmniejszają\nopór, umożliwiając mu latanie z dużą prędkością.</language>
	</row>
	<row id="msg_0803_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ukrywa jedzenie pod długim\nfutrem na ciele. Wozi ze sobą\nten zapas jedzenia i połyka go bez żucia.</language>
	</row>
	<row id="msg_0803_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Komunikują się ze sobą,\nużywając swoich aur. Potrafią\nbiegać przez całą noc.</language>
	</row>
	<row id="msg_0803_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że żaden wróg nie\nmoże pozostać niewidoczny dla\nLUCARIO, bo potrafi wykrywać aury. Nawet wrogów, których inaczej by nie zobaczył.</language>
	</row>
	<row id="msg_0803_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Otula się piaskiem, by\nchronić się przed zarazkami.\nSwobodnie przemierza pustynne piaski.</language>
	</row>
	<row id="msg_0803_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Otwiera szeroko pysk,\ndemonstrując przerażającą siłę.\nPodczas ataku wzbija ogromne ilości piasku.</language>
	</row>
	<row id="msg_0803_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zakopuje się w piasku, by\nczaić się na ofiarę. Pazury na\nogonie mogą wstrzyknąć ofierze zajadłą truciznę.</language>
	</row>
	<row id="msg_0803_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atakuje ludzi i Pokémony,\nktórzy przemierzają pustynię. To\ntylko pogłębiło jego złą reputację.</language>
	</row>
	<row id="msg_0803_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Płyn wyciśnięty z jego\npalca, choć trujący, jest ważnym\nskładnikiem lekarstw na ból dolnej części pleców.</language>
	</row>
	<row id="msg_0803_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kołysząc się i unikając\nataków wroga, wplata swoje\ngiętkie ciało blisko, po czym wypada, atakując trującymi pazurami.</language>
	</row>
	<row id="msg_0803_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chodzi na swoich mackach w\nposzukiwaniu gałęzi drzewa, na\nktórej może zwisać i zasadzić się na ofiarę.</language>
	</row>
	<row id="msg_0803_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pływając i trzepocząc swoimi\ndwiema ogonowymi płetwami,\nwygląda jak BEAUTIFLY. Nocą wzory na jego płetwach delikatnie świecą.</language>
	</row>
	<row id="msg_0803_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LUMINEON pływające w\nciemności głębokiego morza\nwyglądają jak gwiazdy świecące na nocnym niebie.</language>
	</row>
	<row id="msg_0803_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy pływa blisko\npowierzchni oceanu, ludzie na\npokładach statków mogą obserwować wzór na jego grzbiecie.</language>
	</row>
	<row id="msg_0803_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W zimnych porach roku\nmigruje w niższe partie góry.\nNa wiosnę wraca na pokryty śniegiem szczyt.</language>
	</row>
	<row id="msg_0803_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje spokojnym życiem na\ngórach wiecznie pokrytych\nśniegiem. Ukrywa się, wzbijając zamiecie.</language>
	</row>
	<row id="msg_0803_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w śnieżnych regionach.\nWyrzeźbia wzory na drzewach\nswoimi pazurami jako sygnał dla innych.</language>
	</row>
	<row id="msg_0803_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ekspozycja na specjalne pole\nmagnetyczne zmieniła strukturę\nmolekularną MAGNETONA, przekształcając go w MAGNEZONE.</language>
	</row>
	<row id="msg_0803_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ślina może rozłożyć\nwszystko. Owija swój długi\njęzyk wokół rzeczy, by pokryć je lepką śliną.</language>
	</row>
	<row id="msg_0803_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z otworów w dłoniach\nwystrzeliwuje GEODUDE. Jego\npancerz może wytrzymać wybuchy wulkaniczne.</language>
	</row>
	<row id="msg_0803_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy pozostaje nieruchomy,\nwygląda jak duży krzew.\nNiczego niespodziewająca się ofiara, która się zbliży, zostaje usidlona jego pnączami.</language>
	</row>
	<row id="msg_0803_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jego ładunek elektryczny\nnarasta, między jego rogami\nzaczynają trzaskać niebieskie iskry.</language>
	</row>
	<row id="msg_0803_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wystrzeliwuje kule ognia o\ntemperaturze ponad 1980 stopni\nCelsjusza ze swoich ramion. Jego oddech też pali i skwierczy.</language>
	</row>
	<row id="msg_0803_00468" index="468">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak wszyscy wiedzą, odwiedza\nspokojne regiony, przynosząc im\ndary dobroci i słodkie błogosławieństwa.</language>
	</row>
	<row id="msg_0803_00469" index="469">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten sześcionogi Pokémon z\nłatwością potrafi przenieść w\nlocie dorosłą osobę. Skrzydła na jego ogonie pomagają mu utrzymać równowagę.</language>
	</row>
	<row id="msg_0803_00470" index="470">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy widzisz śpiącego LEAFEONA\nw plamie słońca, wiedz, że\nużywa fotosyntezy, by wytwarzać czyste powietrze.</language>
	</row>
	<row id="msg_0803_00471" index="471">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powoduje powstawanie\nmałych kryształków lodu,\nobniżając temperaturę otaczającej atmosfery.</language>
	</row>
	<row id="msg_0803_00472" index="472">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lata bezgłośnie. Używa\nswojego długiego ogona, by\nunosić ofiarę... Potem resztę robią jego wydłużone kły.</language>
	</row>
	<row id="msg_0803_00473" index="473">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zamrożonego MAMOSWINE\nwykopano z lodu sprzed 10 000 lat.\nTen Pokémon istnieje bardzo, bardzo, bardzo długo.</language>
	</row>
	<row id="msg_0803_00474" index="474">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego oprogramowanie zostało\nzmodyfikowane, by mógł podróżować\nprzez obce wymiary. Wygląda na to, że mógł zajść jakiś błąd...</language>
	</row>
	<row id="msg_0803_00475" index="475">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ potrafi wyczuć, o\nczym myśli jego wróg, jego ataki\nwybuchają jako pierwsze, szybko i zajadle.</language>
	</row>
	<row id="msg_0803_00476" index="476">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kontroluje trzy jednostki\nzwane Mini-Nosami za pomocą\nsiły magnetycznej. Dzięki nim może atakować wroga z trzech kierunków.</language>
	</row>
	<row id="msg_0803_00477" index="477">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten budzący\nlęk Pokémon podróżuje do\nnieznanych światów. Niektórzy wierzą nawet, że zabiera ze sobą zagubione dusze.</language>
	</row>
	<row id="msg_0803_00478" index="478">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Legendy w śnieżnych\nregionach głoszą, że kobieta,\nktóra zaginęła na lodowej górze, odrodziła się jako FROSLASS.</language>
	</row>
	<row id="msg_0803_00479" index="479">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Badania nad tym Pokémonem\ntrwają, bo może on być źródłem\nmocy unikalnego silnika.</language>
	</row>
	<row id="msg_0803_00480" index="480">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Według niektórych źródeł ten\nPokémon obdarzył ludzi\ninteligencją potrzebną do rozwiązywania różnych problemów.</language>
	</row>
	<row id="msg_0803_00481" index="481">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten Pokémon\nobdarzył ludzkie serce emocjami,\ntakimi jak smutek i radość.</language>
	</row>
	<row id="msg_0803_00482" index="482">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten Pokémon\nobdarzył ludzi determinacją\npotrzebną do stawiania czoła wszelkim trudnościom życia.</language>
	</row>
	<row id="msg_0803_00483" index="483">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon całkowicie\nkontroluje bieg czasu. Używa swojej\nmocy, by dowolnie podróżować przez przeszłość i przyszłość.</language>
	</row>
	<row id="msg_0803_00484" index="484">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego całkowita kontrola nad\ngranicami przestrzeni pozwala\nmu przenosić się do odległych miejsc, a nawet innych wymiarów.</language>
	</row>
	<row id="msg_0803_00485" index="485">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wrząca krew, jak magma,\nkrąży w jego ciele. Zamieszkuje\nwulkaniczne jaskinie.</language>
	</row>
	<row id="msg_0803_00486" index="486">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzy się, że ukształtował\nREGIROCKA, REGICE i REGISTEELA\nz gliny, lodu i magmy.</language>
	</row>
	<row id="msg_0803_00487" index="487">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten Pokémon\nżyje w świecie po odwrotnej\nstronie naszego, gdzie powszechna wiedza jest wypaczona i dziwna.</language>
	</row>
	<row id="msg_0803_00488" index="488">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ci, którzy śpią, trzymając\npióro CRESSELII, mają zapewnione\nradosne sny. Mówi się, że reprezentuje ona sierp księżyca.</language>
	</row>
	<row id="msg_0803_00489" index="489">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy woda się ogrzewa,\nnadymają pęcherz pływny na\ngłowach i leniwie dryfują po morzu w stadach.</language>
	</row>
	<row id="msg_0803_00490" index="490">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaczyna życie z cudowną\nmocą, która pozwala mu\nzwiązać się z dowolnym rodzajem Pokémona.</language>
	</row>
	<row id="msg_0803_00491" index="491">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegania ludzi i Pokémony\nze swojego terytorium, sprawiając,\nże doświadczają głębokich, koszmarnych snów.</language>
	</row>
	<row id="msg_0803_00492" index="492">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zakwitanie kwiatów Gracidea\nobdarza go mocą lotu. Wdzięczność\nto przesłanie, które przekazuje.</language>
	</row>
	<row id="msg_0803_00493" index="493">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Według legend Sinnoh ten\nPokémon wykluł się z jaja i\nukształtował wszystko, co istnieje w tym świecie.</language>
	</row>
</body>
