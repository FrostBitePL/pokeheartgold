<?xml version="1.0"?>
<body language="English">
	<row id="msg_0804_00000" index="0">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0804_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nosi nasiono na grzbiecie od\nnarodzin. Wraz z wiekiem nasiono\nrównież rośnie.</language>
	</row>
	<row id="msg_0804_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli pąk na jego grzbiecie\nzaczyna słodko pachnieć, to znak,\nże wielki kwiat wkrótce zakwitnie.</language>
	</row>
	<row id="msg_0804_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrafi przekształcać światło\nsłoneczne w energię. W rezultacie\njest silniejszy latem.</language>
	</row>
	<row id="msg_0804_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Płomień na jego ogonie wskazuje\nsiłę życiową CHARMANDERA. Jeśli\njest zdrowy, płomień płonie jasno.</language>
	</row>
	<row id="msg_0804_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma barbarzyńską naturę. W walce\nwymachuje swoim ognistym ogonem\ni tnie ostrymi pazurami.</language>
	</row>
	<row id="msg_0804_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oddychając intensywnymi,\ngorącymi płomieniami, potrafi\nstopić niemal wszystko. Jego oddech zadaje wrogom straszliwy ból.</language>
	</row>
	<row id="msg_0804_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skorupa, która twardnieje\nwkrótce po narodzinach, jest\nwytrzymała. Jeśli ją szturchniesz, odbije się.</language>
	</row>
	<row id="msg_0804_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprytnie kontroluje swoje\nfuterkowe uszy i ogon, by\nutrzymać równowagę podczas pływania.</language>
	</row>
	<row id="msg_0804_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rakietowe działa na jego\nskorupie wystrzeliwują strumienie\nwody zdolne przebić dziury w grubej stali.</language>
	</row>
	<row id="msg_0804_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego stopy mają przyssawki\nzaprojektowane, by przylegać do\ndowolnej powierzchni. Wytrwale wspina się na drzewa w poszukiwaniu jedzenia.</language>
	</row>
	<row id="msg_0804_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przygotowuje się do ewolucji,\nutwardzając skorupę tak bardzo,\njak to możliwe, by chronić swoje miękkie ciało.</language>
	</row>
	<row id="msg_0804_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wodoodporny pyłek na jego\nskrzydłach pozwala mu zbierać\nmiód nawet w najcięższych deszczach.</language>
	</row>
	<row id="msg_0804_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atakuje, używając pięciocentymetrowego\ntrującego kolca na głowie.\nZwykle można go znaleźć pod liśćmi, które je.</language>
	</row>
	<row id="msg_0804_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z tej formy wyrośnie na\ndorosłego. W miarę jak jego ciało\nstaje się miększe, zewnętrzna skorupa twardnieje.</language>
	</row>
	<row id="msg_0804_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma trzy trujące kolce.\nKolec na jego ogonie wydziela\nnajsilniejszą truciznę.</language>
	</row>
	<row id="msg_0804_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powszechny na trawiastych\nobszarach i w lasach, jest bardzo\nłagodny i przepędzi wrogów, wzbijając piasek.</language>
	</row>
	<row id="msg_0804_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Unieruchamia swoją ofiarę\ndobrze rozwiniętymi pazurami, a\npotem niesie ją ponad 95 kilometrów do gniazda.</language>
	</row>
	<row id="msg_0804_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozkłada szeroko swoje\npiękne skrzydła, by przestraszyć\nwrogów. Potrafi latać z prędkością Mach 2.</language>
	</row>
	<row id="msg_0804_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyjąc wszędzie, gdzie jest\njedzenie, nieustannie szuka\nżywności przez cały dzień.</language>
	</row>
	<row id="msg_0804_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wąsy pomagają mu\nutrzymać równowagę. Jego kły\nnigdy nie przestają rosnąć, więc gryzie, by je skracać.</language>
	</row>
	<row id="msg_0804_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardzo chroni swoje terytorium,\ntrzepocze zawzięcie krótkimi\nskrzydłami, by śmigać z dużą prędkością.</language>
	</row>
	<row id="msg_0804_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprytnie używa swojego\ncienkiego, długiego dzioba, by\nwyciągać i jeść małe owady ukryte pod ziemią.</language>
	</row>
	<row id="msg_0804_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze ukrywa się w trawie.\nZaraz po narodzinach nie ma\ntrucizny, więc jego ugryzienie jest bolesne, ale nieszkodliwe.</language>
	</row>
	<row id="msg_0804_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardzo mściwy z natury, nie\nzrezygnuje z pościgu, bez\nwzględu na to, jak daleko, gdy raz upatrzy sobie ofiarę.</language>
	</row>
	<row id="msg_0804_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podnosi ogon, by sprawdzić\notoczenie. W tej pozycji ogon\nczasem trafia w niego piorun.</language>
	</row>
	<row id="msg_0804_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli elektryczne worki w\njego policzkach są w pełni\nnaładowane, oba uszy staną prosto.</language>
	</row>
	<row id="msg_0804_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie lubiąc wody, żyje w\ngłębokich norach na suchych\nobszarach. Potrafi błyskawicznie zwinąć się w kulę.</language>
	</row>
	<row id="msg_0804_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli kopie w niesamowitym\ntempie, może odłamać swoje\nkolce i pazury. Odrastają w ciągu dnia.</language>
	</row>
	<row id="msg_0804_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć niezbyt bojowy, będzie\ndręczyć wrogów trującymi\nkolcami, jeśli poczuje się w jakikolwiek sposób zagrożony.</language>
	</row>
	<row id="msg_0804_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma spokojną i troskliwą\nnaturę. Ponieważ jego róg rośnie\npowoli, woli nie walczyć.</language>
	</row>
	<row id="msg_0804_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa swojego łuskowatego,\nszorstkiego ciała, by zatkać\nwejście do gniazda i chronić młode przed drapieżnikami.</language>
	</row>
	<row id="msg_0804_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podnosi swoje duże uszy, by\nsprawdzić otoczenie. Uderzy jako\npierwszy, jeśli wyczuje jakiekolwiek niebezpieczeństwo.</language>
	</row>
	<row id="msg_0804_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybko wpada w gniew, dźga\nwrogów rogiem, by wstrzyknąć\npotężną truciznę, gdy się pobudzi.</language>
	</row>
	<row id="msg_0804_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ogon jest gruby i\npotężny. Jeśli owinie nim wroga,\nmoże dość łatwo unieszkodliwić ofiarę.</language>
	</row>
	<row id="msg_0804_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego urocze zachowanie i\nkrzyk czynią go bardzo popularnym.\nJednak ten uroczy Pokémon jest rzadko spotykany.</language>
	</row>
	<row id="msg_0804_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego bardzo czułe uszy\npozwalają mu rozróżniać dalekie\ndźwięki. W rezultacie preferuje ciche miejsca.</language>
	</row>
	<row id="msg_0804_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zostanie zaatakowany\nprzez silniejszego od siebie\nwroga, udaje ranę, by go oszukać, i ucieka.</language>
	</row>
	<row id="msg_0804_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego dziewięć pięknych\nogonów jest pełnych cudownej\nenergii, która mogłaby utrzymać go przy życiu przez 1000 lat.</language>
	</row>
	<row id="msg_0804_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spojrzenie w jego urocze,\nokrągłe oczy sprawia, że śpiewa\nrelaksującą melodię, wprawiając wrogów w sen.</language>
	</row>
	<row id="msg_0804_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma bardzo delikatne futro.\nUważaj, by go nie rozzłościć,\nbo może stopniowo się nadmuchać i uderzyć całym ciałem.</language>
	</row>
	<row id="msg_0804_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdolny do bezpiecznego\nlatania w ciemnych miejscach,\nwydaje ultradźwiękowe krzyki, by sprawdzać przeszkody.</language>
	</row>
	<row id="msg_0804_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może wypić za jednym razem\nponad 280 mililitrów krwi. Jeśli\nma jej za dużo, robi się ciężki i lata niezdarnie.</language>
	</row>
	<row id="msg_0804_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zostanie wystawiony na\nblask księżyca, zaczyna się\nporuszać. Nocą wędruje daleko i szeroko, rozsypując nasiona.</language>
	</row>
	<row id="msg_0804_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydziela lepki miód\nprzypominający ślinę. Choć\nsłodki, pachnie zbyt odpychająco, by podejść zbyt blisko.</language>
	</row>
	<row id="msg_0804_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pąk wybucha kwiatem z\nhukiem. Potem zaczyna rozsypywać\nalergizujący, trujący pyłek.</language>
	</row>
	<row id="msg_0804_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wraz z rozwojem jego ciała,\nna jego grzbiecie zaczynają\nwyrastać duże grzyby zwane tochukaso.</language>
	</row>
	<row id="msg_0804_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Im większy grzyb na jego\ngrzbiecie urośnie, tym silniejsze\nzarodniki grzyba rozsypuje.</language>
	</row>
	<row id="msg_0804_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trucizna wycieka z całego\njego ciała. Nocą łapie i zjada\nmałe owady przyciągnięte światłem.</language>
	</row>
	<row id="msg_0804_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pyłek na jego skrzydłach\njest trujący, jeśli ma ciemny\nodcień. Jeśli jest jasny, powoduje paraliż.</language>
	</row>
	<row id="msg_0804_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli DIGLETT przekopie\npole, pozostawia glebę idealnie\nspulchnioną i doskonałą do sadzenia upraw.</language>
	</row>
	<row id="msg_0804_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niezwykle potężne, potrafią\nprzekopać się nawet przez\nnajtwardszą ziemię na głębokość ponad 95 kilometrów.</language>
	</row>
	<row id="msg_0804_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbia wszystko, co\nlśni. Szczególnie uwielbia\nmonety, które podnosi i potajemnie gromadzi.</language>
	</row>
	<row id="msg_0804_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego zwinne mięśnie\npozwalają mu chodzić bez\nwydawania dźwięku. Atakuje w mgnieniu oka.</language>
	</row>
	<row id="msg_0804_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jego przewlekły ból\ngłowy osiąga szczyt, może\nprzejawiać dziwne moce. Wydaje się nie pamiętać takich epizodów.</language>
	</row>
	<row id="msg_0804_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pojawia się przy ciekach\nwodnych o zmierzchu. Może użyć\nmocy telekinetycznych, jeśli jego czoło tajemniczo świeci.</language>
	</row>
	<row id="msg_0804_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie jest bezpiecznie się\nzbliżać, gdy wpada w gwałtowną\nwściekłość bez powodu i nie potrafi odróżnić przyjaciół od wrogów.</language>
	</row>
	<row id="msg_0804_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wpada w dziką furię, jeśli\ntylko wyczuje, że ktoś na niego\npatrzy. Ściga każdego, kto napotka jego spojrzenie.</language>
	</row>
	<row id="msg_0804_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niezwykle lojalny, bez\nlęku zaszczeka na każdego\nprzeciwnika, by chronić swojego trenera przed krzywdą.</language>
	</row>
	<row id="msg_0804_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wspaniałe szczekanie\nprzekazuje poczucie majestatu.\nKażdy, kto je usłyszy, nie może się powstrzymać przed hołdem.</language>
	</row>
	<row id="msg_0804_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kierunek spirali na jego\nbrzuchu różni się w zależności od\nregionu. Uważa się, że wpływ na to ma równik.</language>
	</row>
	<row id="msg_0804_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skóra na większości jego\nciała jest wilgotna. Jednak\nskóra na spirali na brzuchu jest gładka w dotyku.</language>
	</row>
	<row id="msg_0804_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć jest energicznym,\nwprawnym pływakiem, używającym\nwszystkich mięśni, żyje na suchym lądzie.</language>
	</row>
	<row id="msg_0804_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zdecyduje się losowo\nteleportować, wywołuje złudzenie,\nże stworzył swoje kopie.</language>
	</row>
	<row id="msg_0804_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli używa swoich zdolności,\nwydziela specjalne fale alfa,\nktóre powodują awarie maszyn.</language>
	</row>
	<row id="msg_0804_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego komórki mózgowe\nmnożą się nieustannie aż do\nśmierci. W rezultacie pamięta wszystko.</language>
	</row>
	<row id="msg_0804_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbia ćwiczyć i budować\nswoje mięśnie. Nigdy nie jest\nusatysfakcjonowany, nawet jeśli trenuje ciężko przez cały dzień.</language>
	</row>
	<row id="msg_0804_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mięśnie pokrywające jego\nciało tryskają mocą. Nawet w\nbezruchu emanuje niesamowitym poczuciem siły.</language>
	</row>
	<row id="msg_0804_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa swoich czterech\npotężnych ramion, by przygwoździć\nkończyny wroga, po czym rzuca ofiarę poza horyzont.</language>
	</row>
	<row id="msg_0804_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zapuszcza swoje stopy\ngłęboko pod ziemię, by uzupełnić\nwodę. Nie może uciec przed wrogiem, gdy jest zakorzeniony.</language>
	</row>
	<row id="msg_0804_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli ofiara jest większa niż\njego pysk, kroi ją ostrymi\nliśćmi, a potem zjada każdy kęs.</language>
	</row>
	<row id="msg_0804_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten przerażający roślinny\nPokémon przyciąga ofiary\naromatycznym miodem, a potem topi je w pysku.</language>
	</row>
	<row id="msg_0804_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dryfuje bezcelowo po\nfalach. Bardzo trudno go dostrzec\nw wodzie, więc może pozostać niezauważony, aż użądli.</language>
	</row>
	<row id="msg_0804_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W walce rozciąga wszystkie\nswoje 80 macek, by uwięzić\nprzeciwnika w trującej sieci.</language>
	</row>
	<row id="msg_0804_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa ramion, by stale\nwspinać się po stromych\ngórskich ścieżkach. Wymachuje pięściami, jeśli się rozzłości.</language>
	</row>
	<row id="msg_0804_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powolny piechur, toczy się,\nby się poruszać. Nie zwraca\nuwagi na żaden przedmiot, który przypadkiem znajdzie się na jego drodze.</language>
	</row>
	<row id="msg_0804_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest zdolny się wysadzić.\nUżywa tej wybuchowej siły, by\nprzeskakiwać z góry na górę.</language>
	</row>
	<row id="msg_0804_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego tylne nogi, mające\nkopyta twardsze od diamentu,\nkopią do tyłu w stronę każdej obecności, jaką wyczuje za sobą.</language>
	</row>
	<row id="msg_0804_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z niesamowitym przyspieszeniem\nosiąga swoją maksymalną\nprędkość 240 km/h po zaledwie 10 krokach.</language>
	</row>
	<row id="msg_0804_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słodki sok wycieka z czubka\njego ogona. Choć nie jest\nodżywczy, ogon jest przyjemny do żucia.</language>
	</row>
	<row id="msg_0804_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z natury tępy od początku,\nstracił zdolność odczuwania\nbólu z powodu wyciekającej trucizny SHELLDERA.</language>
	</row>
	<row id="msg_0804_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jednostki po bokach jego\nciała wytwarzają energię\nantygrawitacyjną, by utrzymać go w powietrzu.</language>
	</row>
	<row id="msg_0804_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">MAGNEMITE są połączone\nmagnetyzmem tak silnym, że\nosusza całą wilgoć w pobliżu.</language>
	</row>
	<row id="msg_0804_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zje łodygę rośliny,\nktórą nosi jako zapas awaryjny,\nrusza w poszukiwaniu nowej łodygi.</language>
	</row>
	<row id="msg_0804_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pędzi przez trawiaste\nrówniny potężnymi krokami,\npozostawiając odciski stóp głębokie na dziesięć centymetrów.</language>
	</row>
	<row id="msg_0804_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jedna z głów dostanie\njeść, pozostałe też będą\nzadowolone i przestaną się kłócić.</language>
	</row>
	<row id="msg_0804_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W dzień często można go\nznaleźć śpiącego na dnie morza\nna płytkich wodach. Jego nozdrza zamykają się podczas pływania.</language>
	</row>
	<row id="msg_0804_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha lodowate morza z\nkrą lodową. Używa swojego\ndługiego ogona, by szybko zmieniać kierunek pływania.</language>
	</row>
	<row id="msg_0804_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdziekolwiek przeszedł\nGRIMER, zostawia tyle zarazków,\nże żadne rośliny już nigdy tam nie wyrosną.</language>
	</row>
	<row id="msg_0804_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało zbudowane jest\nz potężnej trucizny. Przypadkowe\ndotknięcie go spowoduje gorączkę wymagającą leżenia w łóżku.</language>
	</row>
	<row id="msg_0804_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ziarna piasku uwięzione w\njego skorupach mieszają się z\npłynami ustrojowymi, tworząc piękne perły.</language>
	</row>
	<row id="msg_0804_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CLOYSTER żyjące w morzach\nz gwałtownymi prądami pływowymi\nrozwijają duże, ostre kolce na swoich skorupach.</language>
	</row>
	<row id="msg_0804_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało zbudowane jest z\ngazu. Mimo braku substancji może\nowinąć się wokół przeciwnika dowolnego rozmiaru i spowodować uduszenie.</language>
	</row>
	<row id="msg_0804_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego język zbudowany jest z\ngazu. Jeśli oblizana, ofiara\nzaczyna nieustannie trząść się, aż w końcu nadchodzi śmierć.</language>
	</row>
	<row id="msg_0804_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By wykraść życie swojego\ncelu, wślizguje się w cień\nofiary i cicho czeka na okazję.</language>
	</row>
	<row id="msg_0804_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybko wwierca się w ziemię\nz prędkością 80 km/h, wijąc się\ni skręcając swoje masywne, szorstkie ciało.</language>
	</row>
	<row id="msg_0804_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pamięta każdy sen, który\nzje. Rzadko je sny dorosłych,\nbo sny dzieci są o wiele smaczniejsze.</language>
	</row>
	<row id="msg_0804_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze trzyma wahadło, którym\nkołysze w stałym rytmie, wywołując\nsenność u każdego w pobliżu.</language>
	</row>
	<row id="msg_0804_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szczypce łatwo się\nodłamują. Jeśli straci szczypce,\njakoś traci zdolność chodzenia bokiem.</language>
	</row>
	<row id="msg_0804_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego szczypce rosną\ndziwacznie duże. Jeśli podniesie\nje zbyt szybko, traci równowagę i chwieje się.</language>
	</row>
	<row id="msg_0804_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odkryto go, gdy wprowadzono\nPoké Balle. Mówi się, że\nistnieje między nimi jakiś związek.</language>
	</row>
	<row id="msg_0804_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Magazynuje w swoim ciele\nprzytłaczającą ilość energii\nelektrycznej. Nawet mały wstrząs sprawia, że wybucha.</language>
	</row>
	<row id="msg_0804_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używając telepatii, którą\ntylko one potrafią stosować,\nzawsze tworzą skupisko sześciu EXEGGCUTE.</language>
	</row>
	<row id="msg_0804_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli głowa odpadnie,\nwydaje telepatyczne wezwanie w\nposzukiwaniu innych, by utworzyć skupisko EXEGGCUTE.</language>
	</row>
	<row id="msg_0804_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze nosi czaszkę swojej\nzmarłej matki, więc nikt nie ma\npojęcia, jak wygląda jego ukryta twarz.</language>
	</row>
	<row id="msg_0804_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbiera kości z nieznanego\nmiejsca. Niektórzy szepczą, że\ngdzieś na świecie istnieje cmentarzysko MAROWAKÓW.</language>
	</row>
	<row id="msg_0804_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zacznie kopać\nwielokrotnie, obie nogi wyciągną\nsię jeszcze dłużej, by trafić uciekającego wroga.</language>
	</row>
	<row id="msg_0804_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciosy rozcinają\npowietrze. Są wystrzeliwane z\ntaką prędkością, że nawet lekkie draśnięcie może spowodować poparzenie.</language>
	</row>
	<row id="msg_0804_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego długi język, oblepiony\nlepką śliną, przywiera do\nwszystkiego, więc jest bardzo przydatny.</language>
	</row>
	<row id="msg_0804_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trujące gazy, które\nzawiera, są nieco lżejsze od\npowietrza, co utrzymuje go lekko unoszącego się w powietrzu.</language>
	</row>
	<row id="msg_0804_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Perfumy najwyższej jakości\nrobi się z jego wewnętrznych\ntrujących gazów, rozcieńczając je do najwyższego poziomu.</language>
	</row>
	<row id="msg_0804_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie obchodzi go, czy coś\nstoi mu na drodze. Po prostu\nszarżuje i niszczy wszystkie przeszkody.</language>
	</row>
	<row id="msg_0804_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego mózg rozwinął się, gdy\nzaczął chodzić na tylnych\nnogach. Jego gruba skóra chroni go nawet w magmie.</language>
	</row>
	<row id="msg_0804_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będąc nielicznym i trudnym\ndo złapania, mówi się, że\nprzynosi szczęście trenerowi, który go złapie.</language>
	</row>
	<row id="msg_0804_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oplątuje każdą poruszającą\nsię rzecz swoimi pnączami.\nIch subtelne drganie łaskocze, gdy zostaniesz w nie schwytany.</language>
	</row>
	<row id="msg_0804_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By chronić swoje młode,\nnigdy się nie podda w walce,\nbez względu na to, jak bardzo jest ranny.</language>
	</row>
	<row id="msg_0804_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego duże, rozwinięte płetwy\nporuszają się szybko, pozwalając\nmu pływać do tyłu, wciąż będąc zwróconym do przodu.</language>
	</row>
	<row id="msg_0804_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czubki jego płetw wyciekają\ntrucizną. Jego płetwy i kości są\nwysoko cenione jako składniki medycyny ziołowej.</language>
	</row>
	<row id="msg_0804_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Silny pływak, potrafi\npływać nieprzerwanie pod prąd\nszybkich strumieni w stałym tempie ośmiu kilometrów na godzinę.</language>
	</row>
	<row id="msg_0804_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używając rogu, wierci\notwory w głazach na dnie rzeki,\ntworząc gniazda, by zapobiec zmyciu jaj.</language>
	</row>
	<row id="msg_0804_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet jeśli jego ciało\nzostanie rozerwane, może się\nregenerować, dopóki świecący centralny rdzeń pozostaje nienaruszony.</language>
	</row>
	<row id="msg_0804_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niezależnie od środowiska,\nw którym żyje, jego ciało rośnie,\ntworząc symetryczny geometryczny kształt.</language>
	</row>
	<row id="msg_0804_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czubki jego palców\nemitują dziwne pole siłowe,\nktóre utwardza powietrze, tworząc prawdziwą ścianę.</language>
	</row>
	<row id="msg_0804_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy się porusza, zostawia\ntylko smugę. Jeśli ukryje się w\ntrawie, ochronne ubarwienie czyni go niewidzialnym.</language>
	</row>
	<row id="msg_0804_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi językiem podobnym do\nludzkiego. Jednak wydaje się, że\ndo komunikacji używa tańca.</language>
	</row>
	<row id="msg_0804_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało nieustannie\nwyładowuje elektryczność.\nPodejście blisko sprawi, że włosy staną ci dęba.</language>
	</row>
	<row id="msg_0804_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ognista powierzchnia jego\nciała emituje falujący, drgający\nblask podobny do słońca.</language>
	</row>
	<row id="msg_0804_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wymachuje dziko swoimi\ndługimi szczypcowymi rogami, by\nzaatakować. W chłodnych porach ukrywa się głęboko w lasach.</language>
	</row>
	<row id="msg_0804_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po wzmocnieniu woli walki,\nbatożąc się trzema ogonami,\nszarżuje z pełną prędkością.</language>
	</row>
	<row id="msg_0804_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bez powodu skacze i\npluska się, przez co łatwo łapią\ngo drapieżniki takie jak PIDGEOTTO w trakcie skoku.</language>
	</row>
	<row id="msg_0804_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy się pojawia, wpada w\nszał. Pozostaje wściekły, aż\nzniszczy wszystko dookoła.</language>
	</row>
	<row id="msg_0804_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przewozi ludzi przez morze\nna swoim grzbiecie. Może zaśpiewać\nzachwycający krzyk, gdy jest w dobrym humorze.</language>
	</row>
	<row id="msg_0804_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego zdolność przemiany\njest doskonała. Jednak jeśli\nzostanie rozśmieszony, nie potrafi utrzymać przebrania.</language>
	</row>
	<row id="msg_0804_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na jego nieregularne DNA\nwpływa otoczenie. Ewoluuje,\njeśli jego środowisko się zmieni.</language>
	</row>
	<row id="msg_0804_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Preferuje piękne wybrzeża.\nMając komórki podobne do\ncząsteczek wody, mógłby stopić się w wodzie.</language>
	</row>
	<row id="msg_0804_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Każdy włos na jego ciele\nzaczyna stawać ostro dęba, jeśli\nnaładuje się elektrycznością.</language>
	</row>
	<row id="msg_0804_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadyma swój futrzany kołnierz,\nby obniżyć temperaturę ciała,\nktóra może sięgać 900 stopni Celsjusza.</language>
	</row>
	<row id="msg_0804_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sztuczny Pokémon, który\npowstał w wyniku badań.\nZaprogramowany jest tylko z podstawowymi ruchami.</language>
	</row>
	<row id="msg_0804_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon ze starożytnych\nczasów podobno żeglował po\nmorzu, zręcznie wykręcając swoich 10 macek.</language>
	</row>
	<row id="msg_0804_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy raz owinie się wokół\nofiary, nigdy nie puszcza. Zjada\nofiarę, rozrywając ją ostrymi kłami.</language>
	</row>
	<row id="msg_0804_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon żył w\nstarożytnych czasach. Sporadycznie\nodkrywano go jako żywą skamielinę.</language>
	</row>
	<row id="msg_0804_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostrymi pazurami ten\nokrutny, starożytny Pokémon\nrozdziera ofiary i wysysa ich płyny ustrojowe.</language>
	</row>
	<row id="msg_0804_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten okrutny\nPokémon latał na starożytnym\nniebie, wydając wysokie, przenikliwe krzyki.</language>
	</row>
	<row id="msg_0804_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Soki trawienne w jego\nżołądku mogą rozpuścić dowolny\nrodzaj trucizny. Może nawet jeść rzeczy z ziemi.</language>
	</row>
	<row id="msg_0804_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden z legendarnych ptasich\nPokémonów, schładza wilgoć w\natmosferze, by tworzyć śnieg podczas lotu.</language>
	</row>
	<row id="msg_0804_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten legendarny\nptasi Pokémon pojawia się tylko,\ngdy chmura burzowa rozdziela się na dwie połowy.</language>
	</row>
	<row id="msg_0804_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten legendarny\nptasi Pokémon sprowadza\nwczesną wiosnę do zimowych krain, które odwiedza.</language>
	</row>
	<row id="msg_0804_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon jest pełen\nenergii życiowej. Nieustannie\nzrzuca skórę i stopniowo rośnie.</language>
	</row>
	<row id="msg_0804_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego kryształowe kule\nwydają się dawać temu\nPokémonowi moc swobodnej kontroli nad pogodą.</language>
	</row>
	<row id="msg_0804_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten morski Pokémon ma\nimponującą budowę, która pozwala\nmu swobodnie latać nad szalejącymi morzami bez trudu.</language>
	</row>
	<row id="msg_0804_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle pozostaje nieruchomy,\nby oszczędzać energię, tak\nby móc uwolnić pełną moc w walce.</language>
	</row>
	<row id="msg_0804_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jego DNA zawiera\nkody genetyczne wszystkich\nPokémonów, więc może używać wszystkich rodzajów technik.</language>
	</row>
	<row id="msg_0804_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego przyjemnie aromatyczny\nliść ma zdolność sprawdzania\nwilgotności i temperatury.</language>
	</row>
	<row id="msg_0804_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostry aromat unosi się\nwokół jego szyi. Aromat działa\njak stymulant przywracający zdrowie.</language>
	</row>
	<row id="msg_0804_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oddech MEGANIUM ma moc\nprzywracania do życia martwej\ntrawy i roślin. Może sprawić, że staną się znów zdrowe.</language>
	</row>
	<row id="msg_0804_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle pozostaje\nprzygarbiony. Jeśli jest zły\nlub zaskoczony, strzela płomieniami z grzbietu.</language>
	</row>
	<row id="msg_0804_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon jest w pełni\npokryty niepalnym futrem. Może\nwytrzymać każdy rodzaj ataku ognia.</language>
	</row>
	<row id="msg_0804_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma tajny, niszczycielski\nruch. Ociera swoje płonące\nfutro o siebie, by wywołać ogromne eksplozje.</language>
	</row>
	<row id="msg_0804_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest mały, ale szorstki i\ntwardy. Bez wahania ugryzie\nwszystko, co się poruszy.</language>
	</row>
	<row id="msg_0804_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Otwiera szeroko swoje\nogromne szczęki, atakując. Jeśli\nstraci kły podczas gryzienia, odrastają.</language>
	</row>
	<row id="msg_0804_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trudno mu utrzymać swój\nciężar poza wodą, więc czasem\nopiera się na wszystkich czterech. Ale porusza się szybko.</language>
	</row>
	<row id="msg_0804_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stoi na ogonie, by widzieć\ndaleko. Jeśli zauważy wroga,\ngłośno krzyczy, by ostrzec swój gatunek.</language>
	</row>
	<row id="msg_0804_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie wiadomo, gdzie zaczyna\nsię ogon. Mimo krótkich nóg,\njest szybki i lubi ścigać RATTATA.</language>
	</row>
	<row id="msg_0804_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma doskonałe wyczucie\nczasu. Cokolwiek się dzieje,\nutrzymuje rytm, precyzyjnie kiwając głową w takt.</language>
	</row>
	<row id="msg_0804_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy musi myśleć, obraca\ngłowę o 180 stopni, by wyostrzyć\nswoją zdolność intelektualną.</language>
	</row>
	<row id="msg_0804_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy robi się zimno, mnóstwo\nLEDYB gromadzi się zewsząd,\nby skupić się i grzać nawzajem.</language>
	</row>
	<row id="msg_0804_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wzory plamek na jego\ngrzbiecie rosną lub maleją w\nzależności od liczby gwiazd na nocnym niebie.</language>
	</row>
	<row id="msg_0804_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wytwarza sieć z cienkiej,\nale wytrzymałej nici. Potem\ncierpliwie czeka, aż ofiara się w nią złapie.</language>
	</row>
	<row id="msg_0804_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pojedyncza nić specjalnej\nprzędzy jest nieustannie\nwysnuwana z tyłu jego ciała. Nić prowadzi z powrotem do gniazda.</language>
	</row>
	<row id="msg_0804_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozwój skrzydeł na jego\nnogach pozwala mu szybko latać,\nale też utrudnia zatrzymanie się i odpoczynek.</language>
	</row>
	<row id="msg_0804_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na ciemnym dnie oceanu\njego jedynym środkiem komunikacji\njest nieustannie migoczące światło.</language>
	</row>
	<row id="msg_0804_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oślepia ofiarę intensywnym\nbłyskiem światła. Gdy ofiara\njest sparaliżowana, Pokémon połyka ją w jednym kęsie.</language>
	</row>
	<row id="msg_0804_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mimo małego rozmiaru,\npotrafi porazić nawet dorosłego\nczłowieka. Jednak robiąc to, sam się zaskakuje.</language>
	</row>
	<row id="msg_0804_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy liczne meteory\noświetlają nocne niebo, obserwacje\nCLEFFA dziwnie się zwiększają.</language>
	</row>
	<row id="msg_0804_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego niezwykle elastyczne\nciało sprawia, że nieustannie\nsię odbija--zawsze i wszędzie.</language>
	</row>
	<row id="msg_0804_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przysłowie głosi, że\nszczęście przyjdzie do każdego,\nkto zdoła postawić śpiącego TOGEPI na nogi.</language>
	</row>
	<row id="msg_0804_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Traci ducha, jeśli nie jest\nz życzliwymi ludźmi. Potrafi\nunosić się w powietrzu, nie poruszając skrzydłami.</language>
	</row>
	<row id="msg_0804_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle szuka jedzenia na\nziemi, ale sporadycznie może\nwskoczyć na gałęzie, by dziobać pędy.</language>
	</row>
	<row id="msg_0804_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W Ameryce Południowej mówi\nsię, że jego prawe oko widzi\nprzyszłość, a lewe patrzy w przeszłość.</language>
	</row>
	<row id="msg_0804_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego runo rośnie\nnieustannie. Latem runo w\npełni się zrzuca, ale odrasta w ciągu tygodnia.</language>
	</row>
	<row id="msg_0804_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego puszyste runo łatwo\nmagazynuje elektryczność. Jego\ngumowata skóra chroni go przed porażeniem.</language>
	</row>
	<row id="msg_0804_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jasne światło na jego\nogonie widać z daleka. Od\nstarożytności jest cenione jako latarnia.</language>
	</row>
	<row id="msg_0804_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powszechne w tropikach. Gdy\ntańczy, jego płatki ocierają się\no siebie, wydając przyjemny dźwięk dzwonienia.</language>
	</row>
	<row id="msg_0804_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czubek jego ogona służy\njako boja, która chroni go przed\nutonięciem, nawet w gwałtownym prądzie.</language>
	</row>
	<row id="msg_0804_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy bawi się w wodzie,\nzwija swoje wydłużone uszy, by\nzapobiec zamoczeniu ich wnętrza.</language>
	</row>
	<row id="msg_0804_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maskuje się jako drzewo, by\nuniknąć ataku. Nienawidzi wody,\nwięc zniknie, jeśli zacznie padać.</language>
	</row>
	<row id="msg_0804_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy zbierze się troje lub\nwięcej z nich, śpiewają głośnym\ngłosem, który brzmi jak ryk.</language>
	</row>
	<row id="msg_0804_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało jest tak lekkie,\nże musi mocno trzymać się ziemi\nstopami, by nie zostać zdmuchnięty.</language>
	</row>
	<row id="msg_0804_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozkłada swoje płatki, by\nabsorbować światło słoneczne.\nUnosi się też w powietrzu, by być bliżej słońca.</language>
	</row>
	<row id="msg_0804_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dryfuje na sezonowych\nwiatrach i rozsypuje swoje\nbawełniane zarodniki po całym świecie, by wydać więcej potomstwa.</language>
	</row>
	<row id="msg_0804_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje na szczytach wysokich\ndrzew. Skacząc z gałęzi na\ngałąź, sprawnie używa ogona do równowagi.</language>
	</row>
	<row id="msg_0804_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje, pijąc tylko krople rosy\nspod liści roślin. Mówi się, że\nnie je niczego innego.</language>
	</row>
	<row id="msg_0804_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W dzień pędzi wokół w\ngorączkowy sposób, ale zupełnie\nsię zatrzymuje, gdy słońce zachodzi.</language>
	</row>
	<row id="msg_0804_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego duże oczy potrafią\nskanować 360 stopni. Patrzy we\nwszystkich kierunkach, szukając owadów jako swojej ofiary.</language>
	</row>
	<row id="msg_0804_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy chodzi po ziemi, powleka\nswoje ciało śliską, trującą\nbłoną.</language>
	</row>
	<row id="msg_0804_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ze względu na zrelaksowane\ni beztroskie nastawienie, często\nuderza głową o głazy i kadłuby łodzi podczas pływania.</language>
	</row>
	<row id="msg_0804_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odczytując prądy powietrzne,\npotrafi przewidzieć takie rzeczy\njak pogoda czy następny ruch wroga.</language>
	</row>
	<row id="msg_0804_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy zapada ciemność,\npierścienie na ciele zaczynają\nświecić, wzbudzając strach w sercach każdego w pobliżu.</language>
	</row>
	<row id="msg_0804_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że gdy jest\nścigany, wabi napastnika na\nciemne górskie szlaki, gdzie wróg się zgubi.</language>
	</row>
	<row id="msg_0804_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jego głowa została\nugryziona, toksyny weszły do\ngłowy SLOWPOKE i uwolniły nadzwyczajną moc.</language>
	</row>
	<row id="msg_0804_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbia gryźć i szarpać\nludzi za włosy od tyłu bez\nostrzeżenia, tylko po to, by zobaczyć ich zszokowane reakcje.</language>
	</row>
	<row id="msg_0804_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego płaskie, cienkie ciało\nzawsze przylega do ścian. Jego\nkształt wydaje się mieć jakieś znaczenie.</language>
	</row>
	<row id="msg_0804_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By ukryć swój\nczarny jak smoła ogon, żyje\nspokojnie w ciemności. Nigdy nie atakuje pierwszy.</language>
	</row>
	<row id="msg_0804_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ogon, który zawiera\ntakże mały mózg, może ugryźć\nsamodzielnie, jeśli wyczuje kuszący zapach.</language>
	</row>
	<row id="msg_0804_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwisa i czeka, aż zbliży\nsię latający owad będący jego\nofiarą. Sam z siebie niewiele się porusza.</language>
	</row>
	<row id="msg_0804_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozostaje nieruchomo\nzakorzeniony w swoim drzewie.\nRozsypuje kawałki twardej skorupy, by odstraszyć wrogów.</language>
	</row>
	<row id="msg_0804_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli zostanie zauważony,\nucieka, wwiercając się ogonem.\nMoże unosić się nieznacznie, używając skrzydeł.</language>
	</row>
	<row id="msg_0804_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle przywiera do\nklifów. Gdy dostrzeże ofiarę,\nrozkłada skrzydła i szybuje w dół, by zaatakować.</language>
	</row>
	<row id="msg_0804_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jeśli ONIX żyje\n100 lat, jego budowa staje się\npodobna do diamentu, gdy ewoluuje w STEELIXA.</language>
	</row>
	<row id="msg_0804_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma aktywną, zabawową\nnaturę. Wiele kobiet lubi się z\nnim bawić z powodu jego czułego usposobienia.</language>
	</row>
	<row id="msg_0804_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ jego kły są zbyt\nciężkie, zawsze trzyma głowę\npochyloną. Jednak jego ugryzienie jest potężne.</language>
	</row>
	<row id="msg_0804_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Małe kolce pokrywające\njego ciało rozwinęły się z łusek.\nWstrzykują toksynę, która powoduje omdlenie.</language>
	</row>
	<row id="msg_0804_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego skrzydła nie służą do\nlatania. Trzepocze nimi z dużą\nprędkością, by regulować temperaturę ciała.</language>
	</row>
	<row id="msg_0804_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przechowuje jagody wewnątrz\nswojej skorupy. By uniknąć\nataków, chowa się pod skałami i pozostaje całkowicie nieruchomy.</language>
	</row>
	<row id="msg_0804_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle łagodny, ale jeśli\nzostanie zakłócony podczas\npicia miodu, przegania intruza rogiem.</language>
	</row>
	<row id="msg_0804_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Okrutny z natury, wypędza\nPIDGEY z ich gniazd i wygrzebuje\nwszelkie resztki, jakie znajdzie.</language>
	</row>
	<row id="msg_0804_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zanim jedzenie staje się\nrzadkie w zimie, ma zwyczaj\ngromadzić jedzenie w wielu ukrytych miejscach.</language>
	</row>
	<row id="msg_0804_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki zdolności\nrozróżniania każdego zapachu,\nniezawodnie znajduje wszelkie jedzenie zakopane głęboko pod ziemią.</language>
	</row>
	<row id="msg_0804_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powszechny widok na\nobszarach wulkanicznych, powoli\npełza w ciągłym poszukiwaniu ciepłych miejsc.</language>
	</row>
	<row id="msg_0804_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego krucha skorupa\nsporadycznie tryska intensywnymi\npłomieniami, które krążą po całym jego ciele.</language>
	</row>
	<row id="msg_0804_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli poczuje coś\nkuszącego, rzuca się na oślep, by\nznaleźć źródło aromatu.</language>
	</row>
	<row id="msg_0804_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli szarżuje na wroga,\nwłosy na jego grzbiecie stają\ndęba. Jest bardzo wrażliwy na dźwięki.</language>
	</row>
	<row id="msg_0804_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W narodzie na południowych\nmorzach ludzie żyją w\nspołecznościach zbudowanych na grupach tych Pokémonów.</language>
	</row>
	<row id="msg_0804_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używając płetwy grzbietowej\njako przyssawki, przywiera do\nspodu MANTINE’A, by żywić się resztkami.</language>
	</row>
	<row id="msg_0804_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Instynktownie wślizguje się\nw skaliste dziury. Jeśli robi\nsię senny, kradnie gniazdo innego OCTILLERY.</language>
	</row>
	<row id="msg_0804_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gnieździ się na krawędzi\nostrych klifów. Spędza cały\ndzień, nosząc jedzenie do czekających piskląt.</language>
	</row>
	<row id="msg_0804_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swobodnie pływając na\notwartym morzu, może wylecieć z\nwody i ponad falami, jeśli nabierze wystarczającej prędkości.</language>
	</row>
	<row id="msg_0804_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po zagnieżdżeniu się w\njeżynowych krzewach, skrzydła\njego piskląt twardnieją od zadrapań cierniami.</language>
	</row>
	<row id="msg_0804_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By osaczyć ofiarę, sprawdzają\nswoje wzajemne położenie za\npomocą szczekania, które tylko one rozumieją.</language>
	</row>
	<row id="msg_0804_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Słysząc jego przerażające\nwycie, inne Pokémony dostają\ndreszczy i wracają prosto do swoich gniazd.</language>
	</row>
	<row id="msg_0804_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śpi głęboko na dnie oceanu,\nby zgromadzić energię. Mówi się,\nże powoduje tornada, gdy się budzi.</language>
	</row>
	<row id="msg_0804_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jako oznakę uczucia,\nszturcha swoim pyskiem. Jednak\njest tak silny, że może cię wysłać w powietrze.</language>
	</row>
	<row id="msg_0804_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Im dłuższe i większe jego\nkły, tym wyższa jego ranga w\nstadzie. Kły potrzebują dużo czasu, by urosnąć.</language>
	</row>
	<row id="msg_0804_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dalsze badania ulepszyły\njego zdolności. Czasem może\nprzejawiać ruchy, które nie zostały zaprogramowane.</language>
	</row>
	<row id="msg_0804_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ci, którzy wpatrują się w\njego rogi, stopniowo tracą\nkontrolę nad zmysłami i nie są w stanie stać.</language>
	</row>
	<row id="msg_0804_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy staje się dorosły, ma\ntendencję do pozwalania\ntowarzyszom odciskać ślady stóp na jego grzbiecie.</language>
	</row>
	<row id="msg_0804_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć jest mały, nie można\ngo zignorować, bo bez ostrzeżenia\nuderzy każdy dostępny cel.</language>
	</row>
	<row id="msg_0804_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zadaje kopnięcia, wirując.\nJeśli wiruje z dużą prędkością,\nmoże wwiercić się w ziemię.</language>
	</row>
	<row id="msg_0804_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze powoli kołysze\ngłową do przodu i do tyłu, jakby\npróbował kogoś pocałować.</language>
	</row>
	<row id="msg_0804_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet w najgwałtowniejszej\nburzy ten Pokémon bawi się\nszczęśliwie, gdy grzmi na niebie.</language>
	</row>
	<row id="msg_0804_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Można go znaleźć w\nkraterach wulkanów. Temperatura\njego ciała przekracza 590 stopni Celsjusza, więc nie lekceważ go.</language>
	</row>
	<row id="msg_0804_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jest w pobliżu\nniemowląt, mleko, które produkuje,\nzawiera dużo więcej składników odżywczych niż zwykle.</language>
	</row>
	<row id="msg_0804_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma bardzo współczującą\nnaturę. Jeśli zobaczy chorego\nPokémona, będzie pielęgnował go, by wrócił do zdrowia.</language>
	</row>
	<row id="msg_0804_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który pędzi przez\nkrainę, szczekając krzykiem\nbrzmiącym jak trzask pioruna.</language>
	</row>
	<row id="msg_0804_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który pędzi przez\nkrainę. Mówi się, że rodzi się\njeden za każdym razem, gdy pojawia się nowy wulkan.</language>
	</row>
	<row id="msg_0804_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon pędzi przez\nkrainę. Mówi się, że północne\nwiatry jakoś zaczynają wiać, gdy się pojawia.</language>
	</row>
	<row id="msg_0804_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rodzi się głęboko pod\nziemią. Nie może się wyłonić,\ndopóki całkowicie nie skonsumuje otaczającej go gleby.</language>
	</row>
	<row id="msg_0804_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nawet zamknięty w swojej\nskorupie, potrafi się swobodnie\nporuszać. Twardy i szybki, ma niesamowitą siłę niszczenia.</language>
	</row>
	<row id="msg_0804_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niezwykle silny, potrafi\nzmienić krajobraz. Ma bezczelną\nnaturę, przez którą nie obchodzą go inni.</language>
	</row>
	<row id="msg_0804_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jest\nstrażnikiem mórz. Podobno widziano\ngo w noc burzy.</language>
	</row>
	<row id="msg_0804_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Legenda mówi, że jego\nciało świeci siedmioma kolorami.\nMówi się, że tęcza tworzy się za nim, gdy leci.</language>
	</row>
	<row id="msg_0804_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy CELEBI znika głęboko\nw lesie, mówi się, że zostawia\njajko, które przyniósł z przyszłości.</language>
	</row>
	<row id="msg_0804_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Małe haczyki pod jego\nstopami zaczepiają się o ściany\ni sufity. Tak może zwisać nad głową.</language>
	</row>
	<row id="msg_0804_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skacze z gałęzi na gałąź\ndość zwinnie. Wykazuje\nzdumiewającą zwinność.</language>
	</row>
	<row id="msg_0804_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwinnie skacze po dżungli i\nużywa ostrych liści na\nramionach, by uderzyć swoją ofiarę.</language>
	</row>
	<row id="msg_0804_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wewnątrz jego ciała jest\nmiejsce, gdzie przechowuje mały\npłomień. Przytul go! Będzie ciepły jak termofor.</language>
	</row>
	<row id="msg_0804_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podczas walki gorący płomień\nw jego ciele nasila się. Jego\nkopnięcia mają niesamowitą siłę niszczenia.</language>
	</row>
	<row id="msg_0804_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może pokonać 30-piętrowy\nbudynek jednym skokiem. Jego\nogniste ciosy palą wrogów.</language>
	</row>
	<row id="msg_0804_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego siła może zmiażdżyć\ngłazy. Odpoczywa, okrywając\nsię błotem na dnie rzeki.</language>
	</row>
	<row id="msg_0804_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Życie na błotnistej ziemi,\ndającej słabe oparcie, wzmocniło\njego nogi.</language>
	</row>
	<row id="msg_0804_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ramiona są twarde jak\nskała. Jednym uderzeniem może\nrozbić głaz na kawałki.</language>
	</row>
	<row id="msg_0804_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ściga swoją ofiarę, aż ta\nsię wyczerpie. Jednak ucieka,\njeśli ofiara zaatakuje z powrotem.</language>
	</row>
	<row id="msg_0804_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ściga ofiarę w watasze\nliczącej około dziesięciu. Pokonują\nwrogów dzięki doskonale skoordynowanej pracy zespołowej.</language>
	</row>
	<row id="msg_0804_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Interesuje go wszystko,\ndlatego kluczy. Jest dobry w\nznajdowaniu przedmiotów.</language>
	</row>
	<row id="msg_0804_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Biegnąc w linii prostej, może\nłatwo przekroczyć 100 km/h. Ma\ntrudności z zakrętami.</language>
	</row>
	<row id="msg_0804_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje wśród wysokiej trawy i w\nlasach. Odpiera ataki, unosząc\nkolce na tylnej części ciała.</language>
	</row>
	<row id="msg_0804_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Owinąwszy jedwab wokół\ngałęzi drzewa, spokojnie czeka\nna ewolucję.</language>
	</row>
	<row id="msg_0804_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wyróżniającą cechą są\nskrzydła w żywych wzorach.\nSsie słodki nektar kwiatów swoim długim pyszczkiem.</language>
	</row>
	<row id="msg_0804_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znosi ataki cierpliwie, bo\nim więcej bólu przed ewolucją,\ntym twardszy się staje.</language>
	</row>
	<row id="msg_0804_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozsypuje swój drobny pył\nwszędzie, gdy zostanie\nzaatakowany. To nocny Pokémon.</language>
	</row>
	<row id="msg_0804_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego liść urósł zbyt duży,\nby mógł żyć na lądzie. Tak\nzaczął żyć, unosząc się na wodzie.</language>
	</row>
	<row id="msg_0804_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest nocny i staje się\naktywny o zmierzchu. Żywi się\nwodnymi mchami rosnącymi w korycie rzeki.</language>
	</row>
	<row id="msg_0804_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli usłyszy świąteczną\nmuzykę, zaczyna się poruszać w\nrytm, by wzmocnić swoją moc.</language>
	</row>
	<row id="msg_0804_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyczepia się do gałęzi\ndrzewa czubkiem głowy. Silne\nwiatry czasem mogą sprawić, że spadnie.</language>
	</row>
	<row id="msg_0804_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje głęboko w lasach.\nZ liścia na głowie robi flet,\nktórego melodia sprawia, że słuchaczom robi się nieswojo.</language>
	</row>
	<row id="msg_0804_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje spokojnie w głębokim\nlesie. Mówi się, że wachlarzami,\nktóre trzyma, tworzy chłodne zimowe wiatry.</language>
	</row>
	<row id="msg_0804_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy robi się zimno, migrują,\nprzelatując ponad 290 kilometrów\ndziennie. Poluje na smaczną ofiarę.</language>
	</row>
	<row id="msg_0804_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nurkuje pod ostrym kątem, gdy\ntylko dostrzeże swoją ofiarę.\nŁapie ją ostrymi pazurami.</language>
	</row>
	<row id="msg_0804_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szybuje na prądach\nwznoszących, nie machając\nskrzydłami. Buduje gniazdo na stromych klifach nad morzem.</language>
	</row>
	<row id="msg_0804_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chroni swoje młode w\ndziobie. Kołysze się na falach,\nodpoczywając na nich w spokojne dni.</language>
	</row>
	<row id="msg_0804_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rogi na jego głowie dają mu\nsilną moc, która pozwala mu\nwyczuwać emocje ludzi.</language>
	</row>
	<row id="msg_0804_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma moc psychiczną, która\npozwala mu zniekształcać przestrzeń\nwokół siebie i widzieć przyszłość.</language>
	</row>
	<row id="msg_0804_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwalnia energię psychokinetyczną\nz pełną mocą, chroniąc trenera,\nz którym blisko się związał.</language>
	</row>
	<row id="msg_0804_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydziela gęsty, słodko\npachnący syrop z czubka głowy.\nŻyje w stawach zarośniętych chwastami.</language>
	</row>
	<row id="msg_0804_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepocze czterema skrzydłami,\nby zawisnąć i swobodnie latać\nw dowolnym kierunku--tam i z powrotem oraz w bok.</language>
	</row>
	<row id="msg_0804_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli wyczuje niebezpieczeństwo,\nrozsypuje zarodniki z czubka\ngłowy, by się chronić.</language>
	</row>
	<row id="msg_0804_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozsypuje trujące zarodniki i\nrzuca potężne ciosy, podczas\ngdy jego wróg jest osłabiony wdychanymi zarodnikami.</language>
	</row>
	<row id="msg_0804_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sposób, w jaki SLAKOTH się\nrozwala, sprawia, że każdy, kto\nna niego patrzy, ma ochotę zrobić to samo.</language>
	</row>
	<row id="msg_0804_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego poziom stresu wzrasta,\njeśli nie może się nieustannie\nporuszać. Zbyt duży stres sprawia, że czuje się chory.</language>
	</row>
	<row id="msg_0804_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najleniwszy Pokémon na\nświecie. Przenosi się w inne\nmiejsce, gdy w zasięgu nie ma już jedzenia.</language>
	</row>
	<row id="msg_0804_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czasem może żyć pod ziemią\nprzez ponad 10 lat. Wchłania\nsubstancje odżywcze z korzeni drzew.</language>
	</row>
	<row id="msg_0804_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego krzyk pozostawia trwały\nból głowy, jeśli słucha się go\nzbyt długo. Porusza się tak szybko, że jest niemal niewidoczny.</language>
	</row>
	<row id="msg_0804_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dziwny Pokémon--lata bez\nporuszania skrzydłami, ma pustą\nskorupę zamiast ciała i nie oddycha.</language>
	</row>
	<row id="msg_0804_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli wyczuje niebezpieczeństwo,\nstrasza wroga, krzycząc z\ngłośnością silnika odrzutowca.</language>
	</row>
	<row id="msg_0804_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Krzyczy głośno, wdychając\npowietrze, a potem wydycha\nje, używając dobrze rozwiniętych mięśni brzucha.</language>
	</row>
	<row id="msg_0804_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ryk podczas walki wstrząsa\nziemią jak drżenie--albo jak\ntrzęsienie ziemi.</language>
	</row>
	<row id="msg_0804_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hartuje się, uderzając\nwielokrotnie w grube drzewa.\nZyskuje wytrzymałe ciało i nieustraszonego ducha.</language>
	</row>
	<row id="msg_0804_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbia wyzywać innych na\npróby siły. Ma moc, by zatrzymać\npociąg jednym klaśnięciem.</language>
	</row>
	<row id="msg_0804_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ogon jest pełen\nsubstancji odżywczych, których\npotrzebuje, by rosnąć.</language>
	</row>
	<row id="msg_0804_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli spotka się dwóch z\nnich, nie mogą podejść zbyt\nblisko, bo ich nosy się odpychają.</language>
	</row>
	<row id="msg_0804_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest urocze, gdy ściga\nwłasny ogon. Trudno zdobyć jego\nzaufanie.</language>
	</row>
	<row id="msg_0804_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie lubi brudnych miejsc.\nCzęsto szuka wygodnego miejsca,\nby się wypielęgnować.</language>
	</row>
	<row id="msg_0804_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mieszka w ciemności jaskiń.\nUżywa ostrych pazurów, by\nwykopywać klejnoty, którymi się odżywia.</language>
	</row>
	<row id="msg_0804_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kłapie szeroko otwartym\npyskiem. Jego ogromne szczęki\nto w rzeczywistości przekształcone stalowe rogi.</language>
	</row>
	<row id="msg_0804_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy ewoluuje, zrzuca stalowy\npancerz, który pokrywał całe\njego ciało, i wykształca nowy.</language>
	</row>
	<row id="msg_0804_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uwielbia rudę żelaza. Grupy\nz nich walczą o terytorium,\nuderzając się nawzajem swoimi stalowymi ciałami.</language>
	</row>
	<row id="msg_0804_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wiek można poznać po\ndługości żelaznych rogów.\nRości sobie prawo do całej góry jako swojego terytorium.</language>
	</row>
	<row id="msg_0804_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Medytuje, by wzmocnić\nwewnętrzną energię i unosić\nsię w powietrzu. Je jedną jagodę dziennie.</language>
	</row>
	<row id="msg_0804_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki treningowi jogi\nzyskał moc psychiczną, by\nprzewidywać kolejny ruch wroga.</language>
	</row>
	<row id="msg_0804_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Magazynuje elektryczność w\nswoim futrze. Wydziela iskry z\ncałego ciała w porach roku, gdy powietrze jest suche.</language>
	</row>
	<row id="msg_0804_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego gniazdo można znaleźć\ntam, gdzie uderzył piorun.\nWyładowuje elektryczność ze swojej grzywy.</language>
	</row>
	<row id="msg_0804_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wchłania elektryczność ze\nsłupów telefonicznych. Zwiera\nswoje ciało, tworząc trzaskające dźwięki.</language>
	</row>
	<row id="msg_0804_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ekspozycja na elektryczność\nod MINUN i PLUSLE poprawia\nkrążenie krwi i rozluźnia mięśnie.</language>
	</row>
	<row id="msg_0804_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Emituje światło z ogona, by\nsię komunikować. Uwielbia słodki\naromat wydzielany przez ILLUMISE.</language>
	</row>
	<row id="msg_0804_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego zapach przyciąga roje\nVOLBEAT, więc razem rysują\nponad 200 wzorów na nocnym niebie.</language>
	</row>
	<row id="msg_0804_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ROSELIA, które piją bogatą\nw substancje odżywcze wodę ze\nźródeł, podobno ujawniają rzadkie zabarwienie podczas kwitnienia.</language>
	</row>
	<row id="msg_0804_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma małe serce i mózg. Jego\nżołądek stanowi większość\nciała, z enzymami, które rozpuszczają wszystko.</language>
	</row>
	<row id="msg_0804_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Połyka wszystko, co zmieści\nsię w jego pysku. Jego specjalne\nenzymy potrafią rozpuścić wszystko.</language>
	</row>
	<row id="msg_0804_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tworzą watahy, by atakować\nłodzie i rozrywać ich kadłuby,\nby je zatopić. Żyją w rzekach w dżungli.</language>
	</row>
	<row id="msg_0804_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może pływać z prędkością\n120 km/h, wystrzeliwując wodę\nmorską przez swoje ciało. To bandyta morza.</language>
	</row>
	<row id="msg_0804_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odbija się zabawowo jak\npiłka. Im więcej wody morskiej\npołknie, tym wyżej się odbija.</language>
	</row>
	<row id="msg_0804_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest największym ze\nwszystkich zidentyfikowanych\nPokémonów. Skaczą stadem, by spędzić swoją ofiarę.</language>
	</row>
	<row id="msg_0804_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Płonąca magma, którą\nmagazynuje w garbie na grzbiecie,\njest źródłem jego ogromnej mocy.</language>
	</row>
	<row id="msg_0804_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w kraterze wulkanu.\nPowszechnie wiadomo, że garby\nna jego grzbiecie wybuchają co 10 lat.</language>
	</row>
	<row id="msg_0804_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Można znaleźć porzucone\nkopalnie węgla pełne tych\nPokémonów. Niestrudzenie kopią w poszukiwaniu węgla.</language>
	</row>
	<row id="msg_0804_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odbija się na swoim ogonie,\nby jego serce nadal pompowało.\nNosi na głowie perłę z CLAMPERL.</language>
	</row>
	<row id="msg_0804_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrafi wykonywać dziwne\nkroki taneczne, by wpływać na\nwrogów. Jego styl tańca stał się ogromnie popularny za granicą.</language>
	</row>
	<row id="msg_0804_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szanse, że dwa SPINDA mają\nidentyczne wzory plamek, są\nmniejsze niż jeden na cztery miliardy.</language>
	</row>
	<row id="msg_0804_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego gniazdo to nachylony,\nprzypominający miskę dół na\npustyni. Gdy coś w niego wpadnie, nie ma ucieczki.</language>
	</row>
	<row id="msg_0804_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Energicznie wibruje\nskrzydłami, tworząc fale\nultradźwiękowe, które wywołują poważne bóle głowy.</language>
	</row>
	<row id="msg_0804_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nazywany jest „Duchem\nPustyni”, bo trzepot jego\nskrzydeł brzmi jak śpiew kobiety.</language>
	</row>
	<row id="msg_0804_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w suchych miejscach.\nJego żółte kwiaty kwitną raz w\nroku.</language>
	</row>
	<row id="msg_0804_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Watahy z nich podążają za\npodróżnikami przez pustynię,\naż podróżnicy nie mogą się już poruszyć.</language>
	</row>
	<row id="msg_0804_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego skrzydła przywodzą na\nmyśl bawełniane chmury. Pielęgnuje\nsię wodą ze źródła i uwielbia siadać na głowach.</language>
	</row>
	<row id="msg_0804_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lata wdzięcznie po niebie.\nJego melodyjne buczenie sprawia,\nże czujesz się jak we śnie.</language>
	</row>
	<row id="msg_0804_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego futro stanęłoby dęba,\ngdyby wyczuł w pobliżu SEVIPERA.\nJego ostre pazury rozrywają wrogów.</language>
	</row>
	<row id="msg_0804_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W walce używa swojego\nostrzowego ogona, by kontrować\nkażdego ZANGOOSE. Wydziela śmiertelną truciznę w ogonie.</language>
	</row>
	<row id="msg_0804_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odkryto go w miejscu\nuderzenia meteorytu 40 lat temu.\nJego spojrzenie może uśpić wrogów.</language>
	</row>
	<row id="msg_0804_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy się obraca, wydaje\nświatło podobne do słonecznego,\noślepiając w ten sposób swoich wrogów.</language>
	</row>
	<row id="msg_0804_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">BARBOACH używa swoich\nwąsów, by smakować rzeczy tak,\njak człowiek używa języka.</language>
	</row>
	<row id="msg_0804_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rości sobie prawo do dużego\nbagna. Jeśli zbliży się wróg,\nwywołuje wstrząsy, szamocząc się.</language>
	</row>
	<row id="msg_0804_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwotnie był Pokémonem z\ndaleka, który uciekł na wolność.\nMoże przystosować się do najbrudniejszej rzeki.</language>
	</row>
	<row id="msg_0804_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Brutalny Pokémon, który uwielbia\nwalkę. Wbije się w każdego wroga,\nktóry zbliży się do jego gniazda.</language>
	</row>
	<row id="msg_0804_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porusza się, wirując na\njednej stopie. Widziano niektóre\nBALTOY wirujące na głowach.</language>
	</row>
	<row id="msg_0804_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że wywodzi się z\ngliniach lalek robionych przez\nstarożytną cywilizację.</language>
	</row>
	<row id="msg_0804_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Maskuje swoje macki jako\nkwiaty, by przyciągnąć i złapać\nofiarę. Wymarł w czasach starożytnych.</language>
	</row>
	<row id="msg_0804_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w ciepłych morzach.\nJego ciężkie ciało utrzymuje go\nw miejscu, by nie zostało zniesione podczas burzy.</language>
	</row>
	<row id="msg_0804_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przodkowski Pokémon, który\nżył w oceanie. Z czasem jego\nosiem nóg przekształciło się w skrzydła.</language>
	</row>
	<row id="msg_0804_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ogromne, chowane pazury\nmogą przeciąć niemal wszystko.\nCałe jego ciało pokryte jest wytrzymałymi płytami.</language>
	</row>
	<row id="msg_0804_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest najbardziej nędznym ze\nwszystkich Pokémonów. Tworzy\nławice i żyje na dnie rzek.</language>
	</row>
	<row id="msg_0804_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jedno spojrzenie\nna MILOTIC i jego piękno\nukoi każdą wrogą emocję, jaką czujesz.</language>
	</row>
	<row id="msg_0804_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon może zmieniać\nswoje komórki, przyjmując różne\nformy w zależności od temperatury i wilgotności.</language>
	</row>
	<row id="msg_0804_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zmienia swoje odcienie, by\ndopasować się do otoczenia, dzięki\nczemu może podkraść się do ofiary. Tylko wzory na brzuchu pozostają stałe.</language>
	</row>
	<row id="msg_0804_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podobno używa rogu, by\nżywić się zawiścią i złośliwością.\nJest bardzo aktywny nocą.</language>
	</row>
	<row id="msg_0804_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon powstał z\nporzuconej lalki, która zgromadziła\nurazę. Widywany jest w mrocznych zaułkach.</language>
	</row>
	<row id="msg_0804_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli znajdzie niegrzeczne\ndzieci, które nie słuchają\nrodziców, podobno je porywa.</language>
	</row>
	<row id="msg_0804_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Każdy, kto odważy się\nspojrzeć w jego ciało, by zobaczyć\njego widmową kulę ognia, straci swojego ducha.</language>
	</row>
	<row id="msg_0804_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grono owoców wokół jego\nszyi dojrzewa dwa razy w roku i\njest przepyszne. To wysoko ceniona tropikalna przekąska.</language>
	</row>
	<row id="msg_0804_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa przyssawki na głowie,\nby zwisać z drzewa lub okapu.\nPotrafi wydawać siedem różnych tonów.</language>
	</row>
	<row id="msg_0804_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma zdolność przewidywania\nklęsk żywiołowych. Jego długość\nżycia przekracza sto lat.</language>
	</row>
	<row id="msg_0804_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma tendencję do poruszania\nsię w watasze. Osobniki ściskają\nsię wzajemnie, by hartować swojego ducha.</language>
	</row>
	<row id="msg_0804_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jeśli zostaną\nzobaczone o północy, spowodują\nobfite opady śniegu. Żywią się śniegiem i lodem, by przetrwać.</language>
	</row>
	<row id="msg_0804_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może natychmiast zamrozić\nwilgoć w atmosferze. Używa tej\nmocy, by zamrażać swoich wrogów.</language>
	</row>
	<row id="msg_0804_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przemierza oceany, tocząc\nsię na dryfującym lodzie.\nPuszyste futro ogrzewa go, gdy temperatura spada poniżej zera.</language>
	</row>
	<row id="msg_0804_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma bardzo wrażliwy nos.\nDotyka nim nowe rzeczy, by je\nzbadać.</language>
	</row>
	<row id="msg_0804_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozłupuje dryfujący lód\nswoimi silnymi kłami. Jego gruba\nwarstwa tłuszczu odpiera ataki wrogów.</language>
	</row>
	<row id="msg_0804_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy ewoluuje, tworzy\ntajemniczą perłę, która wzmacnia\nmoce psychiczne, gdy się ją trzyma.</language>
	</row>
	<row id="msg_0804_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje głęboko w morzu, w\nczarnej ciemności. Przyciąga\nofiary, poruszając ogonem, naśladując małe zwierzę.</language>
	</row>
	<row id="msg_0804_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego różowe ciało staje się\nbardziej intensywne wraz ze\nwzrostem temperatury wody wiosną.</language>
	</row>
	<row id="msg_0804_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odkryty przypadkiem podczas\ngłębinowych eksploracji, nie\nzmienił się od czasów starożytnych.</language>
	</row>
	<row id="msg_0804_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało w kształcie serca\nczyni go popularnym. W niektórych\nmiejscach dałbyś LUVDISCA komuś, kogo kochasz.</language>
	</row>
	<row id="msg_0804_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego dobrze rozwinięte mięśnie\nszyi i żelazna głowa mogą\nrozbić głazy na kawałki.</language>
	</row>
	<row id="msg_0804_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Otacza swoje ciało twardą jak\nżelazo skorupą, by zgromadzić\nwystarczająco mocy do ewolucji.</language>
	</row>
	<row id="msg_0804_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest niekontrolowany, gdy\nrozwścieczony. Lata dookoła,\ntryskając płomieniami i paląc pola i góry.</language>
	</row>
	<row id="msg_0804_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Siła magnetyczna wytwarzana\nprzez jego ciało odpycha naturalny\nmagnetyzm ziemi, pozwalając mu unosić się.</language>
	</row>
	<row id="msg_0804_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy dwa BELDUM łączą się,\nmagnetyczny system nerwowy\nłączy ich mózgi w jedno.</language>
	</row>
	<row id="msg_0804_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Składa cztery nogi podczas\nlotu. Jego cztery mózgi podobno\nprzewyższają superkomputer.</language>
	</row>
	<row id="msg_0804_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Te same skały, z których\nzbudowane jest jego ciało, znaleziono\nw warstwach ziemi na całym świecie.</language>
	</row>
	<row id="msg_0804_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że spał w\nlodowcu przez tysiące lat. Jego\nciała nie można stopić, nawet magmą.</language>
	</row>
	<row id="msg_0804_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Podobno jego ciało jest\ntwardsze niż jakikolwiek metal.\nBadania wykazały, że jego ciało jest puste.</language>
	</row>
	<row id="msg_0804_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Komunikuje się telepatycznie.\nJego ciało pokryte jest puchem,\nktóry załamuje światło, czyniąc go niewidzialnym.</language>
	</row>
	<row id="msg_0804_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozumie ludzką mowę i jest\nniezwykle inteligentny. To czuły\nPokémon, który nie lubi walczyć.</language>
	</row>
	<row id="msg_0804_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mityczny Pokémon, o którym\nmówi się, że wzburzył morza\ndeszczem i falami przypływowymi. Walczył z GROUDONEM.</language>
	</row>
	<row id="msg_0804_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że powiększył\nlądy, odparowując wodę szalejącym\nżarem. Toczył tytaniczną walkę z KYOGRE.</language>
	</row>
	<row id="msg_0804_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lata w warstwie ozonowej,\nwysoko na niebie. Do niedawna\nnikt go nigdy nie widział.</language>
	</row>
	<row id="msg_0804_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokolenia wierzyły, że\njakiekolwiek życzenie zapisane na\nkartce na jego głowie spełni się, gdy się obudzi.</language>
	</row>
	<row id="msg_0804_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">DNA z kosmicznego wirusa\nzmutowało i stało się Pokémonem.\nPojawia się tam, gdzie widoczne są zorze polarne.</language>
	</row>
	<row id="msg_0804_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fotosynteza zachodzi na\ncałym jego ciele pod słońcem.\nSkorupa na jego grzbiecie to w rzeczywistości stwardniała ziemia.</language>
	</row>
	<row id="msg_0804_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GROTLE, który żyje w lesie,\npodobno ma własne, tajemne\nźródło wody.</language>
	</row>
	<row id="msg_0804_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starożytni ludzie wyobrażali\nsobie, że pod ziemią mieszka\nolbrzymi TORTERRA.</language>
	</row>
	<row id="msg_0804_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gaz wytwarzany w jego\nbrzuchu spala się z tylnej\nczęści ciała. Ogień pali się słabo, gdy czuje się chory.</language>
	</row>
	<row id="msg_0804_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Większy ogień na ogonie i\njaśniejszy niebieski wzór na\ntwarzy oznaczają wyższą rangę w watasze.</language>
	</row>
	<row id="msg_0804_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rzuca swoimi wrogami ze\nzwinnością. Używa wszystkich\nkończyn, by walczyć we własnym, unikalnym stylu.</language>
	</row>
	<row id="msg_0804_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie lubi, gdy się nim\nopiekują. Trudno się z nim\nzwiązać, bo nie słucha swojego trenera.</language>
	</row>
	<row id="msg_0804_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w samotności. Jego\nskrzydła zadają złowieszcze ciosy,\nktóre mogą złamać nawet najgrubsze drzewa.</language>
	</row>
	<row id="msg_0804_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Unika niepotrzebnych sporów,\nale zniszczy wszystko, co zagraża\njego dumie.</language>
	</row>
	<row id="msg_0804_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gromadzą się wokół gór i\npól, ścigając owadzie Pokémony.\nIch śpiew jest głośny i irytujący.</language>
	</row>
	<row id="msg_0804_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Utrzymują ogromne stada, choć\nmiędzy różnymi stadami wybuchają\nzaciekłe potyczki.</language>
	</row>
	<row id="msg_0804_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy STARAVIA ewoluują w\nSTARAPTORA, opuszczają stado, by\nżyć samotnie. Mają wytrzymałe skrzydła.</language>
	</row>
	<row id="msg_0804_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w grupach nad wodą.\nGryzie głazy i drzewa wokół\nswojego gniazda swoimi siekaczami.</language>
	</row>
	<row id="msg_0804_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pilnie buduje swoje gniazdo\nze stosów gałęzi i korzeni,\nktóre pocięło swoimi ostrymi siekaczami.</language>
	</row>
	<row id="msg_0804_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jego czułki się uderzają,\nbrzmi to jak muzyka ksylofonu.\n</language>
	</row>
	<row id="msg_0804_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozwalając, by jego krzyk\nrezonował w wydrążonym brzuchu,\nwytwarza urzekający dźwięk.</language>
	</row>
	<row id="msg_0804_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozciąganie i kurczenie\njego mięśni wytwarza elektryczność.\nJego futro świeci, gdy jest w kłopotach.</language>
	</row>
	<row id="msg_0804_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbierając swoje ogony razem,\nwspólnie wytwarzają potężną\nelektryczność ze swoich pazurów.</language>
	</row>
	<row id="msg_0804_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zdolność LUXRAYA do widzenia\nprzez przedmioty przydaje się,\ngdy wypatruje niebezpieczeństwa.</language>
	</row>
	<row id="msg_0804_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy poczuje ciepły dotyk\nsłońca, otwiera pąk, by uwolnić\npyłek. Żyje przy czystych stawach.</language>
	</row>
	<row id="msg_0804_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego słodki aromat\nprzyciąga ofiary. Potem wypluwa\ntruciznę. Im bardziej toksyczny, tym słodszy jego aromat.</language>
	</row>
	<row id="msg_0804_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CRANIDOS hartują swoje i tak\njuż twarde jak skała głowy,\nuderzając się nawzajem głowami.</language>
	</row>
	<row id="msg_0804_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego czaszka wytrzymuje\nuderzenia dowolnej mocy. W\nrezultacie jego mózg nigdy nie ma szansy urosnąć.</language>
	</row>
	<row id="msg_0804_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powstał ze skamieliny\nwykopanej z warstwy gliny\nstarszej, niż ktokolwiek wie. Ma wytrzymałą twarz.</language>
	</row>
	<row id="msg_0804_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy są atakowane, tworzą\nmur. Ich twarde jak skała twarze\nsłużą do ochrony przed atakami.</language>
	</row>
	<row id="msg_0804_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Okrywa się płaszczem, by\nschronić się przed zimnem. Gdy\njest gorąco, jego płaszcz jest cieńszy.</language>
	</row>
	<row id="msg_0804_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że WORMADAM, który\newoluuje w zimny dzień, będzie\nmiał grubszy płaszcz.</language>
	</row>
	<row id="msg_0804_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepocze wokół nocą i\nkradnie miód z ula COMBEE.</language>
	</row>
	<row id="msg_0804_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nocą COMBEE śpią w grupie\nokoło tysiąca, ściśnięte razem\nw grudę.</language>
	</row>
	<row id="msg_0804_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hoduje larwy w otworach w\nswoim ciele. Wydziela feromony,\nby kontrolować COMBEE.</language>
	</row>
	<row id="msg_0804_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest jednym z rodzajów\nPokémonów z elektrycznymi\nworkami policzkowymi. Wystrzeliwuje ładunki z ogona.</language>
	</row>
	<row id="msg_0804_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nadyma swój pęcherz\npływny, trzymając twarz nad\nwodą, by obserwować ruchy ofiary.</language>
	</row>
	<row id="msg_0804_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z nadmuchanym pęcherzem\npływnym może nosić ludzi na\ngrzbiecie. Zdmuchuje pęcherz, zanim zanurkuje.</language>
	</row>
	<row id="msg_0804_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ewoluuje, wysysając energię\nz małej kuli, w której magazynował\nsubstancje odżywcze.</language>
	</row>
	<row id="msg_0804_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W czasie silnego światła\nsłonecznego jego pąk kwitnie,\npłatki w pełni się rozwijają, a on staje się bardzo aktywny.</language>
	</row>
	<row id="msg_0804_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego kształt i zabarwienie\nzmieniają się w zależności od\nsiedliska.</language>
	</row>
	<row id="msg_0804_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy atakuje go naturalny\nwróg, wydziela fioletowy płyn\ni ucieka.</language>
	</row>
	<row id="msg_0804_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardzo trudno uniknąć\nkolejnych uderzeń jego dwóch\nogonów.</language>
	</row>
	<row id="msg_0804_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szepcze się, że każde\ndziecko, które pomyli DRIFLOON z\nbalonem i się go złapie, może zniknąć.</language>
	</row>
	<row id="msg_0804_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może wytwarzać i uwalniać\ngaz wewnątrz swojego ciała.\nDzięki temu potrafi kontrolować wysokość dryfowania.</language>
	</row>
	<row id="msg_0804_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po sposobie, w jaki zwija\nuszy, można poznać jego nastrój.\nGdy jest przestraszony, oba uszy są zwinięte.</language>
	</row>
	<row id="msg_0804_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrzuca futro dwa razy w\nroku. Jego zimowe futro jest\nmiękkie i puszyste.</language>
	</row>
	<row id="msg_0804_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego krzyki brzmią jak\nzaklęcia dręczące wroga. Pojawia\nsię tam, gdzie najmniej się go spodziewasz.</language>
	</row>
	<row id="msg_0804_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest bezlitosny z natury.\nMówi się, że nigdy nie wybacza\nbłędów swoich podwładnych MURKROW.</language>
	</row>
	<row id="msg_0804_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jest szczęśliwy, GLAMEOW\ndemonstruje piękne ruchy ogonem,\njak tańcząca wstążka.</language>
	</row>
	<row id="msg_0804_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zająłby cudze gniazdo jako\nswoje, gdyby uznał je za\nwystarczająco wygodne.</language>
	</row>
	<row id="msg_0804_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydaje wysokoczęstotliwościowe\nkrzyki, których ludzie nie\nsłyszą. Gdy zaczyna, może krzyczeć strasznie długo.</language>
	</row>
	<row id="msg_0804_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cuchnący płyn z jego tylnej\nczęści jest tak obrzydliwy, że\nmoże wywołać mdłości nawet z odległości dwóch kilometrów.</language>
	</row>
	<row id="msg_0804_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atakuje, rozpylając\nobrzydliwy płyn z ogona, ale\nsmród słabnie po kilku pryskach.</language>
	</row>
	<row id="msg_0804_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starożytni ludzie wierzyli,\nże wzór na grzbiecie BRONZORA\nkrył tajemniczą moc.</language>
	</row>
	<row id="msg_0804_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starożytni ludzie wierzyli,\nże proszenie BRONZONGA o deszcz\njest sposobem na wzrost upraw.</language>
	</row>
	<row id="msg_0804_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By dostosować poziom płynów\nw swoim ciele, wydziela wodę z\noczu. Sprawia to, że wygląda, jakby płakał.</language>
	</row>
	<row id="msg_0804_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Próbując zmylić wroga,\nnaśladuje jego ruchy. Potem\nnie traci czasu i się ulatnia!</language>
	</row>
	<row id="msg_0804_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ostrożnie nosi okrągły,\nbiały kamień, który uważa za\njajko. Przeszkadza mu, jak kędzierzawe wyglądają jego włosy.</language>
	</row>
	<row id="msg_0804_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Naśladuje krzyki innych\nPokémonów, by oszukać je, że\njest jednym z nich. Dzięki temu go nie atakują.</language>
	</row>
	<row id="msg_0804_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powstał z połączenia 108\nduchów. Został przywiązany do\nDziwnego Kamienia Węgielnego, by nie robił psikusów.</language>
	</row>
	<row id="msg_0804_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gnieździ się w poziomych\nnorach ogrzewanych ciepłem\ngeotermalnym. Wrogowie, którzy podejdą zbyt blisko, mogą spodziewać się skoku i ukąszenia.</language>
	</row>
	<row id="msg_0804_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kopiąc, by rozszerzyć swoje\ngniazdo, zwyczajowo wykopuje\nklejnoty, które potem gromadzi w gnieździe.</language>
	</row>
	<row id="msg_0804_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało pokryte jest\ndrobnymi łuskami, które zmniejszają\nopór, umożliwiając mu latanie z dużą prędkością.</language>
	</row>
	<row id="msg_0804_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ukrywa jedzenie pod długim\nfutrem na ciele. Wozi ze sobą\nten zapas jedzenia i połyka go bez żucia.</language>
	</row>
	<row id="msg_0804_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Komunikują się ze sobą,\nużywając swoich aur. Potrafią\nbiegać przez całą noc.</language>
	</row>
	<row id="msg_0804_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że żaden wróg nie\nmoże pozostać niewidoczny dla\nLUCARIO, bo potrafi wykrywać aury. Nawet wrogów, których inaczej by nie zobaczył.</language>
	</row>
	<row id="msg_0804_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Otula się piaskiem, by\nchronić się przed zarazkami.\nSwobodnie przemierza pustynne piaski.</language>
	</row>
	<row id="msg_0804_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Otwiera szeroko pysk,\ndemonstrując przerażającą siłę.\nPodczas ataku wzbija ogromne ilości piasku.</language>
	</row>
	<row id="msg_0804_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zakopuje się w piasku, by\nczaić się na ofiarę. Pazury na\nogonie mogą wstrzyknąć ofierze zajadłą truciznę.</language>
	</row>
	<row id="msg_0804_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atakuje ludzi i Pokémony,\nktórzy przemierzają pustynię. To\ntylko pogłębiło jego złą reputację.</language>
	</row>
	<row id="msg_0804_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Płyn wyciśnięty z jego\npalca, choć trujący, jest ważnym\nskładnikiem lekarstw na ból dolnej części pleców.</language>
	</row>
	<row id="msg_0804_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kołysząc się i unikając\nataków wroga, wplata swoje\ngiętkie ciało blisko, po czym wypada, atakując trującymi pazurami.</language>
	</row>
	<row id="msg_0804_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chodzi na swoich mackach w\nposzukiwaniu gałęzi drzewa, na\nktórej może zwisać i zasadzić się na ofiarę.</language>
	</row>
	<row id="msg_0804_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pływając i trzepocząc swoimi\ndwiema ogonowymi płetwami,\nwygląda jak BEAUTIFLY. Nocą wzory na jego płetwach delikatnie świecą.</language>
	</row>
	<row id="msg_0804_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">LUMINEON pływające w\nciemności głębokiego morza\nwyglądają jak gwiazdy świecące na nocnym niebie.</language>
	</row>
	<row id="msg_0804_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy pływa blisko\npowierzchni oceanu, ludzie na\npokładach statków mogą obserwować wzór na jego grzbiecie.</language>
	</row>
	<row id="msg_0804_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W zimnych porach roku\nmigruje w niższe partie góry.\nNa wiosnę wraca na pokryty śniegiem szczyt.</language>
	</row>
	<row id="msg_0804_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje spokojnym życiem na\ngórach wiecznie pokrytych\nśniegiem. Ukrywa się, wzbijając zamiecie.</language>
	</row>
	<row id="msg_0804_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w śnieżnych regionach.\nWyrzeźbia wzory na drzewach\nswoimi pazurami jako sygnał dla innych.</language>
	</row>
	<row id="msg_0804_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ekspozycja na specjalne pole\nmagnetyczne zmieniła strukturę\nmolekularną MAGNETONA, przekształcając go w MAGNEZONE.</language>
	</row>
	<row id="msg_0804_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma miejsce w gardle, by\nprzechowywać ślinę. Może też\nzwinąć swój język i przechowywać go w tym samym miejscu.</language>
	</row>
	<row id="msg_0804_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z otworów w dłoniach\nwystrzeliwuje GEODUDE. Jego\npancerz może wytrzymać wybuchy wulkaniczne.</language>
	</row>
	<row id="msg_0804_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego pnącza rosną tak bujnie,\nże w ciepłej porze roku nie\nda się nawet dostrzec jego oczu.</language>
	</row>
	<row id="msg_0804_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy jego ładunek elektryczny\nnarasta, między jego rogami\nzaczynają trzaskać niebieskie iskry.</language>
	</row>
	<row id="msg_0804_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wystrzeliwuje kule ognia o\ntemperaturze ponad 1980 stopni\nCelsjusza ze swoich ramion. Jego oddech też pali i skwierczy.</language>
	</row>
	<row id="msg_0804_00468" index="468">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jak wszyscy wiedzą, odwiedza\nspokojne regiony, przynosząc im\ndary dobroci i słodkie błogosławieństwa.</language>
	</row>
	<row id="msg_0804_00469" index="469">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uderzenie jego skrzydeł jest\ntak potężne, że przypadkowo\nwyrywa dorosłe drzewa, gdy startuje w locie.</language>
	</row>
	<row id="msg_0804_00470" index="470">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy widzisz śpiącego LEAFEONA\nw plamie słońca, wiedz, że\nużywa fotosyntezy, by wytwarzać czyste powietrze.</language>
	</row>
	<row id="msg_0804_00471" index="471">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powoduje powstawanie\nmałych kryształków lodu,\nobniżając temperaturę otaczającej atmosfery.</language>
	</row>
	<row id="msg_0804_00472" index="472">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lata bezgłośnie. Używa\nswojego długiego ogona, by\nunosić ofiarę... Potem resztę robią jego wydłużone kły.</language>
	</row>
	<row id="msg_0804_00473" index="473">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kwitł na całym świecie w\nepoce lodowcowej, ale jego\npopulacja spadła, gdy masy lodu zaczęły topnieć.</language>
	</row>
	<row id="msg_0804_00474" index="474">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego oprogramowanie zostało\nzmodyfikowane, by mógł podróżować\nprzez obce wymiary. Wygląda na to, że mógł zajść jakiś błąd...</language>
	</row>
	<row id="msg_0804_00475" index="475">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ potrafi wyczuć, o\nczym myśli jego wróg, jego ataki\nwybuchają jako pierwsze, szybko i zajadle.</language>
	</row>
	<row id="msg_0804_00476" index="476">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kontroluje trzy jednostki\nzwane Mini-Nosami za pomocą\nsiły magnetycznej. Dzięki nim może atakować wroga z trzech kierunków.</language>
	</row>
	<row id="msg_0804_00477" index="477">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten budzący\nlęk Pokémon podróżuje do\nnieznanych światów. Niektórzy wierzą nawet, że zabiera ze sobą zagubione dusze.</language>
	</row>
	<row id="msg_0804_00478" index="478">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Legendy w śnieżnych\nregionach głoszą, że kobieta,\nktóra zaginęła na lodowej górze, odrodziła się jako FROSLASS.</language>
	</row>
	<row id="msg_0804_00479" index="479">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Badania nad tym Pokémonem\ntrwają, bo może on być źródłem\nmocy unikalnego silnika.</language>
	</row>
	<row id="msg_0804_00480" index="480">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Według niektórych źródeł ten\nPokémon obdarzył ludzi\ninteligencją potrzebną do rozwiązywania różnych problemów.</language>
	</row>
	<row id="msg_0804_00481" index="481">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten Pokémon\nobdarzył ludzkie serce emocjami,\ntakimi jak smutek i radość.</language>
	</row>
	<row id="msg_0804_00482" index="482">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten Pokémon\nobdarzył ludzi determinacją\npotrzebną do stawiania czoła wszelkim trudnościom życia.</language>
	</row>
	<row id="msg_0804_00483" index="483">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten Pokémon całkowicie\nkontroluje bieg czasu. Używa swojej\nmocy, by dowolnie podróżować przez przeszłość i przyszłość.</language>
	</row>
	<row id="msg_0804_00484" index="484">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego całkowita kontrola nad\ngranicami przestrzeni pozwala\nmu przenosić się do odległych miejsc, a nawet innych wymiarów.</language>
	</row>
	<row id="msg_0804_00485" index="485">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wrząca krew, jak magma,\nkrąży w jego ciele. Zamieszkuje\nwulkaniczne jaskinie.</language>
	</row>
	<row id="msg_0804_00486" index="486">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzy się, że ukształtował\nREGIROCKA, REGICE i REGISTEELA\nz gliny, lodu i magmy.</language>
	</row>
	<row id="msg_0804_00487" index="487">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ten Pokémon\nżyje w świecie po odwrotnej\nstronie naszego, gdzie powszechna wiedza jest wypaczona i dziwna.</language>
	</row>
	<row id="msg_0804_00488" index="488">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ci, którzy śpią, trzymając\npióro CRESSELII, mają zapewnione\nradosne sny. Mówi się, że reprezentuje ona sierp księżyca.</language>
	</row>
	<row id="msg_0804_00489" index="489">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy woda się ogrzewa,\nnadymają pęcherz pływny na\ngłowach i leniwie dryfują po morzu w stadach.</language>
	</row>
	<row id="msg_0804_00490" index="490">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zaczyna życie z cudowną\nmocą, która pozwala mu\nzwiązać się z dowolnym rodzajem Pokémona.</language>
	</row>
	<row id="msg_0804_00491" index="491">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przegania ludzi i Pokémony\nze swojego terytorium, sprawiając,\nże doświadczają głębokich, koszmarnych snów.</language>
	</row>
	<row id="msg_0804_00492" index="492">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zakwitanie kwiatów Gracidea\nobdarza go mocą lotu. Wdzięczność\nto przesłanie, które przekazuje.</language>
	</row>
	<row id="msg_0804_00493" index="493">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Według legend Sinnoh ten\nPokémon wykluł się z jaja i\nukształtował wszystko, co istnieje w tym świecie.</language>
	</row>
</body>
