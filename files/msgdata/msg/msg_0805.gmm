<?xml version="1.0"?>
<body language="English">
	<row id="msg_0805_00000" index="0">
		<attribute name="window_context_name">garbage</attribute>
		<language name="English"></language>
		<language name="日本語"></language>
	</row>
	<row id="msg_0805_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przez pewien czas po narodzinach\nrośnie, czerpiąc substancje\nodżywcze z nasienia na grzbiecie.</language>
	</row>
	<row id="msg_0805_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy pąk na jego grzbiecie\nzaczyna puchnąć, unosi się słodki\naromat, zwiastujący nadchodzący rozkwit kwiatu.</language>
	</row>
	<row id="msg_0805_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po deszczowym dniu kwiat na\njego grzbiecie pachnie silniej.\nZapach przyciąga inne Pokémony.</language>
	</row>
	<row id="msg_0805_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ogień na czubku jego ogona to\nmiara jego życia. Jeśli jest\nzdrowy, jego ogon płonie intensywnie.</language>
	</row>
	<row id="msg_0805_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W skalistych górach, gdzie\nżyją CHARMELEONY, ich ogniste\nogony świecą nocą jak gwiazdy.</language>
	</row>
	<row id="msg_0805_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ogień CHARIZARDA\npali się mocniej, jeśli przeszedł\nprzez ciężkie walki.</language>
	</row>
	<row id="msg_0805_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chroni się w swojej skorupie,\na potem kontruje strumieniami\nwody przy każdej okazji.</language>
	</row>
	<row id="msg_0805_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że żyje 10 000 lat.\nJego futrzasty ogon jest\npopularnym symbolem długowieczności.</language>
	</row>
	<row id="msg_0805_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strumienie wody, które\nwystrzeliwuje z rakietowych dział\nna skorupie, mogą przebić grubą stal.</language>
	</row>
	<row id="msg_0805_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydziela odór z czerwonego\nczułka, by odpędzić wrogów.\nRośnie, wielokrotnie się przepoczwarzając.</language>
	</row>
	<row id="msg_0805_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Twarda jak stal skorupa chroni\njego delikatne ciało. Cierpliwie\nznosi trudy, czekając na ewolucję.</language>
	</row>
	<row id="msg_0805_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha miód kwiatów i potrafi\nznaleźć skupiska kwiatów\nz nawet najmniejszymi ilościami pyłku.</language>
	</row>
	<row id="msg_0805_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zjada dziennie tyle liści, ile\nsam waży. Odpiera napastników\nkolcem na głowie.</language>
	</row>
	<row id="msg_0805_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czekając na ewolucję, chowa\nsię przed drapieżnikami pod\nliśćmi i w zakamarkach gałęzi.</language>
	</row>
	<row id="msg_0805_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego najlepszy atak to latanie\nwokół z dużą prędkością, atak\ntrującymi kolcami, a potem odlot.</language>
	</row>
	<row id="msg_0805_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest łagodny i preferuje\nunikanie konfliktów. Jeśli\nzostanie zakłócony, może jednak dziko kontratakować.</language>
	</row>
	<row id="msg_0805_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lata po swoim rozległym\nterytorium w poszukiwaniu ofiary,\npowalając ją wysoko rozwiniętymi pazurami.</language>
	</row>
	<row id="msg_0805_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepocząc skrzydłami z całej\nsiły, PIDGEOT może wywołać\npodmuch wiatru zdolny wygięć wysokie drzewa.</language>
	</row>
	<row id="msg_0805_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niezwykle ostrożny, jego\nwytrzymała witalność pozwala mu\nżyć w każdym rodzaju środowiska.</language>
	</row>
	<row id="msg_0805_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ścina swoje nieustannie rosnące\nkły, gryząc twarde rzeczy. Może\nprzegryźć murki z żużlobetonu.</language>
	</row>
	<row id="msg_0805_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepocze zawzięcie małymi\nskrzydłami, by latać. Używając\ndzioba, szuka ofiary w trawie.</language>
	</row>
	<row id="msg_0805_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma wytrzymałość, by latać\ncały dzień na swoich szerokich\nskrzydłach. Walczy, używając ostrego dzioba.</language>
	</row>
	<row id="msg_0805_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wślizguje się przez trawę bez\nwydawania dźwięku i atakuje\nniczego niespodziewającą się ofiarę od tyłu.</language>
	</row>
	<row id="msg_0805_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wzór na jego brzuchu służy do\nzastraszania. Wiąże wrogów,\ngdy są sparaliżowani strachem.</language>
	</row>
	<row id="msg_0805_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w lasach z innymi.\nMagazynuje elektryczność w\nworeczkach na policzkach.</language>
	</row>
	<row id="msg_0805_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Staje się agresywny, jeśli ma\nw ciele zbyt dużo elektryczności.\nWyładowuje moc przez ogon.</language>
	</row>
	<row id="msg_0805_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By się chronić przed\nnapastnikami, zwija się w kulę.\nŻyje w suchych regionach z minimalnymi opadami.</language>
	</row>
	<row id="msg_0805_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwija się, a potem toczy się\nw wrogów swoim grzbietem. Jego\nostre kolce zadają poważne obrażenia.</language>
	</row>
	<row id="msg_0805_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć nie preferuje walki,\nnawet jedna kropla trucizny, którą\nwydziela z kolców, może być śmiertelna.</language>
	</row>
	<row id="msg_0805_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy wyczuje niebezpieczeństwo,\npodnosi wszystkie kolce na\nciele. Te kolce rosną wolniej niż u NIDORINO.</language>
	</row>
	<row id="msg_0805_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Całe jego ciało jest zbrojone\ntwardymi łuskami. Będzie chronić\nmłode w swojej norze za cenę życia.</language>
	</row>
	<row id="msg_0805_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Skanuje otoczenie, podnosząc\nuszy z trawy. Jego toksyczny\nróg służy do ochrony.</language>
	</row>
	<row id="msg_0805_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma gwałtowne usposobienie i\ndźga wrogów rogiem, który\nwydziela truciznę przy uderzeniu.</language>
	</row>
	<row id="msg_0805_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jedno machnięcie jego potężnym\nogonem może złamać słup\ntelefoniczny jak zapałkę.</language>
	</row>
	<row id="msg_0805_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważa się, że żyje z innymi\nna spokojnych górach, jest\npopularny ze względu na swoją uroczą naturę.</language>
	</row>
	<row id="msg_0805_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rzadko widziany przez ludzi,\nmówi się, że przyciąga go pełnia\nksiężyca, by bawić się przy opuszczonych jeziorach.</language>
	</row>
	<row id="msg_0805_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kontroluje kule ognia. W\nmiarę jak rośnie, jego sześć\nogonów rozszczepia się na końcach, tworząc więcej ogonów.</language>
	</row>
	<row id="msg_0805_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego dziewięć ogonów podobno\nprzesycone są mistyczną mocą.\nMoże żyć tysiąc lat.</language>
	</row>
	<row id="msg_0805_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy porusza swoimi dużymi,\nokrągłymi oczami, zaczyna\nśpiewać kołysankę, która sprawia, że wszyscy stają się senni.</language>
	</row>
	<row id="msg_0805_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego delikatne futro jest\nwspaniałe w dotyku. Może\npowiększyć swoje ciało, wdychając powietrze.</language>
	</row>
	<row id="msg_0805_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć nie ma oczu, potrafi\nwykryć przeszkody za pomocą\nultradźwięków, które wydaje z ust.</language>
	</row>
	<row id="msg_0805_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha krew ludzi i Pokémonów.\nLata w nocy w poszukiwaniu\nżył na szyi.</language>
	</row>
	<row id="msg_0805_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Często zapuszcza swoje\nkorzeniowe stopy w ziemię w\ndzień i sieje nasiona, chodząc wokół nocą.</language>
	</row>
	<row id="msg_0805_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Miód, który wydziela z ust,\npachnie tak odpychająco, że\nmoże podrażnić nos z odległości ponad kilometra.</language>
	</row>
	<row id="msg_0805_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego płatki są największe na\nświecie. Idąc, rozsypuje\nwyjątkowo alergizujący pyłek.</language>
	</row>
	<row id="msg_0805_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grzyby zwane tochukaso rosną\nna jego grzbiecie. Rosną wraz\nz gospodarzem PARAS.</language>
	</row>
	<row id="msg_0805_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Grzyb, który urósł większy niż\nciało gospodarza, kontroluje\nPARASECTA. Rozsypuje trujące zarodniki.</language>
	</row>
	<row id="msg_0805_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego duże oczy to w\nrzeczywistości skupiska małych\noczu. Nocą jego gatunek przyciąga światło.</language>
	</row>
	<row id="msg_0805_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepocze skrzydłami, by\nrozsypać pyłopodobne łuski. Łuski\nwyciekają toksyny, jeśli zetkną się ze skórą.</language>
	</row>
	<row id="msg_0805_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który żyje pod\nziemią. Z powodu swojego\nciemnego siedliska, odpycha go jasne światło słoneczne.</language>
	</row>
	<row id="msg_0805_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego trzy głowy poruszają się\nna zmianę, przebijając go przez\ntwardą glebę na głębokość ponad 95 kilometrów.</language>
	</row>
	<row id="msg_0805_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest nocny z natury. Jeśli\nzauważy coś błyszczącego, jego\noczy jasno błyskają.</language>
	</row>
	<row id="msg_0805_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bardzo wyniosły Pokémon.\nWśród fanów rozmiar klejnotu na\njego czole jest tematem wielu rozmów.</language>
	</row>
	<row id="msg_0805_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jego zwykły ból głowy\nsię pogłębi, zaczyna przejawiać\ndziwne moce. Nie może jednak tego pamiętać.</language>
	</row>
	<row id="msg_0805_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który żyje w\njeziorach. Pływa szybciej niż\njakikolwiek ludzki czempion pływania.</language>
	</row>
	<row id="msg_0805_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w koloniach na\nwierzchołkach drzew. Jeśli jeden\nwpada w gniew, cała kolonia szaleje bez powodu.</language>
	</row>
	<row id="msg_0805_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wpada w gniew, jeśli\nzobaczysz jego oczy, i jeszcze\nbardziej, jeśli uciekniesz. Jeśli go pokonasz, wścieka się jeszcze bardziej.</language>
	</row>
	<row id="msg_0805_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon o lojalnej naturze.\nPozostanie nieruchomy, dopóki\nnie otrzyma rozkazu od trenera.</language>
	</row>
	<row id="msg_0805_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego dumny i majestatyczny\nwygląd zniewala ludzkie serca\nod bardzo dawna.</language>
	</row>
	<row id="msg_0805_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego skóra jest tak cienka, że\nwidać jego wewnętrzne organy.\nMa trudności z chodzeniem na nowo wyrosłych stopach.</language>
	</row>
	<row id="msg_0805_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wzór spirali na jego brzuchu\nsubtelnie faluje. Wpatrywanie\nsię w niego stopniowo wywołuje senność.</language>
	</row>
	<row id="msg_0805_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dzięki niezwykle silnym\nmięśniom może pływać po Oceanie\nSpokojnym bez odpoczynku.</language>
	</row>
	<row id="msg_0805_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śpi 18 godzin dziennie.\nNawet gdy jest obudzony,\nteleportuje się, pozostając w pozycji siedzącej.</language>
	</row>
	<row id="msg_0805_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jest w pobliżu, na\nekranach telewizorów pojawia się\nniesamowity cień. Mówi się, że widok tego cienia przynosi zły los.</language>
	</row>
	<row id="msg_0805_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wspaniała pamięć pozwala\nmu pamiętać wszystko, co\ndoświadczył od narodzin. Jego IQ przekracza 5000.</language>
	</row>
	<row id="msg_0805_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wielokrotnie podnosi GRAVELERA,\nby wzmocnić całe ciało.\nUżywa każdego rodzaju sztuk walki.</language>
	</row>
	<row id="msg_0805_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bezgraniczna moc MACHOKE jest\nbardzo niebezpieczna, więc nosi\npas, który tłumi jego energię.</language>
	</row>
	<row id="msg_0805_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uderza swoimi czterema\nramionami z oślepiającą\nprędkością. Może wyrzucić 1000 uderzeń w dwie sekundy.</language>
	</row>
	<row id="msg_0805_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Preferuje gorące i wilgotne\nśrodowiska. Jest szybki w\nchwytaniu ofiary swoimi pnączami.</language>
	</row>
	<row id="msg_0805_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który wygląda jak\nroślina. Łapie niczego\nniespodziewającą się ofiarę, oblewając ją trującym pyłkiem.</language>
	</row>
	<row id="msg_0805_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gromadzi w pysku płyn o\nmiodowym zapachu, który w\nrzeczywistości jest kwasem rozpuszczającym wszystko.</language>
	</row>
	<row id="msg_0805_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało w zasadzie zbudowane\njest z wody. Wystrzeliwuje\ndziwne wiązki ze swoich kryształowych oczu.</language>
	</row>
	<row id="msg_0805_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z 80 mackami do usidlania\nofiar, zapobiega ucieczce, aż\nofiara zostanie osłabiona trucizną.</language>
	</row>
	<row id="msg_0805_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiele żyje na górskich\nszlakach i pozostaje częściowo\nzagrzebanych, obserwując wspinaczy.</language>
	</row>
	<row id="msg_0805_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GRAVELERY budują swoje domy\nna stromych klifach, wykopując\nliczne poziome dziury.</language>
	</row>
	<row id="msg_0805_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrzuca skórę raz w roku.\nJego ciało podobne do głazu\njest tak twarde, że nawet dynamit nie może go uszkodzić.</language>
	</row>
	<row id="msg_0805_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Około godzinę po narodzinach\nwyrastają mu ognista grzywa i\nogon, dając mu imponujący wygląd.</language>
	</row>
	<row id="msg_0805_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Galopuje z prędkością blisko\n240 km/h. Z grzywą płonącą\nzajadle, pędzi jak strzała.</language>
	</row>
	<row id="msg_0805_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć jest powolny, jest\nwprawny w łowieniu ryb swoim\nogonem. Nie czuje bólu, gdy jego ogon zostaje ugryziony.</language>
	</row>
	<row id="msg_0805_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć zwykle tępy, wydaje się\nstawać się inspirowany, gdy\nSHELLDER na jego ogonie zacina zęby.</language>
	</row>
	<row id="msg_0805_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jednostki po jego bokach\nwytwarzają fale elektromagnetyczne,\nktóre utrzymują go w powietrzu. Żywi się elektrycznością.</language>
	</row>
	<row id="msg_0805_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">To w rzeczywistości trzy\nMAGNEMITE połączone magnetyzmem.\nGrupa może wywołać burzę magnetyczną.</language>
	</row>
	<row id="msg_0805_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie może żyć bez łodygi,\nktórą trzyma. Dlatego broni jej\nprzed napastnikami za cenę życia.</language>
	</row>
	<row id="msg_0805_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mózgi w jego dwóch głowach\nwydają się przekazywać sobie\nemocje za pomocą mocy telepatycznej.</language>
	</row>
	<row id="msg_0805_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy DODUO ewoluuje w tę\ndziwną odmianę, jedna z jego głów\nrozdziela się na dwie. Biega z prędkością blisko 65 km/h.</language>
	</row>
	<row id="msg_0805_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który żyje na\ngórach lodowych. Pływa w morzu,\nużywając szpica na głowie, by łamać lód.</language>
	</row>
	<row id="msg_0805_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na śniegu, czysto biały płaszcz\npokrywający jego ciało,\nukrywa go przed drapieżnikami.</language>
	</row>
	<row id="msg_0805_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Narodził się, gdy szlam w\nbrudnym strumieniu został\nwystawiony na promienie rentgenowskie księżyca. Pojawia się wśród brudu.</language>
	</row>
	<row id="msg_0805_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toksyczny płyn wycieka z\njego ciała. Płyn natychmiast\nzabija rośliny i drzewa po kontakcie.</language>
	</row>
	<row id="msg_0805_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pływa tyłem, otwierając i\nzamykając swoje dwie skorupy.\nJego duży język zawsze zwisa.</language>
	</row>
	<row id="msg_0805_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczy, trzymając skorupę\nciasno zamkniętą dla ochrony i\nwystrzeliwując kolce, by odpędzić wrogów.</language>
	</row>
	<row id="msg_0805_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ciało tego Pokémona w 95%\nzbudowane jest z gazów,\nktóre zostają zdmuchnięte silnymi podmuchami wiatru.</language>
	</row>
	<row id="msg_0805_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrafi wślizgnąć się przez\ndowolną przeszkodę. Czai się\nwewnątrz ścian, by obserwować wrogów.</language>
	</row>
	<row id="msg_0805_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chowa się w cieniach. Mówi\nsię, że jeśli GENGAR się\nukrywa, schładza okolicę o blisko 5 stopni Celsjusza.</language>
	</row>
	<row id="msg_0805_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy porusza się pod ziemią,\npowoduje dudnienie i wstrząsy.\nMoże przemieszczać się z prędkością 80 km/h.</language>
	</row>
	<row id="msg_0805_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrafi stwierdzić, co ludzie\nśnią, wąchając swoim dużym\nnosem. Kocha zabawne sny.</language>
	</row>
	<row id="msg_0805_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Widok jego kołyszącego się\nwahadła może wywołać sen w trzy\nsekundy, nawet u kogoś, kto właśnie się obudził.</language>
	</row>
	<row id="msg_0805_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w norach wykopanych na\npiaszczystych plażach. Jego\nszczypce całkowicie odrastają, jeśli złamią się w walce.</language>
	</row>
	<row id="msg_0805_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Większe szczypce mają siłę\n10 000 koni mechanicznych.\nJednak są tak ciężkie, że trudno nimi celować.</language>
	</row>
	<row id="msg_0805_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda zupełnie jak Poké Ball.\nJest niebezpieczny, bo może\nporazić lub wybuchnąć po dotknięciu.</language>
	</row>
	<row id="msg_0805_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiadomo, że dryfuje na wiatrach,\njeśli jest nadmuchany do\npęknięcia zmagazynowaną elektrycznością.</language>
	</row>
	<row id="msg_0805_00102" index="102">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego sześć jajek rozmawia\nza pomocą telepatii. Mogą\nszybko się zebrać, jeśli się rozdzielą.</language>
	</row>
	<row id="msg_0805_00103" index="103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nazywa się „Chodzącą Dżunglą”.\nJeśli głowa urośnie zbyt duża,\nodpada i staje się EXEGGCUTE.</language>
	</row>
	<row id="msg_0805_00104" index="104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy myśli o swojej zmarłej\nmatce, płacze. Jego płacz\nsprawia, że czaszka, którą nosi, głucho grzechocze.</language>
	</row>
	<row id="msg_0805_00105" index="105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Od narodzin ten dziki Pokémon\nnieustannie trzyma kości. Jest\nwprawny w używaniu ich jako broni.</language>
	</row>
	<row id="msg_0805_00106" index="106">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego nogi mogą się\npodwójnie wydłużyć. Wrogowie\nspotykający go po raz pierwszy są zaskoczeni jego zasięgiem.</language>
	</row>
	<row id="msg_0805_00107" index="107">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ciosy skręcające ramię, które\nzadaje, miażdżą nawet beton.\nOdpoczywa po trzech minutach walki.</language>
	</row>
	<row id="msg_0805_00108" index="108">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zamiast rąk używa języka,\nktóry jest dwa razy dłuższy\nod jego wzrostu. Jego lepka ślina chwyta wszystko.</language>
	</row>
	<row id="msg_0805_00109" index="109">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gazy lżejsze od powietrza w\njego ciele utrzymują go w górze.\nGazy nie tylko śmierdzą, są też wybuchowe.</language>
	</row>
	<row id="msg_0805_00110" index="110">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rośnie, żywiąc się gazami\nwydzielanymi przez śmieci.\nChoć bardzo rzadkie, znaleziono trojaczki.</language>
	</row>
	<row id="msg_0805_00111" index="111">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało okryte jest grubą\nskórą, a jego szarże obalają\nbudynki. Niestety nie jest zbyt mądry.</language>
	</row>
	<row id="msg_0805_00112" index="112">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego mózg rozwinął się,\nodkąd wyprostował się na\ntylnych nogach. Jego róg-wiertło przewierca tunele w litej skale.</language>
	</row>
	<row id="msg_0805_00113" index="113">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że przynosi\nszczęście. Będąc współczujący,\ndzieli się jajkami z ludźmi, którzy są ranni.</language>
	</row>
	<row id="msg_0805_00114" index="114">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest okryty niebieskimi\npnączami. Nikt nie widział\ntwarzy skrytej pod tym narostem pnączy.</language>
	</row>
	<row id="msg_0805_00115" index="115">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wychowuje swoje potomstwo w\nbrzusznej torbie. Pozwala\nmłodym wyjść, by się bawić, tylko gdy czuje się bezpiecznie.</language>
	</row>
	<row id="msg_0805_00116" index="116">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buduje gniazdo w cieniu\nkoralowców. Jeśli wyczuje\nniebezpieczeństwo, wypluwa mętny atrament i ucieka.</language>
	</row>
	<row id="msg_0805_00117" index="117">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego kolce zapewniają ochronę.\nJego płetwy i kości są\ncenione jako składniki medycyny tradycyjnej.</language>
	</row>
	<row id="msg_0805_00118" index="118">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pływa elegancko, trzepocząc\npłetwą ogonową, jakby to była\nsukienka. Ma wygląd królowej.</language>
	</row>
	<row id="msg_0805_00119" index="119">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buduje gniazdo, wydrążając\ngłazy w potokach swoim rogiem.\nBroni swoich jaj za cenę życia.</language>
	</row>
	<row id="msg_0805_00120" index="120">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jego ciało zostanie\nrozerwane, może odrosnąć,\njeśli czerwony rdzeń pozostanie. Rdzeń błyska o północy.</language>
	</row>
	<row id="msg_0805_00121" index="121">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W centrum jego ciała znajduje\nsię czerwony rdzeń, który\nwysyła tajemnicze sygnały radiowe w nocne niebo.</language>
	</row>
	<row id="msg_0805_00122" index="122">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest ekspertem pantomimy,\nktóry potrafi stworzyć\nniewidzialne, ale solidne ściany za pomocą mimicznych gestów.</language>
	</row>
	<row id="msg_0805_00123" index="123">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Prawie niemożliwe jest\nsparowanie jego atakujących kos.\nJego ruchy są jak ruchy ninja.</language>
	</row>
	<row id="msg_0805_00124" index="124">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego krzyki brzmią jak ludzka\nmowa. Jednak nie da się\nstwierdzić, co próbuje powiedzieć.</language>
	</row>
	<row id="msg_0805_00125" index="125">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Połowa przerw w zasilaniu\nzdarza się, gdy ten Pokémon\npojawia się w elektrowniach i zjada elektryczność.</language>
	</row>
	<row id="msg_0805_00126" index="126">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urodzony w kraterze wulkanu,\njego ciało pokryte jest płomieniami,\nktóre migoczą jak słońce.</language>
	</row>
	<row id="msg_0805_00127" index="127">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chwyta ofiarę szczypcami, aż\nzostanie rozdarta na pół.\nCo nie może rozdzielić, odrzuca daleko.</language>
	</row>
	<row id="msg_0805_00128" index="128">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy raz wyceluje w wroga,\nszarżuje na oślep. Jest znany\nze swojej gwałtownej natury.</language>
	</row>
	<row id="msg_0805_00129" index="129">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jest najsłabszym\nPokémonem na świecie. Nikt\nnie wie, jak zdołał przetrwać.</language>
	</row>
	<row id="msg_0805_00130" index="130">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy się pojawia, jego gniew\nnigdy nie ustaje, aż zniszczy\npola i góry wokół.</language>
	</row>
	<row id="msg_0805_00131" index="131">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha przepływać przez morze\nz ludźmi i Pokémonami na\ngrzbiecie. Rozumie ludzką mowę.</language>
	</row>
	<row id="msg_0805_00132" index="132">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma zdolność całkowitej\nrekonstrukcji swojej struktury\nkomórkowej, by przekształcić się w to, co widzi.</language>
	</row>
	<row id="msg_0805_00133" index="133">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rzadki Pokémon, który\nprzystosowuje się do trudnych\nśrodowisk, przyjmując różne formy ewolucyjne.</language>
	</row>
	<row id="msg_0805_00134" index="134">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ewoluował, by być\nprzystosowany do życia wodnego.\nMoże niewidocznie rozpłynąć się w wodzie.</language>
	</row>
	<row id="msg_0805_00135" index="135">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kontroluje moc 10 000\nwoltów i może postawić całe\nfutro na ciele jak ostre igły.</language>
	</row>
	<row id="msg_0805_00136" index="136">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma worek z ogniem w ciele.\nTemperatura jego ciała przekracza\n900 stopni Celsjusza przed walką.</language>
	</row>
	<row id="msg_0805_00137" index="137">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pierwszy na świecie sztucznie\nstworzony Pokémon. Potrafi\npodróżować przez przestrzeń elektroniczną.</language>
	</row>
	<row id="msg_0805_00138" index="138">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który został\nwskrzeszony ze skamieliny przy\nużyciu współczesnej nauki. Pływał w starożytnych morzach.</language>
	</row>
	<row id="msg_0805_00139" index="139">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważa się, że ten Pokémon\nwyginął, bo jego spiralna\nskorupa urosła zbyt wielka.</language>
	</row>
	<row id="msg_0805_00140" index="140">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważa się, że zamieszkiwał\nplaże 300 milionów lat temu.\nChroniony jest sztywną skorupą.</language>
	</row>
	<row id="msg_0805_00141" index="141">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uważa się, że ten Pokémon\nwyszedł na ląd, bo jego ofiara\nprzystosowała się do życia na lądzie.</language>
	</row>
	<row id="msg_0805_00142" index="142">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który wędrował po\nniebie w epoce dinozaurów.\nJego zęby są jak ostrza piły.</language>
	</row>
	<row id="msg_0805_00143" index="143">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego żołądek może strawić\ndowolny rodzaj jedzenia, nawet\njeśli jest spleśniałe lub zgniłe.</language>
	</row>
	<row id="msg_0805_00144" index="144">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Legendarny ptasi Pokémon.\nMoże tworzyć zamiecie, zamrażając\nwilgoć w powietrzu.</language>
	</row>
	<row id="msg_0805_00145" index="145">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Legendarny Pokémon, o którym\nmówi się, że żyje w chmurach\nburzowych. Swobodnie kontroluje pioruny.</language>
	</row>
	<row id="msg_0805_00146" index="146">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden z legendarnych ptasich\nPokémonów. Mówi się, że jego\npojawienie się zwiastuje nadejście wiosny.</language>
	</row>
	<row id="msg_0805_00147" index="147">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nazywa się „Pokémonem Miraż”,\nbo tak mało osób go widziało.\nZnaleziono jego zrzuconą skórę.</language>
	</row>
	<row id="msg_0805_00148" index="148">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jego ciało przyoblecze\nsię aurą, pogoda zmienia się\nnatychmiast. Mówi się, że żyje w morzach i jeziorach.</language>
	</row>
	<row id="msg_0805_00149" index="149">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ma dom gdzieś\nw morzu. Prowadzi załogi\nrozbitych statków do brzegu.</language>
	</row>
	<row id="msg_0805_00150" index="150">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon stworzony przez\nrekombinację genów MEW. Mówi\nsię, że ma najbardziej dzikie serce ze wszystkich Pokémonów.</language>
	</row>
	<row id="msg_0805_00151" index="151">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ potrafi używać\nwszelkich rodzajów ruchów, wielu\nnaukowców wierzy, że MEW jest przodkiem Pokémonów.</language>
	</row>
	<row id="msg_0805_00152" index="152">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa liścia na głowie, by\nokreślić temperaturę i\nwilgotność. Kocha wygrzewać się na słońcu.</language>
	</row>
	<row id="msg_0805_00153" index="153">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pąki wokół jego szyi wydzielają\nostry aromat, który\nrozbudza ludzi.</language>
	</row>
	<row id="msg_0805_00154" index="154">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego oddech ma fantastyczną\nzdolność przywracania do życia\nmartwych roślin i kwiatów.</language>
	</row>
	<row id="msg_0805_00155" index="155">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma nieśmiałą naturę. Jeśli\nzostanie przestraszony, płomienie\nna jego grzbiecie palą się żywiej.</language>
	</row>
	<row id="msg_0805_00156" index="156">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zastrasza wrogów żarem swoich\npłomieni. Ogień pali się\nsilniej, gdy przygotowuje się do walki.</language>
	</row>
	<row id="msg_0805_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atakuje za pomocą wybuchów\nognia. Tworzy drgania upału\nintensywnym ogniem, by się skryć.</language>
	</row>
	<row id="msg_0805_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma zwyczaj gryzienia\nwszystkiego swoimi rozwiniętymi\nszczękami. Nawet jego trener musi być ostrożny.</language>
	</row>
	<row id="msg_0805_00159" index="159">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy raz zagryzie, nie puści,\naż straci kły. Nowe kły\nszybko odrastają na ich miejsce.</language>
	</row>
	<row id="msg_0805_00160" index="160">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle poruszają się powoli,\nale atakując i gryząc ofiarę,\nporusza się z oślepiającą prędkością.</language>
	</row>
	<row id="msg_0805_00161" index="161">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma bardzo nerwową naturę.\nStoi wysoko na ogonie, by\nmógł skanować rozległe obszary.</language>
	</row>
	<row id="msg_0805_00162" index="162">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Matka usypia swoje potomstwo,\nzwijając się wokół nich.\nOsacza wrogów szybkością.</language>
	</row>
	<row id="msg_0805_00163" index="163">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawsze stoi na jednej nodze.\nNawet gdy jest atakowany, nie\nopiera się obiema nogami.</language>
	</row>
	<row id="msg_0805_00164" index="164">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego oczy są wyjątkowe. Mogą\nwychwycić przedmioty, nawet\njeśli jest tylko najmniejsza odrobina światła.</language>
	</row>
	<row id="msg_0805_00165" index="165">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest tak nieśmiały, że nie\nmoże się ruszyć, jeśli nie jest\nz rojem innych. Przekazuje swoje odczucia zapachem.</language>
	</row>
	<row id="msg_0805_00166" index="166">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa światła gwiazd jako\nenergii. Gdy pojawia się więcej\ngwiazd nocą, wzory na jego grzbiecie rosną.</language>
	</row>
	<row id="msg_0805_00167" index="167">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zastawia pułapkę, tworząc\nsieć z cienkiej, ale wytrzymałej\nnici. Czeka nieruchomo, aż ofiara nadejdzie.</language>
	</row>
	<row id="msg_0805_00168" index="168">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyczepia nić do ofiary i\npuszcza ją wolno. Potem śledzi\nnić do ofiary i jej przyjaciół.</language>
	</row>
	<row id="msg_0805_00169" index="169">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cztery skrzydła pozwalają mu\nlatać szybciej i ciszej. Staje\nsię aktywny, gdy nadchodzi noc.</language>
	</row>
	<row id="msg_0805_00170" index="170">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyładowuje dodatnią i ujemną\nelektryczność z czułków, by\nporazić wrogów.</language>
	</row>
	<row id="msg_0805_00171" index="171">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Światło LANTURNA może świecić\nz dużych głębokości. Nazywany\njest „Gwiazdą Głębokiego Morza”.</language>
	</row>
	<row id="msg_0805_00172" index="172">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Elektryczne worki na jego\npoliczkach są wciąż małe. Nie\nmogą jeszcze zmagazynować wiele elektryczności.</language>
	</row>
	<row id="msg_0805_00173" index="173">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego sylwetka jest jak\ngwiazda. Wierzy się, że przybywa,\njadąc na spadających gwiazdach.</language>
	</row>
	<row id="msg_0805_00174" index="174">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma miękkie i sprężyste\nciało. Gdy raz zacznie się\nodbijać, staje się niemożliwe do zatrzymania.</language>
	</row>
	<row id="msg_0805_00175" index="175">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że jego skorupa\njest pełna szczęścia, którym\ndzieli się z dobrymi ludźmi.</language>
	</row>
	<row id="msg_0805_00176" index="176">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że pojawia się przed\ndobrymi ludźmi, by rozsypać\nświecący puch zwany „pyłem radości”.</language>
	</row>
	<row id="msg_0805_00177" index="177">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbiera jedzenie z kaktusów,\nsprawnie unikając pąków i\nkolców. Wydaje się podskakiwać, by się poruszać.</language>
	</row>
	<row id="msg_0805_00178" index="178">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten dziwny Pokémon widzi\ni przeszłość, i przyszłość.\nObserwuje ruch słońca cały dzień.</language>
	</row>
	<row id="msg_0805_00179" index="179">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego puszysty płaszcz\npodwaja objętość, gdy\nnarasta elektryczność statyczna. Dotknięcie go może porażać.</language>
	</row>
	<row id="msg_0805_00180" index="180">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli jego płaszcz zostanie\nw pełni naładowany elektrycznością,\njego ogon zapala się. Wystrzeliwuje włos, który poraża przy uderzeniu.</language>
	</row>
	<row id="msg_0805_00181" index="181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czubek jego ogona świeci\njasno. W dawnych czasach ludzie\nwysyłali sygnały, używając światła ogona.</language>
	</row>
	<row id="msg_0805_00182" index="182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy kończy się sezon\nulewnych deszczy, wyciąga go\nciepłe słońce, by zatańczyć na otwartej przestrzeni.</language>
	</row>
	<row id="msg_0805_00183" index="183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używając ogona jako\npływaka, nurkuje pod wodę.\nLubi jeść rośliny rosnące na dnie rzek.</language>
	</row>
	<row id="msg_0805_00184" index="184">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w rzekach i jeziorach.\nW wodzie jego ubarwienie i\nwzory oszukują wzrok wrogów.</language>
	</row>
	<row id="msg_0805_00185" index="185">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć wygląda jak drzewo,\njego ciało jest bliższe skałom\ni kamieniom. Jest bardzo słaby na wodę.</language>
	</row>
	<row id="msg_0805_00186" index="186">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbiera grupy innych jako ich\nlider. Jego krzyki sprawiają,\nże POLIWAG go słucha.</language>
	</row>
	<row id="msg_0805_00187" index="187">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dryfuje na wiatrach. Mówi\nsię, że gdy HOPPIP zbierają się\nna polach i w górach, wiosna jest w drodze.</language>
	</row>
	<row id="msg_0805_00188" index="188">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kwitnie, gdy robi się ciepło.\nUnosi się na niebie, by\nwchłonąć jak najwięcej światła słonecznego.</language>
	</row>
	<row id="msg_0805_00189" index="189">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niesiony sezonowymi\nwiatrami, okrąża świat,\nrozsypując bawełniane zarodniki w drodze.</language>
	</row>
	<row id="msg_0805_00190" index="190">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa ogona, by zbierać\nowoce poza zasięgiem. Jego\nogon jest zręczniejszy niż jego prawdziwe ręce.</language>
	</row>
	<row id="msg_0805_00191" index="191">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nagle spada z nieba rano.\nRok po chłodnym lecie ich\npopulacja eksploduje.</language>
	</row>
	<row id="msg_0805_00192" index="192">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czerpie energię z ciepłego\nświatła słonecznego i jest znany\nze swojego zwyczaju przemieszczania się w jego poszukiwaniu.</language>
	</row>
	<row id="msg_0805_00193" index="193">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego oczy widzą 360\nstopni bez poruszania głowy.\nNie przegapi ofiary--nawet tej za nim.</language>
	</row>
	<row id="msg_0805_00194" index="194">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w chłodnej wodzie,\nzakopując się do połowy w\nmule na dnie, by spać.</language>
	</row>
	<row id="msg_0805_00195" index="195">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma ospałą naturę. Leży na\ndnie rzeki, czekając, aż ofiara\nzbłądzi do jego pyska.</language>
	</row>
	<row id="msg_0805_00196" index="196">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego futro wygląda i czuje\nsię jak aksamit. Kula na jego\nczole świeci, gdy używa psychicznej moc.</language>
	</row>
	<row id="msg_0805_00197" index="197">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Światło księżyca zmieniło\nstrukturę genetyczną EEVEE.\nCzai się w ciemności na ofiarę.</language>
	</row>
	<row id="msg_0805_00198" index="198">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wierzy się, że zobaczenie\ntego Pokémona nocą sprowadzi\nniepomyślne zdarzenia.</language>
	</row>
	<row id="msg_0805_00199" index="199">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ugryzienie przez SHELLDERA\ndało mu inteligencję porównywalną\nz nagradzanymi naukowcami.</language>
	</row>
	<row id="msg_0805_00200" index="200">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha podkradać się do ludzi\npóźno w nocy, a potem\nprzestraszyć ich swoim przeszywającym krzykiem.</language>
	</row>
	<row id="msg_0805_00201" index="201">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ukształtowany jak starożytne\npismo, to ogromna tajemnica,\nczy język, czy UNOWN powstał pierwszy.</language>
	</row>
	<row id="msg_0805_00202" index="202">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Desperacko próbuje utrzymać\nswój czarny ogon w ukryciu.\nMówi się, że to dowód, że ogon skrywa tajemnicę.</language>
	</row>
	<row id="msg_0805_00203" index="203">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ogon też ma mały mózg.\nGryzie, by odpędzić każdego\nwroga, który próbuje podejść od tyłu.</language>
	</row>
	<row id="msg_0805_00204" index="204">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda zupełnie jak szyszka.\nJego skorupa chroni go przed\nptasimi Pokémonami, które dziobią go przez przypadek.</language>
	</row>
	<row id="msg_0805_00205" index="205">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest zamknięty w stalowej\nskorupie. Jego wpatrzone oczy\nto wszystko, co widać z jego tajemniczego wnętrza.</language>
	</row>
	<row id="msg_0805_00206" index="206">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wkopuje się w ziemię swoim\nogonem i tworzy gniazdo w\nkształcie labiryntu. Może latać tylko odrobinę.</language>
	</row>
	<row id="msg_0805_00207" index="207">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Płynie na wiatrach z\nrozciągniętymi kończynami, by\nuderzyć z nieba. Celuje w twarz ofiary.</language>
	</row>
	<row id="msg_0805_00208" index="208">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hartowany pod ziemią pod\nwysokim ciśnieniem i ciepłem,\njego ciało jest twardsze od dowolnego metalu.</language>
	</row>
	<row id="msg_0805_00209" index="209">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Małe Pokémony uciekają od\njego przerażającej twarzy. Jest\njednak uważany przez kobiety za uroczego.</language>
	</row>
	<row id="msg_0805_00210" index="210">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest nieśmiały wbrew swojemu\nwyglądowi. Jeśli jednak\nwpadnie w gniew, uderzy swoimi ogromnymi kłami.</language>
	</row>
	<row id="msg_0805_00211" index="211">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wystrzeliwuje trujące kolce\nna swoim ciele we wszystkich\nkierunkach. Jego okrągła forma czyni go słabym pływakiem.</language>
	</row>
	<row id="msg_0805_00212" index="212">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma twarde jak stal ciało.\nZastrasza wrogów, podnosząc\nswoje szczypce z wzorem oka.</language>
	</row>
	<row id="msg_0805_00213" index="213">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przechowuje jagody w swojej\nskorupie. Jagody z czasem\nfermentują, stając się przepysznymi sokami.</language>
	</row>
	<row id="msg_0805_00214" index="214">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zbiera się w lasach, by\nszukać soku z drzew, swojego\nulubionego jedzenia. Jest wystarczająco silny, by rzucać wrogami.</language>
	</row>
	<row id="msg_0805_00215" index="215">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żywi się jajami kradzionymi\nz gniazd. Jego ostro zakrzywione\npazury rozdzierają wrażliwe miejsca ofiary.</language>
	</row>
	<row id="msg_0805_00216" index="216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozwala miodowi nasiąkać w\nłapy, by mógł je nieustannie\nlizać. Każda para łap ma inny smak.</language>
	</row>
	<row id="msg_0805_00217" index="217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Na swoim terytorium zostawia\nzadrapania na drzewach, które\nrodzą smaczne jagody lub owoce.</language>
	</row>
	<row id="msg_0805_00218" index="218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało zbudowane jest z\nmagmy. Jeśli nie będzie się\nruszać, jego ciało ostygnie i stwardnieje.</language>
	</row>
	<row id="msg_0805_00219" index="219">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Temperatura jego ciała wynosi\nokoło 9980 stopni Celsjusza.\nPłomienie wytryskują ze szczelin jego stwardniałej skorupy.</language>
	</row>
	<row id="msg_0805_00220" index="220">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha jeść grzyby, które\nrosną pod martwą trawą. Znajduje\ntakże gorące źródła podczas żerowania.</language>
	</row>
	<row id="msg_0805_00221" index="221">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego kudłaty płaszcz\nuniemożliwia mu widzenie.\nZamiast tego sprawdza otoczenie swoim czułym nosem.</language>
	</row>
	<row id="msg_0805_00222" index="222">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wiele żyje w czystych\nmorzach południa. Podobno nie\nmogą żyć w zanieczyszczonych wodach.</language>
	</row>
	<row id="msg_0805_00223" index="223">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wystrzeliwuje wodę z pyska z\nsiłą, by zestrzelić latającą\nofiarę.</language>
	</row>
	<row id="msg_0805_00224" index="224">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w szczelinach głazów i\nw dziurach na dnie morza.\nJego przyssawki mocno chwytają ofiarę.</language>
	</row>
	<row id="msg_0805_00225" index="225">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nosi jedzenie zwinięte w\nogonie. Ma zwyczaj dzielenia\nsię jedzeniem z ludźmi zagubionymi w górach.</language>
	</row>
	<row id="msg_0805_00226" index="226">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy fale są spokojne, można\nnapotkać rój MANTINE pływających,\njakby byli w locie.</language>
	</row>
	<row id="msg_0805_00227" index="227">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choć jest cały okryty twardą\njak żelazo zbroją, lata z\nprędkością ponad 290 km/h.</language>
	</row>
	<row id="msg_0805_00228" index="228">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przekazuje swoje odczucia\nróżnymi krzykami. Działa w\nwatasze, by sprytnie powalić ofiarę.</language>
	</row>
	<row id="msg_0805_00229" index="229">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dawno temu ludzie wyobrażali\nsobie, że jego niesamowite wycie\njest zewem ponurego kosiarza.</language>
	</row>
	<row id="msg_0805_00230" index="230">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w jaskiniach na dnie\nmorza i tworzy gigantyczne wiry\nkażdym swoim ruchem.</language>
	</row>
	<row id="msg_0805_00231" index="231">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest silny mimo swojego\nzwartego rozmiaru. Może z\nłatwością podnieść i nieść dorosłego człowieka na grzbiecie.</language>
	</row>
	<row id="msg_0805_00232" index="232">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atakuje, zwijając się, a\npotem tocząc się w swojego\nwroga. Może rozwalić dom jednym uderzeniem.</language>
	</row>
	<row id="msg_0805_00233" index="233">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z zainstalowanym\noprogramowaniem do rozwoju\nplanet, stał się zdolny do pracy w kosmosie.</language>
	</row>
	<row id="msg_0805_00234" index="234">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wpatrywanie się w jego rogi\ntworzy dziwne odczucie, jakby\nbyło się wciąganym w ich centra.</language>
	</row>
	<row id="msg_0805_00235" index="235">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znaczy swoje terytorium,\nużywając ogona jak pędzla. Jest\nponad 5000 różnych znaków.</language>
	</row>
	<row id="msg_0805_00236" index="236">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest znany ze swojej\ngorliwości do walki i zawsze\nleczy rany z wyzywania większych wrogów.</language>
	</row>
	<row id="msg_0805_00237" index="237">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Walczy, wirując jak bąk.\nSiła odśrodkowa zwiększa jego\nsiłę niszczenia dziesięciokrotnie.</language>
	</row>
	<row id="msg_0805_00238" index="238">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Testuje wszystko, dotykając\nustami, które pamiętają, co\nlubi, a co nie.</language>
	</row>
	<row id="msg_0805_00239" index="239">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wytwarza elektryczność,\nwirując ramionami. Jednak nie\nmoże magazynować energii, którą wytwarza.</language>
	</row>
	<row id="msg_0805_00240" index="240">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Temperatura jego ciała\nwynosi około 590 stopni\nCelsjusza. Jest zdrowy, jeśli oddycha żółtymi płomieniami.</language>
	</row>
	<row id="msg_0805_00241" index="241">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że dzieci, które\npiją mleko MILTANK, dorastają\nna krzepkich, zdrowych dorosłych.</language>
	</row>
	<row id="msg_0805_00242" index="242">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ten dobroduszny Pokémon\npielęgnuje chore Pokémony, by\nwróciły do zdrowia. Wyczuwa odczucia smutku.</language>
	</row>
	<row id="msg_0805_00243" index="243">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że spadł z\nbłyskawicą. Może wystrzeliwać\npioruny z chmur deszczowych na grzbiecie.</language>
	</row>
	<row id="msg_0805_00244" index="244">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że gdy ryczy,\ngdzieś na świecie wybucha\nwulkan.</language>
	</row>
	<row id="msg_0805_00245" index="245">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pędzi po świecie, by\noczyścić zanieczyszczoną wodę.\nPędzi dalej z północnym wiatrem.</language>
	</row>
	<row id="msg_0805_00246" index="246">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który zjada glebę.\nGdy raz zjadł dużą górę, zasypia,\nby móc rosnąć.</language>
	</row>
	<row id="msg_0805_00247" index="247">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało jest twarde jak\npodłoże skalne. Wypuszczając\nsprężony gaz, może wystrzelić się jak rakieta.</language>
	</row>
	<row id="msg_0805_00248" index="248">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli szaleje, obala góry i\nzasypuje rzeki. Mapy muszą\npotem zostać przerysowane.</language>
	</row>
	<row id="msg_0805_00249" index="249">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Śpi w głębokomorskim rowie.\nJeśli trzepocze skrzydłami,\nmówi się, że powoduje to 40-dniową burzę.</language>
	</row>
	<row id="msg_0805_00250" index="250">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego pióra są w siedmiu\nkolorach. Mówi się, że każdemu,\nkto go zobaczy, obiecane jest wieczne szczęście.</language>
	</row>
	<row id="msg_0805_00251" index="251">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma moc podróżowania przez\nczas, ale mówi się, że pojawia\nsię tylko w czasach pokoju.</language>
	</row>
	<row id="msg_0805_00252" index="252">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spody jego stóp pokryte są\nniezliczonymi małymi kolcami,\nco pozwala mu chodzić po ścianach i sufitach.</language>
	</row>
	<row id="msg_0805_00253" index="253">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w gęstych dżunglach.\nZbliżając się do ofiary, skacze\nz gałęzi na gałąź.</language>
	</row>
	<row id="msg_0805_00254" index="254">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Liście rosnące na jego\nramionach mogą ścinać grube\ndrzewa. Nie ma sobie równych w walce w dżungli.</language>
	</row>
	<row id="msg_0805_00255" index="255">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wewnątrz płonie ogień, więc\njest bardzo ciepły do przytulenia.\nWystrzeliwuje kule ognia o temperaturze 980 stopni Celsjusza.</language>
	</row>
	<row id="msg_0805_00256" index="256">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego mistrzostwo kopnięć\npozwala mu wyrzucić 10 kopnięć\nna sekundę. Wydaje ostre krzyki, by zastraszyć wrogów.</language>
	</row>
	<row id="msg_0805_00257" index="257">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Płomienie wytryskują z jego\nnadgarstków, otulając kłykcie.\nJego ciosy palą wrogów.</language>
	</row>
	<row id="msg_0805_00258" index="258">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By go ostrzec, płetwa na\ngłowie wyczuwa przepływ wody.\nMa siłę, by podnosić głazy.</language>
	</row>
	<row id="msg_0805_00259" index="259">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego solidne nogi dają mu\npewne podparcie, nawet w\nmule. Zakopuje się w ziemi, by spać.</language>
	</row>
	<row id="msg_0805_00260" index="260">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może pływać, ciągnąc duży\nstatek. Obala wrogów machnięciem\nswoich grubych ramion.</language>
	</row>
	<row id="msg_0805_00261" index="261">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon o wytrwałej naturze,\nściga wybraną ofiarę, aż się\nwyczerpie.</language>
	</row>
	<row id="msg_0805_00262" index="262">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ściga ofiarę w watasze.\nNigdy nie odmówi posłuszeństwa\npoleceniom wprawnego trenera.</language>
	</row>
	<row id="msg_0805_00263" index="263">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chodzi zygzakiem. Jest\ndobry w znajdowaniu\nprzedmiotów w trawie i nawet w ziemi.</language>
	</row>
	<row id="msg_0805_00264" index="264">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szarżuje na ofiarę z\nprędkością ponad 95 km/h.\nJednak ponieważ potrafi biegać tylko prosto, często zawodzi.</language>
	</row>
	<row id="msg_0805_00265" index="265">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha jeść liście. Jeśli\nzostanie zaatakowany przez\nSTARLY, obroni się swoim nakolczonym tyłem.</language>
	</row>
	<row id="msg_0805_00266" index="266">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zakotwicza się, owijając\ngałązki jedwabiem ze swojego\nciała. Nieruchomo czeka na ewolucję.</language>
	</row>
	<row id="msg_0805_00267" index="267">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma agresywną naturę. Dźga\nofiarę swoim długim, wąskim\npyskiem, by wysączyć jej płyny.</language>
	</row>
	<row id="msg_0805_00268" index="268">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wewnątrz kokonu jest gorąco.\nWszystkie komórki jego ciała\nwytwarzają energię potrzebną do ewolucji.</language>
	</row>
	<row id="msg_0805_00269" index="269">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon nocny. Przyciągane\nprzez latarnie uliczne, bezładnie\nzjadają liście drzew wzdłuż bulwarów.</language>
	</row>
	<row id="msg_0805_00270" index="270">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda jak roślina wodna\ni służy jako prom dla\nPokémonów, które nie umieją pływać.</language>
	</row>
	<row id="msg_0805_00271" index="271">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma figlarnego ducha. Jeśli\nzauważy wędkarza, pociągnie za\nżyłkę, by zakłócić łowienie.</language>
	</row>
	<row id="msg_0805_00272" index="272">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeśli usłyszy świąteczną\nmuzykę, wszystkie jego mięśnie\nnapełniają się energią. Nie może się powstrzymać przed tańcem.</language>
	</row>
	<row id="msg_0805_00273" index="273">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy zwisa z gałęzi drzewa,\nwygląda zupełnie jak żołądź.\nLubi przestraszać inne Pokémony.</language>
	</row>
	<row id="msg_0805_00274" index="274">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dźwięk jego trawiastego\nfletu sprawia, że słuchacze\nczują się niespokojni. Żyje głęboko w lasach.</language>
	</row>
	<row id="msg_0805_00275" index="275">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzepocząc swoim\nliściastym wachlarzem, może\nwzbić podmuchy 30 m/s, które mogą zrównać domy z ziemią.</language>
	</row>
	<row id="msg_0805_00276" index="276">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma odważnego ducha, który\nsprawia, że śmiało podejmuje\nsię trudnych wrogów. Lata w poszukiwaniu ciepłego klimatu.</language>
	</row>
	<row id="msg_0805_00277" index="277">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Krąży po niebie w\nposzukiwaniu ofiary. Gdy ją\nzauważy, nurkuje stromo, by ją złapać.</language>
	</row>
	<row id="msg_0805_00278" index="278">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buduje gniazdo na stromych\nklifach morskich. Jadąc na\nprądach wznoszących, szybuje na ogromne wysokości.</language>
	</row>
	<row id="msg_0805_00279" index="279">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zanurza swój duży dziób w\nmorzu, a potem zgarnia\nliczne ofiary wraz z wodą.</language>
	</row>
	<row id="msg_0805_00280" index="280">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa rogów na głowie, by\nwyczuwać ludzkie emocje. Mówi\nsię, że pojawia się przed radosnymi ludźmi.</language>
	</row>
	<row id="msg_0805_00281" index="281">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest wysoce wyczulony na\nodczucia swojego trenera.\nTańczy, gdy jest szczęśliwy.</language>
	</row>
	<row id="msg_0805_00282" index="282">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Będzie strzegł swojego\nzaufanego trenera za cenę życia.\nMa zdolność widzenia przyszłości.</language>
	</row>
	<row id="msg_0805_00283" index="283">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda, jakby ślizgał się\npo wodzie. Przyciąga ofiarę\nsłodkim zapachem z czubka głowy.</language>
	</row>
	<row id="msg_0805_00284" index="284">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego czułki mają wzory oczu.\nCztery skrzydła pozwalają mu\nzawisać i latać w dowolnym kierunku.</language>
	</row>
	<row id="msg_0805_00285" index="285">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wytryskuje trujące zarodniki\nz czubka głowy. Te zarodniki\npowodują ból na całym ciele, jeśli zostaną wdychane.</language>
	</row>
	<row id="msg_0805_00286" index="286">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego krótkie ramiona\nrozciągają się, gdy zadaje\nciosy. Jego technika równa się technice zawodowych bokserów.</language>
	</row>
	<row id="msg_0805_00287" index="287">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spędza prawie cały dzień,\nleżąc rozwalony. Samo spojrzenie\nna niego wywołuje senność.</language>
	</row>
	<row id="msg_0805_00288" index="288">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego serce bije dziesięć razy\nszybciej, więc nie może\nusiedzieć spokojnie nawet na chwilę.</language>
	</row>
	<row id="msg_0805_00289" index="289">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Najleniwszy Pokémon na\nświecie. Gdy się rozwala, w\nrzeczywistości oszczędza energię na kontratak.</language>
	</row>
	<row id="msg_0805_00290" index="290">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rośnie pod ziemią, wyczuwając\notoczenie czułkami zamiast\noczu, które są praktycznie ślepe.</language>
	</row>
	<row id="msg_0805_00291" index="291">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ porusza się tak\nszybko, czasem staje się\nniewidoczny. Gromadzi się wokół soku z drzew.</language>
	</row>
	<row id="msg_0805_00292" index="292">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Odrzucona skorupa owada, która\nożyła. Wpatrywanie się w szczelinę\nna jego grzbiecie podobno kradnie ducha.</language>
	</row>
	<row id="msg_0805_00293" index="293">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle jego krzyki są jak\nciche pomruki. Jeśli przestraszony,\nkrzyczy z taką głośnością jak silnik odrzutowca.</language>
	</row>
	<row id="msg_0805_00294" index="294">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Fale uderzeniowe z jego\nkrzyków mogą przewrócić\nciężarówki. Tupnięciem stóp zwiększa swoją moc.</language>
	</row>
	<row id="msg_0805_00295" index="295">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wycie można usłyszeć z\nponad dziesięciu kilometrów. Wydaje\nwszelkiego rodzaju dźwięki z portów na swoim ciele.</language>
	</row>
	<row id="msg_0805_00296" index="296">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hartuje swoje ciało, uderzając\nw grube drzewa. Wiele złamanych\ndrzew można znaleźć w pobliżu jego gniazda.</language>
	</row>
	<row id="msg_0805_00297" index="297">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha mierzyć się siłą z\ndużymi Pokémonami. Może posłać\nciężarówkę w powietrze swoimi pchnięciami ramion.</language>
	</row>
	<row id="msg_0805_00298" index="298">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który żyje przy\nwodzie. Porusza się szybko na\nlądzie, odbijając się na swoim dużym ogonie.</language>
	</row>
	<row id="msg_0805_00299" index="299">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego nos jest magnesem. W\nrezultacie ten Pokémon zawsze\nzwraca pysk w kierunku północy.</language>
	</row>
	<row id="msg_0805_00300" index="300">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nie może powstrzymać się\nprzed ściganiem ruszających\nrzeczy i biega w kółko, ścigając własny ogon.</language>
	</row>
	<row id="msg_0805_00301" index="301">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest bardzo popularny wśród\ntrenerek dzięki swojemu\nwspaniałemu futru. Nie posiada gniazda.</language>
	</row>
	<row id="msg_0805_00302" index="302">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ukrywa się w ciemności\njaskiń. Jego dieta złożona z\nklejnotów przekształciła jego oczy w drogie kamienie.</language>
	</row>
	<row id="msg_0805_00303" index="303">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Do jego głowy przytwierdzony\njest ogromny zestaw szczęk\nutworzonych z rogów. Może przegryzać żelazne belki.</language>
	</row>
	<row id="msg_0805_00304" index="304">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zwykle żyje głęboko w\ngórach. Jednak głód może go\nnapędzić, by jeść szyny kolejowe i samochody.</language>
	</row>
	<row id="msg_0805_00305" index="305">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By się żywić, wykopuje rudę\nżelaza. Rozbija swoje stalowe\nciało o inne, by walczyć o terytorium.</language>
	</row>
	<row id="msg_0805_00306" index="306">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Szukając żelaza na\njedzenie, wykopuje tunele,\nprzebijając się przez podłoże skalne swoimi stalowymi rogami.</language>
	</row>
	<row id="msg_0805_00307" index="307">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zjada tylko jedną jagodę\ndziennie. Znosząc głód, jego\nduch jest hartowany i wyostrzany.</language>
	</row>
	<row id="msg_0805_00308" index="308">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Poprzez treningi jogi\nwyostrzył swoje szóste czucie.\nJego ruchy są pełne elegancji.</language>
	</row>
	<row id="msg_0805_00309" index="309">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używając elektryczności\nzmagazynowanej w futrze,\nstymuluje mięśnie, by zwiększyć swoją szybkość reakcji.</language>
	</row>
	<row id="msg_0805_00310" index="310">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyładowuje elektryczność ze\nswojej grzywy. Tworzy chmurę\nburzową nad sobą, by zrzucać pioruny.</language>
	</row>
	<row id="msg_0805_00311" index="311">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dopinguje przyjaciół\npomponami z iskier. Wysysa moc\nze słupów telefonicznych.</language>
	</row>
	<row id="msg_0805_00312" index="312">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Dopinguje przyjaciół. Jeśli\njego przyjaciele przegrywają,\njego ciało wydziela coraz więcej iskier.</language>
	</row>
	<row id="msg_0805_00313" index="313">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Komunikuje się z innymi,\nświecąc swoim tyłem nocą. Kocha\nsłodki aromat ILLUMISE.</language>
	</row>
	<row id="msg_0805_00314" index="314">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Swoim słodkim aromatem\nprowadzi VOLBEAT, by rysować\nznaki światłem na nocnym niebie.</language>
	</row>
	<row id="msg_0805_00315" index="315">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ROSELIA wychowywane na czystej\nwodzie do picia są znane z\ntego, że wyrastają im żywo ubarwione kwiaty.</language>
	</row>
	<row id="msg_0805_00316" index="316">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niemal całe jego ciało to\nżołądek. Jego surowe soki\ntrawienne szybko rozpuszczają wszystko, co połknie.</language>
	</row>
	<row id="msg_0805_00317" index="317">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Połyka wszystko w całości.\nWyciska toksyczne płyny ze\nswoich mieszków, by oblać wrogów.</language>
	</row>
	<row id="msg_0805_00318" index="318">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Atakują rojem każdego\nwroga, który wejdzie na ich\nterytorium. Ich ostre kły mogą rozerwać kadłuby łodzi.</language>
	</row>
	<row id="msg_0805_00319" index="319">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego kły rozdzierają\nblachę stalową. Pływa z\nprędkością 120 km/h i jest znany jako „Zbir Morza”.</language>
	</row>
	<row id="msg_0805_00320" index="320">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W słoneczne dni wychodzi na\nplaże, by odbijać się jak\npiłka i bawić się. Wystrzeliwuje wodę z nosa.</language>
	</row>
	<row id="msg_0805_00321" index="321">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Największy ze wszystkich\nPokémonów. Może zanurkować na\ngłębokość blisko 3000 metrów na jednym oddechu.</language>
	</row>
	<row id="msg_0805_00322" index="322">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego garbaty grzbiet\nprzechowuje intensywnie gorącą\nmagmę. W deszczu magma ostyga, zwalniając jego ruchy.</language>
	</row>
	<row id="msg_0805_00323" index="323">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma wulkany na grzbiecie.\nJeśli magma narośnie w jego\nciele, drga, a potem gwałtownie wybucha.</language>
	</row>
	<row id="msg_0805_00324" index="324">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spala węgiel wewnątrz\nswojej skorupy na energię.\nWydmuchuje czarną sadzę, jeśli jest zagrożony.</language>
	</row>
	<row id="msg_0805_00325" index="325">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nieustannie odbija się,\nużywając ogona jak sprężyny.\nWstrząs odbicia utrzymuje jego serce w rytmie.</language>
	</row>
	<row id="msg_0805_00326" index="326">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa czarnych pereł, by\nwzmocnić swoją moc psychiczną.\nWykonuje dziwny taniec, by przejąć kontrolę nad wrogami.</language>
	</row>
	<row id="msg_0805_00327" index="327">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żadne dwa SPINDA nie mają\ntego samego wzoru plamek. Jego\nchwiejny krok psuje celność wrogów.</language>
	</row>
	<row id="msg_0805_00328" index="328">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tworzy stożkową jamę w\npiasku pustyni i czeka na\ndnie na ofiarę, która wpadnie, tocząc się w dół.</language>
	</row>
	<row id="msg_0805_00329" index="329">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gwałtownie drga skrzydłami,\nwytwarzając ultradźwięki, które\nwywołują bóle głowy u ludzi.</language>
	</row>
	<row id="msg_0805_00330" index="330">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wzbija burze piaskowe\npotężnymi machnięciami skrzydeł.\nJest znany jako „Duch Pustyni”.</language>
	</row>
	<row id="msg_0805_00331" index="331">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Magazynując wodę w ciele,\nten mieszkaniec pustyni może\nprzetrwać 30 dni bez wody.</language>
	</row>
	<row id="msg_0805_00332" index="332">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Staje się aktywny nocą,\nszukając ofiary wyczerpanej\ndziennym pustynnym żarem.</language>
	</row>
	<row id="msg_0805_00333" index="333">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego skrzydła są jak kłęby\nbawełny. Jeśli przysiądzie na\nczyjejś głowie, wygląda jak bawełniana czapka.</language>
	</row>
	<row id="msg_0805_00334" index="334">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda jak puszysty obłok,\ngdy jest w locie. Mruczy swoim\nsopranowym głosem.</language>
	</row>
	<row id="msg_0805_00335" index="335">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toczy wojnę z SEVIPEREM przez\nwiele pokoleń. Jego ostre pazury\nsą jego największą bronią.</language>
	</row>
	<row id="msg_0805_00336" index="336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przez wiele pokoleń toczy\nwojnę z ZANGOOSE. Ostrzy swój\nostrzowy ogon na skałach przed walką.</language>
	</row>
	<row id="msg_0805_00337" index="337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ staje się aktywny\nw noce pełni, mówi się, że ma\njakiś związek z fazami księżyca.</language>
	</row>
	<row id="msg_0805_00338" index="338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nowy gatunek Pokémona,\npodobno ze słońca. Wydziela\nświatło podczas wirowania.</language>
	</row>
	<row id="msg_0805_00339" index="339">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokrywa całe ciało lepkim\npłynem, by mógł się wić i\nwymknąć, jeśli zostanie złapany.</language>
	</row>
	<row id="msg_0805_00340" index="340">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest bardzo terytorialny.\nOdpycha wrogów, wywołując\nwstrząsy w zasięgu ponad pięciu kilometrów.</language>
	</row>
	<row id="msg_0805_00341" index="341">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wytrzymała witalność\npozwala mu przystosować się do\ndowolnego środowiska. Jego szczypce nigdy nie uwolnią ofiary.</language>
	</row>
	<row id="msg_0805_00342" index="342">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest zbirem, który używa\nswoich szczypiec, by podnosić\ni wyrzucać inne Pokémony z jego stawu.</language>
	</row>
	<row id="msg_0805_00343" index="343">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Porusza się, wirując na\nstopie. To rzadki Pokémon\nodkryty w starożytnych ruinach.</language>
	</row>
	<row id="msg_0805_00344" index="344">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Starożytna glinianka figurka,\nktóra ożyła jako Pokémon\npod wpływem tajemniczego promienia światła.</language>
	</row>
	<row id="msg_0805_00345" index="345">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żył na dnie morza 100\nmilionów lat temu i został\nnaukowo wskrzeszony.</language>
	</row>
	<row id="msg_0805_00346" index="346">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje na mielinach ciepłych\nmórz. Gdy odpływ się cofa,\nwykopuje ofiarę z plaż.</language>
	</row>
	<row id="msg_0805_00347" index="347">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przodek Pokémonów, który\nzostał wskrzeszony ze\nskamieliny. Żył w morzu i polował pazurami.</language>
	</row>
	<row id="msg_0805_00348" index="348">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyszedł na ląd po ewolucji.\nCałe jego ciało okryte jest\nsolidną zbroją.</language>
	</row>
	<row id="msg_0805_00349" index="349">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest znany ze swojego\nniechlujnego wyglądu. Choć\nliczny, mają tendencję do skupiania się w ustalonych miejscach.</language>
	</row>
	<row id="msg_0805_00350" index="350">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy ludzie się kłócą, mówi\nsię, że wyłania się z głębin\njezior, by ukoić wojownicze serca.</language>
	</row>
	<row id="msg_0805_00351" index="351">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego wygląd zmienia się z\npogodą. Niedawno odkryto, że\njego molekuły są zupełnie jak molekuły wody.</language>
	</row>
	<row id="msg_0805_00352" index="352">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Może swobodnie zmieniać\nkolor swojego ciała. Zygzakowaty\nwzór na brzuchu jednak się nie zmienia.</language>
	</row>
	<row id="msg_0805_00353" index="353">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha mściwe emocje i zwisa\nw rzędach pod okapami domów,\ngdzie żyją mściwi ludzie.</language>
	</row>
	<row id="msg_0805_00354" index="354">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lalka, która stała się\nPokémonem przez urazę za\nwyrzucenie na śmieci. Szuka dziecka, które się jej wyrzekło.</language>
	</row>
	<row id="msg_0805_00355" index="355">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zawzięcie ściga swoją ofiarę,\ngdziekolwiek pójdzie. Jednak\npogoń zostaje przerwana o wschodzie słońca.</language>
	</row>
	<row id="msg_0805_00356" index="356">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało jest puste. Mówi\nsię, że ci, którzy zaglądają\ndo jego wnętrza, zostają wciągnięci w pustkę.</language>
	</row>
	<row id="msg_0805_00357" index="357">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ nieustannie jadł\ntylko swój ulubiony owoc,\nowoc zaczął rosnąć wokół jego szyi.</language>
	</row>
	<row id="msg_0805_00358" index="358">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By zwalić wrogów z nóg,\nwstrząsa powietrzem swoimi\nkrzykami. Rozmawia, używając siedmiu krzyków.</language>
	</row>
	<row id="msg_0805_00359" index="359">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wyczuwa nadchodzące katastrofy\ni pojawia się przed ludźmi\ntylko, by ostrzec ich o nadciągającym niebezpieczeństwie.</language>
	</row>
	<row id="msg_0805_00360" index="360">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Staje się silny, napierając\nna innych en masse. Kocha\njeść słodkie owoce.</language>
	</row>
	<row id="msg_0805_00361" index="361">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W krainie śniegu pewien\nfolklor głosi, że dom będzie\nprosperował, jeśli żyje w nim SNORUNT.</language>
	</row>
	<row id="msg_0805_00362" index="362">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By się chronić, okrywa swoje\nciało zbroją z lodu, utworzoną\nprzez zamrażanie wilgoci w powietrzu.</language>
	</row>
	<row id="msg_0805_00363" index="363">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Toczy się po krach lodowych,\nby dotrzeć do brzegu, bo jego\nciało jest źle ukształtowane do pływania.</language>
	</row>
	<row id="msg_0805_00364" index="364">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma zwyczaj kręcenia\nprzedmiotami na nosie. Robiąc\ntak, poznaje tekstury i zapachy.</language>
	</row>
	<row id="msg_0805_00365" index="365">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozbija lód swoimi dużymi\nkłami. Jego gruba warstwa\ntłuszczu odpiera nie tylko chłód, ale też ataki wrogów.</language>
	</row>
	<row id="msg_0805_00366" index="366">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wytwarza jedną perłę w\nciągu życia. Mówi się, że\nperła wzmacnia moc psychiczną.</language>
	</row>
	<row id="msg_0805_00367" index="367">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje głęboko w morzu. Z\nogonem ukształtowanym jak\nmała rybka, przyciąga niczego niespodziewającą się ofiarę.</language>
	</row>
	<row id="msg_0805_00368" index="368">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje na dnie morza. Wiosną\njego różowe ciało staje się\nz jakiegoś powodu bardziej intensywne.</language>
	</row>
	<row id="msg_0805_00369" index="369">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rzadki Pokémon odkryty\npodczas eksploracji głębin\nmorskich. Nie zmienił się od ponad 100 milionów lat.</language>
	</row>
	<row id="msg_0805_00370" index="370">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w ciepłych morzach.\nMówi się, że para, która\nznajdzie tego Pokémona, zostanie błogosławiona wieczną miłością.</language>
	</row>
	<row id="msg_0805_00371" index="371">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Marząc o tym, by pewnego\ndnia latać, trenuje, skacząc\nz klifów każdego dnia.</language>
	</row>
	<row id="msg_0805_00372" index="372">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wewnątrz jego szorstkiej\nskorupy jego komórki zaczęły\nsię zmieniać. Skorupa odpada w momencie ewolucji.</language>
	</row>
	<row id="msg_0805_00373" index="373">
		<attribute name="window_context_name">used</attribute>
		<language name="English">W wyniku jego długo\ntrwającego snu o lataniu, jego\nstruktura komórkowa się zmieniła i wyrosły mu skrzydła.</language>
	</row>
	<row id="msg_0805_00374" index="374">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rozmawia z innymi za\npomocą impulsów magnetycznych.\nW roju poruszają się w idealnej synchronizacji.</language>
	</row>
	<row id="msg_0805_00375" index="375">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Powstaje przez połączenie\ndwóch BELDUM. Jego stalowe\nciało nie zostanie zadrapane, nawet w kolizji z samolotem.</language>
	</row>
	<row id="msg_0805_00376" index="376">
		<attribute name="window_context_name">used</attribute>
		<language name="English">METANGI połączyły się, by\nje utworzyć. Z czterema\nmózgami ma inteligencję superkomputera.</language>
	</row>
	<row id="msg_0805_00377" index="377">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Całe jego ciało zbudowane\njest ze skały. Jeśli jakaś\nczęść odpryska w walce, przyczepia skały, by się naprawić.</language>
	</row>
	<row id="msg_0805_00378" index="378">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało zbudowane jest\nz lodu epoki lodowcowej.\nKontroluje mroźne powietrze o temperaturze -200 stopni Celsjusza.</language>
	</row>
	<row id="msg_0805_00379" index="379">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hartowane ciśnieniem pod\nziemią przez dziesiątki tysięcy\nlat, jego ciało nie może zostać zadrapane.</language>
	</row>
	<row id="msg_0805_00380" index="380">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało pokryte jest\npuchem, który załamuje światło\ntak, że staje się niewidzialny.</language>
	</row>
	<row id="msg_0805_00381" index="381">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wysoce inteligentny Pokémon.\nSkładając skrzydła w locie,\nmoże wyprzedzić samoloty odrzutowe.</language>
	</row>
	<row id="msg_0805_00382" index="382">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że poszerzył morza,\nwywołując ulewy. Spał w\nrowie oceanicznym.</language>
	</row>
	<row id="msg_0805_00383" index="383">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spał w podziemnej magmie,\nodkąd zaciekle walczył z\nKYOGRE dawno temu.</language>
	</row>
	<row id="msg_0805_00384" index="384">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w warstwie ozonowej\nwysoko nad obłokami i nie\nmoże być widziany z ziemi.</language>
	</row>
	<row id="msg_0805_00385" index="385">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mówi się, że ma zdolność\nspełnienia dowolnego życzenia\nna jeden tydzień co tysiąc lat.</language>
	</row>
	<row id="msg_0805_00386" index="386">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pozaziemski wirus, który\nspadł na ziemię na meteorze,\nprzeszedł mutację DNA, by stać się tym Pokémonem.</language>
	</row>
	<row id="msg_0805_00387" index="387">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zrobiona z ziemi skorupa\nna jego grzbiecie twardnieje,\ngdy pije wodę. Żyje wzdłuż jezior.</language>
	</row>
	<row id="msg_0805_00388" index="388">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje przy wodzie w lasach.\nW ciągu dnia opuszcza las, by\nwygrzewać swoją zadrzewioną skorupę na słońcu.</language>
	</row>
	<row id="msg_0805_00389" index="389">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Małe Pokémony czasem\ngromadzą się na jego nieruchomym\ngrzbiecie, by zacząć budować swoje gniazda.</language>
	</row>
	<row id="msg_0805_00390" index="390">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Sprawnie wspina się po\nstromych klifach, by żyć na\nskalistych górach. Jego ogień gaśnie, gdy śpi.</language>
	</row>
	<row id="msg_0805_00391" index="391">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By zastraszyć napastników,\nrozciąga ogień na ogonie,\nby wyglądać większy.</language>
	</row>
	<row id="msg_0805_00392" index="392">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Używa specjalnego rodzaju\nsztuk walki, obejmującego\nwszystkie kończyny. Jego ogień nigdy nie gaśnie.</language>
	</row>
	<row id="msg_0805_00393" index="393">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ponieważ jest bardzo dumny,\nnienawidzi przyjmować jedzenia\nod ludzi. Jego gęsty puch chroni go przed chłodem.</language>
	</row>
	<row id="msg_0805_00394" index="394">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje samotnie, z dala od\ninnych. Najwyraźniej każdy z\nnich wierzy, że jest najważniejszy.</language>
	</row>
	<row id="msg_0805_00395" index="395">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trzy rogi wystające z jego\ndzioba świadczą o jego sile.\nLider ma największe rogi.</language>
	</row>
	<row id="msg_0805_00396" index="396">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gromadzą się w wielkich\nliczbach. Choć małe, trzepoczą\nskrzydłami z wielką siłą.</language>
	</row>
	<row id="msg_0805_00397" index="397">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lata po lasach i polach w\nposzukiwaniu owadzich Pokémonów.\nTrzyma się w ogromnym stadzie.</language>
	</row>
	<row id="msg_0805_00398" index="398">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma dziką naturę. Odważnie\nwyzwie wrogów, którzy są\nznacznie większi.</language>
	</row>
	<row id="msg_0805_00399" index="399">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Z nerwami ze stali, nic\nnie może go zaniepokoić. Jest\nbardziej zwinny i aktywny, niż się wydaje.</language>
	</row>
	<row id="msg_0805_00400" index="400">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buduje gniazdo, tamując\npotoki korą i mułem. Jest\nznany jako pracowity robotnik.</language>
	</row>
	<row id="msg_0805_00401" index="401">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrząsa głową od przodu\ndo tyłu, powodując, że jego\nczułki uderzają się nawzajem, brzmiąc jak ksylofon.</language>
	</row>
	<row id="msg_0805_00402" index="402">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Krzyżuje swoje ramiona\npodobne do noży przed klatką\npiersiową, gdy krzyczy. Może komponować melodie na poczekaniu.</language>
	</row>
	<row id="msg_0805_00403" index="403">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Całe jego futro błyska, jeśli\nwyczuje niebezpieczeństwo. Ucieka,\ngdy wróg jest chwilowo zaślepiony.</language>
	</row>
	<row id="msg_0805_00404" index="404">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego pazury wyładowują\nelektryczność o natężeniu\nzdolnym wywołać omdlenie. Żyją w małych grupach.</language>
	</row>
	<row id="msg_0805_00405" index="405">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma oczy, które widzą przez\nwszystko. Wykrywa i łapie\nofiarę skrytą za przedmiotami.</language>
	</row>
	<row id="msg_0805_00406" index="406">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przez zimę zamyka pąk i\nznosi chłód. Wiosną pąk\notwiera się i wydziela pyłek.</language>
	</row>
	<row id="msg_0805_00407" index="407">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyciąga ofiarę słodkim\naromatem, a potem powala ją\ncierniowymi biczami ukrytymi w ramionach.</language>
	</row>
	<row id="msg_0805_00408" index="408">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żył w dżunglach około 100\nmilionów lat temu. Jego czaszka\njest twarda jak żelazo.</language>
	</row>
	<row id="msg_0805_00409" index="409">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego potężne uderzenie głową\nma siłę, by roztrzaskać nawet\nnajbardziej wytrzymałe rzeczy przy uderzeniu.</language>
	</row>
	<row id="msg_0805_00410" index="410">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który żył w\ndżunglach około 100 milionów\nlat temu. Jego skóra na twarzy jest niezwykle twarda.</language>
	</row>
	<row id="msg_0805_00411" index="411">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Każdy atak frontalny jest\nodpychany. To łagodny Pokémon,\nktóry żywi się trawą i jagodami.</language>
	</row>
	<row id="msg_0805_00412" index="412">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By się chronić przed\nchłodnymi, zimowymi wiatrami,\nokrywa się płaszczem z gałązek i liści.</language>
	</row>
	<row id="msg_0805_00413" index="413">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy BURMY ewoluował, jego\npłaszcz stał się częścią ciała\ntego Pokémona. Płaszcz nigdy nie jest zrzucany.</language>
	</row>
	<row id="msg_0805_00414" index="414">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha miód kwiatów i\nkradnie miód zebrany przez\nCOMBEE.</language>
	</row>
	<row id="msg_0805_00415" index="415">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon utworzony z trzech\ninnych. Pracowicie znosi\nsłodki kwiatowy miód do VESPIQUEN.</language>
	</row>
	<row id="msg_0805_00416" index="416">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego brzuch to plaster\nmiodu dla larw. Wychowuje\nswoje larwy na miodzie zebranym przez COMBEE.</language>
	</row>
	<row id="msg_0805_00417" index="417">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Tworzy kule futra, które\ntrzaskają elektrycznością\nstatyczną. Przechowuje je z jagodami w dziurach drzew.</language>
	</row>
	<row id="msg_0805_00418" index="418">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma worek pływny podobny do\nnadmuchiwanego kołnierza.\nUnosi się na wodzie z głową na wierzchu.</language>
	</row>
	<row id="msg_0805_00419" index="419">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Unosi się, używając swojego\ndobrze rozwiniętego worka\npływnego. Pomaga w ratowaniu tonących ludzi.</language>
	</row>
	<row id="msg_0805_00420" index="420">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mała kula zawiera substancje\nodżywcze potrzebne do ewolucji.\nPodobno jest bardzo słodka i smaczna.</language>
	</row>
	<row id="msg_0805_00421" index="421">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kwitnie w czasie silnego\nświatła słonecznego. Próbuje\nwynagrodzić sobie wszystko, co znosił jako pąk.</language>
	</row>
	<row id="msg_0805_00422" index="422">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego kolory i kształty różnią\nsię w zależności od regionu.\nW regionie Sinnoh potwierdzono dwa typy.</language>
	</row>
	<row id="msg_0805_00423" index="423">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma giętkie ciało bez kości.\nJeśli jakaś część jego ciała\nzostanie oderwana, odrasta zaraz z powrotem.</language>
	</row>
	<row id="msg_0805_00424" index="424">
		<attribute name="window_context_name">used</attribute>
		<language name="English">By jeść, sprawnie łupie\norzechy dwoma ogonami. Rzadko\nużywa już ramion.</language>
	</row>
	<row id="msg_0805_00425" index="425">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon utworzony z duchów\nludzi i Pokémonów. Kocha\nwilgotne, parne sezony.</language>
	</row>
	<row id="msg_0805_00426" index="426">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest senny w ciągu dnia,\nale wieczorem odlatuje w\nwielkich grupach. Nikt nie wie, dokąd lecą.</language>
	</row>
	<row id="msg_0805_00427" index="427">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Uderza wrogów, ostro\nrozwijając swoje zwinięte\nuszy. Kłuje tak silnie, że może sprawić, że dorosły zapłacze z bólu.</language>
	</row>
	<row id="msg_0805_00428" index="428">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Niezwykle ostrożny\nPokémon. Otula swoje ciało\npuszystym futrem z uszu, gdy wyczuje niebezpieczeństwo.</language>
	</row>
	<row id="msg_0805_00429" index="429">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego krzyki brzmią jak\nzaklęcia. Osoby, które je\nusłyszą, są dręczone bólami głowy i halucynacjami.</language>
	</row>
	<row id="msg_0805_00430" index="430">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Staje się aktywny nocą i\njest znany z tworzenia roju\nz licznymi MURKROW u swego boku.</language>
	</row>
	<row id="msg_0805_00431" index="431">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Drapie, gdy jest\nniezadowolony, i mruczy, gdy\njest czuła. Jej zmienność jest bardzo popularna u niektórych.</language>
	</row>
	<row id="msg_0805_00432" index="432">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jest bezczelnym brutalem,\nktóry wdziera się do gniazda\ninnego Pokémona i ogłasza je swoim.</language>
	</row>
	<row id="msg_0805_00433" index="433">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydaje krzyki, poruszając\nkulą w głębi gardła.\nPorusza się podskakującymi skokami.</language>
	</row>
	<row id="msg_0805_00434" index="434">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chroni się, spryskując\nszkodliwym płynem z tyłu. Smród\nunosi się przez 24 godziny.</language>
	</row>
	<row id="msg_0805_00435" index="435">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Spryskuje wstrętnie pachnącym\npłynem z czubka ogona, by\nzaatakować. Jego zasięg przekracza 48 metrów.</language>
	</row>
	<row id="msg_0805_00436" index="436">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Narzędzia w jego kształcie\nodkryto w starożytnych grobowcach.\nNie wiadomo, czy są powiązane.</language>
	</row>
	<row id="msg_0805_00437" index="437">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jeden wywołał sensację w\nwiadomościach, gdy został\nwykopany na budowie po 2000-letnim śnie.</language>
	</row>
	<row id="msg_0805_00438" index="438">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wygląda, jakby zawsze\npłakał. W rzeczywistości\nreguluje poziom płynów w ciele, usuwając nadmiar.</language>
	</row>
	<row id="msg_0805_00439" index="439">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma zwyczaj naśladowania\nwrogów. Raz naśladowany, wróg\nnie może oderwać oczu od tego Pokémona.</language>
	</row>
	<row id="msg_0805_00440" index="440">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Kocha okrągłe, białe\nrzeczy. Nosi kamień w kształcie\njajka, imitując CHANSEY.</language>
	</row>
	<row id="msg_0805_00441" index="441">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrafi uczyć się i mówić\nludzkie słowa. Jeśli się\nzbiorą, wszystkie uczą się tego samego powiedzenia.</language>
	</row>
	<row id="msg_0805_00442" index="442">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon utworzony przez\n108 duchów. Jest przywiązany\ndo szczeliny w dziwnym kamieniu węgielnym.</language>
	</row>
	<row id="msg_0805_00443" index="443">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gnieździ się w małych,\npoziomych dziurach w ścianach\njaskiń. Skacze, by łapać ofiarę, która zbłądzi zbyt blisko.</language>
	</row>
	<row id="msg_0805_00444" index="444">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Od dawna istnieje\nprzekonanie, że lek zrobiony\nz jego łusek wyleczy nawet nieuleczalne choroby.</language>
	</row>
	<row id="msg_0805_00445" index="445">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Gdy zwija ciało i rozciąga\nskrzydła, wygląda jak samolot\nodrzutowy. Lata z prędkością ponaddźwiękową.</language>
	</row>
	<row id="msg_0805_00446" index="446">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pochłania dziennie tyle\njedzenia, ile sam waży, połykając\njedzenie w całości, prawie bez przeżuwania.</language>
	</row>
	<row id="msg_0805_00447" index="447">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Aura, która wydziela się z\njego ciała, nasila się, by\nostrzec innych, jeśli jest przestraszony lub smutny.</language>
	</row>
	<row id="msg_0805_00448" index="448">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma zdolność wyczuwania aur\nwszystkich rzeczy. Rozumie\nludzką mowę.</language>
	</row>
	<row id="msg_0805_00449" index="449">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w suchych miejscach.\nZamiast pocić się, wydala z\nciała sypki piasek.</language>
	</row>
	<row id="msg_0805_00450" index="450">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wystrzeliwuje zmagazynowany\nwewnątrz piasek z portów na\nciele, tworząc wznoszącą się trąbę powietrzną do ataku.</language>
	</row>
	<row id="msg_0805_00451" index="451">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Chwyta ofiarę pazurami na\nogonie i wstrzykuje truciznę.\nZawzięcie trzyma się, aż trucizna zadziała.</language>
	</row>
	<row id="msg_0805_00452" index="452">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma siłę w pazurzastych\nramionach, by zrobić złom z\nsamochodu. Czubki jego pazurów wydzielają truciznę.</language>
	</row>
	<row id="msg_0805_00453" index="453">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego policzki zawierają\nworeczki trucizny. Próbuje\nzłapać wrogów z zaskoczenia, by ukłuć ich toksycznymi palcami.</language>
	</row>
	<row id="msg_0805_00454" index="454">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego pazury na kłykciach\nwydzielają toksynę tak\nzajadłą, że nawet zadrapanie może być śmiertelne.</language>
	</row>
	<row id="msg_0805_00455" index="455">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyciąga ofiarę swoją\nsłodko pachnącą śliną, a\npotem zacina zęby. Zjedzenie ofiary zajmuje cały dzień.</language>
	</row>
	<row id="msg_0805_00456" index="456">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Po długiej ekspozycji na\nświatło słoneczne, wzory na\njego płetwach ogonowych jasno świecą, gdy nadchodzi ciemność.</language>
	</row>
	<row id="msg_0805_00457" index="457">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje na dnie głębokiego\nmorza. Przyciąga ofiarę,\nbłyskając wzorami na czterech płetwach ogonowych.</language>
	</row>
	<row id="msg_0805_00458" index="458">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyjazny Pokémon, który\nwychwytuje subtelne przepływy\nwody morskiej swoimi dwoma czułkami.</language>
	</row>
	<row id="msg_0805_00459" index="459">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje na śnieżnych górach.\nMając mało kontaktu z ludźmi,\njest śmiało dociekliwy.</language>
	</row>
	<row id="msg_0805_00460" index="460">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wzbija zamiecie w górach,\nktóre zawsze są zasypane śniegiem.\nJest potworem śniegu.</language>
	</row>
	<row id="msg_0805_00461" index="461">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyją w chłodnych regionach,\ntworząc grupy po cztery lub\npięć, które polują z imponującą koordynacją.</language>
	</row>
	<row id="msg_0805_00462" index="462">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ewoluował pod wpływem\nspecjalnego pola magnetycznego.\nTrzy jednostki wytwarzają magnetyzm.</language>
	</row>
	<row id="msg_0805_00463" index="463">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Owija przedmioty swoim\nrozciągliwym językiem. Podejście\nzbyt blisko sprawi, że zostaniesz oblepiony śliną.</language>
	</row>
	<row id="msg_0805_00464" index="464">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wkłada kamienie w otwory w\ndłoniach i używa mięśni, by je\nwystrzelić. GEODUDE są wystrzeliwane rzadko.</language>
	</row>
	<row id="msg_0805_00465" index="465">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Usidla ofiarę, rozciągając\nramiona z pnączy. Utrata ramion\nna drapieżniki nie martwi go.</language>
	</row>
	<row id="msg_0805_00466" index="466">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Przyciska czubki swoich\ndwóch ogonów do wroga, a\npotem uwalnia moc ponad 20 000 woltów.</language>
	</row>
	<row id="msg_0805_00467" index="467">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wystrzeliwuje kule ognia o\ntemperaturze ponad 1980 stopni\nCelsjusza z czubków ramion. Żyje w kraterach wulkanicznych.</language>
	</row>
	<row id="msg_0805_00468" index="468">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Nigdy nie pojawi się, gdzie\njest konflikt. Jego obserwacje\nstały się ostatnio rzadkie.</language>
	</row>
	<row id="msg_0805_00469" index="469">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wirując skrzydłami, tworzy\nfale uderzeniowe, które zadają\nkrytyczne wewnętrzne obrażenia wrogom.</language>
	</row>
	<row id="msg_0805_00470" index="470">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zupełnie jak rośliny,\nużywa fotosyntezy. W\nrezultacie jest zawsze otulony czystym powietrzem.</language>
	</row>
	<row id="msg_0805_00471" index="471">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jako technika ochronna, może\ncałkowicie zamrozić swoje\nfutro, by jego włosy stały jak igły.</language>
	</row>
	<row id="msg_0805_00472" index="472">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Obserwuje ofiarę, zwisając\ngłową w dół z gałęzi. Gdy\nnadarza się szansa, atakuje!</language>
	</row>
	<row id="msg_0805_00473" index="473">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego imponujące kły zrobione\nsą z lodu. Populacja się\nzmniejszyła, gdy po epoce lodowcowej zrobiło się ciepło.</language>
	</row>
	<row id="msg_0805_00474" index="474">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zainstalowano dodatkowe\noprogramowanie, by zrobić z\nniego lepszego Pokémona. Jednak zaczął zachowywać się dziwnie.</language>
	</row>
	<row id="msg_0805_00475" index="475">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mistrz etykiety i\nszermierki, walczy mieczami\nwysuwającymi się z łokci.</language>
	</row>
	<row id="msg_0805_00476" index="476">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wydziela silny magnetyzm z\ncałego ciała. Kontroluje trzy\nmałe jednostki zwane Mini-Nosami.</language>
	</row>
	<row id="msg_0805_00477" index="477">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Czułek na jego głowie łapie\nfale radiowe ze świata duchów,\nktóre rozkazują mu zabierać tam ludzi.</language>
	</row>
	<row id="msg_0805_00478" index="478">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zamraża wrogów lodowatym\noddechem o temperaturze blisko\n-51 stopni Celsjusza. To, co wydaje się jego ciałem, jest w rzeczywistości puste.</language>
	</row>
	<row id="msg_0805_00479" index="479">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Jego ciało zbudowane jest\nz plazmy. Wiadomo, że wnika\nw urządzenia elektroniczne i wywołuje spustoszenie.</language>
	</row>
	<row id="msg_0805_00480" index="480">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znany jako „Istota Wiedzy”.\nMówi się, że może wymazać\npamięć tych, którzy zobaczą jego oczy.</language>
	</row>
	<row id="msg_0805_00481" index="481">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znany jako „Istota Emocji”.\nNauczył ludzi szlachetności\nsmutku, bólu i radości.</language>
	</row>
	<row id="msg_0805_00482" index="482">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Znany jako „Istota Woli”.\nŚpi na dnie jeziora, by\nzachować równowagę świata.</language>
	</row>
	<row id="msg_0805_00483" index="483">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma moc kontrolowania czasu.\nPojawia się w mitach regionu\nSinnoh jako starożytne bóstwo.</language>
	</row>
	<row id="msg_0805_00484" index="484">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ma zdolność zniekształcania\nprzestrzeni. Jest opisywany jako\nbóstwo w mitologii regionu Sinnoh.</language>
	</row>
	<row id="msg_0805_00485" index="485">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Zamieszkuje wulkaniczne\njaskinie. Wkopuje się swoimi\nstopami w kształcie krzyża, by pełzać po sufitach i ścianach.</language>
	</row>
	<row id="msg_0805_00486" index="486">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Istnieje trwała legenda\ngłosząca, że ten Pokémon\nciągnął kontynenty linami.</language>
	</row>
	<row id="msg_0805_00487" index="487">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, o którym mówi się,\nże żyje w świecie po odwrotnej\nstronie naszego. Pojawia się na starożytnym cmentarzu.</language>
	</row>
	<row id="msg_0805_00488" index="488">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Błyszczące drobinki\nwydzielają się z jego skrzydeł\njak zasłona. Mówi się, że reprezentuje sierp księżyca.</language>
	</row>
	<row id="msg_0805_00489" index="489">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon, który żyje w\nciepłych morzach. Nadymuje\nworek pływny na głowie, by dryfować i szukać jedzenia.</language>
	</row>
	<row id="msg_0805_00490" index="490">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Urodzony na chłodnym dnie\nmorza, przepłynie ogromne\ndystanse, by wrócić do miejsca urodzenia.</language>
	</row>
	<row id="msg_0805_00491" index="491">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Potrafi usypiać ludzi i\nsprawiać, że śnią. Jest aktywny\nw noce nowiu.</language>
	</row>
	<row id="msg_0805_00492" index="492">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Żyje w skupiskach kwiatów\ni unika wykrycia, zwijając\nsię, by wyglądać jak kwitnąca roślina.</language>
	</row>
	<row id="msg_0805_00493" index="493">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Opisywany jest w mitologii\njako Pokémon, który ukształtował\nwszechświat swoimi 1000 ramionami.</language>
	</row>
</body>
